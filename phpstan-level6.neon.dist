includes:
	- phpstan.neon.dist
	- phpstan-level6-baseline.neon
parameters:
	# Audit round 8 (item 26): the NEXT strictness tier. Level 6 (missing
	# iterable value types) with a FROZEN baseline: existing findings are
	# accepted, any NEW level-6 finding fails CI. Shrink the baseline by
	# fixing code and regenerating — never grow it.
	level: 6
	reportUnmatchedIgnoredErrors: false
