{% extends 'base.html.twig' %}

{% block title %}{{ 'meeting.calendar_title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css' rel='stylesheet' integrity="sha384-a+uEN0SA9NPmaoLnc5WsmxDS2SgEiUlzTisgqmWvaOsxzPREhiatn8EIBuY/Zsl2" crossorigin="anonymous" />
<style>
    /* Custom overrides for FullCalendar to match Rams theme */
    .fc {
        --fc-border-color: var(--rams-border);
        --fc-button-bg-color: var(--rams-surface);
        --fc-button-border-color: var(--rams-border);
        --fc-button-text-color: var(--rams-text);
        --fc-button-hover-bg-color: var(--rams-surface-hover);
        --fc-button-hover-border-color: var(--rams-border);
        --fc-button-active-bg-color: var(--rams-primary-bg);
        --fc-button-active-border-color: var(--rams-primary);
        --fc-event-bg-color: var(--rams-primary);
        --fc-event-border-color: var(--rams-primary);
        --fc-today-bg-color: var(--rams-surface-alt);
        --fc-page-bg-color: var(--rams-surface);
        --fc-neutral-bg-color: var(--rams-surface-alt);
        --fc-list-event-hover-bg-color: var(--rams-surface-hover);
        font-family: inherit;
    }
    
    .fc-toolbar-title {
        font-size: 1.25rem !important;
        font-weight: 600;
    }
    
    .fc-theme-standard td, .fc-theme-standard th {
        border-color: var(--rams-border);
    }
</style>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('meeting_index') }}">{{ 'meeting.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span>{{ 'meeting.calendar'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'meeting.meeting_calendar'|trans }}</h1>
        </div>
        <div class="rams-page__actions mobile-stack">
             <a href="{{ path('meeting_new') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2V14M2 8H14"/>
                </svg>
                {{ 'meeting.new_slot'|trans }}
            </a>
        </div>
    </div>
    
    <div class="rams-module">
        <div class="rams-module__content">
            <div id="calendar" style="min-height: 600px;"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js' integrity="sha384-WfE/vOHqht3KDj6FvpwQUf3UxEPUHoGJ3w1yZ8rhpLWnVigt8HjXL2zXqtcfS7mf" crossorigin="anonymous"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const calendarEl = document.getElementById('calendar');
    const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'timeGridWeek',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay'
        },
        slotMinTime: '07:00:00',
        slotMaxTime: '20:00:00',
        allDaySlot: false,
        height: 'auto',
        events: '{{ path('meeting_api_slots') }}',
        eventClick: function(info) {
            const baseUrl = '{{ path('meeting_show', {id: 0}) }}';
            window.location.href = baseUrl.replace('/0', '/' + info.event.id);
        },
        dateClick: function(info) {
            window.location.href = '{{ path('meeting_new') }}?start=' + info.dateStr;
        },
        eventDidMount: function(info) {
            const status = info.event.extendedProps.status;
            const bookedBy = info.event.extendedProps.bookedBy;
            
            if (bookedBy) {
                // Add a dot or indicator if booked
                let dot = document.createElement('div');
                dot.style.cssText = 'width: 8px; height: 8px; background: var(--rams-foreground); border-radius: 50%; display: inline-block; margin-right: 4px;';
                info.el.querySelector('.fc-event-title').prepend(dot);
                info.el.title = `${info.event.title}\nBooked by: ${bookedBy}`;
            }
        }
    });
    calendar.render();
});
</script>
{% endblock %}
