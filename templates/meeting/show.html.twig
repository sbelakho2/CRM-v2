{% extends 'base.html.twig' %}

{% block title %}Meeting: {{ slot.title }} - CRM{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
            <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">Dashboard</a>
                <span class="rams-breadcrumb-separator">/</span>
                <a href="{{ path('meeting_index') }}">Meetings</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ slot.title }}</span>
            </div>
            <h1 class="rams-page__title rams-mt-2">
                {{ slot.title }}
                <span class="rams-badge rams-badge--{{ slot.statusBadgeClass }}">{{ slot.status|title }}</span>
            </h1>
            {% if slot.description %}
            <p class="rams-page__subtitle">{{ slot.description }}</p>
            {% endif %}
        </div>
        <div class="rams-page__actions">
            <a href="{{ path('meeting_edit', {id: slot.id}) }}" class="rams-btn">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                </svg>
                Edit
            </a>
            {% if slot.isBooked %}
            <form action="{{ path('meeting_cancel', {id: slot.id}) }}" method="post" style="display: inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ slot.id) }}">
                <button type="submit" class="rams-btn--warning" onclick="return confirm('Cancel this meeting?');">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="8" cy="8" r="6"/><path d="M11 5L5 11M5 5L11 11"/>
                    </svg>
                    Cancel Meeting
                </button>
            </form>
            {% endif %}
            <form action="{{ path('meeting_delete', {id: slot.id}) }}" method="post" style="display: inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ slot.id) }}">
                <button type="submit" class="rams-btn--danger" onclick="return confirm('Delete this slot?');">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                         <path d="M2 4H14M5 4V2H11V4M6 4V13H10V4"/>
                    </svg>
                    Delete
                </button>
            </form>
        </div>
    </div>
    
    <div class="rams-grid rams-grid--3 rams-gap-6">
        <!-- Main Info -->
        <div class="rams-grid-span-2">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3>Meeting Details</h3>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-dl">
                        <dt>Date</dt>
                        <dd>{{ slot.startTime|date('l, F j, Y') }}</dd>
                        
                        <dt>Time</dt>
                        <dd>{{ slot.startTime|date('H:i') }} - {{ slot.endTime|date('H:i') }} ({{ slot.formattedDuration }})</dd>
                        
                        <dt>Timezone</dt>
                        <dd>{{ slot.timezone }}</dd>
                        
                        <dt>Meeting Type</dt>
                        <dd>
                            {{ slot.meetingType|replace({'_': ' '})|title }}
                        </dd>
                        
                        {% if slot.location %}
                        <dt>Location</dt>
                        <dd>{{ slot.location }}</dd>
                        {% endif %}
                        
                        {% if slot.meetingUrl %}
                        <dt>Meeting URL</dt>
                        <dd>
                            <a href="{{ slot.meetingUrl }}" target="_blank" class="rams-link">
                                {{ slot.meetingUrl }}
                            </a>
                        </dd>
                        {% endif %}
                        
                        {% if slot.meetingProvider %}
                        <dt>Provider</dt>
                        <dd>{{ slot.meetingProvider|title }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>
            
            {% if slot.isBooked %}
            <div class="rams-module rams-mt-6">
                <div class="rams-module__header">
                    <h3>Booking Information</h3>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-dl">
                        <dt>Name</dt>
                        <dd>{{ slot.bookedByName }}</dd>
                        
                        <dt>Email</dt>
                        <dd>
                            <a href="mailto:{{ slot.bookedByEmail }}" class="rams-link">{{ slot.bookedByEmail }}</a>
                        </dd>
                        
                        {% if slot.bookedByPhone %}
                        <dt>Phone</dt>
                        <dd>
                            <a href="tel:{{ slot.bookedByPhone }}" class="rams-link">{{ slot.bookedByPhone }}</a>
                        </dd>
                        {% endif %}
                        
                        {% if slot.bookedByCompany %}
                        <dt>Company</dt>
                        <dd>{{ slot.bookedByCompany }}</dd>
                        {% endif %}
                        
                        <dt>Booked At</dt>
                        <dd>{{ slot.bookedAt|date('M d, Y H:i') }}</dd>
                        
                        {% if slot.bookingNotes %}
                        <dt>Notes</dt>
                        <dd>{{ slot.bookingNotes|nl2br }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>
            {% endif %}
        </div>
        
        <!-- Sidebar -->
        <div>
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3>Status</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-rams-text--center rams-p-4">
                        {% if slot.isPast %}
                        <svg class="rams-icon rams-icon--xl rams-rams-text--muted rams-mb-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="8" cy="8" r="6"/><path d="M8 4V8L6 10"/>
                        </svg>
                        <p class="rams-rams-text--muted">This meeting has passed.</p>
                        {% elseif slot.isBooked %}
                        <svg class="rams-icon rams-icon--xl rams-rams-text--success rams-mb-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                             <circle cx="8" cy="8" r="6"/><path d="M6 8L7 9L10 6"/>
                        </svg>
                        <p>Meeting is booked and confirmed.</p>
                        {% elseif slot.isAvailable %}
                        <svg class="rams-icon rams-icon--xl rams-rams-text--warning rams-mb-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                             <circle cx="8" cy="8" r="6"/><path d="M8 4V8L10 10"/>
                        </svg>
                        <p>Slot is available for booking.</p>
                        {% elseif slot.isCancelled %}
                        <svg class="rams-icon rams-icon--xl rams-rams-text--danger rams-mb-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                             <circle cx="8" cy="8" r="6"/><path d="M11 5L5 11M5 5L11 11"/>
                        </svg>
                        <p>This meeting was cancelled.</p>
                        {% endif %}
                    </div>
                    
                    {% if slot.isAvailable and not slot.isPast %}
                    <hr class="rams-hr">
                    <p class="rams-rams-text--sm rams-rams-text--muted rams-mb-2">Share this booking link:</p>
                    <div class="rams-form__input-group">
                        <input type="text" class="rams-form__input" value="{{ url('meeting_book_slot', {token: slot.bookingToken}) }}" readonly id="booking-link">
                        <button type="button" class="rams-btn" onclick="copyBookingLink()">
                            <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="4" y="4" width="8" height="8" rx="1"/><path d="M12 4V2H2V12H4"/>
                            </svg>
                        </button>
                    </div>
                    {% endif %}
                </div>
            </div>
            
            <div class="rams-module rams-mt-4">
                <div class="rams-module__header">
                    <h3>Notifications</h3>
                </div>
                <div class="rams-module__content">
                    <ul class="rams-list">
                        <li class="rams-list__item">
                            <span class="rams-status-indicator rams-status-indicator--{{ slot.confirmationSent ? 'success' : 'neutral' }}"></span>
                            <span>Confirmation sent</span>
                            {% if slot.confirmationSentAt %}
                            <span class="rams-rams-text--muted rams-rams-text--xs">({{ slot.confirmationSentAt|date('M d') }})</span>
                            {% endif %}
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-status-indicator rams-status-indicator--{{ slot.reminderSent ? 'success' : 'neutral' }}"></span>
                            <span>Reminder sent</span>
                            {% if slot.reminderSentAt %}
                            <span class="rams-rams-text--muted rams-rams-text--xs">({{ slot.reminderSentAt|date('M d') }})</span>
                            {% endif %}
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function copyBookingLink() {
    const input = document.getElementById('booking-link');
    input.select();
    document.execCommand('copy');
    alert('Link copied to clipboard!');
}
</script>
{% endblock %}
