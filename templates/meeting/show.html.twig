{% extends 'base.html.twig' %}

{% block title %}{{ 'meeting.show_title_prefix'|trans }}{{ slot.title }}{{ 'meeting.show_title_suffix'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
            <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <a href="{{ path('meeting_index') }}">{{ 'meeting.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <span>{{ slot.title }}</span>
            </div>
            <h1 class="rams-page__title rams-mt-2">
                {{ slot.title }}
                <span class="rams-badge rams-badge--{{ slot.statusBadgeClass }}">{{ slot.status|title }}</span>
            </h1>
            {% if slot.description %}
            <p class="rams-page__subtitle">{{ slot.description }}</p>
            {% endif %}
        </div>
        <div class="rams-page__actions mobile-stack">
            <a href="{{ path('meeting_edit', {id: slot.id}) }}" class="rams-btn"> 
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                </svg>
                {{ 'common.edit'|trans }}
            </a>
            {% if slot.isBooked %}
            <form action="{{ path('meeting_cancel', {id: slot.id}) }}" method="post" class="rams-inline-block" onsubmit="return ramsConfirmSubmit(event, '{{ 'meeting.cancel_this_meeting'|trans|e('js') }}', {variant: 'warning'});">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ slot.id) }}">
                <button type="submit" class="rams-btn">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <circle cx="8" cy="8" r="6"/><path d="M11 5L5 11M5 5L11 11"/>
                    </svg>
                    {{ 'meeting.cancel_meeting'|trans }}
                </button>
            </form>
            {% endif %}
            <form action="{{ path('meeting_delete', {id: slot.id}) }}" method="post" class="rams-inline-block" onsubmit="return ramsConfirmSubmit(event, '{{ 'meeting.delete_this_slot'|trans|e('js') }}', {variant: 'danger'});">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ slot.id) }}">
                <button type="submit" class="rams-btn rams-btn--danger">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                         <path d="M2 4H14M5 4V2H11V4M6 4V13H10V4"/>
                    </svg>
                    {{ 'common.delete'|trans }}
                </button>
            </form>
        </div>
    </div>
    
    <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack">
        <!-- Main Info -->
        <div class="rams-grid-span-2 mobile-w-full">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.details'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-definition-list">
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'meeting.date'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ slot.startTime|date('l, F j, Y') }}</dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'meeting.time'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ slot.startTime|date('H:i') }} - {{ slot.endTime|date('H:i') }} ({{ slot.formattedDuration }})</dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'meeting.timezone'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ slot.timezone }}</dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'meeting.meeting_type'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                {{ slot.meetingType|replace({'_': ' '})|upper }}
                            </dd>
                        </div>
                        
                        {% if slot.location %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'meeting.location'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ slot.location }}</dd>
                        </div>
                        {% endif %}
                        
                        {% if slot.meetingUrl %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'meeting.meeting_url'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                <a href="{{ slot.meetingUrl }}" target="_blank" class="rams-link">
                                    {{ slot.meetingUrl }}
                                </a>
                            </dd>
                        </div>
                        {% endif %}
                        
                        {% if slot.meetingProvider %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'meeting.provider'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ slot.meetingProvider|upper }}</dd>
                        </div>
                        {% endif %}
                    </dl>
                </div>
            </div>
            
            {% if slot.isBooked %}
            <div class="rams-module rams-mt-6">
                <div class="rams-module__header">
                    <h3 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.booking_information'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-definition-list">
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.name'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ slot.bookedByName }}</dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.email'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                <a href="mailto:{{ slot.bookedByEmail }}" class="rams-link">{{ slot.bookedByEmail }}</a>
                            </dd>
                        </div>
                        
                        {% if slot.bookedByPhone %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.phone'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                <a href="tel:{{ slot.bookedByPhone }}" class="rams-link">{{ slot.bookedByPhone }}</a>
                            </dd>
                        </div>
                        {% endif %}
                        
                        {% if slot.bookedByCompany %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.company'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ slot.bookedByCompany }}</dd>
                        </div>
                        {% endif %}
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'meeting.booked_at'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ slot.bookedAt|date('M d, Y H:i') }}</dd>
                        </div>
                        
                        {% if slot.bookingNotes %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.notes'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ slot.bookingNotes|nl2br }}</dd>
                        </div>
                        {% endif %}
                    </dl>
                </div>
            </div>
            {% endif %}
        </div>
        
        <!-- Sidebar -->
        <div class="mobile-w-full">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.status_heading'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-text--center rams-p-4">
                        {% if slot.isPast %}
                        <svg class="rams-icon rams-icon--xl rams-text--muted rams-mb-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <circle cx="8" cy="8" r="6"/><path d="M8 4V8L6 10"/>
                        </svg>
                        <p class="rams-text--muted">{{ 'meeting.meeting_passed'|trans }}</p>
                        {% elseif slot.isBooked %}
                        <svg class="rams-icon rams-icon--xl rams-text--success rams-mb-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                             <circle cx="8" cy="8" r="6"/><path d="M6 8L7 9L10 6"/>
                        </svg>
                        <p>{{ 'meeting.meeting_confirmed'|trans }}</p>
                        {% elseif slot.isAvailable %}
                        <svg class="rams-icon rams-icon--xl rams-text--warning rams-mb-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                             <circle cx="8" cy="8" r="6"/><path d="M8 4V8L10 10"/>
                        </svg>
                        <p>{{ 'meeting.slot_available'|trans }}</p>
                        {% elseif slot.isCancelled %}
                        <svg class="rams-icon rams-icon--xl rams-text--danger rams-mb-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                             <circle cx="8" cy="8" r="6"/><path d="M11 5L5 11M5 5L11 11"/>
                        </svg>
                        <p>{{ 'meeting.meeting_was_cancelled'|trans }}</p>
                        {% endif %}
                    </div>
                    
                    {% if slot.isAvailable and not slot.isPast %}
                    <hr class="rams-border-b rams-m-0 rams-mb-3"> 
                    <p class="rams-text--sm rams-text--muted rams-mb-2">{{ 'meeting.share_booking_link'|trans }}</p>
                    <div class="rams-flex rams-gap-2"> 
                        <input type="text" class="rams-form__input rams-flex-1"  value="{{ url('meeting_book_slot', {token: slot.bookingToken}) }}" readonly id="booking-link" aria-label="{{ 'meeting.share_booking_link'|trans }}"> 
                        <button type="button" class="rams-btn"  onclick="copyBookingLink()">
                            <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <rect x="4" y="4" width="8" height="8" rx="1"/><path d="M12 4V2H2V12H4"/>
                            </svg>
                            {{ 'common.copy'|trans }}
                        </button>
                    </div>
                    {% endif %}
                </div>
            </div>
            
            <div class="rams-module rams-mt-4">
                <div class="rams-module__header">
                    <h3 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.notifications'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <ul class="rams-list">
                        <li class="rams-list__item">
                            {% if slot.confirmationSent %} <span class="rams-andon rams-andon--success"><span class="rams-andon__light"></span></span> {% else %} <span class="rams-andon"><span class="rams-andon__light rams-andon__light--off"></span></span> {% endif %}        
                            <span>{{ 'meeting.confirmation_sent'|trans }}</span>
                            {% if slot.confirmationSentAt %}
                            <span class="rams-text--muted rams-text--xs">({{ slot.confirmationSentAt|date('M d') }})</span>
                            {% endif %}
                        </li>
                        <li class="rams-list__item">
                            {% if slot.reminderSent %} <span class="rams-andon rams-andon--success"><span class="rams-andon__light"></span></span> {% else %} <span class="rams-andon"><span class="rams-andon__light rams-andon__light--off"></span></span> {% endif %}        
                            <span>{{ 'meeting.reminder_sent'|trans }}</span>
                            {% if slot.reminderSentAt %}
                            <span class="rams-text--muted rams-text--xs">({{ slot.reminderSentAt|date('M d') }})</span>
                            {% endif %}
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function copyBookingLink() {
    const input = document.getElementById('booking-link');
    input.select();
    document.execCommand('copy');
    ramsAlert('{{ 'meeting.link_copied'|trans }}', {title: '{{ 'meeting.copy'|trans }}'});
}
</script>
{% endblock %}
