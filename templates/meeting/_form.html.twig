{{ form_start(form, {'attr': {'class': 'rams-form'}}) }}
    <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack">
        <div class="rams-grid-span-2 mobile-w-full">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.details'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    {{ form_row(form.title) }}
                    {{ form_row(form.description, {'attr': {'rows': 3}}) }}
                    
                    <div class="rams-grid rams-grid--2 rams-gap-4">
                        {{ form_row(form.meetingType) }}
                        {{ form_row(form.durationMinutes) }}
                    </div>
                    
                    <div class="rams-grid rams-grid--2 rams-gap-4">
                        {{ form_row(form.startTime) }}
                        {{ form_row(form.timezone) }}
                    </div>
                </div>
            </div>
            
            <div class="rams-module rams-mt-4">
                <div class="rams-module__header">
                    <h3 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.location_and_video'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    {{ form_row(form.location) }}
                    
                    <div class="rams-grid rams-grid--2 rams-gap-4">
                        {{ form_row(form.meetingProvider) }}
                        {{ form_row(form.meetingUrl) }}
                    </div>
                </div>
            </div>

            <div class="rams-actions rams-mt-6 mobile-stack">
                <button type="submit" class="rams-btn rams-btn--primary"> 
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                    </svg>
                    {{ button_label|default('meeting.save_slot'|trans) }}
                </button>
                <a href="{{ path('meeting_index') }}" class="rams-btn rams-btn--ghost">{{  'common.cancel'|trans }}</a>
            </div>
        </div>
        
        <!-- Sidebar Help -->
        <div class="mobile-w-full">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.slot_configuration'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <p class="rams-text--sm rams-text--muted rams-mb-4">
                        {{ 'meeting.slot_config_desc'|trans }}
                    </p>
                    <ul class="rams-list">
                        <li class="rams-list__item">
                            <svg class="rams-icon rams-text--muted" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <circle cx="8" cy="8" r="6"/><path d="M8 4V8L10 10"/>
                            </svg>
                            <span>{{ 'meeting.duration_includes_buffer'|trans }}</span>
                        </li>
                        <li class="rams-list__item">
                            <svg class="rams-icon rams-text--muted" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <rect x="2" y="3" width="12" height="10" rx="2"/><path d="M8 7V13M4 10H12"/>
                            </svg>
                            <span>{{ 'meeting.video_links_auto'|trans }}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{{ form_end(form) }}
