{% extends 'base.html.twig' %}

{% block title %}{{ 'meeting.new_title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
            <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <a href="{{ path('meeting_index') }}">{{ 'meeting.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <span>{{ 'meeting.new_slot'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'meeting.create_slot'|trans }}</h1>
        </div>
    </div>
    
    {{ include('meeting/_form.html.twig', {button_label: 'meeting.create_slot'|trans}) }}
</div>
{% endblock %}
