{% extends 'base.html.twig' %}

{% block title %}{{ 'meeting.booking_confirmed_title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-flex rams-items-center rams-justify-center"    style="min-height: 60vh;">
        <div class="rams-module" style="max-width: 600px; width: 100%;">
            <div class="rams-module__content rams-text--center rams-p-8">
                <div class="rams-mb-6">
                    <svg class="rams-icon rams-icon--2xl rams-text--success" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="8" cy="8" r="6"/><path d="M6 8L7 9L10 6"/>
                    </svg>
                </div>
                
                <h1 class="rams-text-2xl rams-text--bold rams-mb-4">{{ 'meeting.booking_confirmed'|trans }}</h1>
                <p class="rams-text--muted rams-mb-8">{{ 'meeting.booking_confirmed_desc'|trans }}</p>
                
                <div class="rams-bg-panel rams-p-6 rams-rounded-lg rams-text--left rams-mb-8">
                    <div class="rams-stack rams-gap-3"> <div> <span class="rams-text--muted rams-text--xs rams-block">{{   
                         'meeting.title'|trans }}</span> <strong>{{ 
                         slot.title }}</strong> </div> <div> <span class="rams-text--muted rams-text--xs rams-block">{{ 
                        
                         'meeting.when'|trans }}</span> <span>{{ 
                         slot.startTime|date('l, F j, Y') }}<br>{{ slot.startTime|date('H:i') }} - {{ slot.endTime|date('H:i') }}</span> </div> 
                        
                        {% if slot.location %}
                        <div> <span class="rams-text--muted rams-text--xs rams-block">{{  'meeting.location'|trans }}</span> <span>{{ 
                         slot.location }}</span> </div> 
                        {% endif %}
                        
                        {% if slot.meetingUrl %}
                        <div> <span class="rams-text--muted rams-text--xs rams-block">{{  'meeting.join_url'|trans }}</span> <a 
                         href="{{ slot.meetingUrl }}" target="_blank" class="rams-link">{{ slot.meetingUrl }}</a> </div> 
                        {% endif %}
                    </div> 
                </div>
                
                <div class="rams-actions rams-justify-center">
                    <a href="{{ path('app_dashboard') }}" class="rams-btn rams-btn--primary">{{ 'meeting.return_to_dashboard'|trans }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
