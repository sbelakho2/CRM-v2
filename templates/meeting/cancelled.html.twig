{% extends 'base.html.twig' %}

{% block title %}{{ 'meeting.cancelled_title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-flex rams-items-center rams-justify-center"    style="min-height: 60vh;">
        <div class="rams-module" style="max-width: 500px; width: 100%;">
            <div class="rams-module__content rams-text--center rams-p-8">
                <div class="rams-mb-6">
                    <svg class="rams-icon rams-icon--2xl rams-text--success" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                         <circle cx="8" cy="8" r="6"/><path d="M6 8L7 9L10 6"/>
                    </svg>
                </div>
                
                <h1 class="rams-text-2xl rams-text--bold rams-mb-4">{{ 'meeting.cancelled'|trans }}</h1>
                <p class="rams-text--muted rams-mb-8">{{ 'meeting.cancelled_desc'|trans }}</p>
                
                <div class="rams-bg-panel rams-p-6 rams-rounded-lg rams-text--left rams-mb-8">
                    <strong class="rams-block rams-mb-2">{{ slot.title }}</strong>
                    <span class="rams-text--muted rams-text--sm">
                        {{ slot.startTime|date('l, F j, Y') }} {{ 'meeting.at'|trans }}  {{ slot.startTime|date('H:i') }}
                    </span>
                </div>
                
                <p class="rams-text--muted rams-text--sm">
                    {{ 'meeting.organizer_notified'|trans }}
                </p>
                
                 <div class="rams-actions rams-justify-center rams-mt-8">
                    <a href="{{ path('app_dashboard') }}" class="rams-btn rams-btn--primary">{{ 'meeting.return_to_dashboard'|trans }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
