{% extends 'base.html.twig' %}

{% block title %}{{ 'meeting.title_crm'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
            <h1 class="rams-page__title">
                <svg class="rams-icon rams-icon--lg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="4" width="12" height="8" rx="1"/><circle cx="8" cy="8" r="2"/><path d="M5 2V4M11 2V4"/>
                </svg>
                {{ 'meeting.title'|trans }}
            </h1>
            <p class="rams-page__subtitle">{{ 'meeting.subtitle'|trans }}</p>
        </div>
        <div class="rams-page__actions mobile-stack">
            <a href="{{ path('meeting_my_link') }}" class="rams-btn uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 8.5C8.27614 8.5 8.5 8.27614 8.5 8L8.5 3.5C8.5 3.22386 8.27614 3 8 3C7.72386 3 7.5 3.22386 7.5 3.5L7.5 8C7.5 8.27614 7.72386 8.5 8 8.5Z"/>
                    <path d="M8 13C10.7614 13 13 10.7614 13 8C13 5.23858 10.7614 3 8 3C5.23858 3 3 5.23858 3 8C3 10.7614 5.23858 13 8 13Z"/>
                    <path d="M11 11L14 14"/>
                </svg>
                {{ 'meeting.booking_link'|trans }}
            </a>
            <a href="{{ path('meeting_generate') }}" class="rams-btn uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2L10 6L14 8L10 10L8 14L6 10L2 8L6 6L8 2Z"/>
                </svg>
                {{ 'meeting.generate_slots'|trans }}
            </a>
            <a href="{{ path('meeting_new') }}" class="rams-btn rams-btn--primary uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 4V12M4 8H12"/>
                </svg>
                {{ 'meeting.new_slot'|trans }}
            </a>
        </div>
    </div>
    
    <!-- Stats -->
    <div class="rams-grid rams-grid--4 rams-mb-6">
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'meeting.available_slots'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ statistics.available|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'meeting.upcoming_bookings'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ statistics.bookedUpcoming|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'meeting.this_week'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ statistics.thisWeek|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'meeting.total_booked'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ statistics.totalBooked|default(0) }}</div>
            </div>
        </div>
    </div>
    
    <div class="rams-grid rams-grid--2 rams-gap-6">
        <!-- Today's Schedule -->
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'meeting.todays_schedule'|trans }}</h3>
                <a href="{{ path('meeting_calendar') }}" class="rams-btn rams-btn--sm rams-btn--ghost uppercase">
                    {{ 'meeting.view_calendar'|trans }}
                </a>
            </div>
            <div class="rams-module__content rams-p-0">
                {% if today|length > 0 %}
                <ul class="rams-meeting-list">
                    {% for slot in today %}
                    <li class="rams-meeting-item">
                        <div class="rams-meeting-time">
                            <div class="rams-meeting-time__hour">{{ slot.startTime|date('H:i') }}</div>
                            <div class="rams-meeting-time__duration">{{ slot.formattedDuration }}</div>
                        </div>
                        <div class="rams-meeting-info">
                            <div class="rams-meeting-title">
                                <a href="{{ path('meeting_show', {id: slot.id}) }}">{{ slot.title }}</a>
                                <span class="rams-badge rams-badge--{{ slot.statusBadgeClass }}">{{ slot.status }}</span>
                            </div>
                            <div class="rams-meeting-meta">
                                <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <circle cx="8" cy="8" r="6"/><path d="M8 4V8L10 10"/>
                                </svg>
                                {{ meetingTypes|filter((v, k) => v == slot.meetingType)|keys|first }}
                            </div>
                            {% if slot.bookedByName %}
                            <div class="rams-meeting-booker">
                                <span class="rams-meeting-booker__avatar">{{ slot.bookedByName[:1]|upper }}</span>
                                <span>{{ slot.bookedByName }}</span>
                                {% if slot.bookedByCompany %}
                                <span class="rams-text--muted">- {{ slot.bookedByCompany }}</span>
                                {% endif %}
                            </div>
                            {% endif %}
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <div class="rams-empty-state">
                    <svg class="rams-icon rams-icon--xl rams-text--muted rams-mb-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="8" cy="8" r="6"/><path d="M8 4V8L10 10"/>
                    </svg>
                    <p class="rams-text--muted">{{ 'meeting.no_meetings_today'|trans }}</p>
                </div>
                {% endif %}
            </div>
        </div>
        
        <!-- Upcoming Bookings -->
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'meeting.upcoming_bookings'|trans }}</h3>
            </div>
            <div class="rams-module__content rams-p-0">
                {% if upcoming|length > 0 %}
                <ul class="rams-meeting-list">
                    {% for slot in upcoming|slice(0, 5) %}
                    <li class="rams-meeting-item">
                        <div class="rams-meeting-time">
                            <div class="rams-meeting-time__hour">{{ slot.startTime|date('M d') }}</div>
                            <div class="rams-meeting-time__duration">{{ slot.startTime|date('H:i') }}</div>
                        </div>
                        <div class="rams-meeting-info">
                            <div class="rams-meeting-title">
                                <a href="{{ path('meeting_show', {id: slot.id}) }}">{{ slot.title }}</a>
                            </div>
                            {% if slot.bookedByName %}
                            <div class="rams-meeting-booker">
                                <span class="rams-meeting-booker__avatar">{{ slot.bookedByName[:1]|upper }}</span>
                                <span>{{ slot.bookedByName }}</span>
                            </div>
                            {% endif %}
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <div class="rams-empty-state">
                    <svg class="rams-icon rams-icon--xl rams-text--muted rams-mb-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 4L4 12M4 4L12 12"/>
                    </svg>
                    <p class="rams-text--muted">{{ 'meeting.no_upcoming_bookings'|trans }}</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    
    <!-- Available Slots -->
    <div class="rams-module rams-mt-6">
        <div class="rams-module__header">
            <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'meeting.available_slots'|trans }} ({{ available|length }})</h3>
        </div>
        <div class="rams-module__content rams-p-0">
            {% if available|length > 0 %}
            <div class="rams-table-container">
                <table class="rams-table">
                    <thead>
                        <tr>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'meeting.date_time'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'common.name'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'common.type'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'meeting.duration'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'meeting.location'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest rams-text--right">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for slot in available|slice(0, 10) %}
                        <tr>
                            <td>
                                <strong>{{ slot.startTime|date('M d, Y') }}</strong><br>
                                <span class="rams-text--muted">{{ slot.startTime|date('H:i') }} - {{ slot.endTime|date('H:i') }}</span>
                            </td>
                            <td>{{ slot.title }}</td>
                            <td>
                                {{ meetingTypes|filter((v, k) => v == slot.meetingType)|keys|first }}
                            </td>
                            <td>{{ slot.formattedDuration }}</td>
                            <td>{{ slot.location ?: '-' }}</td>
                            <td class="rams-text--right">
                                <a href="{{ path('meeting_edit', {id: slot.id}) }}" class="rams-btn rams-btn--icon rams-btn--ghost">
                                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                                    </svg>
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="rams-empty-state">
                <svg class="rams-icon rams-icon--xl rams-text--muted rams-mb-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 4V12M4 8H12"/>
                </svg>
                <p class="rams-text--muted">{{ 'meeting.no_available_slots'|trans }}</p>
                <a href="{{ path('meeting_generate') }}" class="rams-btn rams-btn--primary uppercase rams-mt-3">
                    {{ 'meeting.generate_slots'|trans }}
                </a>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
