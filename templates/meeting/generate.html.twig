{% extends 'base.html.twig' %}

{% block title %}{{ 'meeting.generate_title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
            <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <a href="{{ path('meeting_index') }}">{{ 'meeting.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <span>{{ 'meeting.generate_slots'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'meeting.generate_recurring'|trans }}</h1>
            <p class="rams-page__subtitle">{{ 'meeting.generate_desc'|trans }}</p>
        </div>
    </div>
    
    <form method="post" class="rams-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('meeting_generate') }}">
        <div class="rams-grid rams-grid--3 rams-gap-6">
            <div class="rams-grid-span-2">
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h2 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.meeting_template'|trans }}</h2>
                    </div>
                    <div class="rams-module__content">
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-title">{{      'meeting.meeting_title_label'|trans }}</label>
                            <input type="text" name="title" id="meeting-title" class="rams-form__input" value="{{ 'meeting.meeting_title_default'|trans }}" required>
                        </div>
                        
                        <div class="rams-grid rams-grid--2 rams-gap-4">
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-type">{{      'meeting.meeting_type'|trans }}</label>
                                <select name="meetingType" id="meeting-type" class="rams-form__select">
                                    {% for label, value in meetingTypes %}
                                    <option value="{{ value }}">{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-duration">{{      'meeting.duration'|trans }}</label>
                                <select name="duration" id="meeting-duration" class="rams-form__select">
                                    {% for label, value in durations %}
                                    <option value="{{ value }}" {% if value == 30 %}selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        
                        <div class="rams-grid rams-grid--2 rams-gap-4">
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-location">{{      'meeting.location'|trans }}</label>
                                <input type="text" name="location" id="meeting-location" class="rams-form__input" placeholder="{{ 'meeting.location_placeholder'|trans }}">
                            </div>
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-url">{{      'meeting.meeting_url'|trans }}</label>
                                <input type="url" name="meetingUrl" id="meeting-url" class="rams-form__input" placeholder="{{ 'meeting.url_placeholder'|trans }}">
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="rams-module rams-mt-4">
                    <div class="rams-module__header">
                        <h3 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.schedule'|trans }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.days_of_week'|trans }}</label>
                            <div class="rams-flex rams-flex-wrap rams-gap-4">
                                <label class="rams-flex rams-items-center rams-gap-2">
                                    <input type="checkbox" name="weekdays[]" value="1" checked> <span>{{ 'meeting.day_mon'|trans }}</span>
                                </label>
                                <label class="rams-flex rams-items-center rams-gap-2">
                                    <input type="checkbox" name="weekdays[]" value="2" checked> <span>{{ 'meeting.day_tue'|trans }}</span>
                                </label>
                                <label class="rams-flex rams-items-center rams-gap-2">
                                    <input type="checkbox" name="weekdays[]" value="3" checked> <span>{{ 'meeting.day_wed'|trans }}</span>
                                </label>
                                <label class="rams-flex rams-items-center rams-gap-2">
                                    <input type="checkbox" name="weekdays[]" value="4" checked> <span>{{ 'meeting.day_thu'|trans }}</span>
                                </label>
                                <label class="rams-flex rams-items-center rams-gap-2">
                                    <input type="checkbox" name="weekdays[]" value="5" checked> <span>{{ 'meeting.day_fri'|trans }}</span>
                                </label>
                                <label class="rams-flex rams-items-center rams-gap-2">
                                    <input type="checkbox" name="weekdays[]" value="6"> <span>{{ 'meeting.day_sat'|trans }}</span>
                                </label>
                                <label class="rams-flex rams-items-center rams-gap-2">
                                    <input type="checkbox" name="weekdays[]" value="0"> <span>{{ 'meeting.day_sun'|trans }}</span>
                                </label>
                            </div>
                        </div>
                        
                        <div class="rams-grid rams-grid--3 rams-gap-4">
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-start-time">{{      'meeting.start_time'|trans }}</label>
                                <input type="time" name="startTime" id="meeting-start-time" class="rams-form__input" value="09:00" required>
                            </div>
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-end-time">{{      'meeting.end_time'|trans }}</label>
                                <input type="time" name="endTime" id="meeting-end-time" class="rams-form__input" value="17:00" required>
                            </div>
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-interval">{{      'meeting.interval_mins'|trans }}</label>
                                <select name="interval" id="meeting-interval" class="rams-form__select">
                                    <option value="60">{{ 'meeting.duration_60_mins'|trans }}</option>
                                    <option value="45">{{ 'meeting.duration_45_mins'|trans }}</option>
                                    <option value="30">{{ 'meeting.duration_30_mins'|trans }}</option>
                                    <option value="15">{{ 'meeting.duration_15_mins'|trans }}</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="rams-grid rams-grid--2 rams-gap-4">
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-start-date">{{      'meeting.date_range'|trans }}</label>
                                <input type="date" name="startDate" id="meeting-start-date" class="rams-form__input" value="{{ 'now'|date('Y-m-d') }}" required>
                            </div>
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted" for="meeting-end-date">{{      'meeting.until'|trans }}</label>
                                <input type="date" name="endDate" id="meeting-end-date" class="rams-form__input" value="{{ '+1 month'|date('Y-m-d') }}" required>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="rams-actions rams-mt-6">
                    <button type="submit" class="rams-btn rams-btn--primary rams-uppercase"> 
                        <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                             <circle cx="8" cy="8" r="6"/><path d="M8 4V8L10 10"/>
                        </svg>
                        {{ 'meeting.generate_slots'|trans }}
                    </button>
                    <a href="{{ path('meeting_index') }}" class="rams-btn rams-btn--ghost rams-uppercase">{{  'common.cancel'|trans }}</a>
                </div>
            </div>
            
            <div>
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3 class="rams-font-mono rams-text-2xs rams-uppercase rams-text--muted">{{      'meeting.bulk_generation'|trans }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <p class="rams-text--sm rams-text--muted">
                            {{ 'meeting.bulk_generation_desc'|trans }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
{% endblock %}
