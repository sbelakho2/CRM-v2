{% extends 'base.html.twig' %}

{% block title %}Cancel Meeting - CRM{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-grid rams-grid--1 rams-place-rams-items-center" style="min-height: 60vh;">
        <div class="rams-module" style="max-width: 500px; width: 100%;">
            <div class="rams-module__header rams-bg-warning-bg rams-rams-text--warning rams-border-b-warning">
                <div class="rams-flex rams-items-center rams-gap-2">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M8 2L2 14H14L8 2Z"/><path d="M8 6V10M8 12V12.01"/>
                    </svg>
                    <h3 class="rams-m-0">Cancel Meeting</h3>
                </div>
            </div>
            <div class="rams-module__content rams-p-6">
                <p class="rams-rams-text--center rams-mb-6">Are you sure you want to cancel this meeting?</p>
                
                <div class="rams-bg-surface-alt rams-p-4 rams-rounded-lg rams-mb-6">
                    <strong class="rams-block rams-mb-1">{{ slot.title }}</strong>
                    <span class="rams-rams-text--muted rams-rams-text--sm">
                        {{ slot.startTime|date('l, F j, Y') }}<br>
                        {{ slot.startTime|date('H:i') }} - {{ slot.endTime|date('H:i') }}
                    </span>
                </div>
                
                <form method="post" class="rams-actions rams-justify-center">
                    <button type="submit" class="rams-btn--danger">
                        Yes, Cancel Meeting
                    </button>
                    <a href="javascript:history.back()" class="rams-btn--ghost">
                        No, Keep It
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
