{% extends 'base.html.twig' %}

{% block title %}Email Campaigns{% endblock %}

{% block body %}
<div class="p-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-semibold text-white mb-2">Email Campaigns</h1>
            <p class="text-sm text-zinc-400">Multi-touch email sequences with tracking</p>
        </div>
        <a href="{{ path('app_email_campaign_new') }}" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Campaign
        </a>
    </div>

    <!-- Filters -->
    <div class="flex items-center gap-3 mb-6">
        <div class="flex items-center gap-2 bg-zinc-900 border border-zinc-800 rounded-lg p-1">
            <a href="{{ path('app_email_campaign_index', {status: 'all', language: currentLanguage}) }}" 
               class="px-3 py-1.5 text-sm rounded-md transition-colors {{ currentStatus == 'all' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white' }}">
                All
            </a>
            <a href="{{ path('app_email_campaign_index', {status: 'active', language: currentLanguage}) }}" 
               class="px-3 py-1.5 text-sm rounded-md transition-colors {{ currentStatus == 'active' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white' }}">
                Active
            </a>
            <a href="{{ path('app_email_campaign_index', {status: 'inactive', language: currentLanguage}) }}" 
               class="px-3 py-1.5 text-sm rounded-md transition-colors {{ currentStatus == 'inactive' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white' }}">
                Inactive
            </a>
        </div>

        <div class="flex items-center gap-2 bg-zinc-900 border border-zinc-800 rounded-lg p-1">
            <a href="{{ path('app_email_campaign_index', {status: currentStatus, language: 'all'}) }}" 
               class="px-3 py-1.5 text-sm rounded-md transition-colors {{ currentLanguage == 'all' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white' }}">
                All Languages
            </a>
            <a href="{{ path('app_email_campaign_index', {status: currentStatus, language: 'EN'}) }}" 
               class="px-3 py-1.5 text-sm rounded-md transition-colors {{ currentLanguage == 'EN' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white' }}">
                EN
            </a>
            <a href="{{ path('app_email_campaign_index', {status: currentStatus, language: 'FR'}) }}" 
               class="px-3 py-1.5 text-sm rounded-md transition-colors {{ currentLanguage == 'FR' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white' }}">
                FR
            </a>
        </div>
    </div>

    <!-- Campaigns Grid -->
    {% if campaigns is empty %}
        <div class="text-center py-16 bg-zinc-900 border border-zinc-800 rounded-lg">
            <svg class="mx-auto h-12 w-12 text-zinc-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <h3 class="text-lg font-medium text-zinc-300 mb-1">No campaigns yet</h3>
            <p class="text-sm text-zinc-500 mb-4">Get started by creating your first email campaign.</p>
            <a href="{{ path('app_email_campaign_new') }}" class="geist-button inline-flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 3v10M3 8h10"/>
                </svg>
                Create Campaign
            </a>
        </div>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            {% for campaign in campaigns %}
                {% set metrics = campaignMetrics[campaign.id] %}
                <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6 hover:border-zinc-700 transition-colors">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-2">
                                <h3 class="text-lg font-medium text-white">
                                    <a href="{{ path('app_email_campaign_show', {id: campaign.id}) }}" class="hover:text-zinc-300 transition-colors">
                                        {{ campaign.name }}
                                    </a>
                                </h3>
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full {{ campaign.active ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 'bg-zinc-700 text-zinc-400 border border-zinc-600' }}">
                                    {{ campaign.active ? 'Active' : 'Inactive' }}
                                </span>
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20">
                                    {{ campaign.language }}
                                </span>
                            </div>
                            {% if campaign.description %}
                                <p class="text-sm text-zinc-400 mb-4">{{ campaign.description }}</p>
                            {% endif %}
                            <div class="text-xs text-zinc-500">
                                {{ campaign.touchCount }}-touch sequence
                            </div>
                        </div>
                    </div>

                    <!-- Metrics Grid -->
                    <div class="grid grid-cols-5 gap-4 pt-4 border-t border-zinc-800">
                        <div>
                            <div class="text-2xl font-semibold text-white">{{ metrics.total_sent }}</div>
                            <div class="text-xs text-zinc-400">Sent</div>
                        </div>
                        <div>
                            <div class="text-2xl font-semibold text-green-400">{{ metrics.open_rate|number_format(1) }}%</div>
                            <div class="text-xs text-zinc-400">Open Rate</div>
                        </div>
                        <div>
                            <div class="text-2xl font-semibold text-blue-400">{{ metrics.click_rate|number_format(1) }}%</div>
                            <div class="text-xs text-zinc-400">Click Rate</div>
                        </div>
                        <div>
                            <div class="text-2xl font-semibold text-purple-400">{{ metrics.reply_rate|number_format(1) }}%</div>
                            <div class="text-xs text-zinc-400">Reply Rate</div>
                        </div>
                        <div>
                            <div class="text-2xl font-semibold text-red-400">{{ metrics.bounce_rate|number_format(1) }}%</div>
                            <div class="text-xs text-zinc-400">Bounce Rate</div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center gap-2 mt-4 pt-4 border-t border-zinc-800">
                        <a href="{{ path('app_email_campaign_show', {id: campaign.id}) }}" class="text-sm text-zinc-400 hover:text-white transition-colors">
                            View Details
                        </a>
                        <span class="text-zinc-700">•</span>
                        <a href="{{ path('app_email_campaign_send', {id: campaign.id}) }}" class="text-sm text-zinc-400 hover:text-white transition-colors">
                            Send Emails
                        </a>
                        <span class="text-zinc-700">•</span>
                        <a href="{{ path('app_email_campaign_analytics', {id: campaign.id}) }}" class="text-sm text-zinc-400 hover:text-white transition-colors">
                            Analytics
                        </a>
                        <span class="text-zinc-700">•</span>
                        <a href="{{ path('app_email_campaign_edit', {id: campaign.id}) }}" class="text-sm text-zinc-400 hover:text-white transition-colors">
                            Edit
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
