{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.ab_test.title'|trans }} - {{ campaign.name }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Breadcrumb #}
        <nav class="rams-breadcrumb">
            <ol class="rams-breadcrumb__list">
                <li class="rams-breadcrumb__item"><a href="{{ path('app_email_campaign_index') }}" class="rams-breadcrumb__link">{{ 'email_campaign.title'|trans }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item"><a href="{{ path('app_email_campaign_show', {id: campaign.id}) }}" class="rams-breadcrumb__link">{{ campaign.name }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'email_campaign.ab_test.title'|trans }}</li>
            </ol>
        </nav>

        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.ab_test.setup'|trans|default('A/B Test Setup') }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.ab_test.setup_subtitle'|trans|default('Configure test variants for') }} {{ campaign.name }}</p>
            </div>
            <div class="rams-page__actions">
                <a href="{{ path('app_email_campaign_show', {id: campaign.id}) }}" class="rams-btn rams-btn--secondary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    {{ 'common.back'|trans }}
                </a>
            </div>
        </div>

        <div class="rams-layout rams-layout--sidebar-right">
            {# Main Form #}
            <div class="rams-layout__main">
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h2 class="rams-module__title">{{ 'email_campaign.ab_test.configure'|trans|default('Configure A/B Test') }}</h2>
                    </div>
                    <div class="rams-module__content">
                        <form method="post">
                            {# Test Type #}
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-dymo">{{ 'email_campaign.ab_test.what_to_test'|trans|default('What would you like to test?') }}</label>
                                <div class="rams-test-type-grid">
                                    <label class="rams-test-type-card">
                                        <input type="radio" name="test_type" value="subject_line" checked>
                                        <div class="rams-test-type-card__content">
                                            <svg class="rams-test-type-card__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                            </svg>
                                            <h3 class="rams-test-type-card__title">{{ 'email_campaign.ab_test.subject_lines'|trans|default('Subject Lines') }}</h3>
                                            <p class="rams-test-type-card__description">{{ 'email_campaign.ab_test.subject_lines_desc'|trans|default('Test different subject line variations') }}</p>
                                        </div>
                                    </label>
                                    <label class="rams-test-type-card">
                                        <input type="radio" name="test_type" value="send_time">
                                        <div class="rams-test-type-card__content">
                                            <svg class="rams-test-type-card__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            <h3 class="rams-test-type-card__title">{{ 'email_campaign.ab_test.send_time'|trans|default('Send Time') }}</h3>
                                            <p class="rams-test-type-card__description">{{ 'email_campaign.ab_test.send_time_desc'|trans|default('Find optimal send time') }}</p>
                                        </div>
                                    </label>
                                    <label class="rams-test-type-card">
                                        <input type="radio" name="test_type" value="content">
                                        <div class="rams-test-type-card__content">
                                            <svg class="rams-test-type-card__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                            </svg>
                                            <h3 class="rams-test-type-card__title">{{ 'email_campaign.ab_test.content'|trans|default('Email Content') }}</h3>
                                            <p class="rams-test-type-card__description">{{ 'email_campaign.ab_test.content_desc'|trans|default('Test different content variations') }}</p>
                                        </div>
                                    </label>
                                    <label class="rams-test-type-card">
                                        <input type="radio" name="test_type" value="from_name">
                                        <div class="rams-test-type-card__content">
                                            <svg class="rams-test-type-card__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                            </svg>
                                            <h3 class="rams-test-type-card__title">{{ 'email_campaign.ab_test.from_name'|trans|default('From Name') }}</h3>
                                            <p class="rams-test-type-card__description">{{ 'email_campaign.ab_test.from_name_desc'|trans|default('Test different sender names') }}</p>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            {# Test Configuration #}
                            <div class="rams-form__group">
                                <label for="testPercentage" class="rams-form__label rams-dymo">{{ 'email_campaign.ab_test.audience_size'|trans|default('Test Audience Size') }}</label>
                                <input type="range" class="rams-form__range" id="testPercentage" name="test_percentage" 
                                       min="5" max="50" value="20" step="5">
                                <div class="rams-range-labels">
                                    <span>5%</span>
                                    <span class="rams-range-labels__current" id="percentageValue">20%</span>
                                    <span>50%</span>
                                </div>
                                <span class="rams-form__hint">{{ 'email_campaign.ab_test.audience_hint'|trans|default('This percentage of your audience will be split between test variants. The winner will be sent to the remaining contacts.') }}</span>
                            </div>

                            <div class="rams-form__group">
                                <label for="testDuration" class="rams-form__label rams-dymo">{{ 'email_campaign.ab_test.duration'|trans|default('Test Duration') }}</label>
                                <select class="rams-form__select" id="testDuration" name="test_duration">
                                    <option value="4">4 {{ 'common.hours'|trans|default('hours') }}</option>
                                    <option value="12">12 {{ 'common.hours'|trans|default('hours') }}</option>
                                    <option value="24" selected>24 {{ 'common.hours'|trans|default('hours') }} (1 {{ 'common.day'|trans|default('day') }})</option>
                                    <option value="48">48 {{ 'common.hours'|trans|default('hours') }} (2 {{ 'common.days'|trans|default('days') }})</option>
                                    <option value="72">72 {{ 'common.hours'|trans|default('hours') }} (3 {{ 'common.days'|trans|default('days') }})</option>
                                </select>
                                <span class="rams-form__hint">{{ 'email_campaign.ab_test.duration_hint'|trans|default('After this time, the winning variant will be automatically sent to remaining contacts.') }}</span>
                            </div>

                            {# Variants Configuration #}
                            <div class="rams-form__group">
                                <label class="rams-form__label rams-dymo">{{ 'email_campaign.ab_test.variants'|trans|default('Test Variants') }}</label>
                                <div id="variantsContainer" class="rams-variants-list">
                                    {# Variants will be added here #}
                                </div>
                                <button type="button" class="rams-btn rams-btn--secondary rams-btn--sm" id="addVariantBtn">
                                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                    </svg>
                                    {{ 'email_campaign.ab_test.add_variant'|trans|default('Add Variant') }}
                                </button>
                            </div>

                            <input type="hidden" name="variants" id="variantsInput">

                            <div class="rams-module__footer">
                                <div class="rams-btn-group">
                                    <a href="{{ path('app_email_campaign_show', {id: campaign.id}) }}" class="rams-btn rams-btn--secondary">
                                        {{ 'common.cancel'|trans }}
                                    </a>
                                    <button type="submit" class="rams-btn rams-btn--primary">
                                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                        </svg>
                                        {{ 'email_campaign.ab_test.create'|trans }}
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            {# Sidebar #}
            <div class="rams-layout__sidebar">
                {# Recommendations #}
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3 class="rams-module__title">{{ 'email_campaign.ab_test.recommendations'|trans|default('Recommendations') }}</h3>
                    </div>
                    <div class="rams-module__content">
                        {% for type, recommendation in recommendations %}
                            <div class="rams-recommendation">
                                <span class="rams-recommendation__type">{{ type|replace({'_': ' '})|title }}</span>
                                <p class="rams-recommendation__text">{{ recommendation }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Best Practices #}
                <div class="rams-module rams-module--info">
                    <div class="rams-module__header">
                        <h3 class="rams-module__title">{{ 'email_campaign.ab_test.best_practices'|trans|default('Best Practices') }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <ul class="rams-list rams-list--compact">
                            <li>{{ 'email_campaign.ab_test.tip_1'|trans|default('Test one variable at a time for clear results') }}</li>
                            <li>{{ 'email_campaign.ab_test.tip_2'|trans|default('Use 20-30% of your audience for testing') }}</li>
                            <li>{{ 'email_campaign.ab_test.tip_3'|trans|default('Wait at least 24 hours for statistical significance') }}</li>
                            <li>{{ 'email_campaign.ab_test.tip_4'|trans|default('Ensure each variant has at least 100 recipients') }}</li>
                            <li>{{ 'email_campaign.ab_test.tip_5'|trans|default('Focus on metrics that matter to your goal') }}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('testPercentage').addEventListener('input', function() {
    document.getElementById('percentageValue').textContent = this.value + '%';
});
</script>
{% endblock %}
