{% extends 'base.html.twig' %}

{% block title %}Create Drip Campaign{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4>
                    <i class="bi bi-droplet-fill"></i> Create Drip Campaign
                </h4>
                <a href="{{ path('app_email_campaign_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-9">
            <div class="card">
                <div class="card-body">
                    <form method="post" id="dripForm">
                        {# Basic Info #}
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="campaignName" class="form-label">Campaign Name *</label>
                                <input type="text" class="form-control" id="campaignName" name="name" required
                                       placeholder="e.g., Welcome Series">
                            </div>
                            <div class="col-md-6">
                                <label for="segment" class="form-label">Target Segment</label>
                                <select class="form-select" id="segment" name="segment_id">
                                    <option value="">All Contacts</option>
                                    {% for segment in segments %}
                                    <option value="{{ segment.id }}">{{ segment.name }} ({{ segment.contactCount }} contacts)</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="2"
                                      placeholder="Describe the purpose of this drip campaign"></textarea>
                        </div>

                        {# Drip Sequence Builder #}
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="form-label mb-0">Email Sequence *</label>
                                <button type="button" class="btn btn-primary btn-sm" id="addTouchBtn">
                                    <i class="bi bi-plus-circle"></i> Add Touch
                                </button>
                            </div>

                            <div id="touchesContainer" class="drip-sequence">
                                {# Touches will be added here #}
                            </div>
                        </div>

                        <input type="hidden" name="sequence" id="sequenceInput">

                        <div class="d-flex justify-content-between mt-4 pt-4 border-top">
                            <a href="{{ path('app_email_campaign_index') }}" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Create Drip Campaign
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6 class="mb-3">
                        <i class="bi bi-info-circle-fill text-info"></i> Drip Campaigns
                    </h6>
                    <p class="small">Drip campaigns automatically send a series of emails over time to nurture leads and engage customers.</p>
                    
                    <hr>
                    
                    <h6 class="small fw-bold">Tips:</h6>
                    <ul class="small mb-0">
                        <li>Start with 3-5 touches</li>
                        <li>Space emails 1-3 days apart</li>
                        <li>Provide value in each email</li>
                        <li>Use conditional logic for engagement</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.drip-sequence {
    position: relative;
    padding-left: 40px;
}

.drip-sequence::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 30px;
    bottom: 30px;
    width: 2px;
    background: linear-gradient(to bottom, #0d6efd 0%, #0d6efd 100%);
    background-size: 2px 20px;
}

.touch-item {
    position: relative;
    background: white;
    border: 2px solid #dee2e6;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
}

.touch-number {
    position: absolute;
    left: -40px;
    top: 20px;
    width: 38px;
    height: 38px;
    background: #0d6efd;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
}

.touch-remove-btn {
    position: absolute;
    top: 12px;
    right: 12px;
}

.delay-input-group {
    display: flex;
    gap: 8px;
    align-items: center;
}
</style>

<script>
let touchCount = 0;
const templates = {{ templates|json_encode|raw }};

document.addEventListener('DOMContentLoaded', function() {
    const addTouchBtn = document.getElementById('addTouchBtn');
    const touchesContainer = document.getElementById('touchesContainer');
    const dripForm = document.getElementById('dripForm');

    // Add initial touch
    addTouch();
    addTouch();

    // Add touch button
    addTouchBtn.addEventListener('click', addTouch);

    // Form submit
    dripForm.addEventListener('submit', function(e) {
        const sequence = buildSequence();
        if (sequence.length < 2) {
            e.preventDefault();
            alert('Please add at least 2 email touches');
            return;
        }
        document.getElementById('sequenceInput').value = JSON.stringify(sequence);
    });
});

function addTouch() {
    touchCount++;
    const touchNum = touchCount;
    const touchesContainer = document.getElementById('touchesContainer');
    
    const touchDiv = document.createElement('div');
    touchDiv.className = 'touch-item';
    touchDiv.dataset.touchNum = touchNum;
    
    touchDiv.innerHTML = `
        <div class="touch-number">${touchNum}</div>
        
        ${touchNum > 1 ? `<button type="button" class="btn btn-sm btn-outline-danger touch-remove-btn" onclick="removeTouch(${touchNum})">
            <i class="bi bi-trash"></i>
        </button>` : ''}
        
        ${touchNum > 1 ? `<div class="mb-3">
            <label class="form-label small">Delay after previous email</label>
            <div class="delay-input-group">
                <input type="number" class="form-control form-control-sm" data-role="delay-value" value="1" min="1" style="width: 80px;">
                <select class="form-select form-select-sm" data-role="delay-unit" style="width: 120px;">
                    <option value="hours">hours</option>
                    <option value="days" selected>days</option>
                    <option value="weeks">weeks</option>
                </select>
                <span class="text-muted small">after previous email</span>
            </div>
        </div>` : '<div class="mb-3"><div class="alert alert-info alert-sm mb-0"><i class="bi bi-info-circle"></i> Sent immediately when contact is enrolled</div></div>'}
        
        <div class="mb-2">
            <label class="form-label small">Select Email Template</label>
            <select class="form-select form-select-sm" data-role="template" required>
                <option value="">Choose template...</option>
                ${generateTemplateOptions()}
            </select>
        </div>
    `;
    
    touchesContainer.appendChild(touchDiv);
}

function removeTouch(touchNum) {
    const touchDiv = document.querySelector(`[data-touch-num="${touchNum}"]`);
    if (touchDiv && touchCount > 2) {
        touchDiv.remove();
        renumberTouches();
    } else {
        alert('Drip campaign must have at least 2 touches');
    }
}

function renumberTouches() {
    const touches = document.querySelectorAll('.touch-item');
    touches.forEach((touch, index) => {
        const newNum = index + 1;
        touch.dataset.touchNum = newNum;
        touch.querySelector('.touch-number').textContent = newNum;
    });
    touchCount = touches.length;
}

function buildSequence() {
    const sequence = [];
    document.querySelectorAll('.touch-item').forEach(touchDiv => {
        const templateId = touchDiv.querySelector('[data-role="template"]')?.value;
        const delayValue = touchDiv.querySelector('[data-role="delay-value"]')?.value || 0;
        const delayUnit = touchDiv.querySelector('[data-role="delay-unit"]')?.value || 'days';
        
        if (templateId) {
            sequence.push({
                template_id: parseInt(templateId),
                delay_value: parseInt(delayValue),
                delay_unit: delayUnit
            });
        }
    });
    return sequence;
}

function generateTemplateOptions() {
    return templates.map(t => `<option value="${t.id}">${t.name} - ${t.subjectLine}</option>`).join('');
}
</script>
{% endblock %}
