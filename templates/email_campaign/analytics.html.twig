{% extends 'base.html.twig' %}

{% block title %}Analytics - {{ campaign.name }}{% endblock %}

{% block body %}
<div class="p-8">
    <div class="mb-8">
        <div class="flex items-center gap-3 text-sm text-zinc-400 mb-4">
            <a href="{{ path('app_email_campaign_index') }}" class="hover:text-white transition-colors">Email Campaigns</a>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 4l4 4-4 4"/>
            </svg>
            <a href="{{ path('app_email_campaign_show', {id: campaign.id}) }}" class="hover:text-white transition-colors">{{ campaign.name }}</a>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 4l4 4-4 4"/>
            </svg>
            <span class="text-white">Analytics</span>
        </div>
        <h1 class="text-2xl font-semibold text-white mb-2">Campaign Analytics</h1>
        <p class="text-sm text-zinc-400">Detailed performance metrics for {{ campaign.name }}</p>
    </div>

    <!-- Overall Metrics -->
    <div class="grid grid-cols-5 gap-4 mb-8">
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-white mb-1">{{ metrics.total_sent }}</div>
            <div class="text-sm text-zinc-400">Total Sent</div>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-green-400 mb-1">{{ metrics.open_rate|number_format(1) }}%</div>
            <div class="text-sm text-zinc-400">Open Rate</div>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-blue-400 mb-1">{{ metrics.click_rate|number_format(1) }}%</div>
            <div class="text-sm text-zinc-400">Click Rate</div>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-purple-400 mb-1">{{ metrics.reply_rate|number_format(1) }}%</div>
            <div class="text-sm text-zinc-400">Reply Rate</div>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-red-400 mb-1">{{ metrics.bounce_rate|number_format(1) }}%</div>
            <div class="text-sm text-zinc-400">Bounce Rate</div>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-6 mb-8">
        <!-- Sends Over Time -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6">
            <h2 class="text-lg font-semibold text-white mb-4">Sends Over Time</h2>
            {% if sendsByDate is empty %}
                <div class="text-center py-8 text-zinc-500">No sends yet</div>
            {% else %}
                <div class="space-y-2">
                    {% set maxCount = 0 %}
                    {% for item in sendsByDate %}
                        {% if item.count > maxCount %}
                            {% set maxCount = item.count %}
                        {% endif %}
                    {% endfor %}
                    
                    {% for item in sendsByDate %}
                        <div class="flex items-center gap-3">
                            <div class="text-sm text-zinc-400 w-24">{{ item.date|date('M d') }}</div>
                            <div class="flex-1 h-8 bg-zinc-800 rounded-lg overflow-hidden">
                                {% set width = maxCount > 0 ? ((item.count / maxCount * 100)|round) : 0 %}
                                <div class="h-full bg-gradient-to-r from-blue-500 to-blue-400 flex items-center px-3" style="width: {{ width }}%">
                                    <span class="text-xs font-medium text-white">{{ item.count }}</span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <!-- Engagement Funnel -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6">
            <h2 class="text-lg font-semibold text-white mb-4">Engagement Funnel</h2>
            <div class="space-y-3">
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-sm text-zinc-400">Sent</span>
                        <span class="text-sm font-medium text-white">{{ metrics.total_sent }}</span>
                    </div>
                    <div class="h-3 bg-zinc-800 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-zinc-500 to-zinc-400" style="width: 100%"></div>
                    </div>
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-sm text-zinc-400">Opened</span>
                        <span class="text-sm font-medium text-white">{{ metrics.opened }} ({{ metrics.open_rate|number_format(1) }}%)</span>
                    </div>
                    <div class="h-3 bg-zinc-800 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-green-500 to-green-400" style="width: {{ metrics.open_rate }}%"></div>
                    </div>
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-sm text-zinc-400">Clicked</span>
                        <span class="text-sm font-medium text-white">{{ metrics.clicked }} ({{ metrics.click_rate|number_format(1) }}%)</span>
                    </div>
                    <div class="h-3 bg-zinc-800 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-blue-500 to-blue-400" style="width: {{ metrics.click_rate }}%"></div>
                    </div>
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-sm text-zinc-400">Replied</span>
                        <span class="text-sm font-medium text-white">{{ metrics.replied }} ({{ metrics.reply_rate|number_format(1) }}%)</span>
                    </div>
                    <div class="h-3 bg-zinc-800 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-purple-500 to-purple-400" style="width: {{ metrics.reply_rate }}%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Performing Contacts -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-white mb-4">Top Performing Contacts</h2>
        {% if topContacts is empty %}
            <div class="text-center py-8 text-zinc-500">No engagement data yet</div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-zinc-800">
                            <th class="text-left text-xs font-medium text-zinc-400 pb-3">Contact</th>
                            <th class="text-center text-xs font-medium text-zinc-400 pb-3">Opens</th>
                            <th class="text-center text-xs font-medium text-zinc-400 pb-3">Clicks</th>
                            <th class="text-center text-xs font-medium text-zinc-400 pb-3">Replies</th>
                            <th class="text-center text-xs font-medium text-zinc-400 pb-3">Engagement</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for contact in topContacts %}
                            {% set totalEngagement = contact.opens + contact.clicks + contact.replies %}
                            <tr class="border-b border-zinc-800/50 hover:bg-zinc-800/30">
                                <td class="py-3">
                                    <div class="text-sm text-white">{{ contact.firstName }} {{ contact.lastName }}</div>
                                    <div class="text-xs text-zinc-500">{{ contact.email }}</div>
                                </td>
                                <td class="py-3 text-center">
                                    <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-500/10 text-green-400">
                                        {{ contact.opens }}
                                    </span>
                                </td>
                                <td class="py-3 text-center">
                                    <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-500/10 text-blue-400">
                                        {{ contact.clicks }}
                                    </span>
                                </td>
                                <td class="py-3 text-center">
                                    <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-purple-500/10 text-purple-400">
                                        {{ contact.replies }}
                                    </span>
                                </td>
                                <td class="py-3 text-center">
                                    <div class="flex items-center justify-center gap-1">
                                        {% for i in 1..5 %}
                                            {% if i <= totalEngagement %}
                                                <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                                            {% else %}
                                                <div class="w-2 h-2 bg-zinc-700 rounded-full"></div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
