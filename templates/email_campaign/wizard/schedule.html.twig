{% extends 'base.html.twig' %}

{% block title %}Schedule Campaign - {{ campaign.name }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            {# Wizard Progress #}
            <div class="card mb-4">
                <div class="card-body">
                    <div class="wizard-progress">
                        <div class="wizard-step completed">
                            <div class="step-number">1</div>
                            <div class="step-label">Basic Info</div>
                        </div>
                        <div class="wizard-connector"></div>
                        <div class="wizard-step completed">
                            <div class="step-number">2</div>
                            <div class="step-label">Template</div>
                        </div>
                        <div class="wizard-connector"></div>
                        <div class="wizard-step completed">
                            <div class="step-number">3</div>
                            <div class="step-label">Audience</div>
                        </div>
                        <div class="wizard-connector"></div>
                        <div class="wizard-step active">
                            <div class="step-number">4</div>
                            <div class="step-label">Schedule</div>
                        </div>
                        <div class="wizard-connector"></div>
                        <div class="wizard-step">
                            <div class="step-number">5</div>
                            <div class="step-label">Review</div>
                        </div>
                    </div>
                </div>
            </div>

            {# Schedule Options #}
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">When should we send this campaign?</h5>
                        </div>
                        <div class="card-body">
                            <form method="post">
                                {# Send Option #}
                                <div class="mb-4">
                                    <label class="send-option-card mb-3">
                                        <input type="radio" name="send_option" value="now" checked>
                                        <div class="option-content p-4">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-send-fill text-primary me-3" style="font-size: 32px;"></i>
                                                <div>
                                                    <h6 class="mb-1">Send Immediately</h6>
                                                    <p class="text-muted mb-0 small">Campaign will start sending right away</p>
                                                </div>
                                            </div>
                                        </div>
                                    </label>

                                    <label class="send-option-card">
                                        <input type="radio" name="send_option" value="scheduled">
                                        <div class="option-content p-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <i class="bi bi-calendar-event text-primary me-3" style="font-size: 32px;"></i>
                                                <div>
                                                    <h6 class="mb-1">Schedule for Later</h6>
                                                    <p class="text-muted mb-0 small">Choose a specific date and time</p>
                                                </div>
                                            </div>
                                            
                                            <div class="schedule-inputs" id="scheduleInputs" style="display: none;">
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Date</label>
                                                        <input type="date" name="scheduled_date" class="form-control" min="{{ 'now'|date('Y-m-d') }}">
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Time</label>
                                                        <input type="time" name="scheduled_time" class="form-control" value="09:00">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </label>
                                </div>

                                {# Send Time Optimization #}
                                <div class="card bg-light border-0 mb-4">
                                    <div class="card-body">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="optimize_send_time" id="optimizeSendTime" value="1">
                                            <label class="form-check-label" for="optimizeSendTime">
                                                <strong>Optimize send times</strong>
                                                <p class="text-muted small mb-0 mt-1">
                                                    <i class="bi bi-lightbulb-fill text-warning"></i>
                                                    Use AI to send each email at the optimal time based on recipient's timezone and engagement history
                                                </p>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-4">
                                    <a href="{{ path('app_email_campaign_wizard_segment', {id: campaign.id}) }}" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-left"></i> Back
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        Continue <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.wizard-progress {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 0;
}

.wizard-step {
    text-align: center;
    min-width: 100px;
}

.step-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e9ecef;
    color: #6c757d;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 8px;
    font-weight: 600;
    transition: all 0.3s;
}

.wizard-step.active .step-number {
    background: #0d6efd;
    color: white;
}

.wizard-step.completed .step-number {
    background: #198754;
    color: white;
}

.step-label {
    font-size: 13px;
    color: #6c757d;
    font-weight: 500;
}

.wizard-connector {
    flex: 1;
    height: 2px;
    background: #e9ecef;
    margin: 0 10px;
    max-width: 100px;
}

.send-option-card {
    display: block;
    border: 2px solid #dee2e6;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s;
    overflow: hidden;
}

.send-option-card:hover {
    border-color: #0d6efd;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.send-option-card input[type="radio"] {
    display: none;
}

.send-option-card input[type="radio"]:checked + .option-content {
    background: #f8f9fa;
    border-left: 4px solid #0d6efd;
}

.option-content {
    border-radius: 6px;
    transition: all 0.3s;
}

.schedule-inputs {
    padding-left: 44px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const sendOptions = document.querySelectorAll('input[name="send_option"]');
    const scheduleInputs = document.getElementById('scheduleInputs');
    
    sendOptions.forEach(option => {
        option.addEventListener('change', function() {
            if (this.value === 'scheduled') {
                scheduleInputs.style.display = 'block';
            } else {
                scheduleInputs.style.display = 'none';
            }
        });
    });
});
</script>
{% endblock %}
