{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.wizard.schedule.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Wizard Progress #}
        <div class="rams-wizard-progress">
            <div class="rams-wizard-step rams-wizard-step--complete">
                <span class="rams-wizard-step__number">1</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.template.title'|trans }}</span>
            </div>
            <div class="rams-wizard-step__connector rams-wizard-step__connector--complete"></div>
            <div class="rams-wizard-step rams-wizard-step--complete">
                <span class="rams-wizard-step__number">2</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.content'|trans|default('Content') }}</span>
            </div>
            <div class="rams-wizard-step__connector rams-wizard-step__connector--complete"></div>
            <div class="rams-wizard-step rams-wizard-step--complete">
                <span class="rams-wizard-step__number">3</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.segment.title'|trans }}</span>
            </div>
            <div class="rams-wizard-step__connector rams-wizard-step__connector--complete"></div>
            <div class="rams-wizard-step rams-wizard-step--active">
                <span class="rams-wizard-step__number">4</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.schedule.title'|trans }}</span>
            </div>
            <div class="rams-wizard-step__connector"></div>
            <div class="rams-wizard-step">
                <span class="rams-wizard-step__number">5</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.review.title'|trans }}</span>
            </div>
        </div>

        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.wizard.schedule.title'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.wizard.schedule.subtitle'|trans|default('Choose when to send your campaign') }}</p>
            </div>
        </div>

        <div class="rams-layout rams-layout--sidebar-right">
            {# Main Form #}
            <div class="rams-layout__main">
                <form method="post" action="{{ path('app_email_campaign_wizard_schedule', {id: campaign.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('wizard_schedule') }}">

                    {# Send Options #}
                    <div class="rams-module">
                        <div class="rams-module__header">
                            <h2 class="rams-module__title">{{ 'email_campaign.wizard.schedule.when'|trans|default('When to Send') }}</h2>
                        </div>
                        <div class="rams-module__content">
                            <div class="rams-send-options">
                                {# Send Immediately #}
                                <label class="rams-send-option">
                                    <input type="radio" name="send_type" value="now" {{ campaign.scheduledAt is null ? 'checked' : '' }}>
                                    <div class="rams-send-option__content">
                                        <svg class="rams-send-option__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                                        </svg>
                                        <div class="rams-send-option__text">
                                            <h3 class="rams-send-option__title">{{ 'email_campaign.wizard.schedule.send_now'|trans|default('Send Immediately') }}</h3>
                                            <p class="rams-send-option__description">{{ 'email_campaign.wizard.schedule.send_now_desc'|trans|default('Campaign will be sent as soon as you complete the wizard') }}</p>
                                        </div>
                                    </div>
                                </label>

                                {# Schedule Later #}
                                <label class="rams-send-option">
                                    <input type="radio" name="send_type" value="scheduled" {{ campaign.scheduledAt is not null ? 'checked' : '' }}>
                                    <div class="rams-send-option__content">
                                        <svg class="rams-send-option__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        <div class="rams-send-option__text">
                                            <h3 class="rams-send-option__title">{{ 'email_campaign.wizard.schedule.schedule_later'|trans|default('Schedule for Later') }}</h3>
                                            <p class="rams-send-option__description">{{ 'email_campaign.wizard.schedule.schedule_later_desc'|trans|default('Choose a specific date and time') }}</p>
                                        </div>
                                    </div>
                                </label>

                                {# Optimal Time #}
                                <label class="rams-send-option">
                                    <input type="radio" name="send_type" value="optimal">
                                    <div class="rams-send-option__content">
                                        <svg class="rams-send-option__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                                        </svg>
                                        <div class="rams-send-option__text">
                                            <h3 class="rams-send-option__title">{{ 'email_campaign.wizard.schedule.optimal_time'|trans|default('Optimal Send Time') }}</h3>
                                            <p class="rams-send-option__description">{{ 'email_campaign.wizard.schedule.optimal_time_desc'|trans|default('AI selects the best time based on engagement data') }}</p>
                                        </div>
                                        <span class="rams-badge rams-badge--primary rams-badge--sm">{{ 'common.recommended'|trans|default('Recommended') }}</span>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    {# Schedule Details #}
                    <div class="rams-module {{ campaign.scheduledAt is null ? 'rams-hidden' : '' }}" id="scheduleDetails">
                        <div class="rams-module__header">
                            <h2 class="rams-module__title">{{ 'email_campaign.wizard.schedule.details'|trans|default('Schedule Details') }}</h2>
                        </div>
                        <div class="rams-module__content">
                            <div class="rams-form__row rams-form__row--2">
                                <div class="rams-form__group">
                                    <label for="scheduledDate" class="rams-form__label rams-dymo">{{ 'email_campaign.wizard.schedule.date'|trans|default('Date') }} *</label>
                                    <input type="date" class="rams-form__input" id="scheduledDate" name="scheduled_date"
                                           value="{{ campaign.scheduledAt|date('Y-m-d')|default('') }}"
                                           min="{{ 'now'|date('Y-m-d') }}">
                                </div>
                                <div class="rams-form__group">
                                    <label for="scheduledTime" class="rams-form__label rams-dymo">{{ 'email_campaign.wizard.schedule.time'|trans|default('Time') }} *</label>
                                    <input type="time" class="rams-form__input" id="scheduledTime" name="scheduled_time"
                                           value="{{ campaign.scheduledAt|date('H:i')|default('09:00') }}">
                                </div>
                            </div>

                            <div class="rams-form__group">
                                <label for="timezone" class="rams-form__label rams-dymo">{{ 'email_campaign.wizard.schedule.timezone'|trans|default('Timezone') }}</label>
                                <select class="rams-form__select" id="timezone" name="timezone">
                                    <option value="America/New_York">{{ 'timezone.eastern'|trans|default('Eastern Time (ET)') }}</option>
                                    <option value="America/Chicago">{{ 'timezone.central'|trans|default('Central Time (CT)') }}</option>
                                    <option value="America/Denver">{{ 'timezone.mountain'|trans|default('Mountain Time (MT)') }}</option>
                                    <option value="America/Los_Angeles">{{ 'timezone.pacific'|trans|default('Pacific Time (PT)') }}</option>
                                    <option value="UTC">{{ 'timezone.utc'|trans|default('UTC') }}</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    {# Sending Options #}
                    <div class="rams-module">
                        <div class="rams-module__header">
                            <h2 class="rams-module__title">{{ 'email_campaign.wizard.schedule.options'|trans|default('Sending Options') }}</h2>
                        </div>
                        <div class="rams-module__content">
                            <div class="rams-form__group">
                                <label class="rams-form__checkbox">
                                    <input type="checkbox" name="throttle_enabled">
                                    <span class="rams-form__checkbox-label">{{ 'email_campaign.wizard.schedule.throttle'|trans|default('Enable throttling') }}</span>
                                </label>
                                <span class="rams-form__hint">{{ 'email_campaign.wizard.schedule.throttle_hint'|trans|default('Spread sends over time to avoid spam filters') }}</span>
                            </div>

                            <div class="rams-form__group">
                                <label class="rams-form__checkbox">
                                    <input type="checkbox" name="track_opens" checked>
                                    <span class="rams-form__checkbox-label">{{ 'email_campaign.wizard.schedule.track_opens'|trans|default('Track email opens') }}</span>
                                </label>
                            </div>

                            <div class="rams-form__group">
                                <label class="rams-form__checkbox">
                                    <input type="checkbox" name="track_clicks" checked>
                                    <span class="rams-form__checkbox-label">{{ 'email_campaign.wizard.schedule.track_clicks'|trans|default('Track link clicks') }}</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    {# Navigation #}
                    <div class="rams-wizard-nav">
                        <a href="{{ path('app_email_campaign_wizard_segment', {id: campaign.id}) }}" class="rams-btn rams-btn--secondary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                            </svg>
                            {{ 'common.back'|trans }}
                        </a>
                        <button type="submit" class="rams-btn rams-btn--primary">
                            {{ 'common.next'|trans }}
                            <svg class="rams-btn__icon rams-btn__icon--right" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </button>
                    </div>
                </form>
            </div>

            {# Sidebar #}
            <div class="rams-layout__sidebar">
                {# Best Times #}
                <div class="rams-module rams-module--info">
                    <div class="rams-module__header">
                        <h3 class="rams-module__title">{{ 'email_campaign.wizard.schedule.best_times'|trans|default('Best Send Times') }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <p class="rams-module__description">{{ 'email_campaign.wizard.schedule.best_times_desc'|trans|default('Based on your audience engagement:') }}</p>
                        <ul class="rams-list rams-list--compact">
                            <li><strong>{{ 'email_campaign.wizard.schedule.best_day'|trans|default('Best day') }}:</strong> {{ 'email_campaign.wizard.schedule.tuesday'|trans|default('Tuesday') }}</li>
                            <li><strong>{{ 'email_campaign.wizard.schedule.best_time'|trans|default('Best time') }}:</strong> 10:00 AM</li>
                            <li><strong>{{ 'email_campaign.wizard.schedule.avoid'|trans|default('Avoid') }}:</strong> {{ 'email_campaign.wizard.schedule.weekends'|trans|default('Weekends') }}</li>
                        </ul>
                    </div>
                </div>

                {# Campaign Summary #}
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3 class="rams-module__title">{{ 'email_campaign.wizard.summary'|trans|default('Campaign Summary') }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <dl class="rams-definition-list">
                            <dt class="rams-dymo">{{ 'email_campaign.campaign_name'|trans }}</dt>
                            <dd>{{ campaign.name }}</dd>
                            
                            <dt class="rams-dymo">{{ 'email_campaign.audience'|trans|default('Audience') }}</dt>
                            <dd>{{ audienceCount|number_format }} {{ 'contact.title'|trans|lower }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.querySelectorAll('input[name="send_type"]').forEach(radio => {
    radio.addEventListener('change', function() {
        const details = document.getElementById('scheduleDetails');
        if (this.value === 'scheduled') {
            details.classList.remove('rams-hidden');
        } else {
            details.classList.add('rams-hidden');
        }
    });
});
</script>
{% endblock %}
