{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.wizard.template.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Wizard Progress #}
        <div class="rams-wizard-progress">
            <div class="rams-wizard-step rams-wizard-step--complete">
                <span class="rams-wizard-step__number">1</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.basics'|trans|default('Basics') }}</span>
            </div>
            <div class="rams-wizard-step__connector rams-wizard-step__connector--complete"></div>
            <div class="rams-wizard-step rams-wizard-step--active">
                <span class="rams-wizard-step__number">2</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.template.title'|trans }}</span>
            </div>
            <div class="rams-wizard-step__connector"></div>
            <div class="rams-wizard-step">
                <span class="rams-wizard-step__number">3</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.segment.title'|trans }}</span>
            </div>
            <div class="rams-wizard-step__connector"></div>
            <div class="rams-wizard-step">
                <span class="rams-wizard-step__number">4</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.schedule.title'|trans }}</span>
            </div>
            <div class="rams-wizard-step__connector"></div>
            <div class="rams-wizard-step">
                <span class="rams-wizard-step__number">5</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.review.title'|trans }}</span>
            </div>
        </div>

        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.wizard.template.title'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.wizard.template.subtitle'|trans|default('Choose an email template for your campaign') }}</p>
            </div>
        </div>

        <form method="post" action="{{ path('app_email_campaign_wizard_template', {id: campaign.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('wizard_template') }}">

            {# Template Gallery #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'email_campaign.wizard.template.select'|trans|default('Select Template') }}</h2>
                    <div class="rams-segmented-control">
                        <button type="button" class="rams-segmented-control__btn rams-segmented-control__btn--active" data-filter="all">{{ 'common.all'|trans }}</button>
                        <button type="button" class="rams-segmented-control__btn" data-filter="marketing">{{ 'email_campaign.templates.category.marketing'|trans|default('Marketing') }}</button>
                        <button type="button" class="rams-segmented-control__btn" data-filter="transactional">{{ 'email_campaign.templates.category.transactional'|trans|default('Transactional') }}</button>
                        <button type="button" class="rams-segmented-control__btn" data-filter="newsletter">{{ 'email_campaign.templates.category.newsletter'|trans|default('Newsletter') }}</button>
                    </div>
                </div>
                <div class="rams-module__content">
                    <div class="rams-template-grid" id="templateGrid">
                        {# Blank Template #}
                        <label class="rams-template-card">
                            <input type="radio" name="template_id" value="" {{ campaign.template is null ? 'checked' : '' }}>
                            <div class="rams-template-card__content">
                                <div class="rams-template-card__preview rams-template-card__preview--blank">
                                    <svg class="rams-template-card__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                    </svg>
                                    <span>{{ 'email_campaign.wizard.template.blank'|trans|default('Start from scratch') }}</span>
                                </div>
                                <div class="rams-template-card__info">
                                    <h3 class="rams-template-card__title">{{ 'email_campaign.wizard.template.blank_title'|trans|default('Blank Template') }}</h3>
                                    <p class="rams-template-card__description">{{ 'email_campaign.wizard.template.blank_desc'|trans|default('Create your own design') }}</p>
                                </div>
                            </div>
                        </label>

                        {% for template in templates %}
                            <label class="rams-template-card" data-category="{{ template.category|default('marketing')|lower }}">
                                <input type="radio" name="template_id" value="{{ template.id }}" {{ campaign.template.id|default(0) == template.id ? 'checked' : '' }}>
                                <div class="rams-template-card__content">
                                    <div class="rams-template-card__preview">
                                        {% if template.thumbnail %}
                                            <img src="{{ template.thumbnail }}" alt="{{ template.name }}">
                                        {% else %}
                                            <div class="rams-template-card__preview-placeholder">
                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                                </svg>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="rams-template-card__info">
                                        <h3 class="rams-template-card__title">{{ template.name }}</h3>
                                        <span class="rams-badge rams-badge--{{ template.category|default('marketing')|lower == 'newsletter' ? 'info' : (template.category|default('marketing')|lower == 'transactional' ? 'warning' : 'success') }}">
                                            {{ template.category|default('Marketing') }}
                                        </span>
                                    </div>
                                </div>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# Subject Line #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'email_campaign.wizard.template.subject'|trans|default('Email Subject') }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-form__group">
                        <label for="subject" class="rams-form__label rams-dymo">{{ 'email_campaign.subject'|trans }} *</label>
                        <input type="text" class="rams-form__input" id="subject" name="subject" required
                               value="{{ campaign.subject }}" 
                               placeholder="{{ 'email_campaign.wizard.template.subject_placeholder'|trans|default('Enter your email subject line') }}">
                        <span class="rams-form__hint">{{ 'email_campaign.wizard.template.subject_hint'|trans|default('Keep it under 50 characters for best results.') }}</span>
                    </div>

                    <div class="rams-form__group">
                        <label for="previewText" class="rams-form__label rams-dymo">{{ 'email_campaign.wizard.template.preview_text'|trans|default('Preview Text') }}</label>
                        <input type="text" class="rams-form__input" id="previewText" name="preview_text"
                               value="{{ campaign.previewText|default('') }}" 
                               placeholder="{{ 'email_campaign.wizard.template.preview_placeholder'|trans|default('Brief preview shown in inbox') }}">
                        <span class="rams-form__hint">{{ 'email_campaign.wizard.template.preview_hint'|trans|default('This appears after the subject in most email clients.') }}</span>
                    </div>
                </div>
            </div>

            {# Navigation #}
            <div class="rams-wizard-nav">
                <a href="{{ path('app_email_campaign_show', {id: campaign.id}) }}" class="rams-btn rams-btn--secondary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    {{ 'common.back'|trans }}
                </a>
                <button type="submit" class="rams-btn rams-btn--primary">
                    {{ 'common.next'|trans }}
                    <svg class="rams-btn__icon rams-btn__icon--right" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.querySelectorAll('.rams-segmented-control__btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.rams-segmented-control__btn').forEach(b => b.classList.remove('rams-segmented-control__btn--active'));
        this.classList.add('rams-segmented-control__btn--active');
        
        const filter = this.dataset.filter;
        document.querySelectorAll('.rams-template-card[data-category]').forEach(card => {
            if (filter === 'all' || card.dataset.category === filter) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    });
});
</script>
{% endblock %}
