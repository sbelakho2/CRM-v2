{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.wizard.segment.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Wizard Progress #}
        <div class="rams-wizard-progress">
            <div class="rams-wizard-step rams-wizard-step--complete">
                <span class="rams-wizard-step__number">1</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.template.title'|trans }}</span>
            </div>
            <div class="rams-wizard-step__connector rams-wizard-step__connector--complete"></div>
            <div class="rams-wizard-step rams-wizard-step--complete">
                <span class="rams-wizard-step__number">2</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.content'|trans|default('Content') }}</span>
            </div>
            <div class="rams-wizard-step__connector rams-wizard-step__connector--complete"></div>
            <div class="rams-wizard-step rams-wizard-step--active">
                <span class="rams-wizard-step__number">3</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.segment.title'|trans }}</span>
            </div>
            <div class="rams-wizard-step__connector"></div>
            <div class="rams-wizard-step">
                <span class="rams-wizard-step__number">4</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.schedule.title'|trans }}</span>
            </div>
            <div class="rams-wizard-step__connector"></div>
            <div class="rams-wizard-step">
                <span class="rams-wizard-step__number">5</span>
                <span class="rams-wizard-step__label">{{ 'email_campaign.wizard.review.title'|trans }}</span>
            </div>
        </div>

        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.wizard.segment.title'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.wizard.segment.subtitle'|trans|default('Choose which contacts will receive this campaign') }}</p>
            </div>
        </div>

        <div class="rams-layout rams-layout--sidebar-right">
            {# Main Content #}
            <div class="rams-layout__main">
                <form method="post" action="{{ path('app_email_campaign_wizard_segment', {id: campaign.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('wizard_segment') }}">

                    {# Segment Selection #}
                    <div class="rams-module">
                        <div class="rams-module__header">
                            <h2 class="rams-module__title">{{ 'email_campaign.wizard.segment.select'|trans|default('Select Audience') }}</h2>
                        </div>
                        <div class="rams-module__content">
                            <div class="rams-segment-options">
                                {# All Contacts Option #}
                                <label class="rams-segment-option">
                                    <input type="radio" name="segment_type" value="all" {{ (campaign.segmentId is null) ? 'checked' : '' }}>
                                    <div class="rams-segment-option__content">
                                        <svg class="rams-segment-option__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                        </svg>
                                        <div class="rams-segment-option__text">
                                            <h3 class="rams-segment-option__title">{{ 'email_campaign.wizard.segment.all_contacts'|trans|default('All Contacts') }}</h3>
                                            <p class="rams-segment-option__description">{{ 'email_campaign.wizard.segment.all_contacts_desc'|trans|default('Send to all contacts in your database') }}</p>
                                        </div>
                                        <span class="rams-badge rams-badge--info">{{ totalContacts|number_format }} {{ 'contact.title'|trans|lower }}</span>
                                    </div>
                                </label>

                                {# Existing Segment Option #}
                                <label class="rams-segment-option">
                                    <input type="radio" name="segment_type" value="segment" {{ (campaign.segmentId is not null) ? 'checked' : '' }}>
                                    <div class="rams-segment-option__content">
                                        <svg class="rams-segment-option__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                                        </svg>
                                        <div class="rams-segment-option__text">
                                            <h3 class="rams-segment-option__title">{{ 'email_campaign.wizard.segment.use_segment'|trans|default('Use Existing Segment') }}</h3>
                                            <p class="rams-segment-option__description">{{ 'email_campaign.wizard.segment.use_segment_desc'|trans|default('Select a pre-defined segment') }}</p>
                                        </div>
                                    </div>
                                </label>
                            </div>

                            {# Segment Selection Grid #}
                            <div id="segmentSelector" class="rams-segment-grid" style="{{ (campaign.segmentId is null) ? 'display: none;' : '' }}">
                                {% for segment in segments %}
                                    <label class="rams-segment-card">
                                        <input type="radio" name="segment_id" value="{{ segment.id }}" {{ (campaign.segmentId == segment.id) ? 'checked' : '' }}>
                                        <div class="rams-segment-card__content">
                                            <h4 class="rams-segment-card__title">{{ segment.name }}</h4>
                                            {% if segment.description %}
                                                <p class="rams-segment-card__description">{{ segment.description }}</p>
                                            {% endif %}
                                            <div class="rams-segment-card__meta">
                                                <span class="rams-metric rams-metric--sm">
                                                    <span class="rams-metric__value">{{ segment.contactCount|number_format }}</span>
                                                    <span class="rams-metric__label">{{ 'contact.title'|trans|lower }}</span>
                                                </span>
                                            </div>
                                        </div>
                                    </label>
                                {% else %}
                                    <div class="rams-andon rams-andon--warning">
                                        {{ 'email_campaign.wizard.segment.no_segments'|trans|default('No segments created yet.') }}
                                        <a href="{{ path('app_email_campaign_segment_builder') }}" class="rams-link">{{ 'email_campaign.wizard.segment.create_segment'|trans|default('Create a segment') }}</a>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    {# Exclusions #}
                    <div class="rams-module">
                        <div class="rams-module__header">
                            <h2 class="rams-module__title">{{ 'email_campaign.wizard.segment.exclusions'|trans|default('Exclusions') }}</h2>
                        </div>
                        <div class="rams-module__content">
                            <div class="rams-form__group">
                                <label class="rams-form__checkbox">
                                    <input type="checkbox" name="exclude_bounced" checked>
                                    <span class="rams-form__checkbox-label">{{ 'email_campaign.wizard.segment.exclude_bounced'|trans|default('Exclude bounced emails') }}</span>
                                </label>
                            </div>
                            <div class="rams-form__group">
                                <label class="rams-form__checkbox">
                                    <input type="checkbox" name="exclude_unsubscribed" checked>
                                    <span class="rams-form__checkbox-label">{{ 'email_campaign.wizard.segment.exclude_unsubscribed'|trans|default('Exclude unsubscribed contacts') }}</span>
                                </label>
                            </div>
                            <div class="rams-form__group">
                                <label class="rams-form__checkbox">
                                    <input type="checkbox" name="exclude_recent" checked>
                                    <span class="rams-form__checkbox-label">{{ 'email_campaign.wizard.segment.exclude_recent'|trans|default('Exclude contacts emailed in the last 7 days') }}</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    {# Navigation #}
                    <div class="rams-wizard-nav">
                        <a href="{{ path('app_email_campaign_wizard_template', {id: campaign.id}) }}" class="rams-btn rams-btn--secondary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                            </svg>
                            {{ 'common.back'|trans }}
                        </a>
                        <button type="submit" class="rams-btn rams-btn--primary">
                            {{ 'common.next'|trans }}
                            <svg class="rams-btn__icon rams-btn__icon--right" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </button>
                    </div>
                </form>
            </div>

            {# Sidebar #}
            <div class="rams-layout__sidebar">
                {# Campaign Summary #}
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3 class="rams-module__title">{{ 'email_campaign.wizard.summary'|trans|default('Campaign Summary') }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <dl class="rams-definition-list">
                            <dt class="rams-dymo">{{ 'email_campaign.campaign_name'|trans }}</dt>
                            <dd>{{ campaign.name }}</dd>
                            
                            <dt class="rams-dymo">{{ 'email_campaign.subject'|trans }}</dt>
                            <dd>{{ campaign.subject }}</dd>
                            
                            <dt class="rams-dymo">{{ 'email_campaign.template'|trans }}</dt>
                            <dd>{{ campaign.template.name|default('—') }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.querySelectorAll('input[name="segment_type"]').forEach(radio => {
    radio.addEventListener('change', function() {
        document.getElementById('segmentSelector').style.display = this.value === 'segment' ? 'grid' : 'none';
    });
});
</script>
{% endblock %}
