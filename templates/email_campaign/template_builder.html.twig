{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.templates.template_builder'|trans }}{% endblock %}

{% block head %}
    {{ parent() }}
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.templates.create_template'|trans|default('Create Email Template') }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.templates.build_subtitle'|trans|default('Design a custom email template') }}</p>
            </div>
        </div>

        <form method="post" id="templateForm">
            <div class="rams-layout rams-layout--sidebar-right">
                {# Main Form #}
                <div class="rams-layout__main">
                    <div class="rams-module">
                        <div class="rams-module__content">
                            <div class="rams-form">
                                {# Template Name #}
                                <div class="rams-form__group">
                                    <label for="templateName" class="rams-form__label rams-dymo">{{ 'email_campaign.templates.name'|trans|default('Template Name') }} *</label>
                                    <input type="text" class="rams-form__input" id="templateName" name="name" required>
                                </div>

                                {# Subject Line #}
                                <div class="rams-form__group">
                                    <label for="subjectLine" class="rams-form__label rams-dymo">{{ 'email_campaign.subject'|trans }} *</label>
                                    <div class="rams-input-group">
                                        <input type="text" class="rams-form__input" id="subjectLine" name="subject_line" required 
                                               placeholder="{{ 'email_campaign.templates.subject_placeholder'|trans|default('e.g., Hello {{contact.firstName}}, check this out!') }}">
                                        <button class="rams-btn rams-btn--secondary" type="button" id="insertTokenBtn">
                                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                                            </svg>
                                            {{ 'email_campaign.templates.insert_token'|trans|default('Insert Token') }}
                                        </button>
                                    </div>
                                    <span class="rams-form__hint">{{ 'email_campaign.templates.subject_hint'|trans|default('Use personalization tokens like {{contact.firstName}}, {{company.name}}, etc.') }}</span>
                                </div>

                                {# Preview Text #}
                                <div class="rams-form__group">
                                    <label for="previewText" class="rams-form__label rams-dymo">{{ 'email_campaign.templates.preview_text'|trans|default('Preview Text') }}</label>
                                    <input type="text" class="rams-form__input" id="previewText" name="preview_text"
                                           placeholder="{{ 'email_campaign.templates.preview_placeholder'|trans|default('Text shown in inbox preview') }}">
                                    <span class="rams-form__hint">{{ 'email_campaign.templates.preview_hint'|trans|default('This appears in the inbox next to the subject line (50-100 characters recommended)') }}</span>
                                </div>

                                {# Email Body #}
                                <div class="rams-form__group">
                                    <label for="bodyHtml" class="rams-form__label rams-dymo">{{ 'email_campaign.templates.body'|trans|default('Email Body') }} *</label>
                                    <textarea id="bodyHtml" name="body_html" required></textarea>
                                </div>

                                {# Plain Text Version #}
                                <div class="rams-form__group">
                                    <label for="bodyText" class="rams-form__label rams-dymo">{{ 'email_campaign.templates.plain_text'|trans|default('Plain Text Version') }}</label>
                                    <textarea class="rams-form__textarea" id="bodyText" name="body_text" rows="8"
                                              placeholder="{{ 'email_campaign.templates.plain_text_placeholder'|trans|default('Auto-generated from HTML (you can customize)') }}"></textarea>
                                    <span class="rams-form__hint">{{ 'email_campaign.templates.plain_text_hint'|trans|default('Fallback for email clients that don\'t support HTML') }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="rams-module__footer">
                            <div class="rams-btn-group">
                                {% if campaignId %}
                                    <a href="{{ path('app_email_campaign_wizard_template', {id: campaignId}) }}" class="rams-btn rams-btn--secondary">
                                        {{ 'common.cancel'|trans }}
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_email_campaign_templates') }}" class="rams-btn rams-btn--secondary">
                                        {{ 'common.cancel'|trans }}
                                    </a>
                                {% endif %}
                                
                                <button type="submit" class="rams-btn rams-btn--primary">
                                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                    </svg>
                                    {{ 'email_campaign.templates.save_template'|trans|default('Save Template') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                {# Sidebar #}
                <div class="rams-layout__sidebar">
                    {# Personalization Tokens #}
                    <div class="rams-module">
                        <div class="rams-module__header">
                            <h3 class="rams-module__title">{{ 'email_campaign.templates.tokens'|trans|default('Personalization Tokens') }}</h3>
                        </div>
                        <div class="rams-module__content">
                            <div class="rams-token-group">
                                <span class="rams-dymo">{{ 'contact.fields'|trans|default('Contact Fields') }}</span>
                                <div class="rams-token-list">
                                    <button type="button" class="rams-token-btn" data-token="{{contact.firstName}}">{% verbatim %}{{contact.firstName}}{% endverbatim %}</button>
                                    <button type="button" class="rams-token-btn" data-token="{{contact.lastName}}">{% verbatim %}{{contact.lastName}}{% endverbatim %}</button>
                                    <button type="button" class="rams-token-btn" data-token="{{contact.email}}">{% verbatim %}{{contact.email}}{% endverbatim %}</button>
                                    <button type="button" class="rams-token-btn" data-token="{{contact.phone}}">{% verbatim %}{{contact.phone}}{% endverbatim %}</button>
                                    <button type="button" class="rams-token-btn" data-token="{{contact.title}}">{% verbatim %}{{contact.title}}{% endverbatim %}</button>
                                </div>
                            </div>

                            <div class="rams-token-group">
                                <span class="rams-dymo">{{ 'company.fields'|trans|default('Company Fields') }}</span>
                                <div class="rams-token-list">
                                    <button type="button" class="rams-token-btn" data-token="{{company.name}}">{% verbatim %}{{company.name}}{% endverbatim %}</button>
                                    <button type="button" class="rams-token-btn" data-token="{{company.industry}}">{% verbatim %}{{company.industry}}{% endverbatim %}</button>
                                    <button type="button" class="rams-token-btn" data-token="{{company.website}}">{% verbatim %}{{company.website}}{% endverbatim %}</button>
                                </div>
                            </div>

                            <div class="rams-token-group">
                                <span class="rams-dymo">{{ 'email_campaign.templates.system_tokens'|trans|default('System') }}</span>
                                <div class="rams-token-list">
                                    <button type="button" class="rams-token-btn" data-token="{{unsubscribe_url}}">{% verbatim %}{{unsubscribe_url}}{% endverbatim %}</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Category #}
                    <div class="rams-module">
                        <div class="rams-module__content">
                            <div class="rams-form__group">
                                <label for="category" class="rams-form__label rams-dymo">{{ 'email_campaign.templates.category'|trans|default('Category') }}</label>
                                <select class="rams-form__select" id="category" name="category">
                                    <option value="general">{{ 'email_campaign.templates.cat_general'|trans|default('General') }}</option>
                                    <option value="welcome">{{ 'email_campaign.templates.cat_welcome'|trans|default('Welcome') }}</option>
                                    <option value="newsletter">{{ 'email_campaign.templates.cat_newsletter'|trans|default('Newsletter') }}</option>
                                    <option value="promotional">{{ 'email_campaign.templates.cat_promotional'|trans|default('Promotional') }}</option>
                                    <option value="transactional">{{ 'email_campaign.templates.cat_transactional'|trans|default('Transactional') }}</option>
                                    <option value="followup">{{ 'email_campaign.templates.cat_followup'|trans|default('Follow-up') }}</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    {# Preview Button #}
                    <button type="button" class="rams-btn rams-btn--secondary rams-btn--full" id="previewBtn">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        {{ 'email_campaign.templates.preview'|trans|default('Preview') }}
                    </button>
                </div>
            </div>

            <input type="hidden" name="tokens" id="tokensInput" value="[]">
        </form>
    </div>
</div>

{# Preview Modal #}
<div class="rams-modal" id="previewModal">
    <div class="rams-modal__backdrop" onclick="closePreviewModal()"></div>
    <div class="rams-modal__container rams-modal__container--lg">
        <div class="rams-modal__header">
            <h3 class="rams-modal__title">{{ 'email_campaign.templates.preview'|trans|default('Email Preview') }}</h3>
            <button type="button" class="rams-btn rams-btn--ghost rams-btn--sm" onclick="closePreviewModal()">
                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div class="rams-modal__content">
            <div class="rams-preview-subject">
                <span class="rams-dymo">{{ 'email_campaign.subject'|trans }}:</span>
                <span id="previewSubject"></span>
            </div>
            <div class="rams-preview-content" id="previewContent"></div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize TinyMCE
    tinymce.init({
        selector: '#bodyHtml',
        height: 500,
        menubar: false,
        plugins: [
            'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
            'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
            'insertdatetime', 'media', 'table', 'help', 'wordcount'
        ],
        toolbar: 'undo redo | blocks | bold italic forecolor backcolor | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist outdent indent | link image | removeformat code',
        content_style: 'body { font-family: Arial, sans-serif; font-size: 14px; }',
        setup: function(editor) {
            editor.on('change', function() {
                const htmlContent = editor.getContent();
                const textContent = htmlContent.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
                document.getElementById('bodyText').value = textContent;
            });
        }
    });

    // Token insertion
    const tokenBtns = document.querySelectorAll('.rams-token-btn');
    tokenBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const token = this.dataset.token;
            const activeElement = document.activeElement;
            
            if (activeElement.id === 'subjectLine' || activeElement.id === 'previewText') {
                const start = activeElement.selectionStart;
                const end = activeElement.selectionEnd;
                const text = activeElement.value;
                activeElement.value = text.substring(0, start) + token + text.substring(end);
                activeElement.focus();
                activeElement.setSelectionRange(start + token.length, start + token.length);
            } else {
                tinymce.activeEditor.insertContent(token);
            }
        });
    });

    // Preview
    document.getElementById('previewBtn').addEventListener('click', function() {
        const subject = document.getElementById('subjectLine').value || '{{ 'email_campaign.templates.no_subject'|trans|default('No subject') }}';
        const body = tinymce.get('bodyHtml').getContent();
        
        const sampleData = {
            '{{contact.firstName}}': 'John',
            '{{contact.lastName}}': 'Doe',
            '{{contact.email}}': 'john.doe@example.com',
            '{{contact.phone}}': '+1 (555) 123-4567',
            '{{contact.title}}': 'Marketing Manager',
            '{{company.name}}': 'Acme Corporation',
            '{{company.industry}}': 'Technology',
            '{{company.website}}': 'https://acme.com',
            '{{unsubscribe_url}}': '#unsubscribe'
        };
        
        let previewSubject = subject;
        let previewBody = body;
        
        Object.entries(sampleData).forEach(([token, value]) => {
            previewSubject = previewSubject.replace(new RegExp(token.replace(/[{}]/g, '\\$&'), 'g'), value);
            previewBody = previewBody.replace(new RegExp(token.replace(/[{}]/g, '\\$&'), 'g'), value);
        });
        
        document.getElementById('previewSubject').textContent = previewSubject;
        document.getElementById('previewContent').innerHTML = previewBody;
        document.getElementById('previewModal').classList.add('rams-modal--open');
    });
});

function closePreviewModal() {
    document.getElementById('previewModal').classList.remove('rams-modal--open');
}
</script>
{% endblock %}
