{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.templates.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.templates.title'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.templates.subtitle'|trans|default('Reusable email templates for your campaigns') }}</p>
            </div>
            <div class="rams-page__actions">
                <a href="{{ path('app_email_campaign_template_builder') }}" class="rams-btn rams-btn--primary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    {{ 'email_campaign.templates.new_template'|trans }}
                </a>
            </div>
        </div>

        {# Templates List #}
        {% if templates is empty %}
            <div class="rams-module">
                <div class="rams-module__content rams-empty-state">
                    <svg class="rams-empty-state__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <h3 class="rams-empty-state__title">{{ 'email_campaign.templates.no_templates'|trans|default('No Templates Yet') }}</h3>
                    <p class="rams-empty-state__description">{{ 'email_campaign.templates.create_first'|trans|default('Create your first email template to get started') }}</p>
                    <a href="{{ path('app_email_campaign_template_builder') }}" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        {{ 'email_campaign.templates.create_first_btn'|trans|default('Create Your First Template') }}
                    </a>
                </div>
            </div>
        {% else %}
            <div class="rams-grid rams-grid--3">
                {% for template in templates %}
                    <div class="rams-module rams-module--interactive">
                        <div class="rams-template-preview">
                            <iframe srcdoc="{{ template.bodyHtml|escape }}" class="rams-template-preview__iframe"></iframe>
                        </div>
                        <div class="rams-module__content">
                            <h3 class="rams-module__title">{{ template.name }}</h3>
                            <p class="rams-module__description">{{ template.subjectLine }}</p>
                            
                            <div class="rams-module__meta">
                                <span class="rams-badge rams-badge--neutral">{{ template.category|upper }}</span>
                                {% if template.usageCount > 0 %}
                                    <span class="rams-dymo">
                                        <svg class="rams-icon rams-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </svg>
                                        {{ template.usageCount }} {{ 'email_campaign.templates.uses'|trans|default('uses') }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="rams-module__footer">
                            <div class="rams-btn-group rams-btn-group--full">
                                <button class="rams-btn rams-btn--secondary rams-btn--sm" onclick="previewTemplate({{ template.id }})">
                                    {{ 'email_campaign.templates.preview'|trans|default('Preview') }}
                                </button>
                                <button class="rams-btn rams-btn--secondary rams-btn--sm">
                                    {{ 'common.edit'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

{# Preview Modal #}
<div class="rams-modal" id="previewModal">
    <div class="rams-modal__backdrop"></div>
    <div class="rams-modal__container rams-modal__container--lg">
        <div class="rams-modal__header">
            <h3 class="rams-modal__title">{{ 'email_campaign.templates.preview'|trans|default('Template Preview') }}</h3>
            <button type="button" class="rams-btn rams-btn--ghost rams-btn--sm" onclick="closePreviewModal()">
                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div class="rams-modal__content">
            <div class="rams-preview-subject">
                <span class="rams-dymo">{{ 'email_campaign.subject'|trans }}:</span>
                <span id="previewSubject"></span>
            </div>
            <div class="rams-preview-content" id="previewContent"></div>
        </div>
    </div>
</div>

<script>
function previewTemplate(templateId) {
    const modal = document.getElementById('previewModal');
    modal.classList.add('rams-modal--open');
}

function closePreviewModal() {
    const modal = document.getElementById('previewModal');
    modal.classList.remove('rams-modal--open');
}
</script>
{% endblock %}
