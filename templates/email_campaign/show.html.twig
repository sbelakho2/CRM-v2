{% extends 'base.html.twig' %}

{% block title %}{{ campaign.name }} - {{ 'email_campaign.title_singular'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <nav class="rams-breadcrumb rams-mb-2">
                <ol class="rams-breadcrumb__list">
                    <li class="rams-breadcrumb__item"><a href="{{ path('app_email_campaign_index') }}" class="rams-breadcrumb__link">{{ 'email_campaign.title'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ campaign.name }}</li>
                </ol>
            </nav>
            <h1 class="rams-page-title">{{ campaign.name }}</h1>
            <div class="rams-flex rams-items-center rams-gap-2 rams-mt-1">
                <span class="rams-badge {{ campaign.active ? 'rams-badge--success' : '' }}">
                    {{ (campaign.active ? 'common.active' : 'common.inactive')|trans }}
                </span>
                <span class="rams-badge rams-badge--info">
                    {{ campaign.language }}
                </span>
            </div>
        </div>
        <div class="rams-page-actions mobile-stack">
            <div class="rams-btn-group mobile-stack">
                <form method="post" action="{{ path('app_email_campaign_toggle_active', {id: campaign.id}) }}" class="rams-inline-block">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ campaign.id) }}">
                    <button type="submit" class="rams-btn" aria-expanded="false">
                        {{ (campaign.active ? 'email_campaign.deactivate' : 'email_campaign.activate')|trans }}
                    </button>
                </form>
                <a href="{{ path('app_email_campaign_send', {id: campaign.id}) }}" class="rams-btn rams-btn--primary"> 
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    {{ 'email_campaign.send_emails'|trans }}
                </a>
                <a href="{{ path('app_email_campaign_edit', {id: campaign.id}) }}" class="rams-btn">
                    {{ 'common.edit'|trans }}
                </a>
            </div>
        </div>
    </div>

    {# Metrics Row #}
    <div class="rams-grid rams-grid--5">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'email_campaign.total_sent'|trans }}</span>
                    <span class="rams-metric__value">{{ metrics.total_sent }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'email_campaign.open_rate'|trans }}</span>
                    <span class="rams-metric__value rams-text--success">{{ metrics.open_rate|number_format(1) }}%</span>
                    <span class="rams-metric__unit">{{ metrics.opened }} {{ 'email_campaign.opened'|trans|lower }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'email_campaign.click_rate'|trans }}</span>
                    <span class="rams-metric__value rams-text--info">{{ metrics.click_rate|number_format(1) }}%</span>
                    <span class="rams-metric__unit">{{ metrics.clicked }} {{ 'email_campaign.clicked'|trans|lower }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'email_campaign.reply_rate'|trans }}</span>
                    <span class="rams-metric__value rams-text--info">{{ metrics.reply_rate|number_format(1) }}%</span>
                    <span class="rams-metric__unit">{{ metrics.replied }} {{ 'email_campaign.replied'|trans|lower }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'email_campaign.bounce_rate'|trans }}</span>
                    <span class="rams-metric__value rams-text--danger">{{ metrics.bounce_rate|number_format(1) }}%</span>
                    <span class="rams-metric__unit">{{ metrics.bounced }} {{ 'email_campaign.bounced'|trans|lower }}</span>
                </div>
            </div>
        </div>
    </div>

    {# Touch Performance #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'email_campaign.touch_performance'|trans }}</h2>
        </div>
        <div class="rams-module__content">
            <div class="rams-stack rams-gap-4">
                {% for i in 1..campaign.touchCount %}
                    {% set touch = touchMetrics[i] %}
                    <div class="rams-p-4 rams-border rams-rounded rams-bg-panel">
                        <div class="rams-flex rams-justify-between rams-items-center rams-mb-4 mobile-stack">
                            <div class="rams-flex rams-items-center rams-gap-3">
                                <span class="rams-badge rams-badge--primary">{{ i }}</span>
                                <div>
                                    <span class="rams-text--bold">{{ 'email_campaign.touch'|trans }} {{ i }}</span>
                                    <span class="rams-text--muted rams-text--xs rams-block">{{ touch.total }} {{ 'email_campaign.sent'|trans|lower }}</span>
                                </div>
                            </div>
                            <div class="rams-flex rams-gap-6 mobile-stack">
                                <div class="rams-metric rams-text--right">
                                    <span class="rams-metric__label rams-text--xs">{{ 'email_campaign.opens'|trans }}</span>
                                    <span class="rams-metric__value rams-text--lg rams-text--success">{{ touch.open_rate|number_format(1) }}%</span>
                                </div>
                                <div class="rams-metric rams-text--right">
                                    <span class="rams-metric__label rams-text--xs">{{ 'email_campaign.clicks'|trans }}</span>
                                    <span class="rams-metric__value rams-text--lg rams-text--info">{{ touch.click_rate|number_format(1) }}%</span>
                                </div>
                                <div class="rams-metric rams-text--right">
                                    <span class="rams-metric__label rams-text--xs">{{ 'email_campaign.replies'|trans }}</span>
                                    <span class="rams-metric__value rams-text--lg rams-text--info">{{ touch.reply_rate|number_format(1) }}%</span>
                                </div>
                            </div>
                        </div>
                        
                        {% if touch.total > 0 %}
                            <div class="rams-stack rams-gap-2">
                                <div class="rams-progress rams-progress--compact">
                                    <div class="rams-progress__bar rams-progress__bar--success" style="--rams-meter-value: {{ touch.open_rate|default(0) }}%"></div>
                                </div>
                                <div class="rams-progress rams-progress--compact">
                                    <div class="rams-progress__bar rams-progress__bar--info" style="--rams-meter-value: {{ touch.click_rate|default(0) }}%"></div>
                                </div>
                                <div class="rams-progress rams-progress--compact">
                                    <div class="rams-progress__bar rams-progress__bar--primary" style="--rams-meter-value: {{ touch.reply_rate|default(0) }}%"></div>
                                </div>
                            </div>
                        {% else %}
                            <p class="rams-text--muted rams-text--xs rams-text--center">{{ 'email_campaign.no_sends_yet'|trans }}</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Recent Sends #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'email_campaign.recent_sends'|trans }}</h2>
        </div>
        <div class="rams-module__content rams-module__content--flush">
            {% if campaign.emailSends is empty %}
                <div class="rams-empty-state">
                    <p class="rams-empty-state__description">{{ 'email_campaign.no_emails_sent'|trans }}</p>
                </div>
            {% else %}
                <div class="rams-table-container">
                    <table class="rams-table">
                        <thead>
                            <tr>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'contact.title_singular'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'email_campaign.touch'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'email_campaign.sent_at'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header rams-text--center">{{ 'email_campaign.opened'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header rams-text--center">{{ 'email_campaign.clicked'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header rams-text--center">{{ 'email_campaign.replies'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for send in campaign.emailSends|slice(0, 20) %}
                                <tr class="rams-table__row">
                                    <td class="rams-table__cell">
                                        <div class="rams-text--bold">{{ send.contact.firstName }} {{ send.contact.lastName }}</div>
                                        <div class="rams-text--muted rams-text--xs">{{ send.contact.email }}</div>
                                    </td>
                                    <td class="rams-table__cell">
                                        <span class="rams-badge">{{ 'email_campaign.touch'|trans }} {{ send.touchNumber }}</span>
                                    </td>
                                    <td class="rams-table__cell rams-text--xs">
                                        {{ send.sentAt|date('M d, Y H:i') }}
                                    </td>
                                    <td class="rams-table__cell rams-text--center">
                                        <div class="rams-andon">
                                            <span class="rams-andon__light rams-andon__light--{{ send.opened ? 'green' : '' }}"></span>
                                        </div>
                                    </td>
                                    <td class="rams-table__cell rams-text--center">
                                        <div class="rams-andon">
                                            <span class="rams-andon__light rams-andon__light--{{ send.clicked ? 'info' : '' }}"></span>
                                        </div>
                                    </td>
                                    <td class="rams-table__cell rams-text--center">
                                        <div class="rams-andon">
                                            <span class="rams-andon__light rams-andon__light--{{ send.replied ? 'primary' : '' }}"></span>
                                        </div>
                                    </td>
                                    <td class="rams-table__cell rams-table__cell--actions">
                                        <div class="rams-btn-group mobile-stack">
                                            {% if not send.replied %}
                                                <form method="post" action="{{ path('app_email_send_mark_replied', {id: send.id}) }}" class="rams-inline-block">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('mark_replied' ~ send.id) }}">
                                                    <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm"  title="{{ 'email_campaign.mark_replied'|trans }}" aria-label="{{ 'email_campaign.mark_replied'|trans }}">
                                                        <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                                            <path d="M13 12V7C13 5.89543 12.1046 5 11 5H3M3 5L6 2M3 5L6 8"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            {% endif %}
                                            {% if not send.bounced %}
                                                <form method="post" action="{{ path('app_email_send_mark_bounced', {id: send.id}) }}" class="rams-inline-block">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('mark_bounced' ~ send.id) }}">
                                                    <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm"  title="{{ 'email_campaign.mark_bounced'|trans }}" aria-label="{{ 'email_campaign.mark_bounced'|trans }}">
                                                        <svg class="rams-icon rams-text--danger" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                                            <path d="M8 2L1 14H15L8 2Z M8 6V10 M8 12H8.01"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if campaign.emailSends|length > 20 %}
                    <div class="rams-p-3 rams-text--center rams-border-t">
                        <p class="rams-text--muted rams-text--xs">{{ 'email_campaign.showing_sends'|trans }} 20 / {{ campaign.emailSends|length }}</p>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {# Delete Campaign #}
    <div class="rams-module rams-border-danger">
        <div class="rams-module__content">
            <div class="rams-flex rams-justify-between rams-items-center">
                <div>
                    <h3 class="rams-heading rams-heading--4 rams-text--danger">{{ 'email_campaign.delete_campaign'|trans }}</h3>
                    <p class="rams-text--muted rams-text--xs">{{ 'email_campaign.delete_warning'|trans }}</p>
                </div>
                <form method="post" action="{{ path('app_email_campaign_delete', {id: campaign.id}) }}" onsubmit="return ramsConfirmSubmit(event, '{{ 'email_campaign.confirm_delete'|trans }}', {variant: 'danger'})">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ campaign.id) }}">
                    <button type="submit" class="rams-btn rams-btn--danger"> 
                        {{ 'common.delete'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
