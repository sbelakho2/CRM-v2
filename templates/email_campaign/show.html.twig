{% extends 'base.html.twig' %}

{% block title %}{{ campaign.name }} - {{ 'email_campaign.title_singular'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Breadcrumb #}
        <nav class="rams-breadcrumb">
            <ol class="rams-breadcrumb__list">
                <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item"><a href="{{ path('app_email_campaign_index') }}" class="rams-breadcrumb__link">{{ 'email_campaign.title'|trans }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ campaign.name }}</li>
            </ol>
        </nav>

        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <div class="rams-page__title-row">
                    <h1 class="rams-page__title">{{ campaign.name }}</h1>
                    <span class="rams-badge {{ campaign.active ? 'rams-badge--success' : 'rams-badge--neutral' }}">
                        {{ campaign.active ? 'common.active'|trans : 'common.inactive'|trans }}
                    </span>
                    <span class="rams-badge rams-badge--info">
                        {{ campaign.language }}
                    </span>
                </div>
                {% if campaign.description %}
                    <p class="rams-page__subtitle">{{ campaign.description }}</p>
                {% endif %}
            </div>
            <div class="rams-page__actions">
                <form method="post" action="{{ path('app_email_campaign_toggle_active', {id: campaign.id}) }}" class="rams-inline-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ campaign.id) }}">
                    <button type="submit" class="rams-btn rams-btn--secondary">
                        {{ campaign.active ? 'email_campaign.deactivate'|trans : 'email_campaign.activate'|trans }}
                    </button>
                </form>
                <a href="{{ path('app_email_campaign_send', {id: campaign.id}) }}" class="rams-btn rams-btn--primary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    {{ 'email_campaign.send_emails'|trans }}
                </a>
                <a href="{{ path('app_email_campaign_edit', {id: campaign.id}) }}" class="rams-btn rams-btn--secondary">
                    {{ 'common.edit'|trans }}
                </a>
            </div>
        </div>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="rams-andon rams-andon--{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Overall Metrics #}
        <div class="rams-metrics-grid rams-metrics-grid--5">
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <div class="rams-metric rams-metric--large">
                        <span class="rams-metric__value">{{ metrics.total_sent }}</span>
                        <span class="rams-metric__label">{{ 'email_campaign.total_sent'|trans }}</span>
                    </div>
                </div>
            </div>
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <div class="rams-metric rams-metric--large rams-metric--success">
                        <span class="rams-metric__value">{{ metrics.open_rate|number_format(1) }}%</span>
                        <span class="rams-metric__label">{{ 'email_campaign.open_rate'|trans }}</span>
                        <span class="rams-metric__sub">{{ metrics.opened }} {{ 'email_campaign.opened'|trans|lower }}</span>
                    </div>
                </div>
            </div>
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <div class="rams-metric rams-metric--large rams-metric--info">
                        <span class="rams-metric__value">{{ metrics.click_rate|number_format(1) }}%</span>
                        <span class="rams-metric__label">{{ 'email_campaign.click_rate'|trans }}</span>
                        <span class="rams-metric__sub">{{ metrics.clicked }} {{ 'email_campaign.clicked'|trans|lower }}</span>
                    </div>
                </div>
            </div>
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <div class="rams-metric rams-metric--large rams-metric--primary">
                        <span class="rams-metric__value">{{ metrics.reply_rate|number_format(1) }}%</span>
                        <span class="rams-metric__label">{{ 'email_campaign.reply_rate'|trans }}</span>
                        <span class="rams-metric__sub">{{ metrics.replied }} {{ 'email_campaign.replied'|trans|lower }}</span>
                    </div>
                </div>
            </div>
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <div class="rams-metric rams-metric--large rams-metric--danger">
                        <span class="rams-metric__value">{{ metrics.bounce_rate|number_format(1) }}%</span>
                        <span class="rams-metric__label">{{ 'email_campaign.bounce_rate'|trans }}</span>
                        <span class="rams-metric__sub">{{ metrics.bounced }} {{ 'email_campaign.bounced'|trans|lower }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# Touch Performance #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'email_campaign.touch_performance'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                <div class="rams-touch-list">
                    {% for i in 1..campaign.touchCount %}
                        {% set touch = touchMetrics[i] %}
                        <div class="rams-touch-item">
                            <div class="rams-touch-item__header">
                                <div class="rams-touch-item__number">
                                    <span class="rams-badge rams-badge--info rams-badge--circle">{{ i }}</span>
                                </div>
                                <div class="rams-touch-item__info">
                                    <span class="rams-touch-item__title">{{ 'email_campaign.touch'|trans }} {{ i }}</span>
                                    <span class="rams-dymo">{{ touch.total }} {{ 'email_campaign.sent'|trans|lower }}</span>
                                </div>
                                <div class="rams-touch-item__metrics">
                                    <div class="rams-metric rams-metric--inline rams-metric--success">
                                        <span class="rams-metric__value">{{ touch.open_rate|number_format(1) }}%</span>
                                        <span class="rams-metric__label">{{ 'email_campaign.opens'|trans }}</span>
                                    </div>
                                    <div class="rams-metric rams-metric--inline rams-metric--info">
                                        <span class="rams-metric__value">{{ touch.click_rate|number_format(1) }}%</span>
                                        <span class="rams-metric__label">{{ 'email_campaign.clicks'|trans }}</span>
                                    </div>
                                    <div class="rams-metric rams-metric--inline rams-metric--primary">
                                        <span class="rams-metric__value">{{ touch.reply_rate|number_format(1) }}%</span>
                                        <span class="rams-metric__label">{{ 'email_campaign.replies'|trans }}</span>
                                    </div>
                                </div>
                            </div>
                            
                            {% if touch.total > 0 %}
                                <div class="rams-progress-bars">
                                    <div class="rams-progress-bar">
                                        <span class="rams-progress-bar__label">{{ 'email_campaign.opens'|trans }}</span>
                                        <div class="rams-progress-bar__track">
                                            <div class="rams-progress-bar__fill rams-progress-bar__fill--success" style="width: {{ touch.open_rate }}%"></div>
                                        </div>
                                        <span class="rams-progress-bar__value">{{ touch.opened }}</span>
                                    </div>
                                    <div class="rams-progress-bar">
                                        <span class="rams-progress-bar__label">{{ 'email_campaign.clicks'|trans }}</span>
                                        <div class="rams-progress-bar__track">
                                            <div class="rams-progress-bar__fill rams-progress-bar__fill--info" style="width: {{ touch.click_rate }}%"></div>
                                        </div>
                                        <span class="rams-progress-bar__value">{{ touch.clicked }}</span>
                                    </div>
                                    <div class="rams-progress-bar">
                                        <span class="rams-progress-bar__label">{{ 'email_campaign.replies'|trans }}</span>
                                        <div class="rams-progress-bar__track">
                                            <div class="rams-progress-bar__fill rams-progress-bar__fill--primary" style="width: {{ touch.reply_rate }}%"></div>
                                        </div>
                                        <span class="rams-progress-bar__value">{{ touch.replied }}</span>
                                    </div>
                                </div>
                            {% else %}
                                <p class="rams-text--muted rams-text--center">{{ 'email_campaign.no_sends_yet'|trans }}</p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Recent Sends #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'email_campaign.recent_sends'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                {% if campaign.emailSends is empty %}
                    <div class="rams-empty-state rams-empty-state--compact">
                        <p class="rams-empty-state__description">{{ 'email_campaign.no_emails_sent'|trans }}</p>
                    </div>
                {% else %}
                    <div class="rams-table-wrapper">
                        <table class="rams-table">
                            <thead class="rams-table__header">
                                <tr>
                                    <th class="rams-table__cell">{{ 'contact.title_singular'|trans }}</th>
                                    <th class="rams-table__cell">{{ 'email_campaign.touch'|trans }}</th>
                                    <th class="rams-table__cell">{{ 'email_campaign.sent_at'|trans }}</th>
                                    <th class="rams-table__cell rams-table__cell--center">{{ 'email_campaign.opened'|trans }}</th>
                                    <th class="rams-table__cell rams-table__cell--center">{{ 'email_campaign.clicked'|trans }}</th>
                                    <th class="rams-table__cell rams-table__cell--center">{{ 'email_campaign.replied'|trans }}</th>
                                    <th class="rams-table__cell rams-table__cell--center">{{ 'common.actions'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for send in campaign.emailSends|slice(0, 20) %}
                                    <tr class="rams-table__row">
                                        <td class="rams-table__cell">
                                            <div class="rams-table__primary">{{ send.contact.firstName }} {{ send.contact.lastName }}</div>
                                            <div class="rams-table__secondary">{{ send.contact.email }}</div>
                                        </td>
                                        <td class="rams-table__cell">
                                            <span class="rams-badge rams-badge--info">{{ 'email_campaign.touch'|trans }} {{ send.touchNumber }}</span>
                                        </td>
                                        <td class="rams-table__cell">
                                            {{ send.sentAt|date('M d, Y H:i') }}
                                        </td>
                                        <td class="rams-table__cell rams-table__cell--center">
                                            <span class="rams-andon rams-andon--dot {{ send.opened ? 'rams-andon--success' : 'rams-andon--neutral' }}"></span>
                                        </td>
                                        <td class="rams-table__cell rams-table__cell--center">
                                            <span class="rams-andon rams-andon--dot {{ send.clicked ? 'rams-andon--info' : 'rams-andon--neutral' }}"></span>
                                        </td>
                                        <td class="rams-table__cell rams-table__cell--center">
                                            <span class="rams-andon rams-andon--dot {{ send.replied ? 'rams-andon--primary' : 'rams-andon--neutral' }}"></span>
                                        </td>
                                        <td class="rams-table__cell rams-table__cell--center">
                                            <div class="rams-action-buttons">
                                                {% if not send.replied %}
                                                    <form method="post" action="{{ path('app_email_send_mark_replied', {id: send.id}) }}" class="rams-inline-form">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('mark_replied' ~ send.id) }}">
                                                        <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'email_campaign.mark_replied'|trans }}">
                                                            ↩️
                                                        </button>
                                                    </form>
                                                {% endif %}
                                                {% if not send.bounced %}
                                                    <form method="post" action="{{ path('app_email_send_mark_bounced', {id: send.id}) }}" class="rams-inline-form">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('mark_bounced' ~ send.id) }}">
                                                        <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'email_campaign.mark_bounced'|trans }}">
                                                            ⚠️
                                                        </button>
                                                    </form>
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if campaign.emailSends|length > 20 %}
                        <div class="rams-module__footer">
                            <p class="rams-text--muted rams-text--center">{{ 'email_campaign.showing_sends'|trans }} {{ campaign.emailSends|length }} {{ 'email_campaign.sends'|trans }}</p>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        {# Delete Campaign #}
        <div class="rams-module rams-module--danger">
            <div class="rams-module__content">
                <div class="rams-danger-zone">
                    <div class="rams-danger-zone__info">
                        <h3 class="rams-danger-zone__title">{{ 'email_campaign.delete_campaign'|trans }}</h3>
                        <p class="rams-danger-zone__description">{{ 'email_campaign.delete_warning'|trans }}</p>
                    </div>
                    <form method="post" action="{{ path('app_email_campaign_delete', {id: campaign.id}) }}" onsubmit="return ramsConfirmSubmit(event, '{{ 'email_campaign.confirm_delete'|trans }}', {variant: 'danger'})">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ campaign.id) }}">
                        <button type="submit" class="rams-btn rams-btn--danger">
                            {{ 'common.delete'|trans }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
