{% extends 'base.html.twig' %}

{% block title %}{{ campaign.name }} - Email Campaign{% endblock %}

{% block body %}
<div class="p-8">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-3 text-sm text-zinc-400 mb-4">
            <a href="{{ path('app_email_campaign_index') }}" class="hover:text-white transition-colors">Email Campaigns</a>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 4l4 4-4 4"/>
            </svg>
            <span class="text-white">{{ campaign.name }}</span>
        </div>

        <div class="flex items-start justify-between">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <h1 class="text-2xl font-semibold text-white">{{ campaign.name }}</h1>
                    <span class="px-2 py-0.5 text-xs font-medium rounded-full {{ campaign.active ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 'bg-zinc-700 text-zinc-400 border border-zinc-600' }}">
                        {{ campaign.active ? 'Active' : 'Inactive' }}
                    </span>
                    <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20">
                        {{ campaign.language }}
                    </span>
                </div>
                {% if campaign.description %}
                    <p class="text-sm text-zinc-400">{{ campaign.description }}</p>
                {% endif %}
            </div>

            <div class="flex items-center gap-2">
                <form method="post" action="{{ path('app_email_campaign_toggle_active', {id: campaign.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ campaign.id) }}">
                    <button type="submit" class="geist-button-secondary">
                        {{ campaign.active ? 'Deactivate' : 'Activate' }}
                    </button>
                </form>
                <a href="{{ path('app_email_campaign_send', {id: campaign.id}) }}" class="geist-button">
                    Send Emails
                </a>
                <a href="{{ path('app_email_campaign_edit', {id: campaign.id}) }}" class="geist-button-secondary">
                    Edit
                </a>
            </div>
        </div>
    </div>

    <!-- Overall Metrics -->
    <div class="grid grid-cols-5 gap-4 mb-8">
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-white mb-1">{{ metrics.total_sent }}</div>
            <div class="text-sm text-zinc-400">Total Sent</div>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-green-400 mb-1">{{ metrics.open_rate|number_format(1) }}%</div>
            <div class="text-sm text-zinc-400">Open Rate</div>
            <div class="text-xs text-zinc-500 mt-1">{{ metrics.opened }} opened</div>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-blue-400 mb-1">{{ metrics.click_rate|number_format(1) }}%</div>
            <div class="text-sm text-zinc-400">Click Rate</div>
            <div class="text-xs text-zinc-500 mt-1">{{ metrics.clicked }} clicked</div>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-purple-400 mb-1">{{ metrics.reply_rate|number_format(1) }}%</div>
            <div class="text-sm text-zinc-400">Reply Rate</div>
            <div class="text-xs text-zinc-500 mt-1">{{ metrics.replied }} replied</div>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
            <div class="text-3xl font-semibold text-red-400 mb-1">{{ metrics.bounce_rate|number_format(1) }}%</div>
            <div class="text-sm text-zinc-400">Bounce Rate</div>
            <div class="text-xs text-zinc-500 mt-1">{{ metrics.bounced }} bounced</div>
        </div>
    </div>

    <!-- Touch Performance -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6 mb-8">
        <h2 class="text-lg font-semibold text-white mb-6">Touch Performance</h2>
        <div class="space-y-4">
            {% for i in 1..campaign.touchCount %}
                {% set touch = touchMetrics[i] %}
                <div class="border border-zinc-800 rounded-lg p-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
                                <span class="text-sm font-medium text-blue-400">{{ i }}</span>
                            </div>
                            <div>
                                <div class="text-sm font-medium text-white">Touch {{ i }}</div>
                                <div class="text-xs text-zinc-500">{{ touch.total }} sent</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-6">
                            <div class="text-right">
                                <div class="text-sm font-medium text-green-400">{{ touch.open_rate|number_format(1) }}%</div>
                                <div class="text-xs text-zinc-500">Opens</div>
                            </div>
                            <div class="text-right">
                                <div class="text-sm font-medium text-blue-400">{{ touch.click_rate|number_format(1) }}%</div>
                                <div class="text-xs text-zinc-500">Clicks</div>
                            </div>
                            <div class="text-right">
                                <div class="text-sm font-medium text-purple-400">{{ touch.reply_rate|number_format(1) }}%</div>
                                <div class="text-xs text-zinc-500">Replies</div>
                            </div>
                        </div>
                    </div>
                    
                    {% if touch.total > 0 %}
                        <!-- Progress Bars -->
                        <div class="space-y-2">
                            <div class="flex items-center gap-2">
                                <div class="text-xs text-zinc-500 w-16">Opens</div>
                                <div class="flex-1 h-2 bg-zinc-800 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-green-500 to-green-400" style="width: {{ touch.open_rate }}%"></div>
                                </div>
                                <div class="text-xs text-zinc-400 w-12 text-right">{{ touch.opened }}</div>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="text-xs text-zinc-500 w-16">Clicks</div>
                                <div class="flex-1 h-2 bg-zinc-800 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-blue-500 to-blue-400" style="width: {{ touch.click_rate }}%"></div>
                                </div>
                                <div class="text-xs text-zinc-400 w-12 text-right">{{ touch.clicked }}</div>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="text-xs text-zinc-500 w-16">Replies</div>
                                <div class="flex-1 h-2 bg-zinc-800 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-purple-500 to-purple-400" style="width: {{ touch.reply_rate }}%"></div>
                                </div>
                                <div class="text-xs text-zinc-400 w-12 text-right">{{ touch.replied }}</div>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-sm text-zinc-500 text-center py-2">No sends yet</div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Recent Sends -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-white mb-4">Recent Sends</h2>
        {% if campaign.sends is empty %}
            <div class="text-center py-8 text-zinc-500">
                No emails sent yet
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-zinc-800">
                            <th class="text-left text-xs font-medium text-zinc-400 pb-3">Contact</th>
                            <th class="text-left text-xs font-medium text-zinc-400 pb-3">Touch</th>
                            <th class="text-left text-xs font-medium text-zinc-400 pb-3">Sent</th>
                            <th class="text-center text-xs font-medium text-zinc-400 pb-3">Opened</th>
                            <th class="text-center text-xs font-medium text-zinc-400 pb-3">Clicked</th>
                            <th class="text-center text-xs font-medium text-zinc-400 pb-3">Replied</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for send in campaign.sends|slice(0, 20) %}
                            <tr class="border-b border-zinc-800/50 hover:bg-zinc-800/30">
                                <td class="py-3">
                                    <div class="text-sm text-white">{{ send.contact.firstName }} {{ send.contact.lastName }}</div>
                                    <div class="text-xs text-zinc-500">{{ send.contact.email }}</div>
                                </td>
                                <td class="py-3">
                                    <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20">
                                        Touch {{ send.touchNumber }}
                                    </span>
                                </td>
                                <td class="py-3 text-sm text-zinc-400">
                                    {{ send.sentAt|date('M d, Y H:i') }}
                                </td>
                                <td class="py-3 text-center">
                                    {% if send.opened %}
                                        <span class="inline-block w-2 h-2 bg-green-500 rounded-full"></span>
                                    {% else %}
                                        <span class="inline-block w-2 h-2 bg-zinc-700 rounded-full"></span>
                                    {% endif %}
                                </td>
                                <td class="py-3 text-center">
                                    {% if send.clicked %}
                                        <span class="inline-block w-2 h-2 bg-blue-500 rounded-full"></span>
                                    {% else %}
                                        <span class="inline-block w-2 h-2 bg-zinc-700 rounded-full"></span>
                                    {% endif %}
                                </td>
                                <td class="py-3 text-center">
                                    {% if send.replied %}
                                        <span class="inline-block w-2 h-2 bg-purple-500 rounded-full"></span>
                                    {% else %}
                                        <span class="inline-block w-2 h-2 bg-zinc-700 rounded-full"></span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if campaign.sends|length > 20 %}
                <div class="mt-4 text-center text-sm text-zinc-500">
                    Showing 20 of {{ campaign.sends|length }} sends
                </div>
            {% endif %}
        {% endif %}
    </div>

    <!-- Delete Campaign -->
    <div class="mt-8 pt-8 border-t border-zinc-800">
        <form method="post" action="{{ path('app_email_campaign_delete', {id: campaign.id}) }}" onsubmit="return confirm('Are you sure you want to delete this campaign? All send data will be lost.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ campaign.id) }}">
            <button type="submit" class="text-sm text-red-400 hover:text-red-300 transition-colors">
                Delete Campaign
            </button>
        </form>
    </div>
</div>
{% endblock %}
