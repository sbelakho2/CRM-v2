{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.edit_campaign'|trans }} - {{ campaign.name }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container rams-page__container--narrow">
        
        {# Breadcrumb #}
        <nav class="rams-breadcrumb">
            <ol class="rams-breadcrumb__list">
                <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item"><a href="{{ path('app_email_campaign_index') }}" class="rams-breadcrumb__link">{{ 'email_campaign.title'|trans }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item"><a href="{{ path('app_email_campaign_show', {id: campaign.id}) }}" class="rams-breadcrumb__link">{{ campaign.name }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'common.edit'|trans }}</li>
            </ol>
        </nav>

        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.edit_campaign'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.update_settings'|trans }}</p>
            </div>
        </div>

        {# Form #}
        <div class="rams-module">
            <div class="rams-module__content">
                {{ form_start(form) }}
                
                <div class="rams-form">
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'email_campaign.campaign_name'|trans }}</label>
                        {{ form_widget(form.name, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <div class="rams-form__row rams-form__row--2">
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'email_campaign.language'|trans }}</label>
                            {{ form_widget(form.language, {'attr': {'class': 'rams-form__select'}}) }}
                            {{ form_errors(form.language) }}
                        </div>

                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'email_campaign.touch_count'|trans }}</label>
                            {{ form_widget(form.touchCount, {'attr': {'class': 'rams-form__input'}}) }}
                            {{ form_errors(form.touchCount) }}
                        </div>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'email_campaign.form.subject'|trans }}</label>
                        {{ form_widget(form.subject, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.subject) }}
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'email_campaign.form.body_html'|trans }}</label>
                        {{ form_widget(form.bodyHtml, {'attr': {'class': 'rams-form__textarea', 'rows': 8}}) }}
                        {{ form_errors(form.bodyHtml) }}
                        <span class="rams-form__hint">{{ 'email_campaign.form.body_html_placeholder'|trans }}</span>
                    </div>

                    <div class="rams-form__row rams-form__row--2">
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'email_campaign.form.from_name'|trans }}</label>
                            {{ form_widget(form.fromName, {'attr': {'class': 'rams-form__input'}}) }}
                            {{ form_errors(form.fromName) }}
                        </div>
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'email_campaign.form.from_email'|trans }}</label>
                            {{ form_widget(form.fromEmail, {'attr': {'class': 'rams-form__input'}}) }}
                            {{ form_errors(form.fromEmail) }}
                        </div>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'email_campaign.form.touch_templates'|trans }}</label>
                        {{ form_widget(form.touchTemplates, {'attr': {'class': 'rams-form__textarea rams-font-mono', 'rows': 3}}) }}
                        {{ form_errors(form.touchTemplates) }}
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'common.description'|trans }}</label>
                        {{ form_widget(form.description, {'attr': {'class': 'rams-form__textarea'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="rams-form__group rams-form__group">
                        {{ form_widget(form.active, {'attr': {'class': 'rams-form__checkbox'}}) }}
                        <label class="rams-form__label rams-form__label">{{ 'common.active'|trans }}</label>
                    </div>
                </div>

                <div class="rams-module__footer">
                    <div class="rams-btn-group mobile-stack">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            {{ 'common.save'|trans }}
                        </button>
                        <a href="{{ path('app_email_campaign_show', {id: campaign.id}) }}" class="rams-btn">
                            {{ 'common.cancel'|trans }}
                        </a>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
