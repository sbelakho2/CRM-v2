{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.segments.segment_builder'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.segments.segment_builder'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.segments.build_subtitle'|trans|default('Build custom contact segments with filter rules') }}</p>
            </div>
        </div>

        <form method="post" id="segmentForm">
            <div class="rams-layout rams-layout--sidebar-right">
                {# Main Form #}
                <div class="rams-layout__main">
                    <div class="rams-module">
                        <div class="rams-module__content">
                            <div class="rams-form">
                                {# Segment Name #}
                                <div class="rams-form__group">
                                    <label for="segmentName" class="rams-form__label rams-dymo">{{ 'email_campaign.segments.name'|trans|default('Segment Name') }} *</label>
                                    <input type="text" class="rams-form__input" id="segmentName" name="name" required
                                           placeholder="{{ 'email_campaign.segments.name_placeholder'|trans|default('e.g., Active Customers in Tech Industry') }}">
                                </div>

                                {# Description #}
                                <div class="rams-form__group">
                                    <label for="segmentDescription" class="rams-form__label rams-dymo">{{ 'common.description'|trans }}</label>
                                    <textarea class="rams-form__textarea" id="segmentDescription" name="description" rows="2"
                                              placeholder="{{ 'email_campaign.segments.description_placeholder'|trans|default('Describe the purpose of this segment') }}"></textarea>
                                </div>

                                {# Filter Builder #}
                                <div class="rams-form__group">
                                    <label class="rams-form__label rams-dymo">{{ 'email_campaign.segments.filter_rules'|trans|default('Filter Rules') }} *</label>
                                    
                                    <div class="rams-filter-builder" id="filterBuilder">
                                        {# Main operator selector #}
                                        <div class="rams-filter-builder__operator">
                                            <span class="rams-filter-builder__operator-label">{{ 'email_campaign.segments.match'|trans|default('Match') }}:</span>
                                            <div class="rams-segmented-control rams-segmented-control--compact">
                                                <label class="rams-segmented-control__item">
                                                    <input type="radio" name="mainOperator" value="AND" checked>
                                                    <span>{{ 'email_campaign.segments.match_all'|trans|default('ALL') }}</span>
                                                </label>
                                                <label class="rams-segmented-control__item">
                                                    <input type="radio" name="mainOperator" value="OR">
                                                    <span>{{ 'email_campaign.segments.match_any'|trans|default('ANY') }}</span>
                                                </label>
                                            </div>
                                            <span class="rams-filter-builder__operator-hint">{{ 'email_campaign.segments.of_rules'|trans|default('of the following rules') }}</span>
                                        </div>

                                        {# Rules container #}
                                        <div id="rulesContainer" class="rams-filter-builder__rules">
                                            {# Rules will be added here dynamically #}
                                        </div>

                                        <button type="button" class="rams-btn rams-btn--secondary rams-btn--sm" id="addRuleBtn">
                                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                            </svg>
                                            {{ 'email_campaign.segments.add_rule'|trans|default('Add Rule') }}
                                        </button>
                                    </div>
                                </div>

                                <input type="hidden" name="filter_rules" id="filterRulesInput">
                            </div>
                        </div>
                        <div class="rams-module__footer">
                            <div class="rams-btn-group">
                                {% if campaignId %}
                                    <a href="{{ path('app_email_campaign_wizard_segment', {id: campaignId}) }}" class="rams-btn rams-btn--secondary">
                                        {{ 'common.cancel'|trans }}
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_email_campaign_segments') }}" class="rams-btn rams-btn--secondary">
                                        {{ 'common.cancel'|trans }}
                                    </a>
                                {% endif %}
                                
                                <button type="submit" class="rams-btn rams-btn--primary">
                                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                    </svg>
                                    {{ 'email_campaign.segments.save_segment'|trans|default('Save Segment') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                {# Sidebar #}
                <div class="rams-layout__sidebar">
                    {# Available Fields #}
                    <div class="rams-module">
                        <div class="rams-module__header">
                            <h3 class="rams-module__title">{{ 'email_campaign.segments.available_fields'|trans|default('Available Fields') }}</h3>
                        </div>
                        <div class="rams-module__content">
                            {% for fieldGroup, fields in availableFields %}
                                <div class="rams-field-group">
                                    <span class="rams-dymo">{{ fieldGroup }}</span>
                                    <div class="rams-field-list">
                                        {% for field in fields %}
                                            <div class="rams-field-item">
                                                <code class="rams-field-item__name">{{ field.name }}</code>
                                                <span class="rams-badge rams-badge--neutral rams-badge--sm">{{ field.type }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    {# Live Count #}
                    <div class="rams-module rams-module--primary">
                        <div class="rams-module__content">
                            <div class="rams-metric rams-metric--centered rams-metric--large">
                                <span class="rams-metric__label">{{ 'email_campaign.segments.matching_contacts'|trans|default('Matching Contacts') }}</span>
                                <span class="rams-metric__value" id="contactCount">
                                    <span class="rams-spinner"></span>
                                </span>
                            </div>
                            <button type="button" class="rams-btn rams-btn--secondary rams-btn--full rams-btn--sm" id="refreshCountBtn">
                                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                </svg>
                                {{ 'common.refresh'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
const availableFields = {{ availableFields|json_encode|raw }};
const operatorsByType = {
    'string': [
        { value: '=', label: '{{ 'email_campaign.segments.op_equals'|trans|default('equals') }}' },
        { value: '!=', label: '{{ 'email_campaign.segments.op_not_equals'|trans|default('not equals') }}' },
        { value: 'contains', label: '{{ 'email_campaign.segments.op_contains'|trans|default('contains') }}' },
        { value: 'not_contains', label: '{{ 'email_campaign.segments.op_not_contains'|trans|default('does not contain') }}' },
        { value: 'starts_with', label: '{{ 'email_campaign.segments.op_starts_with'|trans|default('starts with') }}' },
        { value: 'ends_with', label: '{{ 'email_campaign.segments.op_ends_with'|trans|default('ends with') }}' },
        { value: 'is_empty', label: '{{ 'email_campaign.segments.op_is_empty'|trans|default('is empty') }}' },
        { value: 'is_not_empty', label: '{{ 'email_campaign.segments.op_is_not_empty'|trans|default('is not empty') }}' }
    ],
    'integer': [
        { value: '=', label: '{{ 'email_campaign.segments.op_equals'|trans|default('equals') }}' },
        { value: '!=', label: '{{ 'email_campaign.segments.op_not_equals'|trans|default('not equals') }}' },
        { value: '>', label: '{{ 'email_campaign.segments.op_greater'|trans|default('greater than') }}' },
        { value: '>=', label: '{{ 'email_campaign.segments.op_greater_eq'|trans|default('greater than or equal') }}' },
        { value: '<', label: '{{ 'email_campaign.segments.op_less'|trans|default('less than') }}' },
        { value: '<=', label: '{{ 'email_campaign.segments.op_less_eq'|trans|default('less than or equal') }}' },
        { value: 'is_empty', label: '{{ 'email_campaign.segments.op_is_empty'|trans|default('is empty') }}' },
        { value: 'is_not_empty', label: '{{ 'email_campaign.segments.op_is_not_empty'|trans|default('is not empty') }}' }
    ],
    'boolean': [
        { value: '=', label: '{{ 'email_campaign.segments.op_is'|trans|default('is') }}' }
    ],
    'datetime': [
        { value: '>', label: '{{ 'email_campaign.segments.op_after'|trans|default('after') }}' },
        { value: '<', label: '{{ 'email_campaign.segments.op_before'|trans|default('before') }}' },
        { value: 'is_empty', label: '{{ 'email_campaign.segments.op_is_empty'|trans|default('is empty') }}' },
        { value: 'is_not_empty', label: '{{ 'email_campaign.segments.op_is_not_empty'|trans|default('is not empty') }}' }
    ]
};

let ruleIdCounter = 0;

document.addEventListener('DOMContentLoaded', function() {
    const addRuleBtn = document.getElementById('addRuleBtn');
    addRuleBtn.addEventListener('click', addRule);
    
    // Add initial rule
    addRule();
});

function addRule() {
    ruleIdCounter++;
    const rulesContainer = document.getElementById('rulesContainer');
    
    const ruleDiv = document.createElement('div');
    ruleDiv.className = 'rams-filter-rule';
    ruleDiv.dataset.ruleId = ruleIdCounter;
    
    ruleDiv.innerHTML = `
        <select class="rams-form__select rams-filter-rule__field" onchange="updateOperators(${ruleIdCounter})">
            <option value="">{{ 'email_campaign.segments.select_field'|trans|default('Select field...') }}</option>
            ${Object.entries(availableFields).map(([group, fields]) => 
                `<optgroup label="${group}">${fields.map(f => `<option value="${f.name}" data-type="${f.type}">${f.name}</option>`).join('')}</optgroup>`
            ).join('')}
        </select>
        <select class="rams-form__select rams-filter-rule__operator" data-rule-id="${ruleIdCounter}">
            <option value="">{{ 'email_campaign.segments.select_operator'|trans|default('Select operator...') }}</option>
        </select>
        <input type="text" class="rams-form__input rams-filter-rule__value" placeholder="{{ 'common.value'|trans }}">
        <button type="button" class="rams-btn rams-btn--ghost rams-btn--sm rams-filter-rule__remove" onclick="removeRule(${ruleIdCounter})">
            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    `;
    
    rulesContainer.appendChild(ruleDiv);
}

function updateOperators(ruleId) {
    const ruleDiv = document.querySelector(`[data-rule-id="${ruleId}"]`).closest('.rams-filter-rule');
    const fieldSelect = ruleDiv.querySelector('.rams-filter-rule__field');
    const operatorSelect = ruleDiv.querySelector('.rams-filter-rule__operator');
    const selectedOption = fieldSelect.options[fieldSelect.selectedIndex];
    const fieldType = selectedOption.dataset.type || 'string';
    
    const operators = operatorsByType[fieldType] || operatorsByType['string'];
    
    operatorSelect.innerHTML = '<option value="">{{ 'email_campaign.segments.select_operator'|trans|default('Select operator...') }}</option>' +
        operators.map(op => `<option value="${op.value}">${op.label}</option>`).join('');
}

function removeRule(ruleId) {
    const ruleDiv = document.querySelector(`[data-rule-id="${ruleId}"]`).closest('.rams-filter-rule');
    ruleDiv.remove();
}
</script>
{% endblock %}
