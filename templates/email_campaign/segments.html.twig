{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.segments.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.segments.title'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.segments.subtitle'|trans|default('Target specific audiences with contact segments') }}</p>
            </div>
            <div class="rams-page__actions">
                <a href="{{ path('app_email_campaign_segment_builder') }}" class="rams-btn rams-btn--primary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    {{ 'email_campaign.segments.new_segment'|trans }}
                </a>
            </div>
        </div>

        {# Segments List #}
        {% if segments is empty %}
            <div class="rams-module">
                <div class="rams-module__content rams-empty-state">
                    <svg class="rams-empty-state__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                    </svg>
                    <h3 class="rams-empty-state__title">{{ 'email_campaign.segments.no_segments'|trans|default('No Segments Yet') }}</h3>
                    <p class="rams-empty-state__description">{{ 'email_campaign.segments.create_first'|trans|default('Create your first contact segment to target specific audiences') }}</p>
                    <a href="{{ path('app_email_campaign_segment_builder') }}" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        {{ 'email_campaign.segments.create_first_btn'|trans|default('Create Your First Segment') }}
                    </a>
                </div>
            </div>
        {% else %}
            <div class="rams-grid rams-grid--3">
                {% for segment in segments %}
                    <div class="rams-module rams-module--interactive">
                        <div class="rams-module__content">
                            <div class="rams-module__header-row">
                                <div class="rams-module__header-content">
                                    <h3 class="rams-module__title">{{ segment.name }}</h3>
                                    {% if segment.description %}
                                        <p class="rams-module__description">{{ segment.description }}</p>
                                    {% endif %}
                                </div>
                                <svg class="rams-module__icon rams-module__icon--primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                </svg>
                            </div>

                            <div class="rams-metric rams-metric--centered">
                                <span class="rams-metric__value rams-metric__value--xl">{{ segment.contactCount|number_format }}</span>
                                <span class="rams-metric__label">{{ 'contact.title'|trans }}</span>
                            </div>

                            {% if segment.lastCalculatedAt %}
                                <div class="rams-module__meta">
                                    <span class="rams-dymo">{{ 'common.updated'|trans|default('Updated') }} {{ segment.lastCalculatedAt|date('M d, Y g:i A') }}</span>
                                </div>
                            {% endif %}
                        </div>
                        <div class="rams-module__footer">
                            <div class="rams-btn-group rams-btn-group--full">
                                <button class="rams-btn rams-btn--secondary rams-btn--sm" onclick="viewSegment({{ segment.id }})">
                                    {{ 'common.view'|trans }}
                                </button>
                                <button class="rams-btn rams-btn--secondary rams-btn--sm">
                                    {{ 'common.edit'|trans }}
                                </button>
                                <button class="rams-btn rams-btn--ghost rams-btn--sm" onclick="recalculate({{ segment.id }})">
                                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                    </svg>
                                    {{ 'common.refresh'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<script>
function viewSegment(segmentId) {
    window.location.href = '/email-campaigns/segments/' + segmentId;
}

function recalculate(segmentId) {
    console.log('Recalculating segment:', segmentId);
}
</script>
{% endblock %}
