{% extends 'base.html.twig' %}

{% block title %}{{ 'email_campaign.new_campaign'|trans }}{% endblock %}


{% block stylesheets %}
{{ parent() }}
<style>
    .rams-info-panel { display: flex; gap: var(--space-3); padding: var(--space-3); background: var(--rams-bg-info-subtle); border: 1px solid var(--rams-border); border-radius: var(--radius-sm); }
    .rams-info-panel__icon { flex-shrink: 0; width: 20px; height: 20px; color: var(--rams-steel); margin-top: 2px; }
    .rams-info-panel__content { flex: 1; min-width: 0; }
    .rams-info-panel__title { margin: 0 0 var(--space-2); font-size: var(--text-sm); }
    .rams-info-panel__list { margin: 0; padding-left: var(--space-4); font-size: var(--text-xs); color: var(--rams-muted); }
</style>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container rams-page__container--narrow">
        
        {# Breadcrumb #}
        <nav class="rams-breadcrumb">
            <ol class="rams-breadcrumb__list">
                <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item"><a href="{{ path('app_email_campaign_index') }}" class="rams-breadcrumb__link">{{ 'email_campaign.title'|trans }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'email_campaign.new_campaign'|trans }}</li>
            </ol>
        </nav>

        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'email_campaign.create_campaign'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'email_campaign.setup_sequence'|trans }}</p>
            </div>
        </div>

        {# Form #}
        <div class="rams-module">
            <div class="rams-module__content">
                {{ form_start(form) }}
                
                <div class="rams-form">
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'email_campaign.campaign_name'|trans }}</label>
                        {{ form_widget(form.name, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <div class="rams-form__row rams-form__row--2">
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'email_campaign.language'|trans }}</label>
                            {{ form_widget(form.language, {'attr': {'class': 'rams-form__select'}}) }}
                            {{ form_errors(form.language) }}
                        </div>

                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'email_campaign.touch_count'|trans }}</label>
                            {{ form_widget(form.touchCount, {'attr': {'class': 'rams-form__input'}}) }}
                            {{ form_errors(form.touchCount) }}
                            <span class="rams-form__hint">{{ 'email_campaign.touch_count_hint'|trans }}</span>
                        </div>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'common.description'|trans }}</label>
                        {{ form_widget(form.description, {'attr': {'class': 'rams-form__textarea'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="rams-form__group rams-form__group">
                        {{ form_widget(form.active, {'attr': {'class': 'rams-form__checkbox'}}) }}
                        <label class="rams-form__label rams-form__label">{{ 'common.active'|trans }}</label>
                    </div>
                </div>

                <div class="rams-module__footer">
                    <div class="rams-btn-group mobile-stack">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            {{ 'email_campaign.create_campaign'|trans }}
                        </button>
                        <a href="{{ path('app_email_campaign_index') }}" class="rams-btn">
                            {{ 'common.cancel'|trans }}
                        </a>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        {# Info Panel #}
        <div class="rams-module rams-module">
            <div class="rams-module__content">
                <div class="rams-info-panel">
                    <svg class="rams-info-panel__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="rams-info-panel__content">
                        <h3 class="rams-info-panel__title">{{ 'email_campaign.best_practice_title'|trans }}</h3>
                        <ul class="rams-info-panel__list">
                            <li>{{ 'email_campaign.touch_1_hint'|trans }}</li>
                            <li>{{ 'email_campaign.touch_2_hint'|trans }}</li>
                            <li>{{ 'email_campaign.touch_3_hint'|trans }}</li>
                            <li>{{ 'email_campaign.touch_4_hint'|trans }}</li>
                            <li>{{ 'email_campaign.touch_5_hint'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
