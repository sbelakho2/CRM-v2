{% extends 'base.html.twig' %}

{% block title %}New Email Campaign{% endblock %}

{% block body %}
<div class="p-8 max-w-2xl">
    <div class="mb-8">
        <div class="flex items-center gap-3 text-sm text-zinc-400 mb-4">
            <a href="{{ path('app_email_campaign_index') }}" class="hover:text-white transition-colors">Email Campaigns</a>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 4l4 4-4 4"/>
            </svg>
            <span class="text-white">New Campaign</span>
        </div>
        <h1 class="text-2xl font-semibold text-white mb-2">Create Email Campaign</h1>
        <p class="text-sm text-zinc-400">Set up a multi-touch email sequence</p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6">
        {{ form_start(form) }}
        
        <div class="space-y-6">
            <div>
                {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-zinc-300 mb-2'}}) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.language, null, {'label_attr': {'class': 'block text-sm font-medium text-zinc-300 mb-2'}}) }}
                    {{ form_widget(form.language) }}
                    {{ form_errors(form.language) }}
                </div>

                <div>
                    {{ form_label(form.touchCount, null, {'label_attr': {'class': 'block text-sm font-medium text-zinc-300 mb-2'}}) }}
                    {{ form_widget(form.touchCount) }}
                    {{ form_errors(form.touchCount) }}
                    <p class="text-xs text-zinc-500 mt-1">Recommended: 5 touches over 3 weeks</p>
                </div>
            </div>

            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-zinc-300 mb-2'}}) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="flex items-center gap-2">
                {{ form_widget(form.active, {'attr': {'class': 'w-4 h-4 rounded border-zinc-700 bg-zinc-800 text-blue-500 focus:ring-blue-500 focus:ring-offset-zinc-900'}}) }}
                {{ form_label(form.active, null, {'label_attr': {'class': 'text-sm text-zinc-300'}}) }}
            </div>
        </div>

        <div class="flex items-center gap-3 mt-8 pt-6 border-t border-zinc-800">
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Create Campaign
            </button>
            <a href="{{ path('app_email_campaign_index') }}" class="inline-flex items-center gap-2 px-5 py-2.5 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">
                Cancel
            </a>
        </div>

        {{ form_end(form) }}
    </div>

    <!-- Info Panel -->
    <div class="mt-6 bg-blue-500/5 border border-blue-500/20 rounded-lg p-4">
        <div class="flex gap-3">
            <svg class="w-5 h-5 text-blue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
                <h3 class="text-sm font-medium text-blue-400 mb-1">5-Touch Email Sequence Best Practice</h3>
                <ul class="text-sm text-zinc-400 space-y-1">
                    <li>• Touch 1: Initial introduction (Day 1)</li>
                    <li>• Touch 2: Value proposition (Day 4)</li>
                    <li>• Touch 3: Case study or proof (Day 8)</li>
                    <li>• Touch 4: Specific offer (Day 14)</li>
                    <li>• Touch 5: Final follow-up (Day 21)</li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
