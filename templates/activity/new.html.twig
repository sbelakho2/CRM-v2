{% extends 'base.html.twig' %}

{% block title %}Log New Activity{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        {# Breadcrumb #}
        <nav class="mb-6">
            <ol class="flex items-center gap-2 text-sm">
                <li><a href="{{ path('app_dashboard') }}" class="text-neutral-600 hover:text-neutral-900">Dashboard</a></li>
                <li class="text-neutral-400">/</li>
                <li><a href="{{ path('app_activity_index') }}" class="text-neutral-600 hover:text-neutral-900">Activities</a></li>
                <li class="text-neutral-400">/</li>
                <li class="text-neutral-900 font-medium">New</li>
            </ol>
        </nav>

        {# Header #}
        <div class="mb-6">
            <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Log New Activity</h1>
            <p class="mt-1 text-sm text-neutral-600">Record an interaction or touchpoint</p>
        </div>

        {# Form Card #}
        <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                {# Activity Type and Date Row #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_label(form.activityType, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                        {{ form_widget(form.activityType, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                        {{ form_errors(form.activityType, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    </div>
                    <div>
                        {{ form_label(form.activityDate, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                        {{ form_widget(form.activityDate, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                        {{ form_errors(form.activityDate, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    </div>
                </div>

                {# Company and Contact Row #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_label(form.company, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                        {{ form_widget(form.company, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                        {{ form_errors(form.company, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    </div>
                    <div>
                        {{ form_label(form.contact, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                        {{ form_widget(form.contact, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                        {{ form_errors(form.contact, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    </div>
                </div>

                {# Outcome #}
                <div>
                    {{ form_label(form.outcome, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                    {{ form_widget(form.outcome, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                    {{ form_errors(form.outcome, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                </div>

                {# Notes #}
                <div>
                    {{ form_label(form.notes, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                    {{ form_widget(form.notes, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                    {{ form_errors(form.notes, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    <p class="mt-1 text-xs text-neutral-500">Include key discussion points, outcomes, and next steps</p>
                </div>

                {# Action Buttons #}
                <div class="flex items-center gap-3 pt-4 border-t border-neutral-200">
                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-neutral-900 text-white text-sm font-medium rounded-lg hover:bg-neutral-800 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Log Activity
                    </button>
                    <a href="{{ path('app_activity_index') }}" class="inline-flex items-center gap-2 px-5 py-2.5 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">
                        Cancel
                    </a>
                </div>

            {{ form_end(form) }}
        </div>

    </div>
</div>

<style>
/* Custom styles for Symfony form elements */
.form-input,
.form-select {
    @apply w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm;
    @apply focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500;
    @apply transition-colors;
}

select.form-select {
    @apply bg-white;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 0.5rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
    padding-right: 2.5rem;
}
</style>
{% endblock %}
