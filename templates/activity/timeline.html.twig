{% extends 'base.html.twig' %}

{% block title %}{{ 'activity.timeline_view'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container rams-page__container--narrow">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'activity.timeline_title'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'activity.timeline_subtitle'|trans }}</p>
            </div>
            <div class="rams-page__actions">
                <a href="{{ path('app_activity_index') }}" class="rams-btn">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                    </svg>
                    {{ 'activity.list_view'|trans }}
                </a>
                <a href="{{ path('app_activity_new') }}" class="rams-btn--primary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    {{ 'activity.log_activity'|trans }}
                </a>
            </div>
        </div>

        {# Timeline #}
        <div class="rams-timeline">
            {# Vertical Line #}
            <div class="rams-timeline__line"></div>

            <div class="rams-timeline__content">
                {% for date, dayActivities in groupedActivities %}
                    {# Date Header #}
                    <div class="rams-timeline__section">
                        <div class="rams-timeline__date">
                            <div class="rams-timeline__date-marker">
                                <svg class="rams-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <h2 class="rams-timeline__date-label">{{ date|date('F d, Y') }}</h2>
                        </div>

                        {# Activities for this date #}
                        <div class="rams-timeline__items">
                            {% for activity in dayActivities %}
                                <div class="rams-module rams-module--compact rams-module--interactive">
                                    <div class="rams-module__content">
                                        <div class="rams-timeline__item">
                                            <div class="rams-timeline__item-icon rams-timeline__item-icon--{{ activity.type|lower|replace({' ': '-', '-': '-'}) }}">
                                                <svg class="rams-icon rams-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                                </svg>
                                            </div>
                                            <div class="rams-timeline__item-content">
                                                <div class="rams-timeline__item-header">
                                                    <span class="rams-timeline__item-type">{{ ('activity.types.' ~ activity.type|lower|replace({' ': '_', '-': '_'}) )|trans }}</span>
                                                    {% if activity.outcome %}
                                                        <span class="rams-badge rams-badge--sm rams-badge--{{ activity.outcome|lower|replace({' ': '-'}) }}">
                                                            {{ ('activity.outcomes.' ~ activity.outcome|lower|replace({' ': '_', '-': '_'}) )|trans }}
                                                        </span>
                                                    {% endif %}
                                                </div>
                                                <p class="rams-timeline__item-detail">
                                                    {% if activity.company %}
                                                        <a href="{{ path('app_company_show', {id: activity.company.id}) }}" class="rams-link">{{ activity.company.name }}</a>
                                                    {% endif %}
                                                    {% if activity.contact %}
                                                        <span class="rams-timeline__separator">·</span>
                                                        <a href="{{ path('app_contact_show', {id: activity.contact.id}) }}" class="rams-link">{{ activity.contact.firstName }} {{ activity.contact.lastName }}</a>
                                                    {% endif %}
                                                </p>
                                                {% if activity.notes %}
                                                    <p class="rams-timeline__item-notes">{{ activity.notes|slice(0, 120) }}{% if activity.notes|length > 120 %}...{% endif %}</p>
                                                {% endif %}
                                                <div class="rams-timeline__item-footer">
                                                    <span class="rams-timeline__item-user">{{ activity.user.firstName }} {{ activity.user.lastName }}</span>
                                                    <a href="{{ path('app_activity_show', {id: activity.id}) }}" class="rams-link rams-link--sm">{{ 'common.view'|trans }} {{ 'common.details'|trans|lower }}</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    <div class="rams-module">
                        <div class="rams-module__content rams-empty-state">
                            <svg class="rams-empty-state__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <circle cx="8" cy="8" r="6" stroke-width="2"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4V8L11 11"/>
                            </svg>
                            <h3 class="rams-empty-state__title">{{ 'activity.no_timeline'|trans }}</h3>
                            <p class="rams-empty-state__description">{{ 'activity.timeline_empty'|trans }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

    </div>
</div>
{% endblock %}
