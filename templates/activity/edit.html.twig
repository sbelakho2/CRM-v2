{% extends 'base.html.twig' %}

{% block title %}{{ 'activity.edit_activity'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container rams-page__container--narrow">
        
        {# Breadcrumb #}
        <nav class="rams-breadcrumb">
            <ol class="rams-breadcrumb__list">
                <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item"><a href="{{ path('app_activity_index') }}" class="rams-breadcrumb__link">{{ 'activity.title'|trans }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item"><a href="{{ path('app_activity_show', {id: activity.id}) }}" class="rams-breadcrumb__link">{{ activity.type }}</a></li>
                <li class="rams-breadcrumb__separator">/</li>
                <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'common.edit'|trans }}</li>
            </ol>
        </nav>

        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'activity.edit_activity'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'activity.edit_subtitle'|trans|default('Update activity information') }}</p>
            </div>
        </div>

        {# Form Module #}
        <div class="rams-module">
            <div class="rams-module__content">
                {{ form_start(form, {'attr': {'class': 'rams-form'}}) }}

                    {# Activity Type and Date Row #}
                    <div class="rams-form__grid rams-form__grid--2col">
                        <div class="rams-form__group">
                            <label class="rams-dymo" for="{{ form.type.vars.id }}">{{ 'activity.type'|trans }}</label>
                            {{ form_widget(form.type, {'attr': {'class': 'rams-form__select'}}) }}
                            {{ form_errors(form.type) }}
                        </div>
                        <div class="rams-form__group">
                            <label class="rams-dymo" for="{{ form.activityDate.vars.id }}">{{ 'activity.activity_date'|trans }}</label>
                            {{ form_widget(form.activityDate, {'attr': {'class': 'rams-form__input'}}) }}
                            {{ form_errors(form.activityDate) }}
                        </div>
                    </div>

                    {# Company and Contact Row #}
                    <div class="rams-form__grid rams-form__grid--2col">
                        <div class="rams-form__group">
                            <label class="rams-dymo" for="{{ form.company.vars.id }}">{{ 'activity.company'|trans }}</label>
                            {{ form_widget(form.company, {'attr': {'class': 'rams-form__select', 'id': 'activity_company'}}) }}
                            {{ form_errors(form.company) }}
                        </div>
                        <div class="rams-form__group">
                            <label class="rams-dymo" for="{{ form.contact.vars.id }}">{{ 'activity.contact'|trans }}</label>
                            {{ form_widget(form.contact, {'attr': {'class': 'rams-form__select', 'id': 'activity_contact'}}) }}
                            {{ form_errors(form.contact) }}
                        </div>
                    </div>

                    {# Outcome #}
                    <div class="rams-form__group">
                        <label class="rams-dymo" for="{{ form.outcome.vars.id }}">{{ 'activity.outcome'|trans }}</label>
                        {{ form_widget(form.outcome, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.outcome) }}
                    </div>

                    {# Notes #}
                    <div class="rams-form__group">
                        <label class="rams-dymo" for="{{ form.notes.vars.id }}">{{ 'common.notes'|trans }}</label>
                        {{ form_widget(form.notes, {'attr': {'class': 'rams-form__input rams-form__input--textarea'}}) }}
                        {{ form_errors(form.notes) }}
                        <p class="rams-form__hint">{{ 'activity.notes_hint'|trans|default('Include key discussion points, outcomes, and next steps') }}</p>
                    </div>

                    {# Action Buttons #}
                    <div class="rams-module__footer">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            {{ 'activity.update_button'|trans|default('Update Activity') }}
                        </button>
                        <a href="{{ path('app_activity_show', {id: activity.id}) }}" class="rams-btn rams-btn--secondary">
                            {{ 'common.cancel'|trans }}
                        </a>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const companySelect = document.getElementById('activity_company');
    const contactSelect = document.getElementById('activity_contact');
    const contactSearchUrl = '{{ contactSearchUrl }}';
    const initialContactData = {{ initialContactData|raw }};
    
    if (!companySelect || !contactSelect) {
        return;
    }
    
    // Store the currently selected contact (for edit mode)
    const initialContactId = contactSelect.value;
    
    // Function to load contacts via AJAX
    async function loadContacts(companyId = null) {
        const url = new URL(contactSearchUrl, window.location.origin);
        if (companyId) {
            url.searchParams.set('company', companyId);
        }
        url.searchParams.set('limit', '50');
        
        try {
            const response = await fetch(url);
            const contacts = await response.json();
            
            // Clear current options
            contactSelect.innerHTML = '';
            
            // Add placeholder
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = '{{ 'activity.select_contact'|trans|default('Select contact (optional)') }}';
            contactSelect.appendChild(placeholder);
            
            // Add contacts
            contacts.forEach(contact => {
                const option = document.createElement('option');
                option.value = contact.id;
                option.textContent = `${contact.firstName} ${contact.lastName}`;
                if (initialContactId && contact.id == initialContactId) {
                    option.selected = true;
                }
                contactSelect.appendChild(option);
            });
            
            // If initial contact not in list, add it separately
            if (initialContactData && initialContactId && !contacts.some(c => c.id == initialContactId)) {
                if (!companyId) {
                    const option = document.createElement('option');
                    option.value = initialContactData.id;
                    option.textContent = `${initialContactData.firstName} ${initialContactData.lastName}`;
                    option.selected = true;
                    contactSelect.appendChild(option);
                }
            }
            
            // If no contacts found
            if (contacts.length === 0) {
                const option = document.createElement('option');
                option.value = '';
                option.textContent = companyId ? '{{ 'activity.no_contacts_company'|trans|default('No contacts for this company') }}' : '{{ 'activity.no_contacts'|trans|default('No contacts found') }}';
                option.disabled = true;
                contactSelect.appendChild(option);
            }
        } catch (error) {
            console.error('Failed to load contacts:', error);
        }
    }
    
    // Listen for company selection changes
    companySelect.addEventListener('change', function() {
        loadContacts(this.value || null);
    });
    
    // Initial load
    if (companySelect.value) {
        loadContacts(companySelect.value);
    } else {
        loadContacts(null);
    }
});
</script>
{% endblock %}
