{% extends 'base.html.twig' %}

{% block title %}Edit Activity{% endblock %}

{% block body %}
{# Reusable class variables #}
{% set label_class = 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2' %}
{% set input_class = 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors' %}
{% set error_class = 'mt-1 text-xs text-red-600' %}

<div class="min-h-screen bg-neutral-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        {# Breadcrumb #}
        <nav class="mb-6">
            <ol class="flex items-center gap-2 text-sm">
                <li><a href="{{ path('app_dashboard') }}" class="text-neutral-600 hover:text-neutral-900">Dashboard</a></li>
                <li class="text-neutral-400">/</li>
                <li><a href="{{ path('app_activity_index') }}" class="text-neutral-600 hover:text-neutral-900">Activities</a></li>
                <li class="text-neutral-400">/</li>
                <li><a href="{{ path('app_activity_show', {id: activity.id}) }}" class="text-neutral-600 hover:text-neutral-900">{{ activity.type }}</a></li>
                <li class="text-neutral-400">/</li>
                <li class="text-neutral-900 font-medium">Edit</li>
            </ol>
        </nav>

        {# Header #}
        <div class="mb-6">
            <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Edit Activity</h1>
            <p class="mt-1 text-sm text-neutral-600">Update activity information</p>
        </div>

        {# Form Card #}
        <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                {# Activity Type and Date Row #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_label(form.type, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.type, {'attr': {'class': input_class}}) }}
                        {{ form_errors(form.type, {'attr': {'class': error_class}}) }}
                    </div>
                    <div>
                        {{ form_label(form.activityDate, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.activityDate, {'attr': {'class': input_class}}) }}
                        {{ form_errors(form.activityDate, {'attr': {'class': error_class}}) }}
                    </div>
                </div>

                {# Company and Contact Row #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_label(form.company, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.company, {'attr': {'class': input_class, 'id': 'activity_company'}}) }}
                        {{ form_errors(form.company, {'attr': {'class': error_class}}) }}
                    </div>
                    <div>
                        {{ form_label(form.contact, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.contact, {'attr': {'class': input_class, 'id': 'activity_contact'}}) }}
                        {{ form_errors(form.contact, {'attr': {'class': error_class}}) }}
                    </div>
                </div>

                {# Outcome #}
                <div>
                    {{ form_label(form.outcome, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.outcome, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.outcome, {'attr': {'class': error_class}}) }}
                </div>

                {# Notes #}
                <div>
                    {{ form_label(form.notes, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.notes, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.notes, {'attr': {'class': error_class}}) }}
                    <p class="mt-1 text-xs text-neutral-500">Include key discussion points, outcomes, and next steps</p>
                </div>

                {# Action Buttons #}
                <div class="flex items-center gap-3 pt-4 border-t border-neutral-200">
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Update Activity
                    </button>
                    <a href="{{ path('app_activity_show', {id: activity.id}) }}" class="inline-flex items-center gap-2 px-5 py-2.5 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">
                        Cancel
                    </a>
                </div>

            {{ form_end(form) }}
        </div>

    </div>
</div>

<style>
/* Custom styles for Symfony form elements */
.form-input,
.form-select {
    @apply w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm;
    @apply focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500;
    @apply transition-colors;
}

select.form-select {
    @apply bg-white;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 0.5rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
    padding-right: 2.5rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const companySelect = document.getElementById('activity_company');
    const contactSelect = document.getElementById('activity_contact');
    
    if (!companySelect || !contactSelect) {
        return;
    }
    
    // Get all contacts data from the server (pre-loaded, no API call needed)
    const contactsData = {{ contactsData|raw }};
    
    // Store the currently selected contact (for edit mode)
    const initialContactId = contactSelect.value;
    
    // Store all original contact options from the form
    const allContactOptions = Array.from(contactSelect.options);
    
    // Function to filter contacts by company
    function filterContacts() {
        const selectedCompanyId = companySelect.value;
        
        // Clear current options
        contactSelect.innerHTML = '';
        
        // Add placeholder
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Select contact (optional)';
        contactSelect.appendChild(placeholder);
        
        if (!selectedCompanyId) {
            // No company selected - show all contacts
            allContactOptions.forEach(option => {
                if (option.value) { // Skip the placeholder
                    contactSelect.appendChild(option.cloneNode(true));
                }
            });
            // Restore selected contact
            if (initialContactId) {
                contactSelect.value = initialContactId;
            }
            return;
        }
        
        // Filter contacts by company ID (client-side, instant!)
        const filteredContacts = contactsData.filter(contact => 
            contact.companyId == selectedCompanyId
        );
        
        // Add filtered contacts to dropdown
        filteredContacts.forEach(contact => {
            const option = document.createElement('option');
            option.value = contact.id;
            option.textContent = `${contact.firstName} ${contact.lastName}`;
            contactSelect.appendChild(option);
        });
        
        // Restore selected contact if it's in the filtered list
        if (initialContactId) {
            const contactExists = filteredContacts.some(c => c.id == initialContactId);
            if (contactExists) {
                contactSelect.value = initialContactId;
            }
        }
        
        // If no contacts found, show a message
        if (filteredContacts.length === 0) {
            const option = document.createElement('option');
            option.value = '';
            option.textContent = 'No contacts for this company';
            option.disabled = true;
            contactSelect.appendChild(option);
        }
    }
    
    // Listen for company selection changes
    companySelect.addEventListener('change', filterContacts);
    
    // Initial filter on page load if company is pre-selected
    if (companySelect.value) {
        filterContacts();
    }
});
</script>
{% endblock %}
