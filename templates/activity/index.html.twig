{% extends 'base.html.twig' %}

{% block title %}{{ 'activity.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header with Actions #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'activity.title'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'activity.subtitle'|trans }}</p>
            </div>
            <div class="rams-page__actions mobile-stack">
                <a href="{{ path('app_activity_timeline') }}" class="rams-btn">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {{ 'activity.timeline_view'|trans }}
                </a>
                <a href="{{ path('app_activity_new') }}" class="rams-btn rams-btn--primary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    {{ 'activity.log_activity'|trans }}
                </a>
            </div>
        </div>

        {# Filters - Compact horizontal layout #}
        <div class="rams-card mb-6">
            <div class="rams-card-body">
                <form method="get" action="{{ path('app_activity_index') }}" class="space-y-3">
                    <div class="flex flex-wrap items-end gap-3">
                        <div class="w-40">
                            <label class="text-xs font-medium text-rams-neutral-400 mb-1 block">{{ 'activity.type'|trans }}</label>
                            <select name="type" class="rams-input text-sm py-1.5 w-full">
                                <option value="">{{ 'activity.all_types'|trans }}</option>
                                {% for type in types %}
                                    <option value="{{ type }}" {{ current_type == type ? 'selected' : '' }}>{{ ('activity.types.' ~ type|lower|replace({' ': '_', '-': '_'}) )|trans }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="w-48">
                            <label class="text-xs font-medium text-rams-neutral-400 mb-1 block">{{ 'activity.company'|trans }}</label>
                            <select name="company" class="rams-input text-sm py-1.5 w-full">
                                <option value="">{{ 'company.all_companies'|trans }}</option>
                                {% for company in companies %}
                                    <option value="{{ company.id }}" {{ current_company == company.id ? 'selected' : '' }}>{{ company.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="w-44">
                            <label class="text-xs font-medium text-rams-neutral-400 mb-1 block">{{ 'activity.team_member'|trans }}</label>
                            <select name="user" class="rams-input text-sm py-1.5 w-full">
                                <option value="">{{ 'activity.all_members'|trans }}</option>
                                {% for user in users %}
                                    <option value="{{ user.id }}" {{ current_user == user.id ? 'selected' : '' }}>{{ user.firstName }} {{ user.lastName }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="w-36">
                            <label class="text-xs font-medium text-rams-neutral-400 mb-1 block">{{ 'activity.from_date'|trans }}</label>
                            <input type="date" name="date_from" value="{{ current_date_from }}" class="rams-input text-sm py-1.5 w-full">
                        </div>
                        <div class="w-36">
                            <label class="text-xs font-medium text-rams-neutral-400 mb-1 block">{{ 'activity.to_date'|trans }}</label>
                            <input type="date" name="date_to" value="{{ current_date_to }}" class="rams-input text-sm py-1.5 w-full">
                        </div>
                        <div class="flex items-end gap-2">
                            <button type="submit" class="rams-btn rams-btn--primary text-sm py-1.5 px-3">{{ 'common.apply'|trans }}</button>
                            <a href="{{ path('app_activity_index') }}" class="rams-btn rams-btn--ghost text-sm py-1.5 px-3">{{ 'common.clear'|trans }}</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="rams-andon rams-andon--{{ label == 'success' ? 'success' : 'info' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Activities Table #}
        <div class="rams-module">
            <div class="rams-module__content rams-module__content--flush">
                <div class="rams-table-container">
                    <table class="rams-table data-table">
                        <thead class="rams-table__header">
                            <tr>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'activity.type'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'activity.company'|trans }} / {{ 'activity.contact'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'activity.notes'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'activity.team_member'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'activity.date'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions"><span class="rams-sr-only">{{ 'common.actions'|trans }}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for activity in activities %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--{{ activity.type|lower|replace({' ': '-', '-': '-'}) }}">
                                        {{ ('activity.types.' ~ activity.type|lower|replace({' ': '_', '-': '_'}) )|trans }}
                                    </span>
                                    {% if activity.outcome %}
                                        <span class="rams-text--xs rams-text--muted block mt-1">{{ ('activity.outcomes.' ~ activity.outcome|lower|replace({' ': '_', '-': '_'}) )|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    {% if activity.company %}
                                        <a href="{{ path('app_company_show', {id: activity.company.id}) }}" class="rams-link">{{ activity.company.name }}</a>
                                    {% endif %}
                                    {% if activity.contact %}
                                        {% if activity.company %}<span class="rams-text--muted"> · </span>{% endif %}
                                        <a href="{{ path('app_contact_show', {id: activity.contact.id}) }}" class="rams-link">{{ activity.contact.firstName }} {{ activity.contact.lastName }}</a>
                                    {% endif %}
                                    {% if not activity.company and not activity.contact %}
                                        <span class="rams-text--muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    {% if activity.notes %}
                                        <span class="rams-text--sm">{{ activity.notes|length > 80 ? activity.notes|slice(0, 80) ~ '...' : activity.notes }}</span>
                                    {% else %}
                                        <span class="rams-text--muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">{{ activity.user.firstName }} {{ activity.user.lastName }}</td>
                                <td class="rams-table__cell">{{ activity.activityDate|date('M d, Y') }}</td>
                                <td class="rams-table__cell rams-table__cell--actions">
                                    <a href="{{ path('app_activity_show', {id: activity.id}) }}" class="rams-btn rams-btn--ghost rams-btn--icon" title="{{ 'common.view'|trans }}">
                                        <svg class="rams-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:16px;height:16px;">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </a>
                                    <a href="{{ path('app_activity_edit', {id: activity.id}) }}" class="rams-btn rams-btn--ghost rams-btn--icon" title="{{ 'common.edit'|trans }}">
                                        <svg class="rams-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:16px;height:16px;">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="rams-table__cell rams-table__cell--empty">
                                    <div class="rams-empty-state">
                                        <svg class="rams-empty-state__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:48px;height:48px;">
                                            <circle cx="8" cy="8" r="6" stroke-width="2"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4V8L11 11"/>
                                        </svg>
                                        <h3 class="rams-empty-state__title">{{ 'activity.empty.no_activities'|trans }}</h3>
                                        <p class="rams-empty-state__description">{{ 'activity.create_first'|trans }}</p>
                                        <div class="rams-empty-state__actions">
                                            <a href="{{ path('app_activity_new') }}" class="rams-btn rams-btn--primary">
                                                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                                </svg>
                                                {{ 'activity.create_first_button'|trans }}
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
