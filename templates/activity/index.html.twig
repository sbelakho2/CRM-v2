{% extends 'base.html.twig' %}

{% block title %}{{ 'activity.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header with Actions #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'activity.title'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'activity.subtitle'|trans|default('Track all interactions and touchpoints') }}</p>
            </div>
            <div class="rams-page__actions">
                <a href="{{ path('app_activity_timeline') }}" class="rams-btn rams-btn--secondary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {{ 'activity.timeline_view'|trans }}
                </a>
                <a href="{{ path('app_activity_new') }}" class="rams-btn rams-btn--primary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    {{ 'activity.log_activity'|trans|default('Log Activity') }}
                </a>
            </div>
        </div>

        {# Filters Module #}
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <form method="get" action="{{ path('app_activity_index') }}" class="rams-form">
                    
                    {# Filter Grid #}
                    <div class="rams-form__grid rams-form__grid--5col">
                        {# Type Filter #}
                        <div class="rams-form__group">
                            <label for="type" class="rams-dymo">{{ 'activity.type'|trans }}</label>
                            <select name="type" id="type" class="rams-form__select">
                                <option value="">{{ 'common.all'|trans }} {{ 'activity.types_label'|trans|default('Types') }}</option>
                                {% for type in types %}
                                    <option value="{{ type }}" {% if current_type == type %}selected{% endif %}>{{ type }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Company Filter #}
                        <div class="rams-form__group">
                            <label for="company" class="rams-dymo">{{ 'activity.company'|trans }}</label>
                            <select name="company" id="company" class="rams-form__select">
                                <option value="">{{ 'common.all'|trans }} {{ 'company.title'|trans }}</option>
                                {% for company in companies %}
                                    <option value="{{ company.id }}" {% if current_company == company.id %}selected{% endif %}>{{ company.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        {# User Filter #}
                        <div class="rams-form__group">
                            <label for="user" class="rams-dymo">{{ 'activity.team_member'|trans|default('Team Member') }}</label>
                            <select name="user" id="user" class="rams-form__select">
                                <option value="">{{ 'common.all'|trans }} {{ 'activity.users_label'|trans|default('Users') }}</option>
                                {% for user in users %}
                                    <option value="{{ user.id }}" {% if current_user == user.id %}selected{% endif %}>{{ user.firstName }} {{ user.lastName }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Date From #}
                        <div class="rams-form__group">
                            <label for="date_from" class="rams-dymo">{{ 'common.from_date'|trans|default('From Date') }}</label>
                            <input type="date" name="date_from" id="date_from" value="{{ current_date_from }}" class="rams-form__input"/>
                        </div>

                        {# Date To #}
                        <div class="rams-form__group">
                            <label for="date_to" class="rams-dymo">{{ 'common.to_date'|trans|default('To Date') }}</label>
                            <input type="date" name="date_to" id="date_to" value="{{ current_date_to }}" class="rams-form__input"/>
                        </div>
                    </div>

                    {# Filter Actions #}
                    <div class="rams-form__actions">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                            </svg>
                            {{ 'common.apply'|trans }}
                        </button>
                        <a href="{{ path('app_activity_index') }}" class="rams-btn rams-btn--ghost">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                            {{ 'common.clear'|trans }}
                        </a>
                    </div>
                </form>
            </div>
        </div>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="rams-andon rams-andon--{{ label == 'success' ? 'success' : 'info' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Results Count #}
        <div class="rams-results-count">
            {{ 'common.showing'|trans|default('Showing') }} <span class="rams-results-count__value">{{ activities|length }}</span> {{ 'activity.title'|trans|lower }}
        </div>

        {# Activities List #}
        <div class="rams-list">
            {% for activity in activities %}
                <div class="rams-module rams-module--interactive">
                    <div class="rams-module__content">
                        <div class="rams-list__item">
                            {# Activity Icon #}
                            <div class="rams-list__icon rams-list__icon--{{ activity.type|lower|replace({' ': '-', '-': '-'}) }}">
                                <svg class="rams-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                </svg>
                            </div>

                            {# Activity Details #}
                            <div class="rams-list__content">
                                <div class="rams-list__header">
                                    <div class="rams-list__meta">
                                        <span class="rams-badge rams-badge--{{ activity.type|lower|replace({' ': '-', '-': '-'}) }}">
                                            {{ activity.type }}
                                        </span>
                                        {% if activity.outcome %}
                                            <span class="rams-list__separator">·</span>
                                            <span class="rams-list__outcome">{{ activity.outcome }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <p class="rams-list__title">
                                    {% if activity.company %}
                                        <a href="{{ path('app_company_show', {id: activity.company.id}) }}" class="rams-link">{{ activity.company.name }}</a>
                                    {% endif %}
                                    {% if activity.contact %}
                                        <span class="rams-list__separator">·</span>
                                        <a href="{{ path('app_contact_show', {id: activity.contact.id}) }}" class="rams-link">{{ activity.contact.firstName }} {{ activity.contact.lastName }}</a>
                                    {% endif %}
                                </p>
                                {% if activity.notes %}
                                    <p class="rams-list__description">{{ activity.notes }}</p>
                                {% endif %}
                                <div class="rams-list__footer">
                                    <span>{{ activity.activityDate|date('M d, Y') }}</span>
                                    <span class="rams-list__separator">·</span>
                                    <span>{{ activity.user.firstName }} {{ activity.user.lastName }}</span>
                                </div>
                            </div>

                            {# Actions #}
                            <div class="rams-list__actions">
                                <a href="{{ path('app_activity_show', {id: activity.id}) }}" class="rams-btn rams-btn--ghost rams-btn--icon" title="{{ 'common.view'|trans }}">
                                    <svg class="rams-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                </a>
                                <a href="{{ path('app_activity_edit', {id: activity.id}) }}" class="rams-btn rams-btn--ghost rams-btn--icon" title="{{ 'common.edit'|trans }}">
                                    <svg class="rams-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="rams-module">
                    <div class="rams-module__content rams-empty-state">
                        <svg class="rams-empty-state__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <circle cx="8" cy="8" r="6" stroke-width="2"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4V8L11 11"/>
                        </svg>
                        <h3 class="rams-empty-state__title">{{ 'activity.no_activities'|trans }}</h3>
                        <p class="rams-empty-state__description">{{ 'activity.create_first'|trans }}</p>
                        <div class="rams-empty-state__actions">
                            <a href="{{ path('app_activity_new') }}" class="rams-btn rams-btn--primary">
                                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                </svg>
                                {{ 'activity.create_first_button'|trans|default('Create First Activity') }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

    </div>
</div>
{% endblock %}
