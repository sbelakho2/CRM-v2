{% extends 'base.html.twig' %}

{% block title %}New Custom Field{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                 New Custom Field
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('custom_field_index') }}" class="rams-breadcrumb__item">Custom Fields</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">Create</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <a href="{{ path('custom_field_index') }}" class="rams-btn">Cancel</a>
        </div>
    </div>

    <div class="rams-page-content">
        {{ include('custom_field/_form.html.twig', {button_label: 'Create Field'}) }}
    </div>
</div>
{% endblock %}
