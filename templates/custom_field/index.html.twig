{% extends 'base.html.twig' %}

{% block title %}{{ 'custom_field.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page__header-content">
            <h1 class="rams-page__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-3" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                 {{ 'custom_field.title'|trans }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ 'custom_field.title'|trans }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
            {% set previewEntity = (currentEntityType is defined and currentEntityType) ? currentEntityType : ((entityTypes is defined and entityTypes|length) ? (entityTypes|first) : null) %}
            {% if previewEntity %}
                <a href="{{ path('custom_field_preview', {'entityType': previewEntity}) }}" class="rams-btn rams-mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                {{ 'custom_field.preview_form'|trans }}
                </a>
            {% else %}
                <span class="rams-btn rams-btn--ghost rams-mr-2">{{ 'custom_field.preview_form'|trans }}</span>
            {% endif %}
            <a href="{{ path('custom_field_new', {'entity': currentEntityType|default(null)}) }}" class="rams-btn rams-btn--primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                {{ 'custom_field.new_field'|trans }}
            </a>
        </div>
    </div>

    <div class="rams-page__container">
        <!-- Entity Tabs -->
        <div class="rams-module rams-mb-6">
            <div class="rams-module__content rams-p-2 rams-overflow-x-auto">
                <div class="rams-flex rams-gap-2 rams-min-w-max">
                    {% for label, entity in entityTypes %}
                        <a href="{{ path('custom_field_index', {entity: entity}) }}" class="rams-btn {{ currentEntityType == entity ? 'rams-btn--primary' : 'rams-btn--ghost' }} rams-btn--sm">
                            {{ label|trans|default(label) }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="rams-module">
            <div class="rams-table-container">
                <table class="rams-table">
                    <caption class="rams-sr-only">{{ 'custom_field.title'|trans }}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{ 'custom_field.label_key'|trans }}</th>
                            <th scope="col">{{ 'custom_field.entity'|trans }}</th>
                            <th scope="col">{{ 'common.type'|trans }}</th>
                            <th scope="col">{{ 'custom_field.group'|trans }}</th>
                            <th scope="col">{{ 'custom_field.required'|trans }}</th>
                            <th scope="col" class="rams-text--right">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for field in fields %}
                        <tr>
                            <td>
                                <a href="{{ path('custom_field_edit', {'id': field.id}) }}" class="rams-link rams-block">{{ field.label }}</a>
                                <code class="rams-text--xs rams-text--muted">{{ field.fieldKey }}</code>
                            </td>
                            <td><span class="rams-badge rams-badge--gray">{{ field.entityType }}</span></td>
                            <td>{{ field.fieldType }}</td>
                            <td>{{ field.fieldGroup|default('-') }}</td>
                            <td>
                                {% if field.required %}
                                    <span class="rams-text--danger rams-text--bold">{{ 'common.yes'|trans }}</span>
                                {% else %}
                                    <span class="rams-text--muted">{{ 'common.no'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="rams-text--right">
                                <a href="{{ path('custom_field_edit', {'id': field.id}) }}" class="rams-btn rams-btn--ghost rams-btn--icon" title="{{ 'common.edit'|trans }}" aria-label="{{ 'common.edit'|trans }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="rams-text--center rams-py-xl rams-text--muted">
                                {{ 'custom_field.no_fields'|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
