{% extends 'base.html.twig' %}

{% block title %}Custom Fields{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                 Custom Fields
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">Custom Fields</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <a href="{{ path('custom_field_preview', {'entity': currentEntity|default('all')}) }}" class="rams-btn rams-mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                Preview Form
            </a>
            <a href="{{ path('custom_field_new', {'entity': currentEntity|default(null)}) }}" class="rams-btn--primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                New Field
            </a>
        </div>
    </div>

    <div class="rams-page-content">
        <!-- Entity Tabs -->
        <div class="rams-module rams-mb-6">
            <div class="rams-module__content rams-p-2 overflow-x-auto">
                <div class="flex rams-gap-2 min-w-max">
                     <a href="{{ path('custom_field_index') }}" class="rams-btn {{ currentEntity is null ? 'rams-btn--primary' : 'rams-btn--ghost' }} rams-btn-sm">
                        All Entities
                    </a>
                    {% for entity, count in entityCounts %}
                         <a href="{{ path('custom_field_index', {entity: entity}) }}" class="rams-btn {{ currentEntity == entity ? 'rams-btn--primary' : 'rams-btn--ghost' }} rams-btn-sm">
                            {{ entity|title }} <span class="rams-ml-2 bg-white bg-opacity-25 rams-px-1 rams-rounded rams-text--xs">{{ count }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="rams-module">
            <div class="rams-table-container">
                <table class="rams-table">
                    <thead>
                        <tr>
                            <th>Label / Key</th>
                            <th>Entity</th>
                            <th>Type</th>
                            <th>Group</th>
                            <th>Required</th>
                            <th class="rams-text--right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for field in fields %}
                        <tr>
                            <td>
                                <a href="{{ path('custom_field_edit', {'id': field.id}) }}" class="font-medium hover:underline block">{{ field.label }}</a>
                                <code class="rams-text--xs rams-text--muted">{{ field.fieldKey }}</code>
                            </td>
                            <td><span class="rams-badge rams-badge--gray">{{ field.entityType }}</span></td>
                            <td>{{ field.fieldType }}</td>
                            <td>{{ field.fieldGroup|default('-') }}</td>
                            <td>
                                {% if field.required %}
                                    <span class="text-red-500 rams-text--bold">Yes</span>
                                {% else %}
                                    <span class="rams-text--muted">No</span>
                                {% endif %}
                            </td>
                            <td class="rams-text--right">
                                <a href="{{ path('custom_field_edit', {'id': field.id}) }}" class="rams-btn--ghost rams-btn-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="rams-text--center rams-py-8 rams-text--muted">
                                No custom fields found. Select an entity above or create a new one.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
