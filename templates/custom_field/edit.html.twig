{% extends 'base.html.twig' %}

{% block title %}Edit Custom Field{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                 Edit Field: {{ field.label }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('custom_field_index', {entity: field.entityType}) }}" class="rams-breadcrumb__item">Custom Fields</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ field.label }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <a href="{{ path('custom_field_index', {entity: field.entityType}) }}" class="rams-btn">Cancel</a>
             {{ include('custom_field/_delete_form.html.twig', {'field': field}) }}
        </div>
    </div>

    <div class="rams-page-content">
        {{ include('custom_field/_form.html.twig', {button_label: 'Update Field'}) }}
    </div>
</div>
{% endblock %}
