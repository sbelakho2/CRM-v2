{% extends 'form_div_layout.html.twig' %}

{# This is a Symfony form theme (extends form_div_layout.html.twig), so the
   page-level body block is intentionally empty: page templates extending
   base.html.twig define their own body block. #}
{% block body %}{% endblock body %}

{% block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' rams-form__label rams-font-mono rams-text-2xs rams-uppercase rams-text--muted')|trim})      -%}
    {{- parent() -}}
{% endblock form_label %}

{% block form_widget_simple -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' rams-form__input')|trim}) -%}
    {{- parent() -}}
{% endblock form_widget_simple %}

{% block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' rams-form__input')|trim}) -%}
    {{- parent() -}}
{% endblock textarea_widget %}

{% block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' rams-form__select')|trim, 'aria-expanded': 'false'}) -%}
    {{- parent() -}}
{% endblock choice_widget_collapsed %}

{% block form_row -%}
    <div class="rams-form__group rams-mb-4">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock form_row %}

{% block form_errors -%}
    {%- if errors|length > 0 -%}
        <div class="rams-text--danger rams-text--xs rams-mt-1">
            {%- for error in errors -%}
                <p>{{ error.message }}</p>
            {%- endfor -%}
        </div>
    {%- endif -%}
{% endblock form_errors %}
