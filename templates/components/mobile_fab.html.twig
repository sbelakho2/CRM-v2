{# Mobile Quick Actions - Floating Action Button (FAB) - Sensei-Rams Industrial Design #}
{# Only visible on mobile devices (< 768px) #}

<div class="rams-fab">
    {# Main FAB Button #}
    <button 
        id="mobile-fab"
        type="button"
        class="rams-fab__button"
        aria-label="{{ 'fab.quick_actions'|trans }}"
        aria-expanded="false"
    >
        <svg class="rams-fab__icon rams-fab__icon--plus" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <svg class="rams-fab__icon rams-fab__icon--close rams-hidden" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    {# Sub-action Buttons #}
    <div id="fab-actions" class="rams-fab__actions rams-hidden">
        {# Log Activity #}
        <a 
            href="{{ path('app_activity_new') }}" 
            class="rams-fab__action"
            data-action="activity"
            aria-label="{{ 'activity.log'|trans }}"
            title="{{ 'activity.log'|trans }}"
        >
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <span class="rams-fab__label">{{ 'activity.log'|trans }}</span>
        </a>

        {# Add Company #}
        <a 
            href="{{ path('app_company_new') }}" 
            class="rams-fab__action"
            data-action="company"
            aria-label="{{ 'company.add'|trans }}"
            title="{{ 'company.add'|trans }}"
        >
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span class="rams-fab__label">{{ 'company.add'|trans }}</span>
        </a>

        {# Add Contact #}
        <a 
            href="{{ path('app_contact_new') }}" 
            class="rams-fab__action"
            data-action="contact"
            aria-label="{{ 'contact.add'|trans }}"
            title="{{ 'contact.add'|trans }}"
        >
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="rams-fab__label">{{ 'contact.add'|trans }}</span>
        </a>

        {# Quick Search #}
        <button 
            type="button"
            class="rams-fab__action"
            data-action="search"
            id="fab-search-btn"
            aria-label="{{ 'fab.quick_search'|trans }}"
            title="{{ 'fab.quick_search'|trans }}"
        >
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="rams-fab__label">{{ 'common.search'|trans }}</span>
        </button>
    </div>
</div>

<style>
    /* Mobile FAB - Only visible on screens < 768px */
    .rams-fab {
        display: none;
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 999;
    }

    @media (max-width: 767px) {
        .rams-fab {
            display: block;
        }
    }

    /* Main FAB Button - Sensei-Rams style */
    .rams-fab__button {
        width: 56px;
        height: 56px;
        rams-border-radius: 50%;
        background: var(--rams-orange);
        color: var(--rams-foreground);
        rams-border: 2px solid var(--rams-line);
        box-shadow: var(--shadow-inset);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        z-index: 1001;
    }

    .rams-fab__button:hover {
        background: var(--rams-orange);
        transform: scale(1.05);
        box-shadow: var(--shadow-pressed);
    }

    .rams-fab__button:active {
        transform: scale(0.95);
    }

    .rams-fab__button.active {
        background: var(--rams-primary-dark, #2563eb);
        transform: rotate(45deg);
    }

    /* FAB Icons */
    .rams-fab__icon {
        transition: all 0.2s ease;
    }

    .rams-fab__icon.hidden {
        display: none;
    }

    .rams-fab__button.active .rams-fab__icon--plus {
        display: none;
    }

    .rams-fab__button.active .rams-fab__icon--close {
        display: block;
        transform: rotate(-45deg);
    }

    /* Sub-action Buttons Container */
    .rams-fab__actions {
        position: absolute;
        bottom: 70px;
        right: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
        transition: all 0.3s ease;
    }

    .rams-fab__actions.hidden {
        opacity: 0;
        pointer-events: none;
        transform: translateY(20px);
    }

    .rams-fab__actions:not(.hidden) {
        opacity: 1;
        pointer-events: all;
        transform: translateY(0);
    }

    /* Individual Action Buttons - Sensei-Rams Module Style */
    .rams-fab__action {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background: white;
        rams-border: 1px solid var(--rams-line);
        rams-border-radius: var(--radius-lg);
        box-shadow: var(--shadow-inset);
        cursor: pointer;
        text-decoration: none;
        color: var(--rams-foreground);
        font-size: 14px;
        font-weight: 500;
        white-space: nowrap;
        transition: all 0.2s ease;
        min-width: 48px;
        justify-content: flex-end;
        animation: rams-fabSlideIn 0.3s ease backwards;
    }

    .rams-fab__action:nth-child(1) { animation-delay: 0.05s; }
    .rams-fab__action:nth-child(2) { animation-delay: 0.1s; }
    .rams-fab__action:nth-child(3) { animation-delay: 0.15s; }
    .rams-fab__action:nth-child(4) { animation-delay: 0.2s; }

    @keyframes rams-fabSlideIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.8);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .rams-fab__action:hover {
        background: var(--rams-panel);
        transform: translateX(-4px);
        box-shadow: var(--shadow-pressed);
    }

    .rams-fab__action svg {
        flex-shrink: 0;
        color: var(--rams-orange);
    }

    .rams-fab__label {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    }

    /* Accessibility: High contrast focus states */
    .rams-fab__button:focus-visible,
    .rams-fab__action:focus-visible {
        outline: 3px solid var(--rams-primary, #3b82f6);
        outline-offset: 2px;
    }

    /* Compact mode for very small screens */
    @media (max-width: 374px) {
        .rams-fab {
            bottom: 16px;
            right: 16px;
        }

        .rams-fab__button {
            width: 48px;
            height: 48px;
        }

        .rams-fab__action {
            padding: 10px 14px;
            font-size: 13px;
        }
    }
</style>

<script>
    // Mobile FAB functionality
    (function() {
        const fab = document.getElementById('mobile-fab');
        const fabActions = document.getElementById('fab-actions');
        const fabSearchBtn = document.getElementById('fab-search-btn');

        if (!fab || !fabActions) return;

        // Toggle FAB actions
        fab.addEventListener('click', function(e) {
            e.stopPropagation();
            const isActive = fab.classList.contains('active');
            
            if (isActive) {
                closeFab();
            } else {
                openFab();
            }
        });

        function openFab() {
            fab.classList.add('active');
            fab.setAttribute('aria-expanded', 'true');
            fabActions.classList.remove('rams-hidden');
        }

        function closeFab() {
            fab.classList.remove('active');
            fab.setAttribute('aria-expanded', 'false');
            fabActions.classList.add('rams-hidden');
        }

        // Close FAB when clicking outside
        document.addEventListener('click', function(e) {
            if (!fab.contains(e.target) && !fabActions.contains(e.target)) {
                closeFab();
            }
        });

        // Close FAB on ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeFab();
            }
        });

        // Quick Search button - focus search input
        if (fabSearchBtn) {
            fabSearchBtn.addEventListener('click', function(e) {
                e.preventDefault();
                closeFab();
                
                // Try to find and focus search input
                const searchInput = document.querySelector('input[name="search"], input[type="search"], #search');
                if (searchInput) {
                    searchInput.focus();
                    searchInput.select();
                }
            });
        }

        console.log('[Mobile FAB] {{ 'common.initialized'|trans }}');
    })();
</script>
