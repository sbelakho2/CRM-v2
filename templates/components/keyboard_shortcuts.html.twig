{# Keyboard Shortcuts System - Sensei-Rams Industrial Design #}

<script>
/**
 * Keyboard Shortcuts System
 * Global keyboard shortcuts for quick navigation and actions
 */

class KeyboardShortcuts {
    constructor() {
        this.keys = {};
        this.shortcuts = {
            '/': {
                action: () => this.focusSearch(),
                description: '{{ 'shortcuts.focus_search'|trans }}',
                category: '{{ 'shortcuts.navigation'|trans }}'
            },
            'l': {
                action: () => this.navigateTo('{{ path('app_activity_new') }}'),
                description: '{{ 'shortcuts.log_activity'|trans }}',
                category: '{{ 'shortcuts.quick_actions'|trans }}'
            },
            '?': {
                action: () => this.showHelp(),
                description: '{{ 'shortcuts.show_shortcuts'|trans }}',
                category: '{{ 'shortcuts.help'|trans }}'
            }
        };

        // Combo shortcuts (hold first key, press second)
        this.comboShortcuts = {
            'a+c': {
                action: () => this.navigateTo('{{ path('app_company_new') }}'),
                description: '{{ 'shortcuts.add_company'|trans }}',
                display: 'A + C',
                category: '{{ 'shortcuts.quick_actions'|trans }}'
            },
            'a+e': {
                action: () => this.navigateTo('{{ path('app_contact_new') }}'),
                description: '{{ 'shortcuts.add_contact'|trans }}',
                display: 'A + E',
                category: '{{ 'shortcuts.quick_actions'|trans }}'
            }
        };

        this.init();
    }

    init() {
        document.addEventListener('keydown', (e) => this.handleKeyDown(e));
        document.addEventListener('keyup', (e) => this.handleKeyUp(e));
        console.log('[Keyboard Shortcuts] {{ 'common.initialized'|trans }}');
    }

    handleKeyDown(e) {
        // Don't trigger shortcuts when typing in inputs/textareas
        if (this.isTyping(e.target)) {
            return;
        }

        const key = e.key.toLowerCase();
        this.keys[key] = true;

        // Check single-key shortcuts
        if (this.shortcuts[key]) {
            e.preventDefault();
            this.shortcuts[key].action();
            return;
        }

        // Check combo shortcuts
        for (const [combo, config] of Object.entries(this.comboShortcuts)) {
            const [first, second] = combo.split('+');
            if (this.keys[first] && key === second) {
                e.preventDefault();
                config.action();
                return;
            }
        }
    }

    handleKeyUp(e) {
        const key = e.key.toLowerCase();
        delete this.keys[key];
    }

    isTyping(element) {
        const tagName = element.tagName.toLowerCase();
        const isEditable = element.isContentEditable;
        const isInput = ['input', 'textarea', 'select'].includes(tagName);
        
        return isInput || isEditable;
    }

    focusSearch() {
        const searchInput = document.querySelector('input[name="search"], input[type="search"], #search');
        if (searchInput) {
            searchInput.focus();
            searchInput.select();
            console.log('[Shortcuts] {{ 'shortcuts.focused_search'|trans }}');
        }
    }

    navigateTo(url) {
        console.log('[Shortcuts] {{ 'shortcuts.navigating_to'|trans }}:', url);
        window.location.href = url;
    }

    showHelp() {
        const modal = document.getElementById('shortcuts-help-modal');
        if (modal) {
            modal.classList.remove('rams-hidden');
            console.log('[Shortcuts] {{ 'shortcuts.help_opened'|trans }}');
        }
    }

    getAllShortcuts() {
        const all = [];

        // Single-key shortcuts
        for (const [key, config] of Object.entries(this.shortcuts)) {
            all.push({
                keys: key.toUpperCase(),
                description: config.description,
                category: config.category
            });
        }

        // Combo shortcuts
        for (const [combo, config] of Object.entries(this.comboShortcuts)) {
            all.push({
                keys: config.display || combo.toUpperCase(),
                description: config.description,
                category: config.category
            });
        }

        return all;
    }
}

// Initialize on DOM ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        window.keyboardShortcuts = new KeyboardShortcuts();
    });
} else {
    window.keyboardShortcuts = new KeyboardShortcuts();
}
</script>
