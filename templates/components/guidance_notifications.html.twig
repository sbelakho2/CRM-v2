{# templates/components/guidance_notifications.html.twig #}
{% if app.session.get('guidance_notifications') is not empty %}
    {% set notifications = app.session.get('guidance_notifications') %}
    {% set maxDisplay = 3 %}
    {% set totalCount = notifications|length %}
    
    <div class="rams-guidance-stack" id="guidance-notifications-container">
        {% for notification in notifications|slice(0, maxDisplay) %}
            <div class="rams-alert {{ notification.type == 'success' ? 'rams-alert--success' : notification.type == 'warning' ? 'rams-alert--warning' : notification.type == 'error' ? 'rams-alert--error' : 'rams-alert--info' }} guidance-notification rams-module--inset" data-notification-index="{{ loop.index0 }}">
                {# Icon with Andon #}
                <div class="rams-alert__icon">
                    <span class="rams-andon {{ notification.type == 'success' ? 'rams-andon--success' : notification.type == 'warning' ? 'rams-andon--warning' : notification.type == 'error' ? 'rams-andon--error' : 'rams-andon--info' }}"><span class="rams-andon__light"></span></span>
                </div>

                {# Content #}
                <div class="rams-alert__content">
                    <div class="rams-flex rams-justify-between rams-items-start">
                        <span class="rams-alert__title">{{ ('common.' ~ notification.type)|trans }}</span>
                        <div class="rams-text--3xs rams-text--muted rams-font-mono">{{  notification.timestamp|date('H:i') }}</div>
                    </div>
                    <p class="rams-alert__text">
                        {{ notification.message }}
                    </p>
                </div>

                {# Action Buttons #}
                <div class="rams-alert__actions">
                    {% if notification.actionUrl and notification.actionLabel %}
                        <a href="{{ notification.actionUrl }}" class="rams-btn rams-btn--primary rams-btn--sm rams-uppercase"> 
                            {{ notification.actionLabel }}
                        </a>
                    {% endif %}
                    {# Dismiss Button #}
                    <button type="button" onclick="dismissGuidanceNotification(this)" class="rams-btn rams-btn--ghost rams-btn--sm" aria-label="{{  'common.close'|trans }}">
                        <svg class="rams-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            </div>
        {% endfor %}
    </div>

    <script>
    function dismissGuidanceNotification(button) {
        const notification = button.closest('.guidance-notification');
        const index = notification.getAttribute('data-notification-index');
        
        notification.style.transition = 'opacity 0.3s, transform 0.3s';
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(100%)';
        
        fetch('{{ path('guidance_dismiss') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'index=' + index
        + '&_csrf_token=' + encodeURIComponent('{{ csrf_token('guidance_dismiss') }}') }).then(response => {
            if (response.ok) {
                setTimeout(() => {
                    notification.remove();
                    const container = document.getElementById('guidance-notifications-container');
                    const remaining = container ? container.querySelectorAll('.guidance-notification').length : 0;
                    if (remaining === 0 && container) {
                        container.remove();
                    }
                }, 300);
            }
        });
    }

    function clearAllGuidanceNotifications() {
        ramsConfirm('{{ 'guidance.clear_confirm'|trans }}', function() {
            fetch('{{ path('guidance_dismiss_all') }}', {
                method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', }, body: '_csrf_token=' + encodeURIComponent('{{ csrf_token('guidance_dismiss_all') }}') 
            }).then(response => {
                if (response.ok) {
                    location.reload();
                }
            });
        }, {title: '{{ 'guidance.clear_all'|trans }}', variant: 'warning'});
    }

    // Auto-dismiss success notifications after 10 seconds
    document.addEventListener('DOMContentLoaded', function() {
        const successNotifications = document.querySelectorAll('.guidance-notification[data-notification-index]');
        successNotifications.forEach((notification, index) => {
            const notificationType = notification.classList.contains('rams-alert--success') ? 'success' : null;
            if (notificationType === 'success') {
                setTimeout(() => {
                    const dismissBtn = notification.querySelector('button[onclick*="dismissGuidanceNotification"]');
                    if (dismissBtn) {
                        dismissGuidanceNotification(dismissBtn);
                    }
                }, 10000);
            }
        });
    });
    </script>
{% endif %}
