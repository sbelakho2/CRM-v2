{# templates/components/guidance_notifications.html.twig #}
{% if app.session.get('guidance_notifications') is not empty %}
    {% set notifications = app.session.get('guidance_notifications') %}
    {% set maxDisplay = 3 %}
    {% set totalCount = notifications|length %}
    
    <div class="mb-6 space-y-3" id="guidance-notifications-container">
        {# Header with Clear All button #}
        {% if totalCount > 0 %}
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-neutral-700">
                    Guidance Notifications ({{ totalCount }})
                </h3>
                <div class="flex items-center gap-2">
                    {% if totalCount > maxDisplay %}
                        <a href="{{ path('app_guidance_all') }}" class="text-xs text-blue-600 hover:text-blue-700 font-medium">
                            View All ({{ totalCount }})
                        </a>
                    {% endif %}
                    <button type="button" onclick="clearAllGuidanceNotifications()" class="text-xs text-neutral-600 hover:text-neutral-900 font-medium">
                        Clear All
                    </button>
                </div>
            </div>
        {% endif %}
        
        {% for notification in notifications|slice(0, maxDisplay) %}
            <div class="rounded-xl border p-4 flex items-start gap-3 guidance-notification" data-notification-index="{{ loop.index0 }}" {{ 
                notification.type == 'success' ? 'bg-green-50 border-green-200' :
                notification.type == 'warning' ? 'bg-amber-50 border-amber-200' :
                notification.type == 'tip' ? 'bg-blue-50 border-blue-200' :
                'bg-neutral-50 border-neutral-200'
            }}">
                {# Icon #}
                <div class="flex-shrink-0 mt-0.5">
                    {% if notification.type == 'success' %}
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    {% elseif notification.type == 'warning' %}
                        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                    {% elseif notification.type == 'tip' %}
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                        </svg>
                    {% else %}
                        <svg class="w-5 h-5 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    {% endif %}
                </div>

                {# Content #}
                <div class="flex-1 min-w-0">
                    <p class="text-sm {{ 
                        notification.type == 'success' ? 'text-green-800' :
                        notification.type == 'warning' ? 'text-amber-800' :
                        notification.type == 'tip' ? 'text-blue-800' :
                        'text-neutral-800'
                    }}">
                        {{ notification.message|raw }}
                    </p>
                </div>

                {# Action Buttons #}
                <div class="flex-shrink-0 flex items-center gap-2">
                    {% if notification.actionUrl and notification.actionLabel %}
                        <a href="{{ notification.actionUrl }}" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium rounded-lg transition-colors {{
                            notification.type == 'success' ? 'bg-green-600 text-white hover:bg-green-700' :
                            notification.type == 'warning' ? 'bg-amber-600 text-white hover:bg-amber-700' :
                            notification.type == 'tip' ? 'bg-blue-600 text-white hover:bg-blue-700' :
                            'bg-neutral-600 text-white hover:bg-neutral-700'
                        }}">
                            {{ notification.actionLabel }}
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    {% endif %}
                    {# Dismiss Button #}
                    <button type="button" onclick="dismissGuidanceNotification(this)" class="p-1.5 rounded-lg transition-colors {{ 
                        notification.type == 'success' ? 'text-green-600 hover:bg-green-100' :
                        notification.type == 'warning' ? 'text-amber-600 hover:bg-amber-100' :
                        notification.type == 'tip' ? 'text-blue-600 hover:bg-blue-100' :
                        'text-neutral-600 hover:bg-neutral-100'
                    }}" title="Dismiss">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            </div>
        {% endfor %}
    </div>

    <script>
    function dismissGuidanceNotification(button) {
        const notification = button.closest('.guidance-notification');
        const index = notification.getAttribute('data-notification-index');
        
        // Animate out
        notification.style.transition = 'opacity 0.3s, transform 0.3s';
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(100%)';
        
        // Send dismiss request to server to permanently remove
        fetch('{{ path('guidance_dismiss') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'index=' + index
        }).then(response => {
            if (response.ok) {
                setTimeout(() => {
                    notification.remove();
                    
                    // Reload if no more notifications visible
                    const container = document.getElementById('guidance-notifications-container');
                    const remaining = container ? container.querySelectorAll('.guidance-notification').length : 0;
                    if (remaining === 0) {
                        location.reload();
                    }
                }, 300);
            }
        });
    }

    function clearAllGuidanceNotifications() {
        if (confirm('Are you sure you want to clear all guidance notifications?')) {
            fetch('{{ path('guidance_dismiss_all') }}', {
                method: 'POST'
            }).then(response => {
                if (response.ok) {
                    location.reload();
                }
            });
        }
    }

    // Auto-dismiss success notifications after 10 seconds
    document.addEventListener('DOMContentLoaded', function() {
        const successNotifications = document.querySelectorAll('.guidance-notification[data-notification-index]');
        successNotifications.forEach((notification, index) => {
            const notificationType = notification.classList.contains('bg-green-50') ? 'success' : null;
            if (notificationType === 'success') {
                setTimeout(() => {
                    const dismissBtn = notification.querySelector('button[onclick*="dismissGuidanceNotification"]');
                    if (dismissBtn) {
                        dismissGuidanceNotification(dismissBtn);
                    }
                }, 10000); // 10 seconds
            }
        });
    });
    </script>
{% endif %}
