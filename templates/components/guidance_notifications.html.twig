{# templates/components/guidance_notifications.html.twig #}
{% if app.session.get('guidance_notifications') is not empty %}
    {% set notifications = app.session.get('guidance_notifications') %}
    {% set maxDisplay = 3 %}
    {% set totalCount = notifications|length %}
    
    <div class="rams-stack" id="guidance-notifications-container">
        {# Header with Clear All button #}
        {% if totalCount > 0 %}
            <div class="rams-module__header">
                <h3 class="rams-dymo">
                    {{ 'guidance.notifications'|trans }} ({{ totalCount }})
                </h3>
                <div class="rams-btn-group">
                    {% if totalCount > maxDisplay %}
                        <a href="{{ path('app_guidance_all') }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                            {{ 'common.view'|trans }} {{ 'common.all'|trans }} ({{ totalCount }})
                        </a>
                    {% endif %}
                    <button type="button" onclick="clearAllGuidanceNotifications()" class="rams-btn rams-btn--ghost rams-btn--sm">
                        {{ 'guidance.clear_all'|trans }}
                    </button>
                </div>
            </div>
        {% endif %}
        
        {% for notification in notifications|slice(0, maxDisplay) %}
            <div class="rams-alert {{ 
                notification.type == 'success' ? 'rams-alert--success' :
                notification.type == 'warning' ? 'rams-alert--warning' :
                notification.type == 'tip' ? 'rams-alert--info' :
                ''
            }} guidance-notification" data-notification-index="{{ loop.index0 }}">
                {# Icon with Andon #}
                <div class="rams-alert__icon">
                    <span class="rams-andon {{ 
                        notification.type == 'success' ? 'rams-andon--success' :
                        notification.type == 'warning' ? 'rams-andon--warning' :
                        notification.type == 'tip' ? 'rams-andon--info' :
                        ''
                    }}"><span class="rams-andon__light"></span></span>
                </div>

                {# Content #}
                <div class="rams-alert__content">
                    <p class="rams-alert__text">
                        {{ notification.message|raw }}
                    </p>
                </div>

                {# Action Buttons #}
                <div class="rams-alert__actions">
                    {% if notification.actionUrl and notification.actionLabel %}
                        <a href="{{ notification.actionUrl }}" class="rams-btn rams-btn--primary rams-btn--sm">
                            {{ notification.actionLabel }}
                            <svg class="rams-btn__icon--end" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    {% endif %}
                    {# Dismiss Button #}
                    <button type="button" onclick="dismissGuidanceNotification(this)" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'common.close'|trans }}">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            </div>
        {% endfor %}
    </div>

    <script>
    function dismissGuidanceNotification(button) {
        const notification = button.closest('.guidance-notification');
        const index = notification.getAttribute('data-notification-index');
        
        notification.style.transition = 'opacity 0.3s, transform 0.3s';
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(100%)';
        
        fetch('{{ path('guidance_dismiss') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'index=' + index
        }).then(response => {
            if (response.ok) {
                setTimeout(() => {
                    notification.remove();
                    const container = document.getElementById('guidance-notifications-container');
                    const remaining = container ? container.querySelectorAll('.guidance-notification').length : 0;
                    if (remaining === 0) {
                        location.reload();
                    }
                }, 300);
            }
        });
    }

    function clearAllGuidanceNotifications() {
        ramsConfirm('{{ 'guidance.clear_confirm'|trans }}', function() {
            fetch('{{ path('guidance_dismiss_all') }}', {
                method: 'POST'
            }).then(response => {
                if (response.ok) {
                    location.reload();
                }
            });
        }, {title: '{{ 'guidance.clear_all'|trans }}', variant: 'warning'});
    }

    // Auto-dismiss success notifications after 10 seconds
    document.addEventListener('DOMContentLoaded', function() {
        const successNotifications = document.querySelectorAll('.guidance-notification[data-notification-index]');
        successNotifications.forEach((notification, index) => {
            const notificationType = notification.classList.contains('rams-alert--success') ? 'success' : null;
            if (notificationType === 'success') {
                setTimeout(() => {
                    const dismissBtn = notification.querySelector('button[onclick*="dismissGuidanceNotification"]');
                    if (dismissBtn) {
                        dismissGuidanceNotification(dismissBtn);
                    }
                }, 10000);
            }
        });
    });
    </script>
{% endif %}
