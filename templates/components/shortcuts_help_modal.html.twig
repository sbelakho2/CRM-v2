{# Keyboard Shortcuts Help Modal - Sensei-Rams Industrial Design #}

<div id="shortcuts-help-modal" class="rams-modal-backdrop rams-hidden">
    <div class="rams-modal-backdrop__overlay" onclick="document.getElementById('shortcuts-help-modal').classList.add('rams-hidden')"></div>
    
    <div class="rams-module rams-shortcuts-modal">
        {# Modal Header #}
        <div class="rams-module__header rams-shortcuts-modal__header">
            <h2 class="rams-module__title">{{ 'shortcuts.title'|trans|default('Keyboard Shortcuts') }}</h2>
            <button 
                type="button"
                class="rams-btn rams-btn--ghost rams-shortcuts-modal__close"
                onclick="document.getElementById('shortcuts-help-modal').classList.add('rams-hidden')"
                aria-label="{{ 'common.close'|trans }}"
            >
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        {# Modal Body #}
        <div class="rams-module__content rams-shortcuts-modal__body">
            {# Navigation Shortcuts #}
            <div class="rams-shortcuts__section">
                <h3 class="rams-dymo rams-shortcuts__title">{{ 'shortcuts.navigation'|trans|default('Navigation') }}</h3>
                <div class="rams-shortcuts__list">
                    <div class="rams-shortcuts__item">
                        <kbd class="rams-kbd">/</kbd>
                        <span class="rams-shortcuts__desc">{{ 'shortcuts.focus_search'|trans|default('Focus search') }}</span>
                    </div>
                </div>
            </div>

            {# Quick Actions #}
            <div class="rams-shortcuts__section">
                <h3 class="rams-dymo rams-shortcuts__title">{{ 'shortcuts.quick_actions'|trans|default('Quick Actions') }}</h3>
                <div class="rams-shortcuts__list">
                    <div class="rams-shortcuts__item">
                        <kbd class="rams-kbd">L</kbd>
                        <span class="rams-shortcuts__desc">{{ 'shortcuts.log_activity'|trans|default('Log activity') }}</span>
                    </div>
                    <div class="rams-shortcuts__item">
                        <kbd class="rams-kbd">A</kbd>
                        <span class="rams-shortcuts__plus">+</span>
                        <kbd class="rams-kbd">C</kbd>
                        <span class="rams-shortcuts__desc">{{ 'shortcuts.add_company'|trans|default('Add company') }}</span>
                    </div>
                    <div class="rams-shortcuts__item">
                        <kbd class="rams-kbd">A</kbd>
                        <span class="rams-shortcuts__plus">+</span>
                        <kbd class="rams-kbd">E</kbd>
                        <span class="rams-shortcuts__desc">{{ 'shortcuts.add_contact'|trans|default('Add contact') }}</span>
                    </div>
                </div>
            </div>

            {# Help #}
            <div class="rams-shortcuts__section">
                <h3 class="rams-dymo rams-shortcuts__title">{{ 'common.help'|trans|default('Help') }}</h3>
                <div class="rams-shortcuts__list">
                    <div class="rams-shortcuts__item">
                        <kbd class="rams-kbd">?</kbd>
                        <span class="rams-shortcuts__desc">{{ 'shortcuts.show_dialog'|trans|default('Show this dialog') }}</span>
                    </div>
                    <div class="rams-shortcuts__item">
                        <kbd class="rams-kbd">ESC</kbd>
                        <span class="rams-shortcuts__desc">{{ 'shortcuts.close_dialogs'|trans|default('Close dialogs') }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# Modal Footer #}
        <div class="rams-module__footer rams-shortcuts-modal__footer">
            <p class="rams-dymo">
                {{ 'shortcuts.note_disabled_in_text'|trans|default('Note: Shortcuts are disabled when typing in text fields') }}
            </p>
        </div>
    </div>
</div>

<style>
    /* Modal Overlay - Sensei-Rams Industrial Design */
    /* Modal Backdrop - Sensei-Rams BEM */
    .rams-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .rams-modal-backdrop.rams-hidden {
        display: none;
    }

    .rams-modal-backdrop__overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--rams-overlay);
        backdrop-filter: blur(4px);
    }

    /* Modal Content - Rams Module */
    .rams-shortcuts-modal {
        position: relative;
        max-width: 600px;
        width: 100%;
        max-height: 80vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        animation: rams-modalSlideIn 0.3s ease;
    }

    @keyframes rams-modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Modal Header */
    .rams-shortcuts-modal__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .rams-shortcuts-modal__close {
        padding: 8px;
    }

    /* Modal Body */
    .rams-shortcuts-modal__body {
        flex: 1;
        overflow-y: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 32px;
    }

    @media (max-width: 640px) {
        .rams-shortcuts-modal__body {
            grid-template-columns: 1fr;
            gap: 24px;
        }
    }

    /* Shortcuts Sections */
    .rams-shortcuts__section {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .rams-shortcuts__title {
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 8px 0;
    }

    .rams-shortcuts__list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* Individual Shortcut Items */
    .rams-shortcuts__item {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Keyboard Key Style - Rams Industrial */
    .rams-kbd {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        background: var(--rams-panel);
        border: 1px solid var(--rams-line);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 600;
        color: var(--rams-foreground);
        box-shadow: var(--shadow-inset);
    }

    .rams-shortcuts__plus {
        color: var(--rams-grey-600);
        font-size: 12px;
        font-weight: 500;
    }

    .rams-shortcuts__desc {
        flex: 1;
        font-size: 14px;
        color: var(--rams-foreground);
    }

    /* Modal Footer */
    .rams-shortcuts-modal__footer {
        text-align: center;
    }

    /* Accessibility */
    .rams-shortcuts-modal__close:focus-visible {
        outline: 3px solid var(--rams-primary);
        outline-offset: 2px;
    }
</style>

<script>
    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('shortcuts-help-modal');
            if (modal && !modal.classList.contains('rams-hidden')) {
                modal.classList.add('rams-hidden');
            }
        }
    });
</script>
