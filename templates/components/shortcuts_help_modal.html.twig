{# Keyboard Shortcuts Help Modal #}

<div id="shortcuts-help-modal" class="shortcuts-modal hidden">
    <div class="shortcuts-modal-overlay" onclick="document.getElementById('shortcuts-help-modal').classList.add('hidden')"></div>
    
    <div class="shortcuts-modal-content">
        {# Modal Header #}
        <div class="shortcuts-modal-header">
            <h2 class="shortcuts-modal-title">Keyboard Shortcuts</h2>
            <button 
                type="button"
                class="shortcuts-modal-close"
                onclick="document.getElementById('shortcuts-help-modal').classList.add('hidden')"
                aria-label="Close"
            >
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        {# Modal Body #}
        <div class="shortcuts-modal-body">
            {# Navigation Shortcuts #}
            <div class="shortcuts-section">
                <h3 class="shortcuts-section-title">Navigation</h3>
                <div class="shortcuts-list">
                    <div class="shortcut-item">
                        <kbd class="shortcut-key">/</kbd>
                        <span class="shortcut-desc">Focus search</span>
                    </div>
                </div>
            </div>

            {# Quick Actions #}
            <div class="shortcuts-section">
                <h3 class="shortcuts-section-title">Quick Actions</h3>
                <div class="shortcuts-list">
                    <div class="shortcut-item">
                        <kbd class="shortcut-key">L</kbd>
                        <span class="shortcut-desc">Log activity</span>
                    </div>
                    <div class="shortcut-item">
                        <kbd class="shortcut-key">A</kbd>
                        <span class="shortcut-plus">+</span>
                        <kbd class="shortcut-key">C</kbd>
                        <span class="shortcut-desc">Add company</span>
                    </div>
                    <div class="shortcut-item">
                        <kbd class="shortcut-key">A</kbd>
                        <span class="shortcut-plus">+</span>
                        <kbd class="shortcut-key">E</kbd>
                        <span class="shortcut-desc">Add contact</span>
                    </div>
                </div>
            </div>

            {# Help #}
            <div class="shortcuts-section">
                <h3 class="shortcuts-section-title">Help</h3>
                <div class="shortcuts-list">
                    <div class="shortcut-item">
                        <kbd class="shortcut-key">?</kbd>
                        <span class="shortcut-desc">Show this dialog</span>
                    </div>
                    <div class="shortcut-item">
                        <kbd class="shortcut-key">ESC</kbd>
                        <span class="shortcut-desc">Close dialogs</span>
                    </div>
                </div>
            </div>
        </div>

        {# Modal Footer #}
        <div class="shortcuts-modal-footer">
            <p class="text-sm text-neutral-600">
                Note: Shortcuts are disabled when typing in text fields
            </p>
        </div>
    </div>
</div>

<style>
    /* Modal Overlay */
    .shortcuts-modal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .shortcuts-modal.hidden {
        display: none;
    }

    .shortcuts-modal-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(44, 36, 22, 0.5);
        backdrop-filter: blur(4px);
    }

    /* Modal Content */
    .shortcuts-modal-content {
        position: relative;
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(44, 36, 22, 0.3);
        max-width: 600px;
        width: 100%;
        max-height: 80vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        animation: modalSlideIn 0.3s ease;
    }

    @keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Modal Header */
    .shortcuts-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 24px;
        border-bottom: 1px solid var(--claude-border, #DDD8CC);
    }

    .shortcuts-modal-title {
        font-size: 24px;
        font-weight: 600;
        color: var(--claude-text, #2C2416);
        margin: 0;
    }

    .shortcuts-modal-close {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--claude-text-secondary, #5C5041);
        padding: 8px;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .shortcuts-modal-close:hover {
        background: var(--claude-hover, #EDE9E0);
        color: var(--claude-text, #2C2416);
    }

    /* Modal Body */
    .shortcuts-modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 32px;
    }

    @media (max-width: 640px) {
        .shortcuts-modal-body {
            grid-template-columns: 1fr;
            gap: 24px;
        }
    }

    /* Shortcuts Sections */
    .shortcuts-section {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .shortcuts-section-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--claude-purple, #9B6B9E);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 8px 0;
    }

    .shortcuts-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* Individual Shortcut Items */
    .shortcut-item {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .shortcut-key {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        background: var(--claude-tan, #E8E3D8);
        border: 1px solid var(--claude-border, #DDD8CC);
        border-radius: 6px;
        font-family: 'Courier New', monospace;
        font-size: 14px;
        font-weight: 600;
        color: var(--claude-text, #2C2416);
        box-shadow: 0 2px 4px rgba(44, 36, 22, 0.1);
    }

    .shortcut-plus {
        color: var(--claude-text-secondary, #5C5041);
        font-size: 12px;
        font-weight: 500;
    }

    .shortcut-desc {
        flex: 1;
        font-size: 14px;
        color: var(--claude-text, #2C2416);
    }

    /* Modal Footer */
    .shortcuts-modal-footer {
        padding: 16px 24px;
        border-top: 1px solid var(--claude-border, #DDD8CC);
        background: var(--claude-tan, #E8E3D8);
    }

    /* Accessibility */
    .shortcuts-modal-close:focus-visible {
        outline: 3px solid var(--claude-purple, #9B6B9E);
        outline-offset: 2px;
    }
</style>

<script>
    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('shortcuts-help-modal');
            if (modal && !modal.classList.contains('hidden')) {
                modal.classList.add('hidden');
            }
        }
    });
</script>
