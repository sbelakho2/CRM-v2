{# 
    Sensei-Rams Confirmation Modal Component
    
    Usage: Include this component once in base.html.twig
    Then call: ramsConfirm(message, onConfirm, options)
    
    Options:
    - title: string (default: 'Confirm Action')
    - confirmText: string (default: 'Confirm')
    - cancelText: string (default: 'Cancel')
    - variant: 'danger' | 'warning' | 'default' (default: 'default')
#}

{# Confirmation Modal Backdrop #}
<div class="rams-modal-backdrop rams-hidden" id="rams-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="rams-confirm-title">
    <div class="rams-modal rams-modal--sm">
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="rams-module__title" id="rams-confirm-title">
                    <div id="rams-confirm-andon" class="rams-andon rams-andon--warning rams-mr-2">
                        <span class="rams-andon__light"></span>
                    </div>
                    <span id="rams-confirm-title-text">{{ 'common.confirm_action'|trans }}</span>
                </h3>
                <button type="button" class="rams-btn rams-btn--ghost rams-btn--icon" onclick="ramsConfirmCancel()" aria-label="{{ 'common.close'|trans }}">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="rams-icon-sm" aria-hidden="true">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </button>
            </div>
            <div class="rams-module__content">
                <p id="rams-confirm-message" class="rams-text--muted">{{ 'common.confirm_message'|trans }}</p>
                <div id="rams-confirm-input-row" class="rams-hidden rams-mt-3">
                    <label for="rams-confirm-input" id="rams-confirm-input-label" class="rams-form__label">{{ 'common.reason'|trans }}</label>
                    <input type="text" id="rams-confirm-input" class="rams-form__input" autocomplete="off">
                </div>
            </div>
            <div class="rams-module__footer rams-flex rams-gap-2 rams-justify-end">
                <button type="button" id="rams-confirm-cancel-btn" class="rams-btn" onclick="ramsConfirmCancel()">
                    {{ 'common.cancel'|trans }}
                </button>
                <button type="button" id="rams-confirm-btn" class="rams-btn rams-btn--danger" onclick="ramsConfirmAction()">
                    {{ 'common.confirm'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>

<style>
/* Confirmation Modal Styles — component-specific only; shared modal
 * primitives (.rams-modal-backdrop / .rams-modal / rams-modal-enter) live
 * in sensei-rams.css so every modal shares one scrim and one z-scale. */
.rams-module__title-icon {
    margin-right: var(--space-2);
}

/* Variant-specific button colors */
.rams-confirm--danger #rams-confirm-btn {
    background: var(--rams-red);
}

.rams-confirm--warning #rams-confirm-btn {
    background: var(--rams-orange);
    color: var(--rams-foreground);
}
</style>

<script>
/**
 * Sensei-Rams Confirmation Modal
 * Replaces native browser confirm() dialogs with styled modal
 */
(function() {
    let confirmCallback = null;
    let cancelCallback = null;
    let promptMode = false;

    function getModal() {
        return document.getElementById('rams-confirm-modal');
    }

    function resetPromptState() {
        const row = document.getElementById('rams-confirm-input-row');
        const input = document.getElementById('rams-confirm-input');
        promptMode = false;
        if (row) row.classList.add('rams-hidden');
        if (input) input.value = '';
    }

    /**
     * Show confirmation modal
     * @param {string} message - The confirmation message
     * @param {Function} onConfirm - Callback when confirmed
     * @param {Object} options - Optional configuration
     */
    window.ramsConfirm = function(message, onConfirm, options = {}) {
        const modal = getModal();
        const titleText = document.getElementById('rams-confirm-title-text');
        const messageEl = document.getElementById('rams-confirm-message');
        const confirmBtn = document.getElementById('rams-confirm-btn');
        const cancelBtn = document.getElementById('rams-confirm-cancel-btn');
        const andonEl = document.getElementById('rams-confirm-andon');
        
        // Set content
        messageEl.textContent = message;
        titleText.textContent = options.title || '{{ 'common.confirm_action'|trans }}';
        confirmBtn.textContent = options.confirmText || '{{ 'common.confirm'|trans }}';
        cancelBtn.textContent = options.cancelText || '{{ 'common.cancel'|trans }}';
        resetPromptState();
        
        // Set variant
        modal.classList.remove('rams-confirm--danger', 'rams-confirm--warning');
        confirmBtn.classList.remove('rams-btn--danger', 'rams-btn--warning', 'rams-btn--primary');
        andonEl.classList.remove('rams-andon--error', 'rams-andon--warning', 'rams-andon--info');
        
        switch (options.variant) {
            case 'danger':
                modal.classList.add('rams-confirm--danger');
                confirmBtn.classList.add('rams-btn--danger');
                andonEl.classList.add('rams-andon--error');
                break;
            case 'warning':
                modal.classList.add('rams-confirm--warning');
                confirmBtn.classList.add('rams-btn--warning');
                andonEl.classList.add('rams-andon--warning');
                break;
            default:
                confirmBtn.classList.add('rams-btn--primary');
                andonEl.classList.add('rams-andon--info');
        }
        
        // Store callbacks
        confirmCallback = onConfirm;
        cancelCallback = options.onCancel || null;
        
        // Remember the element that opened the modal for focus restore
        modal._previousFocus = document.activeElement;
        
        // Show modal
        modal.classList.remove('rams-hidden');
        confirmBtn.focus();
        
        // Trap focus and handle escape
        document.addEventListener('keydown', handleModalKeydown);
    };

    /**
     * Show prompt modal (replaces native prompt()).
     * The confirm callback receives the entered value as its argument.
     * @param {string} message - The prompt message
     * @param {Function} onConfirm - Callback receiving the entered value
     * @param {Object} options - {title, confirmText, cancelText, required, placeholder}
     */
    window.ramsPrompt = function(message, onConfirm, options = {}) {
        const modal = getModal();
        const titleText = document.getElementById('rams-confirm-title-text');
        const messageEl = document.getElementById('rams-confirm-message');
        const confirmBtn = document.getElementById('rams-confirm-btn');
        const cancelBtn = document.getElementById('rams-confirm-cancel-btn');
        const andonEl = document.getElementById('rams-confirm-andon');
        const row = document.getElementById('rams-confirm-input-row');
        const input = document.getElementById('rams-confirm-input');
        const inputLabel = document.getElementById('rams-confirm-input-label');
        
        messageEl.textContent = message;
        titleText.textContent = options.title || '{{ 'common.enter_value'|trans }}';
        confirmBtn.textContent = options.confirmText || '{{ 'common.confirm'|trans }}';
        cancelBtn.textContent = options.cancelText || '{{ 'common.cancel'|trans }}';
        if (inputLabel && options.inputLabel) {
            inputLabel.textContent = options.inputLabel;
        }
        if (input) {
            input.placeholder = options.placeholder || '';
            input.value = options.value !== undefined ? options.value : '';
        }
        
        // Variant: primary
        modal.classList.remove('rams-confirm--danger', 'rams-confirm--warning');
        confirmBtn.classList.remove('rams-btn--danger', 'rams-btn--warning', 'rams-btn--primary');
        andonEl.classList.remove('rams-andon--error', 'rams-andon--warning', 'rams-andon--info');
        confirmBtn.classList.add('rams-btn--primary');
        andonEl.classList.add('rams-andon--info');
        
        promptMode = true;
        confirmCallback = onConfirm;
        cancelCallback = options.onCancel || null;
        promptRequired = options.required !== false;
        
        row.classList.remove('rams-hidden');
        modal._previousFocus = document.activeElement;
        modal.classList.remove('rams-hidden');
        input.focus();
        
        // Enter inside the input confirms the prompt
        input.onkeydown = function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                ramsConfirmAction();
            }
        };
        
        document.addEventListener('keydown', handleModalKeydown);
    };

    let promptRequired = true;

    /**
     * Execute confirm action
     */
    window.ramsConfirmAction = function() {
        const modal = getModal();
        let value = null;
        
        if (promptMode) {
            const input = document.getElementById('rams-confirm-input');
            value = input.value.trim();
            if (promptRequired && value === '') {
                input.setAttribute('aria-invalid', 'true');
                input.classList.add('rams-form__input--error');
                input.focus();
                return;
            }
            input.removeAttribute('aria-invalid');
            input.classList.remove('rams-form__input--error');
        }
        
        modal.classList.add('rams-hidden');
        document.removeEventListener('keydown', handleModalKeydown);
        restoreFocus(modal);
        // Capture BEFORE resetPromptState() clears promptMode — the callback
        // receives the entered VALUE, not undefined (round-8 UI bug fix).
        const wasPrompt = promptMode;
        resetPromptState();
        
        if (confirmCallback) {
            const cb = confirmCallback;
            confirmCallback = null;
            cb(wasPrompt ? value : undefined);
        }
    };
    
    /**
     * Cancel and close modal
     */
    window.ramsConfirmCancel = function() {
        const modal = getModal();
        modal.classList.add('rams-hidden');
        document.removeEventListener('keydown', handleModalKeydown);
        restoreFocus(modal);
        resetPromptState();
        
        if (cancelCallback) {
            const cb = cancelCallback;
            cancelCallback = null;
            cb();
        }
        confirmCallback = null;
    };
    
    /**
     * Return focus to the element that opened the modal
     */
    function restoreFocus(modal) {
        const previous = modal._previousFocus;
        modal._previousFocus = null;
        if (previous && typeof previous.focus === 'function') {
            previous.focus();
        }
    }
    
    /**
     * Handle keyboard events in modal
     */
    function handleModalKeydown(e) {
        if (e.key === 'Escape') {
            ramsConfirmCancel();
            return;
        }
        if (e.key === 'Tab') {
            const modal = getModal();
            const focusables = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
            if (focusables.length === 0) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        }
    }
    
    /**
     * Helper: Confirm form submission
     * Usage: <form onsubmit="return ramsConfirmSubmit(event, 'Delete this item?', {variant: 'danger'})">
     */
    window.ramsConfirmSubmit = function(event, message, options = {}) {
        event.preventDefault();
        const form = event.target;
        
        ramsConfirm(message, function() {
            // Remove the onsubmit to prevent infinite loop
            const originalSubmit = form.onsubmit;
            form.onsubmit = null;
            form.submit();
            form.onsubmit = originalSubmit;
        }, options);
        
        return false;
    };
    
    /**
     * Helper: Confirm link navigation
     * Usage: <a href="..." onclick="return ramsConfirmLink(event, 'Are you sure?')">
     */
    window.ramsConfirmLink = function(event, message, options = {}) {
        event.preventDefault();
        const href = event.currentTarget.href;
        
        ramsConfirm(message, function() {
            window.location.href = href;
        }, options);
        
        return false;
    };
})();
</script>
