{# Notification Bell Component - Sensei-Rams Industrial Design #}

{# Notification Bell Button #}
<button 
    id="notification-bell"
    type="button"
    class="rams-sidebar__nav-link rams-notification__button rams-w-full rams-justify-start rams-relative"
    aria-label="{{ 'notifications.title'|trans }}"
    title="{{ 'notifications.title'|trans }}"
>
    {# Bell Icon #}
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="rams-flex-shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
    </svg>
    
    <span class="rams-flex-1">{{ 'notifications.title'|trans }}</span>

    {# Unread Badge #}
    <span 
        id="notification-badge"
        class="rams-badge rams-badge--danger rams-notification__badge rams-hidden"
    >
        <span id="notification-count">0</span>
    </span>
</button>

{# Notification Dropdown Modal #}
<div 
    id="notification-modal"
    class="rams-notification__modal rams-hidden"
>
    {# Modal Header #}
    <div class="rams-module__header rams-flex rams-items-center rams-justify-between">
        <h3 class="rams-module__title rams-text--sm">{{ 'notifications.title'|trans }}</h3>
        <button 
            type="button"
            id="notification-close"
            class="rams-btn rams-btn--ghost rams-btn--sm"
            aria-label="{{ 'common.close'|trans }}"
        >
            <svg class="rams-btn__icon" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
        </button>
    </div>

    {# Modal Content (Scrollable) #}
    <div id="notification-list" class="rams-module__content rams-flex-1 rams-overflow-auto">
        {# Notifications will be populated here by JavaScript #}
        <div class="rams-p-4 rams-text--center">
            <p class="rams-dymo">{{ 'notifications.no_notifications'|trans }}</p>
        </div>
    </div>

    {# Modal Footer #}
    <div class="rams-module__footer rams-flex rams-items-center rams-justify-end">
        <a 
            href="{{ path('command_center_index') }}"
            class="rams-btn rams-btn--ghost rams-btn--sm"
        >
            {{ 'common.view'|trans }} {{ 'common.all'|trans }}
        </a>
    </div>
</div>

<script>
window.NOTIFICATION_ENDPOINTS = {
    count: '{{ path('command_center_alert_count') }}',
    alerts: '{{ path('command_center_alerts') }}',
    emptyText: '{{ 'notifications.no_notifications'|trans|e('js') }}'
};
</script>

{# Note: Notification component styles are now in sensei-rams.css (Section 50) #}
