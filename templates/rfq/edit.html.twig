{% extends 'base.html.twig' %}

{% block title %}{{ 'rfq.edit.title'|trans }} - {{ safe_company_name(rfq) }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Header #}
    <div class="rams-page-header">
        <div>
            <nav class="rams-breadcrumb rams-mb-2">
                <ol class="rams-breadcrumb__list">
                    <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item"><a href="{{ path('app_rfq_index') }}" class="rams-breadcrumb__link">{{ 'rfq.index.title'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item"><a href="{{ path('app_rfq_show', {id: rfq.id}) }}" class="rams-breadcrumb__link">{{ safe_company_name(rfq) }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'common.edit'|trans }}</li>
                </ol>
            </nav>
            <h1 class="rams-page-title">{{ 'rfq.edit.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ safe_company_name(rfq) }}</p>
        </div>
    </div>

    {# Form Module #}
    <div class="rams-module rams-module--narrow rams-mx-auto">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'rfq.show.details'|trans }}</h2>
        </div>
        <div class="rams-module__content">
            {{ form_start(form, {'attr': {'class': 'rams-form', 'id': 'rfq-form'}}) }}
            
                {# Company & Basic Info #}
                <div class="rams-grid rams-grid--2 rams-gap-4">
                    <div class="rams-form__group rams-grid-span-2">
                        {{ form_label(form.company, 'rfq.fields.company'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.company, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.company) }}
                    </div>

                    <div class="rams-form__group rams-grid-span-2">
                        {{ form_label(form.contact, 'rfq.fields.contact'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.contact, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.contact) }}
                        <p class="rams-form__hint">{{ 'rfq.form.select_contact'|trans }}</p>
                    </div>

                    <div class="rams-form__group">
                        {{ form_label(form.rfqNumber, 'rfq.fields.rfq_number'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.rfqNumber, {'attr': {'class': 'rams-form__input rams-font-mono'}}) }}
                        {{ form_errors(form.rfqNumber) }}
                    </div>

                    <div class="rams-form__group">
                        {{ form_label(form.rfqDate, 'rfq.fields.rfq_date'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.rfqDate, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.rfqDate) }}
                    </div>
                </div>

                {# Type & Status #}
                <div class="rams-grid rams-grid--2 rams-gap-4">
                    <div class="rams-form__group">
                        {{ form_label(form.type, 'rfq.fields.type'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.type, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.type) }}
                        <p class="rams-form__hint">{{ 'rfq.help.type'|trans }}</p>
                    </div>

                    <div class="rams-form__group">
                        {{ form_label(form.status, 'rfq.fields.status'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.status, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.status) }}
                    </div>
                </div>

                {# Financial Details #}
                <div class="rams-grid rams-grid--3 rams-gap-4">
                    <div class="rams-form__group">
                        {{ form_label(form.currency, 'rfq.fields.currency'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.currency, {'attr': {'class': 'rams-form__select rams-font-mono'}}) }}
                        {{ form_errors(form.currency) }}
                    </div>

                    <div class="rams-form__group">
                        {{ form_label(form.estimatedValue, 'rfq.fields.estimated_value'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.estimatedValue, {'attr': {'class': 'rams-form__input rams-font-mono'}}) }}
                        {{ form_errors(form.estimatedValue) }}
                    </div>

                    <div class="rams-form__group">
                        {{ form_label(form.volumeAnnual, 'rfq.fields.annual_volume'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.volumeAnnual, {'attr': {'class': 'rams-form__input rams-font-mono'}}) }}
                        {{ form_errors(form.volumeAnnual) }}
                    </div>
                </div>

                {# SOP Date #}
                <div class="rams-form__group">
                    {{ form_label(form.sopDate, 'rfq.fields.sop_date'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                    {{ form_widget(form.sopDate, {'attr': {'class': 'rams-form__input'}}) }}
                    {{ form_errors(form.sopDate) }}
                    <p class="rams-form__hint">{{ 'rfq.help.sop_date'|trans }}</p>
                </div>

                {# Technical Scope #}
                <div class="rams-form__group">
                    {{ form_label(form.technicalScope, 'rfq.fields.technical_scope'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                    {{ form_widget(form.technicalScope, {'attr': {'class': 'rams-form__textarea', 'rows': 4}}) }}
                    {{ form_errors(form.technicalScope) }}
                    <p class="rams-form__hint">{{ 'rfq.help.technical_scope'|trans }}</p>
                </div>

                {# Notes #}
                <div class="rams-form__group">
                    {{ form_label(form.notes, 'common.notes'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                    {{ form_widget(form.notes, {'attr': {'class': 'rams-form__textarea', 'rows': 3}}) }}
                    {{ form_errors(form.notes) }}
                </div>

                <div class="rams-form__actions">
                    <button type="submit" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        {{ 'rfq.actions.save_changes'|trans }}
                    </button>
                    <a href="{{ path('app_rfq_show', {id: rfq.id}) }}" class="rams-btn rams-btn--ghost">
                        {{ 'common.cancel'|trans }}
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
