{% extends 'base.html.twig' %}

{% block title %}{{ rfq.company.name }} - RFQ - CRM{% endblock %}

{% block body %}
<div class="content-header">
    <div>
        <nav class="text-sm mb-2">
            <a href="{{ path('app_dashboard') }}" class="text-neutral-600 hover:text-neutral-900">Dashboard</a>
            <span class="text-neutral-400 mx-2">/</span>
            <a href="{{ path('app_rfq_index') }}" class="text-neutral-600 hover:text-neutral-900">RFQs</a>
            <span class="text-neutral-400 mx-2">/</span>
            <span class="text-neutral-900">{{ rfq.company.name }}</span>
        </nav>
        <h1 class="page-title">{{ rfq.company.name }}</h1>
    </div>
    <div class="flex gap-2">
        <a href="{{ path('app_rfq_edit', {id: rfq.id}) }}" class="btn-secondary">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="inline-block mr-1">
                <path d="M11 2L14 5L6 13H3V10L11 2Z"/>
            </svg>
            Edit
        </a>
        <form method="post" action="{{ path('app_rfq_delete', {id: rfq.id}) }}" onsubmit="return confirm('Are you sure you want to delete this RFQ?');" class="inline">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rfq.id) }}">
            <button type="submit" class="btn-secondary border-red-200 text-red-700 hover:bg-red-50">
                Delete
            </button>
        </form>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
        {# RFQ Details #}
        <div class="card">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-lg font-semibold text-neutral-900">RFQ Details</h2>
                
                {# Type Badge #}
                {% if rfq.type == 'NPI' %}
                    <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-medium bg-purple-100 text-purple-700">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="mr-1.5">
                            <path d="M8 2L9.5 6.5L14 8L9.5 9.5L8 14L6.5 9.5L2 8L6.5 6.5L8 2Z"/>
                        </svg>
                        NPI
                    </span>
                {% elseif rfq.type == 'Framework Agreement' %}
                    <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-medium bg-blue-100 text-blue-700">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="mr-1.5">
                            <rect x="3" y="3" width="10" height="10" rx="1"/>
                        </svg>
                        Framework Agreement
                    </span>
                {% else %}
                    <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-medium bg-neutral-100 text-neutral-700">
                        Standard RFQ
                    </span>
                {% endif %}
            </div>

            <div class="grid grid-cols-2 gap-6">
                <div>
                    <label class="text-sm text-neutral-500">Company</label>
                    <p class="font-medium text-neutral-900">
                        <a href="{{ path('app_company_show', {id: rfq.company.id}) }}" class="hover:text-blue-600">{{ rfq.company.name }}</a>
                    </p>
                </div>

                {% if rfq.rfqNumber %}
                    <div>
                        <label class="text-sm text-neutral-500">RFQ Number</label>
                        <p class="font-medium text-neutral-900">{{ rfq.rfqNumber }}</p>
                    </div>
                {% endif %}

                {% if rfq.rfqDate %}
                    <div>
                        <label class="text-sm text-neutral-500">RFQ Date</label>
                        <p class="font-medium text-neutral-900">{{ rfq.rfqDate|date('d F Y') }}</p>
                    </div>
                {% endif %}

                <div>
                    <label class="text-sm text-neutral-500">Status</label>
                    <div class="mt-1">
                        {% if rfq.status == 'Won' %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-emerald-100 text-emerald-700">
                                {{ rfq.status }}
                            </span>
                        {% elseif rfq.status == 'Lost' %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-red-100 text-red-700">
                                {{ rfq.status }}
                            </span>
                        {% elseif rfq.status == 'Submitted' %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-amber-100 text-amber-700">
                                {{ rfq.status }}
                            </span>
                        {% elseif rfq.status == 'In Review' %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-blue-100 text-blue-700">
                                {{ rfq.status }}
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-neutral-100 text-neutral-700">
                                {{ rfq.status }}
                            </span>
                        {% endif %}
                    </div>
                </div>

                {% if rfq.estimatedValue %}
                    <div>
                        <label class="text-sm text-neutral-500">Estimated Value</label>
                        <p class="font-semibold text-xl text-emerald-600">€{{ rfq.estimatedValue|number_format(0, '.', ',') }}</p>
                    </div>
                {% endif %}

                {% if rfq.volumeAnnual %}
                    <div>
                        <label class="text-sm text-neutral-500">Annual Volume</label>
                        <p class="font-medium text-neutral-900">{{ rfq.volumeAnnual|number_format(0, '.', ',') }} units/year</p>
                    </div>
                {% endif %}

                {% if rfq.sopDate %}
                    <div>
                        <label class="text-sm text-neutral-500">SOP Date</label>
                        <p class="font-medium text-neutral-900">{{ rfq.sopDate|date('F Y') }}</p>
                    </div>
                {% endif %}

                <div>
                    <label class="text-sm text-neutral-500">Created</label>
                    <p class="font-medium text-neutral-900">{{ rfq.createdAt|date('d F Y, H:i') }}</p>
                </div>
            </div>

            {% if rfq.technicalScope %}
                <div class="mt-6 pt-6 border-t border-neutral-200">
                    <label class="text-sm text-neutral-500 block mb-2">Technical Scope</label>
                    <div class="prose prose-sm max-w-none text-neutral-700">{{ rfq.technicalScope|nl2br }}</div>
                </div>
            {% endif %}

            {% if rfq.notes %}
                <div class="mt-6 pt-6 border-t border-neutral-200">
                    <label class="text-sm text-neutral-500 block mb-2">Notes</label>
                    <div class="prose prose-sm max-w-none text-neutral-700">{{ rfq.notes|nl2br }}</div>
                </div>
            {% endif %}
        </div>

        {# NDA Workflow #}
        <div class="card">
            <h2 class="text-lg font-semibold text-neutral-900 mb-6">NDA Workflow</h2>
            
            <div class="space-y-4">
                {# NDA Pending #}
                <div class="flex items-start gap-4">
                    <div class="mt-1">
                        {% if rfq.ndaSent %}
                            <div class="w-8 h-8 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 8L6 11L13 4"/>
                                </svg>
                            </div>
                        {% else %}
                            <div class="w-8 h-8 bg-neutral-100 text-neutral-400 rounded-full flex items-center justify-center">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="8" cy="8" r="6"/>
                                </svg>
                            </div>
                        {% endif %}
                    </div>
                    <div class="flex-1">
                        <h3 class="font-medium text-neutral-900">NDA Sent</h3>
                        {% if rfq.ndaSent %}
                            <p class="text-sm text-emerald-600">Sent on {{ rfq.ndaDate|date('d F Y') }}</p>
                        {% else %}
                            <p class="text-sm text-neutral-500">NDA has not been sent yet</p>
                            <form method="post" action="{{ path('app_rfq_nda_sent', {id: rfq.id}) }}" class="mt-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('nda_sent' ~ rfq.id) }}">
                                <button type="submit" class="btn-secondary text-sm">
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="inline-block mr-1">
                                        <path d="M2 3L8 8L14 3M2 3V11C2 11.5 2.5 12 3 12H13C13.5 12 14 11.5 14 11V3"/>
                                    </svg>
                                    Mark as Sent
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>

                {# NDA Executed #}
                <div class="flex items-start gap-4">
                    <div class="mt-1">
                        {% if rfq.ndaExecuted %}
                            <div class="w-8 h-8 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 8L6 11L13 4"/>
                                </svg>
                            </div>
                        {% else %}
                            <div class="w-8 h-8 bg-neutral-100 text-neutral-400 rounded-full flex items-center justify-center">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="8" cy="8" r="6"/>
                                </svg>
                            </div>
                        {% endif %}
                    </div>
                    <div class="flex-1">
                        <h3 class="font-medium text-neutral-900">NDA Executed</h3>
                        {% if rfq.ndaExecuted %}
                            <p class="text-sm text-emerald-600">NDA has been signed and executed</p>
                        {% else %}
                            <p class="text-sm text-neutral-500">Awaiting signature and execution</p>
                            {% if rfq.ndaSent %}
                                <form method="post" action="{{ path('app_rfq_nda_executed', {id: rfq.id}) }}" class="mt-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('nda_executed' ~ rfq.id) }}">
                                    <button type="submit" class="btn-secondary text-sm">
                                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="inline-block mr-1">
                                            <path d="M11 2L14 5L6 13H3V10L11 2Z"/>
                                        </svg>
                                        Mark as Executed
                                    </button>
                                </form>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Sidebar #}
    <div class="space-y-6">
        {# Status Update #}
        <div class="card">
            <h3 class="font-semibold text-neutral-900 mb-4">Update Status</h3>
            <form method="post" action="{{ path('app_rfq_update_status', {id: rfq.id}) }}">
                <select name="status" class="w-full px-4 py-2 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 mb-3">
                    <option value="Pending" {% if rfq.status == 'Pending' %}selected{% endif %}>Pending</option>
                    <option value="In Review" {% if rfq.status == 'In Review' %}selected{% endif %}>In Review</option>
                    <option value="Submitted" {% if rfq.status == 'Submitted' %}selected{% endif %}>Submitted</option>
                    <option value="Won" {% if rfq.status == 'Won' %}selected{% endif %}>Won</option>
                    <option value="Lost" {% if rfq.status == 'Lost' %}selected{% endif %}>Lost</option>
                </select>
                <button type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">Update Status</button>
            </form>
        </div>

        {# Quick Actions #}
        <div class="card">
            <h3 class="font-semibold text-neutral-900 mb-4">Quick Actions</h3>
            <div class="space-y-2">
                <a href="{{ path('app_company_show', {id: rfq.company.id}) }}" class="flex items-center gap-2 px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-50 rounded-lg transition-colors">
                    <div class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="10" height="10" rx="1"/>
                        </svg>
                    </div>
                    View Company
                </a>

                <a href="{{ path('app_activity_new', {company: rfq.company.id}) }}" class="flex items-center gap-2 px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-50 rounded-lg transition-colors">
                    <div class="w-8 h-8 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="8" cy="8" r="6"/>
                            <path d="M8 4V8L11 11"/>
                        </svg>
                    </div>
                    Log Activity
                </a>

                <a href="{{ path('app_rfq_pipeline') }}" class="flex items-center gap-2 px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-50 rounded-lg transition-colors">
                    <div class="w-8 h-8 bg-emerald-100 text-emerald-600 rounded-lg flex items-center justify-center">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="3" height="10" rx="1"/>
                            <rect x="6.5" y="3" width="3" height="10" rx="1"/>
                            <rect x="11" y="3" width="3" height="10" rx="1"/>
                        </svg>
                    </div>
                    View Pipeline
                </a>
            </div>
        </div>

        {# RFQ Statistics #}
        {% if rfq.status == 'Won' %}
            <div class="card bg-gradient-to-br from-emerald-50 to-emerald-100/50">
                <div class="text-center">
                    <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mx-auto mb-3">
                        <svg width="24" height="24" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 8L6 11L13 4"/>
                        </svg>
                    </div>
                    <h3 class="font-semibold text-emerald-900 mb-1">RFQ Won!</h3>
                    <p class="text-sm text-emerald-700">Congratulations on winning this opportunity</p>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
