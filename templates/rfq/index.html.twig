{% extends 'base.html.twig' %}

{% block title %}{{ 'rfq.index.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-container">
    {# Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'rfq.index.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'rfq.index.subtitle'|trans }}</p>
        </div>
        <div class="rams-btn-group">
            <a href="{{ path('app_rfq_pipeline') }}" class="rams-btn rams-btn--secondary">
                <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
                </svg>
                {{ 'rfq.actions.pipeline_view'|trans }}
            </a>
            <a href="{{ path('app_rfq_new') }}" class="rams-btn rams-btn--primary">
                <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                {{ 'rfq.actions.new'|trans }}
            </a>
        </div>
    </div>

    {# Filters Module #}
    <div class="rams-module rams-module--filters">
        <div class="rams-module__content">
            <form method="get" class="rams-grid rams-grid--5">
                <div class="rams-form__group">
                    <label class="rams-dymo">{{ 'rfq.fields.type'|trans }}</label>
                    <select name="type" class="rams-form__select">
                        <option value="">{{ 'rfq.filters.all_types'|trans }}</option>
                        <option value="Standard RFQ" {% if app.request.get('type') == 'Standard RFQ' %}selected{% endif %}>{{ 'rfq.type.standard'|trans }}</option>
                        <option value="NPI" {% if app.request.get('type') == 'NPI' %}selected{% endif %}>{{ 'rfq.type.npi'|trans }}</option>
                        <option value="Framework Agreement" {% if app.request.get('type') == 'Framework Agreement' %}selected{% endif %}>{{ 'rfq.type.framework'|trans }}</option>
                    </select>
                </div>
                
                <div class="rams-form__group">
                    <label class="rams-dymo">{{ 'rfq.fields.status'|trans }}</label>
                    <select name="status" class="rams-form__select">
                        <option value="">{{ 'rfq.filters.all_statuses'|trans }}</option>
                        <option value="Pending" {% if app.request.get('status') == 'Pending' %}selected{% endif %}>{{ 'rfq.status.pending'|trans }}</option>
                        <option value="In Review" {% if app.request.get('status') == 'In Review' %}selected{% endif %}>{{ 'rfq.status.in_review'|trans }}</option>
                        <option value="Submitted" {% if app.request.get('status') == 'Submitted' %}selected{% endif %}>{{ 'rfq.status.submitted'|trans }}</option>
                        <option value="Won" {% if app.request.get('status') == 'Won' %}selected{% endif %}>{{ 'rfq.status.won'|trans }}</option>
                        <option value="Lost" {% if app.request.get('status') == 'Lost' %}selected{% endif %}>{{ 'rfq.status.lost'|trans }}</option>
                    </select>
                </div>
                
                <div class="rams-form__group">
                    <label class="rams-dymo">{{ 'rfq.fields.company'|trans }}</label>
                    <select name="company" class="rams-form__select">
                        <option value="">{{ 'rfq.filters.all_companies'|trans }}</option>
                        {# Companies will be populated dynamically #}
                    </select>
                </div>

                <div class="rams-form__group">
                    <label class="rams-dymo">{{ 'rfq.fields.nda_status'|trans }}</label>
                    <select name="nda_status" class="rams-form__select">
                        <option value="">{{ 'common.all'|trans }}</option>
                        <option value="pending" {% if app.request.get('nda_status') == 'pending' %}selected{% endif %}>{{ 'rfq.nda.pending'|trans }}</option>
                        <option value="sent" {% if app.request.get('nda_status') == 'sent' %}selected{% endif %}>{{ 'rfq.nda.sent'|trans }}</option>
                        <option value="executed" {% if app.request.get('nda_status') == 'executed' %}selected{% endif %}>{{ 'rfq.nda.executed'|trans }}</option>
                    </select>
                </div>

                <div class="rams-form__group rams-form__group--actions">
                    <label class="rams-dymo">&nbsp;</label>
                    <div class="rams-btn-group">
                        <button type="submit" class="rams-btn rams-btn--primary">{{ 'common.apply'|trans }}</button>
                        <a href="{{ path('app_rfq_index') }}" class="rams-btn rams-btn--secondary">{{ 'common.clear'|trans }}</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# RFQ List #}
    {% if rfqs|length > 0 %}
        <div class="rams-card-list">
            {% for rfq in rfqs %}
                <div class="rams-module rams-module--hoverable">
                    <div class="rams-module__content">
                        <div class="rams-rfq-card">
                            <div class="rams-rfq-card__main">
                                <div class="rams-rfq-card__header">
                                    <a href="{{ path('app_rfq_show', {id: rfq.id}) }}" class="rams-rfq-card__title">
                                        {{ rfq.company.name }}
                                    </a>
                                    
                                    {# Type Badge #}
                                    {% if rfq.type == 'NPI' %}
                                        <span class="rams-badge rams-badge--npi">
                                            <svg class="rams-mr-1" width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                                                <path d="M8 2L9.5 6.5L14 8L9.5 9.5L8 14L6.5 9.5L2 8L6.5 6.5L8 2Z"/>
                                            </svg>
                                            {{ 'rfq.type.npi'|trans }}
                                        </span>
                                    {% elseif rfq.type == 'Framework Agreement' %}
                                        <span class="rams-badge rams-badge--framework">
                                            <svg class="rams-mr-1" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="3" width="10" height="10" rx="1"/>
                                            </svg>
                                            {{ 'rfq.type.framework'|trans }}
                                        </span>
                                    {% else %}
                                        <span class="rams-badge">{{ 'rfq.type.standard'|trans }}</span>
                                    {% endif %}

                                    {# Status Badge #}
                                    {% if rfq.status == 'Won' %}
                                        <span class="rams-badge rams-badge--success">{{ rfq.status }}</span>
                                    {% elseif rfq.status == 'Lost' %}
                                        <span class="rams-badge rams-badge--error">{{ rfq.status }}</span>
                                    {% elseif rfq.status == 'Submitted' %}
                                        <span class="rams-badge rams-badge--warning">{{ rfq.status }}</span>
                                    {% elseif rfq.status == 'In Review' %}
                                        <span class="rams-badge rams-badge--info">{{ rfq.status }}</span>
                                    {% else %}
                                        <span class="rams-badge">{{ rfq.status }}</span>
                                    {% endif %}
                                </div>

                                <div class="rams-rfq-card__details">
                                    {% if rfq.rfqNumber %}
                                        <div class="rams-rfq-card__detail">
                                            <span class="rams-text--muted">{{ 'rfq.fields.rfq_number'|trans }}:</span>
                                            <span class="rams-text--strong">{{ rfq.rfqNumber }}</span>
                                        </div>
                                    {% endif %}

                                    {% if rfq.estimatedValue %}
                                        <div class="rams-rfq-card__detail">
                                            <span class="rams-text--muted">{{ 'rfq.fields.value'|trans }}:</span>
                                            <span class="rams-metric rams-metric--currency">€{{ rfq.estimatedValue|number_format(0, '.', ',') }}</span>
                                        </div>
                                    {% endif %}

                                    {% if rfq.volumeAnnual %}
                                        <div class="rams-rfq-card__detail">
                                            <span class="rams-text--muted">{{ 'rfq.fields.volume'|trans }}:</span>
                                            <span class="rams-text--strong">{{ rfq.volumeAnnual|number_format(0, '.', ',') }}/{{ 'common.year'|trans }}</span>
                                        </div>
                                    {% endif %}

                                    {% if rfq.sopDate %}
                                        <div class="rams-rfq-card__detail">
                                            <span class="rams-text--muted">{{ 'rfq.fields.sop'|trans }}:</span>
                                            <span class="rams-text--strong">{{ rfq.sopDate|date('M Y') }}</span>
                                        </div>
                                    {% endif %}
                                </div>

                                {# NDA Status #}
                                <div class="rams-rfq-card__nda">
                                    {% if rfq.ndaExecuted %}
                                        <span class="rams-badge rams-badge--success rams-badge--small">
                                            <svg class="rams-mr-1" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M3 8L6 11L13 4"/>
                                            </svg>
                                            {{ 'rfq.nda.executed'|trans }}
                                        </span>
                                    {% elseif rfq.ndaSent %}
                                        <span class="rams-badge rams-badge--warning rams-badge--small">
                                            <svg class="rams-mr-1" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M2 3L8 8L14 3M2 3V11C2 11.5 2.5 12 3 12H13C13.5 12 14 11.5 14 11V3"/>
                                            </svg>
                                            {{ 'rfq.nda.sent'|trans }} ({{ rfq.ndaDate|date('d/m/Y') }})
                                        </span>
                                    {% else %}
                                        <span class="rams-badge rams-badge--small">
                                            <svg class="rams-mr-1" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5V8"/>
                                                <circle cx="8" cy="11" r="0.5" fill="currentColor"/>
                                            </svg>
                                            {{ 'rfq.nda.pending'|trans }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="rams-rfq-card__actions">
                                <a href="{{ path('app_rfq_show', {id: rfq.id}) }}" class="rams-btn rams-btn--ghost rams-btn--icon" title="{{ 'common.view'|trans }}">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M2 8C2 8 4 4 8 4C12 4 14 8 14 8C14 8 12 12 8 12C4 12 2 8 2 8Z"/>
                                        <circle cx="8" cy="8" r="2"/>
                                    </svg>
                                </a>
                                <a href="{{ path('app_rfq_edit', {id: rfq.id}) }}" class="rams-btn rams-btn--ghost rams-btn--icon" title="{{ 'common.edit'|trans }}">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 2L14 5L6 13H3V10L11 2Z"/>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-empty-state">
                    <div class="rams-empty-state__icon-wrapper">
                        <svg width="32" height="32" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="rams-empty-state__icon">
                            <rect x="3" y="3" width="10" height="10" rx="1"/>
                            <path d="M6 7H10M6 10H8"/>
                        </svg>
                    </div>
                    <h3 class="rams-empty-state__title">{{ 'rfq.empty.title'|trans }}</h3>
                    <p class="rams-empty-state__description">{{ 'rfq.empty.description'|trans }}</p>
                    <a href="{{ path('app_rfq_new') }}" class="rams-btn rams-btn--primary">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M8 3V13M3 8H13"/>
                        </svg>
                        {{ 'rfq.actions.new'|trans }}
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
