{% extends 'base.html.twig' %}

{% block title %}Create RFQ - CRM{% endblock %}

{% block body %}
{# Define reusable class variables for maintainability #}
{% set label_class = 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2' %}
{% set input_class = 'w-full px-4 py-2 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500' %}
{% set error_class = 'mt-1 text-xs text-red-600' %}
{% set help_class = 'text-xs text-neutral-500 mt-1' %}

<div class="min-h-screen bg-neutral-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-6">
            <nav class="text-sm mb-2">
                <a href="{{ path('app_dashboard') }}" class="text-neutral-600 hover:text-neutral-900">Dashboard</a>
                <span class="text-neutral-400 mx-2">/</span>
                <a href="{{ path('app_rfq_index') }}" class="text-neutral-600 hover:text-neutral-900">RFQs</a>
                <span class="text-neutral-400 mx-2">/</span>
                <span class="text-neutral-900">New</span>
            </nav>
            <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Create New RFQ</h1>
        </div>

        <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
        {{ form_start(form) }}
        
        <div class="space-y-6">
            {# Company & Basic Info #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="md:col-span-2">
                    {{ form_label(form.company, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.company, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.company, {'attr': {'class': error_class}}) }}
                </div>

                <div>
                    {{ form_label(form.rfqNumber, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.rfqNumber, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.rfqNumber, {'attr': {'class': error_class}}) }}
                </div>

                <div>
                    {{ form_label(form.rfqDate, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.rfqDate, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.rfqDate, {'attr': {'class': error_class}}) }}
                </div>
            </div>

            {# Type & Status #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.type, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.type, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.type, {'attr': {'class': error_class}}) }}
                    <p class="{{ help_class }}">Select NPI for new product introduction or Framework for long-term agreements</p>
                </div>

                <div>
                    {{ form_label(form.status, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.status, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.status, {'attr': {'class': error_class}}) }}
                </div>
            </div>

            {# Financial Details #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.estimatedValue, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.estimatedValue, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.estimatedValue, {'attr': {'class': error_class}}) }}
                </div>

                <div>
                    {{ form_label(form.volumeAnnual, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.volumeAnnual, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.volumeAnnual, {'attr': {'class': error_class}}) }}
                </div>
            </div>

            {# SOP Date #}
            <div>
                {{ form_label(form.sopDate, null, {'label_attr': {'class': label_class}}) }}
                {{ form_widget(form.sopDate, {'attr': {'class': input_class}}) }}
                {{ form_errors(form.sopDate, {'attr': {'class': error_class}}) }}
                <p class="{{ help_class }}">Expected Start of Production date</p>
            </div>

            {# Technical Scope #}
            <div>
                {{ form_label(form.technicalScope, null, {'label_attr': {'class': label_class}}) }}
                {{ form_widget(form.technicalScope, {'attr': {'class': input_class, 'rows': 4}}) }}
                {{ form_errors(form.technicalScope, {'attr': {'class': error_class}}) }}
                <p class="{{ help_class }}">Describe technical requirements, specifications, and scope of work</p>
            </div>

            {# Notes #}
            <div>
                {{ form_label(form.notes, null, {'label_attr': {'class': label_class}}) }}
                {{ form_widget(form.notes, {'attr': {'class': input_class, 'rows': 3}}) }}
                {{ form_errors(form.notes, {'attr': {'class': error_class}}) }}
            </div>
        </div>

            {# Form Actions #}
            <div class="flex items-center gap-3 pt-6 border-t border-neutral-200">
                <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Create RFQ
                </button>
                <a href="{{ path('app_rfq_index') }}" class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">Cancel</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
