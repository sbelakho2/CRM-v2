{% extends 'base.html.twig' %}

{% block title %}{{ 'rfq.pipeline.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    {# Header #}
    <div class="rams-page-header">
        <div class="rams-flex rams-flex-col rams-gap-1">
            <h1 class="rams-page-title">{{ 'rfq.pipeline.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'rfq.pipeline.subtitle'|trans }}</p>
        </div>
        <div class="rams-btn-group">
            <a href="{{ path('app_rfq_index') }}" class="rams-btn">
                <svg class="rams-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 12h18M3 6h18M3 18h18"/>
                </svg>
                {{ 'rfq.actions.list_view'|trans }}
            </a>
            <a href="{{ path('app_rfq_new') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                {{ 'rfq.actions.new'|trans }}
            </a>
        </div>
    </div>

    {# Filters Module #}
    <div class="rams-module rams-mb-6">
        <div class="rams-module__content">
            <form method="get" class="rams-grid rams-grid--4 rams-gap-4 rams-items-end">
                <div class="rams-form__group">
                    <label class="rams-metric__label">{{ 'rfq.form.rfq_type'|trans }}</label>
                    <select name="type" class="rams-form__select">
                        <option value="">{{ 'common.all'|trans }}</option>
                        <option value="Standard RFQ" {% if app.request.get('type') == 'Standard RFQ' %}selected{% endif %}>{{ 'rfq.types.standard'|trans }}</option>
                        <option value="NPI" {% if app.request.get('type') == 'NPI' %}selected{% endif %}>{{ 'rfq.types.npi'|trans }}</option>
                        <option value="Framework Agreement" {% if app.request.get('type') == 'Framework Agreement' %}selected{% endif %}>{{ 'rfq.types.framework'|trans }}</option>
                    </select>
                </div>
                
                <div class="rams-form__group">
                    <label class="rams-metric__label">{{ 'rfq.company'|trans }}</label>
                    <select name="company" class="rams-form__select">
                        <option value="">{{ 'common.all'|trans }}</option>
                        {% for company in companies %}
                            <option value="{{ company.id }}" {% if app.request.get('company') == company.id %}selected{% endif %}>{{ company.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="rams-btn-group">
                    <button type="submit" class="rams-btn rams-btn--primary">{{ 'common.apply'|trans }}</button>
                    <a href="{{ path('app_rfq_pipeline') }}" class="rams-btn">{{ 'common.clear'|trans }}</a>
                </div>
            </form>
        </div>
    </div>

    {# Kanban Board #}
    <div class="rams-kanban">
        {% set stages = [
            {'key': 'Pending', 'class': 'pending', 'label': 'rfq.status.pending'|trans, 'andon': 'rams-andon--info'},
            {'key': 'In Review', 'class': 'in-review', 'label': 'rfq.status.in_review'|trans, 'andon': 'rams-andon--info'},
            {'key': 'Submitted', 'class': 'submitted', 'label': 'rfq.status.submitted'|trans, 'andon': 'rams-andon--warning'},
            {'key': 'Won', 'class': 'won', 'label': 'rfq.status.won'|trans, 'andon': 'rams-andon--success'},
            {'key': 'Lost', 'class': 'lost', 'label': 'rfq.status.lost'|trans, 'andon': 'rams-andon--error'}
        ] %}

        {% for stage in stages %}
            <div class="rams-kanban__column rams-kanban__column--{{ stage.class }}">
                <div class="rams-kanban__header">
                    <div class="rams-flex rams-items-center rams-gap-2">
                        <span class="rams-andon {{ stage.andon }}"><span class="rams-andon__light"></span></span>
                        <h3 class="rams-kanban__title">{{ stage.label }}</h3>
                    </div>
                    <span class="rams-badge">{{ pipeline[stage.key]|default([])|length }}</span>
                </div>
                
                <div class="rams-kanban__cards">
                    {% for rfq in pipeline[stage.key]|default([]) %}
                        <a href="{{ path('app_rfq_show', {id: rfq.id}) }}" class="rams-kanban__card {{ stage.class == 'won' ? 'rams-kanban__card--success' : (stage.class == 'lost' ? 'rams-kanban__card--danger' : '') }}">
                            <div class="rams-kanban__card-header">
                                <h4 class="rams-kanban__card-title">{{ rfq.company.name }}</h4>
                            </div>
                            
                            <div class="rams-kanban__card-meta">
                                {{ rfq.rfqNumber|default('NO-NUMBER') }}
                            </div>

                            <div class="rams-grid rams-grid--1 rams-gap-2 rams-mt-2">
                                <div class="rams-metric">
                                    <span class="rams-metric__label">{{ 'rfq.estimated_value'|trans }}</span>
                                    <span class="rams-metric__value rams-metric__value--sm">
                                        {{ rfq.estimatedValue ? rfq.estimatedValue|format_currency(rfq.currency, null, 0) : '--' }}
                                    </span>
                                </div>
                                
                                <div class="rams-flex rams-flex-wrap rams-gap-1 rams-mt-1">
                                    {% if rfq.type == 'NPI' %}
                                        <span class="rams-badge rams-badge--npi rams-badge--xs">NPI</span>
                                    {% elseif rfq.type == 'Framework Agreement' %}
                                        <span class="rams-badge rams-badge--framework rams-badge--xs">FWA</span>
                                    {% endif %}

                                    {% if rfq.ndaExecuted %}
                                        <span class="rams-badge rams-badge--success rams-badge--xs">NDA</span>
                                    {% elseif rfq.ndaSent %}
                                        <span class="rams-badge rams-badge--warning rams-badge--xs">NDA SENT</span>
                                    {% endif %}
                                    
                                    {% if rfq.sopDate and stage.key == 'Won' %}
                                        <span class="rams-badge rams-badge--info rams-badge--xs">SOP: {{ rfq.sopDate|date('M Y') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    {% else %}
                        <div class="rams-kanban__empty">
                            {{ ('rfq.pipeline.no_' ~ stage.key|lower|replace({' ': '_'}))|trans }}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
