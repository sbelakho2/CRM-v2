{% extends 'base_login.html.twig' %}

{% block title %}{{ success ? 'email_unsubscribe.success_title'|trans : 'email_unsubscribe.error_title'|trans }}{% endblock %}

{% block body %}
<div class="rams-module rams-module--inset" style="max-width: 480px; margin: 48px auto;">
    <div class="rams-module__header">
        <h1 class="rams-module__title">{{ success ? 'email_unsubscribe.success_title'|trans : 'email_unsubscribe.error_title'|trans }}</h1>
    </div>
    <div class="rams-module__content">
        <div class="rams-alert rams-alert--{{ success ? 'success' : 'error' }} rams-mb-4" role="status">
            <div class="rams-alert__content">
                {{ message == 'email_unsubscribe.success' ? 'email_unsubscribe.success'|trans({}, 'messages') : message|trans }}
                {% if email is defined and email %}<br><strong>{{ email }}</strong>{% endif %}
            </div>
        </div>
        <p class="rams-text--muted">{{ 'email_unsubscribe.footer_note'|trans }}</p>
    </div>
</div>
{% endblock %}
