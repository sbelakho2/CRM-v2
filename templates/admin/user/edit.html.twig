{% extends 'base.html.twig' %}

{% block title %}{{ 'administration.users.edit_user'|trans }} - {{ 'administration.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <nav class="rams-breadcrumb rams-mb-2">
                <ol class="rams-breadcrumb__list">
                    <li class="rams-breadcrumb__item"><a href="{{ path('admin_user_index') }}" class="rams-breadcrumb__link">{{ 'administration.users.title'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'administration.users.edit_user'|trans }}</li>
                </ol>
            </nav>
            <h1 class="rams-page-title">{{ 'administration.users.edit_user'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'administration.users.edit_user_subtitle'|trans }}</p>
        </div>
    </div>

    {# Form Card #}
    <div class="rams-module rams-module--narrow rams-mx-auto">
        <div class="rams-module__content">
            {{ form_start(form, {'attr': {'class': 'rams-form'}}) }}
            
            <div class="rams-grid rams-grid--2">
                <div class="rams-form__group">
                    {{ form_label(form.firstName, 'administration.users.first_name'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                    {{ form_widget(form.firstName, {'attr': {'class': 'rams-form__input'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>

                <div class="rams-form__group">
                    {{ form_label(form.lastName, 'administration.users.last_name'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                    {{ form_widget(form.lastName, {'attr': {'class': 'rams-form__input'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>
            </div>

            <div class="rams-form__group">
                {{ form_label(form.email, 'administration.users.email'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'rams-form__input'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="rams-form__group">
                {{ form_label(form.roles, 'administration.users.role'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                {{ form_widget(form.roles, {'attr': {'class': 'rams-form__select'}}) }}
                {{ form_errors(form.roles) }}
            </div>

            <div class="rams-form__group">
                <div class="rams-form__checkbox">
                    {{ form_widget(form.active, {'attr': {'class': 'rams-form__checkbox-input'}}) }}
                    {{ form_label(form.active, 'administration.users.active'|trans, {'label_attr': {'class': 'rams-form__checkbox-label'}}) }}
                </div>
                {{ form_errors(form.active) }}
            </div>

            <div class="rams-form__actions">
                <button type="submit" class="rams-btn rams-btn--primary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {{ 'administration.users.save_changes'|trans }}
                </button>
                <a href="{{ path('admin_user_index') }}" class="rams-btn rams-btn--ghost">{{ 'common.cancel'|trans }}</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
