{% extends 'base.html.twig' %}

{% block title %}New User - Admin{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Create New User</h1>
        <p class="text-muted">Add a new user to the system</p>
    </div>
</div>

<!-- Form Card -->
<div class="card" style="max-width: 800px;">
    {{ form_start(form) }}
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div class="form-group">
            {{ form_label(form.firstName) }}
            {{ form_widget(form.firstName, {'attr': {'class': 'geist-input'}}) }}
            {{ form_errors(form.firstName) }}
        </div>

        <div class="form-group">
            {{ form_label(form.lastName) }}
            {{ form_widget(form.lastName, {'attr': {'class': 'geist-input'}}) }}
            {{ form_errors(form.lastName) }}
        </div>
    </div>

    <div class="form-group">
        {{ form_label(form.email) }}
        {{ form_widget(form.email, {'attr': {'class': 'geist-input'}}) }}
        {{ form_errors(form.email) }}
    </div>

    {% if form.plainPassword is defined %}
    <div class="form-group">
        {{ form_label(form.plainPassword, 'Password') }}
        {{ form_widget(form.plainPassword, {'attr': {'class': 'geist-input'}}) }}
        {{ form_errors(form.plainPassword) }}
        <small class="text-muted">Minimum 6 characters</small>
    </div>
    {% endif %}

    <div class="form-group">
        {{ form_label(form.roles) }}
        {{ form_widget(form.roles, {'attr': {'class': 'geist-select'}}) }}
        {{ form_errors(form.roles) }}
    </div>

    <div class="form-group">
        <label class="flex items-center gap-2">
            {{ form_widget(form.active) }}
            <span>Active</span>
        </label>
        {{ form_errors(form.active) }}
    </div>

    <div class="flex items-center gap-3 mt-6">
        <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Create User
        </button>
        <a href="{{ path('admin_user_index') }}" class="inline-flex items-center gap-2 px-5 py-2.5 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">Cancel</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
