{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.users.new_user'|trans }} - {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <!-- Header -->
    <div class="rams-page-header">
        <h1 class="rams-page-title">{{ 'admin.users.new_user'|trans }}</h1>
        <p class="rams-page-subtitle">{{ 'admin.users.new_user_subtitle'|trans }}</p>
    </div>

    <!-- Form Card -->
    <div class="rams-module" style="max-width: 800px;">
        <div class="rams-module__content">
            {{ form_start(form, {'attr': {'class': 'rams-form'}}) }}
            
            <div class="rams-grid rams-grid--2">
                <div class="rams-form-group">
                    {{ form_label(form.firstName, 'admin.users.first_name'|trans, {'label_attr': {'class': 'rams-label'}}) }}
                    {{ form_widget(form.firstName, {'attr': {'class': 'rams-input'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>

                <div class="rams-form-group">
                    {{ form_label(form.lastName, 'admin.users.last_name'|trans, {'label_attr': {'class': 'rams-label'}}) }}
                    {{ form_widget(form.lastName, {'attr': {'class': 'rams-input'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>
            </div>

            <div class="rams-form-group">
                {{ form_label(form.email, 'admin.users.email'|trans, {'label_attr': {'class': 'rams-label'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'rams-input'}}) }}
                {{ form_errors(form.email) }}
            </div>

            {% if form.plainPassword is defined %}
            <div class="rams-form-group">
                {{ form_label(form.plainPassword, 'admin.users.password'|trans, {'label_attr': {'class': 'rams-label'}}) }}
                {{ form_widget(form.plainPassword, {'attr': {'class': 'rams-input'}}) }}
                {{ form_errors(form.plainPassword) }}
                <small class="rams-text-muted">{{ 'admin.users.password_hint'|trans }}</small>
            </div>
            {% endif %}

            <div class="rams-form-group">
                {{ form_label(form.roles, 'admin.users.role'|trans, {'label_attr': {'class': 'rams-label'}}) }}
                {{ form_widget(form.roles, {'attr': {'class': 'rams-select'}}) }}
                {{ form_errors(form.roles) }}
            </div>

            <div class="rams-form-group">
                <label class="rams-checkbox">
                    {{ form_widget(form.active, {'attr': {'class': 'rams-checkbox__input'}}) }}
                    <span class="rams-checkbox__label">{{ 'admin.users.active'|trans }}</span>
                </label>
                {{ form_errors(form.active) }}
            </div>

            <div class="rams-module__footer">
                <button type="submit" class="rams-btn rams-btn--primary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {{ 'admin.users.create_user'|trans }}
                </button>
                <a href="{{ path('admin_user_index') }}" class="rams-btn rams-btn--ghost">{{ 'common.cancel'|trans }}</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
