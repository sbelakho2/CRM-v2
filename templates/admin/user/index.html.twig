{% extends 'base.html.twig' %}

{% block title %}Users - Admin{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Users Management</h1>
        <p class="text-muted">Manage system users and their permissions</p>
    </div>
    <div>
        <a href="{{ path('admin_user_new') }}" class="btn">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 3V13M3 8H13"/>
            </svg>
            New User
        </a>
    </div>
</div>

<!-- Search and Filters -->
<div class="card mb-4">
    <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
            <label for="search" class="block text-sm font-medium mb-2">Search</label>
            <input type="text" 
                   id="search" 
                   name="search" 
                   value="{{ app.request.query.get('search') }}"
                   placeholder="Name or email..."
                   class="geist-input">
        </div>
        
        <div>
            <label for="role" class="block text-sm font-medium mb-2">Role</label>
            <select id="role" name="role" class="geist-select">
                <option value="">All Roles</option>
                <option value="ROLE_ADMIN" {% if app.request.query.get('role') == 'ROLE_ADMIN' %}selected{% endif %}>Admin</option>
                <option value="ROLE_USER" {% if app.request.query.get('role') == 'ROLE_USER' %}selected{% endif %}>User</option>
                <option value="ROLE_SALES" {% if app.request.query.get('role') == 'ROLE_SALES' %}selected{% endif %}>Sales</option>
            </select>
        </div>
        
        <div>
            <label for="status" class="block text-sm font-medium mb-2">Status</label>
            <select id="status" name="status" class="geist-select">
                <option value="">All</option>
                <option value="active" {% if app.request.query.get('status') == 'active' %}selected{% endif %}>Active</option>
                <option value="inactive" {% if app.request.query.get('status') == 'inactive' %}selected{% endif %}>Inactive</option>
            </select>
        </div>
        
        <div class="flex items-end gap-2">
            <button type="submit" class="btn flex-1">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="7" cy="7" r="4"/>
                    <path d="M11 11L14 14"/>
                </svg>
                Filter
            </button>
            <a href="{{ path('admin_user_index') }}" class="btn-secondary">Clear</a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="card">
    <table class="w-full table-auto">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>
                        <div class="font-medium">{{ user.firstName }} {{ user.lastName }}</div>
                    </td>
                    <td>
                        <a href="mailto:{{ user.email }}" class="text-purple-600 hover:underline">
                            {{ user.email }}
                        </a>
                    </td>
                    <td>
                        {% for role in user.roles %}
                            <span class="badge badge-primary mr-1">
                                {{ role|replace({'ROLE_': ''}) }}
                            </span>
                        {% endfor %}
                    </td>
                    <td>
                        {% if user.isActive() %}
                            <span class="badge badge-success">Active</span>
                        {% else %}
                            <span class="badge">Inactive</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="flex gap-2">
                            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn-sm btn-secondary">
                                Edit
                            </a>
                            <form action="{{ path('admin_user_delete', {id: user.id}) }}" method="post" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ user.id) }}">
                                <button type="submit" 
                                        onclick="return confirm('Are you sure you want to delete this user?')" 
                                        class="btn-sm text-red-600 border-red-600 hover:bg-red-50">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-8">
                        No users found. 
                        <a href="{{ path('admin_user_new') }}" class="text-purple-600 hover:underline">Create the first user</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
