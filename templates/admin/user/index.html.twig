{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.users.title'|trans }} - {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-4">
    {# Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'admin.users.title'|trans }}</h1>
            <p class="rams-text-muted">{{ 'admin.users.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('admin_user_new') }}" class="rams-btn rams-btn--primary">
            <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 2v12M2 8h12"/>
            </svg>
            {{ 'admin.users.new_user'|trans }}
        </a>
    </div>

    {# Search and Filters #}
    <div class="rams-module">
        <div class="rams-module__content">
            <form method="get" class="rams-grid rams-grid--4">
                <div class="rams-form__group">
                    <label for="search" class="rams-form__label">{{ 'common.search'|trans }}</label>
                    <input type="text" 
                           id="search" 
                           name="search" 
                           value="{{ app.request.query.get('search') }}"
                           placeholder="{{ 'admin.users.search_placeholder'|trans }}"
                           class="rams-form__input">
                </div>
                
                <div class="rams-form__group">
                    <label for="role" class="rams-form__label">{{ 'admin.users.role'|trans }}</label>
                    <select id="role" name="role" class="rams-form__select">
                        <option value="">{{ 'admin.users.all_roles'|trans }}</option>
                        <option value="ROLE_ADMIN" {% if app.request.query.get('role') == 'ROLE_ADMIN' %}selected{% endif %}>{{ 'admin.users.roles.admin'|trans }}</option>
                        <option value="ROLE_USER" {% if app.request.query.get('role') == 'ROLE_USER' %}selected{% endif %}>{{ 'admin.users.roles.user'|trans }}</option>
                        <option value="ROLE_SALES" {% if app.request.query.get('role') == 'ROLE_SALES' %}selected{% endif %}>{{ 'admin.users.roles.sales'|trans }}</option>
                    </select>
                </div>
                
                <div class="rams-form__group">
                    <label for="status" class="rams-form__label">{{ 'admin.users.status'|trans }}</label>
                    <select id="status" name="status" class="rams-form__select">
                        <option value="">{{ 'common.all'|trans }}</option>
                        <option value="active" {% if app.request.query.get('status') == 'active' %}selected{% endif %}>{{ 'admin.users.active'|trans }}</option>
                        <option value="inactive" {% if app.request.query.get('status') == 'inactive' %}selected{% endif %}>{{ 'admin.users.inactive'|trans }}</option>
                    </select>
                </div>
                
                <div class="rams-form__group rams-form__group--actions">
                    <button type="submit" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="7" cy="7" r="4"/>
                            <path d="M11 11L14 14"/>
                        </svg>
                        {{ 'common.filter'|trans }}
                    </button>
                    <a href="{{ path('admin_user_index') }}" class="rams-btn rams-btn--ghost">{{ 'common.clear'|trans }}</a>
                </div>
            </form>
        </div>
    </div>

    {# Users Table #}
    <div class="rams-module">
        <table class="rams-table">
            <thead class="rams-table__header">
                <tr>
                    <th class="rams-table__cell">{{ 'common.name'|trans }}</th>
                    <th class="rams-table__cell">{{ 'admin.users.email'|trans }}</th>
                    <th class="rams-table__cell">{{ 'admin.users.role'|trans }}</th>
                    <th class="rams-table__cell">{{ 'admin.users.status'|trans }}</th>
                    <th class="rams-table__cell">{{ 'common.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr class="rams-table__row">
                        <td class="rams-table__cell">
                            <span class="rams-text-bold">{{ user.firstName }} {{ user.lastName }}</span>
                        </td>
                        <td class="rams-table__cell">
                            <a href="mailto:{{ user.email }}" class="rams-link">{{ user.email }}</a>
                        </td>
                        <td class="rams-table__cell">
                            {% for role in user.roles %}
                                <span class="rams-badge rams-badge--info">{{ role|replace({'ROLE_': ''}) }}</span>
                            {% endfor %}
                        </td>
                        <td class="rams-table__cell">
                            {% if user.isActive() %}
                                <span class="rams-badge rams-badge--success">{{ 'admin.users.active'|trans }}</span>
                            {% else %}
                                <span class="rams-badge rams-badge--neutral">{{ 'admin.users.inactive'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="rams-table__cell">
                            <div class="rams-btn-group">
                                <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.edit'|trans }}</a>
                                <form action="{{ path('admin_user_delete', {id: user.id}) }}" method="post" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ user.id) }}">
                                    <button type="submit" 
                                            onclick="return confirm('{{ 'admin.users.delete_confirm'|trans }}')" 
                                            class="rams-btn rams-btn--danger-outline rams-btn--sm">
                                        {{ 'common.delete'|trans }}
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="rams-table__cell rams-text-center rams-text-muted">
                            {{ 'admin.users.no_users'|trans }} 
                            <a href="{{ path('admin_user_new') }}" class="rams-link">{{ 'admin.users.create_first'|trans }}</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
