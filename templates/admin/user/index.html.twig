{% extends 'base.html.twig' %}

{% block title %}Users - Admin{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-neutral-200/80 pb-5 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Users Management</h1>
            <p class="mt-1 text-sm text-neutral-600">Manage system users and their permissions</p>
        </div>
        <a href="{{ path('admin_user_new') }}" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New User
        </a>
    </div>
</div>

<!-- Search and Filters -->
<div class="rounded-xl border border-neutral-200/60 bg-white p-5 mb-6">
    <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
            <label for="search" class="block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2">Search</label>
            <input type="text" 
                   id="search" 
                   name="search" 
                   value="{{ app.request.query.get('search') }}"
                   placeholder="Name or email..."
                   class="w-full px-4 py-2 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
        </div>
        
        <div>
            <label for="role" class="block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2">Role</label>
            <select id="role" name="role" class="w-full px-4 py-2 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                <option value="">All Roles</option>
                <option value="ROLE_ADMIN" {% if app.request.query.get('role') == 'ROLE_ADMIN' %}selected{% endif %}>Admin</option>
                <option value="ROLE_USER" {% if app.request.query.get('role') == 'ROLE_USER' %}selected{% endif %}>User</option>
                <option value="ROLE_SALES" {% if app.request.query.get('role') == 'ROLE_SALES' %}selected{% endif %}>Sales</option>
            </select>
        </div>
        
        <div>
            <label for="status" class="block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2">Status</label>
            <select id="status" name="status" class="w-full px-4 py-2 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                <option value="">All</option>
                <option value="active" {% if app.request.query.get('status') == 'active' %}selected{% endif %}>Active</option>
                <option value="inactive" {% if app.request.query.get('status') == 'inactive' %}selected{% endif %}>Inactive</option>
            </select>
        </div>
        
        <div class="flex items-end gap-2">
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50 flex-1 justify-center">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="7" cy="7" r="4"/>
                    <path d="M11 11L14 14"/>
                </svg>
                Filter
            </button>
            <a href="{{ path('admin_user_index') }}" class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">Clear</a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="rounded-xl border border-neutral-200/60 bg-white overflow-hidden">
    <table class="w-full">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>
                        <div class="font-medium">{{ user.firstName }} {{ user.lastName }}</div>
                    </td>
                    <td>
                        <a href="mailto:{{ user.email }}" class="text-purple-600 hover:underline">
                            {{ user.email }}
                        </a>
                    </td>
                    <td>
                        {% for role in user.roles %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mr-1">
                                {{ role|replace({'ROLE_': ''}) }}
                            </span>
                        {% endfor %}
                    </td>
                    <td>
                        {% if user.isActive() %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Inactive</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="flex gap-2">
                            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="text-sm text-blue-600 hover:text-blue-800">
                                Edit
                            </a>
                            <form action="{{ path('admin_user_delete', {id: user.id}) }}" method="post" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ user.id) }}">
                                <button type="submit" 
                                        onclick="return confirm('Are you sure you want to delete this user?')" 
                                        class="text-sm text-red-600 hover:text-red-800">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-neutral-600 py-8">
                        No users found. 
                        <a href="{{ path('admin_user_new') }}" class="text-blue-600 hover:underline">Create the first user</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
