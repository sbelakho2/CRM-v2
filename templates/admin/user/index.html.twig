{% extends 'base.html.twig' %}

{% block title %}{{ 'administration.users.title'|trans }} - {{ 'administration.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'administration.users.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'administration.users.subtitle'|trans }}</p>
        </div>
        <div class="rams-page-actions mobile-stack">
            <a href="{{ path('admin_user_new') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 2v12M2 8h12"/>
                </svg>
                {{ 'administration.users.create_user'|trans }}
            </a>
        </div>
    </div>

    {# Search and Filters #}
    <div class="rams-module">
        <div class="rams-module__content">
            <form method="get" class="rams-form rams-grid rams-grid--4 mobile-stack">
                <div class="rams-form__group">
                    <label for="search" class="rams-form__label rams-dymo">{{ 'common.search'|trans }}</label>
                    <input type="text" 
                           id="search" 
                           name="search" 
                           value="{{ app.request.query.get('search') }}"
                           placeholder="{{ 'administration.users.search_placeholder'|trans }}"
                           class="rams-form__input">
                </div>
                
                <div class="rams-form__group">
                    <label for="role" class="rams-form__label rams-dymo">{{ 'administration.users.role'|trans }}</label>
                    <select id="role" name="role" class="rams-form__select">
                        <option value="">{{ 'administration.users.all_roles'|trans }}</option>
                        <option value="ROLE_ADMIN" {% if app.request.query.get('role') == 'ROLE_ADMIN' %}selected{% endif %}>{{ 'administration.users.roles.admin'|trans }}</option>
                        <option value="ROLE_SALES_OPS" {% if app.request.query.get('role') == 'ROLE_SALES_OPS' %}selected{% endif %}>{{ 'administration.users.roles.sales_ops'|trans }}</option>
                        <option value="ROLE_DIGITAL_REP" {% if app.request.query.get('role') == 'ROLE_DIGITAL_REP' %}selected{% endif %}>{{ 'administration.users.roles.digital_rep'|trans }}</option>
                        <option value="ROLE_FIELD_REP" {% if app.request.query.get('role') == 'ROLE_FIELD_REP' %}selected{% endif %}>{{ 'administration.users.roles.field_rep'|trans }}</option>
                        <option value="ROLE_MANAGER" {% if app.request.query.get('role') == 'ROLE_MANAGER' %}selected{% endif %}>{{ 'administration.users.roles.manager'|trans }}</option>
                        <option value="ROLE_SALES" {% if app.request.query.get('role') == 'ROLE_SALES' %}selected{% endif %}>{{ 'administration.users.roles.sales'|trans }}</option>
                        <option value="ROLE_ENGINEERING" {% if app.request.query.get('role') == 'ROLE_ENGINEERING' %}selected{% endif %}>{{ 'administration.users.roles.engineering'|trans }}</option>
                        <option value="ROLE_USER" {% if app.request.query.get('role') == 'ROLE_USER' %}selected{% endif %}>{{ 'administration.users.roles.user'|trans }}</option>
                        <option value="ROLE_VIEWER" {% if app.request.query.get('role') == 'ROLE_VIEWER' %}selected{% endif %}>{{ 'administration.users.roles.viewer'|trans }}</option>
                    </select>
                </div>
                
                <div class="rams-form__group">
                    <label for="status" class="rams-form__label rams-dymo">{{ 'administration.users.status'|trans }}</label>
                    <select id="status" name="status" class="rams-form__select">
                        <option value="">{{ 'common.all'|trans }}</option>
                        <option value="active" {% if app.request.query.get('status') == 'active' %}selected{% endif %}>{{ 'administration.users.active'|trans }}</option>
                        <option value="inactive" {% if app.request.query.get('status') == 'inactive' %}selected{% endif %}>{{ 'administration.users.inactive'|trans }}</option>
                    </select>
                </div>
                
                <div class="rams-form__group rams-form__group--actions">
                    <button type="submit" class="rams-btn rams-w-full">
                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="7" cy="7" r="4"/>
                            <path d="M11 11L14 14"/>
                        </svg>
                        {{ 'common.filter'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Users Table #}
    <div class="rams-module">
        <div class="rams-table-container">
            <table class="rams-table">
                <caption class="rams-sr-only">{{ 'administration.users.title'|trans }}</caption>
                <thead>
                    <tr>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'common.name'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'administration.users.email'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'administration.users.role'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'administration.users.status'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="rams-table__row">
                            <td class="rams-table__cell">
                                <span class="rams-text--bold">{{ user.firstName }} {{ user.lastName }}</span>
                            </td>
                            <td class="rams-table__cell">
                                <a href="mailto:{{ user.email }}" class="rams-link rams-text--xs">{{ user.email }}</a>
                            </td>
                            <td class="rams-table__cell">
                                <div class="rams-flex rams-flex-wrap rams-gap-1">
                                    {% for role in user.roles %}
                                        <span class="rams-badge rams-badge--info">{{ role|replace({'ROLE_': ''}) }}</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="rams-table__cell">
                                {% set userIsActive = user.isActive() %}
                                {% set userStatusKey = userIsActive ? 'administration.users.active' : 'administration.users.inactive' %}
                                <div class="rams-andon">
                                    <span class="rams-andon__light rams-andon__light--{{ userIsActive ? 'green' : '' }}"></span>
                                    <span class="rams-andon__text">{{ userStatusKey|trans }}</span>
                                </div>
                            </td>
                            <td class="rams-table__cell rams-table__cell--actions">
                                <div class="rams-btn-group mobile-stack">
                                    <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.edit'|trans }}</a>
                                    <form action="{{ path('admin_user_delete', {id: user.id}) }}" method="post" class="rams-inline-block" onsubmit="return ramsConfirmSubmit(event, '{{ 'administration.users.delete_confirm'|trans }}', {variant: 'danger'})">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ user.id) }}">
                                        <button type="submit" 
                                                class="rams-btn rams-btn--ghost rams-btn--sm rams-btn--danger">
                                            {{ 'common.delete'|trans }}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="rams-table__cell">
                                <div class="rams-empty-state">
                                    <h2 class="rams-empty-state__title">{{ 'administration.users.no_users'|trans }}</h2>
                                    <a href="{{ path('admin_user_new') }}" class="rams-link">{{ 'administration.users.create_first'|trans }}</a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
