{% extends 'base.html.twig' %}

{% block title %}{{ currentDate|date('l, F j, Y') }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-3"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                 {{ currentDate|date('l, F j, Y') }}
            </h1>
             <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('calendar_index') }}" class="rams-breadcrumb__item">{{ 'calendar.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ 'calendar.day_view'|trans }}</span>
            </nav>
        </div>
           <div class="rams-page-header__actions mobile-stack">
               <div class="rams-btn-group mobile-stack">
                <a href="{{ path('calendar_day', {date: prevDate|date('Y-m-d')}) }}" class="rams-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </a>
                <a href="{{ path('calendar_day', {date: 'today'}) }}" class="rams-btn">{{ 'calendar.today'|trans }}</a>
                <a href="{{ path('calendar_day', {date: nextDate|date('Y-m-d')}) }}" class="rams-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </div>
             <a href="{{ path('calendar_new', {start: currentDate|date('Y-m-d 09:00')}) }}" class="rams-btn rams-btn--orange rams-ml-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                {{ 'calendar.add_event'|trans }}
            </a>
        </div>
    </div>

    <div class="rams-page-content">
        <div class="rams-grid">
            <div class="rams-grid-col-1">
                <!-- All Day Events -->
                 {% if allDayEvents is defined and allDayEvents|length > 0 %}
                <div class="rams-module rams-mb-4">
                    <div class="rams-module__header">
                        <h3>{{ 'calendar.all_day'|trans }}</h3>
                    </div>
                    <div class="rams-module__content rams-p-2">
                        {% for event in allDayEvents %}
                            <a href="{{ path('calendar_show', {id: event.id}) }}" class="block rams-p-2 rams-mb-1 rams-rounded rams-bg-panel rams-border rams-text--sm rams-font-medium">
                                {{ event.title }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <!-- Timeline -->
                <div class="rams-module">
                    <div class="rams-module__content rams-p-0">
                         <!-- Simple Grid for Timeline -->
                         {% for hour in 6..22 %}
                         <div style="display: grid; grid-template-columns: 80px 1fr; border-bottom: 1px solid var(--rams-border); min-height: 4rem;">
                             <div style="padding: 1rem; text-align: right; color: var(--rams-text--muted); font-size: 0.875rem; border-right: 1px solid var(--rams-border);">
                                 {{ '%02d'|format(hour) }}:00
                             </div>
                             <div style="padding: 0.5rem; position: relative;">
                                  <!-- Slots for events in this hour -->
                                  {% for event in events %}
                                     {% if event.start|date('H') == hour and not event.allDay %}
                                        <a href="{{ path('calendar_show', {id: event.id}) }}" 
                                           class="block rams-p-2 rams-mb-1 rams-rounded rams-bg-module rams-border rams-text--sm "
                                           style="border-left: 4px solid rgba(0,0,0,0.2);">
                                           <div class="rams-text--bold">{{ event.title }}</div>
                                           <div class="rams-text--xs opacity-75">{{ event.start|date('H:i') }} - {{ event.end|date('H:i') }}</div>
                                        </a>
                                     {% endif %}
                                  {% endfor %}
                             </div>
                         </div>
                         {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
