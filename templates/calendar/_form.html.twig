{{ form_start(form, {'attr': {'class': 'rams-form'}}) }}
    <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack">
        <!-- Event Details -->
        <div class="rams-grid-span-2 mobile-w-full">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'calendar.event_details'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    {{ form_row(form.title) }}

                    <div class="rams-grid rams-grid--2 rams-gap-4">
                        {{ form_row(form.eventType) }}
                        {{ form_row(form.status) }}
                    </div>

                    {{ form_row(form.description, {'attr': {'rows': '4'}}) }}
                </div>
            </div>

            <div class="rams-actions rams-mt-6 mobile-stack">
                <button type="submit" class="rams-btn rams-btn--orange uppercase">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                    </svg>
                    {{ button_label|default('calendar.save_event'|trans) }}
                </button>
                <a href="{{ path('calendar_index') }}" class="rams-btn rams-btn--ghost uppercase">{{ 'common.cancel'|trans }}</a>
            </div>
        </div>

        <div class="mobile-w-full">
            <!-- Date & Time -->
            <div class="rams-module rams-mb-6">
                <div class="rams-module__header">
                    <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'calendar.date_and_time'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-form__group rams-mb-4">
                        <label class="rams-flex rams-items-center rams-gap-2 cursor-pointer">
                            {{ form_widget(form.allDay, {'attr': {'class': 'rams-checkbox'}}) }}
                            <span class="text-sm font-medium">{{ 'calendar.all_day_event'|trans }}</span>
                        </label>
                    </div>

                    <div class="rams-grid rams-grid--1 rams-gap-2">
                        {{ form_row(form.start) }}
                        {{ form_row(form.end) }}
                    </div>
                    
                    {% if form.recurrence is defined %}
                    <div class="rams-alert rams-alert--info rams-mt-4">
                        {{ form_row(form.recurrence) }}
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Metadata -->
             <div class="rams-module">
                <div class="rams-module__header">
                    <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'calendar.settings'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    {{ form_row(form.location) }}
                    {{ form_row(form.url) }}
                    
                    <div class="rams-form__group">
                        <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'calendar.color_code'|trans }}</label>
                        {{ form_widget(form.backgroundColor, {'attr': {'class': 'rams-form__input', 'type': 'color', 'style': 'height: 48px; padding: 2px;'}}) }}
                    </div>
                </div>
             </div>
        </div>
    </div>
{{ form_end(form) }}
