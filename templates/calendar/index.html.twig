{% extends 'base.html.twig' %}

{% block title %}{{ 'calendar.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" integrity="sha384-a+uEN0SA9NPmaoLnc5WsmxDS2SgEiUlzTisgqmWvaOsxzPREhiatn8EIBuY/Zsl2" crossorigin="anonymous">   
<style>
    /* FullCalendar Overrides to match Sensei-Rams */
    .fc {
        --fc-border-color: var(--rams-line);
        --fc-button-bg-color: var(--rams-orange);
        --fc-button-border-color: var(--rams-orange);
        --fc-button-hover-bg-color: var(--rams-orange-dark);
        --fc-button-hover-border-color: var(--rams-orange-dark);
        --fc-button-active-bg-color: var(--rams-orange-dark);
        --fc-button-active-border-color: var(--rams-orange-dark);
        --fc-event-bg-color: var(--rams-orange);
        --fc-event-border-color: var(--rams-orange);
        --fc-page-bg-color: var(--rams-surface);
        --fc-neutral-bg-color: var(--rams-surface-alt);
        --fc-list-event-hover-bg-color: var(--rams-surface-hover);
        --fc-today-bg-color: rgba(59, 130, 246, 0.12);
        color: var(--rams-foreground);
        font-family: inherit;
    }

    .fc-theme-standard .fc-scrollgrid,
    .fc-theme-standard td,
    .fc-theme-standard th {
        border-color: var(--rams-line);
    }
    
    .fc .fc-toolbar-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--rams-foreground);
    }

    .fc-view-harness {
        background: var(--rams-surface);
        border-radius: 6px;
    }
    
    .fc-col-header-cell-cushion {
        color: var(--rams-foreground);
        padding: 1rem 0;
        font-weight: 600;
    }

    .fc-daygrid-day-number {
        color: var(--rams-foreground);
        text-decoration: none;
        font-weight: 600;
    }

    .fc .fc-daygrid-day-frame,
    .fc .fc-timegrid-slot,
    .fc .fc-timegrid-col-frame {
        background: var(--rams-surface);
    }

    .fc .fc-daygrid-day.fc-day-today,
    .fc .fc-timegrid-col.fc-day-today {
        background: rgba(255, 190, 0, 0.12);
    }

    .fc .fc-timegrid-slot-label,
    .fc .fc-timegrid-axis,
    .fc .fc-list-day-text,
    .fc .fc-list-day-side-text {
        color: var(--rams-foreground);
        font-weight: 600;
    }

    .fc .fc-event-title,
    .fc .fc-event-time {
        color: var(--rams-foreground);
        font-weight: 600;
    }

    /* Make buttons look like rams-btn */
    .fc .fc-button {
        border-radius: 4px;
        font-weight: 500;
        text-transform: capitalize;
        padding: 0.5rem 1rem;
        color: var(--rams-foreground);
        background: var(--rams-orange);
        border-color: var(--rams-orange);
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
        color: var(--rams-foreground);
    }

    .fc .fc-button:hover,
    .fc .fc-button:focus {
        background: var(--rams-orange-dark);
        border-color: var(--rams-orange-dark);
        color: var(--rams-foreground);
    }

    .fc .fc-button:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(255, 190, 0, 0.35);
    }

    .fc .fc-button:disabled,
    .fc .fc-button.fc-button-disabled {
        background: var(--rams-panel);
        border-color: var(--rams-line);
        color: var(--rams-muted);
        opacity: 1;
    }

    .fc .fc-icon {
        color: var(--rams-foreground);
    }
</style>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span>{{ 'calendar.title'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'calendar.title'|trans }}</h1>
        </div>
        <div class="rams-page__actions mobile-stack">
            <a href="{{ path('calendar_new') }}" class="rams-btn rams-btn--primary rams-uppercase">  
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2V14M2 8H14"/>
                </svg>
                {{ 'calendar.new_event'|trans }}
            </a>
        </div>
    </div>

    <div class="rams-grid rams-grid--4 rams-gap-6 mobile-stack">
        <div class="mobile-w-full">  
             <div class="rams-module rams-mb-4">
                 <div class="rams-module__header">
                     <h3 class="rams-module__title">{{ 'calendar.views'|trans }}</h3>
                 </div>
                 <div class="rams-module__content">
                     <div class="rams-list">
                         <a href="{{ path('calendar_index') }}" class="rams-list__item {{ app.request.get('_route') == 'calendar_index' ? 'active' : '' }}">
                             {{ 'calendar.month_view'|trans }}
                         </a>
                         <a href="{{ path('calendar_week', {date: 'now'|date('Y-m-d')}) }}" class="rams-list__item {{ app.request.get('_route') == 'calendar_week' ? 'active' : '' }}">
                             {{ 'calendar.week_view'|trans }}
                         </a>
                         <a href="{{ path('calendar_day', {date: 'now'|date('Y-m-d')}) }}" class="rams-list__item {{ app.request.get('_route') == 'calendar_day' ? 'active' : '' }}">
                             {{ 'calendar.day_view'|trans }}
                         </a>
                     </div>
                 </div>
             </div>

             <div class="rams-module">
                 <div class="rams-module__header">
                     <h3 class="rams-module__title">{{ 'calendar.upcoming_events'|trans }}</h3>
                 </div>
                 <div class="rams-module__content">
                    {% if upcomingEvents|length > 0 %}
                    <div class="rams-stack rams-gap-2">
                        {% for event in upcomingEvents %}
                        <a href="{{ path('calendar_show', {id: event.id}) }}" class="rams-list__item">
                            <div class="rams-flex rams-justify-between rams-items-center rams-gap-2">
                                <span class="rams-text--sm rams-text--bold">{{ event.title }}</span>
                                {% if event.allDay %}
                                <span class="rams-badge rams-badge--small">{{ event.startAt|date('M d') }}</span>
                                {% else %}
                                <span class="rams-badge rams-badge--small">{{ event.startAt|date('M d H:i') }}</span>
                                {% endif %}
                            </div>
                        </a>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="rams-empty-state rams-py-md">
                        <div class="rams-empty-state__title">{{ 'calendar.no_upcoming_events'|trans }}</div>
                    </div>
                    {% endif %}
                </div>
             </div>
        </div>

        <div class="rams-grid-span-3 mobile-w-full">
           <div class="rams-module">
               <div class="rams-module__content" style="min-height: 700px;">
                   <div id="calendar" style="height: 100%;"></div>
               </div>
           </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js" integrity="sha384-WfE/vOHqht3KDj6FvpwQUf3UxEPUHoGJ3w1yZ8rhpLWnVigt8HjXL2zXqtcfS7mf" crossorigin="anonymous"></script> 
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            navLinks: true,
            editable: true,
            dayMaxEvents: true,
            events: function(info, successCallback, failureCallback) {
                fetch('{{ path('calendar_events_json') }}?start=' + encodeURIComponent(info.startStr) + '&end=' + encodeURIComponent(info.endStr), {
                    headers: { 'Accept': 'application/json' },
                    credentials: 'same-origin'
                })
                .then(function(response) {
                    if (!response.ok) {
                        throw new Error('Failed to load events');
                    }
                    return response.json();
                })
                .then(function(data) {
                    successCallback(data);
                })
                .catch(function(error) {
                    failureCallback(error);
                });
            },
            eventClick: function(info) {
                if (info.event.url) {
                    window.location.href = info.event.url;
                    info.jsEvent.preventDefault();
                } else {
                              
                    window.location.href = '{{ path('calendar_show', {id: 0}) }}'.replace('/0', '/' + info.event.id);   
                }
            }
        });
        calendar.render();
    });
</script>
{% endblock %}
