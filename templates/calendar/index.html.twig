{% extends 'base.html.twig' %}

{% block title %}{{ 'calendar.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css' rel='stylesheet' />
<style>
    /* FullCalendar Overrides to match Sensei-Rams */
    .fc {
        --fc-border-color: var(--rams-line, #c2c2c2);
        --fc-button-bg-color: var(--rams-orange, #ffbe00);
        --fc-button-border-color: var(--rams-orange, #ffbe00);
        --fc-button-hover-bg-color: var(--rams-orange-dark, #e6ab00);
        --fc-button-hover-border-color: var(--rams-orange-dark, #e6ab00);
        --fc-button-active-bg-color: var(--rams-orange-dark, #e6ab00);
        --fc-button-active-border-color: var(--rams-orange-dark, #e6ab00);
        --fc-event-bg-color: var(--rams-orange, #ffbe00);
        --fc-event-border-color: var(--rams-orange, #ffbe00);
        --fc-page-bg-color: var(--rams-surface, #f7f7f7);
        --fc-neutral-bg-color: var(--rams-surface-alt, #ededed);
        --fc-list-event-hover-bg-color: var(--rams-surface-hover);
        --fc-today-bg-color: rgba(59, 130, 246, 0.12);
        color: var(--rams-foreground, #1a1a1a);
        font-family: inherit;
    }

    .fc-theme-standard .fc-scrollgrid,
    .fc-theme-standard td,
    .fc-theme-standard th {
        border-color: var(--rams-line, #c2c2c2);
    }
    
    .fc .fc-toolbar-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--rams-foreground, #1a1a1a);
    }

    .fc-view-harness {
        background: var(--rams-surface, #f7f7f7);
        border-radius: 6px;
    }
    
    .fc-col-header-cell-cushion {
        color: var(--rams-foreground, #1a1a1a);
        padding: 1rem 0;
        font-weight: 600;
    }

    .fc-daygrid-day-number {
        color: var(--rams-foreground, #1a1a1a);
        text-decoration: none;
        font-weight: 600;
    }

    .fc .fc-daygrid-day-frame,
    .fc .fc-timegrid-slot,
    .fc .fc-timegrid-col-frame {
        background: var(--rams-surface, #f7f7f7);
    }

    .fc .fc-daygrid-day.fc-day-today,
    .fc .fc-timegrid-col.fc-day-today {
        background: rgba(255, 190, 0, 0.12);
    }

    .fc .fc-timegrid-slot-label,
    .fc .fc-timegrid-axis,
    .fc .fc-list-day-text,
    .fc .fc-list-day-side-text {
        color: var(--rams-foreground, #1a1a1a);
        font-weight: 600;
    }

    .fc .fc-event-title,
    .fc .fc-event-time {
        color: #fff;
        font-weight: 600;
    }

    /* Make buttons look like rams-btn */
    .fc .fc-button {
        border-radius: 4px;
        font-weight: 500;
        text-transform: capitalize;
        padding: 0.5rem 1rem;
        color: #fff;
        background: var(--rams-orange, #ffbe00);
        border-color: var(--rams-orange, #ffbe00);
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
        color: #000;
    }

    .fc .fc-button:hover,
    .fc .fc-button:focus {
        background: var(--rams-orange-dark, #e6ab00);
        border-color: var(--rams-orange-dark, #e6ab00);
        color: #000;
    }

    .fc .fc-button:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(255, 190, 0, 0.35);
    }

    .fc .fc-button:disabled,
    .fc .fc-button.fc-button-disabled {
        background: #9ca3af;
        border-color: #9ca3af;
        color: #fff;
        opacity: 1;
    }

    .fc .fc-icon {
        color: #000;
    }
</style>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ 'calendar.title'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'calendar.title'|trans }}</h1>
        </div>
        <div class="rams-page__actions">
            <a href="{{ path('calendar_new') }}" class="rams-btn rams-btn--orange uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2V14M2 8H14"/>
                </svg>
                {{ 'calendar.new_event'|trans }}
            </a>
        </div>
    </div>

    <div class="rams-grid rams-grid--4 rams-gap-6">
        <div class="rams-grid-span-1">
             <div class="rams-module rams-mb-4">
                 <div class="rams-module__header">
                     <h3 class="rams-module__title">{{ 'calendar.views'|trans }}</h3>
                 </div>
                 <div class="rams-module__content">
                     <div class="rams-list">
                         <a href="{{ path('calendar_index') }}" class="rams-list__item {{ app.request.get('_route') == 'calendar_index' ? 'active' : '' }}">
                             {{ 'calendar.month_view'|trans }}
                         </a>
                         <a href="{{ path('calendar_week', {date: 'now'|date('Y-m-d')}) }}" class="rams-list__item {{ app.request.get('_route') == 'calendar_week' ? 'active' : '' }}">
                             {{ 'calendar.week_view'|trans }}
                         </a>
                         <a href="{{ path('calendar_day', {date: 'now'|date('Y-m-d')}) }}" class="rams-list__item {{ app.request.get('_route') == 'calendar_day' ? 'active' : '' }}">
                             {{ 'calendar.day_view'|trans }}
                         </a>
                     </div>
                 </div>
             </div>

             <div class="rams-module">
                 <div class="rams-module__header">
                     <h3 class="rams-module__title">{{ 'calendar.upcoming_events'|trans }}</h3>
                 </div>
                 <div class="rams-module__content">
                     <div class="rams-empty-state rams-py-3">
                         <div class="rams-empty-state__title">{{ 'calendar.no_upcoming_events'|trans }}</div>
                     </div>
                 </div>
             </div>
        </div>

        <div class="rams-grid-span-3">
           <div class="rams-module">
               <div class="rams-module__content" style="min-height: 700px;">
                   <div id="calendar" style="height: 100%;"></div>
               </div>
           </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            navLinks: true,
            editable: true,
            dayMaxEvents: true,
            events: {{ events|default('[]')|raw }}, // Assuming events are passed as JSON
            eventClick: function(info) {
                if (info.event.url) {
                    window.location.href = info.event.url;
                    info.jsEvent.preventDefault();
                } else {
                    // Fallback to show page if we generate URL from ID
                    window.location.href = '/calendar/' + info.event.id;
                }
            }
        });
        calendar.render();
    });
</script>
{% endblock %}
