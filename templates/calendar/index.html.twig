{% extends 'base.html.twig' %}

{% block title %}Calendar{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css' rel='stylesheet' />
<style>
    .calendar-wrapper {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 1.5rem;
    }
    
    @media (max-width: 992px) {
        .calendar-wrapper {
            grid-template-columns: 1fr;
        }
    }

    /* FullCalendar Overrides to match Sensei-Rams */
    .fc {
        --fc-rams-border-color: var(--rams-border);
        --fc-button-bg-color: var(--rams-primary);
        --fc-button-rams-border-color: var(--rams-primary);
        --fc-button-hover-bg-color: var(--rams-primary-dark);
        --fc-button-hover-rams-border-color: var(--rams-primary-dark);
        --fc-button-active-bg-color: var(--rams-primary-dark);
        --fc-button-active-rams-border-color: var(--rams-primary-dark);
        --fc-event-bg-color: var(--rams-primary);
        --fc-event-rams-border-color: var(--rams-primary);
        --fc-page-bg-color: var(--rams-surface);
        --fc-neutral-bg-color: var(--rams-surface-alt);
        --fc-list-event-hover-bg-color: var(--rams-surface-hover);
        --fc-today-bg-color: rgba(59, 130, 246, 0.05);
        color: var(--rams-text);
        font-family: inherit;
    }

    .fc-theme-standard .fc-scrollgrid, 
    .fc-theme-standard td, 
    .fc-theme-standard th {
        rams-border-color: var(--rams-border);
    }
    
    .fc .fc-toolbar-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--rams-text);
    }

    .fc-view-harness {
        background: var(--rams-surface);
        rams-border-radius: 6px;
    }
    
    .fc-col-header-cell-cushion {
        color: var(--rams-text);
        padding: 1rem 0;
    }

    .fc-daygrid-day-number {
        color: var(--rams-text);
        text-decoration: none;
    }

    /* Make buttons look like rams-btn */
    .fc .fc-button {
        rams-border-radius: 4px;
        font-weight: 500;
        text-transform: capitalize;
        padding: 0.5rem 1rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
             <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                 Calendar
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">Calendar</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
            <a href="{{ path('calendar_new') }}" class="rams-btn--primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                New Event
            </a>
        </div>
    </div>

    <div class="rams-page-content">
        <div class="calendar-wrapper">
             <div class="calendar-sidebar">
                 <!-- Mini Calendar / Filters could go here -->
                 <div class="rams-module rams-mb-4">
                     <div class="rams-module__header">
                         <h3>Views</h3>
                     </div>
                     <div class="rams-module__content rams-p-0">
                         <div class="rams-list">
                             <a href="{{ path('calendar_index') }}" class="rams-list__item active">
                                 Month View
                             </a>
                             <a href="{{ path('calendar_week') }}" class="rams-list__item">
                                 Week View
                             </a>
                             <a href="{{ path('calendar_day') }}" class="rams-list__item">
                                 Day View
                             </a>
                         </div>
                     </div>
                 </div>

                 <div class="rams-module">
                     <div class="rams-module__header">
                         <h3>Upcoming Events</h3>
                     </div>
                     <div class="rams-module__content">
                         {# Simplified placeholder for upcoming events in sidebar #}
                         <div class="rams-text--sm rams-text--muted">No upcoming events in next 24h.</div>
                     </div>
                 </div>
             </div>

             <div class="calendar-main">
                <div class="rams-module" style="height: 100%; min-height: 700px;">
                    <div id="calendar" style="height: 100%;"></div>
                </div>
             </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            navLinks: true,
            editable: true,
            dayMaxEvents: true,
            events: {{ events|default('[]')|raw }}, // Assuming events are passed as JSON
            eventClick: function(info) {
                if (info.event.url) {
                    window.location.href = info.event.url;
                    info.jsEvent.preventDefault();
                } else {
                    // Fallback to show page if we generate URL from ID
                    window.location.href = '/calendar/' + info.event.id;
                }
            }
        });
        calendar.render();
    });
</script>
{% endblock %}
