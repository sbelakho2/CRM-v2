{# Calendar event form rendered as a modal fragment (XHR new/edit paths).
   Uses the same fields and names as calendar/_form.html.twig so the
   CalendarController XHR flow (calendar_new / calendar_edit) keeps working. #}
<div class="rams-modal-backdrop" id="calendar-event-modal-backdrop" data-rams-modal-backdrop>
    <div class="rams-modal rams-modal--lg" role="dialog" aria-modal="true" aria-labelledby="calendar-event-modal-title">
        <div class="rams-module">
            <div class="rams-module__header rams-flex rams-items-center rams-justify-between">
                <h3 class="rams-module__title" id="calendar-event-modal-title">
                    {{ event.id is defined and event.id ? 'calendar.edit_event_title'|trans : 'calendar.new_event'|trans }}
                </h3>
                <button type="button" class="rams-btn rams-btn--ghost rams-btn--icon" data-rams-modal-close aria-label="{{ 'common.close'|trans }}">
                    <svg class="rams-btn__icon" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </button>
            </div>
            <div class="rams-module__content">
                {{ form_start(form, {'attr': {'class': 'rams-form', 'data-rams-modal-form': ''}}) }}
                    <div class="rams-stack rams-gap-4">
                        <div class="rams-module">
                            <div class="rams-module__header">
                                <h3 class="rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{ 'calendar.event_details'|trans }}</h3>
                            </div>
                            <div class="rams-module__content">
                                {{ form_row(form.title) }}

                                <div class="rams-grid rams-grid--2 rams-gap-4">
                                    {{ form_row(form.eventType) }}
                                    {{ form_row(form.status) }}
                                </div>

                                {{ form_row(form.description, {'attr': {'rows': '4'}}) }}
                            </div>
                        </div>

                        <div class="rams-module">
                            <div class="rams-module__header">
                                <h3 class="rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{ 'calendar.date_and_time'|trans }}</h3>
                            </div>
                            <div class="rams-module__content">
                                <div class="rams-form__group rams-mb-4">
                                    <label class="rams-flex rams-items-center rams-gap-2 rams-cursor-pointer">
                                        {{ form_widget(form.allDay, {'attr': {'class': 'rams-checkbox'}}) }}
                                        <span class="rams-text--sm rams-font-medium">{{ 'calendar.all_day_event'|trans }}</span>
                                    </label>
                                </div>

                                <div class="rams-stack rams-gap-2">
                                    {{ form_row(form.startAt) }}
                                    {{ form_row(form.endAt) }}
                                </div>

                                {% if form.isRecurring is defined %}
                                <div class="rams-alert rams-alert--info rams-mt-4">
                                    {{ form_row(form.isRecurring) }}
                                    {{ form_row(form.recurringFrequency) }}
                                    {{ form_row(form.recurringUntil) }}
                                </div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="rams-module">
                            <div class="rams-module__header">
                                <h3 class="rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{ 'calendar.settings'|trans }}</h3>
                            </div>
                            <div class="rams-module__content">
                                {{ form_row(form.location) }}
                                {{ form_row(form.meetingUrl) }}

                                <div class="rams-form__group">
                                    <label class="rams-form__label rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{ 'calendar.color_code'|trans }}</label>
                                    {{ form_widget(form.color, {'attr': {'class': 'rams-form__input', 'type': 'color', 'style': 'height: 48px; padding: 2px;'}}) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="rams-module__footer rams-flex rams-items-center rams-justify-end rams-gap-2">
                        <button type="button" class="rams-btn rams-btn--ghost rams-uppercase" data-rams-modal-close>{{ 'common.cancel'|trans }}</button>
                        <button type="submit" class="rams-btn rams-btn--primary rams-uppercase">
                            <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                            </svg>
                            {{ button_label|default('calendar.save_event'|trans) }}
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
