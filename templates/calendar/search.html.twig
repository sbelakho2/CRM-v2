{% extends 'base.html.twig' %}

{% block title %}{{ 'calendar.search'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
            <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <a href="{{ path('calendar_index') }}">{{ 'calendar.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <span>{{ 'calendar.search'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'calendar.search'|trans }}</h1>
            <p class="rams-page__subtitle">{{ 'calendar.search_subtitle'|trans       }}</p>
        </div>
    </div>

    <div class="rams-module rams-mb-6">
        <div class="rams-module__content">
            <form method="get" action="{{ path('calendar_search') }}" class="rams-flex rams-gap-2 mobile-stack">
                <label for="calendar-search-input" class="rams-sr-only">{{ 'calendar.search'|trans }}</label> <input type="text" id="calendar-search-input" name="q" value="{{ query }}" class="rams-form__input" placeholder="{{ 'calendar.search_placeholder'|trans }}" />
                <button type="submit" class="rams-btn rams-btn--primary rams-uppercase">  
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"> 
                        <circle cx="7" cy="7" r="5" />
                        <path d="M11 11l3 3" />
                    </svg>
                    {{ 'calendar.search'|trans }}
                </button>
            </form>
        </div>
    </div>

    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'calendar.search_results'|trans   }}</h2>
        </div>
        <div class="rams-module__content">
            {% if events is not empty %}
                <div class="rams-table-container">
                <table class="rams-table" aria-label="{{ 'calendar.search_results'|trans }}">
                    <thead>  
                        <tr>
                            <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'common.name'|trans }}</th>
                            <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'common.date'|trans }}</th>
                            <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'common.type'|trans }}</th>
                            <th scope="col" class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>  
                        {% for event in events %}
                            <tr>  
                                <td class="rams-table__cell rams-text--bold">{{ event.title }}</td>
                                <td class="rams-table__cell rams-text--muted">
                                    {% if event.startAt %}
                                        {{ event.startAt|date('Y-m-d H:i') }}
                                    {% else %}
                                        {{ 'common.n_a'|trans }}
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--gray">{{ event.eventType|default('calendar.event')|trans }}</span>
                                </td>
                                <td class="rams-table__cell rams-table__cell--actions">
                                    <a href="{{ path('calendar_show', {id: event.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                                        {{ 'common.view'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </div>
            {% else %}
                <div class="rams-empty-state">
                    {{ query ? 'calendar.no_results'|trans      : 'calendar.search_hint'|trans       }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
