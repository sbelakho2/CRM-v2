{% extends 'base.html.twig' %}

{% block title %}Edit Event{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><line x1="12" x2="12" y1="15" y2="15"/></svg>
                 Edit Event
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('calendar_index') }}" class="rams-breadcrumb__item">Calendar</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('calendar_show', {id: event.id}) }}" class="rams-breadcrumb__item">{{ event.title }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">Edit</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <a href="{{ path('calendar_show', {id: event.id}) }}" class="rams-btn">
                Cancel
            </a>
        </div>
    </div>

    <div class="rams-page-content">
        {{ include('calendar/_form.html.twig', {button_label: 'Update Event'}) }}
    </div>
</div>
{% endblock %}
