{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page__header-content"> 
            <h1 class="rams-page-title"> 
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-3"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                 {{ event.title }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('calendar_index') }}" class="rams-breadcrumb__item">{{ 'calendar.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item rams-breadcrumb__item--current">{{  event.title }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <a href="{{ path('calendar_index') }}" class="rams-btn">{{ 'calendar.back_to_calendar'|trans }}</a>
             <a href="{{ path('calendar_edit', {'id': event.id}) }}" class="rams-btn rams-btn--primary">{{  'calendar.edit_event'|trans }}</a>
             {{ include('calendar/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="rams-page__container"> 
        <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack"> 
            <div class="rams-grid-span-2 mobile-w-full"> 
                <!-- Main Info -->
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h2 class="rams-module__title">{{  'calendar.event_information'|trans }}</h2> 
                    </div>
                    <div class="rams-module__content">
                         <dl class="rams-definition-list rams-grid rams-grid--2"> 
                            <div class="rams-definition-list__item"> 
                                <dt class="rams-definition-list__term">{{  'common.name'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{  event.title }}</dd>
                            </div>
                            <div class="rams-definition-list__item"> 
                                <dt class="rams-definition-list__term">{{  'common.description'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{  event.description|nl2br }}</dd>
                            </div>
                             <div class="rams-definition-list__item"> 
                                <dt class="rams-definition-list__term">{{  'common.type'|trans }}</dt>
                                <dd class="rams-definition-list__desc"> 
                                    <span class="rams-badge rams-badge--gray">{{ event.eventType }}</span>
                                </dd>
                            </div>
                            <div class="rams-definition-list__item"> 
                                <dt class="rams-definition-list__term">{{  'common.status'|trans }}</dt>
                                <dd class="rams-definition-list__desc"> 
                                     <span class="rams-badge {{ event.status == 'confirmed' ? 'rams-badge--success' : 'rams-badge--warning' }}">
                                        {{ event.status }}
                                    </span>
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="mobile-w-full"> 
                 <!-- Timing & Location -->
                 <div class="rams-module">
                    <div class="rams-module__header">
                        <h2 class="rams-module__title">{{  'calendar.timing_and_location'|trans }}</h2> 
                    </div>
                    <div class="rams-module__content">
                         <div class="rams-stat-card rams-mb-4" style="border-left: 4px solid {{ event.backgroundColor|default('var(--rams-steel)') }}">
                            <div class="rams-stat-card__value" style="font-size: 1.25rem;">
                                {{ event.startAt ? event.startAt|date('M j, Y') : '' }}
                            </div>
                            <div class="rams-stat-card__label">
                                {{ event.startAt ? event.startAt|date('H:i') : '' }} - {{ event.endAt ? event.endAt|date('H:i') : '' }}
                            </div>
                         </div>

                         <dl class="rams-definition-list rams-stack rams-gap-2"> 
                             <div class="rams-definition-list__item"> 
                                <dt class="rams-definition-list__term">{{  'calendar.all_day'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{  event.allDay ? 'common.yes'|trans : 'common.no'|trans }}</dd>
                            </div>
                            <div class="rams-definition-list__item"> 
                                <dt class="rams-definition-list__term">{{ 'calendar.location'|trans }}</dt> 
                                <dd class="rams-definition-list__desc">{{  event.location|default('calendar.not_specified'|trans) }}</dd>
                            </div>
                            <div class="rams-definition-list__item"> 
                                <dt class="rams-definition-list__term">{{  'calendar.link'|trans }}</dt>
                                <dd class="rams-definition-list__desc"> 
                                    {% if event.meetingUrl %}
                                        <a href="{{ event.meetingUrl }}" target="_blank" class="rams-link">{{ 'calendar.open_link'|trans }}</a>
                                    {% else %}
                                        -
                                    {% endif %}
                                </dd>
                            </div>
                         </dl>
                    </div>
                 </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
