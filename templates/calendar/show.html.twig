{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                 {{ event.title }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('calendar_index') }}" class="rams-breadcrumb__item">Calendar</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ event.title }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <a href="{{ path('calendar_index') }}" class="rams-btn">Back to Calendar</a>
             <a href="{{ path('calendar_edit', {'id': event.id}) }}" class="rams-btn--primary">Edit Event</a>
             {{ include('calendar/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="rams-page-content">
        <div class="rams-grid">
            <div class="rams-grid-col-2">
                <!-- Main Info -->
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3>Event Information</h3>
                    </div>
                    <div class="rams-module__content">
                         <dl class="rams-dl">
                            <div class="rams-dl-row">
                                <dt class="rams-dt">Title</dt>
                                <dd class="rams-dd">{{ event.title }}</dd>
                            </div>
                            <div class="rams-dl-row">
                                <dt class="rams-dt">Description</dt>
                                <dd class="rams-dd">{{ event.description|nl2br }}</dd>
                            </div>
                             <div class="rams-dl-row">
                                <dt class="rams-dt">Type</dt>
                                <dd class="rams-dd">
                                    <span class="rams-badge rams-badge--gray">{{ event.eventType }}</span>
                                </dd>
                            </div>
                            <div class="rams-dl-row">
                                <dt class="rams-dt">Status</dt>
                                <dd class="rams-dd">
                                     <span class="rams-badge {{ event.status == 'confirmed' ? 'rams-badge--success' : 'rams-badge--warning' }}">
                                        {{ event.status }}
                                    </span>
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="rams-grid-col-1">
                 <!-- Timing & Location -->
                 <div class="rams-module">
                    <div class="rams-module__header">
                        <h3>Timing & Location</h3>
                    </div>
                    <div class="rams-module__content">
                         <div class="rams-stat-card rams-mb-4" style="rams-border-left: 4px solid {{ event.backgroundColor|default('#3b82f6') }}">
                            <div class="rams-stat-card__value" style="font-size: 1.25rem;">
                                {{ event.start ? event.start|date('M j, Y') : '' }}
                            </div>
                            <div class="rams-stat-card__label">
                                {{ event.start ? event.start|date('H:i') : '' }} - {{ event.end ? event.end|date('H:i') : '' }}
                            </div>
                         </div>

                         <dl class="rams-dl">
                             <div class="rams-dl-row">
                                <dt class="rams-dt">All Day</dt>
                                <dd class="rams-dd">{{ event.allDay ? 'Yes' : 'No' }}</dd>
                            </div>
                            <div class="rams-dl-row">
                                <dt class="rams-dt">Location</dt>
                                <dd class="rams-dd">{{ event.location|default('Not specified') }}</dd>
                            </div>
                            <div class="rams-dl-row">
                                <dt class="rams-dt">Link</dt>
                                <dd class="rams-dd">
                                    {% if event.url %}
                                        <a href="{{ event.url }}" target="_blank" class="text-blue-600 hover:underline">Open Link</a>
                                    {% else %}
                                        -
                                    {% endif %}
                                </dd>
                            </div>
                         </dl>
                    </div>
                 </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
