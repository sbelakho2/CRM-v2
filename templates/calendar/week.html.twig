{% extends 'base.html.twig' %}

{% block title %}Week View{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                 Week of {{ weekStart|date('M j') }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('calendar_index') }}" class="rams-breadcrumb__item">Calendar</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">Week View</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <div class="rams-btn-group">
                <a href="{{ path('calendar_week', {date: prevWeek|date('Y-m-d')}) }}" class="rams-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </a>
                <a href="{{ path('calendar_week', {date: 'today'}) }}" class="rams-btn">Today</a>
                <a href="{{ path('calendar_week', {date: nextWeek|date('Y-m-d')}) }}" class="rams-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </div>
             <a href="{{ path('calendar_new') }}" class="rams-btn--primary rams-ml-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                New Event
            </a>
        </div>
    </div>

    <div class="rams-page-content">
        <div class="rams-module">
            <div class="rams-module__content rams-p-0">
                <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 0; min-height: 600px;">
                    {# assuming weekDays is passed #}
                    {% for day in weekDays %} 
                    <div style="rams-border-right: 1px solid var(--rams-border); display: flex; flex-direction: column;" class="{{ loop.last ? 'rams-border-r-0' : '' }}">
                        <div style="padding: 1rem; text-align: center; rams-border-bottom: 1px solid var(--rams-border); background-color: {{ day.date == 'now'|date('Y-m-d') ? 'var(--rams-primary-bg)' : 'var(--rams-surface)' }};">
                             <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--rams-rams-text--muted);">{{ day.date|date('D') }}</div>
                             <div style="font-size: 1.5rem; font-weight: 600;">{{ day.date|date('j') }}</div>
                        </div>
                        <div style="padding: 0.5rem; flex: 1; background-color: var(--rams-surface-alt);">
                            {% for event in day.events %}
                                <a href="{{ path('calendar_show', {id: event.id}) }}" 
                                   class="block rams-p-2 rams-mb-2 rams-rounded bg-white rams-border rams-border-gray-200 shadow-sm hover:shadow-md transition-shadow rams-text--xs"
                                   style="rams-border-left: 3px solid {{ event.backgroundColor|default('var(--rams-primary)') }};">
                                    <div class="font-semibold truncate">{{ event.title }}</div>
                                    <div class="text-gray-500">{{ event.allDay ? 'All Day' : event.start|date('H:i') }}</div>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
