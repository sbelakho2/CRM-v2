{% extends 'base.html.twig' %}

{% block title %}{{ 'calendar.week_view'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-3"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                 {{ 'calendar.week_of'|trans }}{{ weekStart|date('M j') }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('calendar_index') }}" class="rams-breadcrumb__item">{{ 'calendar.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ 'calendar.week_view'|trans }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <div class="rams-btn-group">
                <a href="{{ path('calendar_week', {date: prevWeek|date('Y-m-d')}) }}" class="rams-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </a>
                <a href="{{ path('calendar_week', {date: 'today'}) }}" class="rams-btn">{{ 'calendar.today'|trans }}</a>
                <a href="{{ path('calendar_week', {date: nextWeek|date('Y-m-d')}) }}" class="rams-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </div>
             <a href="{{ path('calendar_new') }}" class="rams-btn rams-btn--orange rams-ml-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                {{ 'calendar.new_event'|trans }}
            </a>
        </div>
    </div>

    <div class="rams-page-content">
        <div class="rams-module">
            <div class="rams-module__content rams-p-0">
                <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 0; min-height: 600px;">
                    {# assuming weekDays is passed #}
                    {% for day in weekDays %}
                        {% set dayKey = day|date('Y-m-d') %}
                        {% set dayEvents = eventsByDay[dayKey]|default([]) %}
                    <div style="border-right: 1px solid var(--rams-border); display: flex; flex-direction: column;" class="{{ loop.last ? 'rams-border-r-0' : '' }}">
                        <div style="padding: 1rem; text-align: center; border-bottom: 1px solid var(--rams-border); background-color: {{ dayKey == 'now'|date('Y-m-d') ? 'var(--rams-primary-bg)' : 'var(--rams-surface)' }};">
                             <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--rams-text--muted);">{{ day|date('D') }}</div>
                             <div style="font-size: 1.5rem; font-weight: 600;">{{ day|date('j') }}</div>
                        </div>
                        <div style="padding: 0.5rem; flex: 1; background-color: var(--rams-surface-alt);">
                            {% for event in dayEvents %}
                                <a href="{{ path('calendar_show', {id: event.id}) }}" 
                                   class="block rams-p-2 rams-mb-2 rams-rounded rams-bg-chassis rams-border rams-border rams-transition-colors rams-text--xs"
                                   style="border-left: 3px solid {{ event.backgroundColor|default('var(--rams-primary)') }};">
                                    <div class="font-semibold truncate">{{ event.title }}</div>
                                    <div class="rams-text--muted">{{ event.allDay ? 'calendar.all_day'|trans : event.start|date('H:i') }}</div>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
