<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Login - CRM Starz Morocco{% endblock %}</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <style>
        /* Claude AI Color Scheme */
        :root {
            --claude-cream: #F5F3EE;
            --claude-tan: #E8E3D8;
            --claude-brown: #8B7355;
            --claude-purple: #9B6B9E;
            --claude-dark-purple: #7C5380;
            --claude-text: #2C2416;
            --claude-text-secondary: #5C5041;
            --claude-border: #DDD8CC;
            --claude-hover: #EDE9E0;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, var(--claude-cream) 0%, var(--claude-tan) 100%);
            color: var(--claude-text);
            min-height: 100vh;
            line-height: 1.6;
        }
        
        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }
        
        .login-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            padding: 3rem 2.5rem;
            max-width: 420px;
            width: 100%;
        }
        
        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .login-title {
            font-size: 1.875rem;
            font-weight: 700;
            color: var(--claude-text);
            margin-bottom: 0.5rem;
        }
        
        .login-subtitle {
            color: var(--claude-text-secondary);
            font-size: 0.95rem;
        }
        
        .form-group {
            margin-bottom: 1.25rem;
        }
        
        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--claude-text);
            font-weight: 500;
            font-size: 0.9rem;
        }
        
        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 2px solid var(--claude-border);
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.2s;
            background: white;
        }
        
        .form-input:focus {
            outline: none;
            border-color: var(--claude-purple);
            box-shadow: 0 0 0 3px rgba(155, 107, 158, 0.1);
        }
        
        .btn-primary {
            width: 100%;
            padding: 0.875rem 1.5rem;
            background: var(--claude-purple);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 0.5rem;
        }
        
        .btn-primary:hover {
            background: var(--claude-dark-purple);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(155, 107, 158, 0.3);
        }
        
        .btn-primary:active {
            transform: translateY(0);
        }
        
        .error-message {
            background: #FEE2E2;
            border: 1px solid #FCA5A5;
            color: #991B1B;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
        }
        
        .logo-text {
            font-size: 2.25rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--claude-purple) 0%, var(--claude-dark-purple) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}
    
    {% block javascripts %}{% endblock %}
</body>
</html>
