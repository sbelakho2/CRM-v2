<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale starts with 'ar' ? 'rtl' : 'ltr' }}" data-theme="system">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'auth.login.title'|trans }}{% endblock %} - {{ 'app.company'|trans }}</title>
    
    {# Sensei-Rams Design System CSS (versioned; bumped only when the stylesheet changes) #}
    <link rel="stylesheet" href="{{ asset('css/sensei-rams.css') }}?v=3.4">
    
    {# Font preloading for performance #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
    
    {% block stylesheets %}{% endblock %}
</head>
<body
    data-user-theme="system"
    data-user-accent="orange"
    data-user-font-size="medium"
    data-user-density="comfortable"
    data-user-reduced-motion="false">
    {# Skip Link for Accessibility #}
    <a href="#main-content" class="rams-skip-link">{{ 'accessibility.skip_to_content'|trans }}</a>
    
    <main id="main-content" class="rams-auth-container" role="main">
        {# Flash Messages #} {% for label, messages in app.flashes %} {% for message in messages %} <div class="rams-alert rams-alert--{{ label == 'error' ? 'error' : (label == 'success' ? 'success' : (label == 'warning' ? 'warning' : 'info')) }} rams-mb-4" role="alert"> <div class="rams-alert__content">{{ message|trans }}</div> </div> {% endfor %} {% endfor %} {% block body %}{% endblock %}
    </main>
    
    {% block javascripts %}{% endblock %}

    <script src="{{ asset('js/theme-applier.js') }}"></script>
</body>
</html>
