<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'auth.login.title'|trans }}{% endblock %} - {{ 'app.company'|trans }}</title>
    
    {# Sensei-Rams Design System CSS #}
    <link rel="stylesheet" href="{{ asset('css/sensei-rams.css') }}">
    
    {# Font preloading for performance #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Auth-specific overrides */
        .rams-auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--rams-space-6);
            background: var(--rams-grey-900);
        }
        
        .rams-auth-module {
            width: 100%;
            max-width: 400px;
        }
        
        .rams-auth-logo {
            text-align: center;
            margin-bottom: var(--rams-space-6);
        }
        
        .rams-auth-logo__symbol {
            width: 48px;
            height: 48px;
            background: var(--rams-grey-800);
            border: 2px solid var(--rams-grey-600);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto var(--rams-space-3);
            font-size: 24px;
            color: var(--rams-orange);
        }
        
        .rams-auth-logo__title {
            font-family: var(--rams-font-mono);
            font-size: var(--rams-text-xl);
            font-weight: 600;
            color: var(--rams-grey-100);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        
        .rams-auth-logo__subtitle {
            font-size: var(--rams-text-sm);
            color: var(--rams-grey-400);
            margin-top: var(--rams-space-1);
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Skip Link for Accessibility #}
    <a href="#main-content" class="rams-skip-link">{{ 'accessibility.skip_to_content'|trans }}</a>
    
    <main id="main-content" class="rams-auth-container" role="main">
        {% block body %}{% endblock %}
    </main>
    
    {% block javascripts %}{% endblock %}
</body>
</html>
