{% extends 'base.html.twig' %}

{% block title %}Lead Dashboard - Starz Morocco CRM{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Lead Dashboard</h2>
        <a href="{{ path('app_lead_review') }}" class="btn btn-primary">
            <i class="fas fa-list"></i> Review Leads
        </a>
    </div>

    {# Key Metrics #}
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card" style="background-color: #f5f0e8; border: none;">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Total Leads</h6>
                    <h3 class="mb-0">{{ total_leads }}</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card" style="background-color: #fff3cd; border: none;">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Pending Review</h6>
                    <h3 class="mb-0 text-warning">{{ pending_leads }}</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card" style="background-color: #d1e7dd; border: none;">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Approved</h6>
                    <h3 class="mb-0 text-success">{{ approved_leads }}</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card" style="background-color: #f8d7da; border: none;">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Denied</h6>
                    <h3 class="mb-0 text-danger">{{ denied_leads }}</h3>
                </div>
            </div>
        </div>
    </div>

    {# Performance Metrics #}
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card" style="background-color: #f5f0e8; border: none;">
                <div class="card-header" style="background-color: transparent; border-bottom: 1px solid #ddd;">
                    <h5 class="mb-0">Weekly Performance (Last 7 Days)</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted">Total Reviewed</h6>
                            <h4>{{ weekly_stats.total ?? 0 }}</h4>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Approval Rate</h6>
                            <h4 class="text-success">
                                {% if weekly_stats.total > 0 %}
                                    {{ ((weekly_stats.approved / weekly_stats.total) * 100)|number_format(1) }}%
                                {% else %}
                                    N/A
                                {% endif %}
                            </h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card" style="background-color: #f5f0e8; border: none;">
                <div class="card-header" style="background-color: transparent; border-bottom: 1px solid #ddd;">
                    <h5 class="mb-0">Quality Metrics</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <h6 class="text-muted">Precision @ Top-50</h6>
                            <h4 class="{% if precision_top50 >= 75 %}text-success{% elseif precision_top50 >= 50 %}text-warning{% else %}text-danger{% endif %}">
                                {{ precision_top50 }}%
                            </h4>
                            <small class="text-muted">Target: ≥75%</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Regional Breakdown #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card" style="background-color: #f5f0e8; border: none;">
                <div class="card-header" style="background-color: transparent; border-bottom: 1px solid #ddd;">
                    <h5 class="mb-0">Leads by Region</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Region</th>
                                    <th>Total Leads</th>
                                    <th>Average Score</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for stat in region_stats %}
                                <tr>
                                    <td>
                                        <span class="badge bg-info">{{ stat.regionTag|upper }}</span>
                                    </td>
                                    <td>{{ stat.total }}</td>
                                    <td>
                                        <span class="badge {% if stat.avg_score >= 70 %}bg-success{% elseif stat.avg_score >= 55 %}bg-warning{% else %}bg-secondary{% endif %} rounded-pill">
                                            {{ stat.avg_score|number_format(1) }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_lead_review', {region: stat.regionTag}) }}" class="btn btn-sm btn-outline-primary">
                                            Review <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No regional data available</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Top Leads #}
    <div class="row">
        <div class="col-12">
            <div class="card" style="background-color: #f5f0e8; border: none;">
                <div class="card-header" style="background-color: transparent; border-bottom: 1px solid #ddd;">
                    <h5 class="mb-0">Top 20 Leads by Score</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Score</th>
                                    <th>Company</th>
                                    <th>Region</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for lead in top_leads %}
                                <tr>
                                    <td>
                                        <span class="badge {% if lead.leadScore >= 70 %}bg-success{% elseif lead.leadScore >= 55 %}bg-warning{% else %}bg-secondary{% endif %} rounded-pill">
                                            {{ lead.leadScore }}
                                        </span>
                                    </td>
                                    <td>
                                        <strong>{{ lead.companyName }}</strong>
                                        {% if lead.websiteRoot %}
                                        <br><small class="text-muted">
                                            <a href="{{ lead.websiteRoot }}" target="_blank">{{ lead.websiteRoot }}</a>
                                        </small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-info">{{ lead.regionTag|upper }}</span>
                                    </td>
                                    <td>
                                        {% if lead.reviewStatus == 'approved' %}
                                            <span class="badge bg-success">Approved</span>
                                        {% elseif lead.reviewStatus == 'denied' %}
                                            <span class="badge bg-danger">Denied</span>
                                        {% else %}
                                            <span class="badge bg-warning">Pending</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('app_lead_review', {region: lead.regionTag}) }}" class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted">No leads available</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
