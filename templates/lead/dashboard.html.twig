{% extends 'base.html.twig' %}

{% block title %}{{ 'lead.dashboard'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'lead.dashboard'|trans }}</h1>
            </div>
            <div class="rams-page__actions mobile-stack">
                <a href="{{ path('app_lead_review') }}" class="rams-btn rams-btn--primary">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    {{ 'lead.review_leads_title'|trans }}
                </a>
            </div>
        </div>

        {# Key Metrics #}
        <div class="rams-grid rams-grid--4">
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead.total_leads'|trans }}</span>
                    <span class="rams-metric">{{ total_leads }}</span>
                </div>
            </div>

            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead.pending_review'|trans }}</span>
                    <span class="rams-metric rams-text--warning">{{ pending_leads }}</span>
                </div>
            </div>

            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead.approved_leads'|trans }}</span>
                    <span class="rams-metric rams-text--success">{{ approved_leads }}</span>
                </div>
            </div>

            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead.denied_leads'|trans }}</span>
                    <span class="rams-metric rams-text--danger">{{ denied_leads }}</span>
                </div>
            </div>
        </div>

        {# Performance Metrics #}
        <div class="rams-grid rams-grid--2">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'lead.weekly_performance'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-grid rams-grid--2">
                        <div>
                            <span class="rams-dymo">{{ 'lead.total_reviewed'|trans }}</span>
                            <span class="rams-metric">{{ weekly_stats.total ?? 0 }}</span>
                        </div>
                        <div>
                            <span class="rams-dymo">{{ 'lead.approval_rate'|trans }}</span>
                            <span class="rams-metric rams-text--success">
                                {% if weekly_stats.total > 0 %}
                                    {{ ((weekly_stats.approved / weekly_stats.total) * 100)|number_format(1) }}%
                                {% else %}
                                    {{ 'common.n_a'|trans }}
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="rams-module">
                <div class="rams-module__header">
                    <h3 class="rams-module__title">{{ 'lead.quality_metrics'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead.precision_top50'|trans }}</span>
                    <span class="rams-metric rams-text--{% if precision_top50 >= 75 %}success{% elseif precision_top50 >= 50 %}warning{% else %}danger{% endif %}">
                        {{ precision_top50 }}%
                    </span>
                    <p class="rams-metric__label">{{ 'lead.target'|trans }}: ≥75%</p>
                </div>
            </div>
        </div>

        {# 📊 Analytics Section #}
        <div class="rams-module rams-mb-4">
            <div class="rams-module__header">
                <h2 class="rams-module__title">📊 {{ 'lead.analytics_title'|trans }}</h2>  
            </div>
            <div class="rams-module__content">
                {# Lead Quality Overview #}
                <div class="rams-mb-6">
                    <h3 class="rams-text--sm rams-font-medium rams-mb-3">🎯 {{ 'lead.quality_overview'|trans }}</h3>   
                    {% if quality_distribution is defined and quality_distribution is not empty %}
                    {% set quality_max = quality_distribution|reduce((carry, item) => carry > item.count ? carry : item.count, 0) %}
                    <div class="rams-grid rams-grid--4">
                        {% for range, data in quality_distribution %}
                        <div class="rams-module rams-module--compact">
                            <div class="rams-module__content">
                                <div class="rams-flex rams-items-center rams-gap-2 rams-mb-1">
                                    <span class="rams-text--lg">
                                        {% if range == '0-25' %}🔴{% elseif range == '26-50' %}🟠{% elseif range == '51-75' %}🟡{% else %}🟢{% endif %}
                                    </span>
                                    <span class="rams-font-medium">{{  range }} <span class="rams-text--muted rams-text--xs">{% if range == '0-25' %}{{ 'lead.quality_low'|trans }}{%  elseif range == '26-50' %}{{ 'lead.quality_fair'|trans }}{%  elseif range == '51-75' %}{{ 'lead.quality_good'|trans }}{%  else %}{{ 'lead.quality_excellent'|trans }}{%  endif %}</span></span>
                                </div>
                                <div class="rams-metric rams-mb-1">{{ data.count }}</div>
                                <div class="rams-progress rams-progress--compact rams-mb-1">
                                    <div class="rams-progress__bar rams-progress__bar--{% if data.approval_rate >= 75 %}success{% elseif data.approval_rate >= 50 %}warning{% else %}danger{% endif %}"    style="width: {{ quality_max > 0 ? (data.count / quality_max * 100)|round : 0 }}%"></div>
                                </div>
                                <div class="rams-flex rams-justify-between rams-text--xs">
                                    <span class="rams-text--muted">{{ 'lead.count_leads'|trans({'%count%': data.count}) }}</span>   
                                    <span class="{% if data.approval_rate >= 75 %}rams-text--success{% elseif data.approval_rate >= 50 %}rams-text--warning{% else %}rams-text--danger{% endif %}">{{ 'lead.approval_percent'|trans({'%rate%': data.approval_rate}) }}</span>   
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="rams-text--muted rams-text--sm rams-py-sm">{{ 'lead.no_quality_data'|trans }}</div>     
                    {% endif %}
                </div>

                {# Source Performance & Funnel #}
                <div class="rams-grid rams-grid--2 rams-gap-4 rams-mb-6">
                    {# Source Effectiveness #}
                    <div>
                        <h4 class="rams-text--sm rams-font-medium rams-mb-2">📡 {{ 'lead.source_performance'|trans }}</h4>  
                        {% if source_effectiveness is defined and source_effectiveness is not empty %}
                        {% set src_max = source_effectiveness|reduce((carry, item) => carry > item.count ? carry : item.count, 0) %}
                        <div class="rams-stack rams-gap-2">
                            {% for item in source_effectiveness %}
                            <div>
                                <div class="rams-flex rams-justify-between rams-items-center rams-mb-1">
                                    <span class="rams-text--sm">{{ item.source }}</span>
                                    <span class="rams-badge rams-badge--blue">{{ item.count }}</span>
                                </div>
                                <div class="rams-progress rams-progress--compact rams-mb-1">
                                    <div class="rams-progress__bar rams-progress__bar--info"    style="width: {{ src_max > 0 ? (item.count / src_max * 100)|round : 0 }}%"></div>
                                </div>
                                <div class="rams-flex rams-justify-between rams-text--xs rams-text--muted">
                                    <span>{{ 'lead.analytics_avg'|trans }}:  <span class="{% if item.avg_score >= 70 %}rams-text--success{% elseif item.avg_score >= 50 %}rams-text--warning{% else %}rams-text--danger{% endif %}">{{ item.avg_score|number_format(1) }}</span></span>
                                    <span>{{ 'lead.analytics_approval'|trans }}:  <span class="{% if item.approval_rate >= 75 %}rams-text--success{% elseif item.approval_rate >= 50 %}rams-text--warning{% else %}rams-text--danger{% endif %}">{{ item.approval_rate }}%</span></span>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="rams-text--muted rams-text--sm rams-py-sm">{{ 'lead.no_source_performance'|trans }}</div>    
                        {% endif %}
                    </div>

                    {# Funnel Analytics #}
                    <div>
                        <h4 class="rams-text--sm rams-font-medium rams-mb-2">📊 {{ 'lead.funnel_analytics'|trans }}</h4>  
                        {% if funnel_analytics is defined and funnel_analytics is not empty %}
                        {% set funnel_max = funnel_analytics|reduce((carry, s) => carry > s.count ? carry : s.count, 0) %}
                        <div class="rams-stack rams-gap-2">
                            {% for stage in funnel_analytics %}
                            <div>
                                <div class="rams-flex rams-justify-between rams-items-center rams-mb-1">
                                    <span class="rams-text--sm">{{ stage.stage|capitalize }}</span>
                                    <span class="rams-text--sm rams-font-medium">{{  stage.count }}</span>
                                </div>
                                <div class="rams-progress rams-progress--compact">    
                                    <div class="rams-progress__bar rams-progress__bar--success"        style="width: {{ funnel_max > 0 ? (stage.count / funnel_max * 100)|round : 0 }}%"></div> 
                                                
                                    
                                </div>
                                <div class="rams-text--xs rams-text--muted">{{ 'lead.analytics_score'|trans }}:  {{ stage.avg_score }}</div>
                            </div>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="rams-text--muted rams-text--sm rams-py-sm">{{ 'lead.no_funnel_data'|trans }}</div>    
                        {% endif %}
                    </div>
                </div>

                {# Geographic Distribution #}
                <div class="rams-mb-6">
                    <h3 class="rams-text--sm rams-font-medium rams-mb-3">🌍 {{ 'lead.geographic_distribution'|trans }}</h3>  
                    {% if geographic_distribution is defined and geographic_distribution is not empty %}
                    <div class="rams-overflow-x-auto">
                        <table class="rams-table rams-w-full" aria-label="{{ 'lead.geographic_distribution'|trans }}">
                            <thead>
                                <tr>
                                    <th scope="col" class="rams-table__cell">{{ 'lead.region'|trans }}</th> 
                                    <th scope="col" class="rams-table__cell">{{ 'common.count'|trans }}</th> 
                                    <th scope="col" class="rams-table__cell">{{ 'lead.avg_score'|trans }}</th>  
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in geographic_distribution %}
                                <tr>
                                    <td class="rams-table__cell"><span class="rams-badge rams-badge--info">{{ item.region }}</span></td>
                                    <td class="rams-table__cell">{{ item.count }}</td>
                                    <td class="rams-table__cell">
                                        <span class="rams-badge {% if item.avg_score >= 70 %}rams-badge--success{% elseif item.avg_score >= 50 %}rams-badge--warning{% endif %}">{{ item.avg_score|number_format(1) }}</span>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="rams-text--muted rams-text--sm rams-py-sm">{{ 'lead.no_geographic_data'|trans }}</div>    
                    {% endif %}
                </div>

                {# Actionable Insights #}
                <div>
                    <h3 class="rams-text--sm rams-font-medium rams-mb-3">💡 {{ 'lead.actionable_insights'|trans }}</h3>  
                    {% if actionable_insights is defined and actionable_insights is not empty %}
                    <div class="rams-stack rams-gap-2">
                        {% for insight in actionable_insights %}
                        <div class="rams-module rams-p-3">
                            <div class="rams-flex rams-justify-between rams-items-start rams-gap-2">
                                <div class="rams-flex-1">
                                    <div class="rams-flex rams-items-center rams-gap-2 rams-mb-1">
                                        <span class="rams-badge rams-badge--{% if insight.priority == 'high' %}danger{% elseif insight.priority == 'medium' %}warning{% else %}info{% endif %} rams-text--xs">{{ insight.priority|upper }}</span>
                                        <span class="rams-font-medium rams-text--sm">{{ insight.lead.companyName }}</span>
                                    </div>
                                    <p class="rams-text--sm rams-text--muted">{{ insight.message }}</p>
                                </div>
                                <div class="rams-flex rams-items-center rams-gap-1">
                                    <span class="rams-badge {% if insight.score >= 70 %}rams-badge--success{% elseif insight.score >= 50 %}rams-badge--warning{% endif %}">{{ insight.score }}</span>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="rams-text--muted rams-text--sm rams-py-sm">{{ 'lead.no_actionable_insights'|trans }}</div>    
                    {% endif %}
                </div>
            </div>
        </div>

        {# Regional Breakdown #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="rams-module__title">{{ 'lead.leads_by_region'|trans }}</h3>
            </div>
            <div class="rams-module__content rams-module__content--flush">
                <div class="rams-table-container">
                    <table class="rams-table" aria-label="{{ 'lead.leads_by_region'|trans }}">
                        <thead>
                            <tr>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'lead.region'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'lead.total_leads'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'lead.avg_score'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for stat in region_stats %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--info">{{ stat.regionTag|upper }}</span>
                                </td>
                                <td class="rams-table__cell">{{ stat.total }}</td>
                                <td class="rams-table__cell">
                                    <span class="rams-badge {% if stat.avg_score >= 70 %}rams-badge--success{% elseif stat.avg_score >= 55 %}rams-badge--warning{% endif %}">
                                        {{ stat.avg_score|number_format(1) }}
                                    </span>
                                </td>
                                <td class="rams-table__cell">
                                    <a href="{{ path('app_lead_review', {region: stat.regionTag}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                                        {{ 'lead.review'|trans }}
                                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="rams-table__cell">  
                                    {{ 'lead.no_regional_data'|trans }}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# 🌍 Geographic Distribution Detail #}
        <div class="rams-module rams-mb-4">
            <div class="rams-module__header">
                <h3 class="rams-module__title">🌍 {{ 'lead.geographic_detail'|trans }}</h3>   
            </div>
            <div class="rams-module__content rams-module__content--flush">
                <div class="rams-table-container">
                    <table class="rams-table" aria-label="{{ 'lead.geographic_detail'|trans }}">
                        <thead>
                            <tr>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'lead.region'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'lead.total_leads'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'lead.avg_score'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if geographic_distribution is defined and geographic_distribution is not empty %}
                            {% for item in geographic_distribution %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--info">{{ item.region }}</span>
                                </td>
                                <td class="rams-table__cell">{{ item.count }}</td>
                                <td class="rams-table__cell">
                                    <span class="rams-badge {% if item.avg_score >= 70 %}rams-badge--success{% elseif item.avg_score >= 50 %}rams-badge--warning{% endif %}">
                                        {{ item.avg_score|number_format(1) }}
                                    </span>
                                </td>
                            </tr>
                            {% endfor %}
                            {% else %}
                            <tr>
                                <td colspan="3" class="rams-table__cell">  
                                    {{ 'lead.no_regional_data'|trans }}
                                </td>
                            </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Top Leads #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="rams-module__title">{{ 'lead.top_leads'|trans }}</h3>
            </div>
            <div class="rams-module__content rams-module__content--flush">
                <div class="rams-table-container">
                    <table class="rams-table" aria-label="{{ 'lead.top_leads'|trans }}">
                        <thead>
                            <tr>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'lead.score'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'company.title_singular'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'lead.region'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for lead in top_leads %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell">
                                    <span class="rams-badge {% if lead.leadScore >= 70 %}rams-badge--success{% elseif lead.leadScore >= 55 %}rams-badge--warning{% endif %}">
                                        {{ lead.leadScore }}
                                    </span>
                                </td>
                                <td class="rams-table__cell">
                                    <strong>{{ lead.companyName }}</strong>
                                    {% if lead.websiteRoot %}
                                    <br><a href="{{ lead.websiteRoot }}" target="_blank" class="rams-link rams-url-break">{{   lead.websiteRoot }}</a>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--info">{{ lead.regionTag|upper }}</span>
                                </td>
                                <td class="rams-table__cell">
                                    {% if lead.reviewStatus == 'approved' %}
                                        <span class="rams-andon rams-andon--success">{{   'lead.approved_leads'|trans }}</span>
                                    {% elseif lead.reviewStatus == 'denied' %}
                                        <span class="rams-andon rams-andon--error">{{   'lead.denied_leads'|trans }}</span>
                                    {% else %}
                                        <span class="rams-andon rams-andon--warning">{{   'common.pending'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    <a href="{{ path('app_lead_review', {region: lead.regionTag}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                                        {{ 'common.view'|trans }}
                                    </a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="rams-table__cell">  
                                    {{ 'lead.no_leads'|trans }}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# 💡 Actionable Insights #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="rams-module__title">💡 {{ 'lead.actionable_insights'|trans }}</h3>  
            </div>
            <div class="rams-module__content">
                {% if actionable_insights is defined and actionable_insights is not empty %}
                <div class="rams-stack rams-gap-2">
                    {% for insight in actionable_insights %}
                    <div class="rams-flex rams-justify-between rams-items-start rams-gap-2 rams-py-sm rams-border-b">  
                        <div class="rams-flex-1">
                            <div class="rams-flex rams-items-center rams-gap-2 rams-mb-1">
                                <span class="rams-badge rams-badge--{% if insight.priority == 'high' %}danger{% elseif insight.priority == 'medium' %}warning{% else %}info{% endif %} rams-text--xs">{{ insight.priority|upper }}</span>
                                <span class="rams-font-medium rams-text--sm">{{ insight.lead.companyName }}</span>
                            </div>
                            <p class="rams-text--sm rams-text--muted">{{ insight.message }}</p>
                        </div>
                        <div>
                            <span class="rams-badge {% if insight.score >= 70 %}rams-badge--success{% elseif insight.score >= 50 %}rams-badge--warning{% endif %}">{{ insight.score }}</span>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="rams-text--muted rams-text--sm rams-py-sm">{{ 'lead.no_actionable_insights'|trans }}</div>    
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
