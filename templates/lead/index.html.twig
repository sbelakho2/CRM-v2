{% extends 'base.html.twig' %}

{% block title %}{{ 'lead.title'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'lead.provisional_leads'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'lead.subtitle'|trans }}</p>
            </div>
        </div>

        {# Quick Stats #}
        <div class="rams-grid rams-grid--4">
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead.total_leads'|trans }}</span>
                    <span class="rams-metric">{{ total_leads }}</span>
                </div>
            </div>

            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead.pending_review'|trans }}</span>
                    <span class="rams-metric rams-text--warning">{{ pending_count }}</span>
                </div>
            </div>

            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead.approved_leads'|trans }}</span>
                    <span class="rams-metric rams-text--success">{{ approved_count }}</span>
                </div>
            </div>

            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead.denied_leads'|trans }}</span>
                    <span class="rams-metric rams-text--danger">{{ denied_count }}</span>
                </div>
            </div>
        </div>

        {# Action Cards #}
        <div class="rams-grid rams-grid--2">
            <div class="rams-module">
                <div class="rams-module__content rams-module__content--centered">
                    <svg class="rams-module__icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 11l3 3L22 4"/>
                        <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                    </svg>
                    <h4 class="rams-module__subtitle">{{ 'lead.review_leads_title'|trans }}</h4>
                    <p class="rams-module__description">
                        {{ 'lead.review_leads_description'|trans }}
                    </p>
                    <a href="{{ path('app_lead_review') }}" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                        </svg>
                        {{ 'lead.start_reviewing'|trans }}
                    </a>
                </div>
            </div>

            <div class="rams-module">
                <div class="rams-module__content rams-module__content--centered">
                    <svg class="rams-module__icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="20" x2="12" y2="10"/>
                        <line x1="18" y1="20" x2="18" y2="4"/>
                        <line x1="6" y1="20" x2="6" y2="16"/>
                    </svg>
                    <h4 class="rams-module__subtitle">{{ 'lead.dashboard_kpis'|trans }}</h4>
                    <p class="rams-module__description">
                        {{ 'lead.dashboard_description'|trans }}
                    </p>
                    <a href="{{ path('app_lead_dashboard') }}" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        {{ 'lead.view_dashboard'|trans }}
                    </a>
                </div>
            </div>
        </div>

        {# Information Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="rams-module__title">{{ 'lead.about_provisional'|trans }}</h3>
            </div>
            <div class="rams-module__content">
                <div class="rams-prose">
                    <p>
                        <strong>{{ 'lead.what_are_leads'|trans }}</strong> 
                        {{ 'lead.what_are_leads_desc'|trans }}
                    </p>
                    <p>
                        <strong>{{ 'lead.daily_drops'|trans }}</strong> 
                        {{ 'lead.daily_drops_desc'|trans }}
                    </p>
                    <p>
                        <strong>{{ 'lead.scoring_label'|trans }}</strong> 
                        {{ 'lead.scoring_desc'|trans }}
                    </p>
                    <p>
                        <strong>{{ 'lead.workflow_label'|trans }}</strong> 
                        {{ 'lead.workflow_desc'|trans }}
                    </p>
                </div>
                
                <div class="rams-andon rams-andon--info">
                    <strong>{{ 'lead.how_to_add'|trans }}</strong><br>
                    1. {{ 'lead.step_1'|trans }}<br>
                    2. {{ 'lead.step_2'|trans }}<br>
                    3. {{ 'lead.step_3'|trans }}<br>
                    4. {{ 'lead.step_4'|trans }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
