{% block javascripts %}
{{ parent() }}
<script>
function approveLead(leadId) {
    if (!confirm('{{ 'lead.confirm_approve'|trans }}')) return;
    fetch('/leads/approve/' + leadId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': '{{ csrf_token("lead_approve") }}' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            showToast(data.message);
            setTimeout(() => location.reload(), 1000);
        } else {
            showToast(data.message || '{{ 'common.error'|trans }}', 'error');
        }
    })
    .catch(e => showToast(e.message, 'error'));
}

function convertLead(leadId) {
    if (!confirm('{{ 'lead.confirm_convert'|trans }}')) return;
    fetch('/leads/convert/' + leadId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': '{{ csrf_token("lead_convert") }}' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            showToast(data.message);
            setTimeout(() => location.reload(), 1200);
        } else {
            showToast(data.message || '{{ 'common.error'|trans }}', 'error');
        }
    })
    .catch(e => showToast(e.message, 'error'));
}

function showToast(message, type) {
    type = type || 'success';
    const toast = document.createElement('div');
    toast.className = 'rams-alert ' + (type === 'success' ? 'rams-alert--success' : 'rams-alert--error') + ' rams-alert--toast';
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 5000);
}
</script>
{% endblock %}
