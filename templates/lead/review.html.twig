{% extends 'base.html.twig' %}

{% block title %}{{ 'lead.review'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'lead.review'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'lead.review_subtitle'|trans }}</p>
            </div>
            <div class="rams-page__actions">
                <a href="{{ path('app_lead_dashboard') }}" class="rams-btn uppercase">
                    <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 14V6l6-4 6 4v8M6 14V9h4v5"/>
                    </svg>
                    {{ 'lead.dashboard'|trans }}
                </a>
                <a href="{{ path('app_lead_export', {region: region_filter, status: status_filter}) }}" class="rams-btn rams-btn--primary uppercase">
                    <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M8 12V2M4 6l4-4 4 4M2 14h12"/>
                    </svg>
                    {{ 'common.export'|trans }} CSV
                </a>
            </div>
        </div>

        {# Filters #}
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <form method="get" class="rams-form rams-form--inline">
                    <div class="rams-form__group">
                        <label class="rams-dymo">{{ 'lead.region'|trans }}</label>
                        <select name="region" class="rams-form__select">
                            <option value="all" {% if region_filter == 'all' %}selected{% endif %}>{{ 'lead.all_regions'|trans }}</option>
                            {% for code, label in region_options %}
                                <option value="{{ code }}" {% if region_filter == code %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-dymo">{{ 'common.status'|trans }}</label>
                        <select name="status" class="rams-form__select">
                            <option value="all" {% if status_filter == 'all' %}selected{% endif %}>{{ 'lead.all_statuses'|trans }}</option>
                            <option value="pending" {% if status_filter == 'pending' %}selected{% endif %}>{{ 'lead.pending_review'|trans }}</option>
                            <option value="approved" {% if status_filter == 'approved' %}selected{% endif %}>{{ 'lead.approved_leads'|trans }}</option>
                            <option value="denied" {% if status_filter == 'denied' %}selected{% endif %}>{{ 'lead.denied_leads'|trans }}</option>
                        </select>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-dymo">{{ 'lead.min_score'|trans }}</label>
                        <input type="number" name="score_min" class="rams-form__input" value="{{ score_min }}" min="0" max="100">
                    </div>

                    <div class="rams-form__group rams-form__group--action">
                        <button type="submit" class="rams-btn rams-btn--primary uppercase">
                            <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M2 4h12M4 8h8M6 12h4"/>
                            </svg>
                            {{ 'common.apply'|trans }}
                        </button>
                    </div>
                </form>
            </div>
        </div>

        {# Regional Stats Summary #}
        {% if region_stats|length > 0 %}
        <div class="rams-grid rams-grid--4">
            {% for stat in region_stats %}
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ region_options[stat.regionTag] ?? (stat.regionTag ? stat.regionTag|upper : 'lead.unknown_region'|trans) }}</span>
                    <span class="rams-metric">{{ stat.total }}</span>
                    <span class="rams-metric__label">{{ 'lead.avg_score'|trans }}: {{ stat.avg_score|number_format(1) }}</span>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {# Leads Table #}
        <div class="rams-module">
            <div class="rams-module__content rams-module__content--flush">
                <div class="rams-table-container">
                    <table class="rams-table">
                        <thead class="rams-table__header">
                            <tr>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'lead.score'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.title_singular'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'lead.region'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'lead.location'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'lead.sectors'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'lead.contact_info'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for lead in leads %}
                            <tr class="rams-table__row" id="lead-{{ lead.id }}">
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--{% if lead.leadScore >= 70 %}success{% elseif lead.leadScore >= 55 %}warning{% else %}neutral{% endif %}">
                                        {{ lead.leadScore }}
                                    </span>
                                </td>
                                <td class="rams-table__cell">
                                    <strong>{{ lead.companyName }}</strong>
                                    {% if lead.websiteRoot %}
                                    <br><a href="{{ lead.websiteRoot }}" target="_blank" class="rams-link rams-link--sm">{{ lead.websiteRoot }}</a>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--info">{{ region_options[lead.regionTag]|default(lead.regionTag|upper) }}</span>
                                </td>
                                <td class="rams-table__cell">
                                    <span class="rams-text--sm">{{ lead.siteLocation ?? lead.usCityMetro ?? 'common.n_a'|trans }}</span>
                                </td>
                                <td class="rams-table__cell">
                                    {% if lead.sectorTags %}
                                        {% for sector in lead.sectorTags|slice(0, 2) %}
                                            <span class="rams-badge rams-badge rams-badge--sm">{{ sector }}</span>
                                        {% endfor %}
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    {% if lead.supplierPortalUrl %}
                                        <a href="{{ lead.supplierPortalUrl }}" target="_blank" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'lead.supplier_portal'|trans }}">
                                            <svg class="rams-icon rams-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                            </svg>
                                        </a>
                                    {% endif %}
                                    {% if lead.contactEmailsPublic %}
                                        <span class="rams-badge rams-badge--success rams-badge--sm" title="{{ lead.contactEmailsPublic|join(', ') }}">
                                            <svg class="rams-icon rams-icon--xs" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                            </svg>
                                            {{ lead.contactEmailsPublic|length }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    {% if lead.reviewStatus == 'approved' %}
                                        <span class="rams-andon rams-andon--success rams-andon--inline">{{ 'lead.approved_leads'|trans }}</span>
                                    {% elseif lead.reviewStatus == 'denied' %}
                                        <span class="rams-andon rams-andon--danger rams-andon--inline">{{ 'lead.denied_leads'|trans }}</span>
                                    {% else %}
                                        <span class="rams-andon rams-andon--warning rams-andon--inline">{{ 'common.pending'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    {% if lead.reviewStatus == 'pending' %}
                                        <button class="rams-btn rams-btn--primary rams-btn--sm" onclick="approveLead({{ lead.id }})" title="{{ 'lead.approve'|trans }}">
                                            <svg class="rams-icon rams-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                            </svg>
                                        </button>
                                        <button class="rams-btn rams-btn--danger rams-btn--sm" onclick="denyLead({{ lead.id }})" title="{{ 'lead.deny'|trans }}">
                                            <svg class="rams-icon rams-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                            </svg>
                                        </button>
                                    {% endif %}
                                    {% if lead.reviewStatus == 'approved' and not lead.company %}
                                        <button class="rams-btn rams-btn--primary rams-btn--sm" onclick="convertLead({{ lead.id }})" title="{{ 'lead.convert'|trans }}">
                                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                            </svg>
                                            {{ 'lead.add_to_companies'|trans }}
                                        </button>
                                    {% elseif safe_company_id(lead) %}
                                        <span class="rams-badge rams-badge--success">
                                            <svg class="rams-icon rams-icon--xs" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                            </svg>
                                            {{ 'lead.in_crm'|trans }}
                                        </span>
                                        <a href="{{ path('app_company_show', {id: safe_company_id(lead)}) }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'lead.view_company'|trans }}">
                                            <svg class="rams-icon rams-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                            </svg>
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="8" class="rams-table__cell rams-table__cell--empty">
                                    {{ 'lead.no_leads'|trans }}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function approveLead(leadId) {
    ramsConfirm('{{ 'lead.confirm_approve'|trans }}', function() {
        fetch(`/leads/approve/${leadId}`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'}
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                ramsAlert('{{ 'common.error'|trans }}: ' + data.message, {variant: 'error'});
            }
        });
    }, {title: '{{ 'lead.approve'|trans }}', variant: 'default'});
}

function denyLead(leadId) {
    const reason = prompt('{{ 'lead.deny_reason_prompt'|trans }}');
    
    fetch(`/leads/deny/${leadId}`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({reason: reason || '{{ 'lead.not_good_fit'|trans }}'})
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            ramsAlert('{{ 'common.error'|trans }}: ' + data.message, {variant: 'error'});
        }
    });
}

function convertLead(leadId) {
    ramsConfirm('{{ 'lead.confirm_convert'|trans }}', function() {
        fetch(`/leads/convert/${leadId}`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'}
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                ramsAlert('{{ 'lead.convert_success'|trans }}', {variant: 'success', onClose: function() { location.reload(); }});
            } else {
                ramsAlert('{{ 'common.error'|trans }}: ' + data.message, {variant: 'error'});
        }
    })
    .catch(error => {
        ramsAlert('{{ 'lead.convert_error'|trans }} ' + error.message, {variant: 'error'});
    });
    }, {title: '{{ 'lead.convert'|trans }}', variant: 'default'});
}
</script>
{% endblock %}
