{# Email Reset Password Template - Sensei-Rams Industrial Functionalist Design System #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'emails.reset_password.subject'|trans }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; background-color: #f5f5f5; color: #1a1a1a;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5; padding: 40px 20px;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; overflow: hidden;">
                    <!-- Header -->
                    <tr>
                        <td style="padding: 30px 40px; text-align: center; background-color: #1a1a1a; rams-border-bottom: 4px solid #FFBE00;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 600; letter-spacing: -0.02em;">🔐 {{ 'emails.reset_password.greeting'|trans }}</h1>
                            <p style="margin: 10px 0 0 0; color: #FFBE00; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em;">{{ 'app.company'|trans }}</p>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px;">
                            <p style="margin: 0 0 20px; color: #1a1a1a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.common.hello'|trans }} {{ user.firstName }},
                            </p>
                            
                            <p style="margin: 0 0 25px; color: #3a3a3a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.reset_password.received_request'|trans }}
                            </p>
                            
                            <p style="margin: 0 0 20px; color: #3a3a3a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.reset_password.body'|trans }}
                            </p>
                            
                            <!-- CTA Button -->
                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td align="center" style="padding: 15px 0 25px;">
                                        <a href="{{ resetUrl }}" style="display: inline-block; background-color: #FFBE00; color: #1a1a1a; padding: 16px 40px; text-decoration: none; font-weight: 600; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em;">{{ 'emails.reset_password.reset_button'|trans }}</a>
                                    </td>
                                </tr>
                            </table>
                            
                            <p style="margin: 0 0 10px; color: #4a4a4a; font-size: 14px;">
                                {{ 'emails.reset_password.copy_link'|trans }}:
                            </p>
                            
                            <!-- Link Box -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 25px;">
                                <tr>
                                    <td style="padding: 15px; background-color: #f5f5f5; rams-border-left: 3px solid #3a3a3a; font-family: 'Courier New', monospace; font-size: 12px; word-break: break-all; color: #3a3a3a;">
                                        {{ resetUrl }}
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- Warning Box -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #fef9e7; rams-border-left: 4px solid #FFBE00; margin: 0 0 25px;">
                                <tr>
                                    <td style="padding: 15px;">
                                        <p style="margin: 0; color: #1a1a1a; font-size: 14px; font-weight: 600;">
                                            ⏰ {{ 'emails.reset_password.expires'|trans }}
                                        </p>
                                    </td>
                                </tr>
                            </table>
                            
                            <p style="margin: 0 0 20px; color: #3a3a3a; font-size: 15px; line-height: 1.6;">
                                <strong>{{ 'emails.reset_password.ignore'|trans }}</strong>
                            </p>
                            
                            <!-- Security Notes -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #2a2a2a; margin: 25px 0;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <p style="margin: 0 0 12px; color: #FFBE00; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">{{ 'emails.reset_password.security_title'|trans }}:</p>
                                        <ul style="margin: 0; padding-left: 18px; color: #e0e0e0; font-size: 13px; line-height: 1.8;">
                                            <li>{{ 'emails.reset_password.security_1'|trans }}</li>
                                            <li>{{ 'emails.reset_password.security_2'|trans }}</li>
                                            <li>{{ 'emails.reset_password.security_3'|trans }}</li>
                                        </ul>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 30px 40px; background-color: #1a1a1a; rams-border-top: 4px solid #FFBE00;">
                            <p style="margin: 0 0 10px; color: #888888; font-size: 13px; text-align: center; line-height: 1.6;">
                                {{ 'emails.reset_password.automated_message'|trans }}
                            </p>
                            <p style="margin: 0; color: #5a5a5a; font-size: 12px; text-align: center;">
                                &copy; {{ "now"|date("Y") }} {{ 'app.company'|trans }}. {{ 'emails.common.all_rights_reserved'|trans }}
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
