{% apply inline_css %}
<style>
    .email-container { 
        max-width: 600px; 
        margin: 0 auto; 
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.5;
        color: #333;
    }
    .header {
        background: #8B7355;
        color: white;
        padding: 20px;
        text-align: center;
    }
    .content {
        padding: 20px;
        background: #ffffff;
    }
    .details {
        margin: 20px 0;
        padding: 15px;
        background: #f5f5f5;
        border-radius: 5px;
    }
    .button {
        display: inline-block;
        padding: 10px 20px;
        background: #8B7355;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        margin: 20px 0;
    }
</style>

<div class="email-container">
    <div class="header">
        <h1>Webinar Registration Confirmation</h1>
    </div>
    
    <div class="content">
        <p>Dear {{ attendee.name }},</p>
        
        <p>Thank you for registering for our upcoming webinar:</p>
        
        <div class="details">
            <h2>{{ webinar.title }}</h2>
            <p><strong>Date & Time:</strong> {{ webinar.scheduledDate|date('F d, Y - H:i') }}</p>
            {% if webinar.meetingUrl %}
                <p><strong>Meeting Link:</strong> <a href="{{ webinar.meetingUrl }}">{{ webinar.meetingUrl }}</a></p>
            {% endif %}
            {% if webinar.description %}
                <p><strong>Description:</strong><br>{{ webinar.description }}</p>
            {% endif %}
        </div>

        {% if webinar.meetingUrl %}
            <a href="{{ webinar.meetingUrl }}" class="button">Join Webinar</a>
        {% endif %}
        
        <p>Please add this event to your calendar. We look forward to your participation!</p>
        
        <p>Best regards,<br>
        The {{ webinar.organization|default('Starz Morocco') }} Team</p>
    </div>
</div>
{% endapply %}