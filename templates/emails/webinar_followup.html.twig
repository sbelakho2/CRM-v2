{# Email Webinar Followup Template - Sensei-Rams Industrial Functionalist Design System #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'emails.webinar_followup.subject'|trans }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; background-color: #f5f5f5; color: #1a1a1a;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5; padding: 40px 20px;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; overflow: hidden;">
                    <!-- Header -->
                    <thead>
                        <tr>
                            <th scope="col" style="padding: 35px 40px; text-align: center; background-color: #1a1a1a; border-bottom: 4px solid #FFBE00;">
                                <h1 style="margin: 0; color: #FFBE00; font-size: 28px; font-weight: 600; letter-spacing: -0.02em;">{{ 'emails.webinar_followup.greeting'|trans }}</h1>
                                <p style="margin: 10px 0 0 0; color: #666666; font-size: 13px; text-transform: uppercase; letter-spacing: 0.1em;">{{ 'app.company'|trans }}</p>
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px;">
                            <p style="margin: 0 0 20px; color: #1a1a1a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.webinar_followup.hi'|trans }} {{ attendee.name }},
                            </p>

                            <p style="margin: 0 0 20px; color: #3a3a3a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.webinar_followup.thank_you_attending'|trans }} <strong>{{ webinar.title }}</strong> {{ 'emails.webinar_followup.on_date'|trans }} {{ webinar.scheduledDate|date('F d, Y') }}.
                            </p>

                            <p style="margin: 0 0 25px; color: #3a3a3a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.webinar_followup.hope_valuable'|trans }}
                            </p>

                            {% if webinar.recordingUrl %}
                            <!-- Recording Section -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f9f9f9; border-left: 4px solid #FFBE00; margin: 25px 0;">
                                <caption style="padding: 25px 25px 0 25px; color: #1a1a1a; font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; text-align: left;">
                                    {{ 'emails.webinar_followup.recording'|trans }}
                                </caption>
                                <tr>
                                    <td style="padding: 12px 25px 25px 25px;">
                                        <p style="margin: 0 0 15px; color: #4a4a4a; font-size: 14px; line-height: 1.5;">
                                            {{ 'emails.webinar_followup.recording_description'|trans }}
                                        </p>
                                        <a href="{{ webinar.recordingUrl }}" style="display: inline-block; padding: 12px 28px; background-color: #FFBE00; color: #1a1a1a; text-decoration: none; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">
                                            {{ 'emails.webinar_followup.watch_recording'|trans }}
                                        </a>
                                    </td>
                                </tr>
                            </table>
                            {% endif %}

                            <p style="margin: 30px 0 20px; color: #3a3a3a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.webinar_followup.questions_help'|trans }}
                            </p>

                            <p style="margin: 25px 0 0; color: #1a1a1a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.common.best_regards'|trans }},<br>
                                <strong>{{ webinar.presenter ?? ('emails.webinar_followup.default_presenter'|trans) }}</strong>
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 30px 40px; background-color: #1a1a1a; border-top: 4px solid #FFBE00;">
                            <p style="margin: 0 0 10px; color: #ffffff; font-size: 14px; text-align: center; font-weight: 600;">
                                {{ 'app.company'|trans }}
                            </p>
                            <p style="margin: 0; color: #5a5a5a; font-size: 12px; text-align: center; line-height: 1.5;">
                                {{ 'emails.common.email_sent_to'|trans }} {{ attendee.email }}
                            </p>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
