{# Email Meeting Cancellation - Sensei-Rams Industrial Functionalist Design System #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'emails.meeting_cancellation.subject'|trans }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; background-color: #f5f5f5; color: #1a1a1a;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5; padding: 40px 20px;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; overflow: hidden;">
                    <!-- Header -->
                    <thead>
                        <tr>
                            <th scope="col" style="padding: 30px 40px; text-align: center; background-color: #1a1a1a; border-bottom: 4px solid #FFBE00;">
                                <h1 style="margin: 0; color: #ffffff; font-size: 22px; font-weight: 600; letter-spacing: -0.02em;">{{ 'emails.meeting_cancellation.subject'|trans }}</h1>
                                <p style="margin: 10px 0 0 0; color: #FFBE00; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em;">{{ 'app.company'|trans }}</p>
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px;">
                            <p style="margin: 0 0 20px; color: #1a1a1a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.meeting_cancellation.dear'|trans }} {{ contactName }},
                            </p>
                            <p style="margin: 0 0 20px; color: #1a1a1a; font-size: 16px; line-height: 1.6;">
                                {{ 'emails.meeting_cancellation.body'|trans }}
                            </p>
                            <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 24px; border: 1px solid #e0e0e0; border-radius: 6px;">
                                <tr>
                                    <th scope="row" style="padding: 12px 16px; text-align: left; background-color: #fafafa; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; color: #666666;">{{ 'emails.meeting_cancellation.title'|trans }}</th>
                                    <td style="padding: 12px 16px; font-size: 15px;">{{ slot.title }}</td>
                                </tr>
                                <tr>
                                    <th scope="row" style="padding: 12px 16px; text-align: left; background-color: #fafafa; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; color: #666666;">{{ 'emails.meeting_cancellation.date'|trans }}</th>
                                    <td style="padding: 12px 16px; font-size: 15px;">{{ slot.startTime|date('l, F j, Y') }} {{ slot.startTime|date('H:i') }} – {{ slot.endTime|date('H:i') }} ({{ slot.timezone }})</td>
                                </tr>
                            </table>
                            <p style="margin: 0; color: #666666; font-size: 13px; line-height: 1.6;">
                                {{ 'emails.meeting_cancellation.footer'|trans }}
                            </p>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
