{# Email Verification Template - Sensei-Rams style #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'emails.verification.subject'|trans }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; background-color: #f5f5f5; color: #1a1a1a;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5; padding: 40px 20px;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; overflow: hidden;">
                    <thead>
                        <tr>
                            <th scope="col" style="padding: 30px 40px; text-align: center; background-color: #1a1a1a; border-bottom: 4px solid #FFBE00;">
                                <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 600; letter-spacing: -0.02em;">{{ 'emails.verification.subject'|trans }}</h1>
                                <p style="margin: 10px 0 0 0; color: #FFBE00; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em;">{{ 'app.company'|trans }}</p>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 40px;">
                                <p style="margin: 0 0 20px; color: #1a1a1a; font-size: 16px; line-height: 1.6;">
                                    {{ 'emails.common.hello'|trans }} {{ user.firstName }},
                                </p>

                                <p style="margin: 0 0 25px; color: #3a3a3a; font-size: 16px; line-height: 1.6;">
                                    {{ 'emails.verification.welcome'|trans({'%company%': 'app.company'|trans}) }}
                                </p>

                                <table width="100%" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td align="center" style="padding: 15px 0 25px;">
                                            <a href="{{ verificationUrl }}" style="display: inline-block; background-color: #FFBE00; color: #1a1a1a; padding: 16px 40px; text-decoration: none; font-weight: 600; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em;">{{ 'emails.verification.verify_button'|trans }}</a>
                                        </td>
                                    </tr>
                                </table>

                                <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 25px;">
                                    <caption style="margin: 0 0 10px; color: #4a4a4a; font-size: 14px; text-align: left;">
                                        {{ 'emails.verification.copy_link'|trans }}:
                                    </caption>
                                    <tr>
                                        <td style="padding: 15px; background-color: #f5f5f5; border-left: 3px solid #3a3a3a; font-family: 'Courier New', monospace; font-size: 12px; word-break: break-all; color: #3a3a3a;">
                                            {{ verificationUrl }}
                                        </td>
                                    </tr>
                                </table>

                                <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #fef9e7; border-left: 4px solid #FFBE00; margin: 0 0 25px;">
                                    <tr>
                                        <td style="padding: 15px;">
                                            <p style="margin: 0; color: #1a1a1a; font-size: 14px; font-weight: 600;">
                                                {{ 'emails.verification.expires'|trans }}
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #2a2a2a; margin: 25px 0;">
                                    <tr>
                                        <td style="padding: 20px;" dir="rtl">
                                            <p style="margin: 0; color: #e0e0e0; font-size: 13px; line-height: 1.8; text-align: right;">
                                                {{ 'emails.verification.arabic_note'|trans }}
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 30px 40px; background-color: #1a1a1a; border-top: 4px solid #FFBE00;">
                                <p style="margin: 0 0 10px; color: #666666; font-size: 13px; text-align: center; line-height: 1.6;">
                                    {{ 'emails.common.automated_message'|trans }}
                                </p>
                                <p style="margin: 0; color: #5a5a5a; font-size: 12px; text-align: center;">
                                    &copy; {{ "now"|date("Y") }} {{ 'app.company'|trans }}. {{ 'emails.common.all_rights_reserved'|trans }}
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
