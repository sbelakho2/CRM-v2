{# Email Verification Template - Sensei-Rams style, bilingual EN/FR/AR note #}
<!DOCTYPE html>
<html>
<head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>Verify your email / Vérifiez votre e-mail</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; background-color: #f5f5f5; color: #1a1a1a;"> <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5; padding: 40px 20px;"> <tr> <td align="center"> <table width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; overflow: hidden;"> <!-- Header --> <tr> <td style="padding: 30px 40px; text-align: center; background-color: #1a1a1a; border-bottom: 4px solid #FFBE00;"> <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 600; letter-spacing: -0.02em;">Verify your email / Vérifiez votre e-mail</h1> <p style="margin: 10px 0 0 0; color: #FFBE00; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em;">{{ 'app.company'|trans }}</p> </td> </tr> <!-- Content --> <tr> <td style="padding: 40px;"> <p style="margin: 0 0 20px; color: #1a1a1a; font-size: 16px; line-height: 1.6;"> {{ 'emails.common.hello'|trans }} {{ user.firstName }}, </p> <p style="margin: 0 0 25px; color: #3a3a3a; font-size: 16px; line-height: 1.6;"> Welcome to {{ 'app.company'|trans }}! Please confirm your email address to activate your account. <br>Bienvenue sur {{ 'app.company'|trans }} ! Veuillez confirmer votre adresse e-mail pour activer votre compte. </p> <!-- CTA Button --> <table width="100%" cellpadding="0" cellspacing="0"> <tr> <td align="center" style="padding: 15px 0 25px;"> <a href="{{ verificationUrl }}" style="display: inline-block; background-color: #FFBE00; color: #1a1a1a; padding: 16px 40px; text-decoration: none; font-weight: 600; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em;">Verify email / Vérifier l'e-mail</a> </td> </tr> </table> <p style="margin: 0 0 10px; color: #4a4a4a; font-size: 14px;"> If the button does not work, copy this link: / Si le bouton ne fonctionne pas, copiez ce lien : </p> <!-- Link Box --> <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 25px;"> <tr> <td style="padding: 15px; background-color: #f5f5f5; border-left: 3px solid #3a3a3a; font-family: 'Courier New', monospace; font-size: 12px; word-break: break-all; color: #3a3a3a;"> {{ verificationUrl }} </td> </tr> </table> <!-- Expiry Note --> <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #fef9e7; border-left: 4px solid #FFBE00; margin: 0 0 25px;"> <tr> <td style="padding: 15px;"> <p style="margin: 0; color: #1a1a1a; font-size: 14px; font-weight: 600;"> This link expires in 7 days / Ce lien expire dans 7 jours. </p> </td> </tr> </table> <!-- Arabic note --> <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #2a2a2a; margin: 25px 0;"> <tr> <td style="padding: 20px;" dir="rtl"> <p style="margin: 0; color: #e0e0e0; font-size: 13px; line-height: 1.8; text-align: right;"> يرجى تأكيد عنوان بريدك الإلكتروني لتفعيل حسابك. الرابط صالح لمدة 7 أيام. </p> </td> </tr> </table> </td> </tr> <!-- Footer --> <tr> <td style="padding: 30px 40px; background-color: #1a1a1a; border-top: 4px solid #FFBE00;"> <p style="margin: 0 0 10px; color: #666666; font-size: 13px; text-align: center; line-height: 1.6;"> {{ 'emails.reset_password.automated_message'|trans }} </p> <p style="margin: 0; color: #5a5a5a; font-size: 12px; text-align: center;"> &copy; {{ "now"|date("Y") }} {{ 'app.company'|trans }}. {{ 'emails.common.all_rights_reserved'|trans }} </p> </td> </tr> </table> </td> </tr> </table>
</body>
</html>
