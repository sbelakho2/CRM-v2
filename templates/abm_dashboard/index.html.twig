{% extends 'base.html.twig' %}

{% block title %}{{ 'abm_dashboard.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <div class="rams-page-header">
        <h1 class="rams-page-title">{{ 'abm_dashboard.title'|trans }}</h1>
        <p class="rams-page-subtitle">{{ 'abm_dashboard.subtitle'|trans }}</p>
    </div>

    <!-- Quick Stats -->
    <div class="rams-grid rams-metrics-grid--4col rams-mb-6">
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'abm_dashboard.active_accounts'|trans }}</span>
                    <span class="rams-metric__value">{{ active_accounts | default(0) }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'abm_dashboard.active_playbooks'|trans }}</span>
                    <span class="rams-metric__value">{{ active_playbooks | default(0) }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'abm_dashboard.recent_engagements'|trans }}</span>
                    <span class="rams-metric__value">{{ recent_engagements | default(0) }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'abm_dashboard.conversion_rate'|trans }}</span>
                    <span class="rams-metric__value">{{ conversion_rate | default('0%') }}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Navigation -->
    <div class="rams-grid rams-metrics-grid--3col rams-mb-6">
        <a href="{{ path('abm_dashboard_accounts') }}" class="rams-module rams-module--hoverable rams-no-underline">
            <div class="rams-module__content">
                <h2 class="rams-module__title">👥 {{ 'abm_dashboard.accounts'|trans }}</h2>
                <p class="rams-text--muted rams-text--xs">{{ 'abm_dashboard.accounts_subtitle'|trans }}</p>
                <div class="rams-flex rams-justify-between rams-items-center rams-mt-4">
                    <span class="rams-metric__value rams-text--lg">{{ active_accounts | default(0) }}</span>
                    <span class="rams-text--muted">→</span>
                </div>
            </div>
        </a>

        <a href="{{ path('abm_dashboard_playbooks') }}" class="rams-module rams-module--hoverable rams-no-underline">
            <div class="rams-module__content">
                <h2 class="rams-module__title">📋 {{ 'abm_dashboard.playbooks'|trans }}</h2>
                <p class="rams-text--muted rams-text--xs">{{ 'abm_dashboard.playbooks_subtitle'|trans }}</p>
                <div class="rams-flex rams-justify-between rams-items-center rams-mt-4">
                    <span class="rams-metric__value rams-text--lg">{{ active_playbooks | default(0) }}</span>
                    <span class="rams-text--muted">→</span>
                </div>
            </div>
        </a>

        <a href="{{ path('abm_dashboard_accounts') }}" class="rams-module rams-module--hoverable rams-no-underline">
            <div class="rams-module__content">
                <h2 class="rams-module__title">📊 {{ 'abm_dashboard.analytics'|trans }}</h2>
                <p class="rams-text--muted rams-text--xs">{{ 'abm_dashboard.analytics_subtitle'|trans }}</p>
                <div class="rams-flex rams-justify-between rams-items-center rams-mt-4">
                    <span class="rams-text--sm rams-uppercase rams-font-mono">{{ 'abm_dashboard.view_reports'|trans }}</span>
                    <span class="rams-text--muted">→</span>
                </div>
            </div>
        </a>
    </div>

    <!-- Engagement Heat Map -->
    {% if heatMapError %}
        <div class="rams-alert rams-alert--error">
            <p class="rams-alert__title">{{ 'abm_dashboard.heat_map_error'|trans }}:</p>
            <p>{{ heatMapError }}</p>
        </div>
    {% elseif heatMapCompanies is defined %}
        {% if heatMapCompanies|length > 0 %}
            {% include 'components/engagement_heat_map.html.twig' with {'companies': heatMapCompanies} %}
        {% else %}
            <div class="rams-alert rams-alert--warning">
                <p class="rams-alert__title">{{ 'abm_dashboard.no_engagement_data'|trans }}</p>
                <p>{{ 'abm_dashboard.add_activities_hint'|trans }}</p>
            </div>
        {% endif %}
    {% else %}
        <div class="rams-alert rams-alert--error">
            <p>{{ 'abm_dashboard.heatmap_missing'|trans }}</p>
        </div>
    {% endif %}

    <!-- Recent Activity -->
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'abm_dashboard.recent_activity'|trans }}</h2>
        </div>
        <div class="rams-module__content">
            <div class="rams-stack">
                {% if activities | default([]) %}
                    {% for activity in activities %}
                        <div class="rams-list__item">
                            <div class="rams-list__content">
                                <p class="rams-list__title">{{ activity.title | default('abm_dashboard.activity_default'|trans) }}</p>
                                <p class="rams-text--muted">{{ activity.description | default('') }}</p>
                                <p class="rams-dymo">{{ activity.timestamp is defined and activity.timestamp ? activity.timestamp | date('M d, Y H:i') : 'common.unknown'|trans }}</p>
                            </div>
                            <span class="rams-badge">
                                {{ activity.type | default('abm_dashboard.activity_update'|trans) }}
                            </span>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="rams-empty-state">{{ 'abm_dashboard.no_recent_activity'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Quick Start -->
    <div class="rams-module rams-module--inset">
        <div class="rams-module__content">
            <h2 class="rams-module__title">🚀 {{ 'abm_dashboard.quick_start'|trans }}</h2>
            <ol class="rams-list rams-list">
                <li><a href="{{ path('abm_dashboard_accounts') }}">{{ 'abm_dashboard.accounts'|trans }}</a> {{ 'abm_dashboard.quick_start_step1'|trans|lower }}</li>
                <li><a href="{{ path('abm_dashboard_playbooks') }}">{{ 'abm_dashboard.playbooks'|trans }}</a> {{ 'abm_dashboard.quick_start_step2'|trans|lower }}</li>
                <li>{{ 'abm_dashboard.quick_start_step3'|trans }}</li>
                <li>{{ 'abm_dashboard.quick_start_step4'|trans }}</li>
                <li>{{ 'abm_dashboard.quick_start_step5'|trans }}</li>
            </ol>
        </div>
    </div>
</div>
{% endblock %}
