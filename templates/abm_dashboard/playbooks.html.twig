{% extends 'base.html.twig' %}

{% block title %}{{ 'abm_dashboard.playbooks'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'playbook.title'|trans }}</h1>
        </div>
        <a href="{{ path('app_email_campaign_new') }}" class="rams-btn rams-btn--primary">
            + {{ 'playbook.new_playbook'|trans }}
        </a>
    </div>

    <!-- Filter and Search -->
    <div class="rams-module">
        <div class="rams-module__content">
            <div class="rams-grid rams-grid--4">
                <input 
                    type="text" 
                    placeholder="{{ 'common.search'|trans }}..." 
                    class="rams-input"
                >
                <select class="rams-select">
                    <option value="">{{ 'abm_dashboard.all_statuses'|trans }}</option>
                    <option value="active">{{ 'common.active'|trans }}</option>
                    <option value="inactive">{{ 'common.inactive'|trans }}</option>
                    <option value="draft">{{ 'email_campaign.statuses.draft'|trans }}</option>
                    <option value="archived">{{ 'admin.datasets.archived'|trans }}</option>
                </select>
                <select class="rams-select">
                    <option value="">{{ 'abm_dashboard.industry_all'|trans }}</option>
                    <option value="technology">{{ 'abm_dashboard.industry_technology'|trans }}</option>
                    <option value="finance">{{ 'abm_dashboard.industry_finance'|trans }}</option>
                    <option value="healthcare">{{ 'abm_dashboard.industry_healthcare'|trans }}</option>
                    <option value="retail">{{ 'abm_dashboard.industry_retail'|trans }}</option>
                </select>
                <button class="rams-btn rams-btn--primary">
                    {{ 'common.filter'|trans }}
                </button>
            </div>
        </div>
    </div>

    <!-- Playbooks Grid -->
    <div class="rams-grid rams-grid--3">
        <!-- Playbook Card 1 -->
        <div class="rams-module">
            <div class="rams-module__header rams-module__header--success">
                <h3 class="rams-module__title">{{ 'abm_dashboard.sample_playbook_1_title'|trans }}</h3>
                <p class="rams-text-muted">{{ 'abm_dashboard.created_weeks_ago'|trans({'%count%': 2}) }}</p>
            </div>
            <div class="rams-module__content">
                <div class="rams-stack">
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'common.status'|trans }}</span>
                        <span class="rams-badge rams-badge--success">{{ 'common.active'|trans }}</span>
                    </div>
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'playbook.target_accounts'|trans }}</span>
                        <span class="rams-metric__value">{{ playbooks[0].account_count | default(24) }} {{ 'abm_dashboard.accounts_label'|trans }}</span>
                    </div>
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'playbook.success_rate'|trans }}</span>
                        <span class="rams-metric__value">{{ playbooks[0].success_rate | default(68) }}%</span>
                    </div>
                </div>
            </div>
            <div class="rams-module__footer">
                <a href="{{ path('abm_dashboard_accounts') }}" class="rams-btn rams-btn--secondary">
                    {{ 'common.view'|trans }}
                </a>
                <a href="{{ path('app_email_campaign_index') }}" class="rams-btn rams-btn--ghost">
                    {{ 'common.edit'|trans }}
                </a>
            </div>
        </div>

        <!-- Playbook Card 2 -->
        <div class="rams-module">
            <div class="rams-module__header rams-module__header--warning">
                <h3 class="rams-module__title">{{ 'abm_dashboard.sample_playbook_2_title'|trans }}</h3>
                <p class="rams-text-muted">{{ 'abm_dashboard.created_weeks_ago'|trans({'%count%': 4}) }}</p>
            </div>
            <div class="rams-module__content">
                <div class="rams-stack">
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'common.status'|trans }}</span>
                        <span class="rams-badge rams-badge--success">{{ 'common.active'|trans }}</span>
                    </div>
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'playbook.target_accounts'|trans }}</span>
                        <span class="rams-metric__value">{{ playbooks[1].account_count | default(18) }} {{ 'abm_dashboard.accounts_label'|trans }}</span>
                    </div>
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'playbook.success_rate'|trans }}</span>
                        <span class="rams-metric__value">{{ playbooks[1].success_rate | default(52) }}%</span>
                    </div>
                </div>
            </div>
            <div class="rams-module__footer">
                <a href="{{ path('abm_dashboard_accounts') }}" class="rams-btn rams-btn--secondary">
                    {{ 'common.view'|trans }}
                </a>
                <a href="{{ path('app_email_campaign_index') }}" class="rams-btn rams-btn--ghost">
                    {{ 'common.edit'|trans }}
                </a>
            </div>
        </div>

        <!-- Playbook Card 3 -->
        <div class="rams-module">
            <div class="rams-module__header rams-module__header--info">
                <h3 class="rams-module__title">{{ 'abm_dashboard.sample_playbook_3_title'|trans }}</h3>
                <p class="rams-text-muted">{{ 'abm_dashboard.created_weeks_ago'|trans({'%count%': 1}) }}</p>
            </div>
            <div class="rams-module__content">
                <div class="rams-stack">
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'common.status'|trans }}</span>
                        <span class="rams-badge rams-badge--warning">{{ 'email_campaign.statuses.draft'|trans }}</span>
                    </div>
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'playbook.target_accounts'|trans }}</span>
                        <span class="rams-metric__value">{{ playbooks[2].account_count | default(12) }} {{ 'abm_dashboard.accounts_label'|trans }}</span>
                    </div>
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'playbook.success_rate'|trans }}</span>
                        <span class="rams-metric__value">{{ playbooks[2].success_rate | default(0) }}%</span>
                    </div>
                </div>
            </div>
            <div class="rams-module__footer">
                <a href="{{ path('abm_dashboard_accounts') }}" class="rams-btn rams-btn--secondary">
                    {{ 'common.view'|trans }}
                </a>
                <a href="{{ path('app_email_campaign_index') }}" class="rams-btn rams-btn--ghost">
                    {{ 'common.edit'|trans }}
                </a>
            </div>
        </div>

        <!-- Playbook Card 4 -->
        <div class="rams-module">
            <div class="rams-module__header rams-module__header--danger">
                <h3 class="rams-module__title">{{ 'abm_dashboard.sample_playbook_4_title'|trans }}</h3>
                <p class="rams-text-muted">{{ 'abm_dashboard.created_weeks_ago'|trans({'%count%': 3}) }}</p>
            </div>
            <div class="rams-module__content">
                <div class="rams-stack">
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'common.status'|trans }}</span>
                        <span class="rams-badge">{{ 'common.inactive'|trans }}</span>
                    </div>
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'playbook.target_accounts'|trans }}</span>
                        <span class="rams-metric__value">{{ playbooks[3].account_count | default(31) }} {{ 'abm_dashboard.accounts_label'|trans }}</span>
                    </div>
                    <div class="rams-metric">
                        <span class="rams-dymo">{{ 'playbook.success_rate'|trans }}</span>
                        <span class="rams-metric__value">{{ playbooks[3].success_rate | default(45) }}%</span>
                    </div>
                </div>
            </div>
            <div class="rams-module__footer">
                <a href="{{ path('abm_dashboard_accounts') }}" class="rams-btn rams-btn--secondary">
                    {{ 'common.view'|trans }}
                </a>
                <a href="{{ path('app_email_campaign_index') }}" class="rams-btn rams-btn--ghost">
                    {{ 'common.edit'|trans }}
                </a>
            </div>
        </div>

        <!-- Create New Playbook Card -->
        <a href="{{ path('app_playbook_new') }}" class="rams-module rams-module--dashed rams-module--clickable">
            <div class="rams-empty-state">
                <svg class="rams-empty-state__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                <h3 class="rams-empty-state__title">{{ 'playbook.new_playbook'|trans }}</h3>
                <p class="rams-empty-state__text">{{ 'playbook.create_first'|trans }}</p>
            </div>
        </a>
    </div>

    <!-- Playbook Performance Overview -->
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'abm_dashboard.performance_overview'|trans }}</h2>
        </div>
        <div class="rams-module__content">
            <div class="rams-grid rams-grid--4">
                <div class="rams-metric">
                    <span class="rams-dymo">{{ 'abm_dashboard.total_accounts'|trans }}</span>
                    <span class="rams-metric__value rams-metric__value--lg">85</span>
                </div>
                <div class="rams-metric">
                    <span class="rams-dymo">{{ 'abm_dashboard.active_playbooks'|trans }}</span>
                    <span class="rams-metric__value rams-metric__value--lg rams-text-success">3</span>
                </div>
                <div class="rams-metric">
                    <span class="rams-dymo">{{ 'abm_dashboard.avg_label'|trans }} {{ 'playbook.success_rate'|trans }}</span>
                    <span class="rams-metric__value rams-metric__value--lg rams-text-info">55%</span>
                </div>
                <div class="rams-metric">
                    <span class="rams-dymo">{{ 'abm_dashboard.conversion_rate'|trans }}</span>
                    <span class="rams-metric__value rams-metric__value--lg">12%</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
