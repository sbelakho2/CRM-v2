{% extends 'base.html.twig' %}

{% block title %}{{ 'abm_dashboard.playbooks'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <nav class="rams-breadcrumb rams-mb-2">
                <ol class="rams-breadcrumb__list">
                    <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item"><a href="{{ path('abm_dashboard_index') }}" class="rams-breadcrumb__link">{{ 'nav.abm_dashboard'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'abm_dashboard.playbooks'|trans }}</li>
                </ol>
            </nav>
            <h1 class="rams-page-title">{{ 'playbook.title'|trans }}</h1>
        </div>
        <div class="rams-page-actions mobile-stack">
            <a href="{{ path('app_playbook_new') }}" class="rams-btn rams-btn--primary rams-uppercase"> 
                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 3v10M3 8h10"/>
                </svg>
                {{ 'playbook.new_playbook'|trans }}
            </a>
        </div>
    </div>

    {# Filter and Search #}
    <div class="rams-module">
        <div class="rams-module__content">
            <form class="rams-form rams-grid rams-grid--4 mobile-stack">
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'common.search'|trans }}</label>
                    <input type="text" placeholder="{{ 'common.search'|trans }}..." class="rams-form__input">
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'common.status'|trans }}</label>
                    <select class="rams-form__select">
                        <option value="">{{ 'abm_dashboard.all_statuses'|trans }}</option>
                        <option value="active">{{ 'common.active'|trans }}</option>
                        <option value="inactive">{{ 'common.inactive'|trans }}</option>
                        <option value="draft">{{ 'email_campaign.statuses.draft'|trans }}</option>
                        <option value="archived">{{ 'administration.datasets.archived'|trans }}</option>
                    </select>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'company.industry'|trans }}</label>
                    <select class="rams-form__select">
                        <option value="">{{ 'abm_dashboard.industry_all'|trans }}</option>
                        <option value="technology">{{ 'abm_dashboard.industry_technology'|trans }}</option>
                        <option value="finance">{{ 'abm_dashboard.industry_finance'|trans }}</option>
                        <option value="healthcare">{{ 'abm_dashboard.industry_healthcare'|trans }}</option>
                        <option value="retail">{{ 'abm_dashboard.industry_retail'|trans }}</option>
                    </select>
                </div>
                <div class="rams-form__group rams-form__group--actions">
                    <button type="submit" class="rams-btn rams-uppercase rams-w-full">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="7" cy="7" r="4"/>
                            <path d="M11 11l3 3"/>
                        </svg>
                        {{ 'common.filter'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Playbooks Grid #}
    <div class="rams-grid rams-grid--3 rams-gap-6">
        {% if playbooks|default([])|length > 0    
                     
                     
                     
                     
         %}

        {% for playbook  in playbooks %} {% set run_stats = stats[playbook.id]|default({'totalRuns': 0, 'successfulRuns': 0, 'lastRun': null}) %} {% set success_rate = run_stats.totalRuns > 0 ? (run_stats.successfulRuns / run_stats.totalRuns * 100)|round : null  %}
            <div class="rams-module rams-module--hoverable">
                <div class="rams-module__header">
                    <div>
                        <h3 class="rams-heading rams-heading--3 rams-mb-1">{{ playbook.name  }}</h3>
                        <p class="rams-text--muted rams-text--xs rams-font-mono rams-uppercase">{{ 'playbook.created'|trans }}: {{ playbook.createdAt ? playbook.createdAt|date('Y-m-d') : 'common.n_a'|trans   }}</p>
                    </div>
                    <span class="rams-badge {% if playbook.isActive %}rams-badge--success{% endif %}">
                        {{ (playbook.isActive    ? 'playbook.active'  : 'playbook.inactive')|trans        }}
                    </span>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-4">
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'playbook.runs'|trans  }}</span>
                            <span class="rams-metric__value rams-text--lg">{{ run_stats.totalRuns }}</span>         
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'playbook.success_rate'|trans }}</span>
                            <span class="rams-metric__value rams-text--lg {% if success_rate >= 60 %}rams-text--success{% elseif success_rate >= 40 %}rams-text--info{% endif %}">
                                {% if success_rate is null %}{{ 'common.n_a'|trans }}{% else %}{{ success_rate }}%{% endif %}
                            </span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'playbook.last_run'|trans }}</span>
                            <span class="rams-metric__value rams-text--sm rams-text--muted">{{ run_stats.lastRun ? run_stats.lastRun.triggeredAt|date('Y-m-d H:i') : 'playbook.never'|trans }}</span>
                        </div>
                    </div>
                </div>
                <div class="rams-module__footer rams-flex rams-gap-2 mobile-stack">
                    <a href="{{ path('abm_dashboard_accounts') }}" class="rams-btn rams-btn--sm rams-btn--ghost rams-uppercase rams-flex-1">
                        {{ 'common.view'|trans }}
                    </a>
                    <a href="{{ path('app_playbook_edit', {id: playbook.id})  }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'common.edit'|trans }}">
                        <svg class="rams-btn__icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 2l3 3-8 8H3v-3l8-8z"/>
                        </svg>
                    </a>
                </div>
            </div>
        {% endfor %}
        {% else %}
        <div class="rams-module rams-module--inset rams-p-8 rams-text--center">
            <div class="rams-empty-state">
                <svg class="rams-empty-state__icon" width="32" height="32" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 4L8 2L14 4V12L8 14L2 12V4Z" stroke-width="1.5"/>
                    <path d="M2 4L8 6L14 4" stroke-width="1.5"/>
                    <path d="M8 6V14" stroke-width="1.5"/>
                </svg>
                <h3 class="rams-empty-state__title">{{ 'playbook.no_playbooks'|trans }}</h3>
                <p class="rams-empty-state__description">{{ 'playbook.create_first'|trans }}</p>
            </div>
        </div>
        {% endif %}

        {# Create New Playbook Card #}
        <a href="{{ path('app_playbook_new') }}" class="rams-module rams-module--hoverable rams-flex rams-items-center rams-justify-center rams-p-8 rams-no-underline" style="border-style: dashed;">
            <div class="rams-empty-state">
                <svg class="rams-empty-state__icon" width="32" height="32" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 3V13M3 8H13"/>
                </svg>
                <h3 class="rams-empty-state__title rams-mt-4">{{ 'playbook.new_playbook'|trans }}</h3>
                <p class="rams-empty-state__description">{{ 'playbook.create_first'|trans }}</p>
            </div>
        </a>
    </div>

    {# Playbook Performance Overview #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'abm_dashboard.performance_overview'|trans }}</h2>
        </div>
        <div class="rams-module__content">
            <div class="rams-grid rams-grid--4 rams-gap-4">
                <div class="rams-module rams-module--inset rams-p-4">
                    <div class="rams-metric">
                        <span class="rams-metric__label">{{ 'abm_dashboard.total_accounts'|trans }}</span>
                        <span class="rams-metric__value rams-text--2xl">{{ overview.total_accounts }}</span> 
                    </div>
                </div>
                <div class="rams-module rams-module--inset rams-p-4">
                    <div class="rams-metric">
                        <span class="rams-metric__label">{{ 'abm_dashboard.active_playbooks'|trans }}</span>
                        <span class="rams-metric__value rams-text--2xl rams-text--success">{{ overview.active_playbooks }}</span> 
                    </div>
                </div>
                <div class="rams-module rams-module--inset rams-p-4">
                    <div class="rams-metric">
                        <span class="rams-metric__label">{{ 'abm_dashboard.avg_label'|trans }} {{ 'playbook.success_rate'|trans }}</span>
                        <span class="rams-metric__value rams-text--2xl rams-text--info"> {% if overview.success_rate is null %}{{ 'common.n_a'|trans }}{% else %}{{ overview.success_rate }}%{% endif %} </span> 
                    </div>
                </div>
                <div class="rams-module rams-module--inset rams-p-4">
                    <div class="rams-metric">
                        <span class="rams-metric__label">{{ 'playbook.runs'|trans  }}</span>
                        <span class="rams-metric__value rams-text--2xl">{{ overview.total_runs }}</span> 
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
