{% extends 'base.html.twig' %}

{% block title %}Target Accounts{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex items-center justify-between border-b border-neutral-200/80 pb-5">
        <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Target Accounts</h1>
        <a href="{{ path('abm_dashboard_account_new') }}" class="inline-flex items-center rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-800">
            ➕ Add Account
        </a>
    </div>

    <!-- Filters -->
    <div class="rounded-lg border border-neutral-200/60 bg-neutral-50/50 p-4">
        <div class="flex gap-4">
            <div class="flex-1">
                <input type="text" placeholder="Search accounts..." class="w-full rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-neutral-900 placeholder-neutral-500 transition-colors hover:border-neutral-300 focus:border-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-400">
            </div>
            <select class="rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-neutral-900 transition-colors hover:border-neutral-300 focus:border-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-400">
                <option>All Regions</option>
                <option>Morocco</option>
                <option>US</option>
                <option>EU</option>
            </select>
            <select class="rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-neutral-900 transition-colors hover:border-neutral-300 focus:border-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-400">
                <option>All Statuses</option>
                <option>Active</option>
                <option>Prospect</option>
                <option>Inactive</option>
            </select>
        </div>
    </div>

    <!-- Accounts Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {% if accounts | default([]) %}
            {% for account in accounts %}
                <div class="rounded-xl border border-neutral-200/60 bg-white p-6 transition-all hover:shadow-sm">
                    <div class="mb-4 flex items-start justify-between">
                        <div>
                            <h3 class="text-lg font-semibold text-neutral-900">{{ account.name | default('Account Name') }}</h3>
                            <p class="text-sm text-neutral-600">{{ account.industry | default('Industry') }}</p>
                        </div>
                        <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold 
                            {% if account.status == 'active' %}bg-green-100 text-green-800{% elseif account.status == 'prospect' %}bg-neutral-100 text-neutral-700{% else %}bg-neutral-100 text-neutral-700{% endif %}">
                            {{ account.status | default('prospect') | capitalize }}
                        </span>
                    </div>

                    <div class="mb-4 space-y-2 text-sm">
                        <p><span class="text-neutral-600">Location:</span> <span class="font-medium text-neutral-900">{{ account.location | default('N/A') }}</span></p>
                        <p><span class="text-neutral-600">Size:</span> <span class="font-medium text-neutral-900">{{ account.company_size | default('N/A') }}</span></p>
                        <p><span class="text-neutral-600">Revenue:</span> <span class="font-medium text-neutral-900">{{ account.revenue | default('N/A') }}</span></p>
                    </div>

                    <div class="mb-4 border-t border-neutral-200 pt-4">
                        <p class="mb-2 text-sm text-neutral-600">Engagement Score: <span class="font-semibold text-neutral-900">{{ account.engagement_score | default(0) }}/100</span></p>
                        <div class="h-2 w-full rounded-full bg-neutral-200">
                            <div class="h-2 rounded-full bg-neutral-900" style="width: {{ account.engagement_score | default(0) }}%"></div>
                        </div>
                    </div>

                    <div class="flex gap-2">
                        <a href="{{ path('abm_dashboard_account_detail', {'id': account.id | default(1)}) }}" class="flex-1 rounded-lg bg-neutral-100 px-3 py-2 text-center text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-200">
                            View
                        </a>
                        <a href="{{ path('abm_dashboard_account_edit', {'id': account.id | default(1)}) }}" class="flex-1 rounded-lg bg-neutral-100 px-3 py-2 text-center text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-200">
                            Edit
                        </a>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="col-span-3 py-12 text-center">
                <p class="mb-4 text-neutral-600">No target accounts yet</p>
                <a href="{{ path('abm_dashboard_account_new') }}" class="font-medium text-neutral-700 hover:text-neutral-900">Add your first account →</a>
            </div>
        {% endif %}
    </div>

    <!-- Quick Actions -->
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        <a href="{{ path('admin_dataset_import_form') }}" class="rounded-lg border border-neutral-200/60 bg-white p-6 transition-all hover:shadow-sm hover:border-neutral-300">
            <h3 class="mb-2 text-lg font-semibold text-neutral-900">📤 Import Accounts</h3>
            <p class="text-sm text-neutral-600">Upload accounts from CSV or Excel</p>
        </a>
        <div class="rounded-lg border border-neutral-200/60 bg-white p-6 transition-all hover:shadow-sm opacity-60">
            <h3 class="mb-2 text-lg font-semibold text-neutral-900">🔄 Sync LinkedIn</h3>
            <p class="text-sm text-neutral-600">Sync accounts and contacts from LinkedIn (Coming Soon)</p>
        </div>
        <a href="{{ path('abm_dashboard_index') }}" class="rounded-lg border border-neutral-200/60 bg-white p-6 transition-all hover:shadow-sm hover:border-neutral-300">
            <h3 class="mb-2 text-lg font-semibold text-neutral-900">📊 Analytics</h3>
            <p class="text-sm text-neutral-600">View engagement and conversion metrics</p>
        </a>
    </div>
</div>
{% endblock %}
