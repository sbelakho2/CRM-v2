{% extends 'base.html.twig' %}

{% block title %}{{ 'abm_dashboard.accounts'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <div class="rams-page-header">
        <h1 class="rams-page-title">{{ 'abm_dashboard.accounts'|trans }}</h1>
        <a href="{{ path('abm_dashboard_account_new') }}" class="rams-btn rams-btn--primary">
            ➕ {{ 'abm_dashboard.add_account'|trans }}
        </a>
    </div>

    <!-- Filters -->
    <div class="rams-module">
        <div class="rams-module__content">
            <div class="rams-form-row">
                <div class="rams-form-group rams-form-group--grow">
                    <input type="text" placeholder="{{ 'abm_dashboard.search_accounts'|trans }}" class="rams-input">
                </div>
                <select class="rams-select">
                    <option>{{ 'abm_dashboard.all_regions'|trans }}</option>
                    <option>Morocco</option>
                    <option>US</option>
                    <option>EU</option>
                </select>
                <select class="rams-select">
                    <option>{{ 'abm_dashboard.all_statuses'|trans }}</option>
                    <option>{{ 'common.active'|trans }}</option>
                    <option>Prospect</option>
                    <option>{{ 'common.inactive'|trans }}</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Accounts Grid -->
    <div class="rams-grid rams-grid--3">
        {% if accounts | default([]) %}
            {% for account in accounts %}
                <div class="rams-module">
                    <div class="rams-module__content">
                        <div class="rams-list-item__header">
                            <div>
                                <h3 class="rams-list-item__title">{{ account.name | default('Account Name') }}</h3>
                                <p class="rams-text-muted">{{ account.industry | default('Industry') }}</p>
                            </div>
                            <span class="rams-badge {% if account.status == 'active' %}rams-badge--success{% elseif account.status == 'prospect' %}rams-badge--info{% else %}rams-badge--neutral{% endif %}">
                                {{ account.status | default('prospect') | capitalize }}
                            </span>
                        </div>

                        <div class="rams-detail-list">
                            <p><span class="rams-dymo">{{ 'abm_dashboard.location'|trans }}:</span> {{ account.location | default('common.n_a'|trans) }}</p>
                            <p><span class="rams-dymo">{{ 'abm_dashboard.company_size'|trans }}:</span> {{ account.company_size | default('common.n_a'|trans) }}</p>
                            <p><span class="rams-dymo">{{ 'abm_dashboard.annual_revenue'|trans }}:</span> {{ account.revenue | default('common.n_a'|trans) }}</p>
                        </div>

                        <div class="rams-progress-section">
                            <p class="rams-text-muted">{{ 'abm_dashboard.engagement_score'|trans }}: <span class="rams-metric__value">{{ account.engagement_score | default(0) }}/100</span></p>
                            <div class="rams-progress">
                                <div class="rams-progress__bar" style="width: {{ account.engagement_score | default(0) }}%"></div>
                            </div>
                        </div>

                        <div class="rams-module__footer">
                            <a href="{{ path('abm_dashboard_account_detail', {'id': account.id | default(1)}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                                {{ 'common.view'|trans }}
                            </a>
                            <a href="{{ path('abm_dashboard_account_edit', {'id': account.id | default(1)}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                                {{ 'common.edit'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="rams-empty-state rams-grid--span-3">
                <p class="rams-text-muted">{{ 'abm_dashboard.no_target_accounts'|trans }}</p>
                <a href="{{ path('abm_dashboard_account_new') }}" class="rams-btn rams-btn--primary">{{ 'abm_dashboard.add_first_account'|trans }} →</a>
            </div>
        {% endif %}
    </div>

    <!-- Quick Actions -->
    <div class="rams-grid rams-grid--3">
        <a href="{{ path('admin_dataset_import_form') }}" class="rams-module rams-module--clickable">
            <div class="rams-module__content">
                <h3 class="rams-module__title">📤 {{ 'abm_dashboard.import_accounts'|trans }}</h3>
                <p class="rams-text-muted">{{ 'abm_dashboard.import_accounts_desc'|trans }}</p>
            </div>
        </a>
        <div class="rams-module rams-module--disabled">
            <div class="rams-module__content">
                <h3 class="rams-module__title">🔄 {{ 'abm_dashboard.sync_linkedin'|trans }}</h3>
                <p class="rams-text-muted">{{ 'abm_dashboard.sync_linkedin_desc'|trans }} ({{ 'abm_dashboard.coming_soon'|trans }})</p>
            </div>
        </div>
        <a href="{{ path('abm_dashboard_index') }}" class="rams-module rams-module--clickable">
            <div class="rams-module__content">
                <h3 class="rams-module__title">📊 {{ 'abm_dashboard.analytics'|trans }}</h3>
                <p class="rams-text-muted">{{ 'abm_dashboard.analytics_subtitle'|trans }}</p>
            </div>
        </a>
    </div>
</div>
{% endblock %}
