{% extends 'base.html.twig' %}

{% block title %}{{ 'abm_dashboard.accounts'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <nav class="rams-breadcrumb rams-mb-2">
                <ol class="rams-breadcrumb__list">
                    <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item"><a href="{{ path('abm_dashboard_index') }}" class="rams-breadcrumb__link">{{ 'nav.abm_dashboard'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'abm_dashboard.accounts'|trans }}</li>
                </ol>
            </nav>
            <h1 class="rams-page-title">{{ 'abm_dashboard.accounts'|trans }}</h1>
        </div>
        <div class="rams-page-actions mobile-stack">
            <a href="{{ path('abm_dashboard_account_new') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 3V13M3 8H13"/>
                </svg>
                {{ 'abm_dashboard.add_account'|trans }}
            </a>
        </div>
    </div>

    {# Filters #}
    <div class="rams-module">
        <div class="rams-module__content">
            <form method="get" action="{{ path('abm_dashboard_accounts') }}" class="rams-form rams-grid rams-grid--3 mobile-stack">
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo" for="abm-account-search">{{  'common.search'|trans }}</label>
                    <input type="text" id="abm-account-search" name="q" value="{{ q|default('') }}" placeholder="{{ 'abm_dashboard.search_accounts'|trans }}" class="rams-form__input">
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo" for="abm-account-region">{{  'company.region'|trans }}</label>
                    <select class="rams-form__select" id="abm-account-region" name="region"> 
                        <option value="">{{ 'abm_dashboard.all_regions'|trans }}</option>
                        <option value="MA" {% if region|default('') == 'MA' %}selected{% endif %}>{{  'abm_dashboard.region_morocco'|trans }}</option>
                        <option value="US" {% if region|default('') == 'US' %}selected{% endif %}>{{  'abm_dashboard.region_us'|trans }}</option>
                        <option value="EU" {% if region|default('') == 'EU' %}selected{% endif %}>{{  'abm_dashboard.region_eu'|trans }}</option>
                    </select>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo" for="abm-account-status">{{  'common.status'|trans }}</label>
                    <select class="rams-form__select" id="abm-account-status" name="status"> 
                        <option value="">{{ 'abm_dashboard.all_statuses'|trans }}</option>
                        <option value="active" {% if status|default('') == 'active' %}selected{% endif %}>{{  'common.active'|trans }}</option>
                        <option value="prospect" {% if status|default('') == 'prospect' %}selected{% endif %}>{{  'abm_dashboard.status_prospect'|trans }}</option>
                        <option value="inactive" {% if status|default('') == 'inactive' %}selected{% endif %}>{{  'common.inactive'|trans }}</option>
                    </select>
                </div> <div class="rams-form__group rams-form__group--actions rams-grid-span-3"> <button type="submit" class="rams-btn rams-w-full"> <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"> <circle cx="7" cy="7" r="4"/> <path d="M11 11L14 14"/> </svg> {{ 'common.filter'|trans }} </button> </div>
            </form>
        </div>
    </div>

    {# Accounts Grid #}
    <div class="rams-grid rams-grid--3 rams-gap-6">
        {% if accounts | default([]) %}
            {% for account in accounts %}
                <div class="rams-module rams-module--hoverable" onclick="location.href='{{ path('abm_dashboard_account_detail', {'id': account.id})    }}'">
                    <div class="rams-module__content">
                        <div class="rams-flex rams-justify-between rams-items-start rams-mb-4">
                            <div>
                                <h3 class="rams-heading rams-heading--3 rams-mb-1">{{ account.name | default('abm_dashboard.account_name_placeholder'|trans) }}</h3>
                                <p class="rams-text--muted rams-text--xs rams-uppercase">{{ account.industry | default('abm_dashboard.industry_placeholder'|trans) }}</p>
                            </div>
                            {% set statusKey = account.status|default('prospect') %}
                            {% set statusLabel = statusKey == 'active'
                                ? 'common.active'|trans
                                : (statusKey == 'inactive' ? 'common.inactive'|trans : 'abm_dashboard.status_prospect'|trans) %}
                            <span class="rams-badge {% if account.status == 'active' %}rams-badge--success{% elseif account.status == 'prospect' %}rams-badge--info{% endif %}">
                                {{ statusLabel }}
                            </span>
                        </div>

                        <dl class="rams-definition-list rams-mb-6">
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'abm_dashboard.location'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ account.location | default('—') }}</dd>
                            </div>
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'abm_dashboard.company_size'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ account.company_size | default('—') }}</dd>
                            </div>
                        </dl>

                        <div class="rams-stack rams-gap-2">
                            <div class="rams-flex rams-justify-between rams-items-end">
                                <span class="rams-text--2xs rams-text--muted rams-uppercase rams-font-mono">{{ 'abm_dashboard.engagement_score'|trans }}</span>
                                <span class="rams-text--sm rams-text--bold rams-font-mono">{{ account.engagement_score | default(0) }}%</span>
                            </div>
                            <div class="rams-progress rams-progress--compact">
                                <div class="rams-progress__bar" style="width: {{ account.engagement_score | default(0) }}%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="rams-module__footer rams-flex rams-gap-2 mobile-stack" onclick="event.stopPropagation()">
                        <a href="{{ path('abm_dashboard_account_detail', {'id': account.id})    }}" class="rams-btn rams-btn--ghost rams-btn--sm rams-flex-1">
                            {{ 'common.view'|trans }}
                        </a>
                        <a href="{{ path('abm_dashboard_account_edit', {'id': account.id})    }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                            <svg class="rams-btn__icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 2L14 5L6 13H3V10L11 2Z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="rams-grid-span-3">
                <div class="rams-module">
                    <div class="rams-module__content rams-empty-state">
                        <p class="rams-text--muted rams-mb-4">{{ 'abm_dashboard.no_target_accounts'|trans }}</p>
                        <a href="{{ path('abm_dashboard_account_new') }}" class="rams-btn rams-btn--primary">
                            {{ 'abm_dashboard.add_first_account'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    {# Quick Actions #}
    <div class="rams-grid rams-grid--3 rams-gap-6">
        <a href="{{ path('admin_dataset_import_form') }}" class="rams-module rams-module--inset rams-module--hoverable rams-no-underline">
            <div class="rams-module__content">
                <div class="rams-flex rams-items-center rams-gap-3 rams-mb-2">
                    <div class="rams-icon rams-icon--xl">
                        <svg class="rams-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                    </div>
                    <h3 class="rams-module__title">{{ 'abm_dashboard.import_accounts'|trans }}</h3>
                </div>
                <p class="rams-text--muted rams-text--xs">{{ 'abm_dashboard.import_accounts_desc'|trans }}</p>
            </div>
        </a>
        <a href="{{ path('abm_dashboard_index') }}" class="rams-module rams-module--inset rams-module--hoverable rams-no-underline">
            <div class="rams-module__content">
                <div class="rams-flex rams-items-center rams-gap-3 rams-mb-2">
                    <div class="rams-icon rams-icon--xl">
                        <svg class="rams-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="20" x2="18" y2="10"></line>
                            <line x1="12" y1="20" x2="12" y2="4"></line>
                            <line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                    </div>
                    <h3 class="rams-module__title">{{ 'abm_dashboard.analytics'|trans }}</h3>
                </div>
                <p class="rams-text--muted rams-text--xs">{{ 'abm_dashboard.analytics_subtitle'|trans }}</p>
            </div>
        </a>
    </div>
</div>
{% endblock %}
