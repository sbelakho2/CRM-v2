{% extends 'base.html.twig' %}

{% block title %}{{ 'abm_dashboard.account_detail'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <nav class="rams-breadcrumb">
        <a href="{{ path('abm_dashboard_accounts') }}" class="rams-breadcrumb__link">
            ← {{ 'abm_dashboard.back_to_accounts'|trans }}
        </a>
    </nav>

    <div class="rams-grid rams-grid--3">
        <!-- Main Content -->
        <div class="rams-stack" style="grid-column: span 2;">
            <!-- Account Header -->
            <div class="rams-module">
                <div class="rams-module__content">
                    <div class="rams-module__header">
                        <div>
                            <h1 class="rams-page-title">{{ account.name | default('Account') }}</h1>
                            <p class="rams-text-muted">{{ account.industry | default('Industry') }}</p>
                        </div>
                        <span class="rams-badge rams-badge--success">
                            {{ account.status | default('active') | capitalize }}
                        </span>
                    </div>
                    
                    <div class="rams-grid rams-grid--4">
                        <div>
                            <span class="rams-dymo">{{ 'abm_dashboard.location'|trans }}</span>
                            <p class="rams-metric__value">{{ account.location | default('common.n_a'|trans) }}</p>
                        </div>
                        <div>
                            <span class="rams-dymo">{{ 'abm_dashboard.company_size'|trans }}</span>
                            <p class="rams-metric__value">{{ account.company_size | default('common.n_a'|trans) }}</p>
                        </div>
                        <div>
                            <span class="rams-dymo">{{ 'abm_dashboard.annual_revenue'|trans }}</span>
                            <p class="rams-metric__value">{{ account.revenue | default('common.n_a'|trans) }}</p>
                        </div>
                        <div>
                            <span class="rams-dymo">{{ 'abm_dashboard.added'|trans }}</span>
                            <p class="rams-metric__value">{{ account.created_at | date('M d, Y') | default('common.n_a'|trans) }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contacts -->
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.contacts'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack">
                        {% if account.contacts | default([]) %}
                            {% for contact in account.contacts %}
                                <div class="rams-list-item rams-list-item--interactive">
                                    <div>
                                        <p class="rams-list-item__title">{{ contact.name | default('Contact') }}</p>
                                        <p class="rams-text-muted">{{ contact.email | default('common.n_a'|trans) }}</p>
                                    </div>
                                    <span class="rams-badge">{{ contact.title | default('Title') }}</span>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="rams-empty-state">{{ 'abm_dashboard.no_contacts'|trans }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Engagement History -->
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.engagement_history'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-timeline">
                        {% if activities | default([]) %}
                            {% for activity in activities %}
                                <div class="rams-timeline__item">
                                    <div class="rams-timeline__marker"></div>
                                    <div class="rams-timeline__content">
                                        <p class="rams-timeline__title">{{ activity.title | default('Activity') }}</p>
                                        <p class="rams-text-muted">{{ activity.description | default('') }}</p>
                                        <p class="rams-timeline__date">{{ activity.timestamp | date('M d, Y H:i') | default('Unknown') }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="rams-empty-state">{{ 'abm_dashboard.no_engagement_history'|trans }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="rams-stack">
            <!-- Engagement Metrics -->
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.engagement'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack">
                        <div>
                            <div class="rams-metric">
                                <span class="rams-dymo">{{ 'abm_dashboard.engagement_score'|trans }}</span>
                                <span class="rams-metric__value">{{ account.engagement_score | default(0) }}/100</span>
                            </div>
                            <div class="rams-progress">
                                <div class="rams-progress__bar" style="width: {{ account.engagement_score | default(0) }}%"></div>
                            </div>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-dymo">{{ 'abm_dashboard.page_views'|trans }}:</span> 
                            <span class="rams-metric__value">{{ account.page_views | default(0) }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-dymo">{{ 'abm_dashboard.emails_sent'|trans }}:</span> 
                            <span class="rams-metric__value">{{ account.emails_sent | default(0) }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-dymo">{{ 'abm_dashboard.email_opens'|trans }}:</span> 
                            <span class="rams-metric__value">{{ account.email_opens | default(0) }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Playbooks -->
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.active_playbooks_sidebar'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack">
                        {% if account.playbooks | default([]) %}
                            {% for playbook in account.playbooks %}
                                <div class="rams-alert rams-alert--info">
                                    <p class="rams-alert__title">{{ playbook.name | default('Playbook') }}</p>
                                    <p class="rams-alert__text">{{ 'common.status'|trans }}: {{ 'common.active'|trans }}</p>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="rams-empty-state">{{ 'abm_dashboard.no_active_playbooks'|trans }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.quick_actions'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack">
                        <a href="{{ path('abm_dashboard_account_edit', {'id': accountId}) }}" class="rams-btn rams-btn--primary">
                            {{ 'abm_dashboard.edit_account'|trans }}
                        </a>
                        <a href="{{ path('app_contact_new') }}?account_name={{ account.name|url_encode }}" class="rams-btn rams-btn--secondary">
                            {{ 'abm_dashboard.add_contact'|trans }}
                        </a>
                        <a href="{{ path('abm_dashboard_playbooks') }}" class="rams-btn rams-btn--secondary">
                            {{ 'abm_dashboard.launch_playbook'|trans }}
                        </a>
                        <button type="button" onclick="ramsConfirm('{{ 'abm_dashboard.remove_confirm'|trans }}', function() { window.location.href='{{ path('abm_dashboard_accounts') }}'; }, {variant: 'danger'})" class="rams-btn rams-btn--danger">
                            {{ 'abm_dashboard.remove_account'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
