{% extends 'base.html.twig' %}

{% block title %}{{ 'abm_dashboard.account_detail'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="Breadcrumb">
        <ol class="rams-breadcrumb__list">
            <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item"><a href="{{ path('abm_dashboard_index') }}" class="rams-breadcrumb__link">{{ 'nav.abm_dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item"><a href="{{ path('abm_dashboard_accounts') }}" class="rams-breadcrumb__link">{{ 'abm_dashboard.accounts'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ account.name | default('Account') }}</li>
        </ol>
    </nav>

    <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack">
        {# Main Content - 2 columns #}
        <div class="rams-grid-span-2 rams-stack rams-gap-6 mobile-w-full">
            {# Account Header Module #}
            <div class="rams-module">
                <div class="rams-module__content">
                    <div class="rams-flex rams-justify-between rams-items-start rams-mb-6 mobile-stack">
                        <div>
                            <h1 class="rams-page-title rams-mb-1">{{ account.name | default('Account') }}</h1>
                            <p class="rams-text--muted rams-text--xs rams-uppercase">{{ account.industry | default('Industry') }}</p>
                        </div>
                        <span class="rams-badge rams-badge--success">
                            {{ account.status | default('active') | capitalize }}
                        </span>
                    </div>
                    
                    <div class="rams-grid rams-grid--4 rams-gap-4">
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'abm_dashboard.location'|trans }}</span>
                            <span class="rams-metric__value rams-text--sm">{{ account.location | default('—') }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'abm_dashboard.company_size'|trans }}</span>
                            <span class="rams-metric__value rams-text--sm">{{ account.company_size | default('—') }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'abm_dashboard.annual_revenue'|trans }}</span>
                            <span class="rams-metric__value rams-text--sm">{{ account.revenue | default('—') }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'abm_dashboard.added'|trans }}</span>
                            <span class="rams-metric__value rams-text--xs">{{ account.created_at | date('M d, Y') | default('—') }}</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Contacts Section #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.contacts'|trans }}</h2>
                    <a href="{{ path('app_contact_new') }}?account_name={{ account.name|url_encode }}" class="rams-btn rams-btn--sm">+ {{ 'common.add'|trans }}</a>
                </div>
                <div class="rams-module__content rams-module__content--flush">
                    {% if account.contacts | default([]) %}
                        <div class="rams-list">
                            {% for contact in account.contacts %}
                                <div class="rams-list-item rams-p-4 rams-border-b last:rams-border-b-0">
                                    <div class="rams-flex rams-items-center rams-gap-4 rams-flex-1">
                                        <div class="rams-badge rams-badge--lg rams-badge--circle rams-badge--primary">
                                            {{ contact.name|slice(0, 1) }}
                                        </div>
                                        <div class="rams-flex-1">
                                            <h3 class="rams-text--sm rams-text--bold">{{ contact.name | default('Contact') }}</h3>
                                            <p class="rams-text--muted rams-text--xs">{{ contact.email | default('—') }}</p>
                                        </div>
                                        <span class="rams-badge">{{ contact.title | default('Title') }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="rams-empty-state rams-p-8">
                            <p class="rams-text--muted rams-text--sm">{{ 'abm_dashboard.no_contacts'|trans }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Engagement History Section #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.engagement_history'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    {% if activities | default([]) %}
                        <div class="rams-stack rams-gap-4">
                            {% for activity in activities %}
                                <div class="rams-flex rams-items-start rams-gap-3">
                                    <div class="rams-andon rams-mt-1">
                                        <span class="rams-andon__light rams-andon__light--green"></span>
                                    </div>
                                    <div class="rams-flex-1">
                                        <div class="rams-flex rams-justify-between rams-items-center rams-mb-1">
                                            <span class="rams-text--sm rams-text--bold rams-uppercase rams-font-mono">{{ activity.title | default('Activity') }}</span>
                                            <span class="rams-text--muted rams-text--xs rams-font-mono">{{ activity.timestamp | date('M d, Y H:i') | default('Unknown') }}</span>
                                        </div>
                                        <p class="rams-text--muted rams-text--xs">{{ activity.description | default('') }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="rams-empty-state rams-p-8">
                            <p class="rams-text--muted rams-text--sm">{{ 'abm_dashboard.no_engagement_history'|trans }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Sidebar - 1 column #}
        <div class="rams-stack rams-gap-6 mobile-w-full">
            {# Engagement Metrics Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.engagement'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-6">
                        <div>
                            <div class="rams-flex rams-justify-between rams-items-end rams-mb-2">
                                <span class="rams-text-2xs rams-text--muted rams-uppercase rams-font-mono">{{ 'abm_dashboard.engagement_score'|trans }}</span>
                                <span class="rams-text--sm rams-text--bold rams-font-mono">{{ account.engagement_score | default(0) }}%</span>
                            </div>
                            <div class="rams-progress rams-progress--compact">
                                <div class="rams-progress__bar" style="width: {{ account.engagement_score | default(0) }}%"></div>
                            </div>
                        </div>
                        
                        <div class="rams-grid rams-grid--2 rams-gap-4">
                            <div class="rams-module rams-module--inset rams-p-3">
                                <span class="rams-text-3xs rams-uppercase rams-text--muted rams-block rams-font-mono">{{ 'abm_dashboard.page_views'|trans }}</span>
                                <span class="rams-metric__value rams-text--xl">{{ account.page_views | default(0) }}</span>
                            </div>
                            <div class="rams-module rams-module--inset rams-p-3">
                                <span class="rams-text-3xs rams-uppercase rams-text--muted rams-block rams-font-mono">{{ 'abm_dashboard.emails_sent'|trans }}</span>
                                <span class="rams-metric__value rams-text--xl">{{ account.emails_sent | default(0) }}</span>
                            </div>
                            <div class="rams-module rams-module--inset rams-p-3 rams-grid-span-2">
                                <span class="rams-text-3xs rams-uppercase rams-text--muted rams-block rams-font-mono">{{ 'abm_dashboard.email_opens'|trans }}</span>
                                <span class="rams-metric__value rams-text--xl rams-text--success">{{ account.email_opens | default(0) }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Active Playbooks Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.active_playbooks_sidebar'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    {% if account.playbooks | default([]) %}
                        <div class="rams-stack rams-gap-2">
                            {% for playbook in account.playbooks %}
                                <div class="rams-flex rams-items-center rams-gap-3 rams-p-2 rams-bg-info-subtle rams-border rams-rounded">
                                    <div class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span></div>
                                    <span class="rams-text--xs rams-text--bold rams-uppercase rams-font-mono">{{ playbook.name | default('Playbook') }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="rams-empty-state rams-p-4">
                            <p class="rams-text--muted rams-text--xs">{{ 'abm_dashboard.no_active_playbooks'|trans }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Quick Actions Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'abm_dashboard.quick_actions'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-2">
                        <a href="{{ path('abm_dashboard_account_edit', {'id': account.id | default(1)}) }}" class="rams-btn rams-btn--primary rams-w-full">
                            {{ 'abm_dashboard.edit_account'|trans }}
                        </a>
                        <a href="{{ path('app_contact_new') }}?account_name={{ account.name|url_encode }}" class="rams-btn rams-w-full">
                            {{ 'abm_dashboard.add_contact'|trans }}
                        </a>
                        <a href="{{ path('abm_dashboard_playbooks') }}" class="rams-btn rams-w-full">
                            {{ 'abm_dashboard.launch_playbook'|trans }}
                        </a>
                        <button type="button" onclick="ramsConfirm('{{ 'abm_dashboard.remove_confirm'|trans }}', function() { window.location.href='{{ path('abm_dashboard_accounts') }}'; }, {variant: 'danger'})" class="rams-btn rams-btn--danger rams-btn--ghost rams-w-full rams-mt-2">
                            {{ 'abm_dashboard.remove_account'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
