{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <div class="rams-page-header">
        <h1 class="rams-page-title">{{ pageTitle }}</h1>
        <p class="rams-page-subtitle">{{ account ? 'abm_dashboard.update_account'|trans : 'abm_dashboard.create_account'|trans }} ABM target account</p>
    </div>

    <div class="rams-module rams-module--narrow">
        <div class="rams-module__content">
            <form method="POST" class="rams-form">
                <!-- Account Name -->
                <div class="rams-form-group">
                    <label class="rams-label">{{ 'abm_dashboard.account_name'|trans }} *</label>
                    <input type="text" name="account_name" required
                           value="{{ account ? account.accountName : '' }}"
                           class="rams-input"
                           placeholder="e.g., Acme Corporation">
                </div>

                <!-- Domain -->
                <div class="rams-form-group">
                    <label class="rams-label">{{ 'abm_dashboard.domain'|trans }} *</label>
                    <input type="text" name="domain" required
                           value="{{ account ? account.domain : '' }}"
                           class="rams-input"
                           placeholder="e.g., acme.com">
                    <p class="rams-text-muted">{{ 'abm_dashboard.domain_hint'|trans }}</p>
                </div>

                <!-- ICP Tier -->
                <div class="rams-form-group">
                    <label class="rams-label">{{ 'abm_dashboard.icp_tier'|trans }}</label>
                    <select name="icp_tier" class="rams-select">
                        <option value="">{{ 'abm_dashboard.select_tier'|trans }}</option>
                        <option value="Tier1" {{ account and account.icpTier == 'Tier1' ? 'selected' : '' }}>{{ 'abm_dashboard.tier1'|trans }}</option>
                        <option value="Tier2" {{ account and account.icpTier == 'Tier2' ? 'selected' : '' }}>{{ 'abm_dashboard.tier2'|trans }}</option>
                        <option value="Tier3" {{ account and account.icpTier == 'Tier3' ? 'selected' : '' }}>{{ 'abm_dashboard.tier3'|trans }}</option>
                    </select>
                </div>

                <!-- Industry -->
                <div class="rams-form-group">
                    <label class="rams-label">{{ 'company.industry'|trans }}</label>
                    <input type="text" name="industry"
                           value="{{ account and account.metadata ? account.metadata.industry|default('') : '' }}"
                           class="rams-input"
                           placeholder="e.g., Technology, Manufacturing">
                </div>

                <!-- Country -->
                <div class="rams-form-group">
                    <label class="rams-label">{{ 'company.country'|trans }}</label>
                    <input type="text" name="country"
                           value="{{ account and account.metadata ? account.metadata.country|default('') : '' }}"
                           class="rams-input"
                           placeholder="e.g., Morocco, USA">
                </div>

                <!-- Company Size -->
                <div class="rams-form-group">
                    <label class="rams-label">{{ 'abm_dashboard.company_size'|trans }}</label>
                    <input type="text" name="company_size"
                           value="{{ account and account.metadata ? account.metadata.company_size|default('') : '' }}"
                           class="rams-input"
                           placeholder="e.g., 50-200, 1000+">
                </div>

                <!-- Revenue -->
                <div class="rams-form-group">
                          <label class="rams-label">{{ 'abm_dashboard.annual_revenue'|trans }}</label>
                          <input type="text" name="revenue"
                              value="{{ account and account.metadata ? account.metadata.revenue|default('') : '' }}"
                              class="rams-input"
                              placeholder="e.g., 1M-10M ({{ display_currency() }})">
                </div>

                <!-- Form Actions -->
                <div class="rams-module__footer">
                    <button type="submit" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M13 3L6 13L3 9"/>
                        </svg>
                        {{ account ? 'abm_dashboard.update_account'|trans : 'abm_dashboard.create_account'|trans }}
                    </button>
                    <a href="{{ path('abm_dashboard_accounts') }}" class="rams-btn rams-btn--ghost">
                        {{ 'common.cancel'|trans }}
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
