{% extends 'base.html.twig' %}

{% block title %}{{ 'lead_discovery.results'|trans }} - {{ 'lead_discovery.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'lead_discovery.results'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'lead_discovery.query_label'|trans|default('Query') }}: <span class="rams-text--bold">{{ query }}</span></p>
            </div>
            <div class="rams-page__actions">
                <a href="{{ path('lead_discovery_index') }}" class="rams-btn rams-btn--secondary">
                    {{ 'lead_discovery.new_search'|trans|default('New Search') }}
                </a>
            </div>
        </div>

        {# Stats #}
        <div class="rams-metrics-grid rams-metrics-grid--4col">
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead_discovery.results_found'|trans|default('Results Found') }}</span>
                    <span class="rams-metric rams-metric--info">{{ results|length }}</span>
                </div>
            </div>
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead_discovery.search_time'|trans|default('Search Time') }}</span>
                    <span class="rams-metric rams-metric--success">{{ searchTime|number_format(2) }}s</span>
                </div>
            </div>
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead_discovery.queries_used'|trans|default('Queries Used') }}</span>
                    <span class="rams-metric rams-metric--warning">{{ quota.total_queries }}</span>
                </div>
            </div>
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <span class="rams-dymo">{{ 'lead_discovery.estimated_cost'|trans|default('Estimated Cost') }}</span>
                            <span class="rams-metric">{{ quota.estimated_cost|format_currency(quota.currency|default(display_currency()), null, 2) }}</span>
                </div>
            </div>
        </div>

        {% if results is empty %}
            <div class="rams-module">
                <div class="rams-module__content rams-empty-state rams-empty-state--warning">
                    <svg class="rams-empty-state__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <h3 class="rams-empty-state__title">{{ 'lead_discovery.no_results'|trans }}</h3>
                    <p class="rams-empty-state__description">{{ 'lead_discovery.no_results_hint'|trans|default('Try adjusting your search query or filters.') }}</p>
                </div>
            </div>
        {% else %}
            {# Import Actions #}
            <div class="rams-module rams-module--compact">
                <div class="rams-module__content">
                    <form method="post" action="{{ path('lead_discovery_import') }}" id="importForm" class="rams-form rams-form--inline">
                        <div class="rams-form__group rams-form__group--inline">
                            <label class="rams-checkbox">
                                <input type="checkbox" id="selectAll" class="rams-checkbox__input">
                                <span class="rams-checkbox__label">{{ 'lead_discovery.select_all'|trans|default('Select All') }}</span>
                            </label>
                            <span class="rams-text--muted">
                                <span id="selectedCount">0</span> {{ 'lead_discovery.selected'|trans|default('selected') }}
                            </span>
                        </div>
                        <div class="rams-form__actions">
                            <button 
                                type="submit" 
                                class="rams-btn rams-btn--primary"
                                id="importSelected"
                                disabled
                            >
                                {{ 'lead_discovery.import_selected'|trans }}
                            </button>
                            <button 
                                type="button" 
                                onclick="document.getElementById('importAllForm').submit()"
                                class="rams-btn rams-btn--success"
                            >
                                {{ 'lead_discovery.import_all'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            {# Hidden form for import all #}
            <form method="post" action="{{ path('lead_discovery_import_all') }}" id="importAllForm" class="rams-hidden"></form>

            {# Results List #}
            <div class="rams-list">
                {% for index, result in results %}
                    <div class="rams-module rams-module--interactive">
                        <div class="rams-module__content">
                            <div class="rams-list__item rams-list__item--selectable">
                                <div class="rams-list__checkbox">
                                    <input 
                                        type="checkbox" 
                                        name="selected[]" 
                                        value="{{ index }}" 
                                        form="importForm"
                                        class="result-checkbox rams-checkbox__input"
                                    >
                                </div>
                                <div class="rams-list__content">
                                    <h3 class="rams-list__title">
                                        {{ result.title|raw }}
                                    </h3>
                                    <a 
                                        href="{{ result.link }}" 
                                        target="_blank" 
                                        class="rams-link rams-link--with-icon"
                                    >
                                        {{ result.displayLink }}
                                        <svg class="rams-icon rams-icon--xs" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                        </svg>
                                    </a>
                                    <p class="rams-list__description">
                                        {{ result.snippet|raw }}
                                    </p>
                                    
                                    {% if result.pagemap.organization is defined %}
                                        <div class="rams-list__meta">
                                            <span class="rams-dymo rams-dymo--sm">{{ 'lead_discovery.additional_info'|trans|default('Additional Info') }}:</span>
                                            {% for org in result.pagemap.organization %}
                                                {% if org.name is defined %}
                                                    <span class="rams-text--sm">{{ org.name }}</span>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<script>
    // Select all functionality
    const selectAllCheckbox = document.getElementById('selectAll');
    const resultCheckboxes = document.querySelectorAll('.result-checkbox');
    const selectedCountSpan = document.getElementById('selectedCount');
    const importButton = document.getElementById('importSelected');

    function updateSelectedCount() {
        const count = document.querySelectorAll('.result-checkbox:checked').length;
        selectedCountSpan.textContent = count;
        importButton.disabled = count === 0;
    }

    selectAllCheckbox?.addEventListener('change', function() {
        resultCheckboxes.forEach(checkbox => {
            checkbox.checked = this.checked;
        });
        updateSelectedCount();
    });

    resultCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            updateSelectedCount();
            
            // Update select all checkbox state
            const allChecked = Array.from(resultCheckboxes).every(cb => cb.checked);
            const noneChecked = Array.from(resultCheckboxes).every(cb => !cb.checked);
            
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = allChecked;
                selectAllCheckbox.indeterminate = !allChecked && !noneChecked;
            }
        });
    });

    // Initialize count
    updateSelectedCount();
</script>
{% endblock %}
