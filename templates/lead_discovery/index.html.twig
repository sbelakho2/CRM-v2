{% extends 'base.html.twig' %}

{% block title %}{{ 'lead_discovery.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__container rams-page__container--narrow">
        
        {# Header #}
        <div class="rams-page__header">
            <div class="rams-page__header-content">
                <h1 class="rams-page__title">{{ 'lead_discovery.title'|trans }}</h1>
                <p class="rams-page__subtitle">{{ 'lead_discovery.subtitle'|trans|default('Search for potential leads using Google Custom Search API') }}</p>
            </div>
        </div>

        {# Search Form Module #}
        <div class="rams-module">
            <div class="rams-module__content">
                <form method="post" action="{{ path('lead_discovery_search') }}" class="rams-form">
                    <div class="rams-form__group">
                        <label for="query" class="rams-dymo">
                            {{ 'lead_discovery.search_query'|trans|default('Search Query') }}
                        </label>
                        <input 
                            type="text" 
                            name="query" 
                            id="query" 
                            class="rams-form__input"
                            placeholder="{{ 'lead_discovery.query_placeholder'|trans|default('e.g., aerospace manufacturing morocco') }}"
                            required
                        >
                        <p class="rams-form__hint">
                            {{ 'lead_discovery.query_hint'|trans|default('Enter keywords to search for potential leads') }}
                        </p>
                    </div>

                    <div class="rams-form__grid rams-form__grid--2col">
                        <div class="rams-form__group">
                            <label for="sector" class="rams-dymo">
                                {{ 'lead_discovery.sector'|trans|default('Sector') }} <span class="rams-form__optional">({{ 'common.optional'|trans }})</span>
                            </label>
                            <select name="sector" id="sector" class="rams-form__select">
                                <option value="all">{{ 'lead_discovery.all_sectors'|trans|default('All Sectors') }}</option>
                                <option value="aerospace">{{ 'lead_discovery.sector_aerospace'|trans|default('Aerospace') }}</option>
                                <option value="automotive">{{ 'lead_discovery.sector_automotive'|trans|default('Automotive') }}</option>
                                <option value="electronics">{{ 'lead_discovery.sector_electronics'|trans|default('Electronics') }}</option>
                                <option value="manufacturing">{{ 'lead_discovery.sector_manufacturing'|trans|default('General Manufacturing') }}</option>
                                <option value="energy">{{ 'lead_discovery.sector_energy'|trans|default('Energy & Renewables') }}</option>
                                <option value="pharmaceutical">{{ 'lead_discovery.sector_pharmaceutical'|trans|default('Pharmaceutical') }}</option>
                            </select>
                        </div>

                        <div class="rams-form__group">
                            <label for="limit" class="rams-dymo">
                                {{ 'lead_discovery.num_results'|trans|default('Number of Results') }}
                            </label>
                            <select name="limit" id="limit" class="rams-form__select">
                                <option value="5">5 {{ 'lead_discovery.results_label'|trans|default('results') }}</option>
                                <option value="10" selected>10 {{ 'lead_discovery.results_label'|trans|default('results') }}</option>
                                <option value="20">20 {{ 'lead_discovery.results_label'|trans|default('results') }}</option>
                                <option value="50">50 {{ 'lead_discovery.results_label'|trans|default('results') }}</option>
                            </select>
                        </div>
                    </div>

                    <div class="rams-module__footer">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                            {{ 'lead_discovery.search_companies'|trans|default('Search Companies') }}
                        </button>

                        <a href="{{ path('app_lead_index') }}" class="rams-btn rams-btn--ghost">
                            {{ 'lead_discovery.back_to_leads'|trans|default('Back to Leads') }}
                        </a>
                    </div>
                </form>
            </div>
        </div>

        {# Info Box #}
        <div class="rams-andon rams-andon--info">
            <div class="rams-andon__content">
                <h3 class="rams-andon__title">{{ 'lead_discovery.about_api'|trans|default('About API Usage') }}</h3>
                <ul class="rams-andon__list">
                    <li>{{ 'lead_discovery.api_free_tier'|trans|default('Free tier: 100 queries per day') }}</li>
                    <li>{{ 'lead_discovery.api_paid_tier'|trans|default('Paid tier: $5 per 1,000 queries') }}</li>
                    <li>{{ 'lead_discovery.api_dedup'|trans|default('Results are automatically filtered for duplicates') }}</li>
                    <li>{{ 'lead_discovery.api_preview'|trans|default('You can preview results before importing') }}</li>
                </ul>
            </div>
        </div>

        {# Example Searches #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="rams-module__title">{{ 'lead_discovery.example_searches'|trans|default('Example Searches') }}</h3>
            </div>
            <div class="rams-module__content">
                <div class="rams-example-list">
                    <button type="button" onclick="document.getElementById('query').value = this.textContent.trim()" class="rams-example-list__item">
                        aerospace manufacturers morocco
                    </button>
                    <button type="button" onclick="document.getElementById('query').value = this.textContent.trim()" class="rams-example-list__item">
                        automotive parts suppliers casablanca
                    </button>
                    <button type="button" onclick="document.getElementById('query').value = this.textContent.trim()" class="rams-example-list__item">
                        electronic components distributors morocco
                    </button>
                    <button type="button" onclick="document.getElementById('query').value = this.textContent.trim()" class="rams-example-list__item">
                        industrial manufacturing companies tangier
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
