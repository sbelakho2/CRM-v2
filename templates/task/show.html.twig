{% extends 'base.html.twig' %}

{% block title %}{{ 'task.show_title_prefix'|trans }}{{ task.title }}{{ 'task.show_title_suffix'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
            <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <a href="{{ path('app_task_index') }}">{{ 'task.title'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ task.title }}</span>
            </div>
            <div class="rams-flex rams-items-center rams-gap-2 rams-mt-2">
                <h1 class="rams-page__title">{{ task.title }}</h1>
                <span class="rams-badge rams-badge--{{ task.status == 'done' ? 'success' : (task.status == 'in_progress' ? 'warning' : 'neutral') }}">
                    {{ task.status|replace({'_': ' '})|upper }}
                </span>
                <span class="rams-badge rams-badge--{{ task.priority == 'high' ? 'danger' : (task.priority == 'medium' ? 'warning' : 'neutral') }}">
                    {{ task.priority|upper }}
                </span>
            </div>
        </div>
        <div class="rams-page__actions mobile-stack">
            {% if task.status != 'done' %}
            <form method="post" action="{{ path('app_task_complete', {id: task.id}) }}" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ task.id) }}">
                <button class="rams-btn rams-btn--success uppercase">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 8L6 11L13 4"/>
                    </svg>
                    {{ 'task.complete'|trans }}
                </button>
            </form>
            {% endif %}
            <a href="{{ path('app_task_edit', {id: task.id}) }}" class="rams-btn uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                </svg>
                {{ 'common.edit'|trans }}
            </a>
            <form method="post" action="{{ path('app_task_delete', {id: task.id}) }}" onsubmit="return confirm('{{ 'task.confirm_delete'|trans }}');" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                <button class="rams-btn rams-btn--danger uppercase">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M2 4H14M5 4V2H11V4M6 4V13H10V4"/>
                    </svg>
                    {{ 'common.delete'|trans }}
                </button>
            </form>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack">
        <div class="rams-grid-span-2 mobile-w-full">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'task.description'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-bg-surface-alt rams-p-4 rounded-rams-sm rams-border rams-border-rams-line">
                        {{ task.description|default('task.no_description'|trans)|nl2br }}
                    </div>
                </div>
            </div>

            {% if task.company %}
            <div class="rams-module rams-mt-6">
                <div class="rams-module__header">
                    <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'task.related_records'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                     <dl class="rams-definition-list">
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.company'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                <a href="#" class="rams-link">{{ safe_company_name(task) }}</a>
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>
            {% endif %}
        </div>

        <div class="mobile-w-full">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'task.details'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-definition-list">
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.status'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ (task.status|replace({'_': ' '}))|upper }}</dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'task.priority'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ task.priority|upper }}</dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'task.due_date'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                {% if task.dueDate %}
                                    <span class="{{ task.isOverdue ? 'rams-text--danger' : '' }}">
                                        {{ task.dueDate|date('M d, Y') }}
                                    </span>
                                {% else %}
                                    <span class="rams-text--muted">{{ 'task.no_due_date'|trans }}</span>
                                {% endif %}
                            </dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.time'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                {% if task.dueTime %}
                                    {{ task.dueTime|date('H:i') }}
                                {% else %}
                                    <span class="rams-text--muted">-</span>
                                {% endif %}
                            </dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'task.assigned_to'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                {% if task.assignedTo %}
                                    {{ task.assignedTo.fullName|default(task.assignedTo.email) }}
                                {% else %}
                                    <span class="rams-text--muted">{{ 'task.unassigned'|trans }}</span>
                                {% endif %}
                            </dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'task.estimated'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ task.estimatedMinutes ? task.estimatedMinutes ~ ' ' ~ 'task.mins'|trans : '-' }}</dd>
                        </div>
                    </dl>
                </div>
            </div>
            
            <div class="rams-module rams-mt-4">
                <div class="rams-module__header">
                    <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'task.meta'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-definition-list">
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'task.created'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ task.createdAt|date('M d, Y H:i') }}</dd>
                        </div>
                        
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'task.updated'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ task.updatedAt|date('M d, Y H:i') }}</dd>
                        </div>
                        
                        {% if task.completedAt %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'task.completed'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ task.completedAt|date('M d, Y H:i') }}</dd>
                        </div>
                        {% endif %}
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
