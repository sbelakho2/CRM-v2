{% extends 'base.html.twig' %}

{% block title %}Task: {{ task.title }} - CRM{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
            <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">Dashboard</a>
                <span class="rams-breadcrumb-separator">/</span>
                <a href="{{ path('app_task_index') }}">Tasks</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ task.title }}</span>
            </div>
            <div class="rams-flex rams-items-center rams-gap-2 rams-mt-2">
                <h1 class="rams-page__title">{{ task.title }}</h1>
                <span class="rams-badge rams-badge--{{ task.status == 'done' ? 'success' : (task.status == 'in_progress' ? 'warning' : 'neutral') }}">
                    {{ task.status|replace({'_': ' '})|title }}
                </span>
                <span class="rams-badge rams-badge--{{ task.priority == 'high' ? 'danger' : (task.priority == 'medium' ? 'warning' : 'neutral') }}">
                    {{ task.priority|title }}
                </span>
            </div>
        </div>
        <div class="rams-page__actions">
            {% if task.status != 'done' %}
            <form method="post" action="{{ path('app_task_complete', {id: task.id}) }}" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ task.id) }}">
                <button class="rams-btn--success">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 8L6 11L13 4"/>
                    </svg>
                    Complete
                </button>
            </form>
            {% endif %}
            <a href="{{ path('app_task_edit', {id: task.id}) }}" class="rams-btn">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                </svg>
                Edit
            </a>
            <form method="post" action="{{ path('app_task_delete', {id: task.id}) }}" onsubmit="return confirm('Are you sure you want to delete this task?');" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                <button class="rams-btn--danger">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M2 4H14M5 4V2H11V4M6 4V13H10V4"/>
                    </svg>
                    Delete
                </button>
            </form>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6">
        <div class="rams-grid-span-2">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3>Description</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-bg-surface-alt rams-p-4 rams-rounded rams-border rams-border-rams-border">
                        {{ task.description|default('No description provided.')|nl2br }}
                    </div>
                </div>
            </div>

            {% if task.company %}
            <div class="rams-module rams-mt-6">
                <div class="rams-module__header">
                    <h3>Related Records</h3>
                </div>
                <div class="rams-module__content">
                     <dl class="rams-dl">
                        <dt>Company</dt>
                        <dd>
                            <a href="#" class="rams-link">{{ task.company.name }}</a>
                        </dd>
                    </dl>
                </div>
            </div>
            {% endif %}
        </div>

        <div>
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3>Details</h3>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-dl">
                        <dt>Status</dt>
                        <dd>{{ task.status|replace({'_': ' '})|title }}</dd>
                        
                        <dt>Priority</dt>
                        <dd>{{ task.priority|title }}</dd>
                        
                        <dt>Due Date</dt>
                        <dd>
                            {% if task.dueDate %}
                                <span class="{{ task.isOverdue ? 'rams-rams-text--danger' : '' }}">
                                    {{ task.dueDate|date('M d, Y') }}
                                </span>
                            {% else %}
                                <span class="rams-rams-text--muted">No due date</span>
                            {% endif %}
                        </dd>
                        
                        <dt>Time</dt>
                        <dd>
                            {% if task.dueTime %}
                                {{ task.dueTime|date('H:i') }}
                            {% else %}
                                <span class="rams-rams-text--muted">-</span>
                            {% endif %}
                        </dd>
                        
                        <dt>Assigned To</dt>
                        <dd>
                            {% if task.assignedTo %}
                                {{ task.assignedTo.fullName|default(task.assignedTo.email) }}
                            {% else %}
                                <span class="rams-rams-text--muted">Unassigned</span>
                            {% endif %}
                        </dd>
                        
                        <dt>Estimated</dt>
                        <dd>{{ task.estimatedMinutes ? task.estimatedMinutes ~ ' mins' : '-' }}</dd>
                    </dl>
                </div>
            </div>
            
            <div class="rams-module rams-mt-4">
                <div class="rams-module__header">
                    <h3>Meta</h3>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-dl">
                        <dt>Created</dt>
                        <dd>{{ task.createdAt|date('M d, Y H:i') }}</dd>
                        
                        <dt>Updated</dt>
                        <dd>{{ task.updatedAt|date('M d, Y H:i') }}</dd>
                        
                        {% if task.completedAt %}
                        <dt>Completed</dt>
                        <dd>{{ task.completedAt|date('M d, Y H:i') }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
