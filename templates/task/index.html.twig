{% extends 'base.html.twig' %}

{% block title %}{{ 'task.title_crm'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ 'task.title'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'task.title'|trans }}</h1>
        </div>
        <div class="rams-page__actions">
            <div class="rams-btn-group">
                <a href="{{ path('app_task_my_day') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="8" cy="8" r="6"/><path d="M8 4V8L10 10"/>
                </svg>
                {{ 'task.my_day'|trans }}
                </a>
                <a href="{{ path('app_task_kanban') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="4" height="12" rx="1"/><rect x="6" y="2" width="4" height="8" rx="1"/><rect x="10" y="2" width="4" height="10" rx="1"/>
                </svg>
                {{ 'task.kanban'|trans }}
                </a>
                <a href="{{ path('app_task_new') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2V14M2 8H14"/>
                </svg>
                {{ 'task.new_task'|trans }}
                </a>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--4 rams-mb-6">
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label">{{ 'task.total_tasks'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ stats.total|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-red">{{ 'task.overdue'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-rams-red">{{ stats.overdue|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-orange">{{ 'task.due_today'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-rams-orange">{{ stats.due_today|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-green">{{ 'task.completed'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-rams-green">{{ stats.by_status.done|default(0) }}</div>
            </div>
        </div>
    </div>

    <div class="rams-module rams-mb-6">
        <div class="rams-module__content">
            <form method="GET" class="rams-grid rams-grid--5 rams-gap-4 rams-items-end">
                <div class="rams-form__group">
                    <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'common.status'|trans }}</label>
                    <select name="status" class="rams-form__select">
                        <option value="">{{ 'task.all_statuses'|trans }}</option>
                        {% for value, label in statuses %}
                            <option value="{{ value }}" {% if current_status == value %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="rams-form__group">
                     <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'task.priority'|trans }}</label>
                    <select name="priority" class="rams-form__select">
                        <option value="">{{ 'task.all_priorities'|trans }}</option>
                        {% for value, label in priorities %}
                            <option value="{{ value }}" {% if current_priority == value %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="rams-form__group">
                     <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'task.assignee'|trans }}</label>
                    <select name="assignee" class="rams-form__select">
                        <option value="">{{ 'task.all_assignees'|trans }}</option>
                        {% for user in users %}
                            <option value="{{ user.id }}" {% if current_assignee == user.id %}selected{% endif %}>{{ user.fullName }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="rams-form__group">
                    <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'common.search'|trans }}</label>
                    <input type="text" name="search" value="{{ current_search }}" placeholder="{{ 'task.search_tasks'|trans }}" class="rams-form__input">
                </div>

                <div class="rams-actions">
                    <button type="submit" class="rams-btn uppercase">{{ 'common.filter'|trans }}</button>
                    <a href="{{ path('app_task_index') }}" class="rams-btn rams-btn--ghost uppercase">{{ 'common.reset'|trans }}</a>
                </div>
            </form>
        </div>
    </div>
    
    <div class="rams-module">
        <div class="rams-table-container">
            <table class="rams-table">
                <thead>
                    <tr>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'common.status'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'task.title_header'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'task.priority'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'task.due_date'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'task.assigned_to'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    <tr>
                        <td>
                            <span class="rams-badge rams-badge--{{ task.status == 'done' ? 'success' : (task.status == 'in_progress' ? 'warning' : 'neutral') }} rams-badge--sm">
                                {{ task.status|replace({'_': ' '})|title }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('app_task_show', {id: task.id}) }}" class="rams-link rams-text--bold">{{ task.title }}</a>
                            {% if task.company %}
                                <div class="rams-text--xs rams-text--muted">{{ task.company.name }}</div>
                            {% endif %}
                        </td>
                        <td>
                             <span class="rams-badge rams-badge--{{ task.priority == 'high' ? 'danger' : (task.priority == 'medium' ? 'warning' : 'neutral') }} rams-badge--sm">
                                {{ task.priority|title }}
                            </span>
                        </td>
                        <td>
                            {% if task.dueDate %}
                                <span class="{{ task.isOverdue ? 'rams-text--danger' : '' }}">
                                    {{ task.dueDate|date('M d') }}
                                </span>
                            {% else %}
                                <span class="rams-text--muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if task.assignedTo %}
                                <span class="rams-avatar rams-avatar--sm rams-bg-primary rams-text-white" title="{{ task.assignedTo.fullName }}">
                                    {{ task.assignedTo.firstName|first }}{{ task.assignedTo.lastName|first }}
                                </span>
                            {% else %}
                                <span class="rams-text--muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="rams-actions rams-actions--sm">
                                <a href="{{ path('app_task_edit', {id: task.id}) }}" class="rams-btn rams-btn--ghost rams-btn--icon" title="{{ 'common.edit'|trans }}">
                                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="rams-text--center rams-p-8 rams-text--muted">
                            {{ 'task.no_tasks_found'|trans }}<a href="{{ path('app_task_new') }}" class="rams-link">{{ 'task.create_one_now'|trans }}</a>.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
