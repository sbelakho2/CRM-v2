{% extends 'base.html.twig' %}

{% block title %}{{ 'task.title_crm'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span>{{ 'task.title'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'task.title'|trans }}</h1>
        </div>
        <div class="rams-page__actions mobile-stack">
            <div class="rams-btn-group mobile-stack">
                <a href="{{ path('app_task_my_day') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="8" cy="8" r="6"/><path d="M8 4V8L10 10"/>
                </svg>
                {{ 'task.my_day'|trans }}
                </a>
                <a href="{{ path('app_task_kanban') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="4" height="12" rx="1"/><rect x="6" y="2" width="4" height="8" rx="1"/><rect x="10" y="2" width="4" height="10" rx="1"/>
                </svg>
                {{ 'task.kanban'|trans }}
                </a>
                <a href="{{ path('app_task_new') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2V14M2 8H14"/>
                </svg>
                {{ 'task.new_task'|trans }}
                </a>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--4 rams-mb-6">
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label">{{ 'task.total_tasks'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ stats.total|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label rams-text--danger">{{  'task.overdue'|trans }}</div>
                <div class="rams-metric__value tabular-nums rams-text--danger">{{  stats.overdue|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label rams-text--warning">{{  'task.due_today'|trans }}</div>
                <div class="rams-metric__value tabular-nums rams-text--warning">{{  stats.due_today|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label rams-text--success">{{  'task.completed'|trans }}</div>
                <div class="rams-metric__value tabular-nums rams-text--success">{{  stats.by_status.done|default(0) }}</div>
            </div>
        </div>
    </div>

    <div class="rams-module rams-mb-6">  
        <div class="rams-module__content"> 
            <form method="GET" action="{{ path('app_task_index') }}" class="rams-stack rams-gap-3"> 
                <div class="rams-flex rams-flex-wrap rams-items-end rams-gap-3">    
                    <div class="rams-flex-1">  
                        <label for="task-search" class="rams-text--xs rams-text--muted rams-mb-1 rams-block">{{      'common.search'|trans }}</label>
                        <input type="text" name="search" id="task-search" placeholder="{{ 'task.search_tasks'|trans }}" value="{{ current_search }}" class="rams-input rams-text--sm rams-w-full">   
                    </div>
                    <div class="rams-w-auto"> 
                        <label for="task-status" class="rams-text--xs rams-text--muted rams-mb-1 rams-block">{{      'common.status'|trans }}</label>
                        <select name="status" id="task-status" class="rams-input rams-text--sm rams-w-full">   
                            <option value="">{{ 'task.all_statuses'|trans }}</option>
                            {% for value, label in statuses %}
                                <option value="{{ value }}" {{ current_status == value ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="rams-w-auto"> 
                        <label for="task-priority" class="rams-text--xs rams-text--muted rams-mb-1 rams-block">{{      'task.priority'|trans }}</label>
                        <select name="priority" id="task-priority" class="rams-input rams-text--sm rams-w-full">   
                            <option value="">{{ 'task.all_priorities'|trans }}</option>
                            {% for value, label in priorities %}
                                <option value="{{ value }}" {{ current_priority == value ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="rams-w-auto"> 
                        <label for="task-assignee" class="rams-text--xs rams-text--muted rams-mb-1 rams-block">{{      'task.assignee'|trans }}</label>
                        <select name="assignee" id="task-assignee" class="rams-input rams-text--sm rams-w-full">   
                            <option value="">{{ 'task.all_assignees'|trans }}</option>
                            {% for user in users %}
                                <option value="{{ user.id }}" {{ current_assignee == user.id ? 'selected' : '' }}>{{ user.fullName }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="rams-flex rams-items-end rams-gap-2">   
                        <button type="submit" class="rams-btn rams-btn--primary rams-text--sm">{{    'common.filter'|trans }}</button>
                        <a href="{{ path('app_task_index') }}" class="rams-btn rams-btn--ghost rams-text--sm">{{    'common.reset'|trans }}</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <div class="rams-module">
        <div class="rams-table-container">
            <table class="rams-table data-table" aria-label="{{ 'task.title'|trans }}">
                <caption class="rams-sr-only">{{ 'task.title'|trans }}</caption>
                <thead>
                    <tr>
                        <th scope="col" class="rams-font-mono rams-text-2xs rams-uppercase" style="letter-spacing: 0.05em;">{{     'common.status'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text-2xs rams-uppercase" style="letter-spacing: 0.05em;">{{     'task.title_header'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text-2xs rams-uppercase" style="letter-spacing: 0.05em;">{{     'task.priority'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text-2xs rams-uppercase" style="letter-spacing: 0.05em;">{{     'task.due_date'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text-2xs rams-uppercase" style="letter-spacing: 0.05em;">{{     'task.assigned_to'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text-2xs rams-uppercase" style="letter-spacing: 0.05em;">{{     'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    <tr>
                        <td>
                            <span class="rams-badge rams-badge--{{ task.status == 'done' ? 'success' : (task.status == 'in_progress' ? 'warning' : 'neutral') }} rams-badge--small">
                                {{ task.status|replace({'_': ' '})|title }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('app_task_show', {id: task.id}) }}" class="rams-link rams-text--bold">{{ task.title }}</a>
                            {% if safe_company_id(task) %}
                                <div class="rams-text--xs rams-text--muted">{{ safe_company_name(task) }}</div>
                            {% endif %}
                        </td>
                        <td>
                             <span class="rams-badge rams-badge--{{ task.priority == 'high' ? 'danger' : (task.priority == 'medium' ? 'warning' : 'neutral') }} rams-badge--small">
                                {{ task.priority|title }}
                            </span>
                        </td>
                        <td>
                            {% if task.dueDate %}
                                <span class="{{ task.isOverdue ? 'rams-text--danger' : '' }}">
                                    {{ task.dueDate|date('M d') }}
                                </span>
                            {% else %}
                                <span class="rams-text--muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if task.assignedTo %}
                                <span class="rams-avatar rams-avatar--sm"    title="{{ task.assignedTo.fullName }}">
                                    {{ task.assignedTo.firstName|first }}{{ task.assignedTo.lastName|first }}
                                </span>
                            {% else %}
                                <span class="rams-text--muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="rams-actions rams-actions--sm">
                                <a href="{{ path('app_task_edit', {id: task.id}) }}" class="rams-btn rams-btn--ghost rams-btn--icon" title="{{ 'common.edit'|trans }}">
                                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="rams-text--center rams-p-8 rams-text--muted">
                            {{ 'task.no_tasks_found'|trans }}<a href="{{ path('app_task_new') }}" class="rams-link">{{ 'task.create_one_now'|trans }}</a>.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
