{% extends 'base.html.twig' %}

{% block title %}{{ 'task.new_title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
            <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <a href="{{ path('app_task_index') }}">{{ 'task.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <span>{{ 'task.new_task'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'task.create_task'|trans }}</h1>
        </div>
    </div>

    <div class="rams-module">
        <div class="rams-module__content">
            {{ form_start(form, {'attr': {'class': 'rams-form'}}) }}
            
            <div class="rams-stack rams-gap-4">
                {{ form_row(form.title) }}
                {{ form_row(form.description, {'attr': {'rows': 4}}) }}
            </div>

            <div class="rams-grid rams-grid--3 rams-gap-4">
                {{ form_row(form.type) }}
                {{ form_row(form.priority) }}
                {{ form_row(form.status) }}
            </div>

            <div class="rams-grid rams-grid--3 rams-gap-4">
                {{ form_row(form.dueDate) }}
                {{ form_row(form.dueTime) }}
                {{ form_row(form.estimatedMinutes) }}
            </div>

            <div class="rams-grid rams-grid--2 rams-gap-4">
                {{ form_row(form.assignedTo) }}
                {{ form_row(form.reminderAt) }}
            </div>

            <div class="rams-border-t rams-my-lg"></div>   
            <h2 class="rams-font-mono rams-text--2xs rams-uppercase rams-text--muted rams-mb-4">{{ 'task.related_records'|trans }}</h2>

            <div class="rams-grid rams-grid--2 rams-gap-4">
                {{ form_row(form.company) }}
            </div>

            <div class="rams-actions rams-mt-6 mobile-stack">
                <button type="submit" class="rams-btn rams-btn--primary rams-uppercase"> 
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                    </svg>
                    {{ 'task.create_task'|trans }}
                </button>
                <a href="{{ path('app_task_index') }}" class="rams-btn rams-btn--ghost rams-uppercase">{{  'common.cancel'|trans }}</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
