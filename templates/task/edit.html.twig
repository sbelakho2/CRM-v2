{% extends 'base.html.twig' %}

{% block title %}{{ 'task.edit_title'|trans }} - {{ task.title }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <a href="{{ path('app_task_index') }}">{{ 'task.title'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <a href="{{ path('app_task_show', {id: task.id}) }}">{{ task.title }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ 'common.edit'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'task.edit_task'|trans }}</h1>
        </div>
        <div class="rams-page__actions">
            <a href="{{ path('app_task_show', {id: task.id}) }}" class="rams-btn uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M10 4L6 8L10 12"/>
                </svg>
                {{ 'task.back_to_task'|trans }}
            </a>
        </div>
    </div>

    <div class="rams-module">
        <div class="rams-module__content">
            {{ form_start(form, {'attr': {'class': 'rams-form'}}) }}
            
            <div class="rams-grid rams-grid--1 rams-gap-4">
                {{ form_row(form.title) }}
                {{ form_row(form.description, {'attr': {'rows': 4}}) }}
            </div>

            <div class="rams-grid rams-grid--3 rams-gap-4">
                {{ form_row(form.type) }}
                {{ form_row(form.priority) }}
                {{ form_row(form.status) }}
            </div>

            <div class="rams-grid rams-grid--3 rams-gap-4">
                {{ form_row(form.dueDate) }}
                {{ form_row(form.dueTime) }}
                {{ form_row(form.estimatedMinutes) }}
            </div>

            <div class="rams-grid rams-grid--2 rams-gap-4">
                {{ form_row(form.assignedTo) }}
                {{ form_row(form.reminderAt) }}
            </div>

            <hr class="rams-hr rams-my-6">
            <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mb-4">{{ 'task.related_records'|trans }}</h3>

            <div class="rams-grid rams-grid--2 rams-gap-4">
                {{ form_row(form.company) }}
            </div>

            <div class="rams-actions rams-mt-6">
                <button type="submit" class="rams-btn rams-btn--primary uppercase">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 2L14 4L4 14H2V12L12 2Z"/>
                    </svg>
                    {{ 'task.update_task'|trans }}
                </button>
                <a href="{{ path('app_task_show', {id: task.id}) }}" class="rams-btn rams-btn--ghost uppercase">{{ 'common.cancel'|trans }}</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
