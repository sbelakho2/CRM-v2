{% extends 'base.html.twig' %}

{% block title %}{{ 'task.my_day_title'|trans }}{% endblock %}

{% block body %}
{% set completed_today = stats.by_status['done']|default(0) %}
{% set remaining_today = todayTasks|length %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <a href="{{ path('app_task_index') }}">{{ 'task.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <span>{{ 'task.my_day'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'task.my_day'|trans }}</h1>
            <p class="rams-page__subtitle">{{ 'now'|date('l, F j, Y') }}</p>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack">
        <div class="rams-grid-span-2 mobile-w-full">
            <!-- Quick Add -->
            <div class="rams-module rams-mb-6">
                <div class="rams-module__content">
                     <form method="post" action="{{ path('app_task_quick_add') }}" class="rams-flex rams-gap-2 mobile-stack">
                        <label class="rams-sr-only" for="quick-add-title">{{ 'task.add_task_placeholder'|trans }}</label> <input type="text" id="quick-add-title" name="title" class="rams-form__input" placeholder="{{ 'task.add_task_placeholder'|trans }}" required>
                        <button type="submit" class="rams-btn rams-btn--primary rams-uppercase"> 
                            <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M8 2V14M2 8H14"/>
                            </svg>
                            {{ 'task.add'|trans }}
                        </button>
                    </form>
                </div>
            </div>

            <!-- Overdue -->
             {% if overdueTasks|length > 0 %}
            <div class="rams-mb-6">
                <h3 class="rams-font-mono rams-text--2xs rams-uppercase rams-text--red rams-mb-3">{{ 'task.overdue'|trans }}</h3>
                <div class="rams-flex rams-flex-col rams-gap-2">
                    {% for task in overdueTasks %}
                        {{ include('task/_task_item_row.html.twig', {task: task, overdue: true}) }}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <!-- Today -->
            <div class="rams-mb-6">
                <h3 class="rams-font-mono rams-text--2xs rams-uppercase rams-text--muted rams-mb-3">{{ 'task.today'|trans }}</h3>
                <div class="rams-flex rams-flex-col rams-gap-2">
                    {% for task in todayTasks %}
                        {{ include('task/_task_item_row.html.twig', {task: task}) }}
                    {% else %}
                        <div class="rams-module rams-p-8 rams-text--center rams-text--muted">
                            <p>{{ 'task.no_tasks_today'|trans }}</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="mobile-w-full">
            <!-- Stats or Calendar side view? -->
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3 class="rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{      'task.focus'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-flex rams-flex-col rams-gap-6">
                        <div class="rams-metric">
                            <div class="rams-metric__label">{{ 'task.completed_today'|trans }}</div>
                            <div class="rams-metric__value tabular-nums">{{ completed_today }}</div>
                        </div>
                        <div class="rams-metric">
                            <div class="rams-metric__label rams-text--warning">{{  'task.remaining'|trans }}</div>
                            <div class="rams-metric__value tabular-nums rams-text--warning">{{  remaining_today }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
