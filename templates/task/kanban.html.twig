{% extends 'base.html.twig' %}

{% block title %}{{ 'task.kanban_title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
{# Kanban styles now in sensei-rams.css #}
{% endblock %}

{% block body %}
<div class="rams-page">
     <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <a href="{{ path('app_task_index') }}">{{ 'task.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span> 
                <span>{{ 'task.kanban'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'task.kanban_board'|trans }}</h1>
        </div>
        <div class="rams-page__actions mobile-stack">
             <a href="{{ path('app_task_index') }}" class="rams-btn rams-uppercase"> 
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="10" height="10" rx="1"/><path d="M6 8L7 9L10 6"/>
                </svg>
                {{ 'task.list_view'|trans }}
            </a>
            <a href="{{ path('app_task_new') }}" class="rams-btn rams-btn--primary rams-uppercase"> 
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2V14M2 8H14"/>
                </svg>
                {{ 'task.new_task'|trans }}
            </a>
        </div>
    </div>

    <div class="rams-kanban">
        {% for status_key, status_label in statuses %}
            <div class="rams-kanban__column">
                <div class="rams-kanban__header">
                    <span class="rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{      status_label }}</span>
                    <span class="rams-badge rams-badge--small">{{   tasks_by_status[status_key]|default([])|length }}</span>
                </div>
                <div class="rams-kanban__cards"> 
                    {% for task in tasks_by_status[status_key]|default([]) %}
                    <div class="rams-kanban__card">
                        <a href="{{ path('app_task_show', {id: task.id}) }}" class="rams-kanban__card-title">
                            {{ task.title }}
                        </a>
                         {% if task.priority == 'high' %}
                            <span class="rams-badge rams-badge--danger rams-badge--small rams-mb-2">{{ 'task.high_priority'|trans }}</span>
                        {% endif %}
                        <div class="rams-kanban__card-meta">
                            <span>
                                {% if task.assignedTo %}
                                    {{ task.assignedTo.firstName }}
                                {% else %}
                                    -
                                {% endif %}
                            </span>
                            {% if task.dueDate %}
                                <span class="{{ task.isOverdue and task.status != 'done' ? 'rams-text--danger' : '' }}">
                                    {{ task.dueDate|date('M d') }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
