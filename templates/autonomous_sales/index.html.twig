{% extends 'base.html.twig' %}

{% block title %}{{ 'autonomous_sales.page_title'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">

    {# ================================================================== #}
    {# HEADER — Power toggle + dynamic subtitle                           #}
    {# ================================================================== #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'autonomous_sales.page_title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ dynamic_subtitle.key|trans(dynamic_subtitle.params) }}</p>
        </div>
        <div class="rams-page-header__actions">
            <form method="post" action="{{ path('autonomous_sales_toggle') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_toggle') }}">
                <button type="submit" class="rams-btn {% if enabled %}rams-btn--primary{% endif %}">
                    {% if enabled %}
                        {{ 'autonomous_sales.disable'|trans }}
                    {% else %}
                        {{ 'autonomous_sales.enable'|trans }}
                    {% endif %}
                </button>
            </form>
        </div>
    </div>

    {# ================================================================== #}
    {# FLASH MESSAGES                                                      #}
    {# ================================================================== #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="rams-alert rams-alert--{{ type == 'error' ? 'error' : (type == 'warning' ? 'warning' : (type == 'info' ? 'info' : 'success')) }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {# ================================================================== #}
    {# SYSTEM STATUS — Always visible traffic-light                       #}
    {# ================================================================== #}
    <div class="rams-module">
        <div class="rams-module__content">
            <div class="rams-flex rams-gap-4 rams-items-center">
                <div class="rams-andon">
                    {% if health.status == 'green' %}
                        <span class="rams-andon__light rams-andon__light--green"></span>
                    {% elseif health.status == 'yellow' %}
                        <span class="rams-andon__light rams-andon__light--yellow"></span>
                    {% elseif health.status == 'red' %}
                        <span class="rams-andon__light rams-andon__light--red"></span>
                    {% else %}
                        <span class="rams-andon__light"></span>
                    {% endif %}
                </div>
                <div>
                    <div class="rams-text--bold">{{ health.statusLabel }}</div>
                    <div class="rams-text--sm rams-text--muted">{{ health.statusDesc }}</div>
                </div>
            </div>
        </div>
    </div>

    {# ================================================================== #}
    {# TABS — Overview / Optimization / Settings (server-side routing)    #}
    {# ================================================================== #}
    {% if enabled %}
        <div class="rams-tabs">
            <a href="{{ path('autonomous_sales_index', {tab: 'overview'}) }}"
               class="rams-tab {{ active_tab == 'overview' ? 'rams-tab--active' : '' }}">
                {{ 'autonomous_sales.tab_overview'|trans }}
            </a>
            <a href="{{ path('autonomous_sales_index', {tab: 'optimization'}) }}"
               class="rams-tab {{ active_tab == 'optimization' ? 'rams-tab--active' : '' }}">
                {{ 'autonomous_sales.tab_optimization'|trans }}
            </a>
            <a href="{{ path('autonomous_sales_index', {tab: 'settings'}) }}"
               class="rams-tab {{ active_tab == 'settings' ? 'rams-tab--active' : '' }}">
                {{ 'autonomous_sales.tab_settings'|trans }}
            </a>
        </div>
    {% endif %}

    {# ================================================================== #}
    {# TAB CONTENT — Only one tab rendered per request                    #}
    {# ================================================================== #}

    {% if not enabled %}
        {# ============================================================== #}
        {# SYSTEM OFF — Show only the how-it-works explainer              #}
        {# ============================================================== #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h3>{{ 'autonomous_sales.how_it_works_title'|trans }}</h3>
            </div>
            <div class="rams-module__content">
                <div class="rams-grid rams-grid--3 rams-gap-4">
                    <div>
                        <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.how_it_works_step1_title'|trans }}</h4>
                        <p class="rams-text--sm rams-text--muted">{{ 'autonomous_sales.how_it_works_step1_desc'|trans }}</p>
                    </div>
                    <div>
                        <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.how_it_works_step2_title'|trans }}</h4>
                        <p class="rams-text--sm rams-text--muted">{{ 'autonomous_sales.how_it_works_step2_desc'|trans }}</p>
                    </div>
                    <div>
                        <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.how_it_works_step3_title'|trans }}</h4>
                        <p class="rams-text--sm rams-text--muted">{{ 'autonomous_sales.how_it_works_step3_desc'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>

    {% elseif active_tab == 'overview' %}
        {# ============================================================== #}
        {# OVERVIEW TAB — Setup wizard + Performance metrics               #}
        {# ============================================================== #}
        <div class="rams-tab-content">

            {# ── Wizard-style setup (only if incomplete) ── #}
            {% if not setup.allDone %}
                <div class="rams-module rams-mb-6">
                    <div class="rams-module__header">
                        <div class="rams-flex rams-justify-between rams-items-center" style="width:100%">
                            <h3>{{ 'autonomous_sales.wizard_title'|trans }}</h3>
                            <span class="rams-text--sm rams-text--muted">{{ 'autonomous_sales.setup_progress'|trans({'%completed%': setup.completed, '%total%': setup.total}) }}</span>
                        </div>
                    </div>
                    <div class="rams-module__content">
                        <div class="rams-progress rams-mb-4">
                            <div class="rams-progress__bar rams-progress__bar--info" style="width: {{ setup.pct }}%"></div>
                        </div>

                        {# Find the NEXT incomplete step and show only that one #}
                        {% set next_step = null %}
                        {% for step in setup.steps %}
                            {% if not step.done and next_step is null %}
                                {% set next_step = step %}
                            {% endif %}
                        {% endfor %}

                        {% if next_step %}
                            <div class="rams-flex rams-gap-3 rams-items-center rams-mb-4">
                                <span class="rams-badge rams-badge--info rams-badge--xs">{{ 'autonomous_sales.wizard_next'|trans }}</span>
                                <div>
                                    <div class="rams-text--bold">{{ next_step.label }}</div>
                                    <div class="rams-text--xs rams-text--muted">{{ next_step.help }}</div>
                                </div>
                            </div>

                            {# Contextual action button for the current step #}
                            {% if next_step.label starts with 'Initialize' and 'initialize' in automation.actions %}
                                <form method="post" action="{{ path('autonomous_sales_initialize') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_initialize') }}">
                                    <button type="submit" class="rams-btn rams-btn--primary">{{ 'autonomous_sales.initialize'|trans }}</button>
                                </form>
                            {% elseif next_step.label starts with 'Set up' and 'seed' in automation.actions %}
                                <form method="post" action="{{ path('autonomous_sales_seed') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_seed') }}">
                                    <input type="hidden" name="seedType" value="subject_line">
                                    <button type="submit" class="rams-btn rams-btn--primary">{{ 'autonomous_sales.setup_default_variations'|trans }}</button>
                                </form>
                            {% elseif next_step.label starts with 'Score' %}
                                <form method="post" action="{{ path('autonomous_sales_score_leads') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_score_leads') }}">
                                    <input type="hidden" name="limit" value="50">
                                    <button type="submit" class="rams-btn rams-btn--primary">{{ 'autonomous_sales.score_leads'|trans }}</button>
                                </form>
                            {% elseif next_step.label starts with 'Run first' %}
                                <form method="post" action="{{ path('autonomous_sales_hourly_run') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_hourly_run') }}">
                                    <input type="hidden" name="dryRun" value="1">
                                    <input type="hidden" name="limit" value="50">
                                    <button type="submit" class="rams-btn rams-btn--primary">{{ 'autonomous_sales.action_run_preview'|trans }}</button>
                                </form>
                            {% endif %}
                        {% endif %}

                        {# Compact checklist showing completed vs remaining #}
                        <details class="rams-mt-4">
                            <summary class="rams-text--xs rams-text--muted" style="cursor:pointer; user-select:none">{{ 'autonomous_sales.wizard_show_all_steps'|trans }}</summary>
                            <div class="rams-stack rams-gap-1 rams-mt-2">
                                {% for step in setup.steps %}
                                    <div class="rams-flex rams-gap-2 rams-items-center rams-text--sm">
                                        {% if step.done %}
                                            <span class="rams-badge rams-badge--success rams-badge--xs" style="min-width:20px;text-align:center">✓</span>
                                            <span class="rams-text--muted" style="text-decoration:line-through">{{ step.label }}</span>
                                        {% else %}
                                            <span class="rams-badge rams-badge--xs" style="min-width:20px;text-align:center">{{ loop.index }}</span>
                                            <span>{{ step.label }}</span>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </details>
                    </div>
                </div>
            {% endif %}

            {# ── Performance metrics (only if there is data) ── #}
            {% if performance.emailsSent > 0 or performance.leadsTotal > 0 %}
                <div class="rams-module rams-mb-6">
                    <div class="rams-module__header">
                        <h3>{{ 'autonomous_sales.performance_title'|trans }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <p class="rams-text--sm rams-text--muted rams-mb-4">{{ 'autonomous_sales.performance_description'|trans }}</p>
                        <div class="rams-grid rams-grid--4 rams-gap-4">
                            <div class="rams-metric">
                                <span class="rams-metric__label">{{ 'autonomous_sales.metric_emails_sent'|trans }}</span>
                                <span class="rams-metric__value">{{ performance.emailsSent|number_format }}</span>
                            </div>
                            <div class="rams-metric">
                                <span class="rams-metric__label">{{ 'autonomous_sales.metric_success_rate'|trans }}</span>
                                <span class="rams-metric__value">{{ performance.successPct }}%</span>
                                <span class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.metric_success_hint'|trans }}</span>
                            </div>
                            <div class="rams-metric">
                                <span class="rams-metric__label">{{ 'autonomous_sales.metric_active_variations'|trans }}</span>
                                <span class="rams-metric__value">{{ performance.variationsActive }}</span>
                                <span class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.metric_active_variations_hint'|trans }}</span>
                            </div>
                            <div class="rams-metric">
                                <span class="rams-metric__label">{{ 'autonomous_sales.metric_leads_available'|trans }}</span>
                                <span class="rams-metric__value">{{ performance.leadsTotal|number_format }}</span>
                                <span class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.metric_leads_scored'|trans({'%count%': performance.leadsScored}) }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# ── Quick actions (simplified — no batch inputs) ── #}
            {% if setup.allDone %}
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3>{{ 'autonomous_sales.quick_actions_title'|trans }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <div class="rams-grid rams-grid--2 rams-gap-4">
                            <div class="rams-module rams-module--inset">
                                <div class="rams-module__content">
                                    <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.quick_optimize_title'|trans }}</h4>
                                    <p class="rams-text--sm rams-text--muted rams-mb-3">{{ 'autonomous_sales.quick_optimize_desc'|trans }}</p>
                                    <form method="post" action="{{ path('autonomous_sales_hourly_run') }}" class="rams-flex rams-gap-3">
                                        <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_hourly_run') }}">
                                        <input type="hidden" name="dryRun" value="1">
                                        <input type="hidden" name="limit" value="50">
                                        <button type="submit" class="rams-btn rams-btn--primary">{{ 'autonomous_sales.action_run_preview'|trans }}</button>
                                    </form>
                                    <p class="rams-text--xs rams-text--muted rams-mt-2">{{ 'autonomous_sales.quick_optimize_hint'|trans }}</p>
                                </div>
                            </div>
                            <div class="rams-module rams-module--inset">
                                <div class="rams-module__content">
                                    <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.quick_score_title'|trans }}</h4>
                                    <p class="rams-text--sm rams-text--muted rams-mb-3">{{ 'autonomous_sales.quick_score_desc'|trans }}</p>
                                    <form method="post" action="{{ path('autonomous_sales_score_leads') }}" class="rams-flex rams-gap-3">
                                        <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_score_leads') }}">
                                        <input type="hidden" name="limit" value="50">
                                        <button type="submit" class="rams-btn">{{ 'autonomous_sales.quick_score_button'|trans }}</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# ── Safety shield summary ── #}
            <div class="rams-module rams-mt-6">
                <div class="rams-module__content">
                    <div class="rams-flex rams-gap-3 rams-items-center">
                        <span class="rams-text--bold">🛡️ {{ 'autonomous_sales.shield_summary'|trans({'%count%': safety_count}) }}</span>
                        <a href="{{ path('autonomous_sales_index', {tab: 'settings'}) }}" class="rams-text--sm" style="color: var(--rams-orange)">{{ 'autonomous_sales.shield_view_details'|trans }} →</a>
                    </div>
                </div>
            </div>
        </div>

    {% elseif active_tab == 'optimization' %}
        {# ============================================================== #}
        {# OPTIMIZATION TAB — Full actions + variations table              #}
        {# ============================================================== #}
        <div class="rams-tab-content">

            {# ── Advanced actions with full controls ── #}
            <div class="rams-module rams-mb-6">
                <div class="rams-module__header">
                    <h3>{{ 'autonomous_sales.actions_title'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <p class="rams-text--sm rams-text--muted rams-mb-4">{{ automation.detail }}</p>

                    <div class="rams-grid rams-grid--2 rams-gap-4">
                        {# Run optimization cycle — full controls #}
                        <div class="rams-module rams-module--inset">
                            <div class="rams-module__content">
                                <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.action_optimize_title'|trans }}</h4>
                                <p class="rams-text--sm rams-text--muted rams-mb-3">{{ 'autonomous_sales.action_optimize_desc'|trans }}</p>
                                <form method="post" action="{{ path('autonomous_sales_hourly_run') }}" class="rams-flex rams-gap-3 rams-items-end">
                                    <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_hourly_run') }}">
                                    <div>
                                        <label class="rams-form__label">{{ 'autonomous_sales.action_mode_label'|trans }}</label>
                                        <select name="dryRun" class="rams-form__select">
                                            <option value="1" selected>{{ 'autonomous_sales.action_mode_preview'|trans }}</option>
                                            <option value="0">{{ 'autonomous_sales.action_mode_apply'|trans }}</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="rams-form__label">{{ 'autonomous_sales.action_howmany_label'|trans }}</label>
                                        <input type="number" name="limit" value="50" min="1" max="100" class="rams-form__input" style="width:80px">
                                    </div>
                                    <button type="submit" class="rams-btn rams-btn--primary">{{ 'autonomous_sales.action_run_now'|trans }}</button>
                                </form>
                            </div>
                        </div>

                        {# Score leads — full controls #}
                        <div class="rams-module rams-module--inset">
                            <div class="rams-module__content">
                                <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.action_score_title'|trans }}</h4>
                                <p class="rams-text--sm rams-text--muted rams-mb-3">{{ 'autonomous_sales.action_score_desc'|trans }}</p>
                                <form method="post" action="{{ path('autonomous_sales_score_leads') }}" class="rams-flex rams-gap-3 rams-items-end">
                                    <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_score_leads') }}">
                                    <div>
                                        <label class="rams-form__label">{{ 'autonomous_sales.action_howmany_label'|trans }}</label>
                                        <input type="number" min="1" max="500" name="limit" value="50" class="rams-form__input" style="width:80px">
                                    </div>
                                    <button type="submit" class="rams-btn">{{ 'autonomous_sales.score_leads'|trans }}</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Email variations — top 5 per section unless expanded ── #}
            {% for section in variations %}
                <div class="rams-module rams-mb-6">
                    <div class="rams-module__header">
                        <div class="rams-flex rams-justify-between rams-items-center" style="width:100%">
                            <h3>{{ section.label }}</h3>
                            <span class="rams-text--sm rams-text--muted">{{ section.count }} {{ section.count != 1 ? 'autonomous_sales.variations'|trans : 'autonomous_sales.variation'|trans }}</span>
                        </div>
                    </div>
                    <div class="rams-module__content">
                        <p class="rams-text--sm rams-text--muted rams-mb-4">{{ section.explanation }}</p>

                        {% if section.items is empty %}
                            <div class="rams-empty-state">
                                <h4 class="rams-empty-state__title">{{ 'autonomous_sales.variations_empty_title'|trans }}</h4>
                                <p class="rams-text--muted">{{ 'autonomous_sales.variations_empty_desc'|trans }}</p>
                            </div>
                        {% else %}
                            {# Determine display list: top 5 or full #}
                            {% set display_limit = expand_variations ? section.items|length : 5 %}
                            {% set has_more = section.items|length > 5 and not expand_variations %}

                            <div class="rams-table-container">
                                <table class="rams-table">
                                    <thead>
                                        <tr>
                                            <th>{{ 'autonomous_sales.table_variation'|trans }}</th>
                                            <th class="rams-text--right">{{ 'autonomous_sales.table_emails_sent'|trans }}</th>
                                            <th class="rams-text--right">{{ 'autonomous_sales.table_performance'|trans }}</th>
                                            <th>{{ 'autonomous_sales.table_status'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for item in section.items|slice(0, display_limit) %}
                                            <tr{% if item.quarantined %} style="opacity: 0.5"{% endif %}>
                                                <td>
                                                    <div class="rams-text--bold">{{ item.name }}</div>
                                                    <div class="rams-text--xs rams-text--muted">{{ item.value|length > 50 ? item.value[:50] ~ '…' : item.value }}</div>
                                                </td>
                                                <td class="rams-text--right">{{ item.emailsSent }}</td>
                                                <td class="rams-text--right">
                                                    {% if item.emailsSent > 0 %}
                                                        {{ item.successPct }}%
                                                        {% if not item.isControl and item.vsBaseline is not null %}
                                                            {% if item.vsBaseline > 0 %}
                                                                <span style="color: var(--rams-success)"> ↑{{ item.vsBaseline }}%</span>
                                                            {% elseif item.vsBaseline < 0 %}
                                                                <span class="rams-text--danger"> ↓{{ item.vsBaseline|abs }}%</span>
                                                            {% endif %}
                                                        {% endif %}
                                                    {% else %}
                                                        <span class="rams-text--muted">—</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if item.badge == 'baseline' %}
                                                        <span class="rams-badge rams-badge--info rams-badge--xs">{{ 'autonomous_sales.badge_baseline'|trans }}</span>
                                                    {% elseif item.badge == 'winning' %}
                                                        <span class="rams-badge rams-badge--success rams-badge--xs">{{ 'autonomous_sales.badge_top_performer'|trans }}</span>
                                                    {% elseif item.badge == 'testing' %}
                                                        <span class="rams-badge rams-badge--xs">{{ 'autonomous_sales.badge_testing'|trans }}</span>
                                                    {% elseif item.badge == 'active' %}
                                                        <span class="rams-badge rams-badge--xs">{{ 'autonomous_sales.badge_active'|trans }}</span>
                                                    {% elseif item.badge == 'losing' %}
                                                        <span class="rams-badge rams-badge--warning rams-badge--xs">{{ 'autonomous_sales.badge_underperforming'|trans }}</span>
                                                    {% elseif item.badge == 'disabled' %}
                                                        <span class="rams-badge rams-badge--danger rams-badge--xs">{{ 'autonomous_sales.badge_disabled'|trans }}</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            {# Show all link if truncated #}
                            {% if has_more %}
                                <div class="rams-mt-3">
                                    <a href="{{ path('autonomous_sales_index', {tab: 'optimization', expand: 1}) }}" class="rams-text--sm" style="color: var(--rams-orange)">
                                        {{ 'autonomous_sales.show_all_variations'|trans({'%count%': section.items|length}) }} →
                                    </a>
                                </div>
                            {% endif %}
                        {% endif %}

                        {# Add custom variation — subject lines only #}
                        {% if section.type == 'subject_line' %}
                            <div class="rams-divider rams-my-4"></div>
                            <details>
                                <summary class="rams-text--sm rams-text--bold" style="cursor: pointer; user-select: none;">{{ 'autonomous_sales.custom_variation_summary'|trans }}</summary>
                                <p class="rams-text--xs rams-text--muted rams-mt-2 rams-mb-3">{{ 'autonomous_sales.custom_variation_desc'|trans }}</p>
                                <form method="post" action="{{ path('autonomous_sales_arm_create') }}" class="rams-flex rams-gap-3 rams-items-end">
                                    <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_arm_create') }}">
                                    <input type="hidden" name="armType" value="subject_line">
                                    <div style="flex: 1">
                                        <label class="rams-form__label">{{ 'autonomous_sales.custom_variation_name_label'|trans }}</label>
                                        <input type="text" name="armName" class="rams-form__input" placeholder="{{ 'autonomous_sales.arm_name_placeholder'|trans }}" required>
                                    </div>
                                    <div style="flex: 2">
                                        <label class="rams-form__label">{{ 'autonomous_sales.custom_variation_subject_label'|trans }}</label>
                                        <input type="text" name="armValue" class="rams-form__input" placeholder="{{ 'autonomous_sales.arm_value_placeholder'|trans }}" required>
                                    </div>
                                    <button type="submit" class="rams-btn">{{ 'autonomous_sales.custom_variation_add_button'|trans }}</button>
                                </form>
                            </details>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

    {% elseif active_tab == 'settings' %}
        {# ============================================================== #}
        {# SETTINGS TAB — How it works + Full safety features + Setup     #}
        {# ============================================================== #}
        <div class="rams-tab-content">

            {# ── How it works ── #}
            <div class="rams-module rams-mb-6">
                <div class="rams-module__header">
                    <h3>{{ 'autonomous_sales.how_it_works_title'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-grid rams-grid--3 rams-gap-4">
                        <div>
                            <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.how_it_works_step1_title'|trans }}</h4>
                            <p class="rams-text--sm rams-text--muted">{{ 'autonomous_sales.how_it_works_step1_desc'|trans }}</p>
                        </div>
                        <div>
                            <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.how_it_works_step2_title'|trans }}</h4>
                            <p class="rams-text--sm rams-text--muted">{{ 'autonomous_sales.how_it_works_step2_desc'|trans }}</p>
                        </div>
                        <div>
                            <h4 class="rams-text--bold rams-mb-2">{{ 'autonomous_sales.how_it_works_step3_title'|trans }}</h4>
                            <p class="rams-text--sm rams-text--muted">{{ 'autonomous_sales.how_it_works_step3_desc'|trans }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Safety features — full detail ── #}
            <div class="rams-module rams-mb-6">
                <div class="rams-module__header">
                    <h3>🛡️ {{ 'autonomous_sales.safety_full_title'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <p class="rams-text--sm rams-text--muted rams-mb-4">{{ 'autonomous_sales.safety_full_desc'|trans }}</p>
                    <div class="rams-grid rams-grid--2 rams-gap-4">
                        <div>
                            <h5 class="rams-text--sm rams-text--bold">{{ 'autonomous_sales.safety_auto_mode_title'|trans }}</h5>
                            <p class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.safety_auto_mode_desc'|trans }}</p>
                        </div>
                        <div>
                            <h5 class="rams-text--sm rams-text--bold">{{ 'autonomous_sales.safety_instant_kill_title'|trans }}</h5>
                            <p class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.safety_instant_kill_desc'|trans }}</p>
                        </div>
                        <div>
                            <h5 class="rams-text--sm rams-text--bold">{{ 'autonomous_sales.safety_business_hours_title'|trans }}</h5>
                            <p class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.safety_business_hours_desc'|trans }}</p>
                        </div>
                        <div>
                            <h5 class="rams-text--sm rams-text--bold">{{ 'autonomous_sales.safety_quality_checks_title'|trans }}</h5>
                            <p class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.safety_quality_checks_desc'|trans }}</p>
                        </div>
                        <div>
                            <h5 class="rams-text--sm rams-text--bold">{{ 'autonomous_sales.safety_shared_suppression_title'|trans }}</h5>
                            <p class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.safety_shared_suppression_desc'|trans }}</p>
                        </div>
                        <div>
                            <h5 class="rams-text--sm rams-text--bold">{{ 'autonomous_sales.safety_cross_module_limits_title'|trans }}</h5>
                            <p class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.safety_cross_module_limits_desc'|trans }}</p>
                        </div>
                        <div>
                            <h5 class="rams-text--sm rams-text--bold">{{ 'autonomous_sales.safety_unified_timeline_title'|trans }}</h5>
                            <p class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.safety_unified_timeline_desc'|trans }}</p>
                        </div>
                        <div>
                            <h5 class="rams-text--sm rams-text--bold">{{ 'autonomous_sales.safety_campaign_bridge_title'|trans }}</h5>
                            <p class="rams-text--xs rams-text--muted">{{ 'autonomous_sales.safety_campaign_bridge_desc'|trans }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Full setup checklist (for reference/debug) ── #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <div class="rams-flex rams-justify-between rams-items-center" style="width:100%">
                        <h3>{{ 'autonomous_sales.setup_title'|trans }}</h3>
                        <span class="rams-text--sm rams-text--muted">{{ 'autonomous_sales.setup_progress'|trans({'%completed%': setup.completed, '%total%': setup.total}) }}</span>
                    </div>
                </div>
                <div class="rams-module__content">
                    <p class="rams-text--sm rams-text--muted rams-mb-4">{{ 'autonomous_sales.setup_description'|trans }}</p>

                    <div class="rams-stack rams-gap-2">
                        {% for step in setup.steps %}
                            <div class="rams-flex rams-gap-3 rams-items-center" style="padding: 8px 0;">
                                {% if step.done %}
                                    <span class="rams-badge rams-badge--success rams-badge--xs" style="min-width: 24px; text-align: center">{{ 'autonomous_sales.setup_done_badge'|trans }}</span>
                                {% else %}
                                    <span class="rams-badge rams-badge--xs" style="min-width: 24px; text-align: center">{{ loop.index }}</span>
                                {% endif %}
                                <div>
                                    <div class="rams-text--sm {% if step.done %}rams-text--muted{% else %}rams-text--bold{% endif %}" style="{% if step.done %}text-decoration: line-through{% endif %}">{{ step.label }}</div>
                                    {% if not step.done %}
                                        <div class="rams-text--xs rams-text--muted">{{ step.help }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {# Setup action buttons #}
                    <div class="rams-flex rams-gap-3 rams-mt-4">
                        {% if 'initialize' in automation.actions %}
                            <form method="post" action="{{ path('autonomous_sales_initialize') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_initialize') }}">
                                <button type="submit" class="rams-btn rams-btn--primary">{{ 'autonomous_sales.initialize'|trans }}</button>
                            </form>
                        {% endif %}
                        {% if 'seed' in automation.actions %}
                            <form method="post" action="{{ path('autonomous_sales_seed') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('autonomous_sales_seed') }}">
                                <input type="hidden" name="seedType" value="subject_line">
                                <button type="submit" class="rams-btn">{{ 'autonomous_sales.setup_default_variations'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}
