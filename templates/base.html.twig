    {# DataTables: loaded lazily — jQuery + DataTables (~206KB) are only
       fetched on pages that actually contain a table.data-table. #}
    <script>
    (function() {
        var translations = {
            search: "{{ 'table.datatables_search'|trans }}",
            lengthMenu: "{{ 'table.datatables_length_menu'|trans }}",
            info: "{{ 'table.datatables_info'|trans }}",
            infoEmpty: "{{ 'table.datatables_info_empty'|trans }}",
            infoFiltered: "{{ 'table.datatables_info_filtered'|trans }}",
            zeroRecords: "{{ 'table.datatables_zero_records'|trans }}"
        };

        function needsDataTables() {
            var tables = document.querySelectorAll('table.data-table');
            for (var i = 0; i < tables.length; i++) {
                var t = tables[i];
                if (t.hasAttribute('data-no-datatable')) continue;
                // Skip tables with empty tbody or colspan rows (empty-state messages)
                var tbody = t.querySelector('tbody');
                if (tbody) {
                    var rows = tbody.querySelectorAll('tr');
                    if (rows.length === 0) continue;
                    if (rows.length === 1) {
                        var firstTd = rows[0].querySelector('td');
                        if (firstTd && firstTd.hasAttribute('colspan')) continue;
                    }
                }
                return true;
            }
            return false;
        }

        function initDataTables() {
            document.querySelectorAll('table.data-table').forEach(function(table) {
                if (table.hasAttribute('data-no-datatable')) return;

                var tbody = table.querySelector('tbody');
                if (tbody) {
                    var rows = tbody.querySelectorAll('tr');
                    if (rows.length === 0) return;
                    if (rows.length === 1) {
                        var firstTd = rows[0].querySelector('td');
                        if (firstTd && firstTd.hasAttribute('colspan')) return;
                    }
                }

                // Server-side pages pre-paginate to 50 rows, so cap client-side
                // pagination at the same limit and never offer an unbounded "All".
                var pageLength = table.getAttribute('data-page-length') || 25;
                var ths = table.querySelectorAll('thead th');
                var colCount = ths.length;
                new DataTable(table, {
                    pageLength: parseInt(pageLength),
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    order: [],
                    columns: colCount > 0 ? Array(colCount).fill(null) : undefined,
                    language: translations,
                    dom: '<"rams-flex rams-flex-wrap rams-items-center rams-justify-between rams-gap-2 rams-mb-3"lf>t<"rams-flex rams-flex-wrap rams-items-center rams-justify-between rams-gap-2 rams-mt-3"ip>'
                });
            });
        }

        function loadScript(src, integrity, onLoad) {
            var s = document.createElement('script');
            s.src = src;
            if (integrity) {
                s.integrity = integrity;
                s.crossOrigin = 'anonymous';
            }
            s.onload = onLoad;
            document.head.appendChild(s);
        }

        if (needsDataTables()) {
            loadScript(
                'https://code.jquery.com/jquery-3.7.1.min.js',
                'sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=',
                function() {
                    loadScript(
                        'https://cdn.datatables.net/2.1.8/js/dataTables.min.js',
                        'sha384-MgwUq0TVErv5Lkj/jIAgQpC+iUIqwhwXxJMfrZQVAOhr++1MR02yXH8aXdPc3fk0',
                        initDataTables
                    );
                }
            );
        }
    })();
    </script>
