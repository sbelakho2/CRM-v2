<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CRM Starz Morocco{% endblock %}</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <style>
        /* Claude AI Color Scheme */
        :root {
            --sidebar-width: 260px;
            --claude-cream: #F5F3EE;
            --claude-tan: #E8E3D8;
            --claude-brown: #8B7355;
            --claude-purple: #9B6B9E;
            --claude-dark-purple: #7C5380;
            --claude-text: #2C2416;
            --claude-text-secondary: #5C5041;
            --claude-border: #DDD8CC;
            --claude-hover: #EDE9E0;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            background: var(--claude-cream);
            color: var(--claude-text);
            display: flex;
            min-height: 100vh;
            line-height: 1.6;
        }
        
        /* Use consistent font throughout */
        body, h1, h2, h3, h4, h5, h6 {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
        }
        
        /* Sidebar Styles */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--claude-tan);
            border-right: 1px solid var(--claude-border);
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 32px 0;
            box-shadow: 2px 0 8px rgba(44, 36, 22, 0.04);
        }
        
        .sidebar-header {
            padding: 0 20px 24px;
            border-bottom: 1px solid var(--claude-border);
            margin-bottom: 16px;
        }
        
        .sidebar-logo {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            font-size: 20px;
            font-weight: 500;
            color: var(--claude-dark-purple);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .sidebar-nav {
            list-style: none;
            padding: 0 0 100px 0;
            margin: 0;
        }
        
        .sidebar-nav-item {
            padding: 0 16px;
            margin-bottom: 4px;
        }
        
        .sidebar-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            color: var(--claude-text-secondary);
            text-decoration: none;
            border-radius: 10px;
            font-size: 14.5px;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        
        .sidebar-nav-link:hover {
            background: var(--claude-hover);
            color: var(--claude-text);
        }
        
        .sidebar-nav-link.active {
            background: var(--claude-purple);
            color: #FFFFFF;
        }
        
        .sidebar-nav-link svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
            opacity: 0.8;
        }
        
        .sidebar-nav-link.active svg {
            opacity: 1;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 20px 8px;
            border-top: 1px solid var(--claude-border);
        }
        
        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            flex: 1;
            background: var(--claude-cream);
            min-height: 100vh;
            padding: 40px 48px;
        }
        
        /* Headers */
        h1, h2, h3, h4, h5, h6 {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            color: var(--claude-text);
            line-height: 1.3;
        }
        
        h1 {
            font-size: 32px;
            font-weight: 500;
            margin-bottom: 8px;
        }
        
        h2 {
            font-size: 24px;
            font-weight: 500;
            margin-bottom: 20px;
        }
        
        h3 {
            font-size: 18px;
            font-weight: 500;
            margin-bottom: 12px;
        }
        
        h4 {
            font-size: 16px;
            font-weight: 500;
            margin-bottom: 10px;
        }
        
        /* Cards */
        .card {
            background: #FFFFFF;
            border: 1px solid var(--claude-border);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 1px 3px rgba(44, 36, 22, 0.06);
        }
        
        /* Tables */
        table {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid var(--claude-border);
            border-radius: 12px;
            overflow: hidden;
            border-collapse: separate;
            border-spacing: 0;
        }
        
        thead {
            background: var(--claude-tan);
        }
        
        th {
            padding: 14px 16px;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            color: var(--claude-text);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--claude-border);
        }
        
        td {
            padding: 14px 16px;
            color: var(--claude-text);
            font-size: 14px;
            border-bottom: 1px solid var(--claude-border);
        }
        
        tr:last-child td {
            border-bottom: none;
        }
        
        tbody tr:hover {
            background: var(--claude-hover);
        }
        
        /* Buttons */
        .btn, .geist-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            background: var(--claude-purple);
            color: #FFFFFF;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        
        .btn:hover, .geist-button:hover {
            background: var(--claude-dark-purple);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(155, 107, 158, 0.25);
        }
        
        .btn-secondary, .geist-button-secondary {
            background: #FFFFFF;
            color: var(--claude-text);
            border: 1px solid var(--claude-border);
        }
        
        .btn-secondary:hover, .geist-button-secondary:hover {
            background: var(--claude-hover);
            border-color: var(--claude-brown);
            transform: translateY(-1px);
        }
        
        .btn-sm {
            padding: 6px 12px;
            font-size: 13px;
        }
        
        /* Forms */
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 6px;
            font-size: 14px;
            font-weight: 500;
            color: var(--claude-text);
        }
        
        .geist-input, .geist-select, .geist-textarea, 
        input[type="text"], input[type="email"], input[type="password"], 
        input[type="date"], input[type="number"], select, textarea {
            width: 100%;
            padding: 10px 14px;
            background: #FFFFFF;
            border: 1px solid var(--claude-border);
            border-radius: 8px;
            color: var(--claude-text);
            font-size: 14px;
            font-family: inherit;
            transition: all 0.2s ease;
        }
        
        .geist-input:focus, .geist-select:focus, .geist-textarea:focus,
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--claude-purple);
            box-shadow: 0 0 0 3px rgba(155, 107, 158, 0.1);
        }
        
        .geist-input::placeholder, input::placeholder, textarea::placeholder {
            color: var(--claude-text-secondary);
        }
        
        /* Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            background: var(--claude-tan);
            color: var(--claude-text);
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .badge-success {
            background: #D4EDDA;
            color: #155724;
        }
        
        .badge-warning {
            background: #FFF3CD;
            color: #856404;
        }
        
        .badge-danger {
            background: #F8D7DA;
            color: #721C24;
        }
        
        .badge-info {
            background: #D1ECF1;
            color: #0C5460;
        }
        
        .badge-primary {
            background: var(--claude-purple);
            color: #FFFFFF;
        }
        
        /* Alerts */
        .alert {
            padding: 14px 18px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 14px;
            border: 1px solid transparent;
        }
        
        .alert-success {
            background: #D4EDDA;
            color: #155724;
            border-color: #C3E6CB;
        }
        
        .alert-info {
            background: #D1ECF1;
            color: #0C5460;
            border-color: #BEE5EB;
        }
        
        .alert-warning {
            background: #FFF3CD;
            color: #856404;
            border-color: #FFEAA7;
        }
        
        .alert-danger {
            background: #F8D7DA;
            color: #721C24;
            border-color: #F5C6CB;
        }
        
        /* Utilities */
        .text-muted {
            color: var(--claude-text-secondary);
        }
        
        .mb-0 { margin-bottom: 0; }
        .mb-1 { margin-bottom: 8px; }
        .mb-2 { margin-bottom: 16px; }
        .mb-3 { margin-bottom: 24px; }
        .mb-4 { margin-bottom: 32px; }
        
        .mt-0 { margin-top: 0; }
        .mt-1 { margin-top: 8px; }
        .mt-2 { margin-top: 16px; }
        .mt-3 { margin-top: 24px; }
        .mt-4 { margin-top: 32px; }
        
        /* Page Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            padding-bottom: 20px;
            border-bottom: 2px solid var(--claude-border);
        }
        
        .page-title {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 28px;
            font-weight: 500;
            color: var(--claude-text);
        }
        
        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        
        .stat-card {
            background: #FFFFFF;
            border: 1px solid var(--claude-border);
            border-radius: 12px;
            padding: 20px;
            transition: all 0.2s ease;
        }
        
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(44, 36, 22, 0.08);
        }
        
        .stat-label {
            font-size: 13px;
            color: var(--claude-text-secondary);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }
        
        .stat-value {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 32px;
            font-weight: 500;
            color: var(--claude-purple);
        }
        
        /* Links */
        a:not(.btn):not(.geist-button):not(.sidebar-nav-link) {
            color: var(--claude-purple);
            text-decoration: none;
        }
        
        a:not(.btn):not(.geist-button):not(.sidebar-nav-link):hover {
            color: var(--claude-dark-purple);
            text-decoration: underline;
        }
        
        /* Paragraphs */
        p {
            color: var(--claude-text-secondary);
        }
        
        /* Lists */
        ul, ol {
            color: var(--claude-text);
        }
        
        /* Strong text */
        strong, b {
            font-weight: 600;
            color: var(--claude-text);
        }
        
        /* Small text */
        small, .text-sm {
            font-size: 13px;
            color: var(--claude-text-secondary);
        }
        
        /* CRITICAL: Apply Claude color scheme consistently to ALL Tailwind classes */
        
        /* Most dark backgrounds become white cards */
        .bg-black, .bg-zinc-950, .bg-gray-900,
        .bg-neutral-900, .bg-gray-800 {
            background: #FFFFFF !important;
        }
        
        /* bg-zinc-900 becomes tan (matches Email Campaigns filter containers) */
        .bg-zinc-900, .bg-zinc-800 {
            background: var(--claude-tan) !important;
        }
        
        /* Semi-transparent dark backgrounds become white */
        .bg-zinc-950\/50, .bg-zinc-900\/30, .bg-black\/50 {
            background: #FFFFFF !important;
        }
        
        /* Light neutral backgrounds use cream */
        .bg-neutral-50, .bg-gray-50, .bg-gray-100 {
            background: var(--claude-cream) !important;
        }
        
        /* All light text becomes dark */
        .text-white, .text-zinc-100, .text-zinc-200, .text-zinc-300 {
            color: var(--claude-text) !important;
        }
        
        /* Gray text becomes secondary color */
        .text-zinc-400, .text-zinc-500, .text-zinc-600,
        .text-gray-400, .text-gray-500, .text-gray-600,
        .text-neutral-400, .text-neutral-500, .text-neutral-600 {
            color: var(--claude-text-secondary) !important;
        }
        
        /* Dark text stays dark */
        .text-neutral-900, .text-gray-900, .text-black {
            color: var(--claude-text) !important;
        }
        
        /* All borders use Claude border color */
        .border-zinc-800, .border-zinc-700, .border-zinc-600,
        .border-gray-800, .border-gray-700, .border-gray-600,
        .border-neutral-200, .border-neutral-300 {
            border-color: var(--claude-border) !important;
        }
        
        /* Hover border effects */
        .hover\:border-zinc-700:hover, .hover\:border-gray-700:hover {
            border-color: var(--claude-brown) !important;
        }
        
        /* Full height containers use cream background */
        .min-h-screen {
            background: var(--claude-cream) !important;
        }
        
        /* Padding containers transparent */
        .p-8, .px-6, .py-16, .max-w-7xl {
            background: transparent !important;
        }
        
        /* BUTTONS ONLY: Purple styling for actual buttons */
        /* White backgrounds with text-black are purple buttons (active state in filters) */
        /* REMOVED: This was making card links purple - disabled for Geist theme */
        /* a.bg-white.text-black, button.bg-white.text-black {
            background: var(--claude-purple) !important;
            color: #FFFFFF !important;
        } */
        
        /* Blue buttons become purple - disabled for Geist neutral theme */
        /* .bg-blue-600, .bg-blue-500 {
            background: var(--claude-purple) !important;
        } */
        
        /* Blue buttons - disabled for Geist neutral theme */
        /* .hover\:bg-blue-700:hover, .hover\:bg-blue-600:hover {
            background: var(--claude-dark-purple) !important;
        } */
        
        /* Primary action buttons that are white become purple */
        /* REMOVED: This was making all white links/cards purple - disabled for Geist theme */
        /* a.bg-white:not(td):not(th), button.bg-white:not(td):not(th) {
            background: var(--claude-purple) !important;
            color: #FFFFFF !important;
        } */
        
        .hover\:bg-zinc-100:hover, .hover\:bg-gray-100:hover {
            background: var(--claude-dark-purple) !important;
        }
        
        /* Filter/tab containers use tan background */
        .bg-zinc-900.border-zinc-800 {
            background: var(--claude-tan) !important;
            border-color: var(--claude-border) !important;
        }
        
        /* Hover text effects */
        .hover\:text-white:hover {
            color: var(--claude-text) !important;
        }
        
        .hover\:text-zinc-300:hover {
            color: var(--claude-dark-purple) !important;
        }
        
        /* All heading classes use serif and dark text */
        .text-2xl, .text-xl, .text-lg,
        .font-light, .font-semibold, .font-medium {
            color: var(--claude-text) !important;
            font-family: Georgia, 'Times New Roman', serif !important;
        }
        
        /* Active tab indicators use purple */
        .border-b-2.border-white,
        a.border-white, button.border-white {
            border-color: var(--claude-purple) !important;
        }
        
        /* Remove backdrop blur effects */
        .backdrop-blur-xl, .backdrop-blur {
            backdrop-filter: none !important;
            background: transparent !important;
        }
        
        /* Sticky/fixed elements use cream */
        .sticky, .fixed {
            background: var(--claude-cream) !important;
        }
        
        /* All cards/containers with rounded corners have tan background (matches Email Campaigns) */
        div.bg-white, section.bg-white, article.bg-white {
            background: var(--claude-tan) !important;
            border-color: var(--claude-border) !important;
        }
        
        /* Rounded elements that aren't buttons use tan */
        div.rounded-xl, div.rounded-lg, div.rounded-md {
            background: var(--claude-tan) !important;
            border-color: var(--claude-border) !important;
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
