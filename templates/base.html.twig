<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale starts with 'ar' ? 'rtl' : 'ltr' }}" data-theme="{{ app.user ? (app.user.preferredTheme ?? 'system') : 'system' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}{{ 'messages.meta_description'|trans }}{% endblock %}">
    <title>{% block title %}{{ 'app.name'|trans }}{% endblock %} - {{ 'app.company'|trans }}</title>
    
    {# Sensei-Rams Design System CSS (versioned; bumped only when the stylesheet changes) #}
    <link rel="stylesheet" href="{{ asset('css/sensei-rams.css') }}?v=3.3">
    
    {# Font preloading for performance - preconnect early, load fonts async #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# Use media="print" + onload trick for non-render-blocking font loading #}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
    
    {% block stylesheets %}{% endblock %}
</head>
<body 
    data-user-theme="{{ app.user ? (app.user.preferredTheme ?? 'system') : 'system' }}" 
    data-user-accent="{{ app.user ? (app.user.accentColor ?? 'orange') : 'orange' }}"
    data-user-font-size="{{ app.user ? (app.user.fontSize ?? 'medium') : 'medium' }}"
    data-user-density="{{ app.user ? (app.user.density ?? 'comfortable') : 'comfortable' }}"
    data-user-reduced-motion="{{ app.user ? (app.user.reducedMotion ? 'true' : 'false') : 'false' }}">
    {# Skip Link for Accessibility #}
    <a href="#main-content" class="rams-skip-link">{{ 'accessibility.skip_to_content'|trans }}</a>
    
    {% set isAuthPage = app.request.get('_route') in ['app_login', 'app_register', 'app_forgot_password', 'app_reset_password'] %}
    
    {% if not isAuthPage %}
        {# Industrial Bezel Frame (Desktop only) #}
        <div class="rams-bezel" aria-hidden="true"></div>

        {# Mobile Top Bar #}
        <header class="rams-mobile-header" role="banner">
            <button class="rams-mobile-header__toggle" type="button"
                    aria-controls="rams-sidebar" aria-expanded="false"
                    aria-label="{{ 'accessibility.toggle_navigation'|trans|default('Toggle navigation') }}">
                <span class="rams-mobile-header__toggle-bar"></span>
                <span class="rams-mobile-header__toggle-bar"></span>
                <span class="rams-mobile-header__toggle-bar"></span>
            </button>
            <div class="rams-mobile-header__brand">
                <img src="{{ asset('images/starz-mark.svg') }}" data-theme-src="light:/images/starz-mark.svg|dark:/images/starz-mark-inverse.svg" alt="{{ 'app.name'|trans }} logo" class="rams-mobile-header__logo" width="272" height="220"> 
                <span class="rams-mobile-header__title">{{ 'app.name'|trans }}</span>
            </div>
        </header>
        
        {# Rack Sidebar #}
        <aside class="rams-sidebar" id="rams-sidebar" role="navigation" aria-label="{{ 'accessibility.navigation'|trans }}">
            {# Station Identifier #}
            <div class="rams-sidebar__header">
                <div class="rams-sidebar__logo">
                    <img src="{{ asset('images/starz-mark.svg') }}" data-theme-src="light:/images/starz-mark.svg|dark:/images/starz-mark-inverse.svg" alt="{{ 'app.name'|trans }} logo" class="rams-logo-image" width="272" height="220"> 
                </div>
                <div>
                    <div class="rams-sidebar__title">{{ 'app.name'|trans }}</div>
                    <div class="rams-sidebar__subtitle">{{ 'app.subtitle'|trans }}</div>
