    <!-- ABM Web Event Tracking -->
    <script>
    (function() {
        'use strict';
        
        // Configuration
        const ABM_CONFIG = {
            apiEndpoint: '/api/web-event',
            trackPageViews: true,
            trackClicks: true,
            trackFormSubmits: true,
            trackDownloads: true,
            debounceDelay: 500
        };
        
        // Tracking state
        let isTracking = true;
        let eventQueue = [];
        let sendTimeout = null;
        
        /**
         * Send event to backend API
         */
        function sendEvent(eventData) {
            if (!isTracking) return;
            
            fetch(ABM_CONFIG.apiEndpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(eventData)
            }).catch(function(error) {
                console.warn('ABM tracking error:', error);
            });
        }
        
        /**
         * Track page view
         */
        function trackPageView() {
            if (!ABM_CONFIG.trackPageViews) return;
            
            sendEvent({
                url: window.location.pathname + window.location.search,
                event_type: 'page_view',
                metadata: {
                    title: document.title,
                    referrer: document.referrer
                }
            });
        }
        
        /**
         * Track link clicks
         */
        function trackClick(event) {
            if (!ABM_CONFIG.trackClicks) return;
            
            const target = event.target.closest('a');
            if (!target) return;
            
            const href = target.getAttribute('href');
            if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
            
            sendEvent({
                url: window.location.pathname,
                event_type: 'click',
                metadata: {
                    link_text: target.textContent.trim().substring(0, 100),
                    link_href: href,
                    link_class: target.className
                }
            });
        }
        
        /**
         * Track form submissions
         */
        function trackFormSubmit(event) {
            if (!ABM_CONFIG.trackFormSubmits) return;
            
            const form = event.target;
            const formId = form.id || form.name || 'unknown';
            const formAction = form.action || window.location.href;
            
            sendEvent({
                url: window.location.pathname,
                event_type: 'form_submit',
                metadata: {
                    form_id: formId,
                    form_action: formAction,
                    form_method: form.method
                }
            });
        }
        
        /**
         * Track file downloads
         */
        function trackDownload(event) {
            if (!ABM_CONFIG.trackDownloads) return;
            
            const target = event.target.closest('a');
            if (!target) return;
            
            const href = target.getAttribute('href');
            if (!href) return;
            
            // Check if it's a download link (pdf, doc, xls, zip, etc.)
            const downloadExtensions = /\.(pdf|doc|docx|xls|xlsx|ppt|pptx|zip|rar|csv)$/i;
            if (!downloadExtensions.test(href)) return;
            
            sendEvent({
                url: window.location.pathname,
                event_type: 'download',
                metadata: {
                    file_name: href.split('/').pop(),
                    file_url: href
                }
            });
        }
        
        /**
         * Initialize tracking
         */
        function init() {
            // Track initial page view
            trackPageView();
            
            // Track clicks with debouncing
            let clickTimeout;
            document.addEventListener('click', function(e) {
                clearTimeout(clickTimeout);
                clickTimeout = setTimeout(function() {
                    trackClick(e);
                    trackDownload(e);
                }, ABM_CONFIG.debounceDelay);
            }, true);
            
            // Track form submissions
            document.addEventListener('submit', trackFormSubmit, true);
            
            // Track page visibility changes (user returns to tab)
            document.addEventListener('visibilitychange', function() {
                if (!document.hidden && ABM_CONFIG.trackPageViews) {
                    sendEvent({
                        url: window.location.pathname,
                        event_type: 'page_focus',
                        metadata: {
                            title: document.title
                        }
                    });
                }
            });
        }
        
        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
    </script>
</body>
