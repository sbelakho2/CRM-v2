                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M8 2L3 7L8 12L13 7L8 2Z"/>
                            <circle cx="8" cy="7" r="2"/>
                        </svg>
                        Leads
                    </a>
                </li>
                
                <li class="sidebar-nav-item">
                    <a href="{{ path('app_webcrawler_index') }}" class="sidebar-nav-link {% if app.request.get('_route') starts with 'app_webcrawler' %}active{% endif %}">
