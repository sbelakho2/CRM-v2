    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Open the group containing the active link
        const activeLink = document.querySelector('.rams-sidebar__nav-link--active');
        if (activeLink) {
            const group = activeLink.closest('.rams-sidebar__nav-group');
            if (group) {
                group.classList.add('is-open');
            }
        }

        // Sidebar group toggles: keyboard-accessible (native buttons).
        // Open/closed state PERSISTS across pages (the audit: someone
        // working in Reports → Compliance → Datasets must not reopen
        // groups on every navigation). The current route's group still
        // auto-opens below.
        const GROUP_STORE_KEY = 'rams.sidebar.groups';
        const readGroupState = function() {
            try { return JSON.parse(localStorage.getItem(GROUP_STORE_KEY)) || {}; }
            catch (e) { return {}; }
        };
        const writeGroupState = function(state) {
            try { localStorage.setItem(GROUP_STORE_KEY, JSON.stringify(state)); } catch (e) {}
        };
        const groupState = readGroupState();
        document.querySelectorAll('[data-sidebar-group-toggle]').forEach(function(toggle, index) {
            const group = toggle.parentElement;
            // Stable key per group: the visible label.
            const key = (toggle.textContent || '').trim() || ('group-' + index);
            if (Object.prototype.hasOwnProperty.call(groupState, key)) {
                group.classList.toggle('is-open', groupState[key] === true);
            }
            const sync = function() {
                toggle.setAttribute('aria-expanded', group.classList.contains('is-open') ? 'true' : 'false');
            };
            sync();
            toggle.addEventListener('click', function() {
                group.classList.toggle('is-open');
                groupState[key] = group.classList.contains('is-open');
                writeGroupState(groupState);
                sync();
            });
        });
        const body = document.body;
        const toggleButton = document.querySelector('.rams-mobile-header__toggle');
        const overlay = document.querySelector('.rams-sidebar__overlay');
        const navLinks = document.querySelectorAll('.rams-sidebar__nav-link');
        const sidebarPanel = document.getElementById('rams-sidebar');

        // Dialog-grade drawer (round-8 UI-4): focus moves into the panel,
        // is TRAPPED there while open, background becomes inert, and focus
        // returns to the toggle on close.
        let sidebarPreviousFocus = null;

        function sidebarFocusables() {
            if (!sidebarPanel) { return []; }
            return Array.prototype.filter.call(
                sidebarPanel.querySelectorAll('a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])'),
                function (el) { return el.offsetParent !== null || el === document.activeElement; }
            );
        }

        function sidebarTrapKeydown(event) {
            if (event.key === 'Escape') { closeSidebar(); return; }
            if (event.key !== 'Tab') { return; }
            const focusables = sidebarFocusables();
            if (focusables.length === 0) { return; }
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        }

        function closeSidebar() {
            const wasOpen = body.classList.contains('is-sidebar-open');
            body.classList.remove('is-sidebar-open');
            if (toggleButton) {
                toggleButton.setAttribute('aria-expanded', 'false');
            }
            if (wasOpen) {
                document.removeEventListener('keydown', sidebarTrapKeydown, true);
                [document.getElementById('main-content'), document.querySelector('.rams-mobile-header')]
                    .forEach(function (el) { if (el) { el.removeAttribute('inert'); } });
                if (sidebarPreviousFocus && typeof sidebarPreviousFocus.focus === 'function') {
                    sidebarPreviousFocus.focus();
                }
                sidebarPreviousFocus = null;
            }
        }

        function toggleSidebar() {
            const isOpen = body.classList.toggle('is-sidebar-open');
            if (toggleButton) {
                toggleButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }
            if (isOpen) {
                sidebarPreviousFocus = document.activeElement;
                document.addEventListener('keydown', sidebarTrapKeydown, true);
                [document.getElementById('main-content'), document.querySelector('.rams-mobile-header')]
                    .forEach(function (el) { if (el) { el.setAttribute('inert', ''); } });
                const focusables = sidebarFocusables();
                if (focusables.length > 0) { focusables[0].focus(); }
            } else {
                closeSidebar();
            }
        }

        if (toggleButton) {
            toggleButton.addEventListener('click', toggleSidebar);
        }

        if (overlay) {
            overlay.addEventListener('click', closeSidebar);
        }

        navLinks.forEach(function(link) {
            link.addEventListener('click', closeSidebar);
        });

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeSidebar();
            }
        });
    });
    </script>

