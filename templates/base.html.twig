<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale starts with 'ar' ? 'rtl' : 'ltr' }}" data-theme="{{ app.user ? (app.user.preferredTheme ?? 'system') : 'system' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}{{ 'messages.meta_description'|trans }}{% endblock %}">
    <title>{% block title %}{{ 'app.name'|trans }}{% endblock %} - {{ 'app.company'|trans }}</title>
    
    {# Sensei-Rams Design System CSS #}
    <link rel="stylesheet" href="{{ asset('css/sensei-rams.css') }}">
    
    {# DataTables - Lightweight client-side table sorting/searching/pagination #}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.tailwindcss.css">
    
    {# Font preloading for performance - preconnect early, load fonts async #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# Use media="print" + onload trick for non-render-blocking font loading #}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
    
    <style>
        .rams-sidebar__nav-group { margin-bottom: 2px; }
        .rams-sidebar__group-header {
            display: flex;
            align-items: center;
            padding: 8px 16px;
            color: var(--rams-muted);
            cursor: pointer;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
            user-select: none;
            transition: color 0.15s ease;
        }
        .rams-sidebar__group-header:hover { color: var(--rams-foreground); }
        .rams-sidebar__group-chevron {
            width: 12px;
            height: 12px;
            margin-right: 8px;
            transition: transform 0.2s ease;
            opacity: 0.7;
        }
        .rams-sidebar__nav-group.is-open .rams-sidebar__group-chevron { transform: rotate(90deg); }
        .rams-sidebar__nav-list--nested {
            display: none;
            padding-left: 0;
            margin: 0;
            list-style: none;
            background: rgba(0,0,0,0.06);
        }
        .rams-sidebar__nav-group.is-open .rams-sidebar__nav-list--nested { display: block; }
        .rams-sidebar__nav-list--nested .rams-sidebar__nav-link {
            padding-left: 32px;
            font-size: 0.85rem;
            color: var(--rams-muted);
        }
        .rams-sidebar__nav-list--nested .rams-sidebar__nav-link:hover {
            color: var(--rams-foreground);
        }
        /* Dark mode overrides for nav groups */
        .dark .rams-sidebar__group-header,
        [data-theme="dark"] .rams-sidebar__group-header { color: var(--rams-muted); }
        .dark .rams-sidebar__group-header:hover,
        [data-theme="dark"] .rams-sidebar__group-header:hover { color: var(--rams-foreground); }
        .dark .rams-sidebar__nav-list--nested,
        [data-theme="dark"] .rams-sidebar__nav-list--nested { background: rgba(0,0,0,0.15); }
        .dark .rams-sidebar__nav-list--nested .rams-sidebar__nav-link,
        [data-theme="dark"] .rams-sidebar__nav-list--nested .rams-sidebar__nav-link { color: var(--rams-muted); }
        .dark .rams-sidebar__nav-list--nested .rams-sidebar__nav-link:hover,
        [data-theme="dark"] .rams-sidebar__nav-list--nested .rams-sidebar__nav-link:hover { color: var(--rams-foreground); }

        /* Fix top-level sidebar nav-link contrast in light mode */
        .rams-sidebar__nav-link { color: var(--rams-muted); }
        .rams-sidebar__nav-link:hover { color: var(--rams-foreground); }
        .dark .rams-sidebar__nav-link,
        [data-theme="dark"] .rams-sidebar__nav-link { color: var(--rams-muted); }
        .dark .rams-sidebar__nav-link:hover,
        [data-theme="dark"] .rams-sidebar__nav-link:hover { color: var(--rams-foreground); }

        /* Utility for Page Layout */
        .rams-page {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: var(--space-6, 24px);
        }
        /* Quick-add "+" links in sidebar */
        .rams-sidebar__nav-item--with-add {
            display: flex;
            align-items: center;
        }
        .rams-sidebar__nav-item--with-add .rams-sidebar__nav-link {
            flex: 1;
            min-width: 0;
        }
        .sidebar-quick-add {
            opacity: 0;
            transition: opacity 0.15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 2px;
            border-radius: 4px;
            color: var(--rams-muted);
            text-decoration: none;
            margin-left: 2px;
        }
        .rams-sidebar__nav-item--with-add:hover .sidebar-quick-add,
        .sidebar-quick-add:focus {
            opacity: 1;
            color: var(--rams-accent);
        }
        .sidebar-quick-add:hover {
            background: var(--rams-panel);
        }
        .sidebar-quick-add svg {
            width: 14px;
            height: 14px;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
