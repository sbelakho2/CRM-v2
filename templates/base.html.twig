<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ block('meta_description')|default('messages.meta_description'|trans) }}">
    <title>{% block title %}{{ 'app.name'|trans }}{% endblock %} - {{ 'app.company'|trans }}</title>
    
    {# Sensei-Rams Design System CSS #}
    <link rel="stylesheet" href="{{ asset('css/sensei-rams.css') }}">
    
    {# Font preloading for performance #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Skip Link for Accessibility #}
    <a href="#main-content" class="rams-skip-link">{{ 'accessibility.skip_to_content'|trans }}</a>
    
    {% set isAuthPage = app.request.get('_route') in ['app_login', 'app_register', 'app_forgot_password', 'app_reset_password'] %}
    
    {% if not isAuthPage %}
        {# Industrial Bezel Frame (Desktop only) #}
        <div class="rams-bezel" aria-hidden="true"></div>
        
        {# Corner Screws #}
        <div class="rams-screw rams-screw--tl" aria-hidden="true">
            <svg viewBox="0 0 12 12"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1"/><path d="M3 6L9 6M6 3L6 9" stroke="currentColor" stroke-width="1"/></svg>
        </div>
        <div class="rams-screw rams-screw--tr" aria-hidden="true">
            <svg viewBox="0 0 12 12"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1"/><path d="M3 6L9 6M6 3L6 9" stroke="currentColor" stroke-width="1"/></svg>
        </div>
        <div class="rams-screw rams-screw--bl" aria-hidden="true">
            <svg viewBox="0 0 12 12"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1"/><path d="M3 6L9 6M6 3L6 9" stroke="currentColor" stroke-width="1"/></svg>
        </div>
        <div class="rams-screw rams-screw--br" aria-hidden="true">
            <svg viewBox="0 0 12 12"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1"/><path d="M3 6L9 6M6 3L6 9" stroke="currentColor" stroke-width="1"/></svg>
        </div>
        
        {# Rack Sidebar #}
        <aside class="rams-sidebar" role="navigation" aria-label="{{ 'accessibility.navigation'|trans }}">
            {# Station Identifier #}
            <div class="rams-sidebar__header">
                <div class="rams-sidebar__logo">▣</div>
                <div>
                    <div class="rams-sidebar__title">{{ 'app.name'|trans }}</div>
                    <div class="rams-sidebar__subtitle">{{ 'app.subtitle'|trans }}</div>
                </div>
            </div>
            
            {# Module Rack Navigation #}
            <nav class="rams-sidebar__nav">
                <ul class="rams-sidebar__nav-list">
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_dashboard') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') == 'app_dashboard' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/>
                            </svg>
                            <span>{{ 'nav.dashboard'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('command_center_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'command_center' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="2" y="2" width="12" height="12" rx="1"/><path d="M2 6H14M6 6V14"/>
                            </svg>
                            <span>{{ 'nav.command_center'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_guidance_all') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') == 'app_guidance_all' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="8" cy="8" r="6"/><path d="M8 5V8L10 10"/>
                            </svg>
                            <span>{{ 'nav.guidance'|trans }}</span>
                            {% set notifCount = app.session.get('guidance_notifications')|default([])|length %}
                            {% if notifCount > 0 %}
                                <span class="rams-sidebar__nav-badge">{{ notifCount }}</span>
                            {% endif %}
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_company_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_company' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M2 13V5L8 2L14 5V13"/><rect x="5" y="8" width="2" height="5"/><rect x="9" y="8" width="2" height="5"/>
                            </svg>
                            <span>{{ 'nav.companies'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_contact_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_contact' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="8" cy="5" r="3"/><path d="M2 13C2 10 5 9 8 9C11 9 14 10 14 13"/>
                            </svg>
                            <span>{{ 'nav.contacts'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_rfq_pipeline') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_rfq' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="3" width="10" height="10" rx="1"/><path d="M6 7H10M6 10H8"/>
                            </svg>
                            <span>{{ 'nav.rfq_pipeline'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_webinar_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_webinar' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="2" y="4" width="12" height="8" rx="1"/><path d="M5 7L8 9L11 7"/>
                            </svg>
                            <span>{{ 'nav.webinars'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_activity_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_activity' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="8" cy="8" r="6"/><path d="M8 4V8L11 11"/>
                            </svg>
                            <span>{{ 'nav.activities'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_compliance_overview') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_compliance' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M8 2L3 4V7C3 10 5 12 8 14C11 12 13 10 13 7V4L8 2Z"/><path d="M6 8L7 9L10 6"/>
                            </svg>
                            <span>{{ 'nav.compliance'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_lead_review') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_lead' and app.request.get('_route') != 'lead_discovery_index' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M8 2L3 7L8 12L13 7L8 2Z"/><circle cx="8" cy="7" r="2"/>
                            </svg>
                            <span>{{ 'nav.leads'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('lead_discovery_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'lead_discovery' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="7" cy="7" r="5"/><path d="M14 14L11 11"/><path d="M7 5V9M5 7H9"/>
                            </svg>
                            <span>{{ 'nav.lead_discovery'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_webcrawler_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_webcrawler' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="8" cy="8" r="6"/><path d="M2 8H14M8 2C6 4 5 6 5 8C5 10 6 12 8 14M8 2C10 4 11 6 11 8C11 10 10 12 8 14"/>
                            </svg>
                            <span>{{ 'nav.webcrawler'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_email_campaign_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_email_campaign' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="2" y="4" width="12" height="8" rx="1"/><path d="M2 4L8 9L14 4"/>
                            </svg>
                            <span>{{ 'nav.email_campaigns'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('app_playbook_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'app_playbook' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="2" width="10" height="12" rx="1"/><path d="M6 6H10M6 9H10"/>
                            </svg>
                            <span>{{ 'nav.abm_playbooks'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('abm_dashboard_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'abm_dashboard' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/>
                            </svg>
                            <span>{{ 'nav.abm_dashboard'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('supplier_portal_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'supplier_portal' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M3 7L8 2L13 7"/><path d="M4 8V13H7V10H9V13H12V8"/>
                            </svg>
                            <span>{{ 'nav.supplier_portal'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('quote_copilot_list') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'quote_copilot' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="8" cy="8" r="6"/><path d="M8 5V8L10 10"/>
                            </svg>
                            <span>{{ 'nav.quote_copilot'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('quote_estimator_list') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'quote_estimator' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="3" width="10" height="10" rx="1"/><path d="M6 6H10M6 8H10M6 10H8"/>
                            </svg>
                            <span>{{ 'nav.quote_estimator'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('quote_review_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'quote_review' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="3" width="10" height="10" rx="1"/><path d="M6 8L7 9L10 6"/>
                            </svg>
                            <span>{{ 'nav.quote_review'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('admin_user_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'admin_user' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="6" cy="5" r="2"/><circle cx="11" cy="5" r="2"/><path d="M2 13C2 11 4 10 6 10C8 10 10 11 10 13"/><path d="M8 13C8 11 9.5 10 11 10C12.5 10 14 11 14 13"/>
                            </svg>
                            <span>{{ 'nav.users'|trans }}</span>
                        </a>
                    </li>
                    
                    <li class="rams-sidebar__nav-item">
                        <a href="{{ path('admin_dataset_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'admin_dataset' %}rams-sidebar__nav-link--active{% endif %}">
                            <span class="rams-sidebar__nav-indicator"></span>
                            <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="3" width="10" height="10" rx="1"/><path d="M3 6H13M6 3V13"/>
                            </svg>
                            <span>{{ 'nav.datasets'|trans }}</span>
                        </a>
                    </li>
                </ul>
            </nav>
            
            {# Sidebar Footer #}
            <div class="rams-sidebar__footer">
                <div class="rams-sidebar__nav-list">
                    <a href="{{ path('profile_index') }}" class="rams-sidebar__nav-link {% if app.request.get('_route') starts with 'profile' %}rams-sidebar__nav-link--active{% endif %}">
                        <span class="rams-sidebar__nav-indicator"></span>
                        <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="8" cy="5" r="3"/><path d="M2 13C2 10 5 9 8 9C11 9 14 10 14 13"/>
                        </svg>
                        <span>{% if app.user %}{{ app.user.fullName|default('nav.profile'|trans) }}{% else %}{{ 'nav.profile'|trans }}{% endif %}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="rams-sidebar__nav-link">
                        <span class="rams-sidebar__nav-indicator"></span>
                        <svg class="rams-sidebar__nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M11 3h2a2 2 0 012 2v8a2 2 0 01-2 2h-2M7 11l-4-4 4-4M3 7h10"/>
                        </svg>
                        <span>{{ 'nav.logout'|trans }}</span>
                    </a>
                </div>
                
                {# System Status #}
                <div class="rams-sidebar__status rams-mt-3">
                    <div class="rams-andon">
                        <span class="rams-andon__light rams-andon__light--green"></span>
                        <span class="rams-andon__text rams-andon__text--green">{{ 'status_bar.operational'|trans }}</span>
                    </div>
                </div>
            </div>
        </aside>
        
        {# Status Bar #}
        <footer class="rams-status-bar" role="contentinfo">
            <div class="rams-status-bar__section">
                <span class="rams-status-bar__item">{{ 'status_bar.station'|trans }}: SENSEI-ALPHA-01</span>
                <span class="rams-status-bar__item">{{ 'status_bar.os_version'|trans }}: {{ 'app.version'|trans }}</span>
            </div>
            <div class="rams-status-bar__section">
                <span class="rams-status-bar__item">
                    <span class="rams-status-bar__indicator"></span>
                    {{ 'status_bar.integrity'|trans }}: {{ 'status_bar.optimal'|trans }}
                </span>
                <span class="rams-status-bar__item" id="system-clock"></span>
            </div>
        </footer>
    {% endif %}
    
    {# Main Content Area #}
    <main id="main-content" class="{% if not isAuthPage %}rams-main{% else %}rams-main rams-main--full{% endif %}" role="main" aria-label="{{ 'accessibility.main_content'|trans }}">
        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="rams-alert rams-alert--{{ label == 'error' ? 'error' : (label == 'success' ? 'success' : (label == 'warning' ? 'warning' : 'info')) }} rams-mb-4" role="alert">
                    <svg class="rams-alert__icon" viewBox="0 0 20 20" fill="currentColor">
                        {% if label == 'success' %}
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        {% elseif label == 'error' %}
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        {% elseif label == 'warning' %}
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        {% else %}
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                        {% endif %}
                    </svg>
                    <div class="rams-alert__content">{{ message|trans }}</div>
                </div>
            {% endfor %}
        {% endfor %}
        
        {# Guidance Notifications #}
        {% if not isAuthPage %}
            {% include 'components/guidance_notifications.html.twig' ignore missing %}
        {% endif %}
        
        {% block body %}{% endblock %}
    </main>
    
    {% block javascripts %}
        {% block encore_script %}{% endblock %}
    {% endblock %}
    
    {# Modal Components #}
    {% if not isAuthPage %}
        {% include 'components/confirm_modal.html.twig' ignore missing %}
        {% include 'components/alert_modal.html.twig' ignore missing %}
    {% endif %}
    
    {# System Clock Script #}
    <script>
    (function() {
        function updateClock() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-US', { hour12: false });
            const clockEl = document.getElementById('system-clock');
            if (clockEl) {
                clockEl.textContent = timeStr;
            }
        }
        updateClock();
        setInterval(updateClock, 1000);
    })();
    </script>
</body>
</html>
