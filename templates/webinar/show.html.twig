{% extends 'base.html.twig' %}

{% block title %}{{ webinar.title }} - Webinar{% endblock %}

{% block body %}
<!-- Header -->
<div class="page-header">
        <div>
            <div class="flex items-center gap-4 text-sm mb-6" style="color: var(--claude-text-secondary);">
                <a href="{{ path('app_webinar_index') }}" class="hover:text-white">Webinars</a>
                <span>/</span>
                <span class="text-white">{{ webinar.title }}</span>
            </div>

            <div class="flex items-start justify-between">
                <div>
                    <h1 class="text-3xl font-light tracking-tight mb-2">{{ webinar.title }}</h1>
                    <div class="flex items-center gap-4 text-sm text-zinc-400">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            {{ webinar.scheduledDate|date('F d, Y - H:i') }}
                        </div>
                        <span class="px-2 py-0.5 text-xs rounded-full 
                            {{ webinar.language == 'EN' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' : 
                               webinar.language == 'FR' ? 'bg-purple-500/10 text-purple-400 border border-purple-500/20' : 
                               'bg-green-500/10 text-green-400 border border-green-500/20' }}">
                            {{ webinar.language }}
                        </span>
                    </div>
                </div>

                <div class="flex gap-2">
                    <a href="{{ path('app_webinar_edit', {id: webinar.id}) }}" 
                       class="px-4 py-2 border border-zinc-700 text-sm rounded-lg hover:bg-zinc-900 transition-colors">
                        Edit
                    </a>
                    <form method="post" action="{{ path('app_webinar_delete', {id: webinar.id}) }}" onsubmit="return confirm('Are you sure?');" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ webinar.id) }}">
                        <button type="submit" class="px-4 py-2 border border-red-900/50 text-red-400 text-sm rounded-lg hover:bg-red-950/30 transition-colors">
                            Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-3 gap-6 mb-8">
            <!-- Stats Cards -->
            <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                <div class="text-zinc-400 text-sm mb-2">Registered</div>
                <div class="text-3xl font-light">{{ stats.total_registered }}</div>
            </div>
            <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                <div class="text-zinc-400 text-sm mb-2">Attended</div>
                <div class="text-3xl font-light">{{ stats.attended }}</div>
            </div>
            <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                <div class="text-zinc-400 text-sm mb-2">Attendance Rate</div>
                <div class="text-3xl font-light">{{ stats.attendance_rate }}%</div>
            </div>
        </div>

        <!-- Description -->
        {% if webinar.description %}
            <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50 mb-6">
                <h2 class="text-lg font-medium mb-3">Description</h2>
                <p class="text-zinc-400 leading-relaxed">{{ webinar.description }}</p>
            </div>
        {% endif %}

        <!-- Links -->
        <div class="grid grid-cols-2 gap-6 mb-6">
            {% if webinar.meetingUrl %}
                <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                    <h3 class="text-sm font-medium mb-2">Meeting Link</h3>
                    <a href="{{ webinar.meetingUrl }}" target="_blank" class="text-blue-400 hover:underline text-sm break-all">
                        {{ webinar.meetingUrl }}
                    </a>
                </div>
            {% endif %}
            
            {% if webinar.recordingUrl %}
                <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                    <h3 class="text-sm font-medium mb-2">Recording</h3>
                    <a href="{{ webinar.recordingUrl }}" target="_blank" class="text-blue-400 hover:underline text-sm break-all">
                        {{ webinar.recordingUrl }}
                    </a>
                </div>
            {% endif %}
        </div>

        <!-- Attendees Section -->
        <div class="border border-zinc-800 rounded-lg bg-zinc-950/50">
            <div class="border-b border-zinc-800 p-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-medium">Attendees</h2>
                    <div class="flex gap-2">
                        <button type="button" 
                                class="px-3 py-1.5 text-sm border border-zinc-700 rounded-lg hover:bg-zinc-900 transition-colors flex items-center gap-2"
                                onclick="copyRegistrationLink(this)"
                                data-url="{{ absolute_url(path('app_webinar_register', {id: webinar.id})) }}">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                            </svg>
                            Copy Registration Link
                        </button>
                        <form method="post" action="{{ path('app_webinar_send_followup', {id: webinar.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('followup' ~ webinar.id) }}">
                            <button type="submit" class="px-3 py-1.5 text-sm bg-white text-black rounded-lg hover:bg-zinc-100 transition-colors">
                                Send Follow-ups
                            </button>
                        </form>
                    </div>
                </div>

                <script>
                function copyRegistrationLink(button) {
                    const url = button.getAttribute('data-url');
                    navigator.clipboard.writeText(url).then(() => {
                        const originalText = button.innerHTML;
                        button.innerHTML = `
                            <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Copied!
                        `;
                        button.classList.add('text-green-400');
                        setTimeout(() => {
                            button.innerHTML = originalText;
                            button.classList.remove('text-green-400');
                        }, 2000);
                    }).catch(err => {
                        console.error('Failed to copy text: ', err);
                    });
                }
                </script>
            </div>

            {% if attendees is empty %}
                <div class="p-12 text-center text-zinc-500">
                    No attendees registered yet
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="border-b border-zinc-800">
                            <tr class="text-left text-sm text-zinc-400">
                                <th class="px-6 py-3 font-medium">Name</th>
                                <th class="px-6 py-3 font-medium">Email</th>
                                <th class="px-6 py-3 font-medium">Company</th>
                                <th class="px-6 py-3 font-medium">Registered</th>
                                <th class="px-6 py-3 font-medium">Status</th>
                                <th class="px-6 py-3 font-medium">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-800">
                            {% for attendee in attendees %}
                                <tr class="text-sm hover:bg-zinc-900/30">
                                    <td class="px-6 py-4">{{ attendee.name }}</td>
                                    <td class="px-6 py-4 text-zinc-400">{{ attendee.email }}</td>
                                    <td class="px-6 py-4 text-zinc-400">
                                        {% if attendee.company %}
                                            {{ attendee.company.name }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 text-zinc-400">{{ attendee.registeredAt|date('M d, Y') }}</td>
                                    <td class="px-6 py-4">
                                        {% if attendee.attended %}
                                            <span class="px-2 py-1 text-xs rounded-full bg-green-500/10 text-green-400 border border-green-500/20">
                                                Attended
                                            </span>
                                        {% else %}
                                            <span class="px-2 py-1 text-xs rounded-full bg-zinc-700/50 text-zinc-400 border border-zinc-700">
                                                Registered
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4">
                                        {% if not attendee.attended %}
                                            <form method="post" action="{{ path('app_webinar_mark_attended', {id: webinar.id, attendeeId: attendee.id}) }}" class="inline">
                                                <button type="submit" class="text-xs text-blue-400 hover:underline">
                                                    Mark Attended
                                                </button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
