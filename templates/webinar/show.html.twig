{% extends 'base.html.twig' %}

{% block title %}{{ webinar.title }} - {{ 'webinar.title_singular'|trans }}{% endblock %}

{% block body %}
<div class="rams-module">
    <div class="rams-module__header">
        <div class="rams-breadcrumb">
            <a href="{{ path('app_webinar_index') }}" class="rams-breadcrumb__link">{{ 'webinar.title'|trans }}</a>
            <span class="rams-breadcrumb__separator">/</span>
            <span class="rams-breadcrumb__current">{{ webinar.title }}</span>
        </div>

        <div class="rams-module__header-content">
            <div class="rams-module__header-info">
                <h1 class="rams-module__title">{{ webinar.title }}</h1>
                <div class="rams-module__meta">
                    <span class="rams-dymo">
                        <svg class="rams-dymo__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        {{ webinar.scheduledDate|date('F d, Y - H:i') }}
                    </span>
                    <span class="rams-badge rams-badge--{{ webinar.language|lower }}">
                        {{ webinar.language }}
                    </span>
                </div>
            </div>

            <div class="rams-module__header-actions">
                <a href="{{ path('app_webinar_edit', {id: webinar.id}) }}" class="rams-btn">
                    {{ 'common.edit'|trans }}
                </a>
                <form method="post" action="{{ path('app_webinar_delete', {id: webinar.id}) }}" onsubmit="return ramsConfirmSubmit(event, '{{ 'messages.delete_confirm'|trans }}', {variant: 'danger'});" class="rams-inline-block">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ webinar.id) }}">
                    <button type="submit" class="rams-btn rams-btn--danger">
                        {{ 'common.delete'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="rams-module__content">
        <!-- Stats Cards -->
        <div class="rams-grid rams-grid--3">
            <div class="rams-metric">
                <span class="rams-metric__label">{{ 'webinar.registration.registered'|trans }}</span>
                <span class="rams-metric__value">{{ stats.total_registered }}</span>
            </div>
            <div class="rams-metric">
                <span class="rams-metric__label">{{ 'webinar.attended'|trans }}</span>
                <span class="rams-metric__value">{{ stats.attended }}</span>
            </div>
            <div class="rams-metric">
                <span class="rams-metric__label">{{ 'webinar.attendance_rate'|trans }}</span>
                <span class="rams-metric__value">{{ stats.attendance_rate }}%</span>
            </div>
        </div>

        <!-- Description -->
        {% if webinar.description %}
            <div class="rams-module rams-module--nested">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'common.description'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <p>{{ webinar.description }}</p>
                </div>
            </div>
        {% endif %}

        <!-- Links -->
        <div class="rams-grid rams-grid--2">
            {% if webinar.meetingUrl %}
                <div class="rams-module rams-module--nested">
                    <div class="rams-module__header">
                        <h3 class="rams-module__title">{{ 'webinar.link'|trans }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <a href="{{ webinar.meetingUrl }}" target="_blank" class="rams-link rams-link--external">
                            {{ webinar.meetingUrl }}
                        </a>
                    </div>
                </div>
            {% endif %}
            
            {% if webinar.recordingUrl %}
                <div class="rams-module rams-module--nested">
                    <div class="rams-module__header">
                        <h3 class="rams-module__title">{{ 'webinar.recording'|trans }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <a href="{{ webinar.recordingUrl }}" target="_blank" class="rams-link rams-link--external">
                            {{ webinar.recordingUrl }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- Attendees Section -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webinar.registration.attendees'|trans }}</h2>
                <div class="rams-module__header-actions">
                    <button type="button" 
                            class="rams-btn"
                            onclick="copyRegistrationLink(this)"
                            data-url="{{ absolute_url(path('app_webinar_register', {id: webinar.id})) }}">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                        </svg>
                        {{ 'webinar.copy_registration_link'|trans }}
                    </button>
                    <form method="post" action="{{ path('app_webinar_send_followup', {id: webinar.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('followup' ~ webinar.id) }}">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            {{ 'webinar.send_followups'|trans }}
                        </button>
                    </form>
                </div>
            </div>

            <div class="rams-module__content">
                {% if attendees is empty %}
                    <div class="rams-empty-state">
                        <p class="rams-empty-state__message">{{ 'webinar.no_attendees'|trans }}</p>
                    </div>
                {% else %}
                    <table class="rams-table">
                        <thead class="rams-table__header">
                            <tr>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.name'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.email'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'contact.company'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'webinar.registration.registered'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for attendee in attendees %}
                                <tr class="rams-table__row">
                                    <td class="rams-table__cell">{{ attendee.name }}</td>
                                    <td class="rams-table__cell rams-table__cell--muted">{{ attendee.email }}</td>
                                    <td class="rams-table__cell rams-table__cell--muted">
                                        {{ safe_company_name(attendee, 'common.n_a'|trans) }}
                                    </td>
                                    <td class="rams-table__cell rams-table__cell--muted">{{ attendee.registeredAt|date('M d, Y') }}</td>
                                    <td class="rams-table__cell">
                                        {% if attendee.attended %}
                                            <span class="rams-andon rams-andon--success">
                                                {{ 'webinar.attended'|trans }}
                                            </span>
                                        {% else %}
                                            <span class="rams-andon rams-andon--neutral">
                                                {{ 'webinar.registration.registered'|trans }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="rams-table__cell">
                                        {% if not attendee.attended %}
                                            <form method="post" action="{{ path('app_webinar_mark_attended', {id: webinar.id, attendeeId: attendee.id}) }}" class="rams-inline-block">
                                                <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm">
                                                    {{ 'webinar.mark_attended'|trans }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
function copyRegistrationLink(button) {
    const url = button.getAttribute('data-url');
    navigator.clipboard.writeText(url).then(() => {
        const originalText = button.innerHTML;
        button.innerHTML = `
            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            {{ 'common.copied'|trans }}
        `;
        button.classList.add('rams-btn--success');
        setTimeout(() => {
            button.innerHTML = originalText;
            button.classList.remove('rams-btn--success');
        }, 2000);
    }).catch(err => {
        console.error('Failed to copy text: ', err);
    });
}
</script>
{% endblock %}
