{% extends 'base.html.twig' %}

{% block title %}Create Webinar - CRM{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Breadcrumb -->
    <nav class="text-sm">
        <a href="{{ path('app_webinar_index') }}" class="text-neutral-600 hover:text-neutral-900">Webinars</a>
        <span class="text-neutral-400 mx-2">/</span>
        <span class="text-neutral-900">New Webinar</span>
    </nav>
    
    <!-- Header -->
    <div class="border-b border-neutral-200/80 pb-5">
        <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Create Webinar</h1>
        <p class="mt-1 text-sm text-neutral-600">Set up a new webinar event</p>
    </div>
    
    <div class="max-w-3xl">

        <div class="rounded-xl border border-neutral-200/60 bg-white p-8">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                
                <div>
                    <label class="block text-sm font-medium mb-2">{{ form_label(form.title) }}</label>
                    {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 bg-black border border-zinc-800 rounded-lg focus:outline-none focus:border-zinc-600 transition-colors'}}) }}
                    {{ form_errors(form.title) }}
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">{{ form_label(form.description) }}</label>
                    {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 bg-black border border-zinc-800 rounded-lg focus:outline-none focus:border-zinc-600 transition-colors'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">{{ form_label(form.scheduledDate) }}</label>
                        {{ form_widget(form.scheduledDate, {'attr': {'class': 'w-full px-4 py-2 bg-black border border-zinc-800 rounded-lg focus:outline-none focus:border-zinc-600 transition-colors'}}) }}
                        {{ form_errors(form.scheduledDate) }}
                    </div>

                    <div>
                        <label class="block text-sm font-medium mb-2">{{ form_label(form.language) }}</label>
                        {{ form_widget(form.language, {'attr': {'class': 'w-full px-4 py-2 bg-black border border-zinc-800 rounded-lg focus:outline-none focus:border-zinc-600 transition-colors'}}) }}
                        {{ form_errors(form.language) }}
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">{{ form_label(form.maxAttendees) }}</label>
                    {{ form_widget(form.maxAttendees, {'attr': {'class': 'w-full px-4 py-2 bg-black border border-zinc-800 rounded-lg focus:outline-none focus:border-zinc-600 transition-colors'}}) }}
                    {{ form_errors(form.maxAttendees) }}
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">{{ form_label(form.meetingUrl) }}</label>
                    {{ form_widget(form.meetingUrl, {'attr': {'class': 'w-full px-4 py-2 bg-black border border-zinc-800 rounded-lg focus:outline-none focus:border-zinc-600 transition-colors'}}) }}
                    {{ form_errors(form.meetingUrl) }}
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">{{ form_label(form.recordingUrl) }}</label>
                    {{ form_widget(form.recordingUrl, {'attr': {'class': 'w-full px-4 py-2 bg-black border border-zinc-800 rounded-lg focus:outline-none focus:border-zinc-600 transition-colors'}}) }}
                    {{ form_errors(form.recordingUrl) }}
                </div>

                <div class="flex items-center gap-3 pt-4">
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        Create Webinar
                    </button>
                    <a href="{{ path('app_webinar_index') }}" class="inline-flex items-center gap-2 px-5 py-2.5 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">
                        Cancel
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
