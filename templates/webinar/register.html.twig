{% extends 'base_login.html.twig' %}

{% block title %}{{ 'webinar.registration.register'|trans }} - {{ webinar.title }}{% endblock %}

{% block stylesheets %}
<style>
    .rams-public-container { max-width: 640px; margin: 0 auto; padding: var(--space-8) var(--space-4); }
    .rams-public-header { margin-bottom: var(--space-6); }
    .rams-public-header__title { margin: 0 0 var(--space-2); }
    .rams-public-header__meta { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .rams-public-description { padding: var(--space-3); background: var(--rams-panel); border-left: 3px solid var(--rams-orange); border-radius: var(--radius-sm); margin-bottom: var(--space-6); color: var(--rams-muted); font-size: var(--text-sm); }
</style>
{% endblock %}

{% block body %}
<div class="rams-public-container">
    <div class="rams-public-header">
        <h1 class="rams-public-header__title">{{ webinar.title }}</h1>
        <div class="rams-public-header__meta">
            <span class="rams-dymo">
                <svg class="rams-icon rams-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                {{ webinar.scheduledDate|date('F d, Y - H:i') }}
            </span>
            <span class="rams-badge rams-badge--{{ webinar.language|lower }}">
                {{ webinar.language }}
            </span>
        </div>
    </div>

    {% if webinar.description %}
        <div class="rams-public-description">
            <p>{{ webinar.description }}</p>
        </div>
    {% endif %}

    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'webinar.registration.title'|trans }}</h2>
        </div>

        <div class="rams-module__content">
            {% if registration_closed|default(false) %}
            <div class="rams-alert rams-alert--warning">
                <p>Registration for this webinar is closed (it may be full, completed, or cancelled).</p>
            </div>
            {% else %}
            <form method="post" class="rams-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('webinar_register_' ~ webinar.id) }}">
                <div class="rams-form__row rams-form__row--2">
                    <div class="rams-form__group">
                        <label for="first_name" class="rams-form__label">{{ 'auth.first_name'|trans }} *</label>
                        <input type="text" id="first_name" name="first_name" required class="rams-form__input">
                    </div>
                    <div class="rams-form__group">
                        <label for="last_name" class="rams-form__label">{{ 'auth.last_name'|trans }} *</label>
                        <input type="text" id="last_name" name="last_name" required class="rams-form__input">
                    </div>
                </div>

                <div class="rams-form__group">
                    <label for="email" class="rams-form__label">{{ 'common.email'|trans }} *</label>
                    <input type="email" id="email" name="email" required class="rams-form__input">
                </div>

                <div class="rams-form__group">
                    <label for="company" class="rams-form__label">{{ 'contact.company'|trans }}</label>
                    <input type="text" id="company" name="company" class="rams-form__input">
                </div>

                <div class="rams-form__actions rams-form__actions">
                    <button type="submit" class="rams-btn rams-btn--primary rams-btn--full">
                        {{ 'webinar.registration.register'|trans }}
                    </button>
                </div>

                <p class="rams-form__hint rams-form__hint rams-text--center">
                    {{ 'webinar.registration_notice'|trans|default("By registering, you'll receive a confirmation email with the meeting link.") }}
                </p>
            </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
