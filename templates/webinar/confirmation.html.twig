<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'webinar.registration.confirmation'|trans }} - {{ webinar.title }}</title>
    <link rel="stylesheet" href="{{ asset('css/rams.css') }}">
</head>
<body class="rams-page rams-page--public rams-page--centered">
    <div class="rams-public-container rams-public-container--narrow">
        <div class="rams-confirmation">
            <div class="rams-confirmation__icon rams-confirmation__icon--success">
                <svg class="rams-icon--2xl" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>

            <h1 class="rams-confirmation__title">{{ 'webinar.registration.confirmation'|trans }}!</h1>
            
            <p class="rams-confirmation__message">
                {{ 'webinar.registration_confirmed_message'|trans|default("You're all set for") }} <strong>{{ webinar.title }}</strong>.
            </p>

            <div class="rams-module rams-module--nested">
                <div class="rams-module__content">
                    <div class="rams-detail-row">
                        <svg class="rams-detail-row__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <div class="rams-detail-row__content">
                            <span class="rams-dymo">{{ 'webinar.date'|trans }} & {{ 'webinar.start_time'|trans }}</span>
                            <span class="rams-detail-row__value">{{ webinar.scheduledDate|date('F d, Y - H:i') }}</span>
                        </div>
                    </div>
                    
                    {% if webinar.meetingUrl %}
                        <div class="rams-detail-row rams-detail-row--separated">
                            <span class="rams-dymo">{{ 'webinar.link'|trans }}</span>
                            <a href="{{ webinar.meetingUrl }}" target="_blank" class="rams-link rams-link--external">
                                {{ webinar.meetingUrl }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="rams-confirmation__notes">
                <p class="rams-note">
                    📧 {{ 'webinar.check_email'|trans }}
                </p>
                <p class="rams-note">
                    {{ 'webinar.reminder_notice'|trans|default("We'll send you a reminder 24 hours before the webinar.") }}
                </p>
            </div>
        </div>
    </div>
</body>
</html>
