{% extends 'base.html.twig' %}

{% block title %}{{ 'webinar.edit_webinar'|trans }} - {{ webinar.title }}{% endblock %}

{% block body %}
<div class="rams-module">
    <div class="rams-module__header">
        <div class="rams-breadcrumb">
            <a href="{{ path('app_webinar_index') }}" class="rams-breadcrumb__link">{{ 'webinar.title'|trans }}</a>
            <span class="rams-breadcrumb__separator">/</span>
            <a href="{{ path('app_webinar_show', {id: webinar.id}) }}" class="rams-breadcrumb__link">{{ webinar.title }}</a>
            <span class="rams-breadcrumb__separator">/</span>
            <span class="rams-breadcrumb__current">{{ 'common.edit'|trans }}</span>
        </div>

        <div class="rams-module__header">
            <h1 class="rams-module__title">{{ 'webinar.edit_webinar'|trans }}</h1>
            <p class="rams-text--sm rams-text--muted">{{ 'webinar.edit_subtitle'|trans }}</p>
        </div>
    </div>

    <div class="rams-module__content">
        <div class="rams-form">
            {{ form_start(form, {'attr': {'class': 'rams-form'}}) }}
                
                <div class="rams-form__group">
                    <label class="rams-form__label">{{ form_label(form.title) }}</label>
                    {{ form_widget(form.title, {'attr': {'class': 'rams-form__input'}}) }}
                    {{ form_errors(form.title) }}
                </div>

                <div class="rams-form__group">
                    <label class="rams-form__label">{{ form_label(form.description) }}</label>
                    {{ form_widget(form.description, {'attr': {'class': 'rams-form__textarea'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="rams-form__row rams-form__row--2">
                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ form_label(form.scheduledDate) }}</label>
                        {{ form_widget(form.scheduledDate, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.scheduledDate) }}
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ form_label(form.language) }}</label>
                        {{ form_widget(form.language, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.language) }}
                    </div>
                </div>

                <div class="rams-form__group">
                    <label class="rams-form__label">{{ form_label(form.maxAttendees) }}</label>
                    {{ form_widget(form.maxAttendees, {'attr': {'class': 'rams-form__input'}}) }}
                    {{ form_errors(form.maxAttendees) }}
                </div>

                <div class="rams-form__group">
                    <label class="rams-form__label">{{ form_label(form.meetingUrl) }}</label>
                    {{ form_widget(form.meetingUrl, {'attr': {'class': 'rams-form__input'}}) }}
                    {{ form_errors(form.meetingUrl) }}
                </div>

                <div class="rams-form__group">
                    <label class="rams-form__label">{{ form_label(form.recordingUrl) }}</label>
                    {{ form_widget(form.recordingUrl, {'attr': {'class': 'rams-form__input'}}) }}
                    {{ form_errors(form.recordingUrl) }}
                </div>

                <div class="rams-form__actions">
                    <button type="submit" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        {{ 'common.save'|trans }}
                    </button>
                    <a href="{{ path('app_webinar_show', {id: webinar.id}) }}" class="rams-btn">
                        {{ 'common.cancel'|trans }}
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
