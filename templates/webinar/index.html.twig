{% extends 'base.html.twig' %}

{% block title %}Webinars - CRM{% endblock %}

{% block body %}
<div class="min-h-screen bg-black text-white">
    <!-- Header -->
    <div class="border-b border-zinc-800 bg-black/50 backdrop-blur-xl sticky top-0 z-10">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-light tracking-tight">Webinars</h1>
                    <p class="text-sm text-zinc-400 mt-1">Manage webinars and track attendance</p>
                </div>
                <a href="{{ path('app_webinar_new') }}" 
                   class="px-4 py-2 bg-white text-black text-sm font-medium rounded-lg hover:bg-zinc-100 transition-colors">
                    Create Webinar
                </a>
            </div>

            <!-- Filter Tabs -->
            <div class="flex gap-4 mt-6 border-b border-zinc-800">
                <a href="{{ path('app_webinar_index', {status: 'all'}) }}" 
                   class="px-4 py-2 text-sm {{ current_status == 'all' ? 'text-white border-b-2 border-white' : 'text-zinc-400 hover:text-white' }} transition-colors">
                    All Webinars
                </a>
                <a href="{{ path('app_webinar_index', {status: 'upcoming'}) }}" 
                   class="px-4 py-2 text-sm {{ current_status == 'upcoming' ? 'text-white border-b-2 border-white' : 'text-zinc-400 hover:text-white' }} transition-colors">
                    Upcoming
                </a>
                <a href="{{ path('app_webinar_index', {status: 'past'}) }}" 
                   class="px-4 py-2 text-sm {{ current_status == 'past' ? 'text-white border-b-2 border-white' : 'text-zinc-400 hover:text-white' }} transition-colors">
                    Past
                </a>
            </div>
        </div>
    </div>

    <!-- Webinars List -->
    <div class="max-w-7xl mx-auto px-6 py-8">
        {% if webinars is empty %}
            <div class="text-center py-16">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-zinc-900 mb-4">
                    <svg class="w-8 h-8 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <p class="text-zinc-400">No webinars found</p>
                <a href="{{ path('app_webinar_new') }}" class="text-sm text-white hover:underline mt-2 inline-block">Create your first webinar</a>
            </div>
        {% else %}
            <div class="grid gap-4">
                {% for webinar in webinars %}
                    <div class="border border-zinc-800 rounded-lg p-6 hover:border-zinc-700 transition-colors bg-zinc-950/50">
                        <div class="flex items-start justify-between">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <h3 class="text-lg font-medium">
                                        <a href="{{ path('app_webinar_show', {id: webinar.id}) }}" class="hover:text-zinc-300">
                                            {{ webinar.title }}
                                        </a>
                                    </h3>
                                    <span class="px-2 py-0.5 text-xs rounded-full 
                                        {{ webinar.language == 'EN' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' : 
                                           webinar.language == 'FR' ? 'bg-purple-500/10 text-purple-400 border border-purple-500/20' : 
                                           'bg-green-500/10 text-green-400 border border-green-500/20' }}">
                                        {{ webinar.language }}
                                    </span>
                                </div>
                                
                                {% if webinar.description %}
                                    <p class="text-sm text-zinc-400 mb-4">{{ webinar.description|slice(0, 150) }}{% if webinar.description|length > 150 %}...{% endif %}</p>
                                {% endif %}

                                <div class="flex items-center gap-6 text-xs text-zinc-500">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                        {{ webinar.scheduledDate|date('M d, Y - H:i') }}
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                        </svg>
                                        {{ webinar.registeredCount }} registered
                                        {% if webinar.attendedCount > 0 %}
                                            · {{ webinar.attendedCount }} attended
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="flex gap-2">
                                <a href="{{ path('app_webinar_edit', {id: webinar.id}) }}" 
                                   class="p-2 text-zinc-400 hover:text-white transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
