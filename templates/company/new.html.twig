{% extends 'base.html.twig' %}

{% block title %}{{ 'company.new_company'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-flex rams-flex-col rams-gap-6">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
        <span class="rams-breadcrumb__separator">/</span>
        <a href="{{ path('app_company_index') }}" class="rams-breadcrumb__item">{{ 'company.title'|trans }}</a>
        <span class="rams-breadcrumb__separator">/</span>
        <span class="rams-breadcrumb__item rams-breadcrumb__item--current" aria-current="page">{{ 'common.new'|trans }}</span>
    </nav>

    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'company.new_company'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'company.create_first'|trans }}</p>
        </div>
    </div>

    {# Form Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <span class="rams-module__title">{{ 'company.title_singular'|trans }} {{ 'common.details'|trans }}</span>
        </div>
        <div class="rams-module__content">
            {{ form_start(form, {'attr': {'class': 'rams-flex rams-flex-col rams-gap-4'}}) }}

                {# Company Name #}
                <div class="rams-form-group rams-mb-0">
                    <label for="{{ form.name.vars.id }}" class="rams-label">{{ 'company.company_name'|trans }} <span class="rams-text-danger">*</span></label>
                    {{ form_widget(form.name, {'attr': {'class': 'rams-input', 'placeholder': 'company.company_name'|trans}}) }}
                    {% if form.name.vars.errors|length > 0 %}
                        <span class="rams-error-text">{{ form_errors(form.name) }}</span>
                    {% endif %}
                </div>

                {# Sector and Tier Row #}
                <div class="rams-grid rams-grid--2" style="gap: var(--space-4);">
                    <div class="rams-form-group rams-mb-0">
                        <label for="{{ form.sector.vars.id }}" class="rams-label">{{ 'company.sector'|trans }}</label>
                        {{ form_widget(form.sector, {'attr': {'class': 'rams-select'}}) }}
                        {% if form.sector.vars.errors|length > 0 %}
                            <span class="rams-error-text">{{ form_errors(form.sector) }}</span>
                        {% endif %}
                    </div>
                    <div class="rams-form-group rams-mb-0">
                        <label for="{{ form.accountTier.vars.id }}" class="rams-label">{{ 'company.account_tier'|trans }}</label>
                        {{ form_widget(form.accountTier, {'attr': {'class': 'rams-select'}}) }}
                        {% if form.accountTier.vars.errors|length > 0 %}
                            <span class="rams-error-text">{{ form_errors(form.accountTier) }}</span>
                        {% endif %}
                    </div>
                </div>

                {# Pipeline Stage and Region Row #}
                <div class="rams-grid rams-grid--2" style="gap: var(--space-4);">
                    <div class="rams-form-group rams-mb-0">
                        <label for="{{ form.pipelineStage.vars.id }}" class="rams-label">{{ 'company.pipeline_stage'|trans }}</label>
                        {{ form_widget(form.pipelineStage, {'attr': {'class': 'rams-select'}}) }}
                        {% if form.pipelineStage.vars.errors|length > 0 %}
                            <span class="rams-error-text">{{ form_errors(form.pipelineStage) }}</span>
                        {% endif %}
                    </div>
                    <div class="rams-form-group rams-mb-0">
                        <label for="{{ form.region.vars.id }}" class="rams-label">{{ 'company.region'|trans }}</label>
                        {{ form_widget(form.region, {'attr': {'class': 'rams-select'}}) }}
                        {% if form.region.vars.errors|length > 0 %}
                            <span class="rams-error-text">{{ form_errors(form.region) }}</span>
                        {% endif %}
                    </div>
                </div>

                {# Divider #}
                <div class="rams-border-t rams-mt-2 rams-pt-4">
                    <span class="rams-module__title">{{ 'common.details'|trans }}</span>
                </div>

                {# Website #}
                <div class="rams-form-group rams-mb-0">
                    <label for="{{ form.website.vars.id }}" class="rams-label">{{ 'company.website'|trans }}</label>
                    <div class="rams-flex rams-items-center rams-gap-2">
                        <span class="rams-flex rams-items-center rams-justify-center" style="width: 40px; height: 40px; background: var(--rams-panel); border: 1px solid var(--rams-line); border-radius: var(--radius-sm);">
                            <svg style="width: 16px; height: 16px;" class="rams-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                            </svg>
                        </span>
                        {{ form_widget(form.website, {'attr': {'class': 'rams-input', 'placeholder': 'https://example.com', 'style': 'flex: 1;'}}) }}
                    </div>
                    {% if form.website.vars.errors|length > 0 %}
                        <span class="rams-error-text">{{ form_errors(form.website) }}</span>
                    {% endif %}
                </div>

                {# LinkedIn URL #}
                <div class="rams-form-group rams-mb-0">
                    <label for="{{ form.linkedInUrl.vars.id }}" class="rams-label">{{ 'company.linkedin'|trans }}</label>
                    <div class="rams-flex rams-items-center rams-gap-2">
                        <span class="rams-flex rams-items-center rams-justify-center" style="width: 40px; height: 40px; background: rgba(74, 144, 226, 0.1); border: 1px solid var(--rams-line); border-radius: var(--radius-sm);">
                            <svg style="width: 16px; height: 16px; color: var(--rams-steel);" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                            </svg>
                        </span>
                        {{ form_widget(form.linkedInUrl, {'attr': {'class': 'rams-input', 'placeholder': 'https://linkedin.com/company/...', 'style': 'flex: 1;'}}) }}
                    </div>
                    {% if form.linkedInUrl.vars.errors|length > 0 %}
                        <span class="rams-error-text">{{ form_errors(form.linkedInUrl) }}</span>
                    {% endif %}
                </div>

                {# Google Drive Link #}
                <div class="rams-form-group rams-mb-0">
                    <label for="{{ form.googleDriveLink.vars.id }}" class="rams-label">{{ 'company.google_drive_link'|trans }}</label>
                    <div class="rams-flex rams-items-center rams-gap-2">
                        <span class="rams-flex rams-items-center rams-justify-center" style="width: 40px; height: 40px; background: rgba(255, 190, 0, 0.1); border: 1px solid var(--rams-line); border-radius: var(--radius-sm);">
                            <svg style="width: 16px; height: 16px; color: var(--rams-orange);" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M7.71 3.5L1.15 15l3.18 5.5L11.88 9zm4.58 0l-6.56 11.5 3.18 5.5 6.56-11.5zM8.3 20.5l-3.18-5.5H21l-3.18 5.5z"/>
                            </svg>
                        </span>
                        {{ form_widget(form.googleDriveLink, {'attr': {'class': 'rams-input', 'placeholder': 'https://drive.google.com/...', 'style': 'flex: 1;'}}) }}
                    </div>
                    {% if form.googleDriveLink.vars.errors|length > 0 %}
                        <span class="rams-error-text">{{ form_errors(form.googleDriveLink) }}</span>
                    {% endif %}
                </div>

            {{ form_end(form, {'render_rest': false}) }}
        </div>
        <div class="rams-module__footer rams-flex rams-gap-2">
            <button type="submit" form="{{ form.vars.id }}" class="rams-btn rams-btn--primary">
                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {{ 'common.create'|trans }} {{ 'company.title_singular'|trans }}
            </button>
            <a href="{{ path('app_company_index') }}" class="rams-btn">
                {{ 'common.cancel'|trans }}
            </a>
        </div>
    </div>
</div>
{% endblock %}
