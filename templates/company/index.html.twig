{% extends 'base.html.twig' %}

{% block title %}{{ 'company.title'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-flex rams-flex-col rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'company.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'common.filter'|trans }} {{ 'company.title'|trans|lower }}</p>
        </div>
        <div class="rams-page-actions mobile-stack">
            <a href="{{ path('app_company_discovered') }}" class="rams-btn">
                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                {{ 'company.discovered.title'|trans }}
            </a>
            <a href="{{ path('app_company_new') }}" class="rams-btn rams-btn--primary">
                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                {{ 'company.new_company'|trans }}
            </a>
        </div>
    </div>

    {# Filters Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <span class="rams-module__title">{{ 'filters.title'|trans }}</span>
        </div>
        <div class="rams-module__content">
            <form method="get" action="{{ path('app_company_index') }}" class="rams-form">
                {# Search Bar #}
                <div class="rams-form__group">
                    <label for="search" class="rams-dymo">{{ 'common.search'|trans }}</label>
                    <input 
                        type="text" 
                        name="search" 
                        id="search" 
                        value="{{ current_search }}" 
                        placeholder="{{ 'table.search_placeholder'|trans }}" 
                        class="rams-form__input"
                    />
                </div>

                {# Filter Grid #}
                <div class="rams-form__row rams-form__row--4 rams-mb-4">
                    {# Sector Filter #}
                    <div class="rams-form__group rams-mb-0">
                        <label for="sector" class="rams-dymo">{{ 'company.sector'|trans }}</label>
                        <select name="sector" id="sector" class="rams-form__select">
                            <option value="">{{ 'company.discovered.filter_all_sectors'|trans }}</option>
                            {% for sector in sectors %}
                                <option value="{{ sector.value }}" {% if current_sector == sector.value %}selected{% endif %}>{{ sector.label }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Tier Filter #}
                    <div class="rams-form__group rams-mb-0">
                        <label for="tier" class="rams-dymo">{{ 'company.account_tier'|trans }}</label>
                        <select name="tier" id="tier" class="rams-form__select">
                            <option value="">{{ 'common.all'|trans }} {{ 'company.account_tier'|trans|lower }}s</option>
                            {% for tier in tiers %}
                                <option value="{{ tier }}" {% if current_tier == tier %}selected{% endif %}>{{ ('company.tiers.' ~ tier|lower)|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Stage Filter #}
                    <div class="rams-form__group rams-mb-0">
                        <label for="stage" class="rams-dymo">{{ 'company.pipeline_stage'|trans }}</label>
                        <select name="stage" id="stage" class="rams-form__select">
                            <option value="">{{ 'common.all'|trans }} {{ 'company.pipeline_stage'|trans|lower }}s</option>
                            {% for stage in stages %}
                                <option value="{{ stage }}" {% if current_stage == stage %}selected{% endif %}>{{ ('company.stages.' ~ stage|lower|replace({' ': '_'}))|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Region Filter #}
                    <div class="rams-form__group rams-mb-0">
                        <label for="region" class="rams-dymo">{{ 'company.region'|trans }}</label>
                        <select name="region" id="region" class="rams-form__select">
                            <option value="">{{ 'common.all'|trans }} {{ 'company.region'|trans|lower }}s</option>
                            {% for code, label in regions %}
                                <option value="{{ code }}" {% if current_region == code %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                {# Filter Actions #}
                <div class="rams-flex rams-gap-2 mobile-stack">
                    <button type="submit" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                        </svg>
                        {{ 'filters.apply'|trans }}
                    </button>
                    <a href="{{ path('app_company_index') }}" class="rams-btn">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                        {{ 'filters.clear'|trans }}
                    </a>
                </div>
            </form>
        </div>
    </div>

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rams-alert {% if label == 'success' %}rams-alert--success{% elseif label == 'error' %}rams-alert--error{% else %}rams-alert--info{% endif %}">
                <div class="rams-alert__content">{{ message }}</div>
            </div>
        {% endfor %}
    {% endfor %}

    {# Explanation Module #}
    <div class="rams-module">
        <div class="rams-module__header" style="cursor: pointer;" role="button" tabindex="0" aria-expanded="true" aria-controls="company-explanation-content" onclick="this.parentElement.querySelector('.rams-module__content').classList.toggle('rams-hidden');" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.parentElement.querySelector('.rams-module__content').classList.toggle('rams-hidden'); this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'); }">
            <h2 class="rams-module__title">
                <svg style="width:16px;height:16px;vertical-align:middle;margin-right:6px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                {{ 'company.explanation.title'|trans }}
            </h2>
        </div>
        <div class="rams-module__content" id="company-explanation-content">
            <p class="rams-text--sm rams-mb-3">{{ 'company.explanation.body'|trans }}</p>
            <p class="rams-text--sm rams-text--muted">{{ 'company.explanation.discovered_button'|trans|raw }}</p>
        </div>
    </div>

    {# Results Count #}
    <div class="rams-flex rams-justify-between rams-items-center mobile-stack">
        <span class="rams-text--muted">
            {{ 'pagination.showing'|trans }} <span class="rams-badge">{{ companies|length }}</span> {{ 'company.title'|trans|lower }}
        </span>
    </div>

    {# Companies Grid #}
    <div class="rams-grid rams-grid--3">
        {% for company in companies %}
            <a href="{{ path('app_company_show', {id: company.id}) }}" class="rams-module">
                <div class="rams-module__header">
                    <span class="rams-module__title rams-truncate rams-max-w-180">
                        {{ company.name }}
                    </span>
                    <div class="rams-flex rams-gap-1">
                        {% if company.companyStatus == 'approved' %}
                            <span class="rams-badge rams-badge--warning" title="{{ 'company.status_tooltip.approved_not_in_compliance'|trans }}">
                                {{ 'company.status.approved'|trans }}
                            </span>
                        {% elseif company.companyStatus == 'active' %}
                            <span class="rams-badge rams-badge--success" title="{{ 'company.status_tooltip.active_compliance_eligible'|trans }}">
                                {{ 'company.status.active'|trans }}
                            </span>
                        {% endif %}
                        {% if company.accountTier %}
                            <span class="rams-badge rams-badge--primary">{{ company.accountTier }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="rams-module__content">
                    {# Sector #}
                    <div class="rams-flex rams-items-center rams-gap-2 rams-mb-2">
                        <span class="rams-dymo">{{ sector_labels[company.sector]|default(company.sector ?: 'common.n_a'|trans) }}</span>
                    </div>

                    {# Pipeline Stage #}
                    {% if company.pipelineStage %}
                        <div class="rams-flex rams-items-center rams-gap-2 rams-mb-2">
                            <span class="rams-andon">
                                {% if company.pipelineStage == 'Award' or company.pipelineStage == 'Closed Won' %}
                                    <span class="rams-andon__light rams-andon__light--green"></span>
                                {% elseif company.pipelineStage == 'Proposal' or company.pipelineStage == 'Negotiation' %}
                                    <span class="rams-andon__light rams-andon__light--yellow"></span>
                                {% else %}
                                    <span class="rams-andon__light rams-andon__light--off"></span>
                                {% endif %}
                                <span class="rams-andon__text">{{ ('company.stages.' ~ company.pipelineStage|lower|replace({' ': '_'}))|trans }}</span>
                            </span>
                        </div>
                    {% endif %}

                    {# Region #}
                    {% if company.region %}
                        <div class="rams-flex rams-items-center rams-gap-2 rams-text--muted rams-text--xs">
                            <svg class="rams-icon--xs" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            {{ region_labels[company.region]|default(company.region) }}
                        </div>
                    {% endif %}

                    {# Quick Links Icons #}
                    <div class="rams-flex rams-gap-2 rams-mt-3 rams-items-center">
                        {% if company.contacts|length > 0 %}
                            <span class="rams-badge rams-badge--success" title="{{ company.contacts|length }} {{ 'contact.title'|trans|lower }}">
                                <svg class="rams-icon--3xs" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                    <circle cx="8" cy="5" r="3"/><path d="M2 13C2 10 5 9 8 9C11 9 14 10 14 13"/>
                                </svg>
                                {{ company.contacts|length }}
                            </span>
                        {% endif %}
                        {% if company.website %}
                            <span class="rams-badge" title="{{ 'company.website'|trans }}">
                                <svg class="rams-icon--3xs" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                                </svg>
                            </span>
                        {% endif %}
                        {% if company.linkedinCompanyUrl %}
                            <span class="rams-badge rams-link--linkedin" title="{{ 'contact.linkedin.label'|trans }}">
                                <svg class="rams-icon--3xs" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                            </span>
                        {% endif %}
                        {% if company.googleDriveLink %}
                            <span class="rams-badge rams-badge--warning" title="{{ 'company.google_drive_link'|trans }}">
                                <svg class="rams-icon--3xs" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M7.71 3.5L1.15 15l3.18 5.5L11.88 9zm4.58 0l-6.56 11.5 3.18 5.5 6.56-11.5zM8.3 20.5l-3.18-5.5H21l-3.18 5.5z"/>
                                </svg>
                            </span>
                        {% endif %}
                    </div>
                </div>
            </a>
        {% else %}
            <div class="rams-module rams-grid-span-3">
                <div class="rams-module__content rams-flex rams-flex-col rams-items-center rams-p-8">
                    <svg class="rams-icon--2xl rams-text--muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                    <h3 class="rams-mt-4 rams-text-base rams-font-semibold">{{ 'company.no_companies'|trans }}</h3>
                    <p class="rams-text--muted rams-mt-1 rams-text--sm">{{ 'company.create_first'|trans }}</p>
                    <div class="rams-mt-4">
                        <a href="{{ path('app_company_new') }}" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                            </svg>
                            {{ 'company.new_company'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
