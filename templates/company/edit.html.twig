{% extends 'base.html.twig' %}

{% block title %}{{ 'company.edit_company'|trans }} - {{ company.name }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="Breadcrumb">
        <ol class="rams-breadcrumb__list">
            <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item"><a href="{{ path('app_company_index') }}" class="rams-breadcrumb__link">{{ 'company.title'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item"><a href="{{ path('app_company_show', {id: company.id}) }}" class="rams-breadcrumb__link">{{ company.name }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'common.edit'|trans }}</li>
        </ol>
    </nav>

    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'company.edit_company'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'common.update'|trans }} {{ company.name }}</p>
        </div>
    </div>

    {# Form Module #}
    <div class="rams-module rams-module--narrow rams-mx-auto">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'company.title_singular'|trans }} {{ 'common.details'|trans }}</h2>
            <span class="rams-dymo">{{ 'common.id'|trans }}: {{ company.id }}</span>
        </div>
        <div class="rams-module__content">
            {{ form_start(form, {'attr': {'class': 'rams-form', 'id': 'company-form'}}) }}

                {# Company Name #}
                <div class="rams-form__group">
                    {{ form_label(form.name, 'company.company_name'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'rams-form__input', 'placeholder': 'company.company_name'|trans}}) }}
                    {{ form_errors(form.name) }}
                </div>

                {# Sector and Tier Row #}
                <div class="rams-grid rams-grid--2 rams-gap-4">
                    <div class="rams-form__group">
                        {{ form_label(form.sector, 'company.sector'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.sector, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.sector) }}
                    </div>
                    <div class="rams-form__group">
                        {{ form_label(form.accountTier, 'company.account_tier'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.accountTier, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.accountTier) }}
                    </div>
                </div>

                {# Pipeline Stage and Region Row #}
                <div class="rams-grid rams-grid--2 rams-gap-4">
                    <div class="rams-form__group">
                        {{ form_label(form.pipelineStage, 'company.pipeline_stage'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.pipelineStage, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.pipelineStage) }}
                    </div>
                    <div class="rams-form__group">
                        {{ form_label(form.region, 'company.region'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.region, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.region) }}
                    </div>
                </div>

                <div class="rams-divider rams-my-4"></div>

                {# Website #}
                <div class="rams-form__group">
                    {{ form_label(form.website, 'company.website'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                    <div class="rams-flex rams-items-center rams-gap-2">
                        <span class="rams-rams-text--xl">🌐</span>
                        {{ form_widget(form.website, {'attr': {'class': 'rams-form__input', 'placeholder': 'https://example.com'}}) }}
                    </div>
                    {{ form_errors(form.website) }}
                </div>

                {# Google Drive Link #}
                <div class="rams-form__group">
                    {{ form_label(form.googleDriveLink, 'company.google_drive_link'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                    <div class="rams-flex rams-items-center rams-gap-2">
                        <span class="rams-rams-text--xl">📁</span>
                        {{ form_widget(form.googleDriveLink, {'attr': {'class': 'rams-form__input', 'placeholder': 'https://drive.google.com/...'}}) }}
                    </div>
                    {{ form_errors(form.googleDriveLink) }}
                </div>

                <div class="rams-form__actions">
                    <button type="submit" class="rams-btn--primary">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        {{ 'common.update'|trans }} {{ 'company.title_singular'|trans }}
                    </button>
                    <a href="{{ path('app_company_show', {id: company.id}) }}" class="rams-btn--ghost">
                        {{ 'common.cancel'|trans }}
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

    {# Metadata Module #}
    <div class="rams-module rams-module--narrow rams-mx-auto">
        <div class="rams-module__content">
            <div class="rams-flex rams-justify-between rams-rams-text--muted rams-rams-text--xs font-mono">
                <span>{{ 'company.created_at'|trans }}: {{ company.createdAt|date('Y-m-d H:i') }}</span>
                <span>{{ 'company.updated_at'|trans }}: {{ company.updatedAt|date('Y-m-d H:i') }}</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
