{% extends 'base.html.twig' %}

{% block title %}{{ company.name }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-flex rams-flex-col rams-gap-6">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
        <span class="rams-breadcrumb__separator">/</span>
        <a href="{{ path('app_company_index') }}" class="rams-breadcrumb__item">{{ 'company.title'|trans }}</a>
        <span class="rams-breadcrumb__separator">/</span>
        <span class="rams-breadcrumb__item rams-breadcrumb__item--current" aria-current="page">{{ company.name }}</span>
    </nav>

    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ company.name }}</h1>
            <div class="rams-flex rams-gap-2 rams-mt-2">
                <span class="rams-dymo">{{ company.sector }}</span>
                {% if company.accountTier %}
                    <span class="rams-badge">{{ 'company.account_tier'|trans }} {{ company.accountTier }}</span>
                {% endif %}
                {% if company.pipelineStage %}
                    <span class="rams-badge {% if company.pipelineStage == 'Award' %}rams-badge--success{% elseif company.pipelineStage == 'Proposal' %}rams-badge--warning{% elseif company.pipelineStage == 'SQO' %}rams-badge--info{% endif %}">
                        {{ company.pipelineStage }}
                    </span>
                {% endif %}
            </div>
        </div>
        <div class="rams-page-actions">
            <a href="{{ path('app_company_edit', {id: company.id}) }}" class="rams-btn">
                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                {{ 'common.edit'|trans }}
            </a>
            <form method="post" action="{{ path('app_company_delete', {id: company.id}) }}" onsubmit="return confirm('{{ 'messages.delete_confirm'|trans }}');" style="display: inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ company.id) }}">
                <button type="submit" class="rams-btn rams-btn--danger">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    {{ 'common.delete'|trans }}
                </button>
            </form>
        </div>
    </div>

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rams-alert {% if label == 'success' %}rams-alert--success{% elseif label == 'error' %}rams-alert--error{% else %}rams-alert--info{% endif %}">
                <div class="rams-alert__content">{{ message }}</div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="rams-grid rams-grid--3">
        {# Main Content - 2 columns #}
        <div style="grid-column: span 2;" class="rams-flex rams-flex-col rams-gap-6">
            {# Company Information Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <span class="rams-module__title">{{ 'company.title_singular'|trans }} {{ 'common.details'|trans }}</span>
                </div>
                <div class="rams-module__content">
                    <div class="rams-grid rams-grid--2" style="gap: var(--space-4);">
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'company.sector'|trans }}</span>
                            <span style="font-size: var(--text-sm);">{{ company.sector }}</span>
                        </div>
                        {% if company.accountTier %}
                            <div class="rams-metric">
                                <span class="rams-metric__label">{{ 'company.account_tier'|trans }}</span>
                                <span style="font-size: var(--text-sm);">{{ 'company.tiers.standard'|trans }} {{ company.accountTier }}</span>
                            </div>
                        {% endif %}
                        {% if company.pipelineStage %}
                            <div class="rams-metric">
                                <span class="rams-metric__label">{{ 'company.pipeline_stage'|trans }}</span>
                                <span style="font-size: var(--text-sm);">{{ company.pipelineStage }}</span>
                            </div>
                        {% endif %}
                        {% if company.region %}
                            <div class="rams-metric">
                                <span class="rams-metric__label">{{ 'company.region'|trans }}</span>
                                <span style="font-size: var(--text-sm);">{{ company.region }}</span>
                            </div>
                        {% endif %}
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'company.created_at'|trans }}</span>
                            <span style="font-size: var(--text-sm);">{{ company.createdAt|date('M d, Y') }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'company.updated_at'|trans }}</span>
                            <span style="font-size: var(--text-sm);">{{ company.updatedAt|date('M d, Y') }}</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Contacts Section #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <span class="rams-module__title">{{ 'contact.title'|trans }}</span>
                    <a href="{{ path('app_contact_new', {company_id: company.id}) }}" class="rams-btn rams-btn--sm">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        {{ 'common.add'|trans }}
                    </a>
                </div>
                <div class="rams-module__content">
                    {% if company.contacts is empty %}
                        <div class="rams-flex rams-flex-col rams-items-center rams-p-6 rams-text-muted">
                            <svg style="width: 32px; height: 32px; opacity: 0.5;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                            <p class="rams-mt-2" style="font-size: var(--text-sm);">{{ 'contact.no_contacts'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="rams-flex rams-flex-col rams-gap-2">
                            {% for contact in company.contacts %}
                                <div class="rams-flex rams-items-center rams-gap-3 rams-p-3" style="border: 1px solid var(--rams-line); border-radius: var(--radius-sm);">
                                    <div class="rams-flex rams-items-center rams-justify-center" style="width: 40px; height: 40px; background: var(--rams-panel); border-radius: 50%; font-weight: 600; font-size: var(--text-sm);">
                                        {{ contact.firstName|slice(0, 1) }}{{ contact.lastName|slice(0, 1) }}
                                    </div>
                                    <div style="flex: 1; min-width: 0;">
                                        <p style="font-size: var(--text-sm); font-weight: 500;">{{ contact.firstName }} {{ contact.lastName }}</p>
                                        <p class="rams-text-muted" style="font-size: var(--text-xs);">{{ contact.jobTitle }}</p>
                                    </div>
                                    {% if contact.email %}
                                        <a href="mailto:{{ contact.email }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'common.email'|trans }}">
                                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                            </svg>
                                        </a>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Activities Section #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <span class="rams-module__title">{{ 'dashboard.recent_activity'|trans }}</span>
                    <a href="{{ path('app_activity_index') }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }} {{ 'common.all'|trans }}</a>
                </div>
                <div class="rams-module__content">
                    {% if company.activities is empty %}
                        <div class="rams-flex rams-flex-col rams-items-center rams-p-6 rams-text-muted">
                            <svg style="width: 32px; height: 32px; opacity: 0.5;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            <p class="rams-mt-2" style="font-size: var(--text-sm);">{{ 'activity.no_activities'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="rams-flex rams-flex-col rams-gap-2">
                            {% for activity in company.activities|slice(0, 5) %}
                                <div class="rams-flex rams-items-start rams-gap-3">
                                    <span class="rams-andon">
                                        {% if activity.type == 'Call' %}
                                            <span class="rams-andon__light rams-andon__light--green"></span>
                                        {% elseif activity.type == 'Email' %}
                                            <span class="rams-andon__light rams-andon__light--yellow"></span>
                                        {% elseif activity.type == 'Meeting' %}
                                            <span class="rams-andon__light rams-andon__light--green"></span>
                                        {% else %}
                                            <span class="rams-andon__light rams-andon__light--off"></span>
                                        {% endif %}
                                    </span>
                                    <div style="flex: 1; min-width: 0;">
                                        <p style="font-size: var(--text-sm);">{{ activity.type }}</p>
                                        {% if activity.notes %}
                                            <p class="rams-text-muted" style="font-size: var(--text-xs);">{{ activity.notes|slice(0, 60) }}...</p>
                                        {% endif %}
                                        <p class="rams-text-muted" style="font-size: var(--text-xs); margin-top: var(--space-1);">{{ activity.activityDate|date('M d, Y') }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Sidebar - 1 column #}
        <div class="rams-flex rams-flex-col rams-gap-6">
            {# Quick Links Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <span class="rams-module__title">{{ 'common.actions'|trans }}</span>
                </div>
                <div class="rams-module__content">
                    <div class="rams-flex rams-flex-col rams-gap-2">
                        {% if company.website %}
                            <a href="{{ company.website }}" target="_blank" class="rams-flex rams-items-center rams-gap-3 rams-p-3" style="border: 1px solid var(--rams-line); border-radius: var(--radius-sm); text-decoration: none;">
                                <div class="rams-flex rams-items-center rams-justify-center" style="width: 32px; height: 32px; background: var(--rams-panel); border-radius: var(--radius-sm);">
                                    <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                                    </svg>
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <p style="font-size: var(--text-sm); font-weight: 500;">{{ 'company.website'|trans }}</p>
                                    <p class="rams-text-muted" style="font-size: var(--text-xs); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ company.website }}</p>
                                </div>
                            </a>
                        {% endif %}

                        {% if company.linkedInUrl %}
                            <a href="{{ company.linkedInUrl }}" target="_blank" class="rams-flex rams-items-center rams-gap-3 rams-p-3" style="border: 1px solid var(--rams-line); border-radius: var(--radius-sm); text-decoration: none;">
                                <div class="rams-flex rams-items-center rams-justify-center" style="width: 32px; height: 32px; background: rgba(74, 144, 226, 0.1); border-radius: var(--radius-sm);">
                                    <svg style="width: 16px; height: 16px; color: var(--rams-steel);" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                    </svg>
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <p style="font-size: var(--text-sm); font-weight: 500;">{{ 'company.linkedin'|trans }}</p>
                                    <p class="rams-text-muted" style="font-size: var(--text-xs);">{{ 'common.view'|trans }} {{ 'profile.title'|trans|lower }}</p>
                                </div>
                            </a>
                        {% endif %}

                        {% if company.googleDriveLink %}
                            <a href="{{ company.googleDriveLink }}" target="_blank" class="rams-flex rams-items-center rams-gap-3 rams-p-3" style="border: 1px solid var(--rams-line); border-radius: var(--radius-sm); text-decoration: none;">
                                <div class="rams-flex rams-items-center rams-justify-center" style="width: 32px; height: 32px; background: rgba(255, 190, 0, 0.1); border-radius: var(--radius-sm);">
                                    <svg style="width: 16px; height: 16px; color: var(--rams-orange);" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M7.71 3.5L1.15 15l3.18 5.5L11.88 9zm4.58 0l-6.56 11.5 3.18 5.5 6.56-11.5zM8.3 20.5l-3.18-5.5H21l-3.18 5.5z"/>
                                    </svg>
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <p style="font-size: var(--text-sm); font-weight: 500;">{{ 'company.google_drive_link'|trans }}</p>
                                    <p class="rams-text-muted" style="font-size: var(--text-xs);">{{ 'common.view'|trans }} {{ 'compliance.documents'|trans|lower }}</p>
                                </div>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Stats Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <span class="rams-module__title">{{ 'dashboard.statistics'|trans }}</span>
                </div>
                <div class="rams-module__content">
                    <div class="rams-flex rams-flex-col rams-gap-3">
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-metric__label">{{ 'company.contacts_count'|trans }}</span>
                            <span class="rams-badge">{{ company.contacts|length }}</span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-metric__label">{{ 'company.activities_count'|trans }}</span>
                            <span class="rams-badge">{{ company.activities|length }}</span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-metric__label">{{ 'company.rfqs_count'|trans }}</span>
                            <span class="rams-badge">{{ company.rfqs|length }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
