{% extends 'base.html.twig' %}

{% block title %}{{ company.name }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="Breadcrumb">
        <ol class="rams-breadcrumb__list">
            <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item"><a href="{{ path('app_company_index') }}" class="rams-breadcrumb__link">{{ 'company.title'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ company.name }}</li>
        </ol>
    </nav>

    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ company.name }}</h1>
            <div class="rams-flex rams-flex-wrap rams-gap-2 rams-mt-2">
                <span class="rams-dymo">{{ company.sector }}</span>
                {% if company.accountTier %}
                    <span class="rams-badge rams-badge--primary">{{ 'company.account_tier'|trans }} {{ company.accountTier }}</span>
                {% endif %}
                {% if company.pipelineStage %}
                    <span class="rams-badge {% if company.pipelineStage == 'Award' %}rams-badge--success{% elseif company.pipelineStage == 'Proposal' %}rams-badge--warning{% elseif company.pipelineStage == 'SQO' %}rams-badge--info{% endif %}">
                        {{ company.pipelineStage }}
                    </span>
                {% endif %}
            </div>
        </div>
        <div class="rams-page-actions">
            <div class="rams-btn-group">
                <a href="{{ path('app_company_edit', {id: company.id}) }}" class="rams-btn">
                    <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 2L14 5L6 13H3V10L11 2Z"/>
                    </svg>
                    {{ 'common.edit'|trans }}
                </a>
                <form method="post" action="{{ path('app_company_delete', {id: company.id}) }}" onsubmit="return ramsConfirmSubmit(event, '{{ 'messages.delete_confirm'|trans }}', {variant: 'danger'});" class="rams-inline-block">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ company.id) }}">
                    <button type="submit" class="rams-btn--danger">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M2 4H14M5 4V2H11V4M6 7V11M10 7V11M3 4L4 14H12L13 4"/>
                        </svg>
                        {{ 'common.delete'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6">
        {# Main Content - 2 columns #}
        <div class="rams-grid-span-2 rams-stack rams-gap-6">
            {# Company Information Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'company.title_singular'|trans }} {{ 'common.details'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-definition-list rams-grid rams-grid--2">
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'company.sector'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ company.sector }}</dd>
                        </div>
                        {% if company.accountTier %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.account_tier'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ 'company.tiers.standard'|trans }} {{ company.accountTier }}</dd>
                            </div>
                        {% endif %}
                        {% if company.pipelineStage %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.pipeline_stage'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ company.pipelineStage }}</dd>
                            </div>
                        {% endif %}
                        {% if company.region %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.region'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ company.region }}</dd>
                            </div>
                        {% endif %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'company.created_at'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ company.createdAt|date('M d, Y') }}</dd>
                        </div>
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'company.updated_at'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ company.updatedAt|date('M d, Y') }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# Contacts Section #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'contact.title'|trans }}</h2>
                    <a href="{{ path('app_contact_new', {company_id: company.id}) }}" class="rams-btn--sm">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M8 3V13M3 8H13"/>
                        </svg>
                        {{ 'common.add'|trans }}
                    </a>
                </div>
                <div class="rams-module__content rams-module__content--flush">
                    {% if company.contacts is empty %}
                        <div class="rams-empty-state">
                            <p class="rams-text--muted rams-text--sm">{{ 'contact.no_contacts'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="rams-list">
                            {% for contact in company.contacts %}
                                <div class="rams-list-item rams-p-4 rams-border-b last:rams-border-b-0">
                                    <div class="rams-flex rams-items-center rams-gap-4 rams-flex-1">
                                        <div class="rams-badge rams-badge--lg rams-badge--circle">
                                            {{ contact.firstName|slice(0, 1) }}{{ contact.lastName|slice(0, 1) }}
                                        </div>
                                        <div class="rams-flex-1">
                                            <h3 class="rams-text--sm rams-text--bold">{{ contact.firstName }} {{ contact.lastName }}</h3>
                                            <p class="rams-text--muted rams-text--xs">{{ contact.jobTitle }}</p>
                                        </div>
                                        {% if contact.email %}
                                            <a href="mailto:{{ contact.email }}" class="rams-btn--ghost rams-btn--sm" title="{{ 'common.email'|trans }}">
                                                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M2 4L8 8L14 4V12H2V4Z"/>
                                                </svg>
                                            </a>
                                        {% endif %}
                                        <a href="{{ path('app_contact_show', {id: contact.id}) }}" class="rams-btn--ghost rams-btn--sm">
                                            {{ 'common.view'|trans }}
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Activities Section #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'dashboard.recent_activity'|trans }}</h2>
                    <a href="{{ path('app_activity_index', {company: company.id}) }}" class="rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }} {{ 'common.all'|trans }}</a>
                </div>
                <div class="rams-module__content">
                    {% if company.activities is empty %}
                        <div class="rams-empty-state">
                            <p class="rams-text--muted rams-text--sm">{{ 'activity.no_activities'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="rams-stack rams-gap-4">
                            {% for activity in company.activities|slice(0, 5) %}
                                <div class="rams-flex rams-items-start rams-gap-3">
                                    <div class="rams-andon rams-mt-1">
                                        {% if activity.type == 'Call' %}
                                            <span class="rams-andon__light rams-andon__light--green"></span>
                                        {% elseif activity.type == 'Email' %}
                                            <span class="rams-andon__light rams-andon__light--yellow"></span>
                                        {% elseif activity.type == 'Meeting' %}
                                            <span class="rams-andon__light rams-andon__light--green"></span>
                                        {% else %}
                                            <span class="rams-andon__light"></span>
                                        {% endif %}
                                    </div>
                                    <div class="rams-flex-1">
                                        <div class="rams-flex rams-justify-between rams-items-center rams-mb-1">
                                            <span class="rams-text--sm rams-text--bold uppercase rams-font-mono">{{ activity.type }}</span>
                                            <span class="rams-text--muted rams-text--xs rams-font-mono">{{ activity.activityDate|date('M d, Y') }}</span>
                                        </div>
                                        {% if activity.notes %}
                                            <p class="rams-text--muted rams-text--xs">{{ activity.notes|slice(0, 120) }}{% if activity.notes|length > 120 %}...{% endif %}</p>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Sidebar - 1 column #}
        <div class="rams-stack rams-gap-6">
            {# Quick Links Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'common.actions'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-2">
                        {% if company.website %}
                            <a href="{{ company.website }}" target="_blank" class="rams-module rams-module--inset rams-module--hoverable rams-p-3 rams-flex rams-items-center rams-gap-3" style="text-decoration:none">
                                <span class="rams-text--xl">🌐</span>
                                <div class="rams-flex-1 rams-overflow-hidden">
                                    <p class="rams-text--sm rams-text--bold rams-mb-0">{{ 'company.website'|trans }}</p>
                                    <p class="rams-text--muted rams-text--xs rams-truncate rams-mb-0">{{ company.website|replace({'https://': '', 'http://': ''}) }}</p>
                                </div>
                            </a>
                        {% endif %}

                        {% if company.googleDriveLink %}
                            <a href="{{ company.googleDriveLink }}" target="_blank" class="rams-module rams-module--inset rams-module--hoverable rams-p-3 rams-flex rams-items-center rams-gap-3" style="text-decoration:none">
                                <span class="rams-text--xl">📁</span>
                                <div class="rams-flex-1">
                                    <p class="rams-text--sm rams-text--bold rams-mb-0">{{ 'company.google_drive_link'|trans }}</p>
                                    <p class="rams-text--muted rams-text--xs rams-mb-0">{{ 'common.view'|trans }} {{ 'compliance.documents'|trans|lower }}</p>
                                </div>
                            </a>
                        {% endif %}
                        
                        <a href="{{ path('app_rfq_new', {company: company.id}) }}" class="rams-btn--primary rams-w-full rams-mt-2">
                            {{ 'rfq.actions.new'|trans }}
                        </a>
                    </div>
                </div>
            </div>

            {# Stats Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'dashboard.statistics'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-3">
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-rams-text--xs rams-rams-text--muted uppercase">{{ 'company.contacts_count'|trans }}</span>
                            <span class="rams-badge">{{ company.contacts|length }}</span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-rams-text--xs rams-rams-text--muted uppercase">{{ 'company.activities_count'|trans }}</span>
                            <span class="rams-badge">{{ company.activities|length }}</span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-rams-text--xs rams-rams-text--muted uppercase">{{ 'company.rfqs_count'|trans }}</span>
                            <span class="rams-badge">{{ company.rfqs|length }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
