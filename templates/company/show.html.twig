{% extends 'base.html.twig' %}

{% block title %}{{ company.name }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="{{ 'common.breadcrumb'|trans }}"> 
        <ol class="rams-breadcrumb__list">
            <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item"><a href="{{ path('app_company_index') }}" class="rams-breadcrumb__link">{{ 'company.title'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ company.name }}</li>
        </ol>
    </nav>

    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ company.name }}</h1>
            {% if company.legalName and company.legalName != company.name %}
                <p class="rams-text--muted rams-text--sm rams-mt-1">{{ 'company.legal_name'|trans }}: {{ company.legalName }}</p>
            {% endif %}
            <div class="rams-flex rams-flex-wrap rams-gap-2 rams-mt-2">
                <span class="rams-dymo">{{ sector_labels[company.sector]|default(company.sector) }}</span>
                {% if company.companyStatus == 'discovered' %}
                    <span class="rams-badge rams-badge--info">{{ 'company.status.discovered_pending_review'|trans }}</span>
                {% elseif company.companyStatus == 'approved' %}
                    <span class="rams-badge rams-badge--warning">{{ 'company.status.approved_not_in_compliance'|trans }}</span>
                {% elseif company.companyStatus == 'active' %}
                    <span class="rams-badge rams-badge--success">{{ 'company.status.active_compliance_eligible'|trans }}</span>
                {% endif %}
                {% if company.accountTier %}
                    <span class="rams-badge rams-badge--primary">{{ 'company.account_tier'|trans }} {{ ('company.tiers.' ~ company.accountTier|lower)|trans }}</span>
                {% endif %}
                {% if company.pipelineStage %}
                    <span class="rams-badge {% if company.pipelineStage == 'Award' or company.pipelineStage == 'Closed Won' %}rams-badge--success{% elseif company.pipelineStage == 'Proposal' or company.pipelineStage == 'Negotiation' %}rams-badge--warning{% elseif company.pipelineStage == 'SQO' %}rams-badge--info{% endif %}">
                        {{ ('company.stages.' ~ company.pipelineStage|lower|replace({' ': '_'}))|trans }}
                    </span>
                {% endif %}
            </div>
        </div>
        <div class="rams-page-actions mobile-stack">
            <div class="rams-btn-group mobile-stack">
                {% if company.companyStatus == 'discovered' %}
                    <form method="post" action="{{ path('app_company_approve', {id: company.id}) }}" class="rams-inline-block">
                        <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ company.id) }}">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            {{ 'company.actions.approve'|trans }}
                        </button>
                    </form>
                {% elseif company.companyStatus == 'approved' %}
                    <form method="post" action="{{ path('app_company_activate', {id: company.id}) }}" class="rams-inline-block">
                        <input type="hidden" name="_token" value="{{ csrf_token('activate' ~ company.id) }}">
                        <button type="submit" class="rams-btn rams-btn--primary" title="{{ 'company.actions.activate_for_compliance_tooltip'|trans }}">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                            </svg>
                            {{ 'company.actions.activate_for_compliance'|trans }}
                        </button>
                    </form>
                {% endif %}
                <a href="{{ path('app_company_edit', {id: company.id}) }}" class="rams-btn">
                    <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 2L14 5L6 13H3V10L11 2Z"/>
                    </svg>
                    {{ 'common.edit'|trans }}
                </a>
                <form method="post" action="{{ path('app_company_delete', {id: company.id}) }}" onsubmit="return ramsConfirmSubmit(event, '{{ 'messages.delete_confirm'|trans }}', {variant: 'danger'});" class="rams-inline-block">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ company.id) }}">
                    <button type="submit" class="rams-btn rams-btn--danger">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M2 4H14M5 4V2H11V4M6 7V11M10 7V11M3 4L4 14H12L13 4"/>
                        </svg>
                        {{ 'common.delete'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack">
        {# Main Content - 2 columns #}
        <div class="rams-grid-span-2 rams-stack rams-gap-6 mobile-w-full">
            {# Company Information Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'company.title_singular'|trans }} {{ 'common.details'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-definition-list rams-grid rams-grid--2">
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'company.sector'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ sector_labels[company.sector]|default(company.sector) }}</dd>
                        </div>
                        {% if company.accountTier %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.account_tier'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ ('company.tiers.' ~ company.accountTier|lower)|trans }}</dd>
                            </div>
                        {% endif %}
                        {% if company.pipelineStage %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.pipeline_stage'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ ('company.stages.' ~ company.pipelineStage|lower|replace({' ': '_'}))|trans }}</dd>
                            </div>
                        {% endif %}
                        {% if company.region %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.region'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ company.region }}</dd>
                            </div>
                        {% endif %}
                        {% if company.country %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.country'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ company.country }}</dd>
                            </div>
                        {% endif %}
                        {% if company.city %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.city'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ company.city }}</dd>
                            </div>
                        {% endif %}
                        {% if company.address %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.address'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ company.address }}</dd>
                            </div>
                        {% endif %}
                        {% if company.physicalSite %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.physical_site'|trans }}</dt>
                                <dd class="rams-definition-list__desc">{{ company.physicalSite }}</dd>
                            </div>
                        {% endif %}
                        {% if company.website %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'company.website'|trans }}</dt>
                                <dd class="rams-definition-list__desc">
                                    <a href="{{ company.website }}" target="_blank" rel="noopener" class="rams-link">
                                        <svg style="width:12px;height:12px;vertical-align:middle;margin-right:4px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                                        </svg>
                                        {{ company.website|replace({'https://': '', 'http://': '', 'www.': ''})|trim('/') }}
                                    </a>
                                </dd>
                            </div>
                        {% endif %}
                        {% if company.linkedinCompanyUrl %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'contact.linkedin.label'|trans }}</dt>
                                <dd class="rams-definition-list__desc">
                                    <a href="{{ company.linkedinCompanyUrl }}" target="_blank" rel="noopener" class="rams-link rams-link--linkedin">
                                        <svg style="width:14px;height:14px;vertical-align:middle;margin-right:4px;" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                        </svg>
                                        {{ 'company.view_company_page'|trans }}
                                    </a>
                                </dd>
                            </div>
                        {% endif %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'company.created_at'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ company.createdAt ? company.createdAt|date('M d, Y') : 'common.n_a'|trans  }}</dd>
                        </div>
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'company.updated_at'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ company.updatedAt ? company.updatedAt|date('M d, Y') : 'common.n_a'|trans  }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# Notes / Description Module #}
            {% if company.notes %}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'company.notes_description'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <p class="rams-text--sm rams-whitespace-pre-line">{{ company.notes }}</p>
                </div>
            </div>
            {% endif %}

            {% if company.sourceNotes %}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">📡 {{ 'company.discovery_source'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <p class="rams-text--sm rams-text--muted rams-whitespace-pre-line">{{ company.sourceNotes }}</p>
                </div>
            </div>
            {% endif %}

            {# Contacts Section #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'contact.title'|trans }}</h2>
                    <a href="{{ path('app_contact_new', {company_id: company.id}) }}" class="rams-btn rams-btn--sm">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M8 3V13M3 8H13"/>
                        </svg>
                        {{ 'common.add'|trans }}
                    </a>
                </div>
                <div class="rams-module__content rams-module__content--flush">
                    {% if company.contacts is empty %}
                        <div class="rams-empty-state">
                            <p class="rams-text--muted rams-text--sm">{{ 'contact.no_contacts'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="rams-list">
                            {% for contact in company.contacts %}
                                <div class="rams-list__item rams-p-4 rams-border-b">  
                                    <div class="rams-flex rams-items-center rams-gap-4 rams-flex-1">
                                        <div class="rams-badge rams-badge--small">  
                                            {{ contact.firstName|slice(0, 1) }}{{ contact.lastName|slice(0, 1) }}
                                        </div>
                                        <div class="rams-flex-1">
                                            <h3 class="rams-text--sm rams-text--bold">
                                                {{ contact.firstName }} {{ contact.lastName }}
                                                {% if contact.primaryContact %}
                                                    <span class="rams-badge rams-badge--success" style="font-size: 0.6rem; vertical-align: middle; margin-left: 4px;">★ {{ 'contact.decision_maker.short'|trans }}</span>
                                                {% endif %}
                                            </h3>
                                            <p class="rams-text--muted rams-text--xs">{{ contact.jobTitle }}</p>
                                        </div>
                                        {% if contact.linkedInUrl %}
                                            <a href="{{ contact.linkedInUrl }}" target="_blank" rel="noopener" class="rams-btn rams-btn--ghost rams-btn--sm rams-link--linkedin" title="{{ 'contact.linkedin.label'|trans }}" aria-label="{{ 'contact.linkedin.label'|trans }}">
                                                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                                </svg>
                                            </a>
                                        {% endif %}
                                        {% if contact.email %}
                                            <a href="mailto:{{ contact.email }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'common.email'|trans }}" aria-label="{{ 'common.email'|trans }}">
                                                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M2 4L8 8L14 4V12H2V4Z"/>
                                                </svg>
                                            </a>
                                        {% endif %}
                                        <a href="{{ path('app_contact_show', {id: contact.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                                            {{ 'common.view'|trans }}
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Activities Section #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'dashboard.recent_activity'|trans }}</h2>
                    <a href="{{ path('app_activity_index', {company: company.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }} {{ 'common.all'|trans }}</a>
                </div>
                <div class="rams-module__content">
                    {% if company.activities is empty %}
                        <div class="rams-empty-state">
                            <p class="rams-text--muted rams-text--sm">{{ 'activity.no_activities'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="rams-stack rams-gap-4">
                            {% for activity in company.activities|slice(0, 5) %}
                                <div class="rams-flex rams-items-start rams-gap-3">
                                    <div class="rams-andon rams-mt-1">
                                        {% if activity.type == 'Call' %}
                                            <span class="rams-andon__light rams-andon__light--green"></span>
                                        {% elseif activity.type == 'Email' %}
                                            <span class="rams-andon__light rams-andon__light--yellow"></span>
                                        {% elseif activity.type == 'Meeting' %}
                                            <span class="rams-andon__light rams-andon__light--green"></span>
                                        {% else %}
                                            <span class="rams-andon__light"></span>
                                        {% endif %}
                                    </div>
                                    <div class="rams-flex-1">
                                        <div class="rams-flex rams-justify-between rams-items-center rams-mb-1">
                                            <span class="rams-text--sm rams-text--bold rams-uppercase rams-font-mono">{{ activity.type }}</span>
                                            <span class="rams-text--muted rams-text--xs rams-font-mono">{{ activity.activityDate ? activity.activityDate|date('M d, Y') : 'common.n_a'|trans  }}</span>
                                        </div>
                                        {% if activity.notes %}
                                            <p class="rams-text--muted rams-text--xs">{{ activity.notes|slice(0, 120) }}{% if activity.notes|length > 120 %}...{% endif %}</p>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Sidebar - 1 column #}
        <div class="rams-stack rams-gap-6">
            {# Quick Links Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'common.actions'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-2">
                        {% if company.website %}
                            <a href="{{ company.website }}" target="_blank" class="rams-module rams-module--inset rams-module--hoverable rams-p-3 rams-flex rams-items-center rams-gap-3 rams-no-underline">
                                <span class="rams-text--xl">🌐</span>
                                <div class="rams-flex-1 rams-overflow-hidden">
                                    <p class="rams-text--sm rams-text--bold rams-mb-0">{{ 'company.website'|trans }}</p>
                                    <p class="rams-text--muted rams-text--xs rams-truncate rams-mb-0">{{ company.website|replace({'https://': '', 'http://': ''}) }}</p>
                                </div>
                            </a>
                        {% endif %}

                        {% if company.linkedinCompanyUrl %}
                            <a href="{{ company.linkedinCompanyUrl }}" target="_blank" class="rams-module rams-module--inset rams-module--hoverable rams-p-3 rams-flex rams-items-center rams-gap-3 rams-no-underline">
                                <span class="rams-text--xl">💼</span>
                                <div class="rams-flex-1 rams-overflow-hidden">
                                    <p class="rams-text--sm rams-text--bold rams-mb-0">{{ 'contact.linkedin.label'|trans }}</p>
                                    <p class="rams-text--muted rams-text--xs rams-truncate rams-mb-0">{{ company.linkedinCompanyUrl|replace({'https://www.linkedin.com/': '', 'https://linkedin.com/': ''}) }}</p>
                                </div>
                            </a>
                        {% endif %}

                        {% if company.googleDriveLink %}
                            <a href="{{ company.googleDriveLink }}" target="_blank" class="rams-module rams-module--inset rams-module--hoverable rams-p-3 rams-flex rams-items-center rams-gap-3 rams-no-underline">
                                <span class="rams-text--xl">📁</span>
                                <div class="rams-flex-1">
                                    <p class="rams-text--sm rams-text--bold rams-mb-0">{{ 'company.google_drive_link'|trans }}</p>
                                    <p class="rams-text--muted rams-text--xs rams-mb-0">{{ 'common.view'|trans }} {{ 'compliance.documents'|trans|lower }}</p>
                                </div>
                            </a>
                        {% endif %}
                        
                        <a href="{{ path('app_rfq_new', {company: company.id}) }}" class="rams-btn rams-btn--primary rams-w-full rams-mt-2">
                            {{ 'rfq.actions.new'|trans }}
                        </a>
                        <a href="{{ path('app_activity_new', {company: company.id, redirect: 'app_company_show', redirect_params: {id: company.id}|json_encode}) }}" class="rams-btn rams-btn--ghost rams-w-full">
                            {{ 'activity.log_activity'|trans }}
                        </a>
                    </div>
                </div>
            </div>

            {# Stats Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'dashboard.statistics'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-3">
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-text--xs rams-text--muted rams-uppercase">{{ 'company.contacts_count'|trans }}</span>
                            <span class="rams-badge">{{ company.contacts|length }}</span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-text--xs rams-text--muted rams-uppercase">{{ 'company.activities_count'|trans }}</span>
                            <span class="rams-badge">{{ company.activities|length }}</span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-text--xs rams-text--muted rams-uppercase">{{ 'company.rfqs_count'|trans }}</span>
                            <span class="rams-badge">{{ company.rfqs|length }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
