{% extends 'base.html.twig' %}

{% block title %}{{ company.name }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        {# Breadcrumb #}
        <nav class="mb-6">
            <ol class="flex items-center gap-2 text-sm">
                <li><a href="{{ path('app_dashboard') }}" class="text-neutral-600 hover:text-neutral-900">Dashboard</a></li>
                <li class="text-neutral-400">/</li>
                <li><a href="{{ path('app_company_index') }}" class="text-neutral-600 hover:text-neutral-900">Companies</a></li>
                <li class="text-neutral-400">/</li>
                <li class="text-neutral-900 font-medium">{{ company.name }}</li>
            </ol>
        </nav>

        {# Header #}
        <div class="flex items-start justify-between mb-6">
            <div class="flex-1">
                <h1 class="text-3xl font-semibold tracking-tight text-neutral-900">{{ company.name }}</h1>
                <div class="mt-2 flex items-center gap-3">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                        {{ company.sector }}
                    </span>
                    {% if company.accountTier %}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-neutral-100 text-neutral-700">
                            Tier {{ company.accountTier }}
                        </span>
                    {% endif %}
                    {% if company.pipelineStage %}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium 
                            {% if company.pipelineStage == 'Award' %}bg-emerald-50 text-emerald-700
                            {% elseif company.pipelineStage == 'Proposal' %}bg-purple-50 text-purple-700
                            {% elseif company.pipelineStage == 'SQO' %}bg-blue-50 text-blue-700
                            {% else %}bg-neutral-50 text-neutral-700{% endif %}">
                            {{ company.pipelineStage }}
                        </span>
                    {% endif %}
                </div>
            </div>
            
            <div class="flex items-center gap-3">
                <a href="{{ path('app_company_edit', {id: company.id}) }}" class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Edit
                </a>
                <form method="post" action="{{ path('app_company_delete', {id: company.id}) }}" onsubmit="return confirm('Are you sure you want to delete this company?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ company.id) }}">
                    <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 border border-red-200 text-red-700 text-sm font-medium rounded-lg hover:bg-red-50 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        Delete
                    </button>
                </form>
            </div>
        </div>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 px-4 py-3 rounded-lg {% if label == 'success' %}bg-emerald-50 text-emerald-800 border border-emerald-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            {# Main Content #}
            <div class="lg:col-span-2 space-y-6">
                
                {# Company Information Card #}
                <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
                    <h2 class="text-base font-semibold text-neutral-900 mb-4">Company Information</h2>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                        <div>
                            <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Sector</dt>
                            <dd class="mt-1 text-sm text-neutral-900">{{ company.sector }}</dd>
                        </div>
                        {% if company.accountTier %}
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Account Tier</dt>
                                <dd class="mt-1 text-sm text-neutral-900">Tier {{ company.accountTier }}</dd>
                            </div>
                        {% endif %}
                        {% if company.pipelineStage %}
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Pipeline Stage</dt>
                                <dd class="mt-1 text-sm text-neutral-900">{{ company.pipelineStage }}</dd>
                            </div>
                        {% endif %}
                        {% if company.region %}
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Region</dt>
                                <dd class="mt-1 text-sm text-neutral-900">{{ company.region }}</dd>
                            </div>
                        {% endif %}
                        <div>
                            <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Created</dt>
                            <dd class="mt-1 text-sm text-neutral-900">{{ company.createdAt|date('M d, Y') }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Last Updated</dt>
                            <dd class="mt-1 text-sm text-neutral-900">{{ company.updatedAt|date('M d, Y') }}</dd>
                        </div>
                    </dl>
                </div>

                {# Contacts Section #}
                <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-base font-semibold text-neutral-900">Contacts</h2>
                        <button class="text-sm text-blue-600 hover:text-blue-700 font-medium">+ Add Contact</button>
                    </div>
                    {% if company.contacts is empty %}
                        <div class="text-center py-8 text-sm text-neutral-500">
                            No contacts yet
                        </div>
                    {% else %}
                        <div class="space-y-3">
                            {% for contact in company.contacts %}
                                <div class="flex items-center gap-3 p-3 border border-neutral-200/60 rounded-lg hover:bg-neutral-50">
                                    <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-medium">
                                        {{ contact.firstName|slice(0, 1) }}{{ contact.lastName|slice(0, 1) }}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-neutral-900">{{ contact.firstName }} {{ contact.lastName }}</p>
                                        <p class="text-xs text-neutral-500">{{ contact.jobTitle }}</p>
                                    </div>
                                    {% if contact.email %}
                                        <a href="mailto:{{ contact.email }}" class="text-neutral-400 hover:text-neutral-600">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                            </svg>
                                        </a>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                {# Activities Section #}
                <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-base font-semibold text-neutral-900">Recent Activities</h2>
                        <button class="text-sm text-blue-600 hover:text-blue-700 font-medium">View All</button>
                    </div>
                    {% if company.activities is empty %}
                        <div class="text-center py-8 text-sm text-neutral-500">
                            No activities recorded
                        </div>
                    {% else %}
                        <div class="space-y-3">
                            {% for activity in company.activities|slice(0, 5) %}
                                <div class="flex items-start gap-3">
                                    <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0
                                        {% if activity.type == 'Call' %}bg-blue-50 text-blue-600
                                        {% elseif activity.type == 'Email' %}bg-purple-50 text-purple-600
                                        {% elseif activity.type == 'Meeting' %}bg-emerald-50 text-emerald-600
                                        {% else %}bg-neutral-50 text-neutral-600{% endif %}">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm text-neutral-900">{{ activity.type }}</p>
                                        {% if activity.notes %}
                                            <p class="text-xs text-neutral-500 mt-0.5">{{ activity.notes|slice(0, 60) }}...</p>
                                        {% endif %}
                                        <p class="text-xs text-neutral-400 mt-1">{{ activity.activityDate|date('M d, Y') }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

            </div>

            {# Sidebar #}
            <div class="space-y-6">
                
                {# Quick Links Card #}
                <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
                    <h2 class="text-base font-semibold text-neutral-900 mb-4">Quick Links</h2>
                    <div class="space-y-3">
                        {% if company.website %}
                            <a href="{{ company.website }}" target="_blank" class="flex items-center gap-3 p-3 border border-neutral-200/60 rounded-lg hover:bg-neutral-50 transition-colors">
                                <div class="w-8 h-8 rounded-lg bg-neutral-100 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                                    </svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-neutral-900">Website</p>
                                    <p class="text-xs text-neutral-500 truncate">{{ company.website }}</p>
                                </div>
                            </a>
                        {% endif %}

                        {% if company.linkedInUrl %}
                            <a href="{{ company.linkedInUrl }}" target="_blank" class="flex items-center gap-3 p-3 border border-neutral-200/60 rounded-lg hover:bg-neutral-50 transition-colors">
                                <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                    </svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-neutral-900">LinkedIn</p>
                                    <p class="text-xs text-neutral-500 truncate">View profile</p>
                                </div>
                            </a>
                        {% endif %}

                        {% if company.googleDriveLink %}
                            <a href="{{ company.googleDriveLink }}" target="_blank" class="flex items-center gap-3 p-3 border border-neutral-200/60 rounded-lg hover:bg-neutral-50 transition-colors">
                                <div class="w-8 h-8 rounded-lg bg-yellow-50 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-yellow-600" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M7.71 3.5L1.15 15l3.18 5.5L11.88 9zm4.58 0l-6.56 11.5 3.18 5.5 6.56-11.5zM8.3 20.5l-3.18-5.5H21l-3.18 5.5z"/>
                                    </svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-neutral-900">Google Drive</p>
                                    <p class="text-xs text-neutral-500 truncate">View files</p>
                                </div>
                            </a>
                        {% endif %}
                    </div>
                </div>

                {# Stats Card #}
                <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
                    <h2 class="text-base font-semibold text-neutral-900 mb-4">Statistics</h2>
                    <div class="space-y-4">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Contacts</span>
                                <span class="text-sm font-semibold text-neutral-900">{{ company.contacts|length }}</span>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Activities</span>
                                <span class="text-sm font-semibold text-neutral-900">{{ company.activities|length }}</span>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-medium text-neutral-500 uppercase tracking-wide">RFQs</span>
                                <span class="text-sm font-semibold text-neutral-900">{{ company.rfqs|length }}</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>
{% endblock %}
