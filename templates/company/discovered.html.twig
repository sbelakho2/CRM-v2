{% extends 'base.html.twig' %}

{% block title %}{{ 'company.discovered.title'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-flex rams-flex-col rams-gap-6">
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'company.discovered.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'company.discovered.subtitle'|trans }}</p>
        </div>
        <div class="rams-page-actions mobile-stack">
            <a href="{{ path('app_company_discovered_export', {format: 'xlsx', sector: current_sector, region: current_region, search: current_search}) }}" class="rams-btn">
                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                {{ 'company.discovered.download_excel'|trans }}
            </a>
            <form method="post" action="{{ path('app_company_approve_all') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('approve_all') }}">
                <button type="submit" class="rams-btn rams-btn--primary">{{ 'company.discovered.approve_all'|trans }}</button>
            </form>
        </div>
    </div>

    <div class="rams-module">
        <div class="rams-module__header">
            <span class="rams-module__title">{{ 'company.discovered.filters'|trans }}</span>
        </div>
        <div class="rams-module__content">
            <form method="get" action="{{ path('app_company_discovered') }}" class="rams-form">
                <div class="rams-form__row rams-form__row--3">
                    <div class="rams-form__group rams-mb-0">
                        <label class="rams-dymo">{{ 'company.discovered.filter_sector'|trans }}</label>
                        <select name="sector" class="rams-form__select">
                            <option value="">{{ 'company.discovered.filter_all_sectors'|trans }}</option>
                            {% for sector in sectors %}
                                <option value="{{ sector.value }}" {% if current_sector == sector.value %}selected{% endif %}>{{ sector.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="rams-form__group rams-mb-0">
                        <label class="rams-dymo">{{ 'company.discovered.filter_region'|trans }}</label>
                        <select name="region" class="rams-form__select">
                            <option value="">{{ 'company.discovered.filter_all_regions'|trans }}</option>
                            {% for region_code, region_label in regions %}
                                <option value="{{ region_code }}" {% if current_region == region_code %}selected{% endif %}>{{ region_label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="rams-form__group rams-mb-0">
                        <label class="rams-dymo">{{ 'company.discovered.filter_search'|trans }}</label>
                        <input type="text" name="search" value="{{ current_search }}" class="rams-form__input" placeholder="{{ 'company.discovered.filter_search_placeholder'|trans }}" />
                    </div>
                </div>
                <div class="rams-flex rams-gap-2 mobile-stack">
                    <button type="submit" class="rams-btn rams-btn--primary">{{ 'company.discovered.filter_apply'|trans }}</button>
                    <a href="{{ path('app_company_discovered') }}" class="rams-btn">{{ 'company.discovered.filter_clear'|trans }}</a>
                </div>
            </form>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rams-alert {% if label == 'success' %}rams-alert--success{% elseif label == 'error' %}rams-alert--error{% else %}rams-alert--info{% endif %}">
                <div class="rams-alert__content">{{ message }}</div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'company.discovered.pending_review'|trans }}</h2>
        </div>
        <div class="rams-module__content rams-module__content--flush">
            {% if companies|length > 0 %}
                <div class="rams-table-container">
                    <table class="rams-table">
                        <thead class="rams-table__header">
                            <tr>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.discovered.table_company'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.discovered.table_website'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.discovered.table_sector'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.discovered.table_region'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.discovered.table_contacts'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.discovered.table_discovered'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'company.discovered.table_actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody class="rams-table__body">
                            {% for company in companies %}
                                <tr class="rams-table__row">
                                    <td class="rams-table__cell rams-text--bold">
                                        <a href="{{ path('app_company_show', {id: company.id}) }}" class="rams-link">{{ company.name }}</a>
                                        <div class="rams-text--xs rams-text--muted">{{ 'company.discovered.status_discovered'|trans }}</div>
                                    </td>
                                    <td class="rams-table__cell">
                                        {% if company.website %}
                                            <a href="{{ company.website }}" target="_blank" class="rams-link rams-text--xs">
                                                {{ company.website|replace({'https://': '', 'http://': '', 'www.': ''}) }}
                                            </a>
                                        {% else %}
                                            <span class="rams-text--muted rams-text--xs">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="rams-table__cell rams-text--xs">{{ sector_labels[company.sector]|default(company.sector ?: 'common.n_a'|trans) }}</td>
                                    <td class="rams-table__cell rams-text--xs">{{ company.region ?: 'common.n_a'|trans }}</td>
                                    <td class="rams-table__cell rams-text--xs">
                                        {% if company.contacts|length > 0 %}
                                            <span class="rams-badge rams-badge--success">{{ company.contacts|length }}</span>
                                        {% else %}
                                            <span class="rams-text--muted">0</span>
                                        {% endif %}
                                    </td>
                                    <td class="rams-table__cell rams-text--xs rams-text--muted">{{ company.createdAt|date('M d, Y') }}</td>
                                    <td class="rams-table__cell rams-table__cell--actions">
                                        <form method="post" action="{{ path('app_company_approve', {id: company.id}) }}" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ company.id) }}">
                                            <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'company.actions.approve'|trans }}</button>
                                        </form>
                                        <form method="post" action="{{ path('app_company_delete', {id: company.id}) }}" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ company.id) }}">
                                            <input type="hidden" name="_redirect" value="discovered">
                                            <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.delete'|trans }}</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="rams-empty-state">
                    <h3 class="rams-empty-state__title">{{ 'company.discovered.empty_title'|trans }}</h3>
                    <p class="rams-empty-state__subtitle">{{ 'company.discovered.empty_subtitle'|trans }}</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
