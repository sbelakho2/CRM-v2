{% extends 'base.html.twig' %}

{% block title %}Discovered Companies - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-flex rams-flex-col rams-gap-6">
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">Discovered Companies</h1>
            <p class="rams-page-subtitle">Review and approve companies found by the webcrawler (not in compliance).</p>
        </div>
        <div class="rams-page-actions">
            <a href="{{ path('app_company_discovered_export', {format: 'xlsx', sector: current_sector, search: current_search}) }}" class="rams-btn">
                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Download Excel
            </a>
            <form method="post" action="{{ path('app_company_approve_all') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('approve_all') }}">
                <button type="submit" class="rams-btn rams-btn--primary">Approve All</button>
            </form>
        </div>
    </div>

    <div class="rams-module">
        <div class="rams-module__header">
            <span class="rams-module__title">Filters</span>
        </div>
        <div class="rams-module__content">
            <form method="get" action="{{ path('app_company_discovered') }}" class="rams-form">
                <div class="rams-form__row rams-form__row--3">
                    <div class="rams-form__group rams-mb-0">
                        <label class="rams-dymo">Sector</label>
                        <select name="sector" class="rams-form__select">
                            <option value="">All sectors</option>
                            {% for sector in sectors %}
                                <option value="{{ sector }}" {% if current_sector == sector %}selected{% endif %}>{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="rams-form__group rams-mb-0">
                        <label class="rams-dymo">Search</label>
                        <input type="text" name="search" value="{{ current_search }}" class="rams-form__input" placeholder="Search company name" />
                    </div>
                </div>
                <div class="rams-flex rams-gap-2">
                    <button type="submit" class="rams-btn rams-btn--primary">Apply</button>
                    <a href="{{ path('app_company_discovered') }}" class="rams-btn">Clear</a>
                </div>
            </form>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rams-alert {% if label == 'success' %}rams-alert--success{% elseif label == 'error' %}rams-alert--error{% else %}rams-alert--info{% endif %}">
                <div class="rams-alert__content">{{ message }}</div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">Pending Review</h2>
        </div>
        <div class="rams-module__content rams-module__content--flush">
            {% if companies|length > 0 %}
                <div class="rams-table-container">
                    <table class="rams-table">
                        <thead class="rams-table__header">
                            <tr>
                                <th class="rams-table__cell rams-table__cell--header">Company</th>
                                <th class="rams-table__cell rams-table__cell--header">Website</th>
                                <th class="rams-table__cell rams-table__cell--header">Sector</th>
                                <th class="rams-table__cell rams-table__cell--header">Region</th>
                                <th class="rams-table__cell rams-table__cell--header">Contacts</th>
                                <th class="rams-table__cell rams-table__cell--header">Discovered</th>
                                <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="rams-table__body">
                            {% for company in companies %}
                                <tr class="rams-table__row">
                                    <td class="rams-table__cell rams-text--bold">
                                        <a href="{{ path('app_company_show', {id: company.id}) }}" class="rams-link">{{ company.name }}</a>
                                        <div class="rams-text--xs rams-text--muted">Status: Discovered</div>
                                    </td>
                                    <td class="rams-table__cell">
                                        {% if company.website %}
                                            <a href="{{ company.website }}" target="_blank" class="rams-link rams-text--xs">
                                                {{ company.website|replace({'https://': '', 'http://': '', 'www.': ''}) }}
                                            </a>
                                        {% else %}
                                            <span class="rams-text--muted rams-text--xs">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="rams-table__cell rams-text--xs">{{ company.sector ?: 'N/A' }}</td>
                                    <td class="rams-table__cell rams-text--xs">{{ company.region ?: 'N/A' }}</td>
                                    <td class="rams-table__cell rams-text--xs">
                                        {% if company.contacts|length > 0 %}
                                            <span class="rams-badge rams-badge--success">{{ company.contacts|length }}</span>
                                        {% else %}
                                            <span class="rams-text--muted">0</span>
                                        {% endif %}
                                    </td>
                                    <td class="rams-table__cell rams-text--xs rams-text--muted">{{ company.createdAt|date('M d, Y') }}</td>
                                    <td class="rams-table__cell rams-table__cell--actions">
                                        <form method="post" action="{{ path('app_company_approve', {id: company.id}) }}" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ company.id) }}">
                                            <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm">Approve</button>
                                        </form>
                                        <form method="post" action="{{ path('app_company_delete', {id: company.id}) }}" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ company.id) }}">
                                            <input type="hidden" name="_redirect" value="discovered">
                                            <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="rams-empty-state">
                    <h3 class="rams-empty-state__title">No discovered companies</h3>
                    <p class="rams-empty-state__subtitle">Run the webcrawler to discover new companies.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
