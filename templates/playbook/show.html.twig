{% extends 'base.html.twig' %}

{% block title %}{{ playbook.name }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="Breadcrumb">
        <ol class="rams-breadcrumb__list">
            <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item"><a href="{{ path('app_playbook_index') }}" class="rams-breadcrumb__link">{{ 'playbook.title'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ playbook.name }}</li>
        </ol>
    </nav>

    {# Playbook Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ playbook.name }}</h1>
            <div class="rams-flex rams-gap-2 rams-mt-2">
                <span class="rams-badge {% if playbook.isActive %}rams-badge--success{% endif %}">
                    {{ (playbook.isActive ? 'playbook.active' : 'playbook.inactive')|trans }}
                </span>
                <span class="rams-badge rams-badge--info">{{ 'playbook.priority'|trans }}: {{ playbook.priority }}</span>
            </div>
        </div>
        <div class="rams-page-actions mobile-stack">
            <div class="rams-btn-group mobile-stack">
                <a href="{{ path('app_playbook_builder_triggers', {id: playbook.id}) }}" class="rams-btn rams-btn--ghost">
                    {{ 'playbook.trigger_rules'|trans|default('Triggers') }}
                </a>
                <a href="{{ path('app_playbook_builder_actions', {id: playbook.id}) }}" class="rams-btn rams-btn--ghost">
                    {{ 'playbook.actions'|trans|default('Actions') }}
                </a>
                <a href="{{ path('app_playbook_edit', {id: playbook.id}) }}" class="rams-btn">
                    <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 2L14 5L6 13H3V10L11 2Z"/>
                    </svg>
                    {{ 'common.edit'|trans }}
                </a>
                <form action="{{ path('app_playbook_delete', {id: playbook.id}) }}" method="post" class="rams-inline-block" onsubmit="return ramsConfirmSubmit(event, '{{ 'playbook.delete_confirm'|trans }}', {variant: 'danger'})">
                    <button type="submit" class="rams-btn rams-btn--danger">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M2 4H14M5 4V2H11V4M6 7V11M10 7V11M3 4L4 14H12L13 4"/>
                        </svg>
                        {{ 'common.delete'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    {# Description & Notes #}
    {% if playbook.description or playbook.notes %}
        <div class="rams-module">
            <div class="rams-module__content">
                {% if playbook.description %}
                    <p class="rams-text--sm rams-mb-4">{{ playbook.description }}</p>
                {% endif %}
                
                {% if playbook.notes %}
                    <div class="rams-alert rams-alert--info">
                        <div class="rams-alert__content">
                            <span class="rams-text--bold rams-uppercase rams-text--xs rams-font-mono rams-mr-2">{{ 'playbook.notes'|trans }}:</span>
                            <span class="rams-text--sm">{{ playbook.notes }}</span>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {# Statistics #}
    <div class="rams-grid rams-grid--4">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'playbook.total_runs'|trans }}</span>
                    <span class="rams-metric__value">{{ stats.total_runs }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'common.completed'|trans }}</span>
                    <span class="rams-metric__value rams-text--success">{{ stats.completed }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'common.failed'|trans }}</span>
                    <span class="rams-metric__value rams-text--danger">{{ stats.failed }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'playbook.success_rate'|trans }}</span>
                    <span class="rams-metric__value rams-text--info">
                        {% if stats.total_runs > 0 %}
                            {{ ((stats.completed / stats.total_runs) * 100)|number_format(0) }}%
                        {% else %}
                            {{ 'common.n_a'|trans }}
                        {% endif %}
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--2 rams-gap-6">
        {# Trigger Rules #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'playbook.trigger_rules'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                <div id="trigger-rules-display" data-rules="{{ playbook.triggerRules|e('html_attr') }}"></div>
                <script>
                (function() {
                    try {
                        const rules = JSON.parse(document.getElementById('trigger-rules-display').dataset.rules || '[]');
                        const container = document.getElementById('trigger-rules-display');
                        if (rules.length > 0) {
                            container.innerHTML = '<div class="rams-stack rams-gap-2">' + rules.map(rule => `
                                <div class="rams-flex rams-items-center rams-gap-3 rams-p-2 rams-bg-panel rams-border rams-rounded">
                                    <span class="rams-badge rams-font-mono">${rule.field || ''}</span>
                                    <span class="rams-text--muted rams-text--xs rams-font-mono rams-uppercase">${rule.operator || ''}</span>
                                    <span class="rams-badge rams-badge--info rams-font-mono">${rule.value || ''}</span>
                                </div>
                            `).join('') + '</div>';
                        } else {
                            container.innerHTML = '<div class="rams-empty-state rams-p-4"><p class="rams-text--muted rams-text--xs">{{ 'playbook.no_trigger_rules'|trans }}</p></div>';
                        }
                    } catch(e) { 
                        document.getElementById('trigger-rules-display').innerHTML = '<div class="rams-alert rams-alert--error">{{ 'common.error'|trans }}</div>';
                    }
                })();
                </script>
            </div>
        </div>

        {# Actions #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'playbook.actions'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                <div id="actions-display" data-actions="{{ playbook.actions|e('html_attr') }}"></div>
                <script>
                (function() {
                    try {
                        const actions = JSON.parse(document.getElementById('actions-display').dataset.actions || '[]');
                        const container = document.getElementById('actions-display');
                        if (actions.length > 0) {
                            container.innerHTML = '<div class="rams-stack rams-gap-2">' + actions.map(action => {
                                let paramsHtml = '';
                                if (action.params && Object.keys(action.params).length > 0) {
                                    paramsHtml = '<div class="rams-grid rams-grid--2 rams-gap-2 rams-mt-2 rams-pt-sm rams-border-t rams-border">';
                                    for (const [key, value] of Object.entries(action.params)) {
                                        paramsHtml += `
                                            <div>
                                                <span class="rams-text-3xs rams-uppercase rams-text--muted rams-block rams-font-mono">${key.replace(/_/g, ' ')}</span>
                                                <span class="rams-text--xs rams-text--bold rams-font-mono">${value}</span>
                                            </div>
                                        `;
                                    }
                                    paramsHtml += '</div>';
                                }
                                return `
                                    <div class="rams-p-3 rams-bg-panel rams-border rams-rounded">
                                        <div class="rams-flex rams-items-center rams-gap-2 rams-mb-1">
                                            <div class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span></div>
                                            <span class="rams-text--sm rams-text--bold rams-uppercase rams-font-mono">${(action.type || '').replace(/_/g, ' ')}</span>
                                        </div>
                                        ${paramsHtml}
                                    </div>
                                `;
                            }).join('') + '</div>';
                        } else {
                            container.innerHTML = '<div class="rams-empty-state rams-p-4"><p class="rams-text--muted rams-text--xs">{{ 'playbook.no_actions'|trans }}</p></div>';
                        }
                    } catch(e) { 
                        document.getElementById('actions-display').innerHTML = '<div class="rams-alert rams-alert--error">{{ 'common.error'|trans }}</div>';
                    }
                })();
                </script>
            </div>
        </div>
    </div>

    {# Execution History #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'playbook.recent_executions'|trans }}</h2>
        </div>
        <div class="rams-module__content rams-module__content--flush">
            {% if runs|length > 0 %}
                <div class="rams-table-container">
                    <table class="rams-table" aria-label="{{ 'playbook.recent_executions'|trans }}">
                        <thead>
                            <tr>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'playbook.triggered_at'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'playbook.actions_executed'|trans }}</th>
                                <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'playbook.outcome'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for run in runs %}
                                <tr class="rams-table__row">
                                    <td class="rams-table__cell rams-text--xs rams-font-mono">{{ run.triggeredAt|date('M d, Y H:i:s') }}</td>
                                    <td class="rams-table__cell">
                                        <span class="rams-badge {% if run.status == 'completed' %}rams-badge--success {% elseif run.status == 'failed' %}rams-badge--danger {% elseif run.status == 'pending' %}rams-badge--warning {% endif %}">
                                            {{ run.status }}
                                        </span>
                                    </td>
                                    <td class="rams-table__cell rams-text--bold rams-font-mono">{{ run.actionsExecuted|default(0) }}</td>
                                    <td class="rams-table__cell rams-text--muted rams-text--xs">{{ run.outcome ?: 'common.n_a'|trans }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="rams-empty-state rams-p-8">
                    <p class="rams-text--muted rams-text--sm">{{ 'playbook.no_executions'|trans }}</p>
                </div>
            {% endif %}
        </div>
    </div>

    {# Metadata #}
    <div class="rams-module rams-module--inset">
        <div class="rams-module__content">
            <div class="rams-flex rams-justify-between rams-text--muted rams-text--xs rams-font-mono">
                <span>{{ 'playbook.created'|trans }}: {{ playbook.createdAt|date('Y-m-d H:i') }}</span>
                <span>{{ 'playbook.last_updated'|trans }}: {{ playbook.updatedAt|date('Y-m-d H:i') }}</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
