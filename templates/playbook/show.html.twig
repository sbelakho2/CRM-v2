{% extends 'base.html.twig' %}

{% block title %}{{ playbook.name }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <a href="{{ path('app_playbook_index') }}" class="text-blue-600 hover:text-blue-800 text-sm">
            ← Back to Playbooks
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">{{ message }}</div>
    {% endfor %}

    <!-- Playbook Header -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <div class="flex justify-between items-start">
            <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                    <h1 class="text-2xl font-bold">{{ playbook.name }}</h1>
                    <span class="px-3 py-1 rounded-full text-sm {% if playbook.isActive %}bg-green-100 text-green-800{% else %}bg-gray-100 text-gray-800{% endif %}">
                        {% if playbook.isActive %}Active{% else %}Inactive{% endif %}
                    </span>
                    <span class="px-2 py-1 bg-blue-100 text-blue-800 rounded text-xs">Priority: {{ playbook.priority }}</span>
                </div>
                <p class="text-gray-600">{{ playbook.description }}</p>
            </div>
            <div class="flex gap-2">
                <a href="{{ path('app_playbook_edit', {id: playbook.id}) }}" class="btn btn-primary">Edit</a>
                <form action="{{ path('app_playbook_delete', {id: playbook.id}) }}" method="post" class="inline" onsubmit="return confirm('Are you sure?')">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>

        {% if playbook.notes %}
            <div class="mt-4 p-3 bg-gray-50 rounded text-sm text-gray-700">
                <strong>Notes:</strong> {{ playbook.notes }}
            </div>
        {% endif %}

        <div class="mt-4 text-xs text-gray-500">
            Created: {{ playbook.createdAt|date('M d, Y H:i') }} | Last updated: {{ playbook.updatedAt|date('M d, Y H:i') }}
        </div>
    </div>

    <!-- Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="text-sm text-gray-600 mb-1">Total Runs</div>
            <div class="text-2xl font-bold text-gray-900">{{ stats.total_runs }}</div>
        </div>
        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="text-sm text-gray-600 mb-1">Completed</div>
            <div class="text-2xl font-bold text-green-600">{{ stats.completed }}</div>
        </div>
        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="text-sm text-gray-600 mb-1">Failed</div>
            <div class="text-2xl font-bold text-red-600">{{ stats.failed }}</div>
        </div>
        <div class="bg-white rounded-lg shadow-md p-4">
            <div class="text-sm text-gray-600 mb-1">Success Rate</div>
            <div class="text-2xl font-bold text-blue-600">
                {% if stats.total_runs > 0 %}
                    {{ ((stats.completed / stats.total_runs) * 100)|number_format(0) }}%
                {% else %}
                    N/A
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Trigger Rules -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Trigger Rules</h2>
        <div id="trigger-rules-display" data-rules="{{ playbook.triggerRules|e('html_attr') }}"></div>
        <script>
        try {
            const rules = JSON.parse(document.getElementById('trigger-rules-display').dataset.rules || '[]');
            const container = document.getElementById('trigger-rules-display');
            if (rules.length > 0) {
                container.innerHTML = '<div class="space-y-2">' + rules.map(rule => `
                    <div class="flex items-center gap-2 text-sm bg-gray-50 p-3 rounded">
                        <span class="font-mono bg-white px-2 py-1 rounded border">${rule.field || ''}</span>
                        <span class="text-gray-600">${rule.operator || ''}</span>
                        <span class="font-mono bg-white px-2 py-1 rounded border">${rule.value || ''}</span>
                    </div>
                `).join('') + '</div>';
            } else {
                container.innerHTML = '<p class="text-gray-500 text-sm">No trigger rules defined</p>';
            }
        } catch(e) { 
            console.error('Error parsing trigger rules:', e);
            document.getElementById('trigger-rules-display').innerHTML = '<p class="text-red-500 text-sm">Error loading trigger rules</p>';
        }
        </script>
    </div>

    <!-- Actions -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Actions</h2>
        <div id="actions-display" data-actions="{{ playbook.actions|e('html_attr') }}"></div>
        <script>
        try {
            const actions = JSON.parse(document.getElementById('actions-display').dataset.actions || '[]');
            const container = document.getElementById('actions-display');
            if (actions.length > 0) {
                container.innerHTML = '<div class="space-y-3">' + actions.map(action => {
                    let paramsHtml = '';
                    if (action.params && Object.keys(action.params).length > 0) {
                        paramsHtml = '<div class="grid grid-cols-2 gap-2 text-xs">';
                        for (const [key, value] of Object.entries(action.params)) {
                            paramsHtml += `
                                <div class="flex gap-2">
                                    <span class="text-gray-600">${key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}:</span>
                                    <span class="font-mono">${value}</span>
                                </div>
                            `;
                        }
                        paramsHtml += '</div>';
                    }
                    return `
                        <div class="bg-gray-50 p-4 rounded">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="font-semibold text-sm">${(action.type || '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</span>
                            </div>
                            ${paramsHtml}
                        </div>
                    `;
                }).join('') + '</div>';
            } else {
                container.innerHTML = '<p class="text-gray-500 text-sm">No actions defined</p>';
            }
        } catch(e) { 
            console.error('Error parsing actions:', e);
            document.getElementById('actions-display').innerHTML = '<p class="text-red-500 text-sm">Error loading actions</p>';
        }
        </script>
        {% set actionsList = [] %}
        {% if false %}
            <div class="space-y-3">
                {% for action in actionsList %}
                    <div class="bg-gray-50 p-4 rounded">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="font-semibold text-sm">{{ action.type|replace({'_': ' '})|title }}</span>
                        </div>
                        {% if action.params and action.params is iterable %}
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                {% for key, value in action.params %}
                                    <div class="flex gap-2">
                                        <span class="text-gray-600">{{ key|replace({'_': ' '})|title }}:</span>
                                        <span class="font-mono">{{ value }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-gray-500 text-sm">No actions defined</p>
        {% endif %}
    </div>

    <!-- Execution History -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-lg font-semibold mb-4">Recent Executions</h2>
        
        {% if runs|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Triggered At</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Actions Executed</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Outcome</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for run in runs %}
                            <tr>
                                <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-900">
                                    {{ run.triggeredAt|date('M d, Y H:i:s') }}
                                </td>
                                <td class="px-4 py-2 whitespace-nowrap">
                                    <span class="px-2 py-1 rounded-full text-xs font-medium
                                        {% if run.status == 'completed' %}bg-green-100 text-green-800
                                        {% elseif run.status == 'failed' %}bg-red-100 text-red-800
                                        {% elseif run.status == 'pending' %}bg-yellow-100 text-yellow-800
                                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                                        {{ run.status }}
                                    </span>
                                </td>
                                <td class="px-4 py-2 text-sm text-gray-900">
                                    {{ run.actionsExecuted|default(0) }}
                                </td>
                                <td class="px-4 py-2 text-sm text-gray-500">
                                    {{ run.outcome|default('—')|slice(0, 50) }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-gray-500 text-sm">No execution history yet</p>
        {% endif %}
    </div>
</div>
{% endblock %}
