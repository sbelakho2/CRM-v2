{# Playbook quote reminder email - extends base email layout #}
{% extends 'emails/base.html.twig' %}

{% block title %}{{ 'emails.playbook.quote_reminder.title'|trans }}{% endblock %}

{% block header %}
<thead>
    <tr>
        <th scope="col" style="padding: 30px 40px; text-align: center; background-color: #b45309; border-bottom: 2px solid #f59e0b;">
            <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 600;">{{ 'emails.playbook.quote_reminder.title'|trans }}</h1>
        </th>
    </tr>
</thead>
{% endblock %}

{% block content %}
<div class="rams-email-content" style="font-family: Arial, sans-serif; color: #374151; line-height: 1.6;">
    <div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; margin: 15px 0;">
        <strong>{{ 'common.action_required'|trans }}:</strong> {{ 'emails.playbook.quote_reminder.subject'|trans }}
    </div>

    <div style="background: #fef3c7; padding: 15px; border-radius: 6px; margin: 15px 0;">
        <strong>{{ 'common.account'|trans }}:</strong> {{ account_name|default(company_name|default('common.unknown'|trans)) }}<br>
        {% if domain is defined %}
        <strong>{{ 'common.domain'|trans }}:</strong> {{ domain }}<br>
        {% endif %}
        {% if quote_value is defined %}
        <strong>{{ 'common.value'|trans }}:</strong> {{ quote_value|number_format(2) }}<br>
        {% endif %}
    </div>

    <p style="margin: 0 0 10px;">{{ 'emails.playbook.quote_reminder.next_steps'|trans }}:</p>
    <ul style="margin: 0 0 15px; padding-left: 20px;">
        <li>{{ 'emails.playbook.quote_reminder.address_questions'|trans }}</li>
        <li>{{ 'emails.playbook.quote_reminder.confirm_receipt'|trans }}</li>
        <li>{{ 'emails.playbook.quote_reminder.discuss_timeline'|trans }}</li>
    </ul>
</div>
{% endblock %}

{% block footer %}
<p style="margin: 0 0 10px; color: #6b7280; font-size: 12px; text-align: center;">{{ 'emails.playbook.quote_reminder.automated_message'|trans }}</p>
<p style="margin: 0; color: #6b7280; font-size: 12px; text-align: center;">{{ timestamp|default('now')|date('Y-m-d H:i:s') }}</p>
{% if unsubscribe_url is defined and unsubscribe_url %}
<p style="margin-top: 12px; border-top: 1px solid #e5e7eb; padding-top: 12px; color: #6b7280; font-size: 12px; text-align: center;">
    {{ 'playbook.email.unsubscribe_desc'|trans }}
    <a href="{{ unsubscribe_url }}" style="color: #6b7280; text-decoration: underline;">{{ 'playbook.email.unsubscribe'|trans }}</a>
</p>
{% endif %}
{% endblock %}
