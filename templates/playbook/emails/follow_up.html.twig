{# Playbook follow-up reminder email - extends base email layout #}
{% extends 'emails/base.html.twig' %}

{% block title %}{{ 'playbook.email.follow_up_title'|trans }}{% endblock %}

{% block header %}
<thead>
    <tr>
        <th scope="col" style="padding: 30px 40px; text-align: center; background-color: #0369a1; border-bottom: 2px solid #0ea5e9;">
            <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 600;">{{ 'playbook.email.follow_up_title'|trans }}</h1>
        </th>
    </tr>
</thead>
{% endblock %}

{% block content %}
<div class="rams-email-content" style="font-family: Arial, sans-serif; color: #374151; line-height: 1.6;">
    <p style="margin: 0 0 15px;">{{ 'playbook.email.reminder_due'|trans }}</p>

    <div style="background: #e0f2fe; padding: 15px; border-radius: 6px; margin: 15px 0;">
        <strong>{{ 'playbook.email.account'|trans }}</strong> {{ account_name|default(company_name|default('common.unknown'|trans)) }}<br>
        {% if domain is defined %}
        <strong>{{ 'playbook.email.domain'|trans }}</strong> {{ domain }}<br>
        {% endif %}
        {% if engagement_score is defined %}
        <strong>{{ 'playbook.email.engagement_score'|trans }}</strong> {{ engagement_score }}<br>
        {% endif %}
    </div>

    <p style="margin: 0 0 15px;">{{ 'playbook.email.timely_follow_up'|trans }}</p>
</div>
{% endblock %}

{% block footer %}
<p style="margin: 0 0 10px; color: #6b7280; font-size: 12px; text-align: center;">{{ 'playbook.email.automated_message'|trans }}</p>
<p style="margin: 0; color: #6b7280; font-size: 12px; text-align: center;">{{ timestamp|default('now')|date('Y-m-d H:i:s') }}</p>
{% if unsubscribe_url is defined and unsubscribe_url %}
<p style="margin-top: 12px; border-top: 1px solid #e5e7eb; padding-top: 12px; color: #6b7280; font-size: 12px; text-align: center;">
    {{ 'playbook.email.unsubscribe_desc'|trans }}
    <a href="{{ unsubscribe_url }}" style="color: #6b7280; text-decoration: underline;">{{ 'playbook.email.unsubscribe'|trans }}</a>
</p>
{% endif %}
{% endblock %}
