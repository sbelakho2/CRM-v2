{% extends 'base.html.twig' %}

{% block title %}{{ 'playbook.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <!-- Header -->
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'playbook.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'playbook.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('app_playbook_new') }}" class="rams-btn rams-btn--primary">
            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            {{ 'playbook.create_playbook'|trans }}
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="rams-alert rams-alert--success">{{ message }}</div>
    {% endfor %}

    <div class="rams-module">
        <table class="rams-table">
            <thead class="rams-table__header">
                <tr>
                    <th class="rams-table__cell">{{ 'common.name'|trans }}</th>
                    <th class="rams-table__cell">{{ 'playbook.priority'|trans }}</th>
                    <th class="rams-table__cell">{{ 'common.status'|trans }}</th>
                    <th class="rams-table__cell">{{ 'playbook.runs'|trans }}</th>
                    <th class="rams-table__cell">{{ 'playbook.success_rate'|trans }}</th>
                    <th class="rams-table__cell">{{ 'playbook.last_run'|trans }}</th>
                    <th class="rams-table__cell">{{ 'common.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for playbook in playbooks %}
                    {% set stats = playbookStats[playbook.id] %}
                    <tr class="rams-table__row">
                        <td class="rams-table__cell">
                            <div class="rams-list-item__title">{{ playbook.name }}</div>
                            <div class="rams-text-muted">{{ playbook.description|slice(0, 60) }}...</div>
                        </td>
                        <td class="rams-table__cell">
                            <span class="rams-metric__value">{{ playbook.priority }}</span>
                        </td>
                        <td class="rams-table__cell">
                            <button 
                                onclick="togglePlaybook({{ playbook.id }})" 
                                class="rams-toggle-btn {% if playbook.isActive %}rams-toggle-btn--active{% else %}rams-toggle-btn--inactive{% endif %}"
                                data-playbook-id="{{ playbook.id }}"
                            >
                                <span class="rams-status-text">{% if playbook.isActive %}{{ 'playbook.active'|trans }}{% else %}{{ 'playbook.inactive'|trans }}{% endif %}</span>
                            </button>
                        </td>
                        <td class="rams-table__cell">
                            <span class="rams-metric__value">{{ stats.total_runs }}</span>
                        </td>
                        <td class="rams-table__cell">
                            {% set success_rate = stats.success_rate %}
                            <div class="rams-metric">
                                <span class="rams-metric__value {% if success_rate >= 80 %}rams-text-success{% elseif success_rate >= 50 %}rams-text-warning{% else %}rams-text-danger{% endif %}">
                                    {{ success_rate|number_format(0) }}%
                                </span>
                                <span class="rams-text-muted">({{ stats.successful_runs }}/{{ stats.total_runs }})</span>
                            </div>
                        </td>
                        <td class="rams-table__cell rams-text-muted">
                            {% if stats.last_run %}
                                {{ stats.last_run.triggeredAt|date('M d, H:i') }}
                            {% else %}
                                {{ 'playbook.never'|trans }}
                            {% endif %}
                        </td>
                        <td class="rams-table__cell">
                            <div class="rams-btn-group">
                                <a href="{{ path('app_playbook_show', {id: playbook.id}) }}" class="rams-btn rams-btn--ghost">{{ 'common.view'|trans }}</a>
                                <a href="{{ path('app_playbook_edit', {id: playbook.id}) }}" class="rams-btn rams-btn--ghost">{{ 'common.edit'|trans }}</a>
                                <form action="{{ path('app_playbook_delete', {id: playbook.id}) }}" method="post" class="rams-inline-block" onsubmit="return ramsConfirmSubmit(event, '{{ 'playbook.delete_confirm'|trans }}', {variant: 'danger'})">
                                    <button type="submit" class="rams-btn rams-btn--danger rams-btn--ghost">{{ 'common.delete'|trans }}</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="rams-table__cell">
                            <div class="rams-empty-state">
                                {{ 'playbook.no_playbooks'|trans }} <a href="{{ path('app_playbook_new') }}" class="rams-link">{{ 'playbook.create_first'|trans }}</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Documentation -->
    <div class="rams-module rams-module--info">
        <div class="rams-module__content">
            <h2 class="rams-module__title">{{ 'playbook.what_are_playbooks'|trans }}</h2>
            <p class="rams-text-muted">
                {{ 'playbook.playbooks_description'|trans }}
            </p>
            <div class="rams-grid rams-grid--2">
                <div>
                    <h3 class="rams-dymo">{{ 'playbook.example_triggers'|trans }}:</h3>
                    <ul class="rams-list rams-list--bullet">
                        <li>Visitor views pricing page 3+ times</li>
                        <li>Lead score increases above 80</li>
                        <li>Email link clicked in campaign</li>
                        <li>Quote pending for >48 hours</li>
                    </ul>
                </div>
                <div>
                    <h3 class="rams-dymo">{{ 'playbook.example_actions'|trans }}:</h3>
                    <ul class="rams-list rams-list--bullet">
                        <li>Create high-priority call task</li>
                        <li>Send automated follow-up email</li>
                        <li>Assign lead to sales rep</li>
                        <li>Update lead score +10 points</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
async function togglePlaybook(id) {
    const btn = document.querySelector(`[data-playbook-id="${id}"]`);
    const statusText = btn.querySelector('.rams-status-text');
    
    try {
        const response = await fetch(`/playbooks/${id}/toggle`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            if (data.is_active) {
                btn.classList.remove('rams-badge--neutral');
                btn.classList.add('rams-badge--success');
                statusText.textContent = '{{ 'playbook.active'|trans }}';
            } else {
                btn.classList.remove('rams-badge--success');
                btn.classList.add('rams-badge--neutral');
                statusText.textContent = '{{ 'playbook.inactive'|trans }}';
            }
        }
    } catch (error) {
        console.error('Error toggling playbook:', error);
    }
}
</script>
{% endblock %}
