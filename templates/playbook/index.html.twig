{% extends 'base.html.twig' %}

{% block title %}ABM Playbooks{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">ABM Playbooks</h1>
        <a href="{{ path('app_playbook_new') }}" class="btn btn-primary">Create Playbook</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">{{ message }}</div>
    {% endfor %}

    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Priority</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Runs</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Success Rate</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Run</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for playbook in playbooks %}
                    {% set stats = playbookStats[playbook.id] %}
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-gray-900">{{ playbook.name }}</div>
                            <div class="text-sm text-gray-500">{{ playbook.description|slice(0, 60) }}...</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="text-sm text-gray-900">{{ playbook.priority }}</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <button 
                                onclick="togglePlaybook({{ playbook.id }})" 
                                class="toggle-btn px-3 py-1 rounded-full text-xs font-medium {% if playbook.isActive %}bg-green-100 text-green-800{% else %}bg-gray-100 text-gray-800{% endif %}"
                                data-playbook-id="{{ playbook.id }}"
                            >
                                <span class="status-text">{% if playbook.isActive %}Active{% else %}Inactive{% endif %}</span>
                            </button>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                            {{ stats.total_runs }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% set success_rate = stats.success_rate %}
                            <div class="flex items-center">
                                <span class="text-sm {% if success_rate >= 80 %}text-green-600{% elseif success_rate >= 50 %}text-yellow-600{% else %}text-red-600{% endif %}">
                                    {{ success_rate|number_format(0) }}%
                                </span>
                                <span class="text-xs text-gray-500 ml-1">({{ stats.successful_runs }}/{{ stats.total_runs }})</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {% if stats.last_run %}
                                {{ stats.last_run.triggeredAt|date('M d, H:i') }}
                            {% else %}
                                Never
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <a href="{{ path('app_playbook_show', {id: playbook.id}) }}" class="text-blue-600 hover:text-blue-900 mr-3">View</a>
                            <a href="{{ path('app_playbook_edit', {id: playbook.id}) }}" class="text-indigo-600 hover:text-indigo-900 mr-3">Edit</a>
                            <form action="{{ path('app_playbook_delete', {id: playbook.id}) }}" method="post" class="inline" onsubmit="return confirm('Are you sure?')">
                                <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="px-6 py-4 text-center text-gray-500">
                            No playbooks yet. <a href="{{ path('app_playbook_new') }}" class="text-blue-600 hover:underline">Create your first playbook</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Documentation -->
    <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
        <h2 class="text-xl font-semibold text-blue-900 mb-4">What are ABM Playbooks?</h2>
        <p class="text-blue-800 mb-4">
            Playbooks are automated workflows that trigger actions based on visitor behavior, lead scoring, email engagement, or quote status.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-blue-800">
            <div>
                <h3 class="font-semibold mb-2">Example Triggers:</h3>
                <ul class="list-disc list-inside space-y-1">
                    <li>Visitor views pricing page 3+ times</li>
                    <li>Lead score increases above 80</li>
                    <li>Email link clicked in campaign</li>
                    <li>Quote pending for >48 hours</li>
                </ul>
            </div>
            <div>
                <h3 class="font-semibold mb-2">Example Actions:</h3>
                <ul class="list-disc list-inside space-y-1">
                    <li>Create high-priority call task</li>
                    <li>Send automated follow-up email</li>
                    <li>Assign lead to sales rep</li>
                    <li>Update lead score +10 points</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
async function togglePlaybook(id) {
    const btn = document.querySelector(`[data-playbook-id="${id}"]`);
    const statusText = btn.querySelector('.status-text');
    
    try {
        const response = await fetch(`/playbooks/${id}/toggle`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            if (data.is_active) {
                btn.classList.remove('bg-gray-100', 'text-gray-800');
                btn.classList.add('bg-green-100', 'text-green-800');
                statusText.textContent = 'Active';
            } else {
                btn.classList.remove('bg-green-100', 'text-green-800');
                btn.classList.add('bg-gray-100', 'text-gray-800');
                statusText.textContent = 'Inactive';
            }
        }
    } catch (error) {
        alert('Error toggling playbook: ' + error.message);
    }
}
</script>
{% endblock %}
