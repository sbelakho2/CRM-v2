{% extends 'base.html.twig' %}

{% block title %}{{ 'playbook.edit_playbook'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <!-- Breadcrumb -->
    <nav class="rams-breadcrumb">
        <a href="{{ path('app_playbook_show', {id: playbook.id}) }}" class="rams-breadcrumb__link">
            ← {{ 'playbook.back_to_playbook'|trans }}
        </a>
    </nav>

    <!-- Header -->
    <div class="rams-page-header">
        <h1 class="rams-page-title">{{ 'playbook.edit_playbook'|trans }}</h1>
        <p class="rams-page-subtitle">{{ playbook.name }}</p>
    </div>

    <div class="rams-module rams-module--wide">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'playbook.configuration'|trans }}</h2>
        </div>

        <div class="rams-module__content">
            <form method="post" id="playbook-form" class="rams-form">
                <!-- Basic Info -->
                <div class="rams-form-section">
                    <h3 class="rams-form-section__title">{{ 'playbook.basic_info'|trans }}</h3>
                    
                    <div class="rams-form-group">
                        <label class="rams-label">{{ 'playbook.playbook_name'|trans }} *</label>
                        <input type="text" name="name" required class="rams-input" value="{{ playbook.name }}">
                    </div>

                    <div class="rams-form-group">
                        <label class="rams-label">{{ 'playbook.description'|trans }}</label>
                        <textarea name="description" rows="3" class="rams-textarea">{{ playbook.description }}</textarea>
                    </div>

                    <div class="rams-grid rams-grid--2">
                        <div class="rams-form-group">
                            <label class="rams-label">{{ 'playbook.priority'|trans }}</label>
                            <input type="number" name="priority" value="{{ playbook.priority }}" min="1" class="rams-input">
                            <p class="rams-text-muted">{{ 'playbook.priority_hint'|trans }}</p>
                        </div>
                        <div class="rams-form-group">
                            <label class="rams-label">{{ 'common.status'|trans }}</label>
                            <select name="is_active" class="rams-select">
                                <option value="1" {% if playbook.isActive %}selected{% endif %}>{{ 'playbook.active'|trans }}</option>
                                <option value="0" {% if not playbook.isActive %}selected{% endif %}>{{ 'playbook.inactive'|trans }}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Trigger Rules -->
                <div class="rams-form-section">
                    <h3 class="rams-form-section__title">{{ 'playbook.trigger_rules'|trans }}</h3>
                    <p class="rams-text-muted">{{ 'playbook.trigger_rules_hint'|trans }}</p>
                    
                    <div id="trigger-rules" class="rams-stack"></div>
                    
                    <button type="button" onclick="addTriggerRule()" class="rams-btn rams-btn--secondary">+ {{ 'playbook.add_trigger'|trans }}</button>
                    
                    <input type="hidden" name="trigger_rules" id="trigger-rules-json" value="{{ playbook.triggerRules }}">
                </div>

                <!-- Actions -->
                <div class="rams-form-section">
                    <h3 class="rams-form-section__title">{{ 'playbook.actions'|trans }}</h3>
                    <p class="rams-text-muted">{{ 'playbook.actions_hint'|trans }}</p>
                    
                    <div id="actions-list" class="rams-stack"></div>
                    
                    <button type="button" onclick="addAction()" class="rams-btn rams-btn--secondary">+ {{ 'playbook.add_action'|trans }}</button>
                    
                    <input type="hidden" name="actions" id="actions-json" value="{{ playbook.actions }}">
                </div>

                <!-- Notes -->
                <div class="rams-form-group">
                    <label class="rams-label">{{ 'playbook.notes'|trans }} ({{ 'common.optional'|trans|lower }})</label>
                    <textarea name="notes" rows="2" class="rams-textarea">{{ playbook.notes }}</textarea>
                </div>

                <div class="rams-module__footer">
                    <button type="submit" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        {{ 'playbook.save_changes'|trans }}
                    </button>
                    <a href="{{ path('app_playbook_show', {id: playbook.id}) }}" class="rams-btn rams-btn--ghost">{{ 'common.cancel'|trans }}</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const availableTriggers = {{ availableTriggers|json_encode|raw }};
const availableActions = {{ availableActions|json_encode|raw }};
const i18n = {
    selectField: '{{ 'playbook.rule.select_field'|trans|e('js') }}',
    selectAction: '{{ 'playbook.action.select_action'|trans|e('js') }}',
    operatorEquals: '{{ 'playbook.rule.operator.equals'|trans|e('js') }}',
    operatorNotEquals: '{{ 'playbook.rule.operator.not_equals'|trans|e('js') }}',
    operatorGreater: '{{ 'playbook.rule.operator.greater_than'|trans|e('js') }}',
    operatorLess: '{{ 'playbook.rule.operator.less_than'|trans|e('js') }}',
    operatorGreaterOrEqual: '{{ 'playbook.rule.operator.greater_or_equal'|trans|e('js') }}',
    operatorLessOrEqual: '{{ 'playbook.rule.operator.less_or_equal'|trans|e('js') }}',
    operatorContains: '{{ 'playbook.rule.operator.contains'|trans|e('js') }}',
    valuePlaceholder: '{{ 'playbook.rule.value_placeholder'|trans|e('js') }}'
};

let triggerRules = JSON.parse({{ playbook.triggerRules|json_encode|raw }}) || [];
let actions = JSON.parse({{ playbook.actions|json_encode|raw }}) || [];

// Load existing trigger rules
triggerRules.forEach((rule, index) => {
    const ruleId = Date.now() + index;
    rule.id = ruleId;
    
    const ruleDiv = document.createElement('div');
    ruleDiv.className = 'rams-flex rams-gap-2 rams-items-center rams-p-3 rams-bg-panel';
    ruleDiv.style.borderRadius = 'var(--radius-sm)';
    ruleDiv.id = `trigger-${ruleId}`;
    
    let fieldOptions = availableTriggers.map(t => 
        `<option value="${t.field}" ${rule.field === t.field ? 'selected' : ''}>${t.label}</option>`
    ).join('');
    
    ruleDiv.innerHTML = `
        <select class="rams-form__select rams-flex-1" onchange="updateTriggerField(${ruleId}, 'field', this.value)">
            <option value="">${i18n.selectField}</option>
            ${fieldOptions}
        </select>
        <select class="rams-form__select rams-flex-1" onchange="updateTriggerField(${ruleId}, 'operator', this.value)">
            <option value="==" ${rule.operator === '==' ? 'selected' : ''}>${i18n.operatorEquals}</option>
            <option value="!=" ${rule.operator === '!=' ? 'selected' : ''}>${i18n.operatorNotEquals}</option>
            <option value=">" ${rule.operator === '>' ? 'selected' : ''}>${i18n.operatorGreater}</option>
            <option value="<" ${rule.operator === '<' ? 'selected' : ''}>${i18n.operatorLess}</option>
            <option value=">=" ${rule.operator === '>=' ? 'selected' : ''}>${i18n.operatorGreaterOrEqual}</option>
            <option value="<=" ${rule.operator === '<=' ? 'selected' : ''}>${i18n.operatorLessOrEqual}</option>
            <option value="contains" ${rule.operator === 'contains' ? 'selected' : ''}>${i18n.operatorContains}</option>
        </select>
        <input type="text" class="rams-form__input rams-flex-1" placeholder="${i18n.valuePlaceholder}" value="${rule.value}" onchange="updateTriggerField(${ruleId}, 'value', this.value)">
        <button type="button" onclick="removeTriggerRule(${ruleId})" class="rams-btn rams-btn--ghost rams-text-danger">×</button>
    `;
    
    document.getElementById('trigger-rules').appendChild(ruleDiv);
});

// Load existing actions
actions.forEach((action, index) => {
    const actionId = Date.now() + index + 1000;
    action.id = actionId;
    
    const actionDiv = document.createElement('div');
    actionDiv.className = 'rams-p-4 rams-bg-panel';
    actionDiv.style.borderRadius = 'var(--radius-sm)';
    actionDiv.id = `action-${actionId}`;
    
    let actionOptions = availableActions.map(a => 
        `<option value="${a.type}" ${action.type === a.type ? 'selected' : ''}>${a.label}</option>`
    ).join('');
    
    actionDiv.innerHTML = `
        <div class="rams-flex rams-gap-2 rams-items-center rams-mb-3">
            <select class="rams-form__select rams-flex-1" onchange="updateActionType(${actionId}, this.value)">
                <option value="">${i18n.selectAction}</option>
                ${actionOptions}
            </select>
            <button type="button" onclick="removeAction(${actionId})" class="rams-btn rams-btn--ghost rams-text-danger">×</button>
        </div>
        <div id="action-params-${actionId}" class="rams-stack rams-gap-2"></div>
    `;
    
    document.getElementById('actions-list').appendChild(actionDiv);
    
    if (action.type) {
        renderActionParams(actionId, action.type, action.params || {});
    }
});

function addTriggerRule(existingRule = null) {
    const ruleId = Date.now();
    const rule = existingRule || { field: '', operator: '', value: '' };
    
    const ruleDiv = document.createElement('div');
    ruleDiv.className = 'rams-flex rams-gap-2 rams-items-center rams-p-3 rams-bg-panel';
    ruleDiv.style.borderRadius = 'var(--radius-sm)';
    ruleDiv.id = `trigger-${ruleId}`;
    
    let fieldOptions = availableTriggers.map(t => 
        `<option value="${t.field}" ${rule.field === t.field ? 'selected' : ''}>${t.label}</option>`
    ).join('');
    
    ruleDiv.innerHTML = `
        <select class="rams-form__select rams-flex-1" onchange="updateTriggerField(${ruleId}, 'field', this.value)">
            <option value="">${i18n.selectField}</option>
            ${fieldOptions}
        </select>
        <select class="rams-form__select rams-flex-1" onchange="updateTriggerField(${ruleId}, 'operator', this.value)">
            <option value="==" ${rule.operator === '==' ? 'selected' : ''}>${i18n.operatorEquals}</option>
            <option value="!=" ${rule.operator === '!=' ? 'selected' : ''}>${i18n.operatorNotEquals}</option>
            <option value=">" ${rule.operator === '>' ? 'selected' : ''}>${i18n.operatorGreater}</option>
            <option value="<" ${rule.operator === '<' ? 'selected' : ''}>${i18n.operatorLess}</option>
            <option value=">=" ${rule.operator === '>=' ? 'selected' : ''}>${i18n.operatorGreaterOrEqual}</option>
            <option value="<=" ${rule.operator === '<=' ? 'selected' : ''}>${i18n.operatorLessOrEqual}</option>
            <option value="contains" ${rule.operator === 'contains' ? 'selected' : ''}>${i18n.operatorContains}</option>
        </select>
        <input type="text" class="rams-form__input rams-flex-1" placeholder="${i18n.valuePlaceholder}" value="${rule.value}" onchange="updateTriggerField(${ruleId}, 'value', this.value)">
        <button type="button" onclick="removeTriggerRule(${ruleId})" class="rams-btn rams-btn--ghost rams-text-danger">×</button>
    `;
    
    document.getElementById('trigger-rules').appendChild(ruleDiv);
    triggerRules.push({ id: ruleId, ...rule });
    updateTriggerJson();
}

function updateTriggerField(ruleId, field, value) {
    const rule = triggerRules.find(r => r.id === ruleId);
    if (rule) {
        rule[field] = value;
        updateTriggerJson();
    }
}

function removeTriggerRule(ruleId) {
    document.getElementById(`trigger-${ruleId}`).remove();
    triggerRules = triggerRules.filter(r => r.id !== ruleId);
    updateTriggerJson();
}

function updateTriggerJson() {
    const rules = triggerRules.map(r => ({ field: r.field, operator: r.operator, value: r.value }));
    document.getElementById('trigger-rules-json').value = JSON.stringify(rules);
}

function addAction(existingAction = null) {
    const actionId = Date.now();
    const action = existingAction || { type: '', params: {} };
    
    const actionDiv = document.createElement('div');
    actionDiv.className = 'rams-p-4 rams-bg-panel';
    actionDiv.style.borderRadius = 'var(--radius-sm)';
    actionDiv.id = `action-${actionId}`;
    
    let actionOptions = availableActions.map(a => 
        `<option value="${a.type}" ${action.type === a.type ? 'selected' : ''}>${a.label}</option>`
    ).join('');
    
    actionDiv.innerHTML = `
        <div class="rams-flex rams-gap-2 rams-items-center rams-mb-3">
            <select class="rams-form__select rams-flex-1" onchange="updateActionType(${actionId}, this.value)">
                <option value="">${i18n.selectAction}</option>
                ${actionOptions}
            </select>
            <button type="button" onclick="removeAction(${actionId})" class="rams-btn rams-btn--ghost rams-text-danger">×</button>
        </div>
        <div id="action-params-${actionId}" class="rams-stack rams-gap-2"></div>
    `;
    
    document.getElementById('actions-list').appendChild(actionDiv);
    actions.push({ id: actionId, ...action });
    
    if (action.type) {
        renderActionParams(actionId, action.type, action.params);
    }
    updateActionsJson();
}

function updateActionType(actionId, type) {
    const action = actions.find(a => a.id === actionId);
    if (action) {
        action.type = type;
        action.params = {};
        renderActionParams(actionId, type, {});
        updateActionsJson();
    }
}

function renderActionParams(actionId, type, existingParams) {
    const container = document.getElementById(`action-params-${actionId}`);
    const actionDef = availableActions.find(a => a.type === type);
    
    if (!actionDef || !actionDef.params) {
        container.innerHTML = '';
        return;
    }
    
    container.innerHTML = actionDef.params.map(p => `
        <div class="rams-form__group">
            <label class="rams-form__label rams-text-xs">${p.label}</label>
            <input type="${p.type || 'text'}" class="rams-form__input" 
                   placeholder="${p.placeholder || ''}" 
                   value="${existingParams[p.name] || ''}"
                   onchange="updateActionParam(${actionId}, '${p.name}', this.value)">
        </div>
    `).join('');
}

function updateActionParam(actionId, param, value) {
    const action = actions.find(a => a.id === actionId);
    if (action) {
        action.params[param] = value;
        updateActionsJson();
    }
}

function removeAction(actionId) {
    document.getElementById(`action-${actionId}`).remove();
    actions = actions.filter(a => a.id !== actionId);
    updateActionsJson();
}

function updateActionsJson() {
    const actionList = actions.map(a => ({ type: a.type, params: a.params }));
    document.getElementById('actions-json').value = JSON.stringify(actionList);
}

document.getElementById('playbook-form').addEventListener('submit', function(e) {
    updateTriggerJson();
    updateActionsJson();
});
</script>
{% endblock %}
