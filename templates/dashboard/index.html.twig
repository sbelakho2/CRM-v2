{% extends 'base.html.twig' %}

{% block title %}Dashboard - STARZ Morocco CRM{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Header with Geist-style typography -->
    <div class="border-b border-neutral-200/80 pb-5">
        <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Dashboard</h1>
        <p class="mt-1.5 text-sm text-neutral-600">90-day performance tracking</p>
    </div>

    <!-- 90-Day KPI Cards - Geist-inspired design -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Pipeline Value -->
        <div class="group relative overflow-hidden rounded-xl border border-neutral-200/60 bg-white p-5 transition-all hover:border-neutral-300 hover:shadow-sm">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <p class="text-xs font-medium uppercase tracking-wide text-neutral-500">Pipeline Value</p>
                    <p class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900">
                        ${{ (kpis.pipeline_value / 1000000)|number_format(1) }}M
                    </p>
                </div>
                <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-blue-50/80 text-blue-600 transition-colors group-hover:bg-blue-100/80">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
            <div class="mt-4 space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-neutral-500">Target: ${{ (kpis.target_pipeline / 1000000)|number_format(1) }}M</span>
                    <span class="font-medium text-blue-600">{{ pipeline_progress }}%</span>
                </div>
                <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-neutral-100">
                    <div class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-blue-500 to-blue-600 transition-all" style="width: {{ pipeline_progress }}%"></div>
                </div>
            </div>
        </div>

        <!-- RFQs -->
        <div class="group relative overflow-hidden rounded-xl border border-neutral-200/60 bg-white p-5 transition-all hover:border-neutral-300 hover:shadow-sm">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <p class="text-xs font-medium uppercase tracking-wide text-neutral-500">RFQs Submitted</p>
                    <p class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900">{{ kpis.rfq_count }}</p>
                </div>
                <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-emerald-50/80 text-emerald-600 transition-colors group-hover:bg-emerald-100/80">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
            </div>
            <div class="mt-4 space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-neutral-500">Target: {{ kpis.target_rfqs }}</span>
                    <span class="font-medium text-emerald-600">{{ rfq_progress }}%</span>
                </div>
                <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-neutral-100">
                    <div class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-emerald-500 to-emerald-600 transition-all" style="width: {{ rfq_progress }}%"></div>
                </div>
            </div>
        </div>

        <!-- NPI Awards -->
        <div class="group relative overflow-hidden rounded-xl border border-neutral-200/60 bg-white p-5 transition-all hover:border-neutral-300 hover:shadow-sm">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <p class="text-xs font-medium uppercase tracking-wide text-neutral-500">NPI Awards</p>
                    <p class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900">{{ kpis.npi_awards }}</p>
                </div>
                <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-purple-50/80 text-purple-600 transition-colors group-hover:bg-purple-100/80">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                    </svg>
                </div>
            </div>
            <div class="mt-4 space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-neutral-500">Target: {{ kpis.target_npis }}</span>
                    <span class="font-medium text-purple-600">{{ npi_progress }}%</span>
                </div>
                <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-neutral-100">
                    <div class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-purple-500 to-purple-600 transition-all" style="width: {{ npi_progress }}%"></div>
                </div>
            </div>
        </div>

        <!-- Framework Agreements -->
        <div class="group relative overflow-hidden rounded-xl border border-neutral-200/60 bg-white p-5 transition-all hover:border-neutral-300 hover:shadow-sm">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <p class="text-xs font-medium uppercase tracking-wide text-neutral-500">Frameworks</p>
                    <p class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900">{{ kpis.framework_agreements }}</p>
                </div>
                <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-amber-50/80 text-amber-600 transition-colors group-hover:bg-amber-100/80">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                    </svg>
                </div>
            </div>
            <div class="mt-4 space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-neutral-500">Target: {{ kpis.target_frameworks }}</span>
                    <span class="font-medium text-amber-600">{{ framework_progress }}%</span>
                </div>
                <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-neutral-100">
                    <div class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-amber-500 to-amber-600 transition-all" style="width: {{ framework_progress }}%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row - Geist-style cards -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <!-- Sector Breakdown -->
        <div class="overflow-hidden rounded-xl border border-neutral-200/60 bg-white p-6 transition-all hover:border-neutral-300 hover:shadow-sm">
            <div class="mb-5 flex items-center justify-between">
                <h3 class="text-base font-semibold tracking-tight text-neutral-900">Companies by Sector</h3>
                <span class="text-xs text-neutral-500">Total: {{ sector_breakdown|length }}</span>
            </div>
            <div class="relative" style="height: 280px;">
                <canvas id="sectorChart"></canvas>
            </div>
        </div>

        <!-- Pipeline Distribution -->
        <div class="overflow-hidden rounded-xl border border-neutral-200/60 bg-white p-6 transition-all hover:border-neutral-300 hover:shadow-sm">
            <div class="mb-5 flex items-center justify-between">
                <h3 class="text-base font-semibold tracking-tight text-neutral-900">Pipeline Distribution</h3>
                <span class="text-xs text-neutral-500">Active Opportunities</span>
            </div>
            <div class="relative" style="height: 280px;">
                <canvas id="pipelineChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Weekly Activity Summary & Recent Activities -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <!-- Weekly Activity -->
        <div class="overflow-hidden rounded-xl border border-neutral-200/60 bg-white p-6 transition-all hover:border-neutral-300 hover:shadow-sm lg:col-span-1">
            <h3 class="mb-5 text-base font-semibold tracking-tight text-neutral-900">This Week</h3>
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50/80 text-blue-600">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                        </div>
                        <span class="text-sm text-neutral-700">Calls Made</span>
                    </div>
                    <span class="text-lg font-semibold text-neutral-900">{{ weekly_metrics.calls_made }}</span>
                </div>
                
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50/80 text-emerald-600">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                        <span class="text-sm text-neutral-700">Emails Sent</span>
                    </div>
                    <span class="text-lg font-semibold text-neutral-900">{{ weekly_metrics.emails_sent }}</span>
                </div>
                
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-purple-50/80 text-purple-600">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                        </div>
                        <span class="text-sm text-neutral-700">Meetings</span>
                    </div>
                    <span class="text-lg font-semibold text-neutral-900">{{ weekly_metrics.meetings_held }}</span>
                </div>
                
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50/80 text-amber-600">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                            </svg>
                        </div>
                        <span class="text-sm text-neutral-700">Portal Signups</span>
                    </div>
                    <span class="text-lg font-semibold text-neutral-900">{{ weekly_metrics.portal_signups }}</span>
                </div>
            </div>
        </div>

        <!-- Recent Activities -->
        <div class="overflow-hidden rounded-xl border border-neutral-200/60 bg-white p-6 transition-all hover:border-neutral-300 hover:shadow-sm lg:col-span-2">
            <div class="mb-5 flex items-center justify-between">
                <h3 class="text-base font-semibold tracking-tight text-neutral-900">Recent Activity</h3>
                <a href="#" class="text-xs font-medium text-blue-600 hover:text-blue-700">View all</a>
            </div>
            <div class="space-y-3">
                {% for activity in recent_activities %}
                <div class="group flex items-start gap-3 rounded-lg p-2 transition-colors hover:bg-neutral-50">
                    <div class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-neutral-600 transition-colors group-hover:bg-neutral-200">
                        {% if activity.type == 'Call' %}
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        {% elseif activity.type == 'Email' %}
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        {% elseif activity.type == 'Meeting' %}
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        {% else %}
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        {% endif %}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-neutral-900">{{ activity.type }}</p>
                        <p class="text-xs text-neutral-600 line-clamp-1">{{ activity.company.name }}</p>
                    </div>
                    <span class="flex-shrink-0 text-xs text-neutral-500">{{ activity.activityDate|date('M d') }}</span>
                </div>
                {% else %}
                <div class="py-8 text-center">
                    <p class="text-sm text-neutral-500">No recent activities</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<script>
// Geist-inspired chart styling
const geistColors = {
    blue: '#3B82F6',
    emerald: '#10B981',
    purple: '#A855F7',
    amber: '#F59E0B',
    red: '#EF4444',
    slate: '#64748B',
    neutral: {
        100: '#F5F5F5',
        200: '#E5E5E5',
        300: '#D4D4D4',
        400: '#A3A3A3',
        500: '#737373',
        600: '#525252',
        700: '#404040',
        800: '#262626',
        900: '#171717'
    }
};

// Chart.js defaults for Geist aesthetic
Chart.defaults.font.family = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif";
Chart.defaults.font.size = 12;
Chart.defaults.color = geistColors.neutral[600];
Chart.defaults.borderColor = geistColors.neutral[200];

// Sector Breakdown Chart
const sectorCtx = document.getElementById('sectorChart').getContext('2d');
new Chart(sectorCtx, {
    type: 'bar',
    data: {
        labels: {{ sector_labels|raw }},
        datasets: [{
            label: 'Companies',
            data: {{ sector_company_counts|raw }},
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            borderColor: geistColors.blue,
            borderWidth: 1,
            borderRadius: 6,
            barThickness: 32
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                display: false
            },
            tooltip: {
                backgroundColor: geistColors.neutral[900],
                titleColor: '#fff',
                bodyColor: '#fff',
                padding: 12,
                cornerRadius: 8,
                displayColors: false,
                titleFont: {
                    size: 13,
                    weight: '600'
                },
                bodyFont: {
                    size: 12
                }
            }
        },
        scales: {
            x: {
                grid: {
                    display: false
                },
                border: {
                    display: false
                },
                ticks: {
                    color: geistColors.neutral[600],
                    font: {
                        size: 11
                    }
                }
            },
            y: {
                beginAtZero: true,
                grid: {
                    color: geistColors.neutral[200],
                    drawBorder: false
                },
                border: {
                    display: false
                },
                ticks: {
                    color: geistColors.neutral[600],
                    font: {
                        size: 11
                    },
                    precision: 0
                }
            }
        }
    }
});

// Pipeline Distribution Chart
const pipelineCtx = document.getElementById('pipelineChart').getContext('2d');
new Chart(pipelineCtx, {
    type: 'doughnut',
    data: {
        labels: {{ pipeline_labels|raw }},
        datasets: [{
            data: {{ pipeline_data|raw }},
            backgroundColor: [
                'rgba(59, 130, 246, 0.8)',
                'rgba(16, 185, 129, 0.8)',
                'rgba(168, 85, 247, 0.8)',
                'rgba(245, 158, 11, 0.8)',
                'rgba(239, 68, 68, 0.8)',
                'rgba(34, 197, 94, 0.8)'
            ],
            borderWidth: 0,
            hoverOffset: 8
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '65%',
        plugins: {
            legend: {
                display: true,
                position: 'bottom',
                labels: {
                    padding: 15,
                    usePointStyle: true,
                    pointStyle: 'circle',
                    font: {
                        size: 11
                    },
                    color: geistColors.neutral[700]
                }
            },
            tooltip: {
                backgroundColor: geistColors.neutral[900],
                titleColor: '#fff',
                bodyColor: '#fff',
                padding: 12,
                cornerRadius: 8,
                displayColors: true,
                titleFont: {
                    size: 13,
                    weight: '600'
                },
                bodyFont: {
                    size: 12
                },
                callbacks: {
                    label: function(context) {
                        return ' ' + context.label + ': ' + context.parsed + ' companies';
                    }
                }
            }
        }
    }
});
</script>
{% endblock %}
