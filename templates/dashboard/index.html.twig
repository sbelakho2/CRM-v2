{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'dashboard.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'dashboard.overview'|trans }} - 90 {{ 'dashboard.days'|trans }}</p>
        </div>
    </div>

    {# 90-Day KPI Cards #}
    <div class="rams-grid rams-grid--4 mobile-stack">
        {# Pipeline Value #}
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content">
                <div class="rams-flex rams-justify-between rams-items-start rams-mb-4">
                    <div class="rams-metric">
                        <span class="rams-metric__label rams-uppercase rams-text--3xs rams-font-mono">{{ 'rfq.estimated_value'|trans }}</span>
                        <span class="rams-metric__value rams-text--xl">
                            {{ (kpis.pipeline_value / 1000000)|format_currency(kpis.pipeline_value_currency|default(display_currency()), null, 1) }}<span class="rams-metric__unit">{{ 'common.million_short'|trans }}</span>
                        </span>
                    </div>
                    <div class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span></div>
                </div>
                <div class="rams-stack rams-gap-1">
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <span class="rams-text--3xs rams-text--muted rams-uppercase rams-font-mono">{{ 'common.total'|trans }}: {{ (kpis.target_pipeline / 1000000)|format_currency(kpis.target_pipeline_currency|default(display_currency()), null, 1) }}{{ 'common.million_short'|trans }}</span>
                        <span class="rams-badge rams-badge--info rams-badge--xs rams-font-mono">{{ pipeline_progress }}%</span>
                    </div>
                    <div class="rams-progress rams-progress--compact">
                        <div class="rams-progress__bar rams-progress__bar--info" style="width: {{ pipeline_progress }}%;"></div>
                    </div>
                </div>
            </div>
        </div>

        {# RFQs #}
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content">
                <div class="rams-flex rams-justify-between rams-items-start rams-mb-4">
                    <div class="rams-metric">
                        <span class="rams-metric__label rams-uppercase rams-text--3xs rams-font-mono">{{ 'rfq.submitted_rfqs'|trans }}</span>
                        <span class="rams-metric__value rams-text--xl">{{ kpis.rfq_count }}</span>
                    </div>
                    <div class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span></div>
                </div>
                <div class="rams-stack rams-gap-1">
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <span class="rams-text--3xs rams-text--muted rams-uppercase rams-font-mono">{{ 'common.total'|trans }}: {{ kpis.target_rfqs }}</span>
                        <span class="rams-badge rams-badge--success rams-badge--xs rams-font-mono">{{ rfq_progress }}%</span>
                    </div>
                    <div class="rams-progress rams-progress--compact">
                        <div class="rams-progress__bar rams-progress__bar--success" style="width: {{ rfq_progress }}%;"></div>
                    </div>
                </div>
            </div>
        </div>

        {# NPI Awards #}
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content">
                <div class="rams-flex rams-justify-between rams-items-start rams-mb-4">
                    <div class="rams-metric">
                        <span class="rams-metric__label rams-uppercase rams-text--3xs rams-font-mono">{{ 'dashboard.npi_awards'|trans }}</span>
                        <span class="rams-metric__value rams-text--xl">{{ kpis.npi_awards }}</span>
                    </div>
                    <div class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span></div>
                </div>
                <div class="rams-stack rams-gap-1">
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <span class="rams-text--3xs rams-text--muted rams-uppercase rams-font-mono">{{ 'common.total'|trans }}: {{ kpis.target_npis }}</span>
                        <span class="rams-badge rams-badge--primary rams-badge--xs rams-font-mono">{{ npi_progress }}%</span>
                    </div>
                    <div class="rams-progress rams-progress--compact">
                        <div class="rams-progress__bar rams-progress__bar--primary" style="width: {{ npi_progress }}%;"></div>
                    </div>
                </div>
            </div>
        </div>

        {# Framework Agreements #}
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content">
                <div class="rams-flex rams-justify-between rams-items-start rams-mb-4">
                    <div class="rams-metric">
                        <span class="rams-metric__label rams-uppercase rams-text--3xs rams-font-mono">{{ 'dashboard.framework_agreements'|trans }}</span>
                        <span class="rams-metric__value rams-text--xl">{{ kpis.framework_agreements }}</span>
                    </div>
                    <div class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span></div>
                </div>
                <div class="rams-stack rams-gap-1">
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <span class="rams-text--3xs rams-text--muted rams-uppercase rams-font-mono">{{ 'common.total'|trans }}: {{ kpis.target_frameworks }}</span>
                        <span class="rams-badge rams-badge--warning rams-badge--xs rams-font-mono">{{ framework_progress }}%</span>
                    </div>
                    <div class="rams-progress rams-progress--compact">
                        <div class="rams-progress__bar rams-progress__bar--warning" style="width: {{ framework_progress }}%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Charts Row #}
    <div class="rams-grid rams-grid--2">
        {# Sector Breakdown #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'company.title'|trans }} {{ 'company.sector'|trans|lower }}</span>
                <span class="rams-badge">{{ 'common.total'|trans }}: {{ sector_breakdown|length }}</span>
            </div>
            <div class="rams-module__content">
                <div class="rams-chart-container">
                    <canvas id="sectorChart"></canvas>
                </div>
            </div>
        </div>

        {# Pipeline Distribution #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'company.pipeline_stage'|trans }}</span>
                <span class="rams-badge">{{ 'common.active'|trans }}</span>
            </div>
            <div class="rams-module__content">
                <div class="rams-chart-container">
                    <canvas id="pipelineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    {# Weekly Activity Summary & Recent Activities #}
    <div class="rams-grid rams-grid--3 rams-gap-6">
        {# Weekly Activity #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'dashboard.this_week'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                <div class="rams-stack rams-gap-4">
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <div class="rams-flex rams-items-center rams-gap-3">
                            <div class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span></div>
                            <span class="rams-text--sm">{{ 'activity.types.call'|trans }}</span>
                        </div>
                        <span class="rams-badge rams-font-mono">{{ weekly_metrics.calls_made }}</span>
                    </div>
                    
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <div class="rams-flex rams-items-center rams-gap-3">
                            <div class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span></div>
                            <span class="rams-text--sm">{{ 'activity.types.email'|trans }}</span>
                        </div>
                        <span class="rams-badge rams-font-mono">{{ weekly_metrics.emails_sent }}</span>
                    </div>
                    
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <div class="rams-flex rams-items-center rams-gap-3">
                            <div class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span></div>
                            <span class="rams-text--sm">{{ 'activity.types.meeting'|trans }}</span>
                        </div>
                        <span class="rams-badge rams-font-mono">{{ weekly_metrics.meetings_held }}</span>
                    </div>
                    
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <div class="rams-flex rams-items-center rams-gap-3">
                            <div class="rams-andon"><span class="rams-andon__light rams-andon__light--yellow"></span></div>
                            <span class="rams-text--sm">{{ 'supplier_portal.title'|trans }}</span>
                        </div>
                        <span class="rams-badge rams-font-mono">{{ weekly_metrics.portal_signups }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# Recent Activities #}
        <div class="rams-module rams-grid-span-2">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'dashboard.recent_activity'|trans }}</h2>
                <a href="{{ path('app_activity_index') }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }} {{ 'common.all'|trans }}</a>
            </div>
            <div class="rams-module__content">
                <div class="rams-grid rams-grid--2 rams-gap-4">
                    {% for activity in recent_activities %}
                    <div class="rams-flex rams-items-center rams-gap-3 rams-p-2 rams-bg-panel rams-border rams-rounded">
                        <div class="rams-andon">
                            {% if activity.type == 'Call' %}
                                <span class="rams-andon__light rams-andon__light--green"></span>
                            {% elseif activity.type == 'Email' %}
                                <span class="rams-andon__light rams-andon__light--green"></span>
                            {% elseif activity.type == 'Meeting' %}
                                <span class="rams-andon__light rams-andon__light--yellow"></span>
                            {% else %}
                                <span class="rams-andon__light"></span>
                            {% endif %}
                        </div>
                        <div class="rams-flex-1 rams-overflow-hidden">
                            <p class="rams-text--xs rams-text--bold rams-uppercase rams-font-mono rams-mb-0">{{ activity.type }}</p>
                            <p class="rams-text-3xs rams-text--muted rams-truncate rams-mb-0">{{ safe_company_name(activity) }}</p>
                        </div>
                        <span class="rams-text-3xs rams-text--muted rams-font-mono rams-uppercase">{{ activity.activityDate|date('M d') }}</span>
                    </div>
                    {% else %}
                    <div class="rams-grid-span-2 rams-empty-state rams-p-4">
                        <p class="rams-text--muted rams-text--xs">{{ 'activity.no_activities'|trans }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    {# Compliance Alerts Widget #}
    {% if compliance_alert_counts.total > 0 or compliance_alert_counts.snoozed > 0 %}
    <div class="rams-module rams-module rams-border-warning">
        <div class="rams-module__header">
            <h2 class="rams-module__title">
                <span class="rams-andon rams-mr-2"><span class="rams-andon__light rams-andon__light--yellow"></span></span>
                {{ 'compliance.alerts'|trans }}
            </h2>
            <div class="rams-flex rams-gap-2 rams-flex-wrap">
                {% if compliance_alert_counts.expired > 0 %}
                    <span class="rams-badge rams-badge--danger rams-badge--sm">{{ compliance_alert_counts.expired }} {{ 'compliance.expired'|trans }}</span>
                {% endif %}
                {% if compliance_alert_counts.expiring_soon > 0 %}
                    <span class="rams-badge rams-badge--warning rams-badge--sm">{{ compliance_alert_counts.expiring_soon }} {{ 'compliance.expiring_soon'|trans }}</span>
                {% endif %}
                {% if compliance_alert_counts.missing > 0 %}
                    <span class="rams-badge rams-badge--info rams-badge--sm">{{ compliance_alert_counts.missing }} {{ 'compliance.missing'|trans }}</span>
                {% endif %}
                {% if compliance_alert_counts.snoozed > 0 %}
                    <span class="rams-badge rams-badge--muted rams-badge--sm" title="{{ 'compliance.snoozed_tooltip'|trans }}">
                        😴 {{ compliance_alert_counts.snoozed }} {{ 'compliance.snoozed'|trans }}
                    </span>
                {% endif %}
                <a href="{{ path('app_compliance_overview') }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }} {{ 'common.all'|trans }}</a>
            </div>
        </div>
        <div class="rams-module__content">
            <div class="rams-stack rams-gap-2">
                {% for doc in compliance_alerts|slice(0, 5) %}
                <div class="rams-flex rams-justify-between rams-items-center rams-p-2 rams-bg-panel rams-border rams-rounded">
                    <div class="rams-flex rams-items-center rams-gap-3">
                        <div class="rams-andon">
                            {% if doc.isExpired %}
                                <span class="rams-andon__light rams-andon__light--red"></span>
                            {% elseif doc.isExpiringSoon %}
                                <span class="rams-andon__light rams-andon__light--yellow"></span>
                            {% else %}
                                <span class="rams-andon__light rams-andon__light--blue"></span>
                            {% endif %}
                        </div>
                        <div>
                            <p class="rams-text--xs rams-text--bold rams-mb-0">{{ doc.name }}</p>
                            <p class="rams-text-3xs rams-text--muted rams-mb-0">
                                {{ safe_company_name(doc, 'No Company') }}
                            </p>
                        </div>
                    </div>
                    <div class="rams-flex rams-items-center rams-gap-2">
                        <div class="rams-text--right">
                            {% if doc.expiryDate %}
                                <span class="rams-text-3xs rams-font-mono {% if doc.isExpired %}rams-text--danger{% elseif doc.isExpiringSoon %}rams-text--warning{% endif %}">
                                    {{ doc.expiryMessage }}
                                </span>
                            {% elseif not doc.provided %}
                                <span class="rams-badge rams-badge--info rams-badge--xs">{{ 'compliance.not_provided'|trans }}</span>
                            {% endif %}
                        </div>
                        {# Snooze Button #}
                        <form method="POST" action="{{ path('app_compliance_snooze', {id: doc.id}) }}" class="rams-inline-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('snooze' ~ doc.id) }}">
                            <input type="hidden" name="days" value="7">
                            <button type="submit" class="rams-btn rams-btn--ghost rams-btn--xs" title="{{ 'compliance.snooze_7_days'|trans }}">
                                😴
                            </button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}
</div>

<script>
{# Industrial-inspired chart styling using CSS custom properties for consistency #}
const computedStyle = getComputedStyle(document.documentElement);
const ramsColors = {
    orange: computedStyle.getPropertyValue('--rams-orange').trim() || '#FFBE00',
    green: computedStyle.getPropertyValue('--rams-green').trim() || '#2D8C3C',
    red: computedStyle.getPropertyValue('--rams-red').trim() || '#D62D2D',
    steel: computedStyle.getPropertyValue('--rams-steel').trim() || '#4A90E2',
    foreground: computedStyle.getPropertyValue('--rams-foreground').trim() || '#1A1A1A',
    muted: computedStyle.getPropertyValue('--rams-muted').trim() || '#6F6F6F',
    panel: computedStyle.getPropertyValue('--rams-panel').trim() || '#D9D9D9',
    line: computedStyle.getPropertyValue('--rams-border').trim() || '#CCCCCC',
    {# Chart-specific colors using new CSS variables #}
    chartPurple: computedStyle.getPropertyValue('--rams-chart-purple').trim() || '#8B5CF6',
    chartEmerald: computedStyle.getPropertyValue('--rams-chart-emerald').trim() || '#22C55E'
};

Chart.defaults.font.family = "'JetBrains Mono', 'SF Mono', 'Consolas', monospace";
Chart.defaults.font.size = 10;
Chart.defaults.color = ramsColors.muted;
Chart.defaults.borderColor = ramsColors.line;

{# Sector Breakdown Chart #}
const sectorCtx = document.getElementById('sectorChart').getContext('2d');
new Chart(sectorCtx, {
    type: 'bar',
    data: {
        labels: {{ sector_labels|raw }},
        datasets: [{
            label: '{{ "company.title"|trans }}',
            data: {{ sector_company_counts|raw }},
            backgroundColor: ramsColors.steel,
            borderColor: ramsColors.steel,
            borderWidth: 1,
            borderRadius: 2,
            barThickness: 24
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: ramsColors.foreground,
                titleColor: '#fff',
                bodyColor: '#fff',
                padding: 12,
                cornerRadius: 2,
                displayColors: false
            }
        },
        scales: {
            x: {
                grid: { display: false },
                border: { display: false },
                ticks: { color: ramsColors.muted }
            },
            y: {
                beginAtZero: true,
                grid: { color: ramsColors.line },
                border: { display: false },
                ticks: { color: ramsColors.muted, precision: 0 }
            }
        }
    }
});

{# Pipeline Distribution Chart #}
const pipelineCtx = document.getElementById('pipelineChart').getContext('2d');
new Chart(pipelineCtx, {
    type: 'doughnut',
    data: {
        labels: {{ pipeline_labels|raw }},
        datasets: [{
            data: {{ pipeline_data|raw }},
            backgroundColor: [
                ramsColors.steel,
                ramsColors.green,
                ramsColors.orange,
                ramsColors.chartPurple,
                ramsColors.red,
                ramsColors.chartEmerald
            ],
            borderWidth: 0,
            hoverOffset: 4
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '65%',
        plugins: {
            legend: {
                display: true,
                position: 'bottom',
                labels: {
                    padding: 12,
                    usePointStyle: true,
                    pointStyle: 'rect',
                    font: { size: 10 },
                    color: ramsColors.muted
                }
            },
            tooltip: {
                backgroundColor: ramsColors.foreground,
                titleColor: '#fff',
                bodyColor: '#fff',
                padding: 12,
                cornerRadius: 2
            }
        }
    }
});
</script>
{% endblock %}
