{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{% endblock %}

{% block body %}
<div class="rams-flex rams-flex-col rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'dashboard.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'dashboard.overview'|trans }} - 90 {{ 'filters.last_30_days'|trans|lower }}</p>
        </div>
    </div>

    {# 90-Day KPI Cards #}
    <div class="rams-grid rams-grid--4">
        {# Pipeline Value #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'dashboard.metrics'|trans }}</span>
                <span class="rams-andon">
                    <span class="rams-andon__light rams-andon__light--green"></span>
                </span>
            </div>
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'rfq.estimated_value'|trans }}</span>
                    <span class="rams-metric__value">
                        {{ (kpis.pipeline_value / 1000000)|format_currency(kpis.pipeline_value_currency|default(display_currency()), null, 1) }}<span class="rams-metric__unit">{{ 'common.million_short'|trans }}</span>
                    </span>
                </div>
                <div class="rams-mt-3">
                    <div class="rams-flex rams-justify-between rams-mb-1">
                        <span class="rams-text-muted rams-text-xs">{{ 'common.total'|trans }}: {{ (kpis.target_pipeline / 1000000)|format_currency(kpis.target_pipeline_currency|default(display_currency()), null, 1) }}{{ 'common.million_short'|trans }}</span>
                        <span class="rams-badge rams-badge--info">{{ pipeline_progress }}%</span>
                    </div>
                    <div class="rams-progress rams-progress--compact">
                        <div class="rams-progress__bar rams-progress__bar--info" style="width: {{ pipeline_progress }}%;"></div>
                    </div>
                </div>
            </div>
        </div>

        {# RFQs #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'rfq.title'|trans }}</span>
                <span class="rams-andon">
                    <span class="rams-andon__light rams-andon__light--green"></span>
                </span>
            </div>
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'common.submit'|trans }}</span>
                    <span class="rams-metric__value">{{ kpis.rfq_count }}</span>
                </div>
                <div class="rams-mt-3">
                    <div class="rams-flex rams-justify-between rams-mb-1">
                        <span class="rams-text-muted rams-text-xs">{{ 'common.total'|trans }}: {{ kpis.target_rfqs }}</span>
                        <span class="rams-badge rams-badge--success">{{ rfq_progress }}%</span>
                    </div>
                    <div class="rams-progress rams-progress--compact">
                        <div class="rams-progress__bar rams-progress__bar--success" style="width: {{ rfq_progress }}%;"></div>
                    </div>
                </div>
            </div>
        </div>

        {# NPI Awards #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'dashboard.npi_awards'|trans }}</span>
                <span class="rams-andon">
                    <span class="rams-andon__light rams-andon__light--green"></span>
                </span>
            </div>
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'common.total'|trans }}</span>
                    <span class="rams-metric__value">{{ kpis.npi_awards }}</span>
                </div>
                <div class="rams-mt-3">
                    <div class="rams-flex rams-justify-between rams-mb-1">
                        <span class="rams-text-muted rams-text-xs">{{ 'common.total'|trans }}: {{ kpis.target_npis }}</span>
                        <span class="rams-badge rams-badge--primary">{{ npi_progress }}%</span>
                    </div>
                    <div class="rams-progress rams-progress--compact">
                        <div class="rams-progress__bar rams-progress__bar--primary" style="width: {{ npi_progress }}%;"></div>
                    </div>
                </div>
            </div>
        </div>

        {# Framework Agreements #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'common.status'|trans }}</span>
                <span class="rams-andon">
                    <span class="rams-andon__light rams-andon__light--green"></span>
                </span>
            </div>
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'dashboard.framework_agreements'|trans }}</span>
                    <span class="rams-metric__value">{{ kpis.framework_agreements }}</span>
                </div>
                <div class="rams-mt-3">
                    <div class="rams-flex rams-justify-between rams-mb-1">
                        <span class="rams-text-muted rams-text-xs">{{ 'common.total'|trans }}: {{ kpis.target_frameworks }}</span>
                        <span class="rams-badge rams-badge--warning">{{ framework_progress }}%</span>
                    </div>
                    <div class="rams-progress rams-progress--compact">
                        <div class="rams-progress__bar rams-progress__bar--warning" style="width: {{ framework_progress }}%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Charts Row #}
    <div class="rams-grid rams-grid--2">
        {# Sector Breakdown #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'company.title'|trans }} {{ 'company.sector'|trans|lower }}</span>
                <span class="rams-badge">{{ 'common.total'|trans }}: {{ sector_breakdown|length }}</span>
            </div>
            <div class="rams-module__content">
                <div class="rams-chart-container">
                    <canvas id="sectorChart"></canvas>
                </div>
            </div>
        </div>

        {# Pipeline Distribution #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'company.pipeline_stage'|trans }}</span>
                <span class="rams-badge">{{ 'common.active'|trans }}</span>
            </div>
            <div class="rams-module__content">
                <div class="rams-chart-container">
                    <canvas id="pipelineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    {# Weekly Activity Summary & Recent Activities #}
    <div class="rams-grid rams-grid--3">
        {# Weekly Activity #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'dashboard.this_week'|trans }}</span>
            </div>
            <div class="rams-module__content">
                <div class="rams-flex rams-flex-col rams-gap-3">
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <div class="rams-flex rams-items-center rams-gap-3">
                            <span class="rams-andon">
                                <span class="rams-andon__light rams-andon__light--green"></span>
                            </span>
                            <span class="rams-text-muted">{{ 'activity.types.call'|trans }}</span>
                        </div>
                        <span class="rams-badge">{{ weekly_metrics.calls_made }}</span>
                    </div>
                    
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <div class="rams-flex rams-items-center rams-gap-3">
                            <span class="rams-andon">
                                <span class="rams-andon__light rams-andon__light--green"></span>
                            </span>
                            <span class="rams-text-muted">{{ 'activity.types.email'|trans }}</span>
                        </div>
                        <span class="rams-badge">{{ weekly_metrics.emails_sent }}</span>
                    </div>
                    
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <div class="rams-flex rams-items-center rams-gap-3">
                            <span class="rams-andon">
                                <span class="rams-andon__light rams-andon__light--green"></span>
                            </span>
                            <span class="rams-text-muted">{{ 'activity.types.meeting'|trans }}</span>
                        </div>
                        <span class="rams-badge">{{ weekly_metrics.meetings_held }}</span>
                    </div>
                    
                    <div class="rams-flex rams-justify-between rams-items-center">
                        <div class="rams-flex rams-items-center rams-gap-3">
                            <span class="rams-andon">
                                <span class="rams-andon__light rams-andon__light--yellow"></span>
                            </span>
                            <span class="rams-text-muted">{{ 'supplier_portal.title'|trans }}</span>
                        </div>
                        <span class="rams-badge">{{ weekly_metrics.portal_signups }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# Recent Activities #}
        <div class="rams-module rams-grid-span-2">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'dashboard.recent_activity'|trans }}</span>
                <a href="{{ path('app_activity_index') }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }} {{ 'common.all'|trans|lower }}</a>
            </div>
            <div class="rams-module__content">
                <div class="rams-flex rams-flex-col rams-gap-2">
                    {% for activity in recent_activities %}
                    <div class="rams-flex rams-items-center rams-gap-3 rams-p-2 rams-rounded">
                        <span class="rams-andon">
                            {% if activity.type == 'Call' %}
                                <span class="rams-andon__light rams-andon__light--green"></span>
                            {% elseif activity.type == 'Email' %}
                                <span class="rams-andon__light rams-andon__light--green"></span>
                            {% elseif activity.type == 'Meeting' %}
                                <span class="rams-andon__light rams-andon__light--yellow"></span>
                            {% else %}
                                <span class="rams-andon__light rams-andon__light--off"></span>
                            {% endif %}
                        </span>
                        <div class="rams-flex-1">
                            <p class="rams-text-sm rams-font-medium">{{ activity.type }}</p>
                            <p class="rams-text-muted rams-text-xs rams-truncate">{{ activity.company.name }}</p>
                        </div>
                        <span class="rams-text-muted rams-text-xs">{{ activity.activityDate|date('M d') }}</span>
                    </div>
                    {% else %}
                    <div class="rams-flex rams-justify-center rams-p-6">
                        <p class="rams-text-muted">{{ 'activity.no_activities'|trans }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
{# Industrial-inspired chart styling using CSS custom properties for consistency #}
const computedStyle = getComputedStyle(document.documentElement);
const ramsColors = {
    orange: computedStyle.getPropertyValue('--rams-orange').trim() || '#FFBE00',
    green: computedStyle.getPropertyValue('--rams-green').trim() || '#2D8C3C',
    red: computedStyle.getPropertyValue('--rams-red').trim() || '#D62D2D',
    steel: computedStyle.getPropertyValue('--rams-steel').trim() || '#4A90E2',
    foreground: computedStyle.getPropertyValue('--rams-foreground').trim() || '#1A1A1A',
    muted: computedStyle.getPropertyValue('--rams-muted').trim() || '#999999',
    panel: computedStyle.getPropertyValue('--rams-panel').trim() || '#D9D9D9',
    line: computedStyle.getPropertyValue('--rams-border').trim() || '#CCCCCC',
    {# Chart-specific colors using new CSS variables #}
    chartPurple: computedStyle.getPropertyValue('--rams-chart-purple').trim() || '#8B5CF6',
    chartEmerald: computedStyle.getPropertyValue('--rams-chart-emerald').trim() || '#22C55E'
};

Chart.defaults.font.family = "'JetBrains Mono', 'SF Mono', 'Consolas', monospace";
Chart.defaults.font.size = 10;
Chart.defaults.color = ramsColors.muted;
Chart.defaults.borderColor = ramsColors.line;

{# Sector Breakdown Chart #}
const sectorCtx = document.getElementById('sectorChart').getContext('2d');
new Chart(sectorCtx, {
    type: 'bar',
    data: {
        labels: {{ sector_labels|raw }},
        datasets: [{
            label: '{{ "company.title"|trans }}',
            data: {{ sector_company_counts|raw }},
            backgroundColor: ramsColors.steel,
            borderColor: ramsColors.steel,
            borderWidth: 1,
            borderRadius: 2,
            barThickness: 24
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: ramsColors.foreground,
                titleColor: '#fff',
                bodyColor: '#fff',
                padding: 12,
                cornerRadius: 2,
                displayColors: false
            }
        },
        scales: {
            x: {
                grid: { display: false },
                border: { display: false },
                ticks: { color: ramsColors.muted }
            },
            y: {
                beginAtZero: true,
                grid: { color: ramsColors.line },
                border: { display: false },
                ticks: { color: ramsColors.muted, precision: 0 }
            }
        }
    }
});

{# Pipeline Distribution Chart #}
const pipelineCtx = document.getElementById('pipelineChart').getContext('2d');
new Chart(pipelineCtx, {
    type: 'doughnut',
    data: {
        labels: {{ pipeline_labels|raw }},
        datasets: [{
            data: {{ pipeline_data|raw }},
            backgroundColor: [
                ramsColors.steel,
                ramsColors.green,
                ramsColors.orange,
                ramsColors.chartPurple,
                ramsColors.red,
                ramsColors.chartEmerald
            ],
            borderWidth: 0,
            hoverOffset: 4
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '65%',
        plugins: {
            legend: {
                display: true,
                position: 'bottom',
                labels: {
                    padding: 12,
                    usePointStyle: true,
                    pointStyle: 'rect',
                    font: { size: 10 },
                    color: ramsColors.muted
                }
            },
            tooltip: {
                backgroundColor: ramsColors.foreground,
                titleColor: '#fff',
                bodyColor: '#fff',
                padding: 12,
                cornerRadius: 2
            }
        }
    }
});
</script>
{% endblock %}
