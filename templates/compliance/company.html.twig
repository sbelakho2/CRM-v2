{% extends 'base.html.twig' %}

{% block title %}Compliance - {{ company.name }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-black text-white">
    <!-- Header -->
    <div class="border-b border-zinc-800 bg-black/50 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-6 py-6">
            <div class="flex items-center gap-4 text-sm text-zinc-400 mb-6">
                <a href="{{ path('app_company_index') }}" class="hover:text-white">Companies</a>
                <span>/</span>
                <a href="{{ path('app_company_show', {id: company.id}) }}" class="hover:text-white">{{ company.name }}</a>
                <span>/</span>
                <span class="text-white">Compliance</span>
            </div>

            <div class="flex items-start justify-between">
                <div>
                    <h1 class="text-3xl font-light tracking-tight mb-2">Compliance Pack</h1>
                    <p class="text-zinc-400">{{ company.name }}</p>
                </div>

                <form method="post" action="{{ path('app_compliance_generate_pack', {id: company.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('generate' ~ company.id) }}">
                    <button type="submit" onclick="return confirm('This will reset all compliance documents. Continue?');" 
                            class="px-4 py-2 border border-zinc-700 text-sm rounded-lg hover:bg-zinc-900 transition-colors">
                        Regenerate Pack
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 py-8">
        <!-- Stats Cards -->
        <div class="grid grid-cols-5 gap-4 mb-8">
            <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                <div class="text-zinc-400 text-sm mb-2">Total Documents</div>
                <div class="text-3xl font-light">{{ stats.total }}</div>
            </div>
            <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                <div class="text-zinc-400 text-sm mb-2">Uploaded</div>
                <div class="text-3xl font-light text-blue-400">{{ stats.uploaded }}</div>
            </div>
            <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                <div class="text-zinc-400 text-sm mb-2">Approved</div>
                <div class="text-3xl font-light text-green-400">{{ stats.approved }}</div>
            </div>
            <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                <div class="text-zinc-400 text-sm mb-2">Pending</div>
                <div class="text-3xl font-light text-yellow-400">{{ stats.pending }}</div>
            </div>
            <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/50">
                <div class="text-zinc-400 text-sm mb-2">Completion</div>
                <div class="text-3xl font-light">{{ stats.completion_percentage }}%</div>
            </div>
        </div>

        <!-- Progress Bar -->
        <div class="mb-8">
            <div class="h-3 bg-zinc-900 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-blue-500 to-green-500 transition-all duration-500" 
                     style="width: {{ stats.completion_percentage }}%"></div>
            </div>
        </div>

        <!-- Documents List -->
        <div class="border border-zinc-800 rounded-lg bg-zinc-950/50">
            <div class="border-b border-zinc-800 p-6">
                <h2 class="text-lg font-medium">Document Checklist</h2>
                <p class="text-sm text-zinc-400 mt-1">Upload and manage compliance documents</p>
            </div>

            <div class="divide-y divide-zinc-800">
                {% for document in documents %}
                    <div class="p-6 hover:bg-zinc-900/30 transition-colors">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <h3 class="font-medium">{{ document.name }}</h3>
                                    
                                    {% if document.fileName %}
                                        <span class="px-2 py-0.5 text-xs rounded-full bg-green-500/10 text-green-400 border border-green-500/20">
                                            Uploaded
                                        </span>
                                    {% else %}
                                        <span class="px-2 py-0.5 text-xs rounded-full bg-zinc-700/50 text-zinc-400 border border-zinc-700">
                                            Not Uploaded
                                        </span>
                                    {% endif %}

                                    {% if document.status %}
                                        <span class="px-2 py-0.5 text-xs rounded-full 
                                            {{ document.status == 'Approved' ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 
                                               document.status == 'Rejected' ? 'bg-red-500/10 text-red-400 border border-red-500/20' : 
                                               'bg-yellow-500/10 text-yellow-400 border border-yellow-500/20' }}">
                                            {{ document.status }}
                                        </span>
                                    {% endif %}

                                    {% if not document.required %}
                                        <span class="px-2 py-0.5 text-xs rounded-full bg-zinc-700/30 text-zinc-500 border border-zinc-700/50">
                                            Optional
                                        </span>
                                    {% endif %}
                                </div>

                                {% if document.fileName %}
                                    <div class="flex items-center gap-4 text-xs text-zinc-500">
                                        <span>{{ document.fileName }}</span>
                                        {% if document.uploadedAt %}
                                            <span>Uploaded {{ document.uploadedAt|date('M d, Y') }}</span>
                                        {% endif %}
                                        {% if document.expiryDate %}
                                            <span class="{{ document.expiryDate < date() ? 'text-red-400' : 'text-zinc-500' }}">
                                                Expires {{ document.expiryDate|date('M d, Y') }}
                                            </span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="flex items-center gap-2">
                                {% if document.fileName %}
                                    <a href="{{ path('app_compliance_download', {id: document.id}) }}" 
                                       class="p-2 text-zinc-400 hover:text-white transition-colors" title="Download">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                        </svg>
                                    </a>

                                    <form method="post" action="{{ path('app_compliance_delete', {id: document.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                                        <button type="submit" onclick="return confirm('Remove this document?');"
                                                class="p-2 text-zinc-400 hover:text-red-400 transition-colors" title="Remove">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </form>
                                {% else %}
                                    <form method="post" action="{{ path('app_compliance_upload', {id: document.id}) }}" enctype="multipart/form-data" class="flex items-center gap-2">
                                        <input type="file" name="file" class="hidden" id="file-{{ document.id }}" onchange="this.form.submit()">
                                        <label for="file-{{ document.id }}" class="px-3 py-1.5 text-sm bg-white text-black rounded-lg hover:bg-zinc-100 transition-colors cursor-pointer">
                                            Upload
                                        </label>
                                    </form>
                                {% endif %}

                                <form method="post" action="{{ path('app_compliance_toggle_required', {id: document.id}) }}" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ document.id) }}">
                                    <button type="submit" class="p-2 text-zinc-400 hover:text-white transition-colors" 
                                            title="{{ document.required ? 'Mark as Optional' : 'Mark as Required' }}">
                                        {% if document.required %}
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                                            </svg>
                                        {% else %}
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                        {% endif %}
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
