{% extends 'base.html.twig' %}

{% block title %}{{ 'compliance.title'|trans }} - {{ company.name }}{% endblock %}

{% block body %}
<div class="rams-stack">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ path('app_company_index') }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'nav.companies'|trans }}</a>
        <span class="rams-text-muted">/</span>
        <a href="{{ path('app_company_show', {id: company.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ company.name }}</a>
        <span class="rams-text-muted">/</span>
        <span class="rams-dymo">{{ 'compliance.title'|trans }}</span>
    </nav>

    {# Header Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <div>
                <h1 class="rams-page-title">{{ 'compliance.company_compliance'|trans }}</h1>
                <p class="rams-dymo">{{ company.name }}</p>
            </div>

            <form method="post" action="{{ path('app_compliance_generate_pack', {id: company.id}) }}" onsubmit="return ramsConfirmSubmit(event, '{{ 'compliance.regenerate_confirm'|trans|default('This will reset all compliance documents. Continue?') }}', {variant: 'warning'})">
                <input type="hidden" name="_token" value="{{ csrf_token('generate' ~ company.id) }}">
                <button type="submit" class="rams-btn rams-btn--secondary">
                    {{ 'compliance.regenerate_pack'|trans|default('Regenerate Pack') }}
                </button>
            </form>
        </div>
    </div>

    {# Stats Cards #}
    <div class="rams-grid rams-grid--5">
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'compliance.documents'|trans }}</span>
                <div class="rams-metric__value">{{ stats.total }}</div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'common.upload'|trans }}</span>
                <div class="rams-metric__value rams-text-info">{{ stats.uploaded }}</div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'compliance.passed'|trans }}</span>
                <div class="rams-metric__value rams-text-success">{{ stats.approved }}</div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'common.pending'|trans }}</span>
                <div class="rams-metric__value rams-text-warning">{{ stats.pending }}</div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'compliance.score'|trans }}</span>
                <div class="rams-metric__value">{{ stats.completion_percentage }}%</div>
            </div>
        </div>
    </div>

    {# Progress Bar #}
    <div class="rams-module">
        <div class="rams-module__content">
            <div class="rams-progress">
                <div class="rams-progress__bar" style="width: {{ stats.completion_percentage }}%"></div>
            </div>
        </div>
    </div>

    {# Documents List #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'compliance.document_checklist'|trans|default('Document Checklist') }}</h2>
            <p class="rams-dymo">{{ 'compliance.upload_manage'|trans|default('Upload and manage compliance documents') }}</p>
        </div>

        <div class="rams-module__content">
            {% for document in documents %}
                <div class="rams-list-item">
                    <div class="rams-list-item__content">
                        <div class="rams-list-item__header">
                            <h3 class="rams-list-item__title">{{ document.name }}</h3>
                            
                            {% if document.fileName %}
                                <span class="rams-badge rams-badge--success">
                                    {{ 'common.upload'|trans }}
                                </span>
                            {% else %}
                                <span class="rams-badge">
                                    {{ 'compliance.not_uploaded'|trans|default('Not Uploaded') }}
                                </span>
                            {% endif %}

                            {% if document.status %}
                                <span class="rams-badge {{ document.status == 'Approved' ? 'rams-badge--success' : (document.status == 'Rejected' ? 'rams-badge--danger' : 'rams-badge--warning') }}">
                                    {{ document.status }}
                                </span>
                            {% endif %}

                            {% if not document.required %}
                                <span class="rams-badge">
                                    {{ 'common.optional'|trans }}
                                </span>
                            {% endif %}
                        </div>

                        {% if document.fileName %}
                            <div class="rams-list-item__meta">
                                <span class="rams-dymo">{{ document.fileName }}</span>
                                {% if document.uploadedAt %}
                                    <span class="rams-dymo">{{ 'common.upload'|trans }} {{ document.uploadedAt|date('M d, Y') }}</span>
                                {% endif %}
                                {% if document.expiryDate %}
                                    <span class="rams-dymo {{ document.expiryDate < date() ? 'rams-dymo--critical' : '' }}">
                                        {{ 'compliance.expiry_date'|trans }} {{ document.expiryDate|date('M d, Y') }}
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="rams-list-item__actions">
                        {% if document.fileName %}
                            <a href="{{ path('app_compliance_download', {id: document.id}) }}" 
                               class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'common.download'|trans }}">
                                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                            </a>

                            <form method="post" action="{{ path('app_compliance_delete', {id: document.id}) }}" class="rams-inline-block" onsubmit="return ramsConfirmSubmit(event, '{{ 'compliance.remove_confirm'|trans|default('Remove this document?') }}', {variant: 'danger'})">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                                <button type="submit"
                                        class="rams-btn rams-btn--ghost rams-btn--sm rams-text-danger" title="{{ 'common.remove'|trans }}">
                                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                </button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('app_compliance_upload', {id: document.id}) }}" enctype="multipart/form-data" class="rams-inline-block">
                                <input type="file" name="file" class="rams-sr-only" id="file-{{ document.id }}" onchange="this.form.submit()">
                                <label for="file-{{ document.id }}" class="rams-btn rams-btn--primary rams-btn--sm" style="cursor:pointer">
                                    {{ 'common.upload'|trans }}
                                </label>
                            </form>
                        {% endif %}

                        <form method="post" action="{{ path('app_compliance_toggle_required', {id: document.id}) }}" class="rams-inline-block">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ document.id) }}">
                            <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm" 
                                    title="{{ document.required ? 'compliance.mark_optional'|trans|default('Mark as Optional') : 'compliance.mark_required'|trans|default('Mark as Required') }}">
                                {% if document.required %}
                                    <svg class="rams-btn__icon rams-text-success" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                                    </svg>
                                {% else %}
                                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                {% endif %}
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
