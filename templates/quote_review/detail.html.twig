{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.review.review_quote'|trans }} {{ quote.quoteNumber }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Confidence Badge Variants - Sensei-Rams BEM Naming */
    .rams-confidence--high { background-color: var(--rams-success-bg); rams-border-color: var(--rams-green); }
    .rams-confidence--medium { background-color: var(--rams-warning-bg); rams-border-color: var(--rams-orange); }
    .rams-confidence--low { background-color: var(--rams-warning-bg); rams-border-color: var(--rams-orange); }
    .rams-confidence--very-low { background-color: var(--rams-danger-bg); rams-border-color: var(--rams-red); }
    
    /* Row State Modifiers */
    .rams-line--verified { opacity: 0.7; }
    .rams-line--needs-review { background-color: var(--rams-warning-bg); }
    
    /* Lifecycle Indicators */
    .rams-lifecycle--critical { background-color: var(--rams-danger-bg); rams-border-left: 4px solid var(--rams-red); }
    .rams-lifecycle--warning { background-color: var(--rams-warning-bg); rams-border-left: 4px solid var(--rams-orange); }
    .rams-lifecycle-badge--critical {
        background-color: var(--rams-red);
        color: white;
        padding: 2px 6px;
        rams-border-radius: var(--radius-sm);
        font-size: 10px;
        font-weight: bold;
        animation: rams-pulse 2s infinite;
    }
    .rams-lifecycle-badge--warning {
        background-color: var(--rams-orange);
        color: white;
        padding: 2px 6px;
        rams-border-radius: var(--radius-sm);
        font-size: 10px;
        font-weight: bold;
    }
    @keyframes rams-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
    
    .rams-alternatives-dropdown { position: relative; display: inline-block; }
    .rams-alternatives-menu {
        display: none;
        position: absolute;
        left: 0;
        top: 100%;
        z-index: 100;
        min-width: 350px;
        background: var(--rams-panel);
        rams-border: 1px solid var(--rams-line);
        rams-border-radius: var(--radius-md);
        box-shadow: var(--shadow-inset);
        padding: 8px 0;
    }
    .rams-alternatives-dropdown:hover .rams-alternatives-menu { display: block; }
    .alt-item {
        padding: 8px 12px;
        rams-border-bottom: 1px solid var(--rams-border-light, #f3f4f6);
        cursor: pointer;
        transition: background-color 0.15s;
    }
    .alt-item:hover { background-color: var(--rams-bg-secondary, #f9fafb); }
    .alt-item:last-child { rams-border-bottom: none; }
    
    .diff-match { color: var(--rams-success); font-weight: 500; }
    .diff-insert { color: var(--rams-danger); background-color: var(--rams-danger-bg); padding: 0 2px; rams-border-radius: 2px; font-weight: 600; }
    .diff-delete { color: var(--rams-danger); text-decoration: line-through; opacity: 0.7; }
    .diff-container { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.5px; }
</style>
{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <nav class="rams-breadcrumb rams-mb-2">
                <ol class="rams-breadcrumb__list">
                    <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item"><a href="{{ path('quote_review_index') }}" class="rams-breadcrumb__link">{{ 'nav.quote_review'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ quote.quoteNumber }}</li>
                </ol>
            </nav>
            <h1 class="rams-page-title">{{ 'quote.review.review'|trans }}: {{ quote.quoteNumber }}</h1>
            <p class="rams-page-subtitle">{{ quote.company.name ?: 'common.n_a'|trans }} · {{ quote.createdAt|date('M j, Y g:i A') }}</p>
        </div>
        <div class="rams-page-actions">
            <div class="rams-btn-group">
                <a href="{{ path('export_quote_bom', {id: quote.id}) }}" class="rams-btn">
                    <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M8 12V2M4 6L8 2L12 6"/>
                    </svg>
                    {{ 'common.export_csv'|trans }}
                </a>
                <button id="verify-all-high-btn" class="rams-btn">
                    {{ 'quote.review.verify_all_high'|trans }}
                </button>
                <button id="approve-quote-btn" class="rams-btn--primary"
                    {% if not stats.ready_for_approval %}disabled{% endif %}>
                    <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 8L6 11L13 4"/>
                    </svg>
                    {{ 'quote.review.approve'|trans }}
                </button>
            </div>
        </div>
    </div>

    {# Stats Cards #}
    <div class="rams-grid rams-grid--4 rams-gap-4">
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'quote.review.total_lines'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg">{{ stats.total_lines }}</span>
                </div>
                <div class="rams-metric rams-text--right">
                    <span class="rams-metric__label">{{ 'quote.review.verified'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg rams-text--success">{{ stats.verified_count }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'quote.review.needs_review'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg rams-text--danger">{{ stats.requires_review_count }}</span>
                </div>
                <div class="rams-metric rams-text--right">
                    <span class="rams-metric__label">{{ 'quote.review.no_price'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg rams-text--warning">{{ stats.no_price_count }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'quote.review.sourced_value'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg">{{ stats.sourced_value|format_currency(quote.currency, null, 2) }}</span>
                </div>
                <div class="rams-metric rams-text--right">
                    <span class="rams-metric__label">{{ 'quote.review.progress'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg rams-text--info">{{ stats.verification_percent }}%</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'quote.review.obsolete_eol'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg rams-text--danger">{{ stats.lifecycle_critical|default(0) }}</span>
                </div>
                <div class="rams-metric rams-text--right">
                    <span class="rams-metric__label">{{ 'quote.review.nrnd_parts'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg rams-text--warning">{{ stats.lifecycle_warning|default(0) }}</span>
                </div>
            </div>
        </div>
    </div>

    {# Confidence Legend #}
    <div class="rams-module">
        <div class="rams-module__content">
            <div class="rams-flex rams-flex-wrap rams-items-center rams-gap-4">
                <span class="rams-text--xs rams-text--bold uppercase rams-font-mono">{{ 'quote.review.confidence_levels'|trans }}:</span>
                <span class="rams-badge rams-confidence--high">{{ 'quote.review.high'|trans }} (90-100)</span>
                <span class="rams-badge rams-confidence--medium">{{ 'quote.review.medium'|trans }} (70-89)</span>
                <span class="rams-badge rams-confidence--low">{{ 'quote.review.low'|trans }} (50-69)</span>
                <span class="rams-badge rams-confidence--very-low">{{ 'quote.review.very_low'|trans }} (&lt;50)</span>
            </div>
        </div>
    </div>

    {# BOM Lines Table #}
    <div class="rams-module">
        <div class="rams-module__content rams-module__content--flush">
            <div class="rams-table-container">
                <table class="rams-table" id="bom-lines-table">
                    <thead class="rams-table__header">
                        <tr>
                            <th class="rams-table__cell rams-table__cell--header">#</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.review.mpn'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.review.matched'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.review.manufacturer'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'common.description'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--right">{{ 'common.quantity'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--right">{{ 'quote.live.unit_price'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--right">{{ 'quote.review.extended'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--center">{{ 'quote.review.confidence'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--center">{{ 'common.status'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="rams-table__body">
                        {% for line in bomLines %}
                            <tr id="line-{{ line.id }}" class="rams-table__row 
                                {% if line.lifecycleWarning == 'critical' %}rams-lifecycle--critical{% elseif line.lifecycleWarning == 'warning' %}rams-lifecycle--warning{% endif %}
                                {% if line.requiresReview and not line.manuallyVerified %}rams-line--needs-review{% endif %}
                                {% if line.manuallyVerified %}rams-line--verified{% endif %}">
                                <td class="rams-table__cell rams-text--muted rams-text--xs rams-font-mono">{{ line.lineNumber }}</td>
                                <td class="rams-table__cell">
                                    <div class="rams-stack rams-gap-1">
                                        <span class="rams-text--bold">
                                            {% if line.distributorSearchUrl %}
                                                <a href="{{ line.distributorSearchUrl }}" target="_blank" class="rams-link rams-text--xs" title="{{ 'quote.review.search_distributor'|trans }}">
                                                    {{ line.mpn ?: 'common.n_a'|trans }} ↗
                                                </a>
                                            {% else %}
                                                {{ line.mpn ?: 'common.n_a'|trans }}
                                            {% endif %}
                                        </span>
                                        {% if line.originalMpn and line.originalMpn != line.mpn %}
                                            <span class="rams-text--3xs rams-text--muted rams-font-mono uppercase">{{ 'quote.review.original'|trans }}: {{ line.originalMpn }}</span>
                                        {% endif %}
                                        <div class="rams-flex rams-gap-1">
                                            {% if line.lifecycleWarning == 'critical' %}
                                                <span class="rams-lifecycle-badge--critical" title="{{ 'quote.review.part_obsolete'|trans }}">⚠ {{ 'quote.review.obsolete'|trans }}</span>
                                            {% elseif line.lifecycleWarning == 'warning' %}
                                                <span class="rams-lifecycle-badge--warning" title="{{ 'quote.review.nrnd'|trans }}">{{ 'quote.review.nrnd_short'|trans }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td class="rams-table__cell">
                                    {% if line.matchedMpn %}
                                        {% if line.matchedMpn != line.mpn and line.confidenceLevel == 'MEDIUM' %}
                                            <div class="diff-container" data-original="{{ line.mpn|e('html_attr') }}" data-matched="{{ line.matchedMpn|e('html_attr') }}">
                                                <span class="diff-view rams-text--warning rams-text--xs rams-font-mono"></span>
                                            </div>
                                        {% else %}
                                            <span class="rams-text--xs rams-font-mono {% if line.matchedMpn != line.mpn %}rams-text--warning{% else %}rams-text--success{% endif %}">
                                                {{ line.matchedMpn }}
                                            </span>
                                        {% endif %}
                                        
                                        {% if line.alternativeParts|default([])|length > 0 %}
                                            <div class="rams-alternatives-dropdown rams-mt-1">
                                                <span class="rams-text--3xs rams-font-mono uppercase rams-link rams-text--muted" style="cursor:pointer">
                                                    +{{ line.alternativeParts|length }} {{ 'quote.review.alternatives'|trans }} ▾
                                                </span>
                                                <div class="rams-alternatives-menu">
                                                    <div class="rams-px-3 rams-py-2 rams-border-b rams-bg-panel">
                                                        <span class="rams-text--2xs rams-text--bold uppercase rams-font-mono rams-text--muted">{{ 'quote.review.alternative_parts'|trans }}</span>
                                                    </div>
                                                    {% for alt in line.alternativeParts %}
                                                        <div class="alt-item" onclick="selectAlternative({{ line.id }}, '{{ alt.mpn|e('js') }}', '{{ (alt.source ?? 'mouser')|e('js') }}')">
                                                            <div class="rams-flex rams-justify-between rams-items-center">
                                                                <div>
                                                                    <span class="rams-text--xs rams-text--bold rams-font-mono">{{ alt.mpn }}</span>
                                                                    <span class="rams-text--3xs rams-text--muted uppercase rams-block">{{ alt.manufacturer ?? '' }}</span>
                                                                </div>
                                                                <div class="rams-text--right">
                                                                    <span class="rams-text--xs rams-text--bold rams-font-mono">{{ alt.price|default(0)|format_currency(quote.currency, null, 4) }}</span>
                                                                    <span class="rams-text--3xs rams-text--muted rams-block">
                                                                        {% if alt.score is defined %}{{ alt.score }}%{% endif %}
                                                                        {% if alt.stock is defined %}· {{ alt.stock }} {{ 'quote.review.in_stock'|trans }}{% endif %}
                                                                    </span>
                                                                </div>
                                                            </div>
                                                            {% if alt.lifecycle_warning %}
                                                                <span class="rams-text--3xs rams-mt-1 rams-block {% if alt.lifecycle_warning == 'critical' %}rams-text--danger{% else %}rams-text--warning{% endif %} uppercase rams-font-mono">
                                                                    ⚠ {{ alt.lifecycle_status|default(alt.lifecycle_warning) }}
                                                                </span>
                                                            {% endif %}
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% else %}
                                        <span class="rams-text--muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-text--muted rams-text--xs">{{ line.manufacturer ?: 'common.n_a'|trans }}</td>
                                <td class="rams-table__cell rams-text--muted rams-text--xs" title="{{ line.description }}">
                                    {% set desc = line.description ?: 'common.n_a'|trans %}
                                    {{ desc|length > 40 ? desc|slice(0, 37) ~ '...' : desc }}
                                </td>
                                <td class="rams-table__cell rams-text--right rams-font-mono rams-text--xs">{{ line.quantity }}</td>
                                <td class="rams-table__cell rams-text--right rams-font-mono rams-text--xs">
                                    {% if line.manualUnitPrice %}
                                        <span class="rams-text--bold rams-text--info">{{ line.manualUnitPrice|format_currency(quote.currency, null, 4) }}</span>
                                        <span class="rams-text--3xs rams-text--muted uppercase rams-block">{{ 'quote.review.manual'|trans }}</span>
                                    {% elseif line.unitPrice %}
                                        <span>{{ line.unitPrice|format_currency(quote.currency, null, 4) }}</span>
                                        <span class="rams-text--3xs rams-text--muted uppercase rams-block">{{ line.procurementSource }}</span>
                                    {% else %}
                                        <span class="rams-text--danger rams-text--bold uppercase rams-text--xs">{{ 'quote.review.no_price'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-text--right rams-font-mono rams-text--xs rams-text--bold">
                                    {% set effectivePrice = line.effectiveExtendedPrice %}
                                    {% if effectivePrice is not null %}
                                        {{ effectivePrice|format_currency(quote.currency, null, 2) }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-text--center">
                                    {% set confLevel = line.confidenceLevel ?? 'VERY_LOW' %}
                                    <span class="rams-badge rams-confidence--{{ confLevel|lower|replace({'_': '-'}) }}" title="{{ line.confidenceReasons|default([])|join(', ') }}">
                                        {{ line.confidenceScore|default(0) }}%
                                    </span>
                                </td>
                                <td class="rams-table__cell rams-text--center">
                                    {% if line.manuallyVerified %}
                                        <div class="rams-andon">
                                            <span class="rams-andon__light rams-andon__light--green"></span>
                                            <span class="rams-andon__text rams-text--success">{{ 'quote.review.verified'|trans }}</span>
                                        </div>
                                    {% elseif line.requiresReview %}
                                        <div class="rams-andon">
                                            <span class="rams-andon__light rams-andon__light--yellow"></span>
                                            <span class="rams-andon__text rams-text--warning">{{ 'quote.review.needs_review'|trans }}</span>
                                        </div>
                                    {% else %}
                                        <span class="rams-badge rams-badge--ghost rams-text--3xs">{{ 'quote.review.auto_ok'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-table__cell--actions">
                                    <div class="rams-btn-group">
                                        {% if not line.manuallyVerified %}
                                            <button onclick="verifyLine({{ line.id }})" class="rams-btn--ghost rams-btn--sm rams-text--success" title="{{ 'quote.review.verify_match'|trans }}">✓</button>
                                        {% endif %}
                                        <button onclick="openOverrideModal({{ line.id }}, '{{ (line.mpn ?? '')|e('js') }}', {{ line.unitPrice ?? 0 }})" class="rams-btn--ghost rams-btn--sm" title="{{ 'quote.review.enter_manual_price'|trans }}">{{ quote.currency ?? display_currency() }}</button>
                                        <button onclick="repriceLine({{ line.id }})" class="rams-btn--ghost rams-btn--sm rams-text--warning" title="{{ 'quote.review.reprice'|trans }}">↻</button>
                                        {% if line.unitPrice and not line.manuallyVerified %}
                                            <button onclick="rejectLine({{ line.id }})" class="rams-btn--ghost rams-btn--sm rams-text--danger" title="{{ 'quote.review.reject_match'|trans }}">✗</button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# Price Override Modal #}
<div id="override-modal" class="rams-modal rams-modal--hidden">
    <div class="rams-modal__backdrop" onclick="closeOverrideModal()"></div>
    <div class="rams-modal__content">
        <div class="rams-modal__header">
            <h3 class="rams-heading rams-heading--3">{{ 'quote.review.manual_price_override'|trans }}</h3>
        </div>
        <div class="rams-modal__body">
            <form id="override-form">
                <input type="hidden" id="override-line-id">
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'quote.review.part_number'|trans }}</label>
                    <input type="text" id="override-mpn" class="rams-form__input rams-form__input--readonly" readonly>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'quote.review.unit_price'|trans }} ({{ quote.currency ?? display_currency() }}) *</label>
                    <input type="number" id="override-price" step="0.0001" min="0" required class="rams-form__input">
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">
                        {{ 'quote.review.price_source_url'|trans }}
                        <span class="rams-text--muted rams-text--normal">({{ 'quote.review.where_found'|trans }})</span>
                    </label>
                    <input type="url" id="override-source-url" placeholder="https://distributor.com/product/..." class="rams-form__input">
                    <span class="rams-form__hint">{{ 'quote.review.link_to_quote'|trans }}</span>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'common.notes'|trans }} ({{ 'common.optional'|trans|lower }})</label>
                    <textarea id="override-notes" rows="2" class="rams-form__textarea" placeholder="{{ 'quote.review.notes_placeholder'|trans }}"></textarea>
                </div>
            </form>
        </div>
        <div class="rams-modal__footer">
            <button type="button" onclick="closeOverrideModal()" class="rams-btn">{{ 'common.cancel'|trans }}</button>
            <button type="submit" form="override-form" class="rams-btn--primary">{{ 'quote.review.apply_override'|trans }}</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const quoteId = {{ quote.id }};

function computeCharDiff(original, matched) {
    if (!original || !matched) return matched || '';
    const origNorm = original.toUpperCase().replace(/[\s\-]/g, '');
    const matchNorm = matched.toUpperCase().replace(/[\s\-]/g, '');
    if (origNorm === matchNorm) return `<span class="diff-match">${matched}</span>`;
    
    let result = '', i = 0, j = 0;
    while (j < matched.length) {
        if (i < origNorm.length && origNorm[i] === matchNorm[j]) {
            result += `<span class="diff-match">${matched[j]}</span>`;
            i++; j++;
        } else {
            result += `<span class="diff-insert">${matched[j]}</span>`;
            j++;
        }
    }
    return result;
}

function initDiffViews() {
    document.querySelectorAll('.diff-view').forEach(el => {
        const container = el.closest('.diff-container');
        if (!container) return;
        el.innerHTML = computeCharDiff(container.dataset.original, container.dataset.matched);
    });
}

document.addEventListener('DOMContentLoaded', initDiffViews);

function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `rams-toast rams-toast--${type}`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}

async function verifyLine(lineId) {
    try {
        const response = await fetch(`/quote-review/line/${lineId}/verify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.part_verified'|trans }}');
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_verify'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

async function rejectLine(lineId) {
    const reason = prompt('{{ 'quote.review.reason_rejection'|trans }}');
    if (reason === null) return;
    
    try {
        const response = await fetch(`/quote-review/line/${lineId}/reject`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.match_rejected'|trans }}');
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_reject'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

async function repriceLine(lineId) {
    try {
        const response = await fetch(`/quote-review/line/${lineId}/reprice`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
            showToast(data.message);
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_reprice'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

function openOverrideModal(lineId, mpn, currentPrice) {
    document.getElementById('override-line-id').value = lineId;
    document.getElementById('override-mpn').value = mpn;
    document.getElementById('override-price').value = currentPrice || '';
    document.getElementById('override-notes').value = '';
    document.getElementById('override-source-url').value = '';
    document.getElementById('override-modal').classList.remove('rams-modal--hidden');
}

function closeOverrideModal() {
    document.getElementById('override-modal').classList.add('rams-modal--hidden');
}

document.getElementById('override-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const lineId = document.getElementById('override-line-id').value;
    const price = document.getElementById('override-price').value;
    const notes = document.getElementById('override-notes').value;
    const sourceUrl = document.getElementById('override-source-url').value;
    
    try {
        const response = await fetch(`/quote-review/line/${lineId}/override`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ unit_price: price, notes, source_url: sourceUrl })
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.price_override_applied'|trans }}');
            closeOverrideModal();
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_override'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
});

document.getElementById('verify-all-high-btn').addEventListener('click', async () => {
    ramsConfirm('{{ 'quote.review.confirm_verify_all'|trans }}', async function() {
        try {
            const response = await fetch(`/quote-review/${quoteId}/verify-all-high`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message);
                location.reload();
            } else {
                showToast(data.error || '{{ 'common.failed'|trans }}', 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
});

document.getElementById('approve-quote-btn').addEventListener('click', async () => {
    ramsConfirm('{{ 'quote.review.confirm_approve'|trans }}', async function() {
        try {
            const response = await fetch(`/quote-review/${quoteId}/approve`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message);
                if (data.redirect) window.location.href = data.redirect;
            } else {
                let msg = data.error;
                if (data.unverified_count) msg += ` (${data.unverified_count} {{ 'quote.review.unverified'|trans }})`;
                if (data.unpriced_count) msg += ` (${data.unpriced_count} {{ 'quote.review.unpriced'|trans }})`;
                showToast(msg, 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
});

async function selectAlternative(lineId, altMpn, source) {
    const message = `{{ 'quote.review.switch_alternative'|trans }}\n\n{{ 'quote.review.new_mpn'|trans }}: ${altMpn}\n{{ 'common.source'|trans }}: ${source}`;
    ramsConfirm(message, async function() {
        try {
            const response = await fetch(`/quote-review/line/${lineId}/select-alternative`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mpn: altMpn, source: source })
            });
            const data = await response.json();
            if (data.success) {
                showToast(`{{ 'quote.review.switched_to'|trans }} ${altMpn}`);
                location.reload();
            } else {
                showToast(data.error || '{{ 'quote.review.failed_select_alt'|trans }}', 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
}
</script>
{% endblock %}
