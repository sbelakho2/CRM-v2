{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.review.review_quote'|trans }} {{ quote.quoteNumber }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Confidence Badge Variants - Sensei-Rams BEM Naming */
    .rams-confidence--high { background-color: rgba(45, 140, 60, 0.1); border-color: var(--rams-green); color: var(--rams-green); }
    .rams-confidence--medium { background-color: rgba(255, 190, 0, 0.1); border-color: var(--rams-orange); color: var(--rams-orange); }
    .rams-confidence--low { background-color: rgba(255, 190, 0, 0.1); border-color: var(--rams-orange); color: var(--rams-orange); }
    .rams-confidence--very-low { background-color: rgba(214, 45, 45, 0.1); border-color: var(--rams-red); color: var(--rams-red); }
    
    /* Row State Modifiers */
    .rams-line--verified { opacity: 0.8; background-color: rgba(45, 140, 60, 0.03); }
    .rams-line--needs-review { background-color: rgba(255, 190, 0, 0.05); }
    
    /* Lifecycle Indicators */
    .rams-lifecycle--critical { border-left: 4px solid var(--rams-red) !important; }
    .rams-lifecycle--warning { border-left: 4px solid var(--rams-orange) !important; }
    .rams-lifecycle-badge--critical {
        background-color: var(--rams-red);
        color: white;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        font-size: 10px;
        font-weight: bold;
        animation: rams-pulse 2s infinite;
    }
    .rams-lifecycle-badge--warning {
        background-color: var(--rams-orange);
        color: white;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        font-size: 10px;
        font-weight: bold;
    }
    @keyframes rams-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
    
    .rams-alternatives-dropdown { position: relative; display: inline-block; }
    .rams-alternatives-menu {
        display: none;
        position: absolute;
        left: 0;
        top: 100%;
        z-index: 100;
        min-width: 350px;
        background: var(--rams-panel);
        border: 1px solid var(--rams-line);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-inset);
        padding: 8px 0;
    }
    .rams-alternatives-dropdown:hover .rams-alternatives-menu { display: block; }
    .rams-alt-item {
        padding: 8px 12px;
        border-bottom: 1px solid var(--rams-border-light, #f3f4f6);
        cursor: pointer;
        transition: background-color 0.15s;
    }
    .rams-alt-item:hover { background-color: var(--rams-bg-secondary, #f9fafb); }
    .rams-alt-item:last-child { border-bottom: none; }
    
    .rams-diff-match { color: var(--rams-success); font-weight: 500; }
    .rams-diff-insert { color: var(--rams-danger); background-color: var(--rams-danger-bg); padding: 0 2px; border-radius: 2px; font-weight: 600; }
    .rams-diff-delete { color: var(--rams-danger); text-decoration: line-through; opacity: 0.7; }
    .rams-diff-container { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.5px; }
</style>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <a href="{{ path('quote_review_index') }}">{{ 'nav.quote_review'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ quote.quoteNumber }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'quote.review.review'|trans }}: {{ quote.quoteNumber }}</h1>
            <p class="rams-page__subtitle">{{ company_name ?? ('common.n_a'|trans) }} · {{ quote.createdAt|date('M j, Y g:i A') }}</p>
        </div>
        <div class="rams-page__actions">
            <a href="{{ path('quote_copilot_pdf', {id: quote.id}) }}" class="rams-btn uppercase" title="{{ 'quote.copilot.download_pdf'|trans }}">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 12V2M4 6L8 2L12 6"/>
                </svg>
                PDF
            </a>
            <a href="{{ path('quote_copilot_full_excel', {id: quote.id}) }}" class="rams-btn uppercase" style="border-color: #FFBE00; color: #FFBE00;">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="10" height="10" rx="1"/>
                    <path d="M3 6H13M3 9H13M6 3V13M10 3V13"/>
                </svg>
                {{ 'quote.copilot.download_full_excel'|trans({}, 'messages')|default('Full Sourcing') }}
            </a>
            <a href="{{ path('export_quote_bom', {id: quote.id}) }}" class="rams-btn uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 12V2M4 6L8 2L12 6"/>
                </svg>
                {{ 'common.export_csv'|trans }}
            </a>
            <button id="verify-all-high-btn" class="rams-btn uppercase">
                {{ 'quote.review.verify_all_high'|trans }}
            </button>
            <button id="approve-quote-btn" class="rams-btn rams-btn--primary uppercase"
                {% if not stats.ready_for_approval %}disabled{% endif %}>
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 8L6 11L13 4"/>
                </svg>
                {{ 'quote.review.approve'|trans }}
            </button>
        </div>
    </div>

    {# Stats Cards #}
    <div class="rams-grid rams-grid--4 rams-mb-6">
        <div class="rams-module rams-p-4">
            <div class="rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <div class="rams-metric__label text-rams-muted">{{ 'quote.review.total_lines'|trans }}</div>
                    <div class="rams-metric__value tabular-nums">{{ stats.total_lines }}</div>
                </div>
                <div class="rams-metric rams-text--right">
                    <div class="rams-metric__label text-rams-muted">{{ 'quote.review.verified'|trans }}</div>
                    <div class="rams-metric__value tabular-nums text-rams-green">{{ stats.verified_count }}</div>
                </div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <div class="rams-metric__label text-rams-muted">{{ 'quote.review.needs_review'|trans }}</div>
                    <div class="rams-metric__value tabular-nums text-rams-red">{{ stats.requires_review_count }}</div>
                </div>
                <div class="rams-metric rams-text--right">
                    <div class="rams-metric__label text-rams-muted">{{ 'quote.review.no_price'|trans }}</div>
                    <div class="rams-metric__value tabular-nums text-rams-orange">{{ stats.no_price_count }}</div>
                </div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <div class="rams-metric__label text-rams-muted">{{ 'quote.review.sourced_value'|trans }}</div>
                    <div class="rams-metric__value tabular-nums text-base">{{ stats.sourced_value|format_currency(quote.currency, null, 2) }}</div>
                </div>
                <div class="rams-metric rams-text--right">
                    <div class="rams-metric__label text-rams-muted">{{ 'quote.review.progress'|trans }}</div>
                    <div class="rams-metric__value tabular-nums text-base text-rams-steel">{{ stats.verification_percent }}%</div>
                </div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <div class="rams-metric__label text-rams-muted">{{ 'quote.review.obsolete_eol'|trans }}</div>
                    <div class="rams-metric__value tabular-nums text-rams-red">{{ stats.lifecycle_critical|default(0) }}</div>
                </div>
                <div class="rams-metric rams-text--right">
                    <div class="rams-metric__label text-rams-muted">{{ 'quote.review.nrnd_parts'|trans }}</div>
                    <div class="rams-metric__value tabular-nums text-rams-orange">{{ stats.lifecycle_warning|default(0) }}</div>
                </div>
            </div>
        </div>
    </div>

    {# Confidence Legend #}
    <div class="rams-module rams-mb-6">
        <div class="rams-module__content">
            <div class="rams-flex rams-flex-wrap rams-items-center rams-gap-4">
                <span class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.review.confidence_levels'|trans }}:</span>
                <span class="rams-badge rams-confidence--high uppercase">{{ 'quote.review.high'|trans }} (90-100)</span>
                <span class="rams-badge rams-confidence--medium uppercase">{{ 'quote.review.medium'|trans }} (70-89)</span>
                <span class="rams-badge rams-confidence--low uppercase">{{ 'quote.review.low'|trans }} (50-69)</span>
                <span class="rams-badge rams-confidence--very-low uppercase">{{ 'quote.review.very_low'|trans }} (&lt;50)</span>
            </div>
        </div>
    </div>

    {# BOM Lines Table #}
    <div class="rams-module">
        <div class="rams-table-container">
            <table class="rams-table" id="bom-lines-table">
                <thead>
                    <tr>
                        <th class="font-mono text-2xs uppercase tracking-widest">#</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'quote.review.mpn'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'quote.review.matched'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'quote.review.manufacturer'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'common.description'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest rams-text--right">{{ 'common.quantity'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest rams-text--right">{{ 'quote.live.unit_price'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest rams-text--right">{{ 'quote.review.extended'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest rams-text--center">{{ 'quote.review.confidence'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest rams-text--center">{{ 'common.status'|trans }}</th>
                        <th class="font-mono text-2xs uppercase tracking-widest">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in bomLines %}
                        <tr id="line-{{ line.id }}" class="
                            {% if line.lifecycleWarning == 'critical' %}rams-lifecycle--critical{% elseif line.lifecycleWarning == 'warning' %}rams-lifecycle--warning{% endif %}
                            {% if line.requiresReview and not line.manuallyVerified %}rams-line--needs-review{% endif %}
                            {% if line.manuallyVerified %}rams-line--verified{% endif %}">
                            <td class="tabular-nums text-xs text-rams-muted font-mono">{{ line.lineNumber }}</td>
                            <td>
                                <div class="rams-flex rams-flex-col rams-gap-1">
                                    {% if line.distributorSearchUrl %}
                                        <a href="{{ line.distributorSearchUrl }}" target="_blank" class="rams-link text-xs uppercase font-mono" title="{{ 'quote.review.search_distributor'|trans }}">
                                            {{ line.mpn ?: 'common.n_a'|trans }} ↗
                                        </a>
                                    {% else %}
                                        <span class="font-mono text-xs uppercase">{{ line.mpn ?: 'common.n_a'|trans }}</span>
                                    {% endif %}
                                    {% if line.originalMpn and line.originalMpn != line.mpn %}
                                        <div class="font-mono text-3xs uppercase text-rams-muted">{{ 'quote.review.original'|trans }}: {{ line.originalMpn }}</div>
                                    {% endif %}
                                    <div class="rams-flex rams-gap-1">
                                        {% if line.lifecycleWarning == 'critical' %}
                                            <span class="rams-lifecycle-badge--critical" title="{{ 'quote.review.part_obsolete'|trans }}">⚠ {{ 'quote.review.obsolete'|trans }}</span>
                                        {% elseif line.lifecycleWarning == 'warning' %}
                                            <span class="rams-lifecycle-badge--warning" title="{{ 'quote.review.nrnd'|trans }}">{{ 'quote.review.nrnd_short'|trans }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if line.matchedMpn %}
                                    {% if line.matchedMpn != line.mpn and line.confidenceLevel == 'MEDIUM' %}
                                        <div class="rams-diff-container" data-original="{{ line.mpn|e('html_attr') }}" data-matched="{{ line.matchedMpn|e('html_attr') }}">
                                            <span class="diff-view font-mono text-xs text-rams-orange"></span>
                                        </div>
                                    {% else %}
                                        <div class="font-mono text-xs {% if line.matchedMpn != line.mpn %}text-rams-orange{% else %}text-rams-green{% endif %}">
                                            {{ line.matchedMpn }}
                                        </div>
                                    {% endif %}
                                    
                                    {% if line.alternativeParts|default([])|length > 0 %}
                                        <div class="rams-alternatives-dropdown rams-mt-1">
                                            <span class="font-mono text-3xs uppercase rams-link text-rams-muted" >
                                                +{{ line.alternativeParts|length }} {{ 'quote.review.alternatives'|trans }} ▾
                                            </span>
                                            <div class="rams-alternatives-menu">
                                                <div class="rams-px-3 rams-py-2 rams-border-b border-rams-line rams-bg-panel">
                                                    <span class="font-mono text-2xs font-bold uppercase text-rams-muted">{{ 'quote.review.alternative_parts'|trans }}</span>
                                                </div>
                                                {% for alt in line.alternativeParts %}
                                                    <div class="rams-alt-item" onclick="selectAlternative({{ line.id }}, '{{ alt.mpn|e('js') }}', '{{ (alt.source ?? 'mouser')|e('js') }}')">
                                                        <div class="rams-flex rams-justify-between rams-items-center">
                                                            <div>
                                                                <span class="font-mono text-xs font-bold">{{ alt.mpn }}</span>
                                                                <span class="text-3xs uppercase text-rams-muted rams-block">{{ alt.manufacturer ?? '' }}</span>
                                                            </div>
                                                            <div class="rams-text--right">
                                                                <span class="font-mono text-xs font-bold">{{ alt.price|default(0)|format_currency(quote.currency, null, 4) }}</span>
                                                                <span class="text-3xs text-rams-muted rams-block">
                                                                    {% if alt.score is defined %}{{ alt.score }}%{% endif %}
                                                                    {% if alt.stock is defined %}· {{ alt.stock }} {{ 'quote.review.in_stock'|trans }}{% endif %}
                                                                </span>
                                                            </div>
                                                        </div>
                                                        {% if alt.lifecycle_warning %}
                                                            <span class="text-3xs rams-mt-1 rams-block {% if alt.lifecycle_warning == 'critical' %}text-rams-red{% else %}text-rams-orange{% endif %} uppercase font-mono">
                                                                ⚠ {{ alt.lifecycle_status|default(alt.lifecycle_warning) }}
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <span class="rams-text--muted">—</span>
                                {% endif %}
                            </td>
                            <td class="text-xs text-rams-muted">{{ line.manufacturer ?: 'common.n_a'|trans }}</td>
                            <td class="text-xs text-rams-muted" title="{{ line.description }}">
                                {% set desc = line.description ?: 'common.n_a'|trans %}
                                {{ desc|length > 40 ? desc|slice(0, 37) ~ '...' : desc }}
                            </td>
                            <td class="rams-text--right tabular-nums font-mono text-xs">{{ line.quantity }}</td>
                            <td class="rams-text--right tabular-nums font-mono text-xs">
                                {% if line.manualUnitPrice %}
                                    <div class="font-bold text-rams-steel">{{ line.manualUnitPrice|format_currency(quote.currency, null, 4) }}</div>
                                    <div class="text-3xs uppercase text-rams-muted">{{ 'quote.review.manual'|trans }}</div>
                                {% elseif line.unitPrice %}
                                    <div>{{ line.unitPrice|format_currency(quote.currency, null, 4) }}</div>
                                    <div class="text-3xs uppercase text-rams-muted">{{ line.procurementSource }}</div>
                                {% else %}
                                    <div class="font-bold uppercase text-xs text-rams-red">{{ 'quote.review.no_price'|trans }}</div>
                                {% endif %}
                            </td>
                            <td class="rams-text--right tabular-nums font-mono text-xs font-bold">
                                {% set effectivePrice = line.effectiveExtendedPrice %}
                                {% if effectivePrice is not null %}
                                    {{ effectivePrice|format_currency(quote.currency, null, 2) }}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="rams-text--center">
                                {% set confLevel = line.confidenceLevel ?? 'VERY_LOW' %}
                                <span class="rams-badge rams-confidence--{{ confLevel|lower|replace({'_': '-'}) }} uppercase" title="{{ line.confidenceReasons|default([])|join(', ') }}">
                                    {{ line.confidenceScore|default(0) }}%
                                </span>
                            </td>
                            <td class="rams-text--center">
                                {% if line.manuallyVerified %}
                                    <div class="rams-flex rams-items-center rams-justify-center rams-gap-2">
                                        <div class="w-2 h-2 rounded-full bg-rams-green"></div>
                                        <span class="font-mono text-3xs uppercase text-rams-green">{{ 'quote.review.verified'|trans }}</span>
                                    </div>
                                {% elseif line.requiresReview %}
                                    <div class="rams-flex rams-items-center rams-justify-center rams-gap-2">
                                        <div class="w-2 h-2 rounded-full bg-rams-orange"></div>
                                        <span class="font-mono text-3xs uppercase text-rams-orange">{{ 'quote.review.needs_review'|trans }}</span>
                                    </div>
                                {% else %}
                                    <span class="rams-badge rams-badge--ghost uppercase text-3xs">{{ 'quote.review.auto_ok'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="rams-actions rams-actions--sm">
                                    {% if not line.manuallyVerified %}
                                        <button onclick="verifyLine({{ line.id }})" class="rams-btn rams-btn--ghost text-rams-green uppercase" title="{{ 'quote.review.verify_match'|trans }}">
                                            <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M3 8L6 11L13 4"/>
                                            </svg>
                                        </button>
                                    {% endif %}
                                    <button onclick="openOverrideModal({{ line.id }}, '{{ (line.mpn ?? '')|e('js') }}', {{ line.unitPrice ?? 0 }})" class="rams-btn rams-btn--ghost uppercase" title="{{ 'quote.review.enter_manual_price'|trans }}">
                                        <span class="font-mono text-2xs">{{ quote.currency ?? display_currency() }}</span>
                                    </button>
                                    <button onclick="repriceLine({{ line.id }})" class="rams-btn rams-btn--ghost text-rams-orange uppercase" title="{{ 'quote.review.reprice'|trans }}">
                                        <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 8a7 7 0 0111.95-5M15 8a7 7 0 01-11.95 5"/>
                                            <path d="M15 1v7h-7M1 15v-7h7"/>
                                        </svg>
                                    </button>
                                    {% if line.unitPrice and not line.manuallyVerified %}
                                        <button onclick="rejectLine({{ line.id }})" class="rams-btn rams-btn--ghost text-rams-red uppercase" title="{{ 'quote.review.reject_match'|trans }}">
                                            <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M4 4l8 8M12 4l-8 8"/>
                                            </svg>
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# Price Override Modal #}
<div id="override-modal" class="rams-modal rams-modal--hidden">
    <div class="rams-modal__backdrop" onclick="closeOverrideModal()"></div>
    <div class="rams-modal__content">
        <div class="rams-modal__header">
            <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.review.manual_price_override'|trans }}</h3>
        </div>
        <div class="rams-modal__body">
            <form id="override-form" class="rams-form">
                <input type="hidden" id="override-line-id">
                <div class="rams-form__group">
                    <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.review.part_number'|trans }}</label>
                    <input type="text" id="override-mpn" class="rams-form__input" readonly>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.review.unit_price'|trans }} ({{ quote.currency ?? display_currency() }}) *</label>
                    <input type="number" id="override-price" step="0.0001" min="0" required class="rams-form__input">
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">
                        {{ 'quote.review.price_source_url'|trans }}
                    </label>
                    <input type="url" id="override-source-url" placeholder="https://distributor.com/product/..." class="rams-form__input">
                    <div class="text-3xs text-rams-muted rams-mt-1">{{ 'quote.review.link_to_quote'|trans }}</div>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'common.notes'|trans }}</label>
                    <textarea id="override-notes" rows="2" class="rams-form__input" placeholder="{{ 'quote.review.notes_placeholder'|trans }}"></textarea>
                </div>
            </form>
        </div>
        <div class="rams-modal__footer rams-flex rams-justify-end rams-gap-2">
            <button type="button" onclick="closeOverrideModal()" class="rams-btn uppercase">{{ 'common.cancel'|trans }}</button>
            <button type="submit" form="override-form" class="rams-btn rams-btn--primary uppercase">{{ 'quote.review.apply_override'|trans }}</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const quoteId = {{ quote.id }};

function computeCharDiff(original, matched) {
    if (!original || !matched) return matched || '';
    const origNorm = original.toUpperCase().replace(/[\s\-]/g, '');
    const matchNorm = matched.toUpperCase().replace(/[\s\-]/g, '');
    if (origNorm === matchNorm) return `<span class="rams-diff-match">${matched}</span>`;
    
    let result = '', i = 0, j = 0;
    while (j < matched.length) {
        if (i < origNorm.length && origNorm[i] === matchNorm[j]) {
            result += `<span class="rams-diff-match">${matched[j]}</span>`;
            i++; j++;
        } else {
            result += `<span class="rams-diff-insert">${matched[j]}</span>`;
            j++;
        }
    }
    return result;
}

function initDiffViews() {
    document.querySelectorAll('.diff-view').forEach(el => {
        const container = el.closest('.rams-diff-container');
        if (!container) return;
        el.innerHTML = computeCharDiff(container.dataset.original, container.dataset.matched);
    });
}

document.addEventListener('DOMContentLoaded', initDiffViews);

function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `rams-toast rams-toast--${type}`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}

async function verifyLine(lineId) {
    try {
        const response = await fetch(`/quote-review/line/${lineId}/verify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.part_verified'|trans }}');
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_verify'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

async function rejectLine(lineId) {
    const reason = prompt('{{ 'quote.review.reason_rejection'|trans }}');
    if (reason === null) return;
    
    try {
        const response = await fetch(`/quote-review/line/${lineId}/reject`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.match_rejected'|trans }}');
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_reject'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

async function repriceLine(lineId) {
    try {
        const response = await fetch(`/quote-review/line/${lineId}/reprice`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
            showToast(data.message);
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_reprice'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

function openOverrideModal(lineId, mpn, currentPrice) {
    document.getElementById('override-line-id').value = lineId;
    document.getElementById('override-mpn').value = mpn;
    document.getElementById('override-price').value = currentPrice || '';
    document.getElementById('override-notes').value = '';
    document.getElementById('override-source-url').value = '';
    document.getElementById('override-modal').classList.remove('rams-modal--hidden');
}

function closeOverrideModal() {
    document.getElementById('override-modal').classList.add('rams-modal--hidden');
}

document.getElementById('override-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const lineId = document.getElementById('override-line-id').value;
    const price = document.getElementById('override-price').value;
    const notes = document.getElementById('override-notes').value;
    const sourceUrl = document.getElementById('override-source-url').value;
    
    try {
        const response = await fetch(`/quote-review/line/${lineId}/override`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ unit_price: price, notes, source_url: sourceUrl })
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.price_override_applied'|trans }}');
            closeOverrideModal();
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_override'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
});

document.getElementById('verify-all-high-btn').addEventListener('click', async () => {
    ramsConfirm('{{ 'quote.review.confirm_verify_all'|trans }}', async function() {
        try {
            const response = await fetch(`/quote-review/${quoteId}/verify-all-high`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message);
                location.reload();
            } else {
                showToast(data.error || '{{ 'common.failed'|trans }}', 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
});

document.getElementById('approve-quote-btn').addEventListener('click', async () => {
    ramsConfirm('{{ 'quote.review.confirm_approve'|trans }}', async function() {
        try {
            const response = await fetch(`/quote-review/${quoteId}/approve`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message);
                if (data.redirect) window.location.href = data.redirect;
            } else {
                let msg = data.error;
                if (data.unverified_count) msg += ` (${data.unverified_count} {{ 'quote.review.unverified'|trans }})`;
                if (data.unpriced_count) msg += ` (${data.unpriced_count} {{ 'quote.review.unpriced'|trans }})`;
                showToast(msg, 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
});

async function selectAlternative(lineId, altMpn, source) {
    const message = `{{ 'quote.review.switch_alternative'|trans }}\n\n{{ 'quote.review.new_mpn'|trans }}: ${altMpn}\n{{ 'common.source'|trans }}: ${source}`;
    ramsConfirm(message, async function() {
        try {
            const response = await fetch(`/quote-review/line/${lineId}/select-alternative`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mpn: altMpn, source: source })
            });
            const data = await response.json();
            if (data.success) {
                showToast(`{{ 'quote.review.switched_to'|trans }} ${altMpn}`);
                location.reload();
            } else {
                showToast(data.error || '{{ 'quote.review.failed_select_alt'|trans }}', 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
}
</script>
{% endblock %}
