{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.review.review_quote'|trans|default('Review Quote') }} {{ quote.quoteNumber }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Confidence Badge Variants - Sensei-Rams BEM Naming */
    .rams-confidence--high { background-color: var(--rams-success-bg); border-color: var(--rams-green); }
    .rams-confidence--medium { background-color: var(--rams-warning-bg); border-color: var(--rams-orange); }
    .rams-confidence--low { background-color: var(--rams-warning-bg); border-color: var(--rams-orange); }
    .rams-confidence--very-low { background-color: var(--rams-danger-bg); border-color: var(--rams-red); }
    
    /* Row State Modifiers */
    .rams-line--verified { opacity: 0.7; }
    .rams-line--needs-review { background-color: var(--rams-warning-bg); }
    
    /* Lifecycle Indicators */
    .rams-lifecycle--critical { background-color: var(--rams-danger-bg); border-left: 4px solid var(--rams-red); }
    .rams-lifecycle--warning { background-color: var(--rams-warning-bg); border-left: 4px solid var(--rams-orange); }
    .rams-lifecycle-badge--critical {
        background-color: var(--rams-red);
        color: white;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        font-size: 10px;
        font-weight: bold;
        animation: rams-pulse 2s infinite;
    }
    .rams-lifecycle-badge--warning {
        background-color: var(--rams-orange);
        color: white;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        font-size: 10px;
        font-weight: bold;
    }
    @keyframes rams-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
    
    .rams-alternatives-dropdown { position: relative; display: inline-block; }
    .rams-alternatives-menu {
        display: none;
        position: absolute;
        left: 0;
        top: 100%;
        z-index: 100;
        min-width: 350px;
        background: var(--rams-panel);
        border: 1px solid var(--rams-line);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-inset);
        padding: 8px 0;
    }
    .rams-alternatives-dropdown:hover .rams-alternatives-menu { display: block; }
    .alt-item {
        padding: 8px 12px;
        border-bottom: 1px solid var(--rams-border-light, #f3f4f6);
        cursor: pointer;
        transition: background-color 0.15s;
    }
    .alt-item:hover { background-color: var(--rams-bg-secondary, #f9fafb); }
    .alt-item:last-child { border-bottom: none; }
    
    .diff-match { color: var(--rams-success); font-weight: 500; }
    .diff-insert { color: var(--rams-danger); background-color: var(--rams-danger-bg); padding: 0 2px; border-radius: 2px; font-weight: 600; }
    .diff-delete { color: var(--rams-danger); text-decoration: line-through; opacity: 0.7; }
    .diff-container { font-family: 'Courier New', Courier, monospace; font-size: 13px; letter-spacing: 0.5px; }
</style>
{% endblock %}

{% block body %}
<div class="rams-stack rams-stack--lg">
    {# Header #}
    <div class="rams-page-header">
        <div class="rams-page-header__nav">
            <a href="{{ path('quote_review_index') }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                ← {{ 'quote.review.back_to_queue'|trans|default('Back to Queue') }}
            </a>
        </div>
        <div class="rams-page-header__row">
            <div>
                <h1 class="rams-heading rams-heading--1">{{ 'quote.review.review'|trans|default('Review') }}: {{ quote.quoteNumber }}</h1>
                <p class="rams-text rams-text--muted">{{ quote.company.name|default('No company') }} • {{ quote.createdAt|date('M j, Y g:i A') }}</p>
            </div>
            <div class="rams-btn-group">
                <a href="{{ path('export_quote_bom', {id: quote.id}) }}" class="rams-btn rams-btn--secondary">
                    📥 {{ 'common.export_csv'|trans|default('Export CSV') }}
                </a>
                <button id="verify-all-high-btn" class="rams-btn rams-btn--secondary">
                    ✓ {{ 'quote.review.verify_all_high'|trans|default('Verify All High Confidence') }}
                </button>
                <button id="approve-quote-btn" class="rams-btn rams-btn--primary"
                    {% if not stats.ready_for_approval %}disabled{% endif %}>
                    {{ 'quote.review.approve'|trans|default('Approve Quote') }}
                </button>
            </div>
        </div>
    </div>

    {# Stats Cards #}
    <div class="rams-grid rams-grid--cols-8 rams-grid--gap-sm">
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <span class="rams-dymo">{{ 'quote.review.total_lines'|trans|default('Total Lines') }}</span>
                <p class="rams-metric rams-metric--md">{{ stats.total_lines }}</p>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <span class="rams-dymo">{{ 'quote.review.verified'|trans|default('Verified') }}</span>
                <p class="rams-metric rams-metric--md rams-text--success">{{ stats.verified_count }}</p>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <span class="rams-dymo">{{ 'quote.review.needs_review'|trans|default('Needs Review') }}</span>
                <p class="rams-metric rams-metric--md rams-text--danger">{{ stats.requires_review_count }}</p>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <span class="rams-dymo">{{ 'quote.review.no_price'|trans|default('No Price') }}</span>
                <p class="rams-metric rams-metric--md rams-text--warning">{{ stats.no_price_count }}</p>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <span class="rams-dymo">{{ 'quote.review.sourced_value'|trans|default('Sourced Value') }}</span>
                <p class="rams-metric rams-metric--md">${{ stats.sourced_value|number_format(2) }}</p>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <span class="rams-dymo">{{ 'quote.review.progress'|trans|default('Progress') }}</span>
                <p class="rams-metric rams-metric--md">{{ stats.verification_percent }}%</p>
            </div>
        </div>
        <div class="rams-module rams-module--compact {% if stats.lifecycle_critical|default(0) > 0 %}rams-module--danger{% endif %}">
            <div class="rams-module__content rams-text--center">
                <span class="rams-dymo">{{ 'quote.review.obsolete_eol'|trans|default('Obsolete/EOL') }}</span>
                <p class="rams-metric rams-metric--md rams-text--danger">{{ stats.lifecycle_critical|default(0) }}</p>
            </div>
        </div>
        <div class="rams-module rams-module--compact {% if stats.lifecycle_warning|default(0) > 0 %}rams-module--warning{% endif %}">
            <div class="rams-module__content rams-text--center">
                <span class="rams-dymo">{{ 'quote.review.nrnd_parts'|trans|default('NRND Parts') }}</span>
                <p class="rams-metric rams-metric--md rams-text--warning">{{ stats.lifecycle_warning|default(0) }}</p>
            </div>
        </div>
    </div>

    {# Confidence Legend #}
    <div class="rams-module rams-module--compact rams-module--muted">
        <div class="rams-module__content">
            <div class="rams-inline-list rams-inline-list--gap-md">
                <span class="rams-text rams-text--bold">{{ 'quote.review.confidence_levels'|trans|default('Confidence Levels') }}:</span>
                <span class="rams-badge rams-confidence--high">{{ 'quote.review.high'|trans|default('HIGH') }} (90-100)</span>
                <span class="rams-badge rams-confidence--medium">{{ 'quote.review.medium'|trans|default('MEDIUM') }} (70-89)</span>
                <span class="rams-badge rams-confidence--low">{{ 'quote.review.low'|trans|default('LOW') }} (50-69)</span>
                <span class="rams-badge rams-confidence--very-low">{{ 'quote.review.very_low'|trans|default('VERY LOW') }} (&lt;50)</span>
            </div>
        </div>
    </div>

    {# BOM Lines Table #}
    <div class="rams-module">
        <div class="rams-module__content rams-module__content--flush">
            <div class="rams-table-wrapper">
                <table class="rams-table" id="bom-lines-table">
                    <thead class="rams-table__header">
                        <tr>
                            <th class="rams-table__cell rams-table__cell--header">#</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.review.mpn'|trans|default('MPN') }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.review.matched'|trans|default('Matched') }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.review.manufacturer'|trans|default('Manufacturer') }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'common.description'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--right">{{ 'common.quantity'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--right">{{ 'quote.live.unit_price'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--right">{{ 'quote.review.extended'|trans|default('Extended') }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--center">{{ 'quote.review.confidence'|trans|default('Confidence') }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--center">{{ 'common.status'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--right">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in bomLines %}
                            <tr id="line-{{ line.id }}" class="rams-table__row 
                                {% if line.lifecycleWarning == 'critical' %}lifecycle-critical{% elseif line.lifecycleWarning == 'warning' %}lifecycle-warning{% endif %}
                                {% if line.requiresReview and not line.manuallyVerified %}line-needs-review{% endif %}
                                {% if line.manuallyVerified %}line-verified{% endif %}">
                                <td class="rams-table__cell rams-text--muted">{{ line.lineNumber }}</td>
                                <td class="rams-table__cell">
                                    <span class="rams-text rams-text--bold">
                                        {% if line.distributorSearchUrl %}
                                            <a href="{{ line.distributorSearchUrl }}" target="_blank" class="rams-link" title="{{ 'quote.review.search_distributor'|trans|default('Search on distributor site') }}">
                                                {{ line.mpn|default('—') }} ↗
                                            </a>
                                        {% else %}
                                            {{ line.mpn|default('—') }}
                                        {% endif %}
                                    </span>
                                    {% if line.originalMpn and line.originalMpn != line.mpn %}
                                        <span class="rams-text rams-text--xs rams-text--muted rams-block">{{ 'quote.review.original'|trans|default('Original') }}: {{ line.originalMpn }}</span>
                                    {% endif %}
                                    {% if line.lifecycleWarning == 'critical' %}
                                        <span class="rams-lifecycle-badge--critical" title="{{ 'quote.review.part_obsolete'|trans|default('Part is obsolete or end-of-life') }}">⚠ {{ 'quote.review.obsolete'|trans|default('OBSOLETE') }}</span>
                                    {% elseif line.lifecycleWarning == 'warning' %}
                                        <span class="rams-lifecycle-badge--warning" title="{{ 'quote.review.nrnd'|trans|default('Not Recommended for New Designs') }}">{{ 'quote.review.nrnd_short'|trans|default('NRND') }}</span>
                                    {% endif %}
                                    {% if line.lifecycleStatus %}
                                        <span class="rams-text rams-text--xs rams-text--muted rams-block">{{ 'common.status'|trans }}: {{ line.lifecycleStatus }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    {% if line.matchedMpn %}
                                        {% if line.matchedMpn != line.mpn and line.confidenceLevel == 'MEDIUM' %}
                                            <div class="diff-container" data-original="{{ line.mpn|e('html_attr') }}" data-matched="{{ line.matchedMpn|e('html_attr') }}">
                                                <span class="diff-view rams-text--warning"></span>
                                            </div>
                                        {% else %}
                                            <span class="rams-text {% if line.matchedMpn != line.mpn %}rams-text--warning{% else %}rams-text--success{% endif %}">
                                                {{ line.matchedMpn }}
                                            </span>
                                        {% endif %}
                                        {% if line.alternativeParts|default([])|length > 0 %}
                                            <div class="rams-alternatives-dropdown rams-mt-xs">
                                                <span class="rams-text rams-text--xs rams-link">
                                                    +{{ line.alternativeParts|length }} {{ 'quote.review.alternatives'|trans|default('alternatives') }} ▾
                                                </span>
                                                <div class="rams-alternatives-menu">
                                                    <div class="rams-text rams-text--xs rams-text--bold rams-text--muted rams-px-sm rams-py-xs rams-border-bottom">
                                                        {{ 'quote.review.alternative_parts'|trans|default('Alternative Parts (click to select)') }}
                                                    </div>
                                                    {% for alt in line.alternativeParts %}
                                                        <div class="alt-item" onclick="selectAlternative({{ line.id }}, '{{ alt.mpn|e('js') }}', '{{ alt.source|default('mouser')|e('js') }}')">
                                                            <div class="rams-flex rams-flex--between rams-flex--center">
                                                                <div>
                                                                    <span class="rams-text rams-text--bold">{{ alt.mpn }}</span>
                                                                    <span class="rams-text rams-text--xs rams-text--muted rams-block">{{ alt.manufacturer|default('') }}</span>
                                                                </div>
                                                                <div class="rams-text--right">
                                                                    <span class="rams-text rams-text--bold">${{ alt.price|default(0)|number_format(4) }}</span>
                                                                    <span class="rams-text rams-text--xs rams-text--muted rams-block">
                                                                        {% if alt.score is defined %}{{ alt.score }}%{% endif %}
                                                                        {% if alt.stock is defined %}• {{ alt.stock }} {{ 'quote.review.in_stock'|trans|default('in stock') }}{% endif %}
                                                                    </span>
                                                                </div>
                                                            </div>
                                                            {% if alt.lifecycle_warning %}
                                                                <span class="rams-text rams-text--xs {% if alt.lifecycle_warning == 'critical' %}rams-text--danger{% else %}rams-text--warning{% endif %}">
                                                                    ⚠ {{ alt.lifecycle_status|default(alt.lifecycle_warning) }}
                                                                </span>
                                                            {% endif %}
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% else %}
                                        <span class="rams-text--muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-text--muted">{{ line.manufacturer|default('—') }}</td>
                                <td class="rams-table__cell rams-text--muted" title="{{ line.description }}">
                                    {% set desc = line.description|default('—') %}
                                    {{ desc|length > 50 ? desc|slice(0, 47) ~ '...' : desc }}
                                </td>
                                <td class="rams-table__cell rams-text--right">{{ line.quantity }}</td>
                                <td class="rams-table__cell rams-text--right">
                                    {% if line.manualUnitPrice %}
                                        <span class="rams-text rams-text--bold rams-text--info">${{ line.manualUnitPrice|number_format(4) }}</span>
                                        <span class="rams-text rams-text--xs rams-text--muted rams-block">{{ 'quote.review.manual'|trans|default('Manual') }}</span>
                                    {% elseif line.unitPrice %}
                                        <span class="rams-text">${{ line.unitPrice|number_format(4) }}</span>
                                        <span class="rams-text rams-text--xs rams-text--muted rams-block">{{ line.procurementSource }}</span>
                                    {% else %}
                                        <span class="rams-text rams-text--danger rams-text--bold">{{ 'quote.review.no_price'|trans|default('No Price') }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-text--right">
                                    {% set effectivePrice = line.effectiveExtendedPrice %}
                                    {% if effectivePrice is not null %}
                                        ${{ effectivePrice|number_format(2) }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-text--center">
                                    {% set confLevel = line.confidenceLevel|default('VERY_LOW') %}
                                    <span class="rams-badge rams-confidence--{{ confLevel|lower|replace({'_': '-'}) }}" title="{{ line.confidenceReasons|default([])|join(', ') }}">
                                        {{ line.confidenceScore|default(0) }}%
                                    </span>
                                    {% if line.confidenceWarnings|default([])|length > 0 %}
                                        <span class="rams-text rams-text--xs rams-text--danger rams-block" title="{{ line.confidenceWarnings|join(', ') }}">
                                            ⚠ {{ line.confidenceWarnings|length }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-text--center">
                                    {% if line.manuallyVerified %}
                                        <span class="rams-badge rams-badge--green">✓ {{ 'quote.review.verified'|trans|default('Verified') }}</span>
                                    {% elseif line.requiresReview %}
                                        <span class="rams-badge rams-badge--yellow">{{ 'quote.review.needs_review'|trans|default('Needs Review') }}</span>
                                    {% else %}
                                        <span class="rams-badge rams-badge--gray">{{ 'quote.review.auto_ok'|trans|default('Auto-OK') }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-text--right">
                                    <div class="rams-btn-group rams-btn-group--compact">
                                        {% if not line.manuallyVerified %}
                                            <button onclick="verifyLine({{ line.id }})" class="rams-btn rams-btn--icon rams-btn--success-ghost" title="{{ 'quote.review.verify_match'|trans|default('Verify this match is correct') }}">✓</button>
                                        {% endif %}
                                        <button onclick="openOverrideModal({{ line.id }}, '{{ line.mpn|default('')|e('js') }}', {{ line.unitPrice|default(0) }})" class="rams-btn rams-btn--icon rams-btn--ghost" title="{{ 'quote.review.enter_manual_price'|trans|default('Enter manual price') }}">$</button>
                                        <button onclick="repriceLine({{ line.id }})" class="rams-btn rams-btn--icon rams-btn--warning-ghost" title="{{ 'quote.review.reprice'|trans|default('Re-run pricing lookup') }}">↻</button>
                                        {% if line.unitPrice and not line.manuallyVerified %}
                                            <button onclick="rejectLine({{ line.id }})" class="rams-btn rams-btn--icon rams-btn--danger-ghost" title="{{ 'quote.review.reject_match'|trans|default('Reject this match') }}">✗</button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# Price Override Modal #}
<div id="override-modal" class="rams-modal rams-modal--hidden">
    <div class="rams-modal__backdrop" onclick="closeOverrideModal()"></div>
    <div class="rams-modal__content">
        <div class="rams-modal__header">
            <h3 class="rams-heading rams-heading--3">{{ 'quote.review.manual_price_override'|trans|default('Manual Price Override') }}</h3>
        </div>
        <div class="rams-modal__body">
            <form id="override-form">
                <input type="hidden" id="override-line-id">
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'quote.review.part_number'|trans|default('Part Number') }}</label>
                    <input type="text" id="override-mpn" class="rams-form__input rams-form__input--readonly" readonly>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'quote.review.unit_price_usd'|trans|default('Unit Price (USD)') }} *</label>
                    <input type="number" id="override-price" step="0.0001" min="0" required class="rams-form__input">
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">
                        {{ 'quote.review.price_source_url'|trans|default('Price Source URL') }}
                        <span class="rams-text--muted rams-text--normal">({{ 'quote.review.where_found'|trans|default('where you found this price') }})</span>
                    </label>
                    <input type="url" id="override-source-url" placeholder="https://distributor.com/product/..." class="rams-form__input">
                    <span class="rams-form__hint">{{ 'quote.review.link_to_quote'|trans|default('Link to quote, product page, or email confirmation') }}</span>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'common.notes'|trans }} ({{ 'common.optional'|trans|lower }})</label>
                    <textarea id="override-notes" rows="2" class="rams-form__textarea" placeholder="{{ 'quote.review.notes_placeholder'|trans|default('e.g., Valid until MM/DD, MOQ requirements, etc.') }}"></textarea>
                </div>
            </form>
        </div>
        <div class="rams-modal__footer">
            <button type="button" onclick="closeOverrideModal()" class="rams-btn rams-btn--secondary">{{ 'common.cancel'|trans }}</button>
            <button type="submit" form="override-form" class="rams-btn rams-btn--primary">{{ 'quote.review.apply_override'|trans|default('Apply Override') }}</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const quoteId = {{ quote.id }};

function computeCharDiff(original, matched) {
    if (!original || !matched) return matched || '';
    const origNorm = original.toUpperCase().replace(/[\s\-]/g, '');
    const matchNorm = matched.toUpperCase().replace(/[\s\-]/g, '');
    if (origNorm === matchNorm) return `<span class="diff-match">${matched}</span>`;
    
    let result = '', i = 0, j = 0;
    while (j < matched.length) {
        if (i < origNorm.length && origNorm[i] === matchNorm[j]) {
            result += `<span class="diff-match">${matched[j]}</span>`;
            i++; j++;
        } else {
            result += `<span class="diff-insert">${matched[j]}</span>`;
            j++;
        }
    }
    return result;
}

function initDiffViews() {
    document.querySelectorAll('.diff-view').forEach(el => {
        const container = el.closest('.diff-container');
        if (!container) return;
        el.innerHTML = computeCharDiff(container.dataset.original, container.dataset.matched);
    });
}

document.addEventListener('DOMContentLoaded', initDiffViews);

function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `rams-toast rams-toast--${type}`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}

async function verifyLine(lineId) {
    try {
        const response = await fetch(`/quote-review/line/${lineId}/verify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.part_verified'|trans|default('Part verified') }}');
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_verify'|trans|default('Failed to verify') }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

async function rejectLine(lineId) {
    const reason = prompt('{{ 'quote.review.reason_rejection'|trans|default('Reason for rejection:') }}');
    if (reason === null) return;
    
    try {
        const response = await fetch(`/quote-review/line/${lineId}/reject`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.match_rejected'|trans|default('Match rejected') }}');
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_reject'|trans|default('Failed to reject') }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

async function repriceLine(lineId) {
    try {
        const response = await fetch(`/quote-review/line/${lineId}/reprice`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
            showToast(data.message);
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_reprice'|trans|default('Failed to reprice') }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

function openOverrideModal(lineId, mpn, currentPrice) {
    document.getElementById('override-line-id').value = lineId;
    document.getElementById('override-mpn').value = mpn;
    document.getElementById('override-price').value = currentPrice || '';
    document.getElementById('override-notes').value = '';
    document.getElementById('override-source-url').value = '';
    document.getElementById('override-modal').classList.remove('rams-modal--hidden');
}

function closeOverrideModal() {
    document.getElementById('override-modal').classList.add('rams-modal--hidden');
}

document.getElementById('override-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const lineId = document.getElementById('override-line-id').value;
    const price = document.getElementById('override-price').value;
    const notes = document.getElementById('override-notes').value;
    const sourceUrl = document.getElementById('override-source-url').value;
    
    try {
        const response = await fetch(`/quote-review/line/${lineId}/override`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ unit_price: price, notes, source_url: sourceUrl })
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.price_override_applied'|trans|default('Price override applied') }}');
            closeOverrideModal();
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_override'|trans|default('Failed to apply override') }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
});

document.getElementById('verify-all-high-btn').addEventListener('click', async () => {
    ramsConfirm('{{ 'quote.review.confirm_verify_all'|trans|default('Verify all high-confidence matches?') }}', async function() {
        try {
            const response = await fetch(`/quote-review/${quoteId}/verify-all-high`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message);
                location.reload();
            } else {
                showToast(data.error || '{{ 'common.failed'|trans|default('Failed') }}', 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
});

document.getElementById('approve-quote-btn').addEventListener('click', async () => {
    ramsConfirm('{{ 'quote.review.confirm_approve'|trans|default('Approve this quote for publishing?') }}', async function() {
        try {
            const response = await fetch(`/quote-review/${quoteId}/approve`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message);
                if (data.redirect) window.location.href = data.redirect;
            } else {
                let msg = data.error;
                if (data.unverified_count) msg += ` (${data.unverified_count} {{ 'quote.review.unverified'|trans|default('unverified') }})`;
                if (data.unpriced_count) msg += ` (${data.unpriced_count} {{ 'quote.review.unpriced'|trans|default('unpriced') }})`;
                showToast(msg, 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
});

async function selectAlternative(lineId, altMpn, source) {
    const message = `{{ 'quote.review.switch_alternative'|trans|default('Switch to alternative part?') }}\n\n{{ 'quote.review.new_mpn'|trans|default('New MPN') }}: ${altMpn}\n{{ 'common.source'|trans|default('Source') }}: ${source}`;
    ramsConfirm(message, async function() {
        try {
            const response = await fetch(`/quote-review/line/${lineId}/select-alternative`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mpn: altMpn, source: source })
            });
            const data = await response.json();
            if (data.success) {
                showToast(`{{ 'quote.review.switched_to'|trans|default('Switched to') }} ${altMpn}`);
                location.reload();
            } else {
                showToast(data.error || '{{ 'quote.review.failed_select_alt'|trans|default('Failed to select alternative') }}', 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
}
</script>
{% endblock %}
