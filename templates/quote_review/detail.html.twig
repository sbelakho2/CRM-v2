{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.review.review_quote'|trans }} {{ quote.quoteNumber }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Confidence Badge Variants - Sensei-Rams BEM Naming */
    .rams-confidence--high { background-color: rgba(45, 140, 60, 0.1); border-color: var(--rams-green); color: var(--rams-green); }
    .rams-confidence--medium { background-color: rgba(255, 190, 0, 0.1); border-color: var(--rams-orange); color: var(--rams-orange); }
    .rams-confidence--low { background-color: rgba(255, 190, 0, 0.1); border-color: var(--rams-orange); color: var(--rams-orange); }
    .rams-confidence--very-low { background-color: rgba(214, 45, 45, 0.1); border-color: var(--rams-red); color: var(--rams-red); }
    
    /* Row State Modifiers */
    .rams-line--verified { opacity: 0.8; background-color: rgba(45, 140, 60, 0.03); }
    .rams-line--needs-review { background-color: rgba(255, 190, 0, 0.05); }
    
    /* Lifecycle Indicators */
    .rams-lifecycle--critical { border-left: 4px solid var(--rams-red) !important; }
    .rams-lifecycle--warning { border-left: 4px solid var(--rams-orange) !important; }
    .rams-lifecycle-badge--critical {
        background-color: var(--rams-red);
        color: white;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        font-size: 10px;
        font-weight: bold;
        animation: rams-pulse 2s infinite;
    }
    .rams-lifecycle-badge--warning {
        background-color: var(--rams-orange);
        color: white;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        font-size: 10px;
        font-weight: bold;
    }
    @keyframes rams-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
    
    .rams-alternatives-dropdown { position: relative; display: inline-block; }
    .rams-alternatives-menu {
        display: none;
        position: absolute;
        left: 0;
        top: 100%;
        z-index: 100;
        min-width: 350px;
        background: var(--rams-panel);
        border: 1px solid var(--rams-line);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-inset);
        padding: 8px 0;
    }
    .rams-alternatives-dropdown:hover .rams-alternatives-menu { display: block; }
    .rams-alt-item {
        padding: 8px 12px;
        border-bottom: 1px solid var(--rams-border-light, #f3f4f6);
        cursor: pointer;
        transition: background-color 0.15s;
    }
    .rams-alt-item:hover { background-color: var(--rams-bg-secondary, #f9fafb); }
    .rams-alt-item:last-child { border-bottom: none; }
    
    .rams-diff-match { color: var(--rams-success); font-weight: 500; }
    .rams-diff-insert { color: var(--rams-danger); background-color: var(--rams-danger-bg); padding: 0 2px; border-radius: 2px; font-weight: 600; }
    .rams-diff-delete { color: var(--rams-danger); text-decoration: line-through; opacity: 0.7; }
    .rams-diff-container { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.5px; }
</style>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('quote_review_index') }}">{{ 'nav.quote_review'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span>{{ quote.quoteNumber }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'quote.review.review'|trans }}: {{ quote.quoteNumber }}</h1>
            <p class="rams-page__subtitle">{{ company_name ?? ('common.n_a'|trans) }} · {{ quote.createdAt|date('M j, Y g:i A') }}</p>
        </div>
        <div class="rams-page__actions mobile-stack">
            <a href="{{ path('quote_copilot_pdf', {id: quote.id}) }}" class="rams-btn rams-uppercase"  title="{{ 'quote.copilot.download_pdf'|trans }}">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 12V2M4 6L8 2L12 6"/>
                </svg>
                {{ 'quote.review.download_pdf'|trans }}
            </a>
            <a href="{{ path('quote_copilot_full_excel', {id: quote.id}) }}" class="rams-btn rams-uppercase rams-btn--accent-outline">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="10" height="10" rx="1"/>
                    <path d="M3 6H13M3 9H13M6 3V13M10 3V13"/>
                </svg>
                {{ 'quote.copilot.download_full_excel'|trans({}, 'messages')|default('Full Sourcing') }}
            </a>
            <a href="{{ path('export_quote_bom', {id: quote.id}) }}" class="rams-btn rams-uppercase"> 
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 12V2M4 6L8 2L12 6"/>
                </svg>
                {{ 'common.export_csv'|trans }}
            </a>
            <button id="verify-all-high-btn" class="rams-btn rams-uppercase"> 
                {{ 'quote.review.verify_all_high'|trans }}
            </button>
            <button id="approve-quote-btn" class="rams-btn rams-btn--primary rams-uppercase" 
                {% if not stats.ready_for_approval %}disabled{% endif %}>
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 8L6 11L13 4"/>
                </svg>
                {{ 'quote.review.approve'|trans }}
            </button>
        </div>
    </div>

    {# Stats Cards #}
    <div class="rams-grid rams-grid--4 rams-mb-6">
        <div class="rams-module rams-p-4">
            <div class="rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <div class="rams-metric__label rams-text--muted">{{  'quote.review.total_lines'|trans }}</div>
                    <div class="rams-metric__value tabular-nums">{{ stats.total_lines }}</div>
                </div>
                <div class="rams-metric rams-text--right">
                    <div class="rams-metric__label rams-text--muted">{{  'quote.review.verified'|trans }}</div>
                    <div class="rams-metric__value tabular-nums rams-text--green">{{  stats.verified_count }}</div>
                </div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <div class="rams-metric__label rams-text--muted">{{  'quote.review.needs_review'|trans }}</div>
                    <div class="rams-metric__value tabular-nums rams-text--red">{{  stats.requires_review_count }}</div>
                </div>
                <div class="rams-metric rams-text--right">
                    <div class="rams-metric__label rams-text--muted">{{  'quote.review.no_price'|trans }}</div>
                    <div class="rams-metric__value tabular-nums rams-text--warning">{{  stats.no_price_count }}</div>
                </div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <div class="rams-metric__label rams-text--muted">{{  'quote.review.sourced_value'|trans }}</div>
                    <div class="rams-metric__value tabular-nums rams-text-base">{{  stats.sourced_value|format_currency(quote.currency, null, 2) }}</div>
                </div>
                <div class="rams-metric rams-text--right">
                    <div class="rams-metric__label rams-text--muted">{{  'quote.review.progress'|trans }}</div>
                    <div class="rams-metric__value tabular-nums rams-text-base rams-text--info">{{   stats.verification_percent }}%</div>
                </div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-flex rams-justify-between rams-items-center">
                <div class="rams-metric">
                    <div class="rams-metric__label rams-text--muted">{{  'quote.review.obsolete_eol'|trans }}</div>
                    <div class="rams-metric__value tabular-nums rams-text--red">{{  stats.lifecycle_critical|default(0) }}</div>
                </div>
                <div class="rams-metric rams-text--right">
                    <div class="rams-metric__label rams-text--muted">{{  'quote.review.nrnd_parts'|trans }}</div>
                    <div class="rams-metric__value tabular-nums rams-text--warning">{{  stats.lifecycle_warning|default(0) }}</div>
                </div>
            </div>
        </div>
    </div>

    {# Confidence Legend #}
    <div class="rams-module rams-mb-6">
        <div class="rams-module__content">
            <div class="rams-flex rams-flex-wrap rams-items-center rams-gap-4">
                <span class="rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{      'quote.review.confidence_levels'|trans }}:</span>
                <span class="rams-badge rams-confidence--high rams-uppercase">{{  'quote.review.high'|trans }} (90-100)</span>
                <span class="rams-badge rams-confidence--medium rams-uppercase">{{  'quote.review.medium'|trans }} (70-89)</span>
                <span class="rams-badge rams-confidence--low rams-uppercase">{{  'quote.review.low'|trans }} (50-69)</span>
                <span class="rams-badge rams-confidence--very-low rams-uppercase">{{  'quote.review.very_low'|trans }} (&lt;50)</span>
            </div>
        </div>
    </div>

    {# BOM Lines Table #}
    <div class="rams-module">
        <div class="rams-table-container">
            <table class="rams-table" id="bom-lines-table">
                <caption class="rams-sr-only">{{ 'quote.copilot.bill_of_materials'|trans }}</caption>
                <thead>
                    <tr>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">#</th>    
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'quote.review.mpn'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'quote.review.matched'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'quote.review.manufacturer'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'common.description'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase rams-text--right">{{ 'common.quantity'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase rams-text--right">{{ 'quote.live.unit_price'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase rams-text--right">{{ 'quote.review.extended'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase rams-text--center">{{ 'quote.review.confidence'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase rams-text--center">{{ 'common.status'|trans }}</th>
                        <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in bomLines %}
                        <tr id="line-{{ line.id }}" class=" {% if line.lifecycleWarning == 'critical' %}rams-lifecycle--critical{% elseif line.lifecycleWarning == 'warning' %}rams-lifecycle--warning{% endif %} {% if line.requiresReview and not line.manuallyVerified %}rams-line--needs-review{% endif %} {% if line.manuallyVerified %}rams-line--verified{% endif %}">
                            <td class="tabular-nums rams-text--xs rams-text--muted rams-font-mono">{{    line.lineNumber }}</td>
                            <td>
                                <div class="rams-flex rams-flex-col rams-gap-1">
                                    {% if line.distributorSearchUrl %}
                                        <a href="{{ line.distributorSearchUrl }}" target="_blank" class="rams-link rams-text--xs rams-uppercase rams-font-mono"    title="{{ 'quote.review.search_distributor'|trans }}">
                                            {{ line.mpn ?: 'common.n_a'|trans }} ↗
                                        </a>
                                    {% else %}
                                        <span class="rams-font-mono rams-text--xs rams-uppercase">{{    line.mpn ?: 'common.n_a'|trans }}</span>
                                    {% endif %}
                                    {% if line.originalMpn and line.originalMpn != line.mpn %}
                                        <div class="rams-font-mono rams-text--3xs rams-uppercase rams-text--muted">{{     'quote.review.original'|trans }}: {{ line.originalMpn }}</div>
                                    {% endif %}
                                    <div class="rams-flex rams-gap-1">
                                        {% if line.lifecycleWarning == 'critical' %}
                                            <span class="rams-lifecycle-badge--critical" title="{{ 'quote.review.part_obsolete'|trans }}">⚠ {{ 'quote.review.obsolete'|trans }}</span>
                                        {% elseif line.lifecycleWarning == 'warning' %}
                                            <span class="rams-lifecycle-badge--warning" title="{{ 'quote.review.nrnd'|trans }}">{{ 'quote.review.nrnd_short'|trans }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if line.matchedMpn %}
                                    {% if line.matchedMpn != line.mpn and line.confidenceLevel == 'MEDIUM' %}
                                        <div class="rams-diff-container" data-original="{{ line.mpn|e('html_attr') }}" data-matched="{{ line.matchedMpn|e('html_attr') }}">
                                            <span class="diff-view rams-font-mono rams-text--xs rams-text--warning"></span>   
                                        </div>
                                    {% else %}
                                        <div class="rams-font-mono rams-text--xs {% if line.matchedMpn != line.mpn %}rams-text--warning{% else %}rams-text--green{% endif %}">
                                            {{ line.matchedMpn }}
                                        </div>
                                    {% endif %}
                                    
                                    {% if line.alternativeParts|default([])|length > 0 %}
                                        <div class="rams-alternatives-dropdown rams-mt-1">
                                            <span class="rams-font-mono rams-text--3xs rams-uppercase rams-link rams-text--muted" role="button" tabindex="0" aria-expanded="false" aria-controls="alt-menu-{{ line.id }}" onclick="toggleAltMenu(this, {{ line.id }})" onkeydown="altMenuKeydown(event, this, {{ line.id }})">
                                                +{{ line.alternativeParts|length }} {{ 'quote.review.alternatives'|trans }} ▾
                                            </span>
                                            <div class="rams-alternatives-menu" id="alt-menu-{{ line.id }}">
                                                <div class="rams-px-md rams-py-sm rams-border-b rams-bg-panel">
                                                    <span class="rams-font-mono rams-text--2xs rams-text--bold rams-uppercase rams-text--muted">{{      'quote.review.alternative_parts'|trans }}</span>
                                                </div>
                                                {% for alt in line.alternativeParts %}
                                                    <div class="rams-alt-item" role="button" tabindex="0" onclick="selectAlternative({{ line.id }}, '{{ alt.mpn|e('js') }}', '{{ (alt.source ?? 'mouser')|e('js') }}')" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectAlternative({{ line.id }}, '{{ alt.mpn|e('js') }}', '{{ (alt.source ?? 'mouser')|e('js') }}'); }">
                                                        <div class="rams-flex rams-justify-between rams-items-center">
                                                            <div>
                                                                <span class="rams-font-mono rams-text--xs rams-text--bold">{{    alt.mpn }}</span>
                                                                <span class="rams-text--3xs rams-uppercase rams-text--muted rams-block">{{ alt.manufacturer ?? '' }}</span>
                                                            </div>
                                                            <div class="rams-text--right">
                                                                <span class="rams-font-mono rams-text--xs rams-text--bold">{{    alt.price|default(0)|format_currency(quote.currency, null, 4) }}</span>
                                                                <span class="rams-text--3xs rams-text--muted rams-block">
                                                                    {% if alt.score is defined %}{{ alt.score }}%{% endif %}
                                                                    {% if alt.stock is defined %}· {{ alt.stock }} {{ 'quote.review.in_stock'|trans }}{% endif %}
                                                                </span>
                                                            </div>
                                                        </div>
                                                        {% if alt.lifecycle_warning %}
                                                            <span class="rams-text--3xs rams-mt-1 rams-block {% if alt.lifecycle_warning == 'critical' %}rams-text--red{% else %}rams-text--warning{% endif %} rams-uppercase rams-font-mono">  
                                                                ⚠ {{ alt.lifecycle_status|default(alt.lifecycle_warning) }}
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <span class="rams-text--muted">—</span>
                                {% endif %}
                            </td>
                            <td class="rams-text--xs rams-text--muted">{{   line.manufacturer ?: 'common.n_a'|trans }}</td>
                            <td class="rams-text--xs rams-text--muted"   title="{{ line.description }}">
                                {% set desc = line.description ?: 'common.n_a'|trans %}
                                {{ desc|length > 40 ? desc|slice(0, 37) ~ '...' : desc }}
                            </td>
                            <td class="rams-text--right tabular-nums rams-font-mono rams-text--xs">{{   line.quantity }}</td>
                            <td class="rams-text--right tabular-nums rams-font-mono rams-text--xs">  
                                {% if line.manualUnitPrice %}
                                    <div class="rams-text--bold rams-text--info">{{   line.manualUnitPrice|format_currency(quote.currency, null, 4) }}</div>
                                    <div class="rams-text--3xs rams-uppercase rams-text--muted">{{    'quote.review.manual'|trans }}</div>
                                {% elseif line.unitPrice %}
                                    <div>{{ line.unitPrice|format_currency(quote.currency, null, 4) }}</div>
                                    <div class="rams-text--3xs rams-uppercase rams-text--muted">{{    line.procurementSource }}</div>
                                {% else %}
                                    <div class="rams-text--bold rams-uppercase rams-text--xs rams-text--red">{{     'quote.review.no_price'|trans }}</div>
                                {% endif %}
                            </td>
                            <td class="rams-text--right tabular-nums rams-font-mono rams-text--xs rams-text--bold">   
                                {% set effectivePrice = line.effectiveExtendedPrice %}
                                {% if effectivePrice is not null %}
                                    {{ effectivePrice|format_currency(quote.currency, null, 2) }}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="rams-text--center">
                                {% set confLevel = line.confidenceLevel ?? 'VERY_LOW' %}
                                <span class="rams-badge rams-confidence--{{ confLevel|lower|replace({'_': '-'}) }} rams-uppercase"  title="{{ line.confidenceReasons|default([])|join(', ') }}">
                                    {{ line.confidenceScore|default(0) }}%
                                </span>
                            </td>
                            <td class="rams-text--center">
                                {% if line.manuallyVerified %}
                                    <div class="rams-flex rams-items-center rams-justify-center rams-gap-2">
                                        <div class="rams-andon__light rams-andon__light--green"></div>    
                                        <span class="rams-font-mono rams-text--3xs rams-uppercase rams-text--green">{{     'quote.review.verified'|trans }}</span>
                                    </div>
                                {% elseif line.requiresReview %}
                                    <div class="rams-flex rams-items-center rams-justify-center rams-gap-2">
                                        <div class="rams-andon__light rams-andon__light--yellow"></div>    
                                        <span class="rams-font-mono rams-text--3xs rams-uppercase rams-text--warning">{{     'quote.review.needs_review'|trans }}</span>
                                    </div>
                                {% else %}
                                    <span class="rams-badge rams-badge--gray rams-uppercase rams-text--3xs">{{   'quote.review.auto_ok'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="rams-actions rams-actions--sm">
                                    {% if not line.manuallyVerified %}
                                        <button onclick="verifyLine({{ line.id }})" class="rams-btn rams-btn--ghost rams-text--green rams-uppercase"   title="{{ 'quote.review.verify_match'|trans }}" aria-label="{{ 'quote.review.verify_match'|trans }}">
                                            <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M3 8L6 11L13 4"/>
                                            </svg>
                                        </button>
                                    {% endif %}
                                    <button onclick="openOverrideModal({{ line.id }}, '{{ (line.mpn ?? '')|e('js') }}', {{ line.unitPrice ?? 0 }})" class="rams-btn rams-btn--ghost rams-uppercase"  title="{{ 'quote.review.enter_manual_price'|trans }}">
                                        <span class="rams-font-mono rams-text--2xs">{{   quote.currency ?? display_currency() }}</span>
                                    </button>
                                    <button onclick="repriceLine({{ line.id }})" class="rams-btn rams-btn--ghost rams-text--warning rams-uppercase"   title="{{ 'quote.review.reprice'|trans }}" aria-label="{{ 'quote.review.reprice'|trans }}">
                                        <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 8a7 7 0 0111.95-5M15 8a7 7 0 01-11.95 5"/>
                                            <path d="M15 1v7h-7M1 15v-7h7"/>
                                        </svg>
                                    </button>
                                    {% if line.unitPrice and not line.manuallyVerified %}
                                        <button onclick="rejectLine({{ line.id }})" class="rams-btn rams-btn--ghost rams-text--red rams-uppercase"   title="{{ 'quote.review.reject_match'|trans }}" aria-label="{{ 'quote.review.reject_match'|trans }}">
                                            <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M4 4l8 8M12 4l-8 8"/>
                                            </svg>
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# Price Override Modal #}
<div id="override-modal" class="rams-modal rams-modal--hidden" role="dialog" aria-modal="true" aria-labelledby="override-modal-title">
    <div class="rams-modal__backdrop" role="button" tabindex="0" aria-label="{{ 'common.close'|trans }}" onclick="closeOverrideModal()" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); closeOverrideModal(); }"></div>
    <div class="rams-modal__content">
        <div class="rams-modal__header">
            <h2 id="override-modal-title" class="rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{      'quote.review.manual_price_override'|trans }}</h2>
        </div>
        <div class="rams-modal__body">
            <form id="override-form" class="rams-form">
                <input type="hidden" id="override-line-id">
                <div class="rams-form__group">
                    <label class="rams-form__label rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{      'quote.review.part_number'|trans }}</label>
                    <input type="text" id="override-mpn" class="rams-form__input" readonly>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{      'quote.review.unit_price'|trans }} ({{ quote.currency ?? display_currency() }}) *</label>
                    <input type="number" id="override-price" step="0.0001" min="0" required class="rams-form__input">
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">     
                        {{ 'quote.review.price_source_url'|trans }}
                    </label>
                    <input type="url" id="override-source-url" placeholder="{{ 'quote.review.price_source_placeholder'|trans }}" class="rams-form__input">
                    <div class="rams-text--3xs rams-text--muted rams-mt-1">{{ 'quote.review.link_to_quote'|trans }}</div>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-font-mono rams-text--2xs rams-uppercase rams-text--muted">{{      'common.notes'|trans }}</label>
                    <textarea id="override-notes" rows="2" class="rams-form__input" placeholder="{{ 'quote.review.notes_placeholder'|trans }}"></textarea>
                </div>
            </form>
        </div>
        <div class="rams-modal__footer rams-flex rams-justify-end rams-gap-2">
            <button type="button" onclick="closeOverrideModal()" class="rams-btn rams-uppercase">{{  'common.cancel'|trans }}</button>
            <button type="submit" form="override-form" class="rams-btn rams-btn--primary rams-uppercase">{{  'quote.review.apply_override'|trans }}</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const quoteId = {{ quote.id }};

const csrfToken = '{{ csrf_token('quote_review') }}'; 
const verifyLineUrl = '{{ path('quote_review_verify_line', {id: 0}) }}';
const rejectLineUrl = '{{ path('quote_review_reject_line', {id: 0}) }}';
const repriceLineUrl = '{{ path('quote_review_reprice_line', {id: 0}) }}';
const overrideLineUrl = '{{ path('quote_review_override_line', {id: 0}) }}';
const selectAlternativeUrl = '{{ path('quote_review_select_alternative', {id: 0}) }}';
const verifyAllHighUrl = '{{ path('quote_review_verify_all_high', {id: 0}) }}';
const approveQuoteUrl = '{{ path('quote_review_approve', {id: 0}) }}';

function computeCharDiff(original, matched) {
    if (!original || !matched) return escapeHtml(matched || '');
    const origNorm = original.toUpperCase().replace(/[\s\-]/g, '');
    const matchNorm = matched.toUpperCase().replace(/[\s\-]/g, '');
    if (origNorm === matchNorm) return `<span class="rams-diff-match">${escapeHtml(matched)}</span>`;
    
    let result = '', i = 0, j = 0;
    while (j < matched.length) {
        if (i < origNorm.length && origNorm[i] === matchNorm[j]) {
            result += `<span class="rams-diff-match">${escapeHtml(matched[j])}</span>`;
            i++; j++;
        } else {
            result += `<span class="rams-diff-insert">${escapeHtml(matched[j])}</span>`;
            j++;
        }
    }
    return result;
}

function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    const div = document.createElement('div');
    div.textContent = String(str);
    return div.innerHTML;
}

function initDiffViews() {
    document.querySelectorAll('.diff-view').forEach(el => {
        const container = el.closest('.rams-diff-container');
        if (!container) return;
        el.innerHTML = computeCharDiff(container.dataset.original, container.dataset.matched);
    });
}

document.addEventListener('DOMContentLoaded', initDiffViews);

async function verifyLine(lineId) {
    try {
        const response = await fetch(verifyLineUrl.replace('/0', '/' + lineId), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken  }
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.part_verified'|trans }}');
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_verify'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

async function rejectLine(lineId) {
    ramsPrompt('{{ 'quote.review.reason_rejection'|trans }}', function(reason) {
        doRejectLine(lineId, reason);
    }, {title: '{{ 'quote.review.reject_match'|trans }}', inputLabel: '{{ 'quote.review.reason_rejection'|trans }}', required: true});
}

async function doRejectLine(lineId, reason) {
    try {
        const response = await fetch(rejectLineUrl.replace('/0', '/' + lineId), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken  },
            body: JSON.stringify({ reason })
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.match_rejected'|trans }}');
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_reject'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

async function repriceLine(lineId) {
    try {
        const response = await fetch(repriceLineUrl.replace('/0', '/' + lineId), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken  }
        });
        const data = await response.json();
        if (data.success) {
            showToast(data.message);
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_reprice'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

function openOverrideModal(lineId, mpn, currentPrice) {
    document.getElementById('override-line-id').value = lineId;
    document.getElementById('override-mpn').value = mpn;
    document.getElementById('override-price').value = currentPrice || '';
    document.getElementById('override-notes').value = '';
    document.getElementById('override-source-url').value = '';
    document.getElementById('override-modal').classList.remove('rams-modal--hidden');
}

function closeOverrideModal() {
    document.getElementById('override-modal').classList.add('rams-modal--hidden');
}

function toggleAltMenu(trigger, lineId) {
    const menu = document.getElementById('alt-menu-' + lineId);
    if (!menu) return;
    const isOpen = menu.style.display === 'block';
    document.querySelectorAll('.rams-alternatives-menu').forEach(m => { m.style.display = 'none'; });
    document.querySelectorAll('[aria-controls^="alt-menu-"]').forEach(t => t.setAttribute('aria-expanded', 'false'));
    if (!isOpen) {
        menu.style.display = 'block';
        trigger.setAttribute('aria-expanded', 'true');
    }
}

function altMenuKeydown(event, trigger, lineId) {
    if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleAltMenu(trigger, lineId);
    } else if (event.key === 'Escape') {
        const menu = document.getElementById('alt-menu-' + lineId);
        if (menu) menu.style.display = 'none';
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
    }
}

document.addEventListener('click', function(e) {
    if (!e.target.closest('.rams-alternatives-dropdown')) {
        document.querySelectorAll('.rams-alternatives-menu').forEach(m => { m.style.display = 'none'; });
        document.querySelectorAll('[aria-controls^="alt-menu-"]').forEach(t => t.setAttribute('aria-expanded', 'false'));
    }
});

document.getElementById('override-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const lineId = document.getElementById('override-line-id').value;
    const price = document.getElementById('override-price').value;
    const notes = document.getElementById('override-notes').value;
    const sourceUrl = document.getElementById('override-source-url').value;
    
    try {
        const response = await fetch(overrideLineUrl.replace('/0', '/' + lineId), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken  },
            body: JSON.stringify({ unit_price: price, notes, source_url: sourceUrl })
        });
        const data = await response.json();
        if (data.success) {
            showToast('{{ 'quote.review.price_override_applied'|trans }}');
            closeOverrideModal();
            location.reload();
        } else {
            showToast(data.error || '{{ 'quote.review.failed_override'|trans }}', 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
});

document.getElementById('verify-all-high-btn').addEventListener('click', async () => {
    ramsConfirm('{{ 'quote.review.confirm_verify_all'|trans }}', async function() {
        try {
            const response = await fetch(verifyAllHighUrl.replace('/0', '/' + quoteId), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken  }
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message);
                location.reload();
            } else {
                showToast(data.error || '{{ 'common.failed'|trans }}', 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
});

document.getElementById('approve-quote-btn').addEventListener('click', async () => {
    ramsConfirm('{{ 'quote.review.confirm_approve'|trans }}', async function() {
        try {
            const response = await fetch(approveQuoteUrl.replace('/0', '/' + quoteId), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken  }
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message);
                if (data.redirect) window.location.href = data.redirect;
            } else {
                let msg = data.error;
                if (data.unverified_count) msg += ` (${data.unverified_count} {{ 'quote.review.unverified'|trans }})`;
                if (data.unpriced_count) msg += ` (${data.unpriced_count} {{ 'quote.review.unpriced'|trans }})`;
                showToast(msg, 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
});

async function selectAlternative(lineId, altMpn, source) {
    const message = `{{ 'quote.review.switch_alternative'|trans }}\n\n{{ 'quote.review.new_mpn'|trans }}: ${altMpn}\n{{ 'common.source'|trans }}: ${source}`;
    ramsConfirm(message, async function() {
        try {
            const response = await fetch(selectAlternativeUrl.replace('/0', '/' + lineId), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken  },
                body: JSON.stringify({ mpn: altMpn, source: source })
            });
            const data = await response.json();
            if (data.success) {
                showToast(`{{ 'quote.review.switched_to'|trans }} ${altMpn}`);
                location.reload();
            } else {
                showToast(data.error || '{{ 'quote.review.failed_select_alt'|trans }}', 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    });
}
</script>
{% endblock %}
