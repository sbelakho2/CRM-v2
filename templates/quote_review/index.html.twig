{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.review.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-stack--lg">
    {# Header #}
    <div class="rams-page-header">
        <h1 class="rams-heading rams-heading--1">{{ 'quote.review.title'|trans }}</h1>
        <p class="rams-text rams-text--muted">{{ 'quote.review.subtitle'|trans }}</p>
    </div>

    {# Stats Summary #}
    <div class="rams-grid rams-grid--4">
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <div class="rams-metric rams-metric--lg">
                    <span class="rams-metric__label">{{ 'quote.review.total_pending'|trans }}</span>
                    <span class="rams-metric__value rams-text--info">{{ quotes|length }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <div class="rams-metric rams-metric--lg">
                    <span class="rams-metric__label">{{ 'quote.review.high_priority'|trans }}</span>
                    <span class="rams-metric__value rams-text--danger">{{ quotes|filter(q => q[2] > 5)|length }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <div class="rams-metric rams-metric--lg">
                    <span class="rams-metric__label">{{ 'quote.review.ready_approve'|trans }}</span>
                    <span class="rams-metric__value rams-text--success">{{ quotes|filter(q => q[2] == 0)|length }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content rams-text--center">
                <div class="rams-metric rams-metric--lg">
                    <span class="rams-metric__label">{{ 'quote.review.in_progress'|trans }}</span>
                    <span class="rams-metric__value rams-text--warning">{{ quotes|filter(q => q[2] > 0 and q[2] <= 5)|length }}</span>
                </div>
            </div>
        </div>
    </div>

    {# Quotes List #}
    {% if quotes is empty %}
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-empty-state">
                    <div class="rams-empty-state__icon rams-text--success">✓</div>
                    <h3 class="rams-heading rams-heading--3">{{ 'quote.review.all_caught_up'|trans }}</h3>
                    <p class="rams-text rams-text--muted">{{ 'quote.review.no_pending'|trans }}</p>
                    <a href="{{ path('quote_copilot_index') }}" class="rams-btn rams-btn--primary rams-mt-md">
                        {{ 'quote.copilot.new_quote'|trans }}
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="rams-module">
            <div class="rams-module__content rams-module__content--flush">
                <table class="rams-table">
                    <thead class="rams-table__header">
                        <tr>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.quote'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'common.company'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.bom_lines'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.review.needs_review'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'common.created'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header rams-text--right">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for quote in quotes %}
                            {% set q = quote[0] %}
                            {% set totalLines = quote[1] %}
                            {% set reviewCount = quote[2] %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell">
                                    <span class="rams-text rams-text--bold">{{ q.quoteNumber }}</span>
                                    <span class="rams-text rams-text--sm rams-text--muted rams-block">{{ q.totalCost|format_currency(q.currency, null, 2) }}</span>
                                </td>
                                <td class="rams-table__cell">{{ q.company.name ?: 'common.n_a'|trans }}</td>
                                <td class="rams-table__cell">{{ totalLines }} {{ 'quote.lines'|trans }}</td>
                                <td class="rams-table__cell">
                                    {% if reviewCount == 0 %}
                                        <span class="rams-badge rams-badge--green">{{ 'quote.review.ready'|trans }} ✓</span>
                                    {% elseif reviewCount <= 5 %}
                                        <span class="rams-badge rams-badge--yellow">{{ reviewCount }} {{ 'quote.review.items'|trans }}</span>
                                    {% else %}
                                        <span class="rams-badge rams-badge--red">{{ reviewCount }} {{ 'quote.review.items'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--{% if q.status == 'draft' %}gray{% elseif q.status == 'pending_review' %}blue{% elseif q.status == 'approved' %}green{% else %}gray{% endif %}">
                                        {{ q.status|capitalize }}
                                    </span>
                                </td>
                                <td class="rams-table__cell">{{ q.createdAt|date('M j, Y') }}</td>
                                <td class="rams-table__cell rams-text--right">
                                    <a href="{{ path('quote_review_detail', {id: q.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                                        {{ 'quote.review.review'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
