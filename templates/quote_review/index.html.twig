{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.review.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span>{{ 'quote.review.title'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'quote.review.title'|trans }}</h1>
            <p class="rams-page__subtitle">{{ 'quote.review.subtitle'|trans }}</p>
        </div>
    </div>

    {# Stats Summary #}
    <div class="rams-grid rams-grid--4 rams-mb-6">
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label rams-text--muted">{{  'quote.review.total_pending'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ quotes|length }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label rams-text--red">{{  'quote.review.high_priority'|trans }}</div>
                <div class="rams-metric__value tabular-nums rams-text--red">{{  quotes|filter(q => q.review_count > 5)|length }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label rams-text--green">{{  'quote.review.ready_approve'|trans }}</div>
                <div class="rams-metric__value tabular-nums rams-text--green">{{  quotes|filter(q => q.review_count == 0)|length }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label rams-text--warning">{{  'quote.review.in_progress'|trans }}</div>
                <div class="rams-metric__value tabular-nums rams-text--warning">{{  quotes|filter(q => q.review_count > 0 and q.review_count <= 5)|length }}</div>
            </div>
        </div>
    </div>

    {# Quotes List #}
    {% if quotes is empty %}
        <div class="rams-module">
            <div class="rams-module__content rams-p-8 rams-text--center">
                <div class="rams-text--green rams-text--4xl rams-mb-4">
                    <svg class="rams-icon rams-icon--xl" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 8L6 11L13 4"/>
                    </svg>
                </div>
                <h2 class="rams-font-mono rams-text--xs rams-uppercase rams-text--muted rams-mb-2">{{ 'quote.review.all_caught_up'|trans }}</h2>
                <p class="rams-text--sm rams-text--muted rams-mb-6">{{ 'quote.review.no_pending'|trans }}</p>
                <a href="{{ path('quote_copilot_index') }}" class="rams-btn rams-btn--primary rams-uppercase"> 
                    {{ 'quote.copilot.new_quote'|trans }}
                </a>
            </div>
        </div>
    {% else %}
        <div class="rams-module">
            <div class="rams-table-container">
                <table class="rams-table">
                    <caption class="rams-sr-only">{{ 'quote.review.title'|trans }}</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'quote.quote'|trans }}</th>
                            <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'common.company'|trans }}</th>
                            <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'quote.copilot.bom_lines'|trans }}</th>
                            <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'quote.review.needs_review'|trans }}</th>
                            <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'common.status'|trans }}</th>
                            <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase ">{{     'common.created'|trans }}</th>
                            <th scope="col" class="rams-font-mono rams-text--2xs rams-uppercase rams-text--right">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for quote in quotes %}
                            {% set q = quote[0] %}
                            {% set totalLines = quote.total_lines %}
                            {% set reviewCount = quote.review_count %}
                            <tr>
                                <td>
                                    <div class="rams-text--bold">{{  q.quoteNumber }}</div>
                                    <div class="rams-text--xs rams-text--muted tabular-nums">{{ q.totalCost|format_currency(q.currency, null, 2) }}</div>
                                </td>
                                <td>{{ quote.company_name ?? ('common.n_a'|trans) }}</td>
                                <td class="tabular-nums">{{ totalLines }} {{ 'quote.lines'|trans }}</td>
                                <td>
                                    {% if reviewCount == 0 %}
                                        <div class="rams-flex rams-items-center rams-gap-2">
                                            <div class="rams-andon__light rams-andon__light--green"></div>    
                                            <span class="rams-font-mono rams-text--3xs rams-uppercase rams-text--green">{{     'quote.review.ready'|trans }}</span>
                                        </div>
                                    {% elseif reviewCount <= 5 %}
                                        <span class="rams-badge rams-badge--warning rams-uppercase">{{  reviewCount }} {{ 'quote.review.items'|trans }}</span>
                                    {% else %}
                                        <span class="rams-badge rams-badge--danger rams-uppercase">{{  reviewCount }} {{ 'quote.review.items'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="rams-badge rams-badge--{{ q.status == 'approved' ? 'success' : (q.status == 'pending_review' ? 'neutral' : 'neutral') }} rams-uppercase"> 
                                        {{ q.status|replace({'_': ' '}) }}
                                    </span>
                                </td>
                                <td class="tabular-nums rams-text--muted">{{  q.createdAt|date('M j, Y') }}</td>
                                <td class="rams-text--right">
                                    <a href="{{ path('quote_review_detail', {id: q.id}) }}" class="rams-btn rams-btn--ghost rams-uppercase"> 
                                        <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 8s3-6 7-6 7 6 7 6-3 6-7 6-7-6-7-6zM8 11a3 3 0 100-6 3 3 0 000 6z"/>
                                        </svg>
                                        {{ 'quote.review.review'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
