{% extends 'base.html.twig' %}

{% block title %}Import Dataset{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Import Dataset</h1>
        <p class="text-gray-600 mb-8">Upload new data files to the system</p>

        <div class="bg-white rounded-lg shadow-lg p-6">
            {% if errors is defined and errors %}
                <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
                    <h3 class="font-bold mb-2">Import Errors:</h3>
                    <ul class="list-disc list-inside space-y-1">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="POST" enctype="multipart/form-data" class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Dataset Name</label>
                    <input type="text" name="dataset_name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="e.g., Q4 2025 Pricing" required>
                    <p class="mt-1 text-sm text-gray-500">A descriptive name for this dataset version</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Dataset Type</label>
                    <select name="dataset_type" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" required>
                        <option value="">-- Select Type --</option>
                        <option value="pricing">Pricing Data</option>
                        <option value="tariff">Tariff Rates</option>
                        <option value="freight">Freight Tables</option>
                        <option value="capacity">Capacity Calendar</option>
                        <option value="compliance">Compliance Requirements</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Upload File</label>
                    <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-blue-500 transition">
                        <input type="file" name="dataset_file" class="hidden" id="file-input" accept=".xlsx,.xls,.csv,.json" required>
                        <label for="file-input" class="cursor-pointer">
                            <p class="text-gray-700 font-medium">📁 Click to select file or drag and drop</p>
                            <p class="text-sm text-gray-500 mt-1">Supported: XLSX, CSV, JSON (Max 50MB)</p>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                    <textarea name="description" rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="Enter details about this dataset update..."></textarea>
                </div>

                <div>
                    <label class="flex items-center">
                        <input type="checkbox" name="replace_existing" class="mr-2">
                        <span class="text-sm text-gray-700">Replace existing data with this version</span>
                    </label>
                    <p class="mt-1 text-sm text-gray-500">If unchecked, this will be saved as a new version</p>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <h3 class="font-semibold text-blue-900 mb-2">Import Options</h3>
                    <label class="flex items-center mb-2">
                        <input type="checkbox" name="validate_data" checked class="mr-2">
                        <span class="text-sm text-blue-800">Validate data before import</span>
                    </label>
                    <label class="flex items-center mb-2">
                        <input type="checkbox" name="backup_existing" checked class="mr-2">
                        <span class="text-sm text-blue-800">Backup existing data</span>
                    </label>
                    <label class="flex items-center">
                        <input type="checkbox" name="notify_team" class="mr-2">
                        <span class="text-sm text-blue-800">Notify team when import completes</span>
                    </label>
                </div>

                <div class="flex gap-4">
                    <button type="submit" class="px-6 py-2 bg-neutral-900 text-white font-medium rounded-lg hover:bg-neutral-800">
                        ⬆️ Upload & Import
                    </button>
                    <a href="{{ path('admin_dataset_index') }}" class="px-6 py-2 bg-neutral-100 text-neutral-700 font-medium rounded-lg hover:bg-neutral-200">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- Instructions -->
        <div class="mt-8 bg-gray-50 rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Import Instructions</h2>
            <ol class="space-y-2 text-sm text-gray-700 list-decimal list-inside">
                <li>Prepare your data in Excel, CSV, or JSON format</li>
                <li>Ensure all required columns are present</li>
                <li>Give your dataset a descriptive name</li>
                <li>Select the appropriate dataset type</li>
                <li>Upload the file</li>
                <li>Review validation results</li>
                <li>Confirm and complete import</li>
            </ol>
        </div>
    </div>
</div>

<script>
// Drag and drop support
const fileInput = document.getElementById('file-input');
const dropZone = document.querySelector('.border-dashed');

['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
    dropZone.addEventListener(eventName, preventDefaults, false);
});

function preventDefaults(e) {
    e.preventDefault();
    e.stopPropagation();
}

dropZone.addEventListener('drop', handleDrop, false);

function handleDrop(e) {
    let dt = e.dataTransfer;
    let files = dt.files;
    fileInput.files = files;
}
</script>
{% endblock %}
