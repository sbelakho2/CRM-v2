{% extends 'base.html.twig' %}

{% block title %}{{ 'administration.datasets.title_full'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'administration.datasets.title_full'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'administration.datasets.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('admin_dataset_import_form') }}" class="rams-btn rams-btn--primary uppercase">
            <svg class="rams-icon rams-icon--sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 2v12M2 8h12"/>
            </svg>
            {{ 'administration.datasets.import_dataset'|trans }}
        </a>
    </div>

    {% if message is defined and message %}
        <div class="rams-alert rams-alert--success">
            {{ message }}
        </div>
    {% endif %}

    <!-- Statistics -->
    <div class="rams-grid rams-grid--4">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'administration.datasets.total_datasets'|trans }}</span>
                    <span class="rams-metric__value">12</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'administration.datasets.active_versions'|trans }}</span>
                    <span class="rams-metric__value">8</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'administration.datasets.last_updated'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg">{{ 'administration.datasets.sample_last_updated'|trans }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'administration.datasets.storage_used'|trans }}</span>
                    <span class="rams-metric__value rams-text--lg">{{ 'administration.datasets.sample_storage_used'|trans }}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Datasets Table -->
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'administration.datasets.active_datasets'|trans }}</h2>
        </div>

        <div class="rams-table-container">
            <table class="rams-table">
                <thead class="rams-table__header">
                    <tr>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.dataset_name'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.version'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.records'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.last_updated'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.status'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="rams-table__body">
                    {% if datasets | default([]) %}
                        {% for dataset in datasets %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell rams-text--bold">{{ dataset.name }}</td>
                                <td class="rams-table__cell"><span class="rams-badge">{{ dataset.version }}</span></td>
                                <td class="rams-table__cell">
                                    <span class="rams-metric__value rams-text--sm">{{ dataset.records | number_format }}</span>
                                </td>
                                <td class="rams-table__cell rams-text--muted rams-text--xs">{{ dataset.updated_at }}</td>
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--info">
                                        {{ dataset.status }}
                                    </span>
                                </td>
                                <td class="rams-table__cell rams-table__cell--actions">
                                    <div class="rams-btn-group">
                                        <a href="#" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }}</a>
                                        <a href="#" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.export'|trans }}</a>
                                        <a href="#" class="rams-btn rams-btn--ghost rams-btn--sm rams-btn--danger">{{ 'common.delete'|trans }}</a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="rams-table__cell">
                                <div class="rams-empty-state">
                                    {{ 'administration.datasets.no_datasets'|trans }} <a href="{{ path('admin_dataset_import_form') }}" class="rams-link">{{ 'administration.datasets.import_one_now'|trans }}</a>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="rams-grid rams-grid--3">
        <a href="{{ path('admin_dataset_history') }}" class="rams-module rams-module--hoverable">
            <div class="rams-module__content">
                <div class="rams-flex rams-items-center rams-gap-3">
                    <span class="rams-metric__value rams-text--xl">
                        <svg class="rams-icon rams-icon--lg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M3 3h10v10H3V3zM3 6h10M6 3v10"/>
                        </svg>
                    </span>
                    <div>
                        <h3 class="rams-module__title">{{ 'administration.datasets.version_history'|trans }}</h3>
                        <p class="rams-text--muted rams-text--xs">{{ 'administration.datasets.version_history_desc'|trans }}</p>
                    </div>
                </div>
            </div>
        </a>
        <a href="{{ path('admin_dataset_import_form') }}" class="rams-module rams-module--hoverable">
            <div class="rams-module__content">
                <div class="rams-flex rams-items-center rams-gap-3">
                    <span class="rams-metric__value rams-text--xl">
                        <svg class="rams-icon rams-icon--lg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M8 2v10M4 6l4-4 4 4M2 14h12"/>
                        </svg>
                    </span>
                    <div>
                        <h3 class="rams-module__title">{{ 'administration.datasets.import'|trans }}</h3>
                        <p class="rams-text--muted rams-text--xs">{{ 'administration.datasets.upload_hint'|trans }}</p>
                    </div>
                </div>
            </div>
        </a>
        <div class="rams-module rams-module--hoverable" onclick="ramsAlert('{{ 'administration.datasets.syncing_started'|trans }}')">
            <div class="rams-module__content">
                <div class="rams-flex rams-items-center rams-gap-3">
                    <span class="rams-metric__value rams-text--xl">
                        <svg class="rams-icon rams-icon--lg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M1 8a7 7 0 0111.95-5M15 8a7 7 0 01-11.95 5"/>
                            <path d="M15 1v7h-7M1 15v-7h7"/>
                        </svg>
                    </span>
                    <div>
                        <h3 class="rams-module__title">{{ 'administration.datasets.sync_datasets'|trans }}</h3>
                        <p class="rams-text--muted rams-text--xs">{{ 'administration.datasets.sync_desc'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
