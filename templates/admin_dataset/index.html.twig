{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.datasets.title_full'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'admin.datasets.title_full'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'admin.datasets.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('admin_dataset_import_form') }}" class="rams-btn rams-btn--primary">
            ➕ {{ 'admin.datasets.import_dataset'|trans }}
        </a>
    </div>

    {% if message is defined and message %}
        <div class="rams-alert rams-alert--success">
            {{ message }}
        </div>
    {% endif %}

    <!-- Statistics -->
    <div class="rams-grid rams-grid--4">
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'admin.datasets.total_datasets'|trans }}</span>
                <p class="rams-metric__value">12</p>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'admin.datasets.active_versions'|trans }}</span>
                <p class="rams-metric__value">8</p>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'admin.datasets.last_updated'|trans }}</span>
                <p class="rams-metric__value">{{ 'admin.datasets.sample_last_updated'|trans }}</p>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'admin.datasets.storage_used'|trans }}</span>
                <p class="rams-metric__value">{{ 'admin.datasets.sample_storage_used'|trans }}</p>
            </div>
        </div>
    </div>

    <!-- Datasets Table -->
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'admin.datasets.active_datasets'|trans }}</h2>
        </div>

        <table class="rams-table">
            <thead>
                <tr>
                    <th>{{ 'admin.datasets.dataset_name'|trans }}</th>
                    <th>{{ 'admin.datasets.version'|trans }}</th>
                    <th>{{ 'admin.datasets.records'|trans }}</th>
                    <th>{{ 'admin.datasets.last_updated'|trans }}</th>
                    <th>{{ 'admin.datasets.status'|trans }}</th>
                    <th>{{ 'common.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% if datasets | default([]) %}
                    {% for dataset in datasets %}
                        <tr>
                            <td>{{ dataset.name }}</td>
                            <td>{{ dataset.version }}</td>
                            <td>
                                <span class="rams-metric__value">{{ dataset.records | number_format }}</span>
                            </td>
                            <td>{{ dataset.updated_at }}</td>
                            <td>
                                <span class="rams-badge">
                                    {{ dataset.status }}
                                </span>
                            </td>
                            <td>
                                <div class="rams-btn-group">
                                    <a href="#" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }}</a>
                                    <a href="#" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.export'|trans }}</a>
                                    <a href="#" class="rams-btn rams-btn--ghost rams-btn--sm rams-text-danger">{{ 'common.delete'|trans }}</a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="6" class="rams-empty-state">
                            {{ 'admin.datasets.no_datasets'|trans }} <a href="{{ path('admin_dataset_import_form') }}">{{ 'admin.datasets.import_one_now'|trans }}</a>
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    <!-- Quick Actions -->
    <div class="rams-grid rams-grid--3">
        <a href="{{ path('admin_dataset_history') }}" class="rams-module rams-module--clickable">
            <div class="rams-module__content">
                <h3 class="rams-module__title">📋 {{ 'admin.datasets.version_history'|trans }}</h3>
                <p class="rams-text-muted">{{ 'admin.datasets.version_history_desc'|trans }}</p>
            </div>
        </a>
        <a href="{{ path('admin_dataset_import_form') }}" class="rams-module rams-module--clickable">
            <div class="rams-module__content">
                <h3 class="rams-module__title">⬆️ {{ 'admin.datasets.import'|trans }}</h3>
                <p class="rams-text-muted">{{ 'admin.datasets.upload_hint'|trans }}</p>
            </div>
        </a>
        <a href="#" class="rams-module rams-module--clickable">
            <div class="rams-module__content">
                <h3 class="rams-module__title">🔄 {{ 'admin.datasets.sync_datasets'|trans }}</h3>
                <p class="rams-text-muted">{{ 'admin.datasets.sync_desc'|trans }}</p>
            </div>
        </a>
    </div>
</div>
{% endblock %}
