{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.datasets.history_title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <div class="rams-page-header">
        <h1 class="rams-page-title">{{ 'admin.datasets.history_title'|trans }}</h1>
    </div>

    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'admin.datasets.all_versions'|trans }}</h2>
        </div>

        <table class="rams-table">
            <thead>
                <tr>
                    <th>{{ 'admin.datasets.version'|trans }}</th>
                    <th>{{ 'admin.datasets.dataset_name'|trans }}</th>
                    <th>{{ 'admin.datasets.uploaded_by'|trans }}</th>
                    <th>{{ 'common.date'|trans }}</th>
                    <th>{{ 'admin.datasets.records'|trans }}</th>
                    <th>{{ 'admin.datasets.status'|trans }}</th>
                    <th>{{ 'common.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% if versions | default([]) %}
                    {% for version in versions %}
                        <tr>
                            <td>{{ 'admin.datasets.version_prefix'|trans }}{{ version.version | default('admin.datasets.version_default'|trans) }}</td>
                            <td>{{ version.dataset_name | default('common.unknown'|trans) }}</td>
                            <td class="rams-text-muted">{{ version.uploaded_by | default('admin.datasets.system'|trans) }}</td>
                            <td class="rams-text-muted">
                                {% if version.created_at %}
                                    {{ version.created_at | date('Y-m-d H:i') }}
                                {% else %}
                                    {{ 'common.n_a'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                <span class="rams-metric__value">{{ version.record_count | default('0') }}</span>
                            </td>
                            <td>
                                {% if version.is_active %}
                                    <span class="rams-badge rams-badge--success">{{ 'common.active'|trans }}</span>
                                {% else %}
                                    <span class="rams-badge">{{ 'admin.datasets.archived'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="rams-btn-group">
                                    <a href="#" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }}</a>
                                    {% if not version.is_active %}
                                        <a href="#" class="rams-btn rams-btn--ghost rams-btn--sm rams-text-success">{{ 'admin.datasets.restore'|trans }}</a>
                                    {% endif %}
                                    <a href="#" class="rams-btn rams-btn--ghost rams-btn--sm rams-text-danger">{{ 'common.delete'|trans }}</a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="7" class="rams-empty-state">
                            {{ 'admin.datasets.no_versions'|trans }}
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    <!-- Version Timeline -->
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'admin.datasets.timeline'|trans }}</h2>
        </div>
        <div class="rams-module__content">
            <div class="rams-timeline">
                {% if versions | default([]) %}
                    {% for version in versions %}
                        <div class="rams-timeline__item">
                            <div class="rams-timeline__marker">
                                <div class="rams-andon__light rams-andon__light--green"></div>
                                {% if not loop.last %}
                                    <div class="rams-timeline__line"></div>
                                {% endif %}
                            </div>
                            <div class="rams-timeline__content">
                                <p class="rams-timeline__title">{{ version.dataset_name | default('admin.datasets.dataset_update_default'|trans) }}</p>
                                <p class="rams-text-muted">
                                    {% if version.created_at %}
                                        {{ version.created_at | date('Y-m-d H:i') }}
                                    {% else %}
                                        {{ 'admin.datasets.unknown_date'|trans }}
                                    {% endif %}
                                </p>
                                {% if version.description %}
                                    <p class="rams-timeline__description">{{ version.description }}</p>
                                {% endif %}
                                <p class="rams-dymo">
                                    {{ 'admin.datasets.uploaded_by'|trans }} {{ version.uploaded_by | default('admin.datasets.system'|trans) }} • 
                                    {{ version.record_count | default('0') }} {{ 'admin.datasets.records'|trans|lower }}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="rams-text-muted">{{ 'admin.datasets.no_version_history'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Return Link -->
    <div class="rams-module__footer">
        <a href="{{ path('admin_dataset_index') }}" class="rams-btn rams-btn--ghost">
            ← {{ 'common.back'|trans }} {{ 'admin.datasets.title_full'|trans|lower }}
        </a>
    </div>
</div>
{% endblock %}
