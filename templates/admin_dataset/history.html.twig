{% extends 'base.html.twig' %}

{% block title %}{{ 'administration.datasets.history_title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <div class="rams-page-header">
        <h1 class="rams-page-title">{{ 'administration.datasets.history_title'|trans }}</h1>
    </div>

    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'administration.datasets.all_versions'|trans }}</h2>
        </div>

        <div class="rams-table-container">
            <table class="rams-table">
                <thead>
                    <tr>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.version'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.dataset_name'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.uploaded_by'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'common.date'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.records'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'administration.datasets.status'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if versions | default([]) %}
                        {% for version in versions %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell"><span class="rams-badge">{{ 'administration.datasets.version_prefix'|trans }}{{ version.version | default('administration.datasets.version_default'|trans) }}</span></td>
                                <td class="rams-table__cell rams-text--bold">{{ version.dataset_name | default('common.unknown'|trans) }}</td>
                                <td class="rams-table__cell rams-text--muted">{{ version.uploaded_by | default('administration.datasets.system'|trans) }}</td>
                                <td class="rams-table__cell rams-text--muted rams-text--xs">
                                    {% if version.created_at %}
                                        {{ version.created_at | date('Y-m-d H:i') }}
                                    {% else %}
                                        {{ 'common.n_a'|trans }}
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    <span class="rams-metric__value rams-text--sm">{{ version.record_count | default('0') }}</span>
                                </td>
                                <td class="rams-table__cell">
                                    {% if version.is_active %}
                                        <span class="rams-badge rams-badge--success">{{ 'common.active'|trans }}</span>
                                    {% else %}
                                        <span class="rams-badge">{{ 'administration.datasets.archived'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-table__cell--actions">
                                    <div class="rams-btn-group mobile-stack">
                                        <a href="{{ path('admin_dataset_history', {type: version.type}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }}</a>
                                        {% if not version.is_active %}
                                            <form method="post" action="{{ path('admin_dataset_rollback', {datasetType: version.type}) }}" class="rams-mb-0" onsubmit="return ramsConfirmSubmit(event, '{{ 'administration.datasets.restore_confirm'|trans }}', {variant: 'warning'})">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_dataset_rollback_' ~ version.type) }}">
                                                <input type="hidden" name="target_version" value="{{ version.version }}">
                                                <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm rams-text--success">{{ 'administration.datasets.restore'|trans }}</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="7" class="rams-table__cell">
                                <div class="rams-empty-state">
                                    {{ 'administration.datasets.no_versions'|trans }}
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Version Timeline -->
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'administration.datasets.timeline'|trans }}</h2>
        </div>
        <div class="rams-module__content">
            <div class="rams-timeline">
                {% if versions | default([]) %}
                    {% for version in versions %}
                        <div class="rams-timeline__item">
                            <div class="rams-timeline__marker">
                                <div class="rams-andon__light rams-andon__light--green"></div>
                                {% if not loop.last %}
                                    <div class="rams-timeline__line"></div>
                                {% endif %}
                            </div>
                            <div class="rams-timeline__content">
                                <p class="rams-timeline__title">{{ version.dataset_name | default('administration.datasets.dataset_update_default'|trans) }}</p>
                                <p class="rams-text--muted">
                                    {% if version.created_at %}
                                        {{ version.created_at | date('Y-m-d H:i') }}
                                    {% else %}
                                        {{ 'administration.datasets.unknown_date'|trans }}
                                    {% endif %}
                                </p>
                                {% if version.description %}
                                    <p class="rams-timeline__description">{{ version.description }}</p>
                                {% endif %}
                                <p class="rams-dymo">
                                    {{ 'administration.datasets.uploaded_by'|trans }} {{ version.uploaded_by | default('administration.datasets.system'|trans) }} • 
                                    {{ version.record_count | default('0') }} {{ 'administration.datasets.records'|trans|lower }}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="rams-text--muted">{{ 'administration.datasets.no_version_history'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="rams-module__footer">
        <a href="{{ path('admin_dataset_index') }}" class="rams-btn rams-btn--ghost"> 
            <svg class="rams-icon rams-mr-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M10 4L6 8L10 12"/>
            </svg>
            {{ 'common.back'|trans }} {{ 'administration.datasets.title_full'|trans|lower }}
        </a>
    </div>
</div>

{% block stylesheets %}
{{ parent() }}
<style>
    .rams-timeline { position: relative; }
    .rams-timeline__item { position: relative; display: flex; gap: var(--space-3); padding-bottom: var(--space-4); }
    .rams-timeline__marker { position: relative; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; }
    .rams-timeline__marker .rams-andon__light { width: 14px; height: 14px; }
    .rams-timeline__line { position: absolute; top: 16px; bottom: 0; width: 2px; background: var(--rams-line); }
    .rams-timeline__content { flex: 1; min-width: 0; padding-bottom: var(--space-2); border-bottom: 1px solid var(--rams-line); }
    .rams-timeline__title { margin: 0 0 var(--space-1); font-weight: 600; }
    .rams-timeline__description { margin: var(--space-1) 0 0; font-size: var(--text-sm); color: var(--rams-muted); }
</style>
{% endblock %}
{% endblock %}
