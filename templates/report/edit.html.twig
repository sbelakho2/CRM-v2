{% extends 'base.html.twig' %}

{% block title %}{{ 'report.edit_title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page__header-content">
            <h1 class="rams-page__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-3" aria-hidden="true"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                 {{ 'report.edit_settings'|trans }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('report_index') }}" class="rams-breadcrumb__item">{{ 'report.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('report_show', {id: report.id}) }}" class="rams-breadcrumb__item">{{ report.name }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ 'report.edit_title'|trans }}</span>
            </nav>
        </div>
         <div class="rams-page-header__actions">
             <a href="{{ path('report_show', {id: report.id}) }}" class="rams-btn">{{ 'report.cancel'|trans }}</a>
        </div>
    </div>

    <div class="rams-page__container">
        {{ include('report/_form.html.twig', {button_label: 'report.update_settings'|trans}) }}
    </div>
</div>
{% endblock %}
