{% extends 'base.html.twig' %}

{% block title %}Reports{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                 Reports
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">Reports</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
            <a href="{{ path('report_new') }}" class="rams-btn--primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Create Report
            </a>
        </div>
    </div>

    <div class="rams-page-content">
        <!-- Optional: Favorites or Recent -->
        {% if favoriteReports is defined and favoriteReports|length > 0 %}
        <div class="rams-module rams-mb-6">
            <div class="rams-module__header">
                <h3>Favorite Reports</h3>
            </div>
            <div class="rams-module__content">
                <div class="rams-grid--3">
                    {% for report in favoriteReports %}
                         <a href="{{ path('report_show', {'id': report.id}) }}" class="rams-stat-card hover:rams-border-blue-500 transition-colors cursor-pointer block no-underline text-inherit">
                            <div class="rams-stat-card__label rams-mb-2">{{ report.entityClass|split('\\')|last }}</div>
                            <div class="rams-stat-card__value rams-text--lg">{{ report.name }}</div>
                            <div class="rams-text--xs rams-text--muted rams-mt-2">
                                <span class="rams-badge rams-badge--gray">{{ report.reportType }}</span>
                            </div>
                         </a>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}

        <div class="rams-module">
            <div class="rams-table-container">
                <table class="rams-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Data Source</th>
                            <th>Type</th>
                            <th>Created</th>
                            <th>Status</th>
                            <th class="rams-text--right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for report in reports %}
                        <tr>
                            <td>
                                <a href="{{ path('report_show', {'id': report.id}) }}" class="font-medium hover:underline">{{ report.name }}</a>
                                {% if report.description %}
                                    <div class="rams-text--xs rams-text--muted truncate max-w-xs">{{ report.description }}</div>
                                {% endif %}
                            </td>
                            <td>
                                <span class="rams-badge rams-badge--gray">{{ report.entityClass|split('\\')|last }}</span>
                            </td>
                            <td>{{ report.reportType }}</td>
                            <td>{{ report.createdAt ? report.createdAt|date('M j, Y') : '' }}</td>
                            <td>
                                {% if report.isPublic %}
                                    <span class="text-green-600 rams-text--xs rams-text--bold uppercase">Public</span>
                                {% else %}
                                    <span class="text-gray-500 rams-text--xs rams-text--bold uppercase">Private</span>
                                {% endif %}
                            </td>
                            <td class="rams-text--right whitespace-nowrap">
                                <a href="{{ path('report_builder', {'id': report.id}) }}" class="rams-btn-sm rams-mr-1">Builder</a>
                                <a href="{{ path('report_edit', {'id': report.id}) }}" class="rams-btn--ghost rams-btn-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="rams-text--center rams-py-8 rams-text--muted">
                                No reports found. Create one to get started.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
