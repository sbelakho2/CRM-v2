{% extends 'base.html.twig' %}

{% block title %}{{ 'report.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page__header-content">
            <h1 class="rams-page__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-3" aria-hidden="true"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                 {{ 'report.title'|trans }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ 'report.title'|trans }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
            <a href="{{ path('report_new') }}" class="rams-btn rams-btn--primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                {{ 'report.new_report'|trans }}
            </a>
        </div>
    </div>

    <div class="rams-page__container">
        <!-- Optional: Favorites or Recent -->
        {% if favoriteReports is defined and favoriteReports|length > 0 %}
        <div class="rams-module rams-mb-6">
            <div class="rams-module__header">
                <h2>{{ 'report.favorite_reports'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                <div class="rams-grid--3">
                    {% for report in favoriteReports %}
                         <a href="{{ path('report_show', {'id': report.id}) }}" class="rams-stat-card rams-no-underline rams-block rams-cursor-pointer rams-transition-colors">
                            <div class="rams-stat-card__label rams-mb-2">{{ report.dataSource|default('common.n_a'|trans) }}</div>
                            <div class="rams-stat-card__value rams-text--lg">{{ report.name }}</div>
                            <div class="rams-text--xs rams-text--muted rams-mt-2">
                                <span class="rams-badge rams-badge--gray">{{ report.reportType }}</span>
                            </div>
                         </a>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}

        <div class="rams-module">
            <div class="rams-table-container">
                <table class="rams-table">
                    <caption class="rams-sr-only">{{ 'report.title'|trans }}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{ 'common.name'|trans }}</th>
                            <th scope="col">{{ 'report.data_source'|trans }}</th>
                            <th scope="col">{{ 'common.type'|trans }}</th>
                            <th scope="col">{{ 'common.created'|trans }}</th>
                            <th scope="col">{{ 'common.status'|trans }}</th>
                            <th scope="col" class="rams-text--right">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for report in reports %}
                        <tr>
                            <td>
                                <a href="{{ path('report_show', {'id': report.id}) }}" class="rams-link">{{ report.name }}</a>
                                {% if report.description %}
                                    <div class="rams-text--xs rams-text--muted rams-truncate rams-max-w-xs">{{ report.description }}</div>
                                {% endif %}
                            </td>
                            <td>
                                <span class="rams-badge rams-badge--gray">{{ report.dataSource|default('N/A') }}</span>
                            </td>
                            <td>{{ report.reportType }}</td>
                            <td>{{ report.createdAt ? report.createdAt|date('M j, Y') : '' }}</td>
                            <td>
                                {% if report.isPublic %}
                                    <span class="rams-text--success rams-text--xs rams-text--bold rams-uppercase">{{ 'report.public'|trans }}</span>
                                {% else %}
                                    <span class="rams-text--muted rams-text--xs rams-text--bold rams-uppercase">{{ 'report.private'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="rams-text--right rams-whitespace-nowrap">
                                <a href="{{ path('report_builder', {'id': report.id}) }}" class="rams-btn rams-btn--sm rams-mr-1">{{ 'report.builder'|trans }}</a>
                                <a href="{{ path('report_edit', {'id': report.id}) }}" class="rams-btn rams-btn--ghost rams-btn__icon" title="{{ 'common.edit'|trans }}" aria-label="{{ 'common.edit'|trans }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="rams-text--center rams-py-xl rams-text--muted">
                                {{ 'report.no_reports'|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
