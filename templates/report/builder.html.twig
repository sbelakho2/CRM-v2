{% extends 'base.html.twig' %}

{% block title %}Report Builder: {{ report.name }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<style>
    .builder-ghost {
        opacity: 0.4;
        background-color: var(--rams-surface-hover);
        rams-border: 1px dashed var(--rams-primary);
    }
    .builder-drag {
        cursor: move; 
    }
    .field-item {
        padding: 0.5rem 1rem;
        background: var(--rams-surface);
        rams-border: 1px solid var(--rams-border);
        rams-border-radius: 4px;
        margin-bottom: 0.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.875rem;
    }
    .field-item:hover {
        rams-border-color: var(--rams-primary-light);
    }
    .field-code {
        font-family: monospace;
        color: var(--rams-rams-text--muted);
        font-size: 0.75rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                 Builder: {{ report.name }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('report_index') }}" class="rams-breadcrumb__item">Reports</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('report_show', {'id': report.id}) }}" class="rams-breadcrumb__item">{{ report.name }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">Builder</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <button type="submit" form="builder-form" class="rams-btn--primary">Save Configuration</button>
             <a href="{{ path('report_show', {id: report.id}) }}" class="rams-btn">Cancel</a>
        </div>
    </div>

    <div class="rams-page-content">
        <form id="builder-form" method="post" action="{{ path('report_builder_save', {id: report.id}) }}">
        <div class="rams-grid" style="grid-template-columns: 300px 1fr;">
            <!-- Sidebar: Available Fields -->
            <div class="rams-module" style="height: fit-content;">
                <div class="rams-module__header">
                    <h3>Available Fields</h3>
                    <input type="text" id="field-search" class="rams-form__input rams-form__input-sm rams-mt-2" placeholder="Search fields...">
                </div>
                <div class="rams-module__content rams-p-2 bg-gray-50" style="max-height: 600px; overflow-y: auto;">
                    <div id="available-fields" class="min-h-[200px]">
                        {% for field in availableFields %}
                        <div class="field-item builder-drag" data-field="{{ field.property }}" data-label="{{ field.label }}" data-type="{{ field.type }}">
                            <span>{{ field.label }}</span>
                            <span class="field-code">{{ field.type }}</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Main: Configuration Areas -->
            <div class="space-y-6">
                
                <!-- Columns -->
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3>Selected Columns</h3>
                        <div class="rams-text--xs rams-text--muted">Drag fields here to include them in the report table</div>
                    </div>
                    <div class="rams-module__content rams-p-2">
                        <div id="selected-columns" class="min-h-[100px] rams-border-2 rams-border-dashed rams-border-gray-200 rams-rounded rams-p-2">
                             {% for col in report.columns %}
                                 <div class="field-item builder-drag" data-field="{{ col.property }}">
                                    <span>{{ col.label }}</span>
                                    <input type="hidden" name="columns[]" value="{{ col.property }}">
                                    <button type="button" class="rams-ml-2 text-red-500 hover:text-red-700" onclick="this.parentElement.remove()">×</button>
                                </div>
                             {% endfor %}
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3>Filters</h3>
                        <div class="rams-text--xs rams-text--muted">Drag fields here to filter results</div>
                    </div>
                    <div class="rams-module__content rams-p-2">
                         <div id="report-filters" class="min-h-[100px] rams-border-2 rams-border-dashed rams-border-gray-200 rams-rounded rams-p-2">
                            {% for filter in report.filters %}
                                <div class="field-item builder-drag" data-field="{{ filter.property }}">
                                    <div class="flex-1 grid grid-cols-3 rams-gap-2 rams-items-center">
                                        <span class="font-medium">{{ filter.label }}</span>
                                        <select name="filters[{{ filter.property }}][operator]" class="rams-form__select rams-form__select-sm">
                                            <option value="equals" {{ filter.operator == 'equals' ? 'selected' : '' }}>Equals</option>
                                            <option value="contains" {{ filter.operator == 'contains' ? 'selected' : '' }}>Contains</option>
                                            <option value="gt" {{ filter.operator == 'gt' ? 'selected' : '' }}>Greater Than</option>
                                            <option value="lt" {{ filter.operator == 'lt' ? 'selected' : '' }}>Less Than</option>
                                        </select>
                                        <input type="text" name="filters[{{ filter.property }}][value]" value="{{ filter.value }}" class="rams-form__input rams-form__input-sm" placeholder="Value">
                                    </div>
                                    <button type="button" class="rams-ml-2 text-red-500 hover:text-red-700" onclick="this.parentElement.remove()">×</button>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <!-- Sorting -->
                <div class="rams-module">
                   <div class="rams-module__header">
                        <h3>Sorting</h3>
                    </div>
                    <div class="rams-module__content rams-p-2">
                        <div id="report-sorting" class="min-h-[80px] rams-border-2 rams-border-dashed rams-border-gray-200 rams-rounded rams-p-2">
                             {% for sort in report.sorting %}
                                <div class="field-item builder-drag" data-field="{{ sort.property }}">
                                    <div class="flex-1 flex rams-items-center rams-justify-between">
                                        <span>{{ sort.label }}</span>
                                        <select name="sorting[{{ sort.property }}]" class="rams-form__select rams-form__select-sm w-32">
                                            <option value="asc" {{ sort.direction == 'asc' ? 'selected' : '' }}>Ascending</option>
                                            <option value="desc" {{ sort.direction == 'desc' ? 'selected' : '' }}>Descending</option>
                                        </select>
                                    </div>
                                    <button type="button" class="rams-ml-2 text-red-500 hover:text-red-700" onclick="this.parentElement.remove()">×</button>
                                </div>
                             {% endfor %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const available = document.getElementById('available-fields');
        const columns = document.getElementById('selected-columns');
        const filters = document.getElementById('report-filters');
        const sorting = document.getElementById('report-sorting');

        // Available Fields (Source)
        new Sortable(available, {
            group: {
                name: 'fields',
                pull: 'clone',
                put: false
            },
            sort: false,
            animation: 150,
            ghostClass: 'builder-ghost'
        });

        // Columns List
        new Sortable(columns, {
            group: 'fields',
            animation: 150,
            ghostClass: 'builder-ghost',
            onAdd: function (evt) {
                const item = evt.item;
                const field = item.dataset.field;
                item.innerHTML = `
                    <span>${item.dataset.label}</span>
                    <input type="hidden" name="columns[]" value="${field}">
                    <button type="button" class="rams-ml-2 text-red-500 hover:text-red-700" onclick="this.parentElement.remove()">×</button>
                `;
            }
        });

        // Filters List
        new Sortable(filters, {
            group: 'fields',
            animation: 150,
            ghostClass: 'builder-ghost',
            onAdd: function (evt) {
                const item = evt.item;
                const field = item.dataset.field;
                item.innerHTML = `
                    <div class="flex-1 grid grid-cols-3 rams-gap-2 rams-items-center">
                        <span class="font-medium">${item.dataset.label}</span>
                        <select name="filters[${field}][operator]" class="rams-form__select rams-form__select-sm">
                            <option value="equals">Equals</option>
                            <option value="contains">Contains</option>
                            <option value="gt">Greater Than</option>
                            <option value="lt">Less Than</option>
                        </select>
                        <input type="text" name="filters[${field}][value]" class="rams-form__input rams-form__input-sm" placeholder="Value">
                    </div>
                    <button type="button" class="rams-ml-2 text-red-500 hover:text-red-700" onclick="this.parentElement.remove()">×</button>
                `;
            }
        });

        // Sorting List
        new Sortable(sorting, {
            group: 'fields',
            animation: 150,
            ghostClass: 'builder-ghost',
            onAdd: function (evt) {
                const item = evt.item;
                const field = item.dataset.field;
                // Check if already exists
                // Note: simplified logic
                item.innerHTML = `
                    <div class="flex-1 flex rams-items-center rams-justify-between">
                        <span>${item.dataset.label}</span>
                        <select name="sorting[${field}]" class="rams-form__select rams-form__select-sm w-32">
                            <option value="asc">Ascending</option>
                            <option value="desc">Descending</option>
                        </select>
                    </div>
                    <button type="button" class="rams-ml-2 text-red-500 hover:text-red-700" onclick="this.parentElement.remove()">×</button>
                `;
            }
        });

        // Search
        document.getElementById('field-search').addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('#available-fields .field-item').forEach(el => {
                const label = el.dataset.label.toLowerCase();
                el.style.display = label.includes(term) ? 'flex' : 'none';
            });
        });
    });
</script>
{% endblock %}
