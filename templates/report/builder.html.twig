{% extends 'base.html.twig' %}

{% block title %}{{ 'report.builder_title_prefix'|trans }}{{ report.name }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js" integrity="sha384-HZZ/fukV+9G8gwTNjN7zQDG0Sp7MsZy5DDN6VfY3Be7V9dvQpEpR2jF2HlyFUUjU" crossorigin="anonymous"></script> 
<style>
    .rams-builder-ghost {
        opacity: 0.4;
        background-color: var(--rams-surface-hover);
        border: 1px dashed var(--rams-primary);
    }
    .rams-builder-drag {
        cursor: move; 
    } .rams-builder-dropzone { border: 2px dashed var(--rams-line); border-radius: var(--radius-sm); }
    .rams-field-item {
        padding: 0.5rem 1rem;
        background: var(--rams-surface);
        border: 1px solid var(--rams-border);
        border-radius: 4px;
        margin-bottom: 0.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-2); font-size: 0.875rem;
    }
    .rams-field-item:hover {
        border-color: var(--rams-primary-light);
    }
    .rams-field-code {
        font-family: var(--font-mono); 
        color: var(--rams-muted); 
        font-size: 0.75rem;
    } .rams-field-item .rams-form__input, .rams-field-item .rams-form__select { padding: 2px 6px; font-size: var(--text-sm); }
</style>
{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page__header-content">
            <h1 class="rams-page__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-3"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                 {{ 'report.builder_title_prefix'|trans }}{{ report.name }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('report_index') }}" class="rams-breadcrumb__item">{{ 'report.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('report_show', {'id': report.id}) }}" class="rams-breadcrumb__item">{{ report.name }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ 'report.builder'|trans }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <button type="submit" form="builder-form" class="rams-btn rams-btn--primary">{{ 'report.save_configuration'|trans }}</button>
             <a href="{{ path('report_show', {id: report.id}) }}" class="rams-btn">{{ 'report.cancel'|trans }}</a>
        </div>
    </div>

    <div class="rams-page__container">
        <form id="builder-form" method="post" action="{{ path('report_builder', {id: report.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('report_builder') }}"> <div class="rams-grid" style="grid-template-columns: 300px 1fr;">
            <!-- Sidebar: Available Fields -->
            <div class="rams-module" style="height: fit-content;">
                <div class="rams-module__header">
                    <h2>{{ 'report.available_fields'|trans }}</h2>
                    <input type="text" id="field-search" class="rams-form__input rams-mt-2" placeholder="{{ 'report.search_fields'|trans }}">
                </div>
                <div class="rams-module__content rams-p-2 rams-bg-panel" style="max-height: 600px; overflow-y: auto;">
                    <div id="available-fields" class="rams-builder-dropzone rams-p-2" style="min-height: 200px;"> 
                        {% for field in availableFields %}
                        <div class="rams-field-item rams-builder-drag" data-field="{{ field.property }}" data-label="{{ field.label }}" data-type="{{ field.type }}">
                            <span>{{ field.label }}</span>
                            <span class="rams-field-code">{{ field.type }}</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Main: Configuration Areas -->
            <div class="rams-stack rams-stack--lg"> 
                
                <!-- Columns -->
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3>{{ 'report.selected_columns'|trans }}</h3>
                        <div class="rams-text--xs rams-text--muted">{{ 'report.drag_columns_desc'|trans }}</div>
                    </div>
                    <div class="rams-module__content rams-p-2">
                        <div id="selected-columns" class="rams-builder-dropzone rams-p-2" style="min-height: 100px;">      
                             {% for col in report.columns %}
                                 {% set colField = col.field is defined ? col.field : col %}
                                 <div class="rams-field-item rams-builder-drag" data-field="{{ colField }}">
                                    <span>{{ colField }}</span>
                                    <input type="hidden" name="columns[]" value="{{ colField }}">
                                    <button type="button" class="rams-ml-2 rams-text--danger" onclick="this.parentElement.remove()" aria-label="{{ 'report.remove'|trans }}">×</button> 
                                </div>
                             {% endfor %}
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="rams-module">
                    <div class="rams-module__header">
                        <h3>{{ 'report.filters'|trans }}</h3>
                        <div class="rams-text--xs rams-text--muted">{{ 'report.drag_filters_desc'|trans }}</div>
                    </div>
                    <div class="rams-module__content rams-p-2">
                         <div id="report-filters" class="rams-builder-dropzone rams-p-2" style="min-height: 100px;">      
                            {% for filter in report.filters %}
                                {% set filterField = filter.field is defined ? filter.field : filter %}
                                <div class="rams-field-item rams-builder-drag" data-field="{{ filterField }}">
                                    <div class="rams-flex-1 rams-grid rams-grid--3 rams-gap-2 rams-items-center">
                                        <span class="rams-text--strong">{{ filterField }}</span>
                                        <select name="filters[{{ filterField }}][operator]" class="rams-form__select">  
                                            <option value="equals" {{ filter.operator == 'equals' ? 'selected' : '' }}>{{ 'report.equals'|trans }}</option>
                                            <option value="contains" {{ filter.operator == 'contains' ? 'selected' : '' }}>{{ 'report.contains'|trans }}</option>
                                            <option value="gt" {{ filter.operator == 'gt' ? 'selected' : '' }}>{{ 'report.greater_than'|trans }}</option>
                                            <option value="lt" {{ filter.operator == 'lt' ? 'selected' : '' }}>{{ 'report.less_than'|trans }}</option>
                                        </select>
                                        <input type="text" name="filters[{{ filterField }}][value]" value="{{ filter.value|default('') }}" class="rams-form__input"   placeholder="{{ 'report.value'|trans }}">
                                    </div>
                                    <button type="button" class="rams-ml-2 rams-text--danger" onclick="this.parentElement.remove()" aria-label="{{ 'report.remove'|trans }}">×</button> 
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <!-- Sorting -->
                <div class="rams-module">
                   <div class="rams-module__header">
                        <h3>{{ 'report.sorting'|trans }}</h3>
                    </div>
                    <div class="rams-module__content rams-p-2">
                        <div id="report-sorting" class="rams-builder-dropzone rams-p-2" style="min-height: 80px;">      
                             {% for sort in report.orderBy %}
                                {% set sortField = sort.field is defined ? sort.field : sort %}
                                <div class="rams-field-item rams-builder-drag" data-field="{{ sortField }}">
                                    <div class="rams-flex-1 rams-flex rams-items-center rams-justify-between rams-gap-2"> 
                                        <span>{{ sortField }}</span>
                                        <select name="sorting[{{ sortField }}]" class="rams-form__select">   
                                            <option value="asc" {{ sort.direction == 'asc' ? 'selected' : '' }}>{{ 'report.ascending'|trans }}</option>
                                            <option value="desc" {{ sort.direction == 'desc' ? 'selected' : '' }}>{{ 'report.descending'|trans }}</option>
                                        </select>
                                    </div>
                                    <button type="button" class="rams-ml-2 rams-text--danger" onclick="this.parentElement.remove()" aria-label="{{ 'report.remove'|trans }}">×</button> 
                                </div>
                             {% endfor %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const available = document.getElementById('available-fields');
        const columns = document.getElementById('selected-columns');
        const filters = document.getElementById('report-filters');
        const sorting = document.getElementById('report-sorting');

        // Available Fields (Source)
        new Sortable(available, {
            group: {
                name: 'fields',
                pull: 'clone',
                put: false
            },
            sort: false,
            animation: 150,
            ghostClass: 'rams-builder-ghost'
        });

        // Columns List
        new Sortable(columns, {
            group: 'fields',
            animation: 150,
            ghostClass: 'rams-builder-ghost',
            onAdd: function (evt) {
                const item = evt.item;
                const field = item.dataset.field;
                item.innerHTML = `
                    <span>${item.dataset.label}</span>
                    <input type="hidden" name="columns[]" value="${field}">
                    <button type="button" class="rams-ml-2 rams-text--danger" onclick="this.parentElement.remove()" aria-label="{{ 'report.remove'|trans }}">×</button> 
                `;
            }
        });

        // Filters List
        new Sortable(filters, {
            group: 'fields',
            animation: 150,
            ghostClass: 'rams-builder-ghost',
            onAdd: function (evt) {
                const item = evt.item;
                const field = item.dataset.field;
                item.innerHTML = `
                    <div class="rams-flex-1 rams-grid rams-grid--3 rams-gap-2 rams-items-center">
                        <span class="rams-text--strong">${item.dataset.label}</span> 
                        <select name="filters[${field}][operator]" class="rams-form__select">  
                            <option value="equals">{{ 'report.equals'|trans }}</option>
                            <option value="contains">{{ 'report.contains'|trans }}</option>
                            <option value="gt">{{ 'report.greater_than'|trans }}</option>
                            <option value="lt">{{ 'report.less_than'|trans }}</option>
                        </select>
                        <input type="text" name="filters[${field}][value]" class="rams-form__input"   placeholder="{{ 'report.value'|trans }}">
                    </div>
                    <button type="button" class="rams-ml-2 rams-text--danger" onclick="this.parentElement.remove()" aria-label="{{ 'report.remove'|trans }}">×</button> 
                `;
            }
        });

        // Sorting List
        new Sortable(sorting, {
            group: 'fields',
            animation: 150,
            ghostClass: 'rams-builder-ghost',
            onAdd: function (evt) {
                const item = evt.item;
                const field = item.dataset.field;
                    
                   
                item.innerHTML = `
                    <div class="rams-flex-1 rams-flex rams-items-center rams-justify-between rams-gap-2"> 
                        <span>${item.dataset.label}</span>
                        <select name="sorting[${field}]" class="rams-form__select">   
                            <option value="asc">{{ 'report.ascending'|trans }}</option>
                            <option value="desc">{{ 'report.descending'|trans }}</option>
                        </select>
                    </div>
                    <button type="button" class="rams-ml-2 rams-text--danger" onclick="this.parentElement.remove()" aria-label="{{ 'report.remove'|trans }}">×</button> 
                `;
            }
        });

        // Search
        document.getElementById('field-search').addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('#available-fields .rams-field-item').forEach(el => {
                const label = el.dataset.label.toLowerCase();
                el.style.display = label.includes(term) ? 'flex' : 'none';
            });
        });
    });
</script>
{% endblock %}
