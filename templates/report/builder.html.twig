{% extends 'base.html.twig' %}

{% block title %}{{ 'report.builder_title_prefix'|trans }}{{ report.name }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page__header-content">
            <h1 class="rams-page__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rams-mr-3" aria-hidden="true"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                 {{ 'report.builder_title_prefix'|trans }}{{ report.name }}
            </h1>
            <nav class="rams-breadcrumb" aria-label="Breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator" aria-hidden="true">/</span>
                <a href="{{ path('report_index') }}" class="rams-breadcrumb__item">{{ 'report.title'|trans }}</a>
                <span class="rams-breadcrumb__separator" aria-hidden="true">/</span>
                <a href="{{ path('report_show', {'id': report.id}) }}" class="rams-breadcrumb__item">{{ report.name }}</a>
                <span class="rams-breadcrumb__separator" aria-hidden="true">/</span>
                <span class="rams-breadcrumb__item active" aria-current="page">{{ 'report.builder'|trans }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <button type="submit" form="builder-form" class="rams-btn rams-btn--primary">{{ 'report.save_configuration'|trans }}</button>
             <a href="{{ path('report_show', {id: report.id}) }}" class="rams-btn">{{ 'report.cancel'|trans }}</a>
        </div>
    </div>

    <div class="rams-page__container">
        {% if previewResults.meta.warnings is defined and previewResults.meta.warnings is not empty %}
            <div class="rams-flash rams-flash--warning" role="alert">
                <strong>Configuration issues:</strong>
                <ul class="rams-mb-0">
                    {% for warning in previewResults.meta.warnings %}
                        <li>{{ warning }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form id="builder-form" method="post" action="{{ path('report_builder', {id: report.id}) }}" class="rams-builder-layout">
            <input type="hidden" name="_token" value="{{ csrf_token('report_builder') }}">

            {# ── Panel 1: DATA — searchable field list with explicit actions ── #}
            <section class="rams-module rams-builder-fields" aria-labelledby="builder-fields-title">
                <div class="rams-module__header">
                    <h2 id="builder-fields-title">{{ 'report.available_fields'|trans }}</h2>
                </div>
                <div class="rams-module__content rams-p-2">
                    <input type="search" id="field-search" class="rams-form__input rams-mb-2"
                           placeholder="{{ 'report.search_fields'|trans }}" aria-label="{{ 'report.search_fields'|trans }}">
                    <ul class="rams-builder-fieldlist" id="available-fields">
                        {% for field in availableFields %}
                            <li class="rams-builder-field" data-field="{{ field.property }}" data-label="{{ field.label }}" data-type="{{ field.type }}">
                                <span class="rams-builder-field__label">{{ field.label }}</span>
                                <span class="rams-field-code">{{ field.type }}</span>
                                <span class="rams-builder-field__actions">
                                    <button type="button" class="rams-btn rams-btn--secondary rams-btn--sm" data-add="column"
                                            aria-label="Add {{ field.label }} as column">Column</button>
                                    <button type="button" class="rams-btn rams-btn--secondary rams-btn--sm" data-add="filter"
                                            aria-label="Add {{ field.label }} as filter">Filter</button>
                                    <button type="button" class="rams-btn rams-btn--secondary rams-btn--sm" data-add="sort"
                                            aria-label="Sort by {{ field.label }}">Sort</button>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="rams-text--xs rams-text--muted rams-mt-2">Click Column, Filter or Sort to add a field. You can also drag between panels.</p>
                </div>
            </section>

            {# ── Panel 2: CONFIGURE — structured, accessible rows ── #}
            <div class="rams-stack rams-stack--lg">

                <section class="rams-module" aria-labelledby="builder-columns-title">
                    <div class="rams-module__header">
                        <h3 id="builder-columns-title">{{ 'report.selected_columns'|trans }}</h3>
                    </div>
                    <div class="rams-module__content rams-p-2">
                        <ol class="rams-builder-rows" id="selected-columns" data-empty="{{ 'report.no_columns'|trans|default('No columns selected — add fields from the left.') }}">
                            {% for col in report.columns %}
                                {% set colField = col.field is defined ? col.field : col %}
                                {% set colDef = fields[colField] ?? null %}
                                <li class="rams-builder-row" data-field="{{ colField }}">
                                    <span class="rams-builder-row__label">{{ colDef.label ?? colField }}</span>
                                    <input type="hidden" name="columns[{{ loop.index0 }}][field]" value="{{ colField }}">
                                    <label class="rams-sr-only" for="col-agg-{{ loop.index0 }}">Aggregation for {{ colDef.label ?? colField }}</label>
                                    <select id="col-agg-{{ loop.index0 }}" name="columns[{{ loop.index0 }}][aggregation]" class="rams-form__select rams-builder-row__control">
                                        <option value="">None</option>
                                        {% for aggLabel, aggValue in aggregations %}
                                            <option value="{{ aggValue }}" {{ (col.aggregation ?? '')|lower == aggValue ? 'selected' : '' }}>{{ aggLabel }}</option>
                                        {% endfor %}
                                    </select>
                                    <button type="button" class="rams-btn rams-btn--sm rams-builder-row__remove" data-remove
                                            aria-label="Remove {{ colDef.label ?? colField }} from columns">×</button>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                </section>

                <section class="rams-module" aria-labelledby="builder-filters-title">
                    <div class="rams-module__header">
                        <h3 id="builder-filters-title">{{ 'report.filters'|trans }}</h3>
                    </div>
                    <div class="rams-module__content rams-p-2">
                        <ol class="rams-builder-rows" id="report-filters">
                            {% for filter in report.filters %}
                                {% set filterField = filter.field is defined ? filter.field : filter %}
                                {% set filterDef = fields[filterField] ?? null %}
                                {% set fType = filterDef.type ?? 'string' %}
                                <li class="rams-builder-row rams-builder-row--filter" data-field="{{ filterField }}" data-type="{{ fType }}">
                                    <span class="rams-builder-row__label">{{ filterDef.label ?? filterField }}</span>
                                    <input type="hidden" name="filters[{{ loop.index0 }}][field]" value="{{ filterField }}">
                                    <label class="rams-sr-only" for="filter-op-{{ loop.index0 }}">Operator for {{ filterDef.label ?? filterField }}</label>
                                    <select id="filter-op-{{ loop.index0 }}" name="filters[{{ loop.index0 }}][operator]" class="rams-form__select rams-builder-row__control" data-operator-for="{{ filterField }}">
                                        {% for opKey, opLabel in operatorsByType[fType]|default(operatorsByType['string']) %}
                                            <option value="{{ opKey }}" {{ (filter.operator ?? '') == opKey ? 'selected' : '' }}>{{ opLabel }}</option>
                                        {% endfor %}
                                    </select>
                                    {% if fType == 'boolean' %}
                                        <label class="rams-sr-only" for="filter-val-{{ loop.index0 }}">Value for {{ filterDef.label ?? filterField }}</label>
                                        <select id="filter-val-{{ loop.index0 }}" name="filters[{{ loop.index0 }}][value]" class="rams-form__select rams-builder-row__control">
                                            <option value="1" {{ filter.value|default('') == '1' or filter.value|default('') == 1 ? 'selected' : '' }}>Yes</option>
                                            <option value="0" {{ filter.value|default('') == '0' or filter.value|default('') == 0 and filter.value|default('') != '' ? 'selected' : '' }}>No</option>
                                        </select>
                                    {% elseif fType == 'datetime' or fType == 'date' %}
                                        <label class="rams-sr-only" for="filter-val-{{ loop.index0 }}">Value for {{ filterDef.label ?? filterField }}</label>
                                        <input type="date" id="filter-val-{{ loop.index0 }}" name="filters[{{ loop.index0 }}][value]" value="{{ filter.value|default('') }}" class="rams-form__input rams-builder-row__control">
                                    {% elseif fType == 'integer' or fType == 'decimal' %}
                                        <label class="rams-sr-only" for="filter-val-{{ loop.index0 }}">Value for {{ filterDef.label ?? filterField }}</label>
                                        <input type="number" step="any" id="filter-val-{{ loop.index0 }}" name="filters[{{ loop.index0 }}][value]" value="{{ filter.value|default('') }}" class="rams-form__input rams-builder-row__control">
                                    {% else %}
                                        <label class="rams-sr-only" for="filter-val-{{ loop.index0 }}">Value for {{ filterDef.label ?? filterField }}</label>
                                        <input type="text" id="filter-val-{{ loop.index0 }}" name="filters[{{ loop.index0 }}][value]" value="{{ filter.value|default('') }}" class="rams-form__input rams-builder-row__control" placeholder="{{ 'report.value'|trans }}">
                                    {% endif %}
                                    <button type="button" class="rams-btn rams-btn--sm rams-builder-row__remove" data-remove
                                            aria-label="Remove filter on {{ filterDef.label ?? filterField }}">×</button>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                </section>

                <section class="rams-module" aria-labelledby="builder-sorting-title">
                    <div class="rams-module__header">
                        <h3 id="builder-sorting-title">{{ 'report.sorting'|trans }}</h3>
                    </div>
                    <div class="rams-module__content rams-p-2">
                        <ol class="rams-builder-rows" id="report-sorting">
                            {% for sort in report.orderBy %}
                                {% set sortField = sort.field is defined ? sort.field : sort %}
                                {% set sortDef = fields[sortField] ?? null %}
                                <li class="rams-builder-row" data-field="{{ sortField }}">
                                    <span class="rams-builder-row__label">{{ sortDef.label ?? sortField }}</span>
                                    <input type="hidden" name="orderBy[{{ loop.index0 }}][field]" value="{{ sortField }}">
                                    <label class="rams-sr-only" for="sort-dir-{{ loop.index0 }}">Direction for {{ sortDef.label ?? sortField }}</label>
                                    <select id="sort-dir-{{ loop.index0 }}" name="orderBy[{{ loop.index0 }}][direction]" class="rams-form__select rams-builder-row__control">
                                        <option value="ASC" {{ (sort.direction ?? 'ASC')|upper == 'ASC' ? 'selected' : '' }}>{{ 'report.ascending'|trans }}</option>
                                        <option value="DESC" {{ (sort.direction ?? '')|upper == 'DESC' ? 'selected' : '' }}>{{ 'report.descending'|trans }}</option>
                                    </select>
                                    <button type="button" class="rams-btn rams-btn--sm rams-builder-row__remove" data-remove
                                            aria-label="Remove sort on {{ sortDef.label ?? sortField }}">×</button>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                </section>

                {# ── Panel 3: PREVIEW — explicit state, always visible ── #}
                <section class="rams-module" aria-labelledby="builder-preview-title">
                    <div class="rams-module__header">
                        <h3 id="builder-preview-title">Preview</h3>
                        <span class="rams-text--xs rams-text--muted">
                            {% if previewResults.success %}
                                {{ previewResults.data|length > 0 ? 'Showing up to 20 of ' ~ previewResults.meta.totalRows ~ ' matching records' : 'No records match the current configuration' }} — preview shows the last saved configuration.
                            {% else %}
                                Preview unavailable
                            {% endif %}
                        </span>
                    </div>
                    <div class="rams-module__content rams-p-2">
                        {% if not previewResults.success %}
                            <div class="rams-empty-state" role="alert">
                                <p class="rams-empty-state__title">This report can't run yet</p>
                                <p class="rams-empty-state__body">{{ previewResults.error }}</p>
                            </div>
                        {% elseif previewResults.data|length == 0 %}
                            <div class="rams-empty-state">
                                <p class="rams-empty-state__title">No matching records</p>
                                <p class="rams-empty-state__body">
                                    {% if report.filters is not empty %}
                                        The current filters exclude every record. Loosen a filter, or clear it below.
                                    {% else %}
                                        There is no data for this source yet.
                                    {% endif %}
                                </p>
                            </div>
                        {% else %}
                            <div class="rams-table-container">
                                <table class="rams-table" aria-label="Report preview">
                                    <thead>
                                        <tr>
                                            {% for key in previewResults.data[0]|keys %}
                                                <th scope="col">{{ (fields[loop.index0] is defined ? '' : '') }}{{ key|replace({'_': ' '})|title }}</th>
                                            {% endfor %}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in previewResults.data|slice(0, 20) %}
                                            <tr>
                                                {% for value in row %}
                                                    <td class="rams-truncate">{{ value is iterable ? value|json_encode : value }}</td>
                                                {% endfor %}
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </section>

            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    {% set json_hex = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') %}
    document.addEventListener('DOMContentLoaded', function () {
        var fieldTypes = {};
        {% for field in availableFields %}
        fieldTypes[{{ field.property|json_encode(json_hex)|raw }}] = {{ field.type|json_encode(json_hex)|raw }};
        {% endfor %}

        var operatorOptions = {};
        {% for type, ops in operatorsByType %}
        operatorOptions[{{ type|json_encode(json_hex)|raw }}] = {{ ops|json_encode(json_hex)|raw }};
        {% endfor %}

        var labels = {
            remove: {{ 'report.remove'|trans|json_encode(json_hex)|raw }},
            none: 'None'
        };

        function nextIndex(list) {
            return list.querySelectorAll('.rams-builder-row').length;
        }

        function addColumn(field, label) {
            var list = document.getElementById('selected-columns');
            var li = document.createElement('li');
            li.className = 'rams-builder-row';
            li.dataset.field = field;
            var i = nextIndex(list);
            li.innerHTML =
                '<span class="rams-builder-row__label"></span>' +
                '<input type="hidden" name="columns[' + i + '][field]" value="">' +
                '<label class="rams-sr-only" for="col-agg-new-' + i + '">Aggregation</label>' +
                '<select id="col-agg-new-' + i + '" name="columns[' + i + '][aggregation]" class="rams-form__select rams-builder-row__control">' +
                '<option value="">' + labels.none + '</option>' +
                {% for aggLabel, aggValue in aggregations %}'<option value="{{ aggValue }}">{{ aggLabel|e('js') }}</option>' +{% endfor %}
                '</select>' +
                '<button type="button" class="rams-btn rams-btn--sm rams-builder-row__remove" data-remove aria-label="Remove">×</button>';
            li.querySelector('.rams-builder-row__label').textContent = label;
            li.querySelector('input[type=hidden]').value = field;
            list.appendChild(li);
        }

        function addFilter(field, label, type) {
            var list = document.getElementById('report-filters');
            var li = document.createElement('li');
            li.className = 'rams-builder-row rams-builder-row--filter';
            li.dataset.field = field;
            li.dataset.type = type;
            var i = nextIndex(list);
            var ops = operatorOptions[type] || operatorOptions['string'] || {};
            var opOptions = '';
            Object.keys(ops).forEach(function (opKey) {
                opOptions += '<option value="' + opKey + '">' + ops[opKey] + '</option>';
            });
            var control;
            if (type === 'boolean') {
                control = '<label class="rams-sr-only" for="filter-val-new-' + i + '">Value</label>' +
                    '<select id="filter-val-new-' + i + '" name="filters[' + i + '][value]" class="rams-form__select rams-builder-row__control">' +
                    '<option value="1">Yes</option><option value="0">No</option></select>';
            } else if (type === 'datetime' || type === 'date') {
                control = '<label class="rams-sr-only" for="filter-val-new-' + i + '">Value</label>' +
                    '<input type="date" id="filter-val-new-' + i + '" name="filters[' + i + '][value]" class="rams-form__input rams-builder-row__control">';
            } else if (type === 'integer' || type === 'decimal') {
                control = '<label class="rams-sr-only" for="filter-val-new-' + i + '">Value</label>' +
                    '<input type="number" step="any" id="filter-val-new-' + i + '" name="filters[' + i + '][value]" class="rams-form__input rams-builder-row__control">';
            } else {
                control = '<label class="rams-sr-only" for="filter-val-new-' + i + '">Value</label>' +
                    '<input type="text" id="filter-val-new-' + i + '" name="filters[' + i + '][value]" class="rams-form__input rams-builder-row__control">';
            }
            li.innerHTML =
                '<span class="rams-builder-row__label"></span>' +
                '<input type="hidden" name="filters[' + i + '][field]" value="">' +
                '<label class="rams-sr-only" for="filter-op-new-' + i + '">Operator</label>' +
                '<select id="filter-op-new-' + i + '" name="filters[' + i + '][operator]" class="rams-form__select rams-builder-row__control">' + opOptions + '</select>' +
                control +
                '<button type="button" class="rams-btn rams-btn--sm rams-builder-row__remove" data-remove aria-label="Remove">×</button>';
            li.querySelector('.rams-builder-row__label').textContent = label;
            li.querySelector('input[type=hidden]').value = field;
            list.appendChild(li);
        }

        function addSort(field, label) {
            var list = document.getElementById('report-sorting');
            var li = document.createElement('li');
            li.className = 'rams-builder-row';
            li.dataset.field = field;
            var i = nextIndex(list);
            li.innerHTML =
                '<span class="rams-builder-row__label"></span>' +
                '<input type="hidden" name="orderBy[' + i + '][field]" value="">' +
                '<label class="rams-sr-only" for="sort-dir-new-' + i + '">Direction</label>' +
                '<select id="sort-dir-new-' + i + '" name="orderBy[' + i + '][direction]" class="rams-form__select rams-builder-row__control">' +
                '<option value="ASC">Ascending</option><option value="DESC">Descending</option></select>' +
                '<button type="button" class="rams-btn rams-btn--sm rams-builder-row__remove" data-remove aria-label="Remove">×</button>';
            li.querySelector('.rams-builder-row__label').textContent = label;
            li.querySelector('input[type=hidden]').value = field;
            list.appendChild(li);
        }

        // Click-first: explicit add buttons on every field row.
        document.getElementById('available-fields').addEventListener('click', function (e) {
            var btn = e.target.closest('[data-add]');
            if (!btn) { return; }
            var row = btn.closest('.rams-builder-field');
            var field = row.dataset.field;
            var label = row.dataset.label;
            var type = row.dataset.type || 'string';
            if (btn.dataset.add === 'column') { addColumn(field, label); }
            if (btn.dataset.add === 'filter') { addFilter(field, label, type); }
            if (btn.dataset.add === 'sort') { addSort(field, label); }
        });

        // Delegated remove (works for server-rendered and JS-added rows).
        document.getElementById('builder-form').addEventListener('click', function (e) {
            var btn = e.target.closest('[data-remove]');
            if (btn) { btn.closest('.rams-builder-row').remove(); }
        });

        // Search
        document.getElementById('field-search').addEventListener('input', function (e) {
            var term = e.target.value.toLowerCase();
            document.querySelectorAll('#available-fields .rams-builder-field').forEach(function (el) {
                var hit = el.dataset.label.toLowerCase().includes(term) || el.dataset.field.toLowerCase().includes(term);
                el.style.display = hit ? '' : 'none';
            });
        });
    });
</script>
{% endblock %}
