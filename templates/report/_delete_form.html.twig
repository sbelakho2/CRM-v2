<form method="post" action="{{ path('report_delete', {'id': report.id}) }}" onsubmit="return ramsConfirmSubmit(event, '{{ 'report.confirm_delete'|trans }}', {variant: 'danger'})">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ report.id) }}">
    <button type="submit" class="rams-btn rams-btn--danger">{{ 'common.delete'|trans }}</button>
</form>
