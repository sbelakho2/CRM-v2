{% extends 'base.html.twig' %}

{% block title %}{{ report.name }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page__header-content">
            <h1 class="rams-page__title">
                 <svg class="rams-icon rams-icon--lg rams-mr-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 13V7M7 13V4M11 13V9M15 13V2"/>
                 </svg>
                 {{ report.name }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('report_index') }}" class="rams-breadcrumb__item">{{ 'report.title'|trans }}</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ report.name }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <a href="{{ path('report_index') }}" class="rams-btn">{{ 'report.back'|trans }}</a>
             <a href="{{ path('report_builder', {'id': report.id}) }}" class="rams-btn">
                <svg class="rams-icon rams-mr-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2L10 6L14 8L10 10L8 14L6 10L2 8L6 6L8 2Z"/>
                </svg>
                {{ 'report.config_builder'|trans }}
            </a>
             <a href="{{ path('report_edit', {'id': report.id}) }}" class="rams-btn">{{ 'common.settings'|trans }}</a>
             {{ include('report/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="rams-page__container">
        <!-- Summary Stats (if available) -->
        {% if summary is defined and summary|length > 0 %}
        <div class="rams-grid rams-grid--4 rams-mb-6">
            {% for label, value in summary %}
            <div class="rams-stat-card">
                <div class="rams-stat-card__value">{{ value }}</div>
                <div class="rams-stat-card__label">{{ label }}</div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if report.description %}
            <div class="rams-alert rams-alert--info rams-mb-6">
                {{ report.description }}
            </div>
        {% endif %}

        <!-- Chart -->
        {% if chartData is defined and chartData %}
        <div class="rams-module rams-mb-6">
             <div class="rams-module__header">
                <h2>{{ 'report.visualization'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                <div style="height: 400px; width: 100%;">
                    <canvas id="reportChart"></canvas>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Data Table -->
        <div class="rams-module">
            <div class="rams-module__header">
                <h3>{{ 'report.data_records'|trans }} ({{ results|length }})</h3>
                <div class="rams-module__header__actions">
                     <a href="{{ path('report_export', {'id': report.id, 'format': 'csv'}) }}" class="rams-btn rams-btn--sm"> <svg class="rams-icon rams-mr-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"> <path d="M8 2v10M4 6l4-4 4 4M2 14h12"/> </svg> {{   'report.export_csv'|trans }} </a> 
                </div>
            </div>
            <div class="rams-table-container">
                <table class="rams-table" aria-label="{{ 'report.data_records'|trans }}">
                    {% if columns is defined and columns|length > 0 %}
                        <thead>
                            <tr>
                                {% for col in columns %}
                                    <th scope="col">{{ col.label }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in results %}
                                <tr>
                                    {% for col in columns %}
                                        <td>{{ attribute(row, col.property) }}</td>
                                    {% endfor %}
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="{{ columns|length }}" class="rams-text--center rams-py-xl rams-text--muted">{{ 'report.no_results'|trans }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    {% else %}
                        <!-- Fallback if specific columns not defined or unconfigured -->
                        <thead>
                            <tr><th scope="col">{{ 'report.result'|trans }}</th></tr>
                        </thead>
                        <tbody>
                            <tr><td class="rams-text--center rams-py-md rams-text--muted">{{ 'report.use_builder_desc'|trans }}</td></tr>
                        </tbody>
                    {% endif %}
                </table>
            </div>
            <!-- Pagination could go here -->
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% if chartData is defined and chartData %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" integrity="sha384-e6nUZLBkQ86NJ6TVVKAeSaK8jWa3NhkYWZFomE39AvDbQWeie9PlQqM3pmYW5d1g" crossorigin="anonymous"></script> 
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('reportChart');
        if (ctx) {
            new Chart(ctx, {{ chartData|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }});
        }
    });
</script>
{% endif %}
{% endblock %}
