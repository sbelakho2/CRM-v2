{% extends 'base.html.twig' %}

{% block title %}{{ report.name }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page-header">
        <div class="rams-page-header__content">
            <h1 class="rams-page-header__title">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem;"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                 {{ report.name }}
            </h1>
            <nav class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__item">Dashboard</a>
                <span class="rams-breadcrumb__separator">/</span>
                <a href="{{ path('report_index') }}" class="rams-breadcrumb__item">Reports</a>
                <span class="rams-breadcrumb__separator">/</span>
                <span class="rams-breadcrumb__item active">{{ report.name }}</span>
            </nav>
        </div>
        <div class="rams-page-header__actions">
             <a href="{{ path('report_index') }}" class="rams-btn">Back</a>
             <a href="{{ path('report_builder', {'id': report.id}) }}" class="rams-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                Config Builder
            </a>
             <a href="{{ path('report_edit', {'id': report.id}) }}" class="rams-btn">Settings</a>
             {{ include('report/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="rams-page-content">
        <!-- Summary Stats (if available) -->
        {% if summary is defined and summary|length > 0 %}
        <div class="rams-grid rams-grid--4 rams-mb-6">
            {% for label, value in summary %}
            <div class="rams-stat-card">
                <div class="rams-stat-card__value">{{ value }}</div>
                <div class="rams-stat-card__label">{{ label }}</div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if report.description %}
            <div class="rams-alert rams-alert--info rams-mb-6">
                {{ report.description }}
            </div>
        {% endif %}

        <!-- Chart -->
        {% if chartData is defined and chartData %}
        <div class="rams-module rams-mb-6">
             <div class="rams-module__header">
                <h3>Visualization</h3>
            </div>
            <div class="rams-module__content">
                <div style="height: 400px; width: 100%;">
                    <canvas id="reportChart"></canvas>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Data Table -->
        <div class="rams-module">
            <div class="rams-module__header">
                <h3>Data Records ({{ results|length }})</h3>
                <div class="rams-module__header__actions">
                     <button class="rams-btn-sm">Export CSV</button>
                </div>
            </div>
            <div class="rams-table-container">
                <table class="rams-table">
                    {% if columns is defined and columns|length > 0 %}
                        <thead>
                            <tr>
                                {% for col in columns %}
                                    <th>{{ col.label }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in results %}
                                <tr>
                                    {% for col in columns %}
                                        <td>{{ attribute(row, col.property) }}</td>
                                    {% endfor %}
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="{{ columns|length }}" class="rams-text--center rams-py-8 rams-text--muted">No results found</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    {% else %}
                        <!-- Fallback if specific columns not defined or unconfigured -->
                        <thead>
                            <tr><th>Result</th></tr>
                        </thead>
                        <tbody>
                            <tr><td class="rams-text--center rams-py-4 rams-text--muted">Use the Builder to configure columns.</td></tr>
                        </tbody>
                    {% endif %}
                </table>
            </div>
            <!-- Pagination could go here -->
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% if chartData is defined and chartData %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('reportChart');
        if (ctx) {
            new Chart(ctx, {{ chartData|json_encode|raw }});
        }
    });
</script>
{% endif %}
{% endblock %}
