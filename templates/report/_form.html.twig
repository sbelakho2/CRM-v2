{{ form_start(form, {'attr': {'class': 'rams-form'}}) }}
    <div class="rams-grid">
        <div class="rams-grid rams-grid--2">
            <!-- Basic Settings -->
            <div class="rams-module">
                <div class="rams-module__header">
                     <h3>{{ 'report.details'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-form__group">
                        {{ form_label(form.name, null, {'label_attr': {'class': 'rams-form__label'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.name) }}
                    </div>
                    
                    <div class="rams-form__group">
                        {{ form_label(form.description, null, {'label_attr': {'class': 'rams-form__label'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'rams-form__textarea', 'rows': '3'}}) }}
                        {{ form_errors(form.description) }}
                    </div>
                </div>
            </div>

            <!-- Configuration -->
            <div class="rams-module">
                <div class="rams-module__header">
                    <h3>{{ 'report.configuration'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-grid--2">
                            <div class="rams-form__group">
                                {{ form_label(form.dataSource, 'report.data_source'|trans, {'label_attr': {'class': 'rams-form__label'}}) }}
                                {{ form_widget(form.dataSource, {'attr': {'class': 'rams-form__select'}}) }}
                                <div class="rams-form__hint">{{ 'report.data_source_help'|trans }}</div>
                                {{ form_errors(form.dataSource) }}
                            </div>

                         <div class="rams-form__group">
                             {{ form_label(form.reportType, null, {'label_attr': {'class': 'rams-form__label'}}) }}
                             {{ form_widget(form.reportType, {'attr': {'class': 'rams-form__select'}}) }}
                             <div class="rams-form__hint">{{ 'report.visualization_help'|trans }}</div>
                             {{ form_errors(form.reportType) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="rams-grid">
             <!-- Options -->
             <div class="rams-module">
                <div class="rams-module__header">
                    <h3>{{ 'report.options'|trans }}</h3>
                </div>
                <div class="rams-module__content">
                    <div class="rams-form__group">
                        <label class="rams-form__checkbox">
                            {{ form_widget(form.isPublic) }}
                            <span class="rams-form__checkbox-label">{{ 'report.public_report'|trans }}</span>
                        </label>
                        <div class="rams-form__hint rams-text--xs rams-mt-1">{{ 'report.visible_to_all'|trans }}</div>
                    </div>
                    
                     <div class="rams-form__group">
                        <label class="rams-form__checkbox">
                            {{ form_widget(form.isFavorite) }}
                            <span class="rams-form__checkbox-label">{{ 'report.add_to_favorites'|trans }}</span>
                        </label>
                    </div>
                </div>
                <div class="rams-module__footer">
                     <button class="rams-btn rams-btn--primary rams-w-full">{{ button_label|default('report.save_report'|trans) }}</button>
                </div>
             </div>
        </div>
    </div>
{{ form_end(form) }}
