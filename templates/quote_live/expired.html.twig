<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'quote.live.expired.title'|trans }}</title>
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    {# Page-specific layout - component styles are in sensei-rams.css (Section 45) #}
    <style>
        body { 
            background: var(--rams-bg-tertiary); 
            min-height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
        }
    </style>
</head>
<body>
    <div class="rams-expired-card rams-module">
        <div class="rams-module__header rams-module__header--danger">
            <div class="rams-andon rams-andon--danger rams-mr-3">
                <span class="rams-andon__light"></span>
            </div>
            <h2 class="rams-heading rams-heading--2 rams-text--white">{{ 'quote.live.expired.heading'|trans }}</h2>
        </div>
        
        <div class="rams-module__content">
            <p class="rams-text rams-text--lg rams-text--muted rams-mb-lg">
                {{ message ?? 'quote.live.expired.message'|trans }}
            </p>
            
            <div class="rams-module rams-module--nested rams-module--muted rams-mb-lg rams-text--left">
                <div class="rams-module__content">
                    <p class="rams-text rams-text--bold rams-mb-sm">{{ 'quote.live.expired.what_happened'|trans }}</p>
                    <ul class="rams-list rams-list--bullet rams-stack rams-gap-2">
                        <li class="rams-list__item">
                            <span class="rams-text--warning font-mono text-2xs">[EXP]</span> {{ 'quote.live.expired.reason_expired'|trans }}
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-text--info font-mono text-2xs">[OFF]</span> {{ 'quote.live.expired.reason_deactivated'|trans }}
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-text--success font-mono text-2xs">[ACC]</span> {{ 'quote.live.expired.reason_accepted'|trans }}
                        </li>
                    </ul>
                </div>
            </div>
            
            <p class="rams-text rams-text--sm rams-text--muted rams-mb-lg">
                {{ 'quote.live.expired.contact_hint'|trans }}
            </p>
            
            <a href="mailto:sales@starzcrm.com" class="rams-btn rams-btn--primary rams-btn--lg rams-btn--block uppercase">
                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                {{ 'quote.live.contact_sales'|trans }}
            </a>
        </div>
        
        <div class="rams-module__footer rams-module__footer--muted">
            <small class="rams-text rams-text--sm rams-text--muted rams-flex rams-items-center rams-justify-center rams-gap-2">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                {{ 'quote.live.expired.security_note'|trans }}
            </small>
        </div>
    </div>
</body>
</html>
