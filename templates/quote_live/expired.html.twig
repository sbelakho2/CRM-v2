<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'quote.live.expired.title'|trans }}</title>
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    {# Page-specific layout - component styles are in sensei-rams.css (Section 45) #}
    <style>
        body { 
            background: var(--rams-bg-tertiary, #f5f5f5); 
            min-height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
        }
    </style>
</head>
<body>
    <div class="rams-expired-card rams-module">
        <div class="rams-module__header rams-module__header--danger">
            <div class="rams-expired-icon">⚠️</div>
            <h2 class="rams-heading rams-heading--2 rams-text--white">{{ 'quote.live.expired.heading'|trans }}</h2>
        </div>
        
        <div class="rams-module__content">
            <p class="rams-text rams-text--lg rams-text--muted rams-mb-lg">
                {{ message ?? 'quote.live.expired.message'|trans }}
            </p>
            
            <div class="rams-module rams-module--nested rams-module--muted rams-mb-lg rams-text--left">
                <div class="rams-module__content">
                    <p class="rams-text rams-text--bold rams-mb-sm">{{ 'quote.live.expired.what_happened'|trans }}</p>
                    <ul class="rams-list">
                        <li class="rams-list__item">
                            <span class="rams-text--warning">🕐</span> {{ 'quote.live.expired.reason_expired'|trans }}
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-text--info">🔗</span> {{ 'quote.live.expired.reason_deactivated'|trans }}
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-text--success">✓</span> {{ 'quote.live.expired.reason_accepted'|trans }}
                        </li>
                    </ul>
                </div>
            </div>
            
            <p class="rams-text rams-text--sm rams-text--muted rams-mb-lg">
                {{ 'quote.live.expired.contact_hint'|trans }}
            </p>
            
            <a href="mailto:sales@starzcrm.com" class="rams-btn rams-btn--primary rams-btn--lg rams-btn--block">
                ✉️ {{ 'quote.live.contact_sales'|trans }}
            </a>
        </div>
        
        <div class="rams-module__footer rams-module__footer--muted">
            <small class="rams-text rams-text--sm rams-text--muted">
                🔒 {{ 'quote.live.expired.security_note'|trans }}
            </small>
        </div>
    </div>
</body>
</html>
