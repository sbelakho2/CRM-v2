{% extends 'base_login.html.twig' %}

{% block title %}{{ 'quote.live.title'|trans }} {{ quote.quoteNumber }}{% endblock %}

{% block body %}
    <div class="rams-page">
        <div class="rams-module">
            {# Header #}
            <div class="rams-module__header rams-bg-chassis">
                <div class="rams-module__header--row">
                    <div>
                        <h2 class="rams-heading rams-heading--2 rams-text--white">{{ 'quote.live.title'|trans }} {{ quote.quoteNumber }}</h2>
                        <p class=" rams-text--white-muted">{{ 'quote.live.for'|trans }}: {{ company_name ?? 'N/A' }}</p>
                    </div>
                    <div class="rams-text--right">
                        <span class="rams-dymo rams-text--white-muted">{{ 'quote.live.valid_until'|trans }}</span>
                        <p class=" rams-text--white rams-text--bold">{{ tierPricing.valid_until }}</p>
                    </div>
                </div>
            </div>

            <div class="rams-module__content">
                {# Summary Info #}
                <div class="rams-grid rams-grid--3 rams-gap-4 rams-mb-lg">
                    <div class="rams-text--center">
                        <span class="rams-dymo">{{ 'quote.copilot.bom_lines'|trans }}</span>
                        <p class="rams-metric rams-metric--lg">{{ tierPricing.bom_line_count }}</p>
                    </div>
                    <div class="rams-text--center">
                        <span class="rams-dymo">{{ 'quote.currency'|trans }}</span>
                        <p class="rams-metric rams-metric--lg">{{ tierPricing.currency }}</p>
                    </div>
                    <div class="rams-text--center">
                        <span class="rams-dymo">{{ 'quote.live.base_quantity'|trans }}</span>
                        <p class="rams-metric rams-metric--lg">{{ tierPricing.base_quantity|number_format }}</p>
                    </div>
                </div>

                {# Quantity Tier Selection #}
                <h3 class="rams-heading rams-heading--4 rams-mb-sm">{{ 'quote.live.select_quantity'|trans }}</h3>
                <p class=" rams-text--sm rams-text--muted rams-mb-md">{{ 'quote.live.select_quantity_hint'|trans }}</p>

                <div class="rams-grid rams-grid--4 rams-gap-2 rams-mb-lg" id="tierCards">
                    {% for tier in tierPricing.tiers %}
                        <div class="rams-module rams-module--compact rams-module--hoverable{% if loop.first %} rams-module--hoverable--selected{% endif %}" 
                             data-quantity="{{ tier.quantity }}"
                             role="button" tabindex="0" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}" onclick="selectTier(this, {{ tier.quantity }})" onkeydown="tierKeydown(event, this, {{ tier.quantity }})">
                            {% if tier.savings_vs_minimum.percent > 0 %}
                                <span class="rams-badge rams-badge--green rams-badge--small"> 
                                    ↓ {{ tier.savings_vs_minimum.percent }}%
                                </span>
                            {% endif %}
                            <div class="rams-module__content rams-text--center">
                                <p class="rams-metric rams-text--xl rams-font-bold">{{  tier.quantity|number_format }}</p>
                                <span class=" rams-text--xs rams-text--muted">{{ 'quote.live.units'|trans }}</span>
                                <div class="rams-text--xl rams-text--success">{{ tier.unit_price|format_currency(tierPricing.currency, tierPricing.currency, 4) }}</div>
                                <span class=" rams-text--xs rams-text--muted">{{ 'quote.live.per_unit'|trans }}</span>
                                <hr class="rams-border-t rams-mb-md rams-mt-md"> 
                                <p class=" rams-text--bold rams-text--success">{{ tier.extended_price|format_currency(tierPricing.currency, tierPricing.currency, 2) }}</p>
                                <span class=" rams-text--xs rams-text--muted">{{ 'common.total'|trans|lower }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Selected Tier Details #}
                <div class="rams-module rams-module--inset rams-module--inset rams-mb-lg" id="tierDetails">
                    <div class="rams-module__content">
                        <div class="rams-grid rams-grid--2 rams-gap-6">
                            <div>
                                <h4 class="rams-heading rams-heading--4">{{ 'quote.live.selected'|trans }}: <span id="selectedQty">{{ tierPricing.tiers[0].quantity|number_format }}</span> {{ 'quote.live.units'|trans }}</h4>
                                <dl class="rams-definition-list rams-definition-list">
                                    <div class="rams-definition-list__item">
                                        <dt class="rams-definition-list__term">{{ 'quote.live.unit_price'|trans }}:</dt>
                                        <dd class="rams-definition-list__desc rams-text--bold" id="selectedUnitPrice">{{ tierPricing.tiers[0].unit_price|format_currency(tierPricing.currency, tierPricing.currency, 4) }}</dd>
                                    </div>
                                    <div class="rams-definition-list__item">
                                        <dt class="rams-definition-list__term">{{ 'quote.live.extended_price'|trans }}:</dt>
                                        <dd class="rams-definition-list__desc rams-text--bold rams-text--success" id="selectedExtended">{{ tierPricing.tiers[0].extended_price|format_currency(tierPricing.currency, tierPricing.currency, 2) }}</dd>
                                    </div>
                                    <div class="rams-definition-list__item">
                                        <dt class="rams-definition-list__term">{{ 'quote.live.stock_status'|trans }}:</dt>
                                        <dd class="rams-definition-list__desc" id="selectedStock">
                                            <span class="rams-badge rams-badge--{% if tierPricing.tiers[0].stock_status == 'all_in_stock' %}green{% else %}yellow{% endif %}">
                                                {{ tierPricing.tiers[0].stock_status|replace({'_': ' '})|title }}
                                            </span>
                                        </dd>
                                    </div>
                                </dl>
                            </div>
                            <div>
                                <h5 class="rams-heading rams-heading--4">{{ 'quote.live.lead_time'|trans }}</h5>
                                <div id="leadTimeInfo">
                                    {% set lt = tierPricing.tiers[0].lead_time_estimate %}
                                    <div class="rams-mb-sm">
                                        <span class=" rams-text--bold">{{ lt.total_days }} {{ 'quote.live.days'|trans }}</span>
                                        <span class=" rams-text--sm rams-text--muted">({{ 'quote.live.est'|trans }} {{ lt.estimate_date }})</span>
                                    </div>
                                    <div class="rams-progress rams-progress--compact rams-mb-sm">
                                        <div class="rams-progress__bar rams-progress__bar--{% if lt.confidence == 'high' %}fast{% elseif lt.confidence == 'medium' %}medium{% else %}slow{% endif %}"></div>
                                    </div>
                                    <span class=" rams-text--xs rams-text--muted">
                                        {{ 'quote.live.procurement'|trans }}: {{ lt.procurement_days }}d | {{ 'quote.live.assembly'|trans }}: {{ lt.assembly_days }}d
                                    </span>
                                </div>
                            </div>
                        </div>

                        {# Price Break Recommendation #}
                        {% if tierPricing.tiers[0].next_break is defined %}
                            <div class="rams-alert rams-alert--info rams-mt-md" id="priceBreakTip">
                                <div class="rams-alert__icon">
                                    <div class="rams-andon rams-andon--info"><span class="rams-andon__light"></span></div>
                                </div>
                                <div class="rams-alert__content">
                                    <span class="rams-alert__title">{{ 'quote.live.tip'|trans }}</span>
                                    <p class="rams-alert__text">
                                        {{ 'quote.live.order'|trans }} <span id="additionalQty">{{ tierPricing.tiers[0].next_break.additional_qty }}</span> {{ 'quote.live.more_units'|trans }} 
                                        ({{ 'common.total'|trans|lower }} <span id="nextBreakQty">{{ tierPricing.tiers[0].next_break.quantity }}</span>) 
                                        {{ 'quote.live.and_save'|trans }} <span id="savingsPerUnit">{{ tierPricing.tiers[0].next_break.savings_per_unit|format_currency(tierPricing.currency, tierPricing.currency, 4) }}</span>/{{ 'quote.live.unit'|trans }}!
                                    </p>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Action Buttons #}
                <div class="rams-form__actions rams-form__actions">
                    <button class="rams-btn rams-btn--lg" onclick="requestCustomQuote()">
                        💬 {{ 'quote.live.request_changes'|trans }}
                    </button>
                    <button class="rams-btn rams-btn--primary rams-btn--lg" onclick="acceptQuote()">
                        ✓ {{ 'quote.live.accept'|trans }}
                    </button>
                </div>

                {# Contact Info #}
                <div class="rams-text--center rams-mt-lg">
                    <p class=" rams-text--sm rams-text--muted">
                        {{ 'quote.live.questions'|trans }}
                        <a href="mailto:{{ 'quote.live.support_email_address'|trans }}" class="rams-link">{{ 'quote.live.support_email_label'|trans }}</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# Request Quote Modal #}
    <div class="rams-modal rams-modal--hidden" id="requestModal" role="dialog" aria-modal="true" aria-labelledby="requestModalTitle"> 
        <div class="rams-modal__backdrop" onclick="closeModal('requestModal')"></div>
        <div class="rams-modal__content">
            <div class="rams-modal__header">
                <h5 class="rams-heading rams-heading--3" id="requestModalTitle">{{  'quote.live.request_custom_quote'|trans }}</h5>
            </div>
            <div class="rams-modal__body">
                <form id="requestForm" onsubmit="event.preventDefault(); submitRequest()"> 
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'quote.live.desired_quantity'|trans }}</label>
                        <input type="number" class="rams-form__input" id="requestQty" required>
                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'common.notes'|trans }} ({{ 'common.optional'|trans|lower }})</label>
                        <textarea class="rams-form__textarea" id="requestNotes" rows="3" 
                                  placeholder="{{ 'quote.live.notes_placeholder'|trans }}"></textarea>
                    </div>
                </form>
            </div>
            <div class="rams-modal__footer">
                <button type="button" class="rams-btn" onclick="closeModal('requestModal')">{{ 'common.cancel'|trans }}</button>
                <button type="button" class="rams-btn rams-btn--primary" onclick="submitRequest()">{{ 'common.submit'|trans }}</button>
            </div>
        </div>
    </div>

    {# Accept Quote Modal #}
    <div class="rams-modal rams-modal--hidden" id="acceptModal" role="dialog" aria-modal="true" aria-labelledby="acceptModalTitle"> 
        <div class="rams-modal__backdrop" onclick="closeModal('acceptModal')"></div>
        <div class="rams-modal__content">
            <div class="rams-modal__header rams-modal__header">
                <h5 class="rams-heading rams-heading--3 rams-text--white" id="acceptModalTitle">✓  {{ 'quote.live.accept'|trans }}</h5>
            </div>
            <div class="rams-modal__body">
                <p class=" rams-mb-md">
                    {{ 'quote.live.accepting_for'|trans }} <strong id="acceptQtyDisplay">-</strong> {{ 'quote.live.at'|trans }} <strong id="acceptPriceDisplay">-</strong>.
                </p>
                <form id="acceptForm" onsubmit="event.preventDefault(); submitAcceptance()"> 
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'auth.full_name'|trans }} *</label>
                        <input type="text" class="rams-form__input" id="acceptName" required>
                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'common.email'|trans }} *</label>
                        <input type="email" class="rams-form__input" id="acceptEmail" required>
                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'common.phone'|trans }}</label>
                        <input type="tel" class="rams-form__input" id="acceptPhone">
                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'quote.live.po_number'|trans }} ({{ 'quote.live.if_available'|trans }})</label>
                        <input type="text" class="rams-form__input" id="acceptPO">
                    </div>
                </form>
            </div>
            <div class="rams-modal__footer">
                <button type="button" class="rams-btn" onclick="closeModal('acceptModal')">{{ 'common.cancel'|trans }}</button>
                <button type="button" class="rams-btn rams-btn--primary" onclick="submitAcceptance()">
                    ✓ {{ 'quote.live.confirm_acceptance'|trans }}
                </button>
            </div>
        </div>
    </div>

    {% include 'components/alert_modal.html.twig' %}

{% endblock %}

{% block javascripts %}
    <script>
        const token = '{{ token }}'; const csrfToken = '{{ csrf_token('quote_live') }}';
        const liveRequestUrl = '{{ path('quote_live_request', {token: '__TOKEN__'}) }}'.replace('__TOKEN__', token);
        const liveAcceptUrl = '{{ path('quote_live_accept', {token: '__TOKEN__'}) }}'.replace('__TOKEN__', token);
        const tierData = {{ tierPricing.tiers|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
        const currencySymbol = '{{ currency_symbol(tierPricing.currency)|e('js') }}';
        const currencyNeedsSpace = {{ tierPricing.currency in ['MAD', 'TND'] ? 'true' : 'false' }};
        const stockAllInLabel = '{{ 'quote.live.stock_all_in'|trans|e('js') }}';
        const stockPartialLabel = '{{ 'quote.live.stock_partial'|trans|e('js') }}';
        const i18n = {
            daysLabel: '{{ 'quote.live.days_label'|trans|e('js') }}',
            daysShort: '{{ 'quote.live.days_short'|trans|e('js') }}',
            estimateLabel: '{{ 'quote.live.estimate_label'|trans|e('js') }}',
            procurementLabel: '{{ 'quote.live.procurement_label'|trans|e('js') }}',
            assemblyLabel: '{{ 'quote.live.assembly_label'|trans|e('js') }}',
            unitsLabel: '{{ 'quote.live.units_label'|trans|e('js') }}',
            requestSubmitted: '{{ 'quote.live.request_submitted'|trans|e('js') }}',
            requestError: '{{ 'quote.live.request_error'|trans|e('js') }}',
            acceptedTitle: '{{ 'quote.live.accepted_title'|trans|e('js') }}',
            errorLabel: '{{ 'common.error'|trans|e('js') }}'
        };
        let selectedQuantity = tierData[0].quantity;

        function formatCurrency(value, decimals) {
            const formatted = value.toLocaleString(undefined, {
                minimumFractionDigits: decimals,
                maximumFractionDigits: decimals
            });
            return currencyNeedsSpace ? `${currencySymbol} ${formatted}` : `${currencySymbol}${formatted}`;
        }
        
        function selectTier(element, quantity) {
            document.querySelectorAll('.rams-module--compact.rams-module--hoverable').forEach(card    => { card.classList.remove('rams-module--hoverable--selected'); card.setAttribute('aria-pressed', 'false'); }); element.classList.add('rams-module--hoverable--selected'); element.setAttribute('aria-pressed', 'true');   
              
            
            const tier = tierData.find(t => t.quantity === quantity);
            if (!tier) return;
            
            selectedQuantity = quantity;
            
            document.getElementById('selectedQty').textContent = quantity.toLocaleString();
            document.getElementById('selectedUnitPrice').textContent = formatCurrency(tier.unit_price, 4);
            document.getElementById('selectedExtended').textContent = formatCurrency(tier.extended_price, 2);
            
            const stockBadge = tier.stock_status === 'all_in_stock' 
                ? `<span class="rams-badge rams-badge--green">${stockAllInLabel}</span>`
                : `<span class="rams-badge rams-badge--yellow">${stockPartialLabel}</span>`;
            document.getElementById('selectedStock').innerHTML = stockBadge;
            
            const lt = tier.lead_time_estimate;
            const ltClass = lt.confidence === 'high' ? 'fast' : lt.confidence === 'medium' ? 'medium' : 'slow';
            document.getElementById('leadTimeInfo').innerHTML = `
                <div class="rams-mb-sm">
                    <span class=" rams-text--bold">${lt.total_days} ${i18n.daysLabel}</span>
                    <span class=" rams-text--sm rams-text--muted">(${i18n.estimateLabel} ${lt.estimate_date})</span>
                </div>
                <div class="rams-progress rams-progress--compact rams-mb-sm">
                    <div class="rams-progress__bar rams-progress__bar--${ltClass}"></div>
                </div>
                <span class=" rams-text--xs rams-text--muted">${i18n.procurementLabel}: ${lt.procurement_days}${i18n.daysShort} | ${i18n.assemblyLabel}: ${lt.assembly_days}${i18n.daysShort}</span>
            `;
            
            const tipEl = document.getElementById('priceBreakTip');
            if (tier.next_break) {
                tipEl.style.display = 'block';
                document.getElementById('additionalQty').textContent = tier.next_break.additional_qty;
                document.getElementById('nextBreakQty').textContent = tier.next_break.quantity;
                document.getElementById('savingsPerUnit').textContent = formatCurrency(tier.next_break.savings_per_unit, 4);
            } else if (tipEl) {
                tipEl.style.display = 'none';
            }
        }
        
        let lastFocused = null; function openModal(modalId) { const modal = document.getElementById(modalId); lastFocused = document.activeElement; modal.classList.remove('rams-modal--hidden'); const focusTarget = modal.querySelector('input, textarea, select, button:not(.rams-modal__close)'); if (focusTarget) focusTarget.focus(); } function closeModal(modalId) {
            const modal = document.getElementById(modalId); modal.classList.add('rams-modal--hidden'); if (lastFocused && typeof lastFocused.focus === 'function') { lastFocused.focus(); lastFocused = null; 
        }
        
        }
        function tierKeydown(event, element, quantity) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                selectTier(element, quantity);
            }
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const open = document.querySelector('.rams-modal:not(.rams-modal--hidden)');
                if (open) closeModal(open.id);
            }
            if (e.key === 'Tab') {
                const modal = document.querySelector('.rams-modal:not(.rams-modal--hidden)');
                if (!modal) return;
                const focusables = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
                if (focusables.length === 0) return;
                const first = focusables[0];
                const last = focusables[focusables.length - 1];
                if (e.shiftKey && document.activeElement === first) {
                    e.preventDefault();
                    last.focus();
                } else if (!e.shiftKey && document.activeElement === last) {
                    e.preventDefault();
                    first.focus();
                }
            }
        });
        function requestCustomQuote() {
            document.getElementById('requestQty').value = selectedQuantity;
            openModal('requestModal'); 
        }
        
        function acceptQuote() {
            const tier = tierData.find(t => t.quantity === selectedQuantity);
            document.getElementById('acceptQtyDisplay').textContent = `${selectedQuantity.toLocaleString()} ${i18n.unitsLabel}`;
            document.getElementById('acceptPriceDisplay').textContent = formatCurrency(tier.extended_price, 2);
            openModal('acceptModal'); 
        }
        
        function submitRequest() {
            const form = document.getElementById('requestForm'); if (!form.reportValidity()) return; const quantity = document.getElementById('requestQty').value;
            const notes = document.getElementById('requestNotes').value;
            
            fetch(liveRequestUrl, {
                method: 'POST',
                headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken}, 
                body: JSON.stringify({quantity: parseInt(quantity), notes: notes})
            })
            .then(response => response.json())
            .then(data => {
                closeModal('requestModal');
                ramsAlert(data.message || i18n.requestSubmitted, {variant: 'success'});
            })
            .catch(error => ramsAlert(`${i18n.requestError}: ${error.message}`, {variant: 'error'}));
        }
        
        function submitAcceptance() {
            const form = document.getElementById('acceptForm'); if (!form.reportValidity()) return; const data = {
                quantity: selectedQuantity,
                name: document.getElementById('acceptName').value,
                email: document.getElementById('acceptEmail').value,
                phone: document.getElementById('acceptPhone').value,
                po_number: document.getElementById('acceptPO').value
            };
            
            fetch(liveAcceptUrl, {
                method: 'POST',
                headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken}, 
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                closeModal('acceptModal');
                const container = document.querySelector('.rams-module__content'); 
                const div = document.createElement('div');
                div.className = 'rams-text--center rams-py-xl';
                
                const check = document.createElement('div');
                check.className = 'rams-text--success rams-text-6xl';
                check.textContent = '✓';
                div.appendChild(check);
                
                const title = document.createElement('h2');
                title.className = 'rams-heading rams-heading--2 rams-mt-md';
                title.textContent = i18n.acceptedTitle;
                div.appendChild(title);
                
                const msg = document.createElement('p');
                msg.className = '  rams-text--muted';
                msg.textContent = result.message;
                div.appendChild(msg);
                
                const ul = document.createElement('ul');
                ul.className = 'rams-list  rams-text--left rams-mx-auto';
                ul.style.maxWidth = '400px';
                if (result.next_steps) {
                    result.next_steps.forEach(s => {
                        const li = document.createElement('li');
                        li.className = 'rams-list__item';
                        li.textContent = '✓ ' + s;
                        ul.appendChild(li);
                    });
                }
                div.appendChild(ul);
                
                container.innerHTML = '';
                container.appendChild(div);
            })
            .catch(error => ramsAlert(`${i18n.errorLabel}: ${error.message}`, {variant: 'error'}));
        }
    </script>
{% endblock %}
