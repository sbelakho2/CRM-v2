<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'quote.live.title'|trans }} {{ quote.quoteNumber }}</title>
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    {# Page-specific overrides - component styles are in sensei-rams.css (Sections 44-45) #}
    <style>
        body { background: var(--rams-bg-tertiary, #f5f5f5); min-height: 100vh; }
        .rams-quote-card { max-width: 1000px; margin: 0 auto; }
    </style>
</head>
<body>
    <div class="rams-container rams-py-lg">
        <div class="rams-quote-card rams-module">
            {# Header #}
            <div class="rams-module__header rams-module__header--primary">
                <div class="rams-module__header--row">
                    <div>
                        <h2 class="rams-heading rams-heading--2 rams-text--white">{{ 'quote.live.title'|trans }} {{ quote.quoteNumber }}</h2>
                        <p class="rams-text rams-text--white-muted">{{ 'quote.live.for'|trans|default('For') }}: {{ quote.company.name }}</p>
                    </div>
                    <div class="rams-text--right">
                        <span class="rams-dymo rams-text--white-muted">{{ 'quote.live.valid_until'|trans }}</span>
                        <p class="rams-text rams-text--white rams-text--bold">{{ tierPricing.valid_until }}</p>
                    </div>
                </div>
            </div>

            <div class="rams-module__content">
                {# Summary Info #}
                <div class="rams-grid rams-grid--cols-3 rams-grid--gap-md rams-mb-lg">
                    <div class="rams-text--center">
                        <span class="rams-dymo">{{ 'quote.copilot.bom_lines'|trans|default('BOM Lines') }}</span>
                        <p class="rams-metric rams-metric--lg">{{ tierPricing.bom_line_count }}</p>
                    </div>
                    <div class="rams-text--center">
                        <span class="rams-dymo">{{ 'quote.currency'|trans }}</span>
                        <p class="rams-metric rams-metric--lg">{{ tierPricing.currency }}</p>
                    </div>
                    <div class="rams-text--center">
                        <span class="rams-dymo">{{ 'quote.live.base_quantity'|trans|default('Base Quantity') }}</span>
                        <p class="rams-metric rams-metric--lg">{{ tierPricing.base_quantity|number_format }}</p>
                    </div>
                </div>

                {# Quantity Tier Selection #}
                <h5 class="rams-heading rams-heading--4 rams-mb-sm">{{ 'quote.live.select_quantity'|trans }}</h5>
                <p class="rams-text rams-text--sm rams-text--muted rams-mb-md">{{ 'quote.live.select_quantity_hint'|trans|default('Click a quantity tier to see pricing. Higher quantities unlock better unit prices.') }}</p>

                <div class="rams-grid rams-grid--cols-4 rams-grid--gap-sm rams-mb-lg" id="tierCards">
                    {% for tier in tierPricing.tiers %}
                        <div class="rams-tier-card rams-module rams-module--compact {% if loop.first %}rams-tier-card--selected{% endif %}" 
                             data-quantity="{{ tier.quantity }}"
                             onclick="selectTier(this, {{ tier.quantity }})">
                            {% if tier.savings_vs_minimum.percent > 0 %}
                                <span class="rams-savings-badge rams-badge rams-badge--green rams-badge--sm">
                                    ↓ {{ tier.savings_vs_minimum.percent }}%
                                </span>
                            {% endif %}
                            <div class="rams-module__content rams-text--center">
                                <p class="rams-metric rams-metric--md">{{ tier.quantity|number_format }}</p>
                                <span class="rams-text rams-text--xs rams-text--muted">{{ 'quote.live.units'|trans|default('units') }}</span>
                                <div class="rams-price-highlight">{{ tier.unit_price|format_currency(tierPricing.currency, tierPricing.currency, 4) }}</div>
                                <span class="rams-text rams-text--xs rams-text--muted">{{ 'quote.live.per_unit'|trans|default('per unit') }}</span>
                                <hr class="rams-divider">
                                <p class="rams-text rams-text--bold rams-text--success">{{ tier.extended_price|format_currency(tierPricing.currency, tierPricing.currency, 2) }}</p>
                                <span class="rams-text rams-text--xs rams-text--muted">{{ 'common.total'|trans|lower }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Selected Tier Details #}
                <div class="rams-module rams-module--nested rams-module--muted rams-mb-lg" id="tierDetails">
                    <div class="rams-module__content">
                        <div class="rams-grid rams-grid--cols-2 rams-grid--gap-lg">
                            <div>
                                <h5 class="rams-heading rams-heading--4">{{ 'quote.live.selected'|trans|default('Selected') }}: <span id="selectedQty">{{ tierPricing.tiers[0].quantity|number_format }}</span> {{ 'quote.live.units'|trans|default('units') }}</h5>
                                <dl class="rams-definition-list rams-definition-list--compact">
                                    <div class="rams-definition-list__item">
                                        <dt class="rams-definition-list__term">{{ 'quote.live.unit_price'|trans }}:</dt>
                                        <dd class="rams-definition-list__desc rams-text--bold" id="selectedUnitPrice">{{ tierPricing.tiers[0].unit_price|format_currency(tierPricing.currency, tierPricing.currency, 4) }}</dd>
                                    </div>
                                    <div class="rams-definition-list__item">
                                        <dt class="rams-definition-list__term">{{ 'quote.live.extended_price'|trans }}:</dt>
                                        <dd class="rams-definition-list__desc rams-text--bold rams-text--success" id="selectedExtended">{{ tierPricing.tiers[0].extended_price|format_currency(tierPricing.currency, tierPricing.currency, 2) }}</dd>
                                    </div>
                                    <div class="rams-definition-list__item">
                                        <dt class="rams-definition-list__term">{{ 'quote.live.stock_status'|trans|default('Stock Status') }}:</dt>
                                        <dd class="rams-definition-list__desc" id="selectedStock">
                                            <span class="rams-badge rams-badge--{% if tierPricing.tiers[0].stock_status == 'all_in_stock' %}green{% else %}yellow{% endif %}">
                                                {{ tierPricing.tiers[0].stock_status|replace({'_': ' '})|title }}
                                            </span>
                                        </dd>
                                    </div>
                                </dl>
                            </div>
                            <div>
                                <h5 class="rams-heading rams-heading--4">{{ 'quote.live.lead_time'|trans }}</h5>
                                <div id="leadTimeInfo">
                                    {% set lt = tierPricing.tiers[0].lead_time_estimate %}
                                    <div class="rams-mb-sm">
                                        <span class="rams-text rams-text--bold">{{ lt.total_days }} {{ 'quote.live.days'|trans|default('days') }}</span>
                                        <span class="rams-text rams-text--sm rams-text--muted">({{ 'quote.live.est'|trans|default('Est.') }} {{ lt.estimate_date }})</span>
                                    </div>
                                    <div class="rams-lead-time-bar rams-mb-sm">
                                        <div class="rams-lead-time-fill rams-lead-time-fill--{% if lt.confidence == 'high' %}fast{% elseif lt.confidence == 'medium' %}medium{% else %}slow{% endif %}"></div>
                                    </div>
                                    <span class="rams-text rams-text--xs rams-text--muted">
                                        {{ 'quote.live.procurement'|trans|default('Procurement') }}: {{ lt.procurement_days }}d | {{ 'quote.live.assembly'|trans|default('Assembly') }}: {{ lt.assembly_days }}d
                                    </span>
                                </div>
                            </div>
                        </div>

                        {# Price Break Recommendation #}
                        {% if tierPricing.tiers[0].next_break is defined %}
                            <div class="rams-andon rams-andon--blue rams-mt-md" id="priceBreakTip">
                                <strong>💡 {{ 'quote.live.tip'|trans|default('Tip') }}:</strong>
                                {{ 'quote.live.order'|trans|default('Order') }} <span id="additionalQty">{{ tierPricing.tiers[0].next_break.additional_qty }}</span> {{ 'quote.live.more_units'|trans|default('more units') }} 
                                ({{ 'common.total'|trans|lower }} <span id="nextBreakQty">{{ tierPricing.tiers[0].next_break.quantity }}</span>) 
                                {{ 'quote.live.and_save'|trans|default('and save') }} <span id="savingsPerUnit">{{ tierPricing.tiers[0].next_break.savings_per_unit|format_currency(tierPricing.currency, tierPricing.currency, 4) }}</span>/{{ 'quote.live.unit'|trans|default('unit') }}!
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Action Buttons #}
                <div class="rams-form__actions rams-form__actions--center">
                    <button class="rams-btn rams-btn--secondary rams-btn--lg" onclick="requestCustomQuote()">
                        💬 {{ 'quote.live.request_changes'|trans }}
                    </button>
                    <button class="rams-btn rams-btn--primary rams-btn--lg" onclick="acceptQuote()">
                        ✓ {{ 'quote.live.accept'|trans }}
                    </button>
                </div>

                {# Contact Info #}
                <div class="rams-text--center rams-mt-lg">
                    <p class="rams-text rams-text--sm rams-text--muted">
                        {{ 'quote.live.questions'|trans|default('Questions? Contact your sales representative or email') }}
                        <a href="mailto:sales@starzcrm.com" class="rams-link">sales@starzcrm.com</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# Request Quote Modal #}
    <div class="rams-modal rams-modal--hidden" id="requestModal">
        <div class="rams-modal__backdrop" onclick="closeModal('requestModal')"></div>
        <div class="rams-modal__content">
            <div class="rams-modal__header">
                <h5 class="rams-heading rams-heading--3">{{ 'quote.live.request_custom_quote'|trans|default('Request Custom Quote') }}</h5>
            </div>
            <div class="rams-modal__body">
                <form id="requestForm">
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'quote.live.desired_quantity'|trans|default('Desired Quantity') }}</label>
                        <input type="number" class="rams-form__input" id="requestQty" required>
                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'common.notes'|trans }} ({{ 'common.optional'|trans|lower }})</label>
                        <textarea class="rams-form__textarea" id="requestNotes" rows="3" 
                                  placeholder="{{ 'quote.live.notes_placeholder'|trans|default('Any special requirements or questions...') }}"></textarea>
                    </div>
                </form>
            </div>
            <div class="rams-modal__footer">
                <button type="button" class="rams-btn rams-btn--secondary" onclick="closeModal('requestModal')">{{ 'common.cancel'|trans }}</button>
                <button type="button" class="rams-btn rams-btn--primary" onclick="submitRequest()">{{ 'common.submit'|trans }}</button>
            </div>
        </div>
    </div>

    {# Accept Quote Modal #}
    <div class="rams-modal rams-modal--hidden" id="acceptModal">
        <div class="rams-modal__backdrop" onclick="closeModal('acceptModal')"></div>
        <div class="rams-modal__content">
            <div class="rams-modal__header rams-modal__header--success">
                <h5 class="rams-heading rams-heading--3 rams-text--white">✓ {{ 'quote.live.accept'|trans }}</h5>
            </div>
            <div class="rams-modal__body">
                <p class="rams-text rams-mb-md">
                    {{ 'quote.live.accepting_for'|trans|default('You are accepting this quote for') }} <strong id="acceptQtyDisplay">-</strong> {{ 'quote.live.at'|trans|default('at') }} <strong id="acceptPriceDisplay">-</strong>.
                </p>
                <form id="acceptForm">
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'auth.full_name'|trans }} *</label>
                        <input type="text" class="rams-form__input" id="acceptName" required>
                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'common.email'|trans }} *</label>
                        <input type="email" class="rams-form__input" id="acceptEmail" required>
                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'common.phone'|trans }}</label>
                        <input type="tel" class="rams-form__input" id="acceptPhone">
                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'quote.live.po_number'|trans|default('PO Number') }} ({{ 'quote.live.if_available'|trans|default('if available') }})</label>
                        <input type="text" class="rams-form__input" id="acceptPO">
                    </div>
                </form>
            </div>
            <div class="rams-modal__footer">
                <button type="button" class="rams-btn rams-btn--secondary" onclick="closeModal('acceptModal')">{{ 'common.cancel'|trans }}</button>
                <button type="button" class="rams-btn rams-btn--primary" onclick="submitAcceptance()">
                    ✓ {{ 'quote.live.confirm_acceptance'|trans|default('Confirm Acceptance') }}
                </button>
            </div>
        </div>
    </div>

    <script>
        const token = '{{ token }}';
        const tierData = {{ tierPricing.tiers|json_encode|raw }};
        const currencySymbol = '{{ currency_symbol(tierPricing.currency)|e('js') }}';
        const currencyNeedsSpace = {{ tierPricing.currency in ['MAD', 'TND'] ? 'true' : 'false' }};
        let selectedQuantity = tierData[0].quantity;

        function formatCurrency(value, decimals) {
            const formatted = value.toLocaleString(undefined, {
                minimumFractionDigits: decimals,
                maximumFractionDigits: decimals
            });
            return currencyNeedsSpace ? `${currencySymbol} ${formatted}` : `${currencySymbol}${formatted}`;
        }
        
        function selectTier(element, quantity) {
            document.querySelectorAll('.rams-tier-card').forEach(card => card.classList.remove('rams-tier-card--selected'));
            element.classList.add('rams-tier-card--selected');
            
            const tier = tierData.find(t => t.quantity === quantity);
            if (!tier) return;
            
            selectedQuantity = quantity;
            
            document.getElementById('selectedQty').textContent = quantity.toLocaleString();
            document.getElementById('selectedUnitPrice').textContent = formatCurrency(tier.unit_price, 4);
            document.getElementById('selectedExtended').textContent = formatCurrency(tier.extended_price, 2);
            
            const stockBadge = tier.stock_status === 'all_in_stock' 
                ? '<span class="rams-badge rams-badge--green">All In Stock</span>'
                : '<span class="rams-badge rams-badge--yellow">Partial Stock</span>';
            document.getElementById('selectedStock').innerHTML = stockBadge;
            
            const lt = tier.lead_time_estimate;
            const ltClass = lt.confidence === 'high' ? 'fast' : lt.confidence === 'medium' ? 'medium' : 'slow';
            document.getElementById('leadTimeInfo').innerHTML = `
                <div class="rams-mb-sm">
                    <span class="rams-text rams-text--bold">${lt.total_days} days</span>
                    <span class="rams-text rams-text--sm rams-text--muted">(Est. ${lt.estimate_date})</span>
                </div>
                <div class="rams-lead-time-bar rams-mb-sm">
                    <div class="rams-lead-time-fill rams-lead-time-fill--${ltClass}"></div>
                </div>
                <span class="rams-text rams-text--xs rams-text--muted">Procurement: ${lt.procurement_days}d | Assembly: ${lt.assembly_days}d</span>
            `;
            
            const tipEl = document.getElementById('priceBreakTip');
            if (tier.next_break) {
                tipEl.style.display = 'block';
                document.getElementById('additionalQty').textContent = tier.next_break.additional_qty;
                document.getElementById('nextBreakQty').textContent = tier.next_break.quantity;
                document.getElementById('savingsPerUnit').textContent = formatCurrency(tier.next_break.savings_per_unit, 4);
            } else if (tipEl) {
                tipEl.style.display = 'none';
            }
        }
        
        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('rams-modal--hidden');
        }
        
        function requestCustomQuote() {
            document.getElementById('requestQty').value = selectedQuantity;
            document.getElementById('requestModal').classList.remove('rams-modal--hidden');
        }
        
        function acceptQuote() {
            const tier = tierData.find(t => t.quantity === selectedQuantity);
            document.getElementById('acceptQtyDisplay').textContent = selectedQuantity.toLocaleString() + ' units';
            document.getElementById('acceptPriceDisplay').textContent = formatCurrency(tier.extended_price, 2);
            document.getElementById('acceptModal').classList.remove('rams-modal--hidden');
        }
        
        function submitRequest() {
            const quantity = document.getElementById('requestQty').value;
            const notes = document.getElementById('requestNotes').value;
            
            fetch(`/quote/live/${token}/request`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({quantity: parseInt(quantity), notes: notes})
            })
            .then(response => response.json())
            .then(data => {
                closeModal('requestModal');
                ramsAlert(data.message || 'Request submitted successfully!', {variant: 'success'});
            })
            .catch(error => ramsAlert('Error submitting request: ' + error.message, {variant: 'error'}));
        }
        
        function submitAcceptance() {
            const data = {
                quantity: selectedQuantity,
                name: document.getElementById('acceptName').value,
                email: document.getElementById('acceptEmail').value,
                phone: document.getElementById('acceptPhone').value,
                po_number: document.getElementById('acceptPO').value
            };
            
            fetch(`/quote/live/${token}/accept`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                closeModal('acceptModal');
                document.querySelector('.rams-quote-card .rams-module__content').innerHTML = `
                    <div class="rams-text--center rams-py-xl">
                        <div class="rams-text--success rams-text-6xl">✓</div>
                        <h2 class="rams-heading rams-heading--2 rams-mt-md">Quote Accepted!</h2>
                        <p class="rams-text rams-text--muted">${result.message}</p>
                        <ul class="rams-list rams-list--check rams-text--left rams-mx-auto" style="max-width: 400px;">
                            ${result.next_steps.map(s => `<li class="rams-list__item">✓ ${s}</li>`).join('')}
                        </ul>
                    </div>
                `;
            })
            .catch(error => ramsAlert('Error: ' + error.message, {variant: 'error'}));
        }
    </script>
</body>
</html>
