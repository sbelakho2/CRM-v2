<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quote {{ quote.quoteNumber }} - Interactive View</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .quote-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        .tier-card {
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        .tier-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .tier-card.selected {
            border-color: #667eea;
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
        }
        .savings-badge {
            position: absolute;
            top: -10px;
            right: -10px;
            background: #28a745;
            color: white;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 0.75rem;
            font-weight: bold;
        }
        .price-highlight {
            font-size: 2.5rem;
            font-weight: 700;
            color: #667eea;
        }
        .lead-time-indicator {
            height: 8px;
            border-radius: 4px;
            background: #e9ecef;
            overflow: hidden;
        }
        .lead-time-fill {
            height: 100%;
            border-radius: 4px;
        }
        .lead-time-fast { background: #28a745; width: 30%; }
        .lead-time-medium { background: #ffc107; width: 60%; }
        .lead-time-slow { background: #dc3545; width: 90%; }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="quote-card mx-auto" style="max-width: 1000px;">
            {# Header #}
            <div class="p-4 border-bottom" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 20px 20px 0 0;">
                <div class="d-flex justify-content-between align-items-center text-white">
                    <div>
                        <h2 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Quote {{ quote.quoteNumber }}</h2>
                        <p class="mb-0 opacity-75">For: {{ quote.company.name }}</p>
                    </div>
                    <div class="text-end">
                        <small class="d-block opacity-75">Valid Until</small>
                        <strong>{{ tierPricing.valid_until }}</strong>
                    </div>
                </div>
            </div>

            <div class="p-4">
                {# Summary Info #}
                <div class="row mb-4">
                    <div class="col-md-4 text-center">
                        <small class="text-muted d-block">BOM Lines</small>
                        <strong class="fs-4">{{ tierPricing.bom_line_count }}</strong>
                    </div>
                    <div class="col-md-4 text-center">
                        <small class="text-muted d-block">Currency</small>
                        <strong class="fs-4">{{ tierPricing.currency }}</strong>
                    </div>
                    <div class="col-md-4 text-center">
                        <small class="text-muted d-block">Base Quantity</small>
                        <strong class="fs-4">{{ tierPricing.base_quantity|number_format }}</strong>
                    </div>
                </div>

                {# Quantity Tier Selection #}
                <h5 class="mb-3"><i class="bi bi-sliders text-primary me-2"></i>Select Quantity</h5>
                <p class="text-muted small mb-3">Click a quantity tier to see pricing. Higher quantities unlock better unit prices.</p>

                <div class="row g-3 mb-4" id="tierCards">
                    {% for tier in tierPricing.tiers %}
                        <div class="col-md-4 col-lg-3">
                            <div class="tier-card card h-100 position-relative {% if loop.first %}selected{% endif %}" 
                                 data-quantity="{{ tier.quantity }}"
                                 onclick="selectTier(this, {{ tier.quantity }})">
                                {% if tier.savings_vs_minimum.percent > 0 %}
                                    <span class="savings-badge">
                                        <i class="bi bi-arrow-down"></i> {{ tier.savings_vs_minimum.percent }}%
                                    </span>
                                {% endif %}
                                <div class="card-body text-center">
                                    <h5 class="mb-1">{{ tier.quantity|number_format }}</h5>
                                    <small class="text-muted d-block mb-2">units</small>
                                    <div class="price-highlight">${{ tier.unit_price|number_format(4) }}</div>
                                    <small class="text-muted">per unit</small>
                                    <hr>
                                    <div class="fw-bold text-success">
                                        ${{ tier.extended_price|number_format(2) }}
                                    </div>
                                    <small class="text-muted">total</small>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Selected Tier Details #}
                <div class="card bg-light mb-4" id="tierDetails">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h5><i class="bi bi-info-circle text-primary me-2"></i>Selected: <span id="selectedQty">{{ tierPricing.tiers[0].quantity|number_format }}</span> units</h5>
                                <table class="table table-sm">
                                    <tr>
                                        <td>Unit Price:</td>
                                        <td class="fw-bold" id="selectedUnitPrice">${{ tierPricing.tiers[0].unit_price|number_format(4) }}</td>
                                    </tr>
                                    <tr>
                                        <td>Extended Price:</td>
                                        <td class="fw-bold text-success" id="selectedExtended">${{ tierPricing.tiers[0].extended_price|number_format(2) }}</td>
                                    </tr>
                                    <tr>
                                        <td>Stock Status:</td>
                                        <td id="selectedStock">
                                            <span class="badge bg-{% if tierPricing.tiers[0].stock_status == 'all_in_stock' %}success{% else %}warning{% endif %}">
                                                {{ tierPricing.tiers[0].stock_status|replace({'_': ' '})|title }}
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h5><i class="bi bi-truck text-info me-2"></i>Estimated Lead Time</h5>
                                <div id="leadTimeInfo">
                                    {% set lt = tierPricing.tiers[0].lead_time_estimate %}
                                    <div class="mb-2">
                                        <strong>{{ lt.total_days }} days</strong>
                                        <small class="text-muted">(Est. {{ lt.estimate_date }})</small>
                                    </div>
                                    <div class="lead-time-indicator mb-2">
                                        <div class="lead-time-fill lead-time-{% if lt.confidence == 'high' %}fast{% elseif lt.confidence == 'medium' %}medium{% else %}slow{% endif %}"></div>
                                    </div>
                                    <small class="text-muted">
                                        Procurement: {{ lt.procurement_days }}d | Assembly: {{ lt.assembly_days }}d
                                    </small>
                                </div>
                            </div>
                        </div>

                        {# Price Break Recommendation #}
                        {% if tierPricing.tiers[0].next_break is defined %}
                            <div class="alert alert-info mt-3 mb-0" id="priceBreakTip">
                                <i class="bi bi-lightbulb me-2"></i>
                                <strong>Tip:</strong> Order <span id="additionalQty">{{ tierPricing.tiers[0].next_break.additional_qty }}</span> more units 
                                (total <span id="nextBreakQty">{{ tierPricing.tiers[0].next_break.quantity }}</span>) 
                                and save <span id="savingsPerUnit">${{ tierPricing.tiers[0].next_break.savings_per_unit|number_format(4) }}</span>/unit!
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Action Buttons #}
                <div class="d-flex gap-3 justify-content-center">
                    <button class="btn btn-lg btn-outline-primary" onclick="requestCustomQuote()">
                        <i class="bi bi-chat-dots me-2"></i>Request Custom Quote
                    </button>
                    <button class="btn btn-lg btn-success" onclick="acceptQuote()">
                        <i class="bi bi-check-circle me-2"></i>Accept Quote
                    </button>
                </div>

                {# Contact Info #}
                <div class="text-center mt-4 text-muted">
                    <small>
                        Questions? Contact your sales representative or email 
                        <a href="mailto:sales@starzcrm.com">sales@starzcrm.com</a>
                    </small>
                </div>
            </div>
        </div>
    </div>

    {# Request Quote Modal #}
    <div class="modal fade" id="requestModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Request Custom Quote</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="requestForm">
                        <div class="mb-3">
                            <label class="form-label">Desired Quantity</label>
                            <input type="number" class="form-control" id="requestQty" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Notes (optional)</label>
                            <textarea class="form-control" id="requestNotes" rows="3" 
                                      placeholder="Any special requirements or questions..."></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="submitRequest()">Submit Request</button>
                </div>
            </div>
        </div>
    </div>

    {# Accept Quote Modal #}
    <div class="modal fade" id="acceptModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-check-circle me-2"></i>Accept Quote</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>You are accepting this quote for <strong id="acceptQtyDisplay">-</strong> units at 
                       <strong id="acceptPriceDisplay">-</strong>.</p>
                    <form id="acceptForm">
                        <div class="mb-3">
                            <label class="form-label">Your Name *</label>
                            <input type="text" class="form-control" id="acceptName" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control" id="acceptEmail" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Phone</label>
                            <input type="tel" class="form-control" id="acceptPhone">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">PO Number (if available)</label>
                            <input type="text" class="form-control" id="acceptPO">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" onclick="submitAcceptance()">
                        <i class="bi bi-check-circle me-2"></i>Confirm Acceptance
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const token = '{{ token }}';
        const tierData = {{ tierPricing.tiers|json_encode|raw }};
        let selectedQuantity = tierData[0].quantity;
        
        function selectTier(element, quantity) {
            // Update UI
            document.querySelectorAll('.tier-card').forEach(card => card.classList.remove('selected'));
            element.classList.add('selected');
            
            // Find tier data
            const tier = tierData.find(t => t.quantity === quantity);
            if (!tier) return;
            
            selectedQuantity = quantity;
            
            // Update details
            document.getElementById('selectedQty').textContent = quantity.toLocaleString();
            document.getElementById('selectedUnitPrice').textContent = '$' + tier.unit_price.toFixed(4);
            document.getElementById('selectedExtended').textContent = '$' + tier.extended_price.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
            
            // Stock status
            const stockBadge = tier.stock_status === 'all_in_stock' 
                ? '<span class="badge bg-success">All In Stock</span>'
                : '<span class="badge bg-warning">Partial Stock</span>';
            document.getElementById('selectedStock').innerHTML = stockBadge;
            
            // Lead time
            const lt = tier.lead_time_estimate;
            const ltClass = lt.confidence === 'high' ? 'fast' : lt.confidence === 'medium' ? 'medium' : 'slow';
            document.getElementById('leadTimeInfo').innerHTML = `
                <div class="mb-2">
                    <strong>${lt.total_days} days</strong>
                    <small class="text-muted">(Est. ${lt.estimate_date})</small>
                </div>
                <div class="lead-time-indicator mb-2">
                    <div class="lead-time-fill lead-time-${ltClass}"></div>
                </div>
                <small class="text-muted">
                    Procurement: ${lt.procurement_days}d | Assembly: ${lt.assembly_days}d
                </small>
            `;
            
            // Price break tip
            const tipEl = document.getElementById('priceBreakTip');
            if (tier.next_break) {
                tipEl.style.display = 'block';
                document.getElementById('additionalQty').textContent = tier.next_break.additional_qty;
                document.getElementById('nextBreakQty').textContent = tier.next_break.quantity;
                document.getElementById('savingsPerUnit').textContent = '$' + tier.next_break.savings_per_unit.toFixed(4);
            } else if (tipEl) {
                tipEl.style.display = 'none';
            }
        }
        
        function requestCustomQuote() {
            document.getElementById('requestQty').value = selectedQuantity;
            new bootstrap.Modal(document.getElementById('requestModal')).show();
        }
        
        function acceptQuote() {
            const tier = tierData.find(t => t.quantity === selectedQuantity);
            document.getElementById('acceptQtyDisplay').textContent = selectedQuantity.toLocaleString() + ' units';
            document.getElementById('acceptPriceDisplay').textContent = '$' + tier.extended_price.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
            new bootstrap.Modal(document.getElementById('acceptModal')).show();
        }
        
        function submitRequest() {
            const quantity = document.getElementById('requestQty').value;
            const notes = document.getElementById('requestNotes').value;
            
            fetch(`/quote/live/${token}/request`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({quantity: parseInt(quantity), notes: notes})
            })
            .then(response => response.json())
            .then(data => {
                bootstrap.Modal.getInstance(document.getElementById('requestModal')).hide();
                alert(data.message || 'Request submitted successfully!');
            })
            .catch(error => alert('Error submitting request: ' + error.message));
        }
        
        function submitAcceptance() {
            const data = {
                quantity: selectedQuantity,
                name: document.getElementById('acceptName').value,
                email: document.getElementById('acceptEmail').value,
                phone: document.getElementById('acceptPhone').value,
                po_number: document.getElementById('acceptPO').value
            };
            
            fetch(`/quote/live/${token}/accept`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                bootstrap.Modal.getInstance(document.getElementById('acceptModal')).hide();
                document.querySelector('.quote-card .p-4:last-child').innerHTML = `
                    <div class="text-center py-5">
                        <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
                        <h2 class="mt-3">Quote Accepted!</h2>
                        <p class="text-muted">${result.message}</p>
                        <ul class="list-unstyled text-start mx-auto" style="max-width: 400px;">
                            ${result.next_steps.map(s => `<li><i class="bi bi-check text-success me-2"></i>${s}</li>`).join('')}
                        </ul>
                    </div>
                `;
            })
            .catch(error => alert('Error: ' + error.message));
        }
    </script>
</body>
</html>
