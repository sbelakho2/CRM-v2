{% extends 'base.html.twig' %}

{% block title %}{{ 'competitor.list.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    <div class="rams-page-header">
        <h1 class="rams-page-title">📋 {{ 'competitor.list.title'|trans }}</h1>
        <p class="rams-page-subtitle">{{ total }} {{ 'competitor.list.subtitle'|trans }}</p>
    </div>

    {# ── Filters ── #}
    <div class="rams-module rams-mb-6">
        <div class="rams-module__content">
            <form method="get" action="{{ path('comp_crawler_list') }}" class="rams-grid rams-grid--4col" style="gap: 12px; align-items: end;">
                <div>
                    <label class="rams-label">{{ 'competitor.list.filters.search'|trans }}</label>
                    <input type="text" name="q" value="{{ filters.search }}" placeholder="{{ 'competitor.list.filters.search'|trans }}" class="rams-input rams-input--sm">
                </div>
                <div>
                    <label class="rams-label">{{ 'competitor.list.filters.status'|trans }}</label>
                    <select name="status" class="rams-input rams-input--sm">
                        <option value="">{{ 'competitor.list.filters.all_statuses'|trans }}</option>
                        {% for s in statuses %}
                            <option value="{{ s }}" {% if filters.status == s %}selected{% endif %}>{{ s | capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="rams-label">{{ 'competitor.list.filters.type'|trans }}</label>
                    <select name="type" class="rams-input rams-input--sm">
                        <option value="">{{ 'competitor.list.filters.all_types'|trans }}</option>
                        {% for t in types %}
                            <option value="{{ t }}" {% if filters.type == t %}selected{% endif %}>{{ t | replace({'_': ' '}) | capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="rams-label">{{ 'competitor.list.filters.proof'|trans }}</label>
                    <select name="proofGrade" class="rams-input rams-input--sm">
                        <option value="">{{ 'common.all'|trans|default('All') }}</option>
                        <option value="A" {% if filters.proofGrade == 'A' %}selected{% endif %}>A — Official</option>
                        <option value="B" {% if filters.proofGrade == 'B' %}selected{% endif %}>B — Quality page</option>
                        <option value="C" {% if filters.proofGrade == 'C' %}selected{% endif %}>C — Marketing</option>
                        <option value="D" {% if filters.proofGrade == 'D' %}selected{% endif %}>D — Badge only</option>
                    </select>
                </div>
                <div>
                    <label class="rams-label">{{ 'competitor.list.filters.min_threat'|trans }}</label>
                    <input type="number" name="minThreat" value="{{ filters.minThreat }}" min="0" max="100" placeholder="0" class="rams-input rams-input--sm">
                </div>
                <div>
                    <label class="rams-label">{{ 'competitor.list.filters.min_overlap'|trans }}</label>
                    <input type="number" name="minOverlap" value="{{ filters.minOverlap }}" min="0" max="100" placeholder="0" class="rams-input rams-input--sm">
                </div>
                <div>
                    <label class="rams-label">{{ 'competitor.list.filters.directness'|trans }}</label>
                    <select name="directness" class="rams-input rams-input--sm">
                        <option value="">{{ 'common.all'|trans|default('All') }}</option>
                        <option value="head_to_head" {% if filters.directness == 'head_to_head' %}selected{% endif %}>Head-to-Head</option>
                        <option value="adjacent" {% if filters.directness == 'adjacent' %}selected{% endif %}>Adjacent</option>
                        <option value="niche_overlap" {% if filters.directness == 'niche_overlap' %}selected{% endif %}>Niche Overlap</option>
                        <option value="potential" {% if filters.directness == 'potential' %}selected{% endif %}>Potential</option>
                    </select>
                </div>
                <div class="rams-flex rams-gap-2">
                    <button type="submit" class="rams-btn rams-btn--primary rams-btn--sm rams-flex-1">{{ 'competitor.list.filters.apply'|trans }}</button>
                    <a href="{{ path('comp_crawler_list') }}" class="rams-btn rams-btn--outline rams-btn--sm">{{ 'competitor.list.filters.reset'|trans }}</a>
                </div>
            </form>
        </div>
    </div>

    {# ── Table ── #}
    <div class="rams-module">
        <div class="rams-module__content" style="overflow-x: auto;">
            <table class="rams-table">
                <thead>
                    <tr>
                        <th>{{ 'competitor.list.table.company'|trans }}</th>
                        <th>{{ 'competitor.list.table.domain'|trans }}</th>
                        <th>{{ 'competitor.list.table.types'|trans }}</th>
                        <th>{{ 'competitor.list.filters.status'|trans }}</th>
                        <th>{{ 'competitor.list.table.threat'|trans }}</th>
                        <th>{{ 'competitor.list.table.overlap'|trans }}</th>
                        <th>{{ 'competitor.list.table.proof'|trans }}</th>
                        <th>{{ 'competitor.list.table.country'|trans }}</th>
                        <th>Certs</th>
                        <th>Crawled</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in competitors %}
                    <tr>
                        <td>
                            <a href="{{ path('comp_crawler_detail', {id: c.id}) }}" class="rams-link" style="font-weight: 600;">
                                {{ c.name }}
                            </a>
                        </td>
                        <td class="rams-font-mono rams-text--xs">
                            <a href="https://{{ c.canonicalDomain }}" target="_blank" rel="noopener" class="rams-link">{{ c.canonicalDomain }}</a>
                        </td>
                        <td>
                            {% for t in c.competitorTypes | slice(0, 2) %}
                                <span class="rams-badge rams-badge--info rams-text--xs">{{ t | replace({'_': ' '}) }}</span>
                            {% endfor %}
                            {% if c.competitorTypes | length > 2 %}
                                <span class="rams-text--xs rams-text--muted">+{{ c.competitorTypes | length - 2 }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="rams-badge rams-badge--{% if c.status == 'monitoring' %}success{% elseif c.status == 'verified' %}info{% elseif c.status == 'candidate' %}warning{% elseif c.status == 'rejected' %}danger{% else %}muted{% endif %}">
                                {{ c.status }}
                            </span>
                        </td>
                        <td>
                            <span class="rams-badge {% if c.threatScore >= 70 %}rams-badge--danger{% elseif c.threatScore >= 40 %}rams-badge--warning{% else %}rams-badge--success{% endif %}">
                                {{ c.threatScore }}
                            </span>
                        </td>
                        <td>{{ c.overlapScore }}</td>
                        <td>
                            <span class="rams-badge rams-badge--{% if c.proofGrade == 'A' %}success{% elseif c.proofGrade == 'B' %}info{% elseif c.proofGrade == 'C' %}warning{% else %}muted{% endif %}">
                                {{ c.proofGrade | default('—') }}
                            </span>
                        </td>
                        <td class="rams-text--xs">{{ c.hqCountry | default('—') }}</td>
                        <td class="rams-text--xs">{{ c.certifications | length }}</td>
                        <td class="rams-text--xs rams-text--muted">
                            {{ c.lastCrawledAt ? c.lastCrawledAt | date('M d') : '—' }}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="10" class="rams-text--muted" style="text-align: center; padding: 32px;">
                            {{ 'common.no_results'|trans|default('No results found.') }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ── Pagination ── #}
    {% if total_pages > 1 %}
    <div class="rams-flex rams-justify-center rams-mt-4" style="gap: 8px;">
        {% if page > 1 %}
            <a href="{{ path('comp_crawler_list', filters | merge({page: page - 1})) }}" class="rams-btn rams-btn--outline rams-btn--sm">← {{ 'pagination.previous'|trans|default('Prev') }}</a>
        {% endif %}
        <span class="rams-text--sm rams-text--muted" style="line-height: 32px;">{{ 'pagination.page'|trans|default('Page') }} {{ page }} {{ 'pagination.of'|trans|default('of') }} {{ total_pages }}</span>
        {% if page < total_pages %}
            <a href="{{ path('comp_crawler_list', filters | merge({page: page + 1})) }}" class="rams-btn rams-btn--outline rams-btn--sm">{{ 'pagination.next'|trans|default('Next') }} →</a>
        {% endif %}
    </div>
    {% endif %}
</div>
{% endblock %}
