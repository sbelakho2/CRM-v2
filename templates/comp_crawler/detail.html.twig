{% extends 'base.html.twig' %}

{% block title %}{{ competitor.name }} — {{ 'competitor.detail.title'|trans|default('Competitor Profile') }}{% endblock %}

{% block body %}
<div class="rams-stack">
    {# ── Header ── #}
    <div class="rams-page-header">
        <div class="rams-flex rams-justify-between rams-items-center">
            <div>
                <h1 class="rams-page-title">{{ competitor.name }}</h1>
                <p class="rams-page-subtitle">
                    <a href="https://{{ competitor.canonicalDomain }}" target="_blank" rel="noopener" class="rams-link rams-font-mono">{{ competitor.canonicalDomain }}</a>
                    {% if competitor.altDomains | length > 0 %}
                        <span class="rams-text--muted rams-text--xs"> (+{{ competitor.altDomains | length }} {{ 'common.alt_domains'|trans|default('alt domains') }})</span>
                    {% endif %}
                </p>
            </div>
            <div class="rams-flex" style="gap: 8px;">
                <a href="{{ path('comp_crawler_list') }}" class="rams-btn rams-btn--outline rams-btn--sm">← {{ 'competitor.detail.back_to_list'|trans }}</a>
                <span class="rams-badge rams-badge--{% if competitor.status == 'monitoring' %}success{% elseif competitor.status == 'verified' %}info{% elseif competitor.status == 'candidate' %}warning{% elseif competitor.status == 'rejected' %}danger{% else %}muted{% endif %}" style="font-size: 0.85rem; padding: 6px 14px;">
                    {{ competitor.status | upper }}
                </span>
            </div>
        </div>
    </div>

    {# ── Score Cards ── #}
    <div class="rams-grid rams-grid--4col rams-mb-6">
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'competitor.detail.scores.threat'|trans }}</span>
                    <span class="rams-metric__value" style="color: {% if competitor.threatScore >= 70 %}var(--rams-error, #E53935){% elseif competitor.threatScore >= 40 %}var(--rams-warning, #F59E0B){% else %}var(--rams-success, #22C55E){% endif %};">
                        {{ competitor.threatScore }}
                    </span>
                </div>
                <div class="rams-progress-bar rams-mt-2">
                    <div class="rams-progress-bar__fill" style="background: {% if competitor.threatScore >= 70 %}var(--rams-error, #E53935){% elseif competitor.threatScore >= 40 %}var(--rams-warning, #F59E0B){% else %}var(--rams-success, #22C55E){% endif %}; width: {{ competitor.threatScore }}%;"></div>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'competitor.detail.scores.overlap'|trans }}</span>
                    <span class="rams-metric__value">{{ competitor.overlapScore }}</span>
                </div>
                <div class="rams-progress-bar rams-mt-2">
                    <div class="rams-progress-bar__fill bg-rams-warning" style="width: {{ competitor.overlapScore }}%;"></div>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'competitor.detail.scores.strategic'|trans }}</span>
                    <span class="rams-metric__value">{{ competitor.strategicRelevanceScore }}</span>
                </div>
                <div class="rams-progress-bar rams-mt-2">
                    <div class="rams-progress-bar__fill bg-rams-info" style="width: {{ competitor.strategicRelevanceScore }}%;"></div>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'competitor.detail.scores.proof'|trans }}</span>
                    <span class="rams-metric__value">{{ competitor.proofGrade | default('—') }}</span>
                </div>
                <div class="rams-text--xs rams-text--muted rams-mt-1">
                    {% if competitor.proofGrade == 'A' %}PDF certificate / official{% elseif competitor.proofGrade == 'B' %}Quality page claim{% elseif competitor.proofGrade == 'C' %}Marketing mention{% elseif competitor.proofGrade == 'D' %}Badge / snippet{% else %}Not graded{% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--2col rams-mb-6" style="gap: 24px;">
        {# ── Left Column: Profile ── #}
        <div>
            {# Company Info #}
            <div class="rams-module rams-mb-4">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'common.company_info'|trans|default('Company Information') }}</h2>
                </div>
                <div class="rams-module__content">
                    <table class="rams-table rams-table--kv">
                        <tr><td class="rams-text--muted">{{ 'competitor.list.table.types'|trans }}</td><td>
                            {% for t in competitor.competitorTypes %}
                                <span class="rams-badge rams-badge--info">{{ t | replace({'_': ' '}) }}</span>
                            {% endfor %}
                        </td></tr>
                        <tr><td class="rams-text--muted">{{ 'competitor.list.filters.directness'|trans }}</td><td>{{ competitor.directness | default('—') | replace({'_': ' '}) | capitalize }}</td></tr>
                        <tr><td class="rams-text--muted">{{ 'competitor.list.table.country'|trans }}</td><td>{{ competitor.hqCountry | default('—') }}</td></tr>
                        <tr><td class="rams-text--muted">{{ 'competitor.list.filters.region'|trans }}</td><td>{{ competitor.regions | join(', ') | replace({'_': ' '}) | capitalize }}</td></tr>
                        <tr><td class="rams-text--muted">Employees</td><td>{{ competitor.employeeEstimate ? competitor.employeeEstimate | number_format : '—' }}</td></tr>
                        <tr><td class="rams-text--muted">{{ 'common.discovered'|trans|default('Discovered') }}</td><td>{{ competitor.discoveredAt | date('M d, Y') }}</td></tr>
                        <tr><td class="rams-text--muted">{{ 'competitor.detail.info.last_crawl'|trans }}</td><td>{{ competitor.lastCrawledAt ? competitor.lastCrawledAt | date('M d, Y H:i') : 'Never' }}</td></tr>
                        <tr><td class="rams-text--muted">Pages Crawled</td><td>{{ competitor.pagesCrawled }}</td></tr>
                        {% if competitor.parentCompetitor %}
                        <tr><td class="rams-text--muted">Parent</td><td>
                            <a href="{{ path('comp_crawler_detail', {id: competitor.parentCompetitor.id}) }}" class="rams-link">{{ competitor.parentCompetitor.name }}</a>
                        </td></tr>
                        {% endif %}
                    </table>
                </div>
            </div>

            {# Certifications #}
            {% if competitor.certifications | length > 0 %}
            <div class="rams-module rams-mb-4">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">🏅 Certifications ({{ competitor.certifications | length }})</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-flex" style="gap: 6px; flex-wrap: wrap;">
                        {% for cert in competitor.certifications %}
                            <span class="rams-badge rams-badge--success">{{ cert }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% endif %}

            {# Capabilities #}
            {% if competitor.capabilities | length > 0 %}
            <div class="rams-module rams-mb-4">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">⚙️ Capabilities ({{ competitor.capabilities | length }})</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-flex" style="gap: 6px; flex-wrap: wrap;">
                        {% for cap in competitor.capabilities %}
                            <span class="rams-badge rams-badge--info">{{ cap }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% endif %}

            {# Industries Served #}
            {% if competitor.industries | length > 0 %}
            <div class="rams-module rams-mb-4">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">🏭 Industries Served ({{ competitor.industries | length }})</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-flex" style="gap: 6px; flex-wrap: wrap;">
                        {% for ind in competitor.industries %}
                            <span class="rams-badge">{{ ind }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        {# ── Right Column: Type Profiles + Changes ── #}
        <div>
            {# EMS Profile #}
            {% if competitor.emsProfile and competitor.emsProfile | length > 0 %}
            <div class="rams-module rams-mb-4">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">🔧 EMS Profile</h2>
                </div>
                <div class="rams-module__content">
                    <table class="rams-table rams-table--kv">
                        {% for key, val in competitor.emsProfile %}
                        <tr>
                            <td class="rams-text--muted">{{ key | replace({'_': ' '}) | capitalize }}</td>
                            <td>{% if val is same as(true) %}✅{% elseif val is same as(false) %}—{% else %}{{ val }}{% endif %}</td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>
            {% endif %}

            {# Machining Profile #}
            {% if competitor.machiningProfile and competitor.machiningProfile | length > 0 %}
            <div class="rams-module rams-mb-4">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">🏗️ Machining Profile</h2>
                </div>
                <div class="rams-module__content">
                    <table class="rams-table rams-table--kv">
                        {% for key, val in competitor.machiningProfile %}
                        <tr>
                            <td class="rams-text--muted">{{ key | replace({'_': ' '}) | capitalize }}</td>
                            <td>{% if val is iterable %}{{ val | join(', ') }}{% else %}{{ val }}{% endif %}</td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>
            {% endif %}

            {# Harness Profile #}
            {% if competitor.harnessProfile and competitor.harnessProfile | length > 0 %}
            <div class="rams-module rams-mb-4">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">🔌 Harness Profile</h2>
                </div>
                <div class="rams-module__content">
                    <table class="rams-table rams-table--kv">
                        {% for key, val in competitor.harnessProfile %}
                        <tr>
                            <td class="rams-text--muted">{{ key | replace({'_': ' '}) | capitalize }}</td>
                            <td>{% if val is iterable %}{{ val | join(', ') }}{% elseif val is same as(true) %}✅{% else %}{{ val }}{% endif %}</td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>
            {% endif %}

            {# Supercap Profile #}
            {% if competitor.supercapProfile and competitor.supercapProfile | length > 0 %}
            <div class="rams-module rams-mb-4">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">⚡ Supercapacitor Profile</h2>
                </div>
                <div class="rams-module__content">
                    <table class="rams-table rams-table--kv">
                        {% for key, val in competitor.supercapProfile %}
                        <tr>
                            <td class="rams-text--muted">{{ key | replace({'_': ' '}) | capitalize }}</td>
                            <td>{% if val is iterable %}{{ val | join(', ') }}{% else %}{{ val }}{% endif %}</td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>
            {% endif %}

            {# Alt Domains #}
            {% if competitor.altDomains | length > 0 %}
            <div class="rams-module rams-mb-4">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">🌐 Alt Domains</h2>
                </div>
                <div class="rams-module__content">
                    {% for d in competitor.altDomains %}
                        <div class="rams-font-mono rams-text--xs" style="padding: 4px 0;">
                            <a href="https://{{ d }}" target="_blank" rel="noopener" class="rams-link">{{ d }}</a>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Change History #}
            {% if change_events | length > 0 %}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">📊 {{ 'competitor.dashboard.recent_changes'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    {% for event in change_events %}
                    <div style="padding: 8px 0; border-bottom: 1px solid var(--rams-border); {% if loop.last %}border-bottom: none;{% endif %}">
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-badge rams-badge--{% if event.severity == 'high' %}danger{% elseif event.severity == 'medium' %}warning{% else %}info{% endif %} rams-text--xs">
                                {{ event.severity }}
                            </span>
                            <span class="rams-text--xs rams-text--muted">{{ event.createdAt | date('M d, H:i') }}</span>
                        </div>
                        <div class="rams-font-mono rams-text--xs" style="margin-top: 4px;">{{ event.changeType }}</div>
                        <div class="rams-text--xs" style="margin-top: 2px;">{{ event.diffSummary }}</div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {# ── Notes ── #}
    {% if competitor.notes %}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">📝 Notes</h2>
        </div>
        <div class="rams-module__content">
            <p class="rams-text--sm">{{ competitor.notes }}</p>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
