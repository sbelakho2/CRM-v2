{% extends 'base.html.twig' %}

{% block title %}{{ 'audit_log.title'|trans }}   - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-flex rams-flex-col rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'audit_log.title'|trans }}</h1>  
            <p class="rams-page-subtitle">{{ 'audit_log.subtitle'|trans }}</p>     
        </div>
    </div>

    {# Filters Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <span class="rams-module__title">{{ 'filters.title'|trans }}</span>
        </div>
        <div class="rams-module__content">
            <form method="get" action="{{ path('app_audit_log_index') }}" class="rams-form">
                <div class="rams-form__row rams-form__row--4 rams-mb-4">
                    <div class="rams-form__group rams-mb-0">
                        <label for="entity_type" class="rams-dymo">{{ 'audit_log.entity_type'|trans }}</label>  
                        <select name="entity_type" id="entity_type" class="rams-form__select">
                            <option value="">{{ 'audit_log.all_types'|trans }}</option>  
                            {% for type in entity_types %}
                                <option value="{{ type }}" {% if current_entity_type == type %}selected{% endif %}>{{ type }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="rams-form__group rams-mb-0">
                        <label for="entity_id" class="rams-dymo">{{ 'audit_log.entity_id'|trans }}</label>  
                        <input type="text" name="entity_id" id="entity_id" value="{{ current_entity_id }}" placeholder="{{ 'audit_log.enter_id'|trans }}"   class="rams-form__input" />
                    </div>

                    <div class="rams-form__group rams-mb-0">
                        <label for="action" class="rams-dymo">{{ 'audit_log.col_action'|trans }}</label> 
                        <select name="action" id="action" class="rams-form__select">
                            <option value="">{{ 'audit_log.all_actions'|trans }}</option>  
                            {% for act in actions %}
                                <option value="{{ act }}" {% if current_action == act %}selected{% endif %}>{{ act|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="rams-form__group rams-mb-0 rams-flex rams-items-end">
                        <button type="submit" class="rams-btn rams-btn--primary rams-w-full"> 
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                            {{ 'common.filter'|trans }} 
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# Audit Log Table #}
    <div class="rams-module">
        <div class="rams-module__header">
            <span class="rams-module__title">{{ 'audit_log.log_count'|trans({'%count%': audit_logs|length}) }}</span>      
        </div>
        <div class="rams-module__content rams-p-0">
            <div class="rams-table-wrapper">
                <table class="rams-table">
                    <thead>
                        <tr>
                            <th>{{ 'audit_log.col_timestamp'|trans }}</th> <th>{{ 'audit_log.col_user'|trans }}</th> <th>{{ 'audit_log.col_action'|trans }}</th> <th>{{ 'audit_log.col_entity_type'|trans }}</th> <th>{{ 'audit_log.col_entity_id'|trans }}</th> <th>{{ 'audit_log.col_ip'|trans }}</th> 
                            
                            
                             
                             
                             
                            <th class="rams-text--center">{{ 'common.details'|trans }}</th> 
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in audit_logs %}
                            <tr>
                                <td>
                                    <span class="rams-text--sm">{{  log.createdAt|date('Y-m-d H:i:s') }}</span>
                                </td>
                                <td>
                                    {% if log.user %}
                                        <span class="rams-badge rams-badge--info">{{ log.user.fullName|default(log.user.email) }}</span>
                                    {% else %}
                                        <span class="rams-badge">{{ 'common.system'|trans }}</span>  
                                    {% endif %}
                                </td>
                                <td>
                                    {% if log.action == 'create' %}
                                        <span class="rams-badge rams-badge--success">{{ 'common.create'|trans }}</span> 
                                    {% elseif log.action == 'update' %}
                                        <span class="rams-badge rams-badge--warning">{{ 'common.update'|trans }}</span> 
                                    {% elseif log.action == 'delete' %}
                                        <span class="rams-badge rams-badge--danger">{{ 'common.delete'|trans }}</span> 
                                    {% else %}
                                        <span class="rams-badge">{{   log.action }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ log.entityType }}</td>
                                <td>{{ log.entityId }}</td>
                                <td>
                                    <span class="rams-text--xs rams-text--muted">{{ log.ipAddress|default('common.n_a'|trans)    }}</span>
                                </td>
                                <td class="rams-text--center"> 
                                    <a href="{{ path('app_audit_log_show', {'id': log.id}) }}" class="rams-btn rams-btn--sm rams-btn--ghost" aria-label="{{ 'common.details'|trans }}"> 
                                        <svg class="rams-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="rams-text--center rams-py-lg">  
                                    <p class="rams-text--muted">{{ 'audit_log.no_entries'|trans }}</p>     
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
