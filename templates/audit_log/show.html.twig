{% extends 'base.html.twig' %}

{% block title %}{{ 'audit_log.entry_title'|trans({'%id%': audit_log.id})     }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-flex rams-flex-col rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'audit_log.entry_title'|trans({'%id%': audit_log.id})      }}</h1>
            <p class="rams-page-subtitle">{{ 'audit_log.on_entity'|trans({'%action%': audit_log.action|capitalize, '%entity%': audit_log.entityType})      }}</p>
        </div>
        <div class="rams-page-actions">
            <a href="{{ path('app_audit_log_index') }}" class="rams-btn">
                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                {{ 'audit_log.back'|trans }}    
            </a>
        </div>
    </div>

    <div class="rams-grid rams-grid--2 rams-gap-6 mobile-stack">
        {# Details Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'audit_log.entry_details'|trans }}</span>  
            </div>
            <div class="rams-module__content">
                <dl class="rams-definition-list"> 
                    <div class="rams-definition-list__item"> 
                        <dt class="rams-definition-list__term">{{ 'common.id'|trans }}</dt> 
                        <dd class="rams-definition-list__desc">{{  audit_log.id }}</dd>
                    </div>
                    <div class="rams-definition-list__item"> 
                        <dt class="rams-definition-list__term">{{ 'audit_log.col_timestamp'|trans }}</dt> 
                        <dd class="rams-definition-list__desc">{{  audit_log.createdAt|date('Y-m-d H:i:s') }}</dd>
                    </div>
                    <div class="rams-definition-list__item"> 
                        <dt class="rams-definition-list__term">{{ 'audit_log.col_user'|trans }}</dt> 
                        <dd class="rams-definition-list__desc"> 
                            {% if audit_log.user %}
                                <span class="rams-badge rams-badge--info">{{ audit_log.user.fullName|default(audit_log.user.email) }}</span>
                            {% else %}
                                <span class="rams-badge">{{ 'common.system'|trans }}</span>  
                            {% endif %}
                        </dd>
                    </div>
                    <div class="rams-definition-list__item"> 
                        <dt class="rams-definition-list__term">{{ 'audit_log.col_action'|trans }}</dt> 
                        <dd class="rams-definition-list__desc"> 
                            {% if audit_log.action == 'create' %}
                                <span class="rams-badge rams-badge--success">{{ 'common.create'|trans }}</span> 
                            {% elseif audit_log.action == 'update' %}
                                <span class="rams-badge rams-badge--warning">{{ 'common.update'|trans }}</span> 
                            {% elseif audit_log.action == 'delete' %}
                                <span class="rams-badge rams-badge--danger">{{ 'common.delete'|trans }}</span> 
                            {% else %}
                                <span class="rams-badge">{{   audit_log.action }}</span>
                            {% endif %}
                        </dd>
                    </div>
                    <div class="rams-definition-list__item"> 
                        <dt class="rams-definition-list__term">{{ 'audit_log.col_entity_type'|trans }}</dt>  
                        <dd class="rams-definition-list__desc">{{  audit_log.entityType }}</dd>
                    </div>
                    <div class="rams-definition-list__item"> 
                        <dt class="rams-definition-list__term">{{ 'audit_log.col_entity_id'|trans }}</dt>  
                        <dd class="rams-definition-list__desc">{{  audit_log.entityId }}</dd>
                    </div>
                    <div class="rams-definition-list__item"> 
                        <dt class="rams-definition-list__term">{{ 'audit_log.col_ip'|trans }}</dt>  
                        <dd class="rams-definition-list__desc">{{ audit_log.ipAddress|default('common.n_a'|trans)   }}</dd>
                    </div>
                    <div class="rams-definition-list__item"> 
                        <dt class="rams-definition-list__term">{{ 'audit_log.user_agent'|trans }}</dt>  
                        <dd class="rams-definition-list__desc rams-text--xs">{{ audit_log.userAgent|default('common.n_a'|trans)    }}</dd>
                    </div>
                </dl>
            </div>
        </div>

        {# Changed Fields Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'audit_log.changed_fields'|trans }}</span>  
            </div>
            <div class="rams-module__content">
                {% if audit_log.changedFields is not empty %}
                    <ul class="rams-list">
                        {% for field in audit_log.changedFields %}
                            <li class="rams-list__item">
                                <span class="rams-badge">{{   field }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="rams-text--muted">{{ 'audit_log.no_field_changes'|trans }}</p>     
                {% endif %}
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--2 rams-gap-6 mobile-stack">
        {# Old Values Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'audit_log.old_values'|trans }}</span>  
            </div>
            <div class="rams-module__content">
                {% if audit_log.oldValues is not empty %}
                    <pre class="rams-code"><code>{{ audit_log.oldValues|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                {% else %}
                    <p class="rams-text--muted">{{ 'audit_log.no_old_values'|trans }}</p>    
                {% endif %}
            </div>
        </div>

        {# New Values Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-module__title">{{ 'audit_log.new_values'|trans }}</span>  
            </div>
            <div class="rams-module__content">
                {% if audit_log.newValues is not empty %}
                    <pre class="rams-code"><code>{{ audit_log.newValues|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                {% else %}
                    <p class="rams-text--muted">{{ 'audit_log.no_new_values'|trans }}</p>    
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
