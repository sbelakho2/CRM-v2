                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">${i18n.dateTo}</label>
                        <input type="date" name="dateTo" class="rams-form__input">
                    </div>
                </div>
                
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">${i18n.sectorFilter}</label>
                    <input type="text" name="sector" placeholder="${i18n.sectorPlaceholder}" class="rams-form__input">
                </div>
                
                <div class="rams-form__group">
