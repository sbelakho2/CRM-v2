{% extends 'base.html.twig' %}

{% block title %}{{ 'discovery_pipeline.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack">
    {# Header Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <div>
                <h1 class="rams-module__title">🔍 {{ 'discovery_pipeline.title'|trans }}</h1>
                <p class="rams-dymo">{{ 'discovery_pipeline.subtitle'|trans }}</p>
            </div>
            
            {# Export Dropdown #}
            <div class="rams-dropdown-container" id="export-dropdown">
                <button type="button" onclick="toggleExportDropdown()" class="rams-btn--primary" aria-expanded="false" aria-haspopup="true">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    {{ 'discovery_pipeline.export_csv'|trans }}
                    <svg class="rams-btn__icon--end" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div class="rams-dropdown rams-hidden" id="export-dropdown-menu">
                    <div class="rams-dropdown__content">
                        <p class="rams-dropdown__header">{{ 'discovery_pipeline.export_options'|trans }}</p>
                        <a href="{{ path('export_leads') }}" class="rams-dropdown__item">
                            📋 {{ 'discovery_pipeline.export_all'|trans }}
                        </a>
                        <a href="{{ path('export_leads', {hasEmails: 1}) }}" class="rams-dropdown__item">
                            📧 {{ 'discovery_pipeline.export_with_emails'|trans }}
                        </a>
                        <a href="{{ path('export_leads', {hasContactForm: 1}) }}" class="rams-dropdown__item">
                            📝 {{ 'discovery_pipeline.export_with_forms'|trans }}
                        </a>
                        <a href="{{ path('export_leads', {status: 'approved'}) }}" class="rams-dropdown__item">
                            ✅ {{ 'discovery_pipeline.export_approved'|trans }}
                        </a>
                        <div class="rams-dropdown__divider"></div>
                        <a href="#" onclick="exportCustomLeads(); return false;" class="rams-dropdown__item">
                            ⚙️ {{ 'discovery_pipeline.export_custom'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Stats Cards #}
    <div class="rams-grid rams-grid--6">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.total_leads'|trans }}</span>
                    <span class="rams-metric__value rams-rams-text--info">{{ stats.total_leads }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.today'|trans }}</span>
                    <span class="rams-metric__value rams-rams-text--success">{{ stats.today_leads }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.with_emails'|trans }}</span>
                    <span class="rams-metric__value">{{ stats.with_emails }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.has_contact_form'|trans }}</span>
                    <span class="rams-metric__value">{{ stats.with_contact_forms|default(0) }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.enrichment_rate'|trans }}</span>
                    <span class="rams-metric__value rams-rams-text--warning">{{ stats.enrichment_rate }}%</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.pending_review'|trans }}</span>
                    <span class="rams-metric__value rams-rams-text--danger">{{ stats.pending_review }}</span>
                </div>
            </div>
        </div>
    </div>
    
    {# Real-time Progress Bar #}
    <div id="progress-container" class="rams-hidden">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-module__header">
                    <h3 class="rams-module__title">🔄 {{ 'discovery_pipeline.enrichment_progress'|trans }}</h3>
                    <span id="progress-status" class="rams-dymo">{{ 'messages.processing'|trans }}...</span>
                </div>
                <div class="rams-progress">
                    <div id="progress-bar" class="rams-progress__bar" style="width: 0%"></div>
                </div>
                <div class="rams-metric">
                    <span id="progress-enriched" class="rams-dymo">0 {{ 'discovery_pipeline.enriched'|trans }}</span>
                    <span id="progress-percent" class="rams-metric__value">0%</span>
                    <span id="progress-pending" class="rams-dymo">0 {{ 'common.pending'|trans }}</span>
                </div>
                <div id="progress-details" class="rams-stack">
                    <div class="rams-andon rams-andon--success">
                        <span class="rams-andon__light"></span>
                        <span id="recently-scraped-text" class="rams-dymo">0 {{ 'discovery_pipeline.leads_scraped'|trans }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--2">
        {# Pipeline Runner Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">🚀 {{ 'discovery_pipeline.run_pipeline'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                <form id="pipeline-form" class="rams-form">
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'discovery_pipeline.target_sector'|trans }} *</label>
                        <select name="sector" required class="rams-form__select">
                            <option value="">{{ 'discovery_pipeline.select_sector'|trans }}</option>
                            {% for sector in sectors %}
                                <option value="{{ sector }}">{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'discovery_pipeline.geographic_focus'|trans }}</label>
                        <select name="location" class="rams-form__select">
                            <option value="">{{ 'discovery_pipeline.all_locations'|trans }}</option>
                            {% for key, label in locations %}
                                <option value="{{ key }}">{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <div class="rams-stack rams-gap-2 rams-mb-4">
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="auto_import" checked class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label">{{ 'discovery_pipeline.auto_import'|trans }}</span>
                        </label>
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="enable_deep_scrape" checked class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label">{{ 'discovery_pipeline.enable_deep_scrape'|trans }}</span>
                        </label>
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="enable_llm" class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label">{{ 'discovery_pipeline.use_llm'|trans }}</span>
                        </label>
                    </div>
                    
                    <div class="rams-form__actions">
                        <button type="button" id="preview-btn" class="rams-btn">
                            {{ 'discovery_pipeline.preview_results'|trans }}
                        </button>
                        <button type="submit" id="run-btn" class="rams-btn--primary">
                            {{ 'discovery_pipeline.run_pipeline_btn'|trans }}
                        </button>
                    </div>
                </form>
                
                {# Results #}
                <div id="pipeline-results" class="rams-hidden rams-mt-4">
                    <h3 class="rams-dymo">{{ 'discovery_pipeline.results'|trans }}</h3>
                    <div id="results-content" class="rams-module rams-module--inset rams-p-4"></div>
                </div>
            </div>
        </div>

        {# Enrich Existing Leads Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">✨ {{ 'discovery_pipeline.enrich_existing'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                <p class="rams-rams-text--muted rams-rams-text--sm rams-mb-4">
                    {{ 'discovery_pipeline.enrich_description'|trans }}
                </p>
                
                <form id="enrich-form" class="rams-form">
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'discovery_pipeline.number_of_leads'|trans }}</label>
                        <input type="number" name="limit" value="50" min="1" max="100" class="rams-form__input">
                        <p class="rams-form__hint">{{ 'discovery_pipeline.max_per_batch'|trans }}</p>
                    </div>
                    
                    <div class="rams-form__group">
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="enable_llm" class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label">{{ 'discovery_pipeline.use_llm'|trans }}</span>
                        </label>
                    </div>
                    
                    <div class="rams-form__actions">
                        <button type="submit" class="rams-btn--primary">
                            {{ 'discovery_pipeline.start_enrichment'|trans }}
                        </button>
                    </div>
                </form>
                
                <div id="enrich-results" class="rams-hidden rams-mt-4">
                    <div class="rams-alert rams-alert--success"></div>
                </div>
            </div>
        </div>
    </div>

    {# Preview Results Table #}
    <div id="preview-table-container" class="rams-mt-8 rams-hidden">
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="rams-module__title">{{ 'discovery_pipeline.search_preview'|trans }}</h3>
            </div>
            <div class="rams-module__content rams-overflow-x-auto">
                <table class="rams-table rams-w-full">
                    <thead class="rams-table__header">
                        <tr>
                            <th class="rams-table__cell">{{ 'company.title_singular'|trans }}</th>
                            <th class="rams-table__cell">{{ 'company.website'|trans }}</th>
                            <th class="rams-table__cell">{{ 'common.description'|trans }}</th>
                            <th class="rams-table__cell rams-rams-text--center">{{ 'common.status'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody id="preview-table-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
let progressInterval = null;
let isPolling = false;
const i18n = {
    running: '{{ 'discovery_pipeline.running'|trans|e('js') }}',
    runPipeline: '{{ 'discovery_pipeline.run_pipeline_btn'|trans|e('js') }}',
    loading: '{{ 'common.loading'|trans|e('js') }}',
    previewResults: '{{ 'discovery_pipeline.preview_results'|trans|e('js') }}',
    selectSector: '{{ 'discovery_pipeline.select_sector_error'|trans|e('js') }}',
    processing: '{{ 'messages.processing'|trans|e('js') }}',
    startEnrichment: '{{ 'discovery_pipeline.start_enrichment'|trans|e('js') }}',
    searched: '{{ 'discovery_pipeline.stats.searched'|trans|e('js') }}',
    imported: '{{ 'discovery_pipeline.stats.imported'|trans|e('js') }}',
    duplicates: '{{ 'discovery_pipeline.stats.duplicates'|trans|e('js') }}',
    queuedForScrape: '{{ 'discovery_pipeline.stats.queued_for_scrape'|trans|e('js') }}',
    errorLabel: '{{ 'common.error'|trans|e('js') }}',
    statusDuplicate: '{{ 'discovery_pipeline.status.duplicate'|trans|e('js') }}',
    statusNew: '{{ 'discovery_pipeline.status.new'|trans|e('js') }}',
    foundResults: '{{ 'discovery_pipeline.found_results'|trans|e('js') }}',
    enrichedLabel: '{{ 'discovery_pipeline.enriched'|trans|e('js') }}',
    pendingLabel: '{{ 'common.pending'|trans|e('js') }}',
    leadsScrapedRecent: '{{ 'discovery_pipeline.leads_scraped_recent'|trans|e('js') }}',
    processingActive: '{{ 'discovery_pipeline.processing_active'|trans|e('js') }}',
    complete: '{{ 'discovery_pipeline.complete'|trans|e('js') }}',
    idleWaiting: '{{ 'discovery_pipeline.idle_waiting'|trans|e('js') }}',
    exportTitle: '{{ 'discovery_pipeline.export_custom_title'|trans|e('js') }}',
    reviewStatus: '{{ 'discovery_pipeline.review_status'|trans|e('js') }}',
    allStatuses: '{{ 'discovery_pipeline.all_statuses'|trans|e('js') }}',
    statusPending: '{{ 'discovery_pipeline.status.pending'|trans|e('js') }}',
    statusApproved: '{{ 'discovery_pipeline.status.approved'|trans|e('js') }}',
    statusRejected: '{{ 'discovery_pipeline.status.rejected'|trans|e('js') }}',
    dateFrom: '{{ 'filters.from'|trans|e('js') }}',
    dateTo: '{{ 'filters.to'|trans|e('js') }}',
    sectorFilter: '{{ 'discovery_pipeline.sector_filter'|trans|e('js') }}',
    sectorPlaceholder: '{{ 'discovery_pipeline.sector_placeholder'|trans|e('js') }}',
    region: '{{ 'discovery_pipeline.region'|trans|e('js') }}',
    allRegions: '{{ 'discovery_pipeline.all_regions'|trans|e('js') }}',
    regionNorthAmerica: '{{ 'discovery_pipeline.region_north_america'|trans|e('js') }}',
    regionEurope: '{{ 'discovery_pipeline.region_europe'|trans|e('js') }}',
    regionAsiaPacific: '{{ 'discovery_pipeline.region_asia_pacific'|trans|e('js') }}',
    dataFilters: '{{ 'discovery_pipeline.data_filters'|trans|e('js') }}',
    onlyWithEmails: '{{ 'discovery_pipeline.only_with_emails'|trans|e('js') }}',
    onlyWithContactForms: '{{ 'discovery_pipeline.only_with_contact_forms'|trans|e('js') }}',
    cancel: '{{ 'common.cancel'|trans|e('js') }}',
    exportCsv: '{{ 'discovery_pipeline.export_csv'|trans|e('js') }}'
};

// Export Dropdown Toggle (vanilla JS replacement for Alpine.js)
function toggleExportDropdown() {
    const menu = document.getElementById('export-dropdown-menu');
    const btn = document.querySelector('#export-dropdown button');
    const isOpen = !menu.classList.contains('rams-hidden');
    
    if (isOpen) {
        closeExportDropdown();
    } else {
        menu.classList.remove('rams-hidden');
        btn.setAttribute('aria-expanded', 'true');
        // Close when clicking outside
        document.addEventListener('click', handleExportDropdownOutsideClick);
    }
}

function closeExportDropdown() {
    const menu = document.getElementById('export-dropdown-menu');
    const btn = document.querySelector('#export-dropdown button');
    menu.classList.add('rams-hidden');
    btn.setAttribute('aria-expanded', 'false');
    document.removeEventListener('click', handleExportDropdownOutsideClick);
}

function handleExportDropdownOutsideClick(e) {
    const dropdown = document.getElementById('export-dropdown');
    if (!dropdown.contains(e.target)) {
        closeExportDropdown();
    }
}

function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `rams-alert ${type === 'success' ? 'rams-alert--success' : 'rams-alert--error'} rams-alert--toast`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 5000);
}

// Progress polling functions
function startProgressPolling() {
    if (isPolling) return;
    isPolling = true;
    
    document.getElementById('progress-container').classList.remove('rams-hidden');
    
    // Poll every 3 seconds
    progressInterval = setInterval(async () => {
        try {
            const response = await fetch('/discovery-pipeline/progress');
            const data = await response.json();
            
            // Update progress bar
            const progressBar = document.getElementById('progress-bar');
            const progressPercent = document.getElementById('progress-percent');
            const progressStatus = document.getElementById('progress-status');
            const progressEnriched = document.getElementById('progress-enriched');
            const progressPending = document.getElementById('progress-pending');
            const recentlyScrapedText = document.getElementById('recently-scraped-text');
            
            progressBar.style.width = data.progress + '%';
            progressPercent.textContent = data.progress + '%';
            progressEnriched.textContent = `${data.enriched} ${i18n.enrichedLabel}`;
            progressPending.textContent = `${data.pending_enrichment} ${i18n.pendingLabel}`;
            recentlyScrapedText.textContent = i18n.leadsScrapedRecent.replace('%count%', data.recently_scraped);
            
            // Update status text
            if (data.recently_scraped > 0) {
                progressStatus.textContent = i18n.processingActive.replace('%count%', data.recently_scraped);
                progressStatus.className = 'rams-text--sm rams-text--success';
            } else if (data.pending_enrichment === 0) {
                progressStatus.textContent = i18n.complete;
                progressStatus.className = 'rams-text--sm rams-text--success';
                stopProgressPolling();
            } else {
                progressStatus.textContent = i18n.idleWaiting;
                progressStatus.className = 'rams-text--sm rams-text--muted';
            }
            
        } catch (e) {
            console.error('Progress poll failed:', e);
        }
    }, 3000);
    
    // Also poll immediately
    fetch('/discovery-pipeline/progress')
        .then(r => r.json())
        .then(data => {
            document.getElementById('progress-bar').style.width = data.progress + '%';
            document.getElementById('progress-percent').textContent = data.progress + '%';
        });
}

function stopProgressPolling() {
    if (progressInterval) {
        clearInterval(progressInterval);
        progressInterval = null;
    }
    isPolling = false;
}

// Pipeline Form
document.getElementById('pipeline-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('run-btn');
    btn.disabled = true;
    btn.textContent = i18n.running;
    
    const data = {
        sector: form.sector.value,
        location: form.location.value || null,
        auto_import: form.auto_import.checked,
        enable_deep_scrape: form.enable_deep_scrape.checked,
        enable_llm: form.enable_llm.checked
    };
    
    try {
        const response = await fetch('/discovery-pipeline/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        const resultsDiv = document.getElementById('pipeline-results');
        const contentDiv = document.getElementById('results-content');
        resultsDiv.classList.remove('rams-hidden');
        
        if (result.success) {
            contentDiv.innerHTML = `
                <div class="rams-text--success rams-mb-2" style="font-weight: 500;">✓ ${result.message}</div>
                <div class="rams-grid rams-grid--2 rams-gap-2 rams-text--muted">
                    <div>${i18n.searched}: ${result.stats.searched}</div>
                    <div>${i18n.imported}: ${result.stats.imported}</div>
                    <div>${i18n.duplicates}: ${result.stats.duplicates}</div>
                    <div>${i18n.queuedForScrape}: ${result.stats.queued_for_scrape}</div>
                </div>
            `;
            showToast(result.message);
            
            // Start progress polling if leads were queued for scraping
            if (result.stats.queued_for_scrape > 0) {
                startProgressPolling();
            }
        } else {
            contentDiv.innerHTML = `<div class="rams-text--danger">${i18n.errorLabel}: ${result.error}</div>`;
            showToast(`${i18n.errorLabel}: ${result.error}`, 'error');
        }
    } catch (e) {
        showToast(`${i18n.errorLabel}: ${e.message}`, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = i18n.runPipeline;
    }
});

// Preview Button
document.getElementById('preview-btn').addEventListener('click', async () => {
    const form = document.getElementById('pipeline-form');
    const btn = document.getElementById('preview-btn');
    btn.disabled = true;
    btn.textContent = i18n.loading;
    
    const data = {
        sector: form.sector.value,
        location: form.location.value || null
    };
    
    if (!data.sector) {
        showToast(i18n.selectSector, 'error');
        btn.disabled = false;
        btn.textContent = i18n.previewResults;
        return;
    }
    
    try {
        const response = await fetch('/discovery-pipeline/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        if (result.success) {
            const container = document.getElementById('preview-table-container');
            const tbody = document.getElementById('preview-table-body');
            
            tbody.innerHTML = result.results.map(r => `
                <tr class="${r.is_duplicate ? 'rams-table__row--muted' : ''}">
                    <td class="rams-table__cell">${r.name}</td>
                    <td class="rams-table__cell">
                        ${r.website ? `<a href="${r.website}" target="_blank" class="rams-link">${r.website}</a>` : '—'}
                    </td>
                    <td class="rams-table__cell rams-text--muted">${r.snippet || '—'}</td>
                    <td class="rams-table__cell rams-text--center">
                        ${r.is_duplicate 
                            ? `<span class="rams-badge rams-badge--muted">${i18n.statusDuplicate}</span>`
                            : `<span class="rams-badge rams-badge--green">${i18n.statusNew}</span>`}
                    </td>
                </tr>
            `).join('');
            
            container.classList.remove('rams-hidden');
            showToast(i18n.foundResults
                .replace('%total%', result.total)
                .replace('%new%', result.new_leads)
                .replace('%duplicates%', result.duplicates));
        } else {
            showToast(result.error, 'error');
        }
    } catch (e) {
        showToast(`${i18n.errorLabel}: ${e.message}`, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = i18n.previewResults;
    }
});

// Enrich Form
document.getElementById('enrich-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = i18n.processing;
    
    const data = {
        limit: parseInt(form.limit.value),
        enable_llm: form.enable_llm.checked
    };
    
    try {
        const response = await fetch('/discovery-pipeline/enrich-existing', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        const resultsDiv = document.getElementById('enrich-results');
        resultsDiv.classList.remove('rams-hidden');
        resultsDiv.querySelector('div').textContent = result.success 
            ? `✓ ${result.message}` 
            : `${i18n.errorLabel}: ${result.error}`;
        
        if (result.success) {
            showToast(result.message);
            // Start progress polling when enrichment begins
            startProgressPolling();
        } else {
            showToast(`${i18n.errorLabel}: ${result.error}`, 'error');
        }
    } catch (e) {
        showToast(`${i18n.errorLabel}: ${e.message}`, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = i18n.startEnrichment;
    }
});

// Custom Export Modal
function exportCustomLeads() {
    // Create modal
    const modal = document.createElement('div');
    modal.className = 'rams-modal-overlay';
    modal.id = 'export-modal';
    
    modal.innerHTML = `
        <div class="rams-modal">
            <div class="rams-modal__header">
                <h3 class="rams-modal__title">${i18n.exportTitle}</h3>
            </div>
            <form id="custom-export-form" class="rams-modal__body rams-stack rams-gap-4">
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">${i18n.reviewStatus}</label>
                    <select name="status" class="rams-form__select">
                        <option value="">${i18n.allStatuses}</option>
                        <option value="pending">${i18n.statusPending}</option>
                        <option value="approved">${i18n.statusApproved}</option>
                        <option value="rejected">${i18n.statusRejected}</option>
                    </select>
                </div>
                
                <div class="rams-grid rams-grid--2">
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">${i18n.dateFrom}</label>
                        <input type="date" name="dateFrom" class="rams-form__input">
                    </div>
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">${i18n.dateTo}</label>
                        <input type="date" name="dateTo" class="rams-form__input">
                    </div>
                </div>
                
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">${i18n.sectorFilter}</label>
                    <input type="text" name="sector" placeholder="${i18n.sectorPlaceholder}" class="rams-form__input">
                </div>
                
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">${i18n.region}</label>
                    <select name="region" class="rams-form__select">
                        <option value="">${i18n.allRegions}</option>
                        <option value="north_america">${i18n.regionNorthAmerica}</option>
                        <option value="europe">${i18n.regionEurope}</option>
                        <option value="asia_pacific">${i18n.regionAsiaPacific}</option>
                    </select>
                </div>
                
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">${i18n.dataFilters}</label>
                    <div class="rams-stack rams-gap-2">
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="hasEmails" class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label">${i18n.onlyWithEmails}</span>
                        </label>
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="hasContactForm" class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label">${i18n.onlyWithContactForms}</span>
                        </label>
                    </div>
                </div>
                
                <div class="rams-modal__footer">
                    <button type="button" onclick="closeExportModal()" class="rams-btn">
                        ${i18n.cancel}
                    </button>
                    <button type="submit" class="rams-btn--primary">
                        ${i18n.exportCsv}
                    </button>
                </div>
            </form>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    // Handle form submission
    document.getElementById('custom-export-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const form = e.target;
        const params = new URLSearchParams();
        
        if (form.status.value) params.append('status', form.status.value);
        if (form.dateFrom.value) params.append('dateFrom', form.dateFrom.value);
        if (form.dateTo.value) params.append('dateTo', form.dateTo.value);
        if (form.sector.value) params.append('sector', form.sector.value);
        if (form.region.value) params.append('region', form.region.value);
        if (form.hasEmails.checked) params.append('hasEmails', '1');
        if (form.hasContactForm.checked) params.append('hasContactForm', '1');
        
        // Trigger download
        window.location.href = '{{ path("export_leads") }}?' + params.toString();
        
        closeExportModal();
    });
}

function closeExportModal() {
    const modal = document.getElementById('export-modal');
    if (modal) modal.remove();
}
</script>
{% endblock %}
