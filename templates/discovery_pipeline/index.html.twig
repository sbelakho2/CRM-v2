{% extends 'base.html.twig' %}

{% block title %}{{ 'discovery_pipeline.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Header Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <div>
                <h1 class="rams-module__title">
                    <svg class="rams-icon rams-icon--info" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: text-bottom; margin-right: 8px;">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    {{ 'discovery_pipeline.title'|trans }}
                </h1>
                <p class="rams-dymo">{{ 'discovery_pipeline.subtitle'|trans }}</p>
            </div>
        </div>
    </div>

    {# Pipeline Status Bar #}
    <div class="rams-grid rams-grid--4">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.current_status'|trans }}</span>
                    <span class="rams-metric__value">
                        {% if pipeline_status == 'running' %}
                            <span class="rams-text--success">
                                <span class="rams-andon rams-andon--success" style="display: inline-block; vertical-align: middle; margin-right: 4px;"><span class="rams-andon__light rams-andon__light--pulse"></span></span>
                                {{ 'discovery_pipeline.status_running'|trans }}
                            </span>
                        {% else %}
                            <span class="rams-text--muted">
                                <span class="rams-andon rams-andon--info" style="display: inline-block; vertical-align: middle; margin-right: 4px;"><span class="rams-andon__light"></span></span>
                                {{ 'discovery_pipeline.status_idle'|trans }}
                            </span>
                        {% endif %}
                    </span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.total_leads'|trans }}</span>
                    <span class="rams-metric__value rams-text--info">{{ stats.total_leads }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.contacts_found'|trans }}</span>
                    <span class="rams-metric__value rams-text--success">{{ contacts_found }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.enrichment_rate'|trans }}</span>
                    <span class="rams-metric__value rams-text--warning">{{ stats.enrichment_rate }}%</span>
                </div>
            </div>
        </div>
    </div>

    {# Stats Cards Row #}
    <div class="rams-grid rams-grid--6">
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.today'|trans }}</span>
                    <span class="rams-metric__value rams-text--success">{{ stats.today_leads }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.with_emails'|trans }}</span>
                    <span class="rams-metric__value">{{ stats.with_emails }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.has_contact_form'|trans }}</span>
                    <span class="rams-metric__value">{{ stats.with_contact_forms|default(0) }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.pending_review'|trans }}</span>
                    <span class="rams-metric__value rams-text--danger">{{ stats.pending_review }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.recently_scraped'|trans }}</span>
                    <span class="rams-metric__value">{{ stats.recently_scraped }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--compact">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'discovery_pipeline.last_run_label'|trans }}</span>
                    <span class="rams-metric__value rams-text--xs">
                        {% if pipeline_history|length > 0 %}
                            {{ pipeline_history[0].run_date }}
                        {% else %}
                            {{ 'common.never'|trans }}
                        {% endif %}
                    </span>
                </div>
            </div>
        </div>
    </div>

    {# Real-time Progress Visualization #}
    <div id="progress-container" class="rams-hidden">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-module__header">
                    <h3 class="rams-module__title">
                        <svg class="rams-icon rams-icon--info rams-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 8px;">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
                        </svg>
                        {{ 'discovery_pipeline.enrichment_progress'|trans }}
                    </h3>
                    <span id="progress-status" class="rams-dymo">{{ 'messages.processing'|trans }}...</span>
                </div>
                
                {# Step Indicators #}
                <div class="rams-flex rams-gap-2 rams-mb-4" id="progress-steps">
                    <div class="rams-step rams-step--active" data-step="1">
                        <div class="rams-step__indicator">1</div>
                        <span class="rams-step__label rams-text--xs">{{ 'discovery_pipeline.step_discovery'|trans }}</span>
                    </div>
                    <div class="rams-step__connector"></div>
                    <div class="rams-step" data-step="2">
                        <div class="rams-step__indicator">2</div>
                        <span class="rams-step__label rams-text--xs">{{ 'discovery_pipeline.step_import'|trans }}</span>
                    </div>
                    <div class="rams-step__connector"></div>
                    <div class="rams-step" data-step="3">
                        <div class="rams-step__indicator">3</div>
                        <span class="rams-step__label rams-text--xs">{{ 'discovery_pipeline.step_scrape'|trans }}</span>
                    </div>
                    <div class="rams-step__connector"></div>
                    <div class="rams-step" data-step="4">
                        <div class="rams-step__indicator">4</div>
                        <span class="rams-step__label rams-text--xs">{{ 'discovery_pipeline.step_enrich'|trans }}</span>
                    </div>
                </div>

                {# Main Progress Bar #}
                <div class="rams-progress rams-progress--lg">
                    <div id="progress-bar" class="rams-progress__bar" style="width: 0%"></div>
                </div>
                <div class="rams-flex rams-justify-between rams-items-center rams-mt-2">
                    <div class="rams-flex rams-gap-4">
                        <span id="progress-enriched" class="rams-dymo">0 {{ 'discovery_pipeline.enriched'|trans }}</span>
                        <span id="progress-percent" class="rams-metric__value rams-text--info">0%</span>
                        <span id="progress-pending" class="rams-dymo">0 {{ 'common.pending'|trans }}</span>
                    </div>
                    <span id="progress-timestamp" class="rams-text--xs rams-text--muted"></span>
                </div>

                {# Detail Cards #}
                <div class="rams-grid rams-grid--3 rams-mt-4" id="progress-details">
                    <div class="rams-module rams-module--nested">
                        <div class="rams-module__content rams-text--center">
                            <div class="rams-andon rams-andon--success rams-justify-center">
                                <span class="rams-andon__light"></span>
                                <span id="recently-scraped-text" class="rams-dymo">0 {{ 'discovery_pipeline.leads_scraped'|trans }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="rams-module rams-module--nested">
                        <div class="rams-module__content rams-text--center">
                            <div class="rams-andon rams-andon--info rams-justify-center">
                                <span class="rams-andon__light"></span>
                                <span id="recently-updated-text" class="rams-dymo">0 {{ 'discovery_pipeline.leads_updated'|trans }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="rams-module rams-module--nested">
                        <div class="rams-module__content rams-text--center">
                            <div class="rams-andon rams-andon--warning rams-justify-center">
                                <span class="rams-andon__light"></span>
                                <span id="pending-enrichment-text" class="rams-dymo">0 {{ 'discovery_pipeline.pending_enrichment'|trans }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Main Grid: Pipeline Runner + Pipeline History #}
    <div class="rams-grid rams-grid--2">
        {# Pipeline Runner #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">
                    <svg class="rams-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 8px;">
                        <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
                        <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
                        <path d="M9 12H4s.55-3.03 2-5c1.62-2.2 5-3 5-3"></path>
                        <path d="M12 15v5s3.03-.55 5-2c2.2-1.62 3-5 3-5"></path>
                    </svg>
                    {{ 'discovery_pipeline.run_configuration'|trans }}
                </h2>
            </div>
            <div class="rams-module__content">
                <form id="pipeline-form" class="rams-form">
                    <div class="rams-flex rams-flex-wrap rams-gap-4 rams-items-end">
                        <div class="rams-form__group" style="min-width: 180px; flex: 1;">
                            <label class="rams-form__label rams-dymo">{{ 'discovery_pipeline.target_sector'|trans }} *</label>
                            <select name="sector" required class="rams-form__select">
                                <option value="">{{ 'discovery_pipeline.select_sector'|trans }}</option>
                                {% for sector in sectors %}
                                    <option value="{{ sector }}">{{ sector }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="rams-form__group" style="min-width: 180px; flex: 1;">
                            <label class="rams-form__label rams-dymo">{{ 'discovery_pipeline.geographic_focus'|trans }}</label>
                            <select name="location" class="rams-form__select">
                                <option value="">{{ 'discovery_pipeline.all_locations'|trans }}</option>
                                {% for key, label in locations %}
                                    <option value="{{ key }}">{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    
                    <div class="rams-flex rams-flex-wrap rams-gap-4 rams-items-center rams-my-3">
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="auto_import" checked class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label rams-text--sm">{{ 'discovery_pipeline.auto_import'|trans }}</span>
                        </label>
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="enable_deep_scrape" checked class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label rams-text--sm">{{ 'discovery_pipeline.enable_deep_scrape'|trans }}</span>
                        </label>
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="enable_llm" class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label rams-text--sm">{{ 'discovery_pipeline.use_llm'|trans }}</span>
                        </label>
                    </div>
                    
                    <div class="rams-flex rams-gap-2">
                        <button type="button" id="preview-btn" class="rams-btn">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            {{ 'discovery_pipeline.preview_results'|trans }}
                        </button>
                        <button type="submit" id="run-btn" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            {{ 'discovery_pipeline.run_pipeline_btn'|trans }}
                        </button>
                    </div>
                </form>
                
                {# Run Results #}
                <div id="pipeline-results" class="rams-hidden rams-mt-4">
                    <div class="rams-module rams-module--nested">
                        <div class="rams-module__header">
                            <h4 class="rams-module__title">{{ 'discovery_pipeline.results'|trans }}</h4>
                        </div>
                        <div id="results-content" class="rams-module__content rams-p-4"></div>
                    </div>
                </div>
            </div>
        </div>

        {# Pipeline History #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">
                    <svg class="rams-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 8px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    {{ 'discovery_pipeline.pipeline_history'|trans }}
                </h2>
                <span class="rams-dymo">{{ 'discovery_pipeline.last_5_runs'|trans }}</span>
            </div>
            <div class="rams-module__content">
                {% if pipeline_history|length > 0 %}
                    <div class="rams-stack rams-gap-3">
                        {% for run in pipeline_history %}
                            <div class="rams-module rams-module--nested {% if loop.first %}rams-module--highlight{% endif %}">
                                <div class="rams-module__content rams-p-3">
                                    <div class="rams-flex rams-justify-between rams-items-center rams-mb-2">
                                        <div class="rams-flex rams-gap-2 rams-items-center">
                                            <span class="rams-badge rams-badge--green">{{ run.status|capitalize }}</span>
                                            <span class="rams-font--medium">{{ run.run_date }}</span>
                                        </div>
                                        <span class="rams-text--xs rams-text--muted">{{ run.time_taken }}s</span>
                                    </div>
                                    <div class="rams-flex rams-gap-3 rams-text--sm">
                                        <span class="rams-text--muted">
                                            <strong class="rams-text--info">{{ run.leads_found }}</strong> {{ 'discovery_pipeline.leads_found'|trans }}
                                        </span>
                                        <span class="rams-text--muted">
                                            <strong class="rams-text--success">{{ run.contacts_enriched }}</strong> {{ 'discovery_pipeline.contacts_enriched'|trans }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="rams-text--center rams-text--muted rams-py-4">
                        <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin: 0 auto 8px; display: block; opacity: 0.4;">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <p>{{ 'discovery_pipeline.no_history'|trans }}</p>
                        <p class="rams-text--xs">{{ 'discovery_pipeline.no_history_hint'|trans }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Enrich Existing Leads Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">
                <svg class="rams-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 8px;">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
                    <path d="M5 3v4"></path>
                    <path d="M19 17v4"></path>
                    <path d="M3 5h4"></path>
                    <path d="M17 19h4"></path>
                </svg>
                {{ 'discovery_pipeline.enrich_existing'|trans }}
            </h2>
        </div>
        <div class="rams-module__content">
            <div class="rams-flex rams-flex-wrap rams-gap-6 rams-items-end">
                <div class="rams-form__group" style="min-width: 200px;">
                    <p class="rams-text--muted rams-text--sm rams-mb-2">
                        {{ 'discovery_pipeline.enrich_description'|trans }}
                    </p>
                    <form id="enrich-form" class="rams-form rams-flex rams-flex-wrap rams-gap-3 rams-items-end">
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'discovery_pipeline.number_of_leads'|trans }}</label>
                            <input type="number" name="limit" value="50" min="1" max="100" class="rams-form__input" style="width: 100px;">
                        </div>
                        <div class="rams-form__group">
                            <label class="rams-form__checkbox-container">
                                <input type="checkbox" name="enable_llm" class="rams-form__checkbox-input">
                                <span class="rams-form__checkbox-label">{{ 'discovery_pipeline.use_llm'|trans }}</span>
                            </label>
                        </div>
                        <button type="submit" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            {{ 'discovery_pipeline.start_enrichment'|trans }}
                        </button>
                    </form>
                </div>
                <div id="enrich-results" class="rams-hidden">
                    <div class="rams-alert rams-alert--success"></div>
                </div>
            </div>
        </div>
    </div>

    {# Preview Results Table #}
    <div id="preview-table-container" class="rams-hidden">
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="rams-module__title">{{ 'discovery_pipeline.search_preview'|trans }}</h3>
                <span id="preview-summary" class="rams-dymo"></span>
            </div>
            <div class="rams-module__content rams-overflow-x-auto">
                <table class="rams-table rams-w-full data-table" data-no-datatable>
                    <thead class="rams-table__header">
                        <tr>
                            <th class="rams-table__cell">{{ 'company.title_singular'|trans }}</th>
                            <th class="rams-table__cell">{{ 'company.website'|trans }}</th>
                            <th class="rams-table__cell">{{ 'common.description'|trans }}</th>
                            <th class="rams-table__cell rams-text--center">{{ 'common.status'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody id="preview-table-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Export Section #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h3 class="rams-module__title">
                <svg class="rams-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 8px;">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                {{ 'discovery_pipeline.export_section'|trans }}
            </h3>
        </div>
        <div class="rams-module__content">
            <div class="rams-flex rams-flex-wrap rams-gap-3">
                <a href="{{ path('export_leads') }}" class="rams-btn">
                    <svg class="rams-btn__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                    {{ 'discovery_pipeline.export_all'|trans }}
                </a>
                <a href="{{ path('export_leads', {hasEmails: 1}) }}" class="rams-btn">
                    <svg class="rams-btn__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    {{ 'discovery_pipeline.export_with_emails'|trans }}
                </a>
                <a href="{{ path('export_leads', {hasContactForm: 1}) }}" class="rams-btn">
                    <svg class="rams-btn__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    {{ 'discovery_pipeline.export_with_forms'|trans }}
                </a>
                <a href="{{ path('export_leads', {status: 'approved'}) }}" class="rams-btn">
                    <svg class="rams-btn__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {{ 'discovery_pipeline.export_approved'|trans }}
                </a>
                <button type="button" onclick="exportCustomLeads()" class="rams-btn rams-btn--ghost">
                    <svg class="rams-btn__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33 1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82 1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    {{ 'discovery_pipeline.export_custom'|trans }}
                </button>
            </div>
        </div>
    </div>

    {# 📈 Analytics Section #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">📈 Pipeline Analytics</h2>
        </div>
        <div class="rams-module__content">
            {# Pipeline Funnel Analytics #}
            <div class="rams-mb-6">
                <h3 class="rams-text--sm rams-font--medium rams-mb-3">📊 Pipeline Funnel</h3>
                {% if funnel_analytics is defined and funnel_analytics is not empty %}
                {% set funnel_max = funnel_analytics|reduce((carry, s) => carry > s.count ? carry : s.count, 0) %}
                <div class="rams-stack rams-gap-3">
                    {% for stage in funnel_analytics %}
                    <div class="flex items-center rams-gap-3">
                        <div class="rams-text--sm rams-font--medium" style="min-width: 120px;">{{ stage.stage|capitalize }}</div>
                        <div class="flex-1">
                            <div class="w-full bg-gray-200 rounded-full h-5">
                                <div class="bg-blue-500 h-5 rounded-full text-xs text-white text-center leading-5" style="width: {{ funnel_max > 0 ? (stage.count / funnel_max * 100)|round : 0 }}%">
                                    {{ stage.count }}
                                </div>
                            </div>
                        </div>
                        <div class="rams-text--sm rams-text--right" style="min-width: 50px;">
                            <span class="rams-badge rams-badge--{% if stage.avg_score >= 70 %}success{% elseif stage.avg_score >= 50 %}warning{% else %}neutral{% endif %}">{{ stage.avg_score }}</span>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="rams-text--muted rams-text--sm rams-py-2">No pipeline funnel data available</div>
                {% endif %}
            </div>

            {# Quality Trend #}
            <div class="rams-mb-6">
                <h3 class="rams-text--sm rams-font--medium rams-mb-3">📈 Quality Trend (Last 30 Days)</h3>
                {% if quality_trend is defined and quality_trend is not empty %}
                {% set trend_max = quality_trend|reduce((carry, t) => carry > t.count ? carry : t.count, 0) %}
                <div class="rams-grid rams-grid--6 rams-gap-3">
                    {% for item in quality_trend %}
                    <div class="rams-module rams-module--compact">
                        <div class="rams-module__content rams-text--center">
                            <div class="rams-text--xs rams-text--muted rams-mb-1">{{ item.week }}</div>
                            <div class="rams-font--medium rams-text--lg">{{ item.count }}</div>
                            <div class="rams-text--xs rams-mb-1">
                                <span class="rams-badge rams-badge--{% if item.avg_score >= 70 %}success{% elseif item.avg_score >= 50 %}warning{% else %}danger{% endif %}">{{ item.avg_score }}</span>
                            </div>
                            <div class="rams-text--xs">
                                <span class="{% if item.approval_rate >= 75 %}rams-text--success{% elseif item.approval_rate >= 50 %}rams-text--warning{% else %}rams-text--danger{% endif %}">{{ item.approval_rate }}%</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-1 rams-mt-1">
                                <div class="bg-blue-500 h-1 rounded-full" style="width: {{ trend_max > 0 ? (item.count / trend_max * 100)|round : 0 }}%"></div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="rams-text--muted rams-text--sm rams-py-2">No quality trend data available</div>
                {% endif %}
            </div>

            {# Actionable Insights #}
            <div>
                <h3 class="rams-text--sm rams-font--medium rams-mb-3">💡 Actionable Insights</h3>
                {% if actionable_insights is defined and actionable_insights is not empty %}
                <div class="rams-stack rams-gap-2">
                    {% for insight in actionable_insights %}
                    <div class="rams-module rams-module--nested rams-p-3">
                        <div class="rams-flex rams-justify-between rams-items-start rams-gap-2">
                            <div class="rams-flex-1">
                                <div class="rams-flex rams-items-center rams-gap-2 rams-mb-1">
                                    <span class="rams-badge rams-badge--{% if insight.priority == 'high' %}danger{% elseif insight.priority == 'medium' %}warning{% else %}info{% endif %} rams-text--xs">{{ insight.priority|upper }}</span>
                                    <span class="rams-font--medium rams-text--sm">{{ insight.lead.companyName }}</span>
                                </div>
                                <p class="rams-text--sm rams-text--muted">{{ insight.message }}</p>
                            </div>
                            <div class="rams-flex rams-items-center rams-gap-1">
                                <span class="rams-badge rams-badge--{% if insight.score >= 70 %}success{% elseif insight.score >= 50 %}warning{% else %}neutral{% endif %}">{{ insight.score }}</span>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="rams-text--muted rams-text--sm rams-py-2">No actionable insights available</div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<style>
.rams-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex: 1;
}
.rams-step__indicator {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--rams-bg-muted, #e5e7eb);
    color: var(--rams-text-muted, #9ca3af);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.3s ease;
}
.rams-step--active .rams-step__indicator {
    background: var(--rams-primary, #3b82f6);
    color: #fff;
}
.rams-step--completed .rams-step__indicator {
    background: var(--rams-success, #10b981);
    color: #fff;
}
.rams-step__connector {
    flex: 1;
    height: 2px;
    background: var(--rams-bg-muted, #e5e7eb);
    margin-top: 13px;
    min-width: 20px;
}
.rams-step__label {
    white-space: nowrap;
}
.rams-progress--lg {
    height: 12px;
}
.rams-progress--sm {
    height: 6px;
    border-radius: 3px;
    overflow: hidden;
    background: var(--rams-bg-muted, #e5e7eb);
}
.rams-module--highlight {
    border-color: var(--rams-primary, #3b82f6);
    border-width: 2px;
}
</style>
<script>
let progressInterval = null;
let isPolling = false;

function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    const div = document.createElement('div');
    div.textContent = String(str);
    return div.innerHTML;
}

const i18n = {
    running: '{{ 'discovery_pipeline.running'|trans|e('js') }}',
    runPipeline: '{{ 'discovery_pipeline.run_pipeline_btn'|trans|e('js') }}',
    loading: '{{ 'common.loading'|trans|e('js') }}',
    previewResults: '{{ 'discovery_pipeline.preview_results'|trans|e('js') }}',
    selectSector: '{{ 'discovery_pipeline.select_sector_error'|trans|e('js') }}',
    processing: '{{ 'messages.processing'|trans|e('js') }}',
    startEnrichment: '{{ 'discovery_pipeline.start_enrichment'|trans|e('js') }}',
    searched: '{{ 'discovery_pipeline.stats.searched'|trans|e('js') }}',
    imported: '{{ 'discovery_pipeline.stats.imported'|trans|e('js') }}',
    duplicates: '{{ 'discovery_pipeline.stats.duplicates'|trans|e('js') }}',
    queuedForScrape: '{{ 'discovery_pipeline.stats.queued_for_scrape'|trans|e('js') }}',
    errorLabel: '{{ 'common.error'|trans|e('js') }}',
    statusDuplicate: '{{ 'discovery_pipeline.status.duplicate'|trans|e('js') }}',
    statusNew: '{{ 'discovery_pipeline.status.new'|trans|e('js') }}',
    foundResults: '{{ 'discovery_pipeline.found_results'|trans|e('js') }}',
    enrichedLabel: '{{ 'discovery_pipeline.enriched'|trans|e('js') }}',
    pendingLabel: '{{ 'common.pending'|trans|e('js') }}',
    leadsScrapedRecent: '{{ 'discovery_pipeline.leads_scraped_recent'|trans|e('js') }}',
    leadsUpdatedRecent: '{{ 'discovery_pipeline.leads_updated_recent'|trans|e('js') }}',
    pendingEnrichmentLabel: '{{ 'discovery_pipeline.pending_enrichment'|trans|e('js') }}',
    processingActive: '{{ 'discovery_pipeline.processing_active'|trans|e('js') }}',
    complete: '{{ 'discovery_pipeline.complete'|trans|e('js') }}',
    idleWaiting: '{{ 'discovery_pipeline.idle_waiting'|trans|e('js') }}',
    exportTitle: '{{ 'discovery_pipeline.export_custom_title'|trans|e('js') }}',
    reviewStatus: '{{ 'discovery_pipeline.review_status'|trans|e('js') }}',
    allStatuses: '{{ 'discovery_pipeline.all_statuses'|trans|e('js') }}',
    statusPending: '{{ 'discovery_pipeline.status.pending'|trans|e('js') }}',
    statusApproved: '{{ 'discovery_pipeline.status.approved'|trans|e('js') }}',
    statusRejected: '{{ 'discovery_pipeline.status.rejected'|trans|e('js') }}',
    dateFrom: '{{ 'filters.from'|trans|e('js') }}',
    dateTo: '{{ 'filters.to'|trans|e('js') }}',
    sectorFilter: '{{ 'discovery_pipeline.sector_filter'|trans|e('js') }}',
    sectorPlaceholder: '{{ 'discovery_pipeline.sector_placeholder'|trans|e('js') }}',
    region: '{{ 'discovery_pipeline.region'|trans|e('js') }}',
    allRegions: '{{ 'discovery_pipeline.all_regions'|trans|e('js') }}',
    regionNorthAmerica: '{{ 'discovery_pipeline.region_north_america'|trans|e('js') }}',
    regionEurope: '{{ 'discovery_pipeline.region_europe'|trans|e('js') }}',
    regionAsiaPacific: '{{ 'discovery_pipeline.region_asia_pacific'|trans|e('js') }}',
    dataFilters: '{{ 'discovery_pipeline.data_filters'|trans|e('js') }}',
    onlyWithEmails: '{{ 'discovery_pipeline.only_with_emails'|trans|e('js') }}',
    onlyWithContactForms: '{{ 'discovery_pipeline.only_with_contact_forms'|trans|e('js') }}',
    cancel: '{{ 'common.cancel'|trans|e('js') }}',
    exportCsv: '{{ 'discovery_pipeline.export_csv'|trans|e('js') }}'
};

function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `rams-alert ${type === 'success' ? 'rams-alert--success' : 'rams-alert--error'} rams-alert--toast`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 5000);
}

// Progress polling functions
function startProgressPolling() {
    if (isPolling) return;
    isPolling = true;
    
    document.getElementById('progress-container').classList.remove('rams-hidden');
    
    progressInterval = setInterval(async () => {
        try {
            const response = await fetch('/discovery-pipeline/progress');
            const data = await response.json();
            
            // Update progress bar
            const progressBar = document.getElementById('progress-bar');
            const progressPercent = document.getElementById('progress-percent');
            const progressStatus = document.getElementById('progress-status');
            const progressEnriched = document.getElementById('progress-enriched');
            const progressPending = document.getElementById('progress-pending');
            const recentlyScrapedText = document.getElementById('recently-scraped-text');
            const recentlyUpdatedText = document.getElementById('recently-updated-text');
            const pendingEnrichmentText = document.getElementById('pending-enrichment-text');
            const progressTimestamp = document.getElementById('progress-timestamp');
            
            progressBar.style.width = data.progress + '%';
            progressPercent.textContent = data.progress + '%';
            progressEnriched.textContent = `${data.enriched} ${i18n.enrichedLabel}`;
            progressPending.textContent = `${data.pending_enrichment} ${i18n.pendingLabel}`;
            recentlyScrapedText.textContent = i18n.leadsScrapedRecent.replace('%count%', data.recently_scraped);
            recentlyUpdatedText.textContent = i18n.leadsUpdatedRecent.replace('%count%', data.recently_updated);
            pendingEnrichmentText.textContent = i18n.pendingEnrichmentLabel.replace('%count%', data.pending_enrichment);
            progressTimestamp.textContent = data.timestamp;
            
            // Update step indicators
            const steps = document.querySelectorAll('#progress-steps .rams-step');
            steps.forEach(step => {
                step.classList.remove('rams-step--active', 'rams-step--completed');
            });
            
            if (data.progress < 25) {
                steps[0].classList.add('rams-step--active');
            } else if (data.progress < 50) {
                steps[0].classList.add('rams-step--completed');
                steps[1].classList.add('rams-step--active');
            } else if (data.progress < 75) {
                steps[0].classList.add('rams-step--completed');
                steps[1].classList.add('rams-step--completed');
                steps[2].classList.add('rams-step--active');
            } else if (data.progress < 100) {
                steps[0].classList.add('rams-step--completed');
                steps[1].classList.add('rams-step--completed');
                steps[2].classList.add('rams-step--completed');
                steps[3].classList.add('rams-step--active');
            } else {
                steps.forEach(s => s.classList.add('rams-step--completed'));
            }
            
            // Update status text
            if (data.recently_scraped > 0) {
                progressStatus.textContent = i18n.processingActive.replace('%count%', data.recently_scraped);
                progressStatus.className = 'rams-text--sm rams-text--success';
            } else if (data.pending_enrichment === 0) {
                progressStatus.textContent = i18n.complete;
                progressStatus.className = 'rams-text--sm rams-text--success';
                stopProgressPolling();
            } else {
                progressStatus.textContent = i18n.idleWaiting;
                progressStatus.className = 'rams-text--sm rams-text--muted';
            }
            
        } catch (e) {
            console.error('Progress poll failed:', e);
        }
    }, 3000);
    
    // Poll immediately
    fetch('/discovery-pipeline/progress')
        .then(r => r.json())
        .then(data => {
            document.getElementById('progress-bar').style.width = data.progress + '%';
            document.getElementById('progress-percent').textContent = data.progress + '%';
        });
}

function stopProgressPolling() {
    if (progressInterval) {
        clearInterval(progressInterval);
        progressInterval = null;
    }
    isPolling = false;
}

// Pipeline Form
document.getElementById('pipeline-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('run-btn');
    btn.disabled = true;
    btn.textContent = i18n.running;
    
    const data = {
        sector: form.sector.value,
        location: form.location.value || null,
        auto_import: form.auto_import.checked,
        enable_deep_scrape: form.enable_deep_scrape.checked,
        enable_llm: form.enable_llm.checked
    };
    
    try {
        const response = await fetch('/discovery-pipeline/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        const resultsDiv = document.getElementById('pipeline-results');
        const contentDiv = document.getElementById('results-content');
        resultsDiv.classList.remove('rams-hidden');
        
        if (result.success) {
            contentDiv.innerHTML = `
                <div class="rams-text--success rams-mb-2" style="font-weight: 500;">✓ ${escapeHtml(result.message)}</div>
                <div class="rams-grid rams-grid--2 rams-gap-2 rams-text--muted">
                    <div>${i18n.searched}: ${result.stats.searched}</div>
                    <div>${i18n.imported}: ${result.stats.imported}</div>
                    <div>${i18n.duplicates}: ${result.stats.duplicates}</div>
                    <div>${i18n.queuedForScrape}: ${result.stats.queued_for_scrape}</div>
                </div>
                ${result.stats.leads && result.stats.leads.length > 0 ? `
                    <div class="rams-mt-3">
                        <p class="rams-dymo rams-mb-2">${i18n.imported} ${'discovery_pipeline.leads'|trans}:</p>
                        <div class="rams-stack rams-gap-1" style="max-height: 150px; overflow-y: auto;">
                            ${result.stats.leads.slice(0, 10).map(l => `<div class="rams-text--xs"><a href="/leads/review?id=${escapeHtml(String(l.id))}" class="rams-link">${escapeHtml(l.name)}</a></div>`).join('')}
                            ${result.stats.leads.length > 10 ? `<div class="rams-text--xs rams-text--muted">...${result.stats.leads.length - 10} more</div>` : ''}
                        </div>
                    </div>
                ` : ''}
            `;
            showToast(result.message);
            
            if (result.stats.queued_for_scrape > 0) {
                startProgressPolling();
            }
        } else {
            contentDiv.innerHTML = `<div class="rams-text--danger">${i18n.errorLabel}: ${result.error}</div>`;
            showToast(`${i18n.errorLabel}: ${result.error}`, 'error');
        }
    } catch (e) {
        showToast(`${i18n.errorLabel}: ${e.message}`, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = i18n.runPipeline;
    }
});

// Preview Button
document.getElementById('preview-btn').addEventListener('click', async () => {
    const form = document.getElementById('pipeline-form');
    const btn = document.getElementById('preview-btn');
    btn.disabled = true;
    btn.textContent = i18n.loading;
    
    const data = {
        sector: form.sector.value,
        location: form.location.value || null
    };
    
    if (!data.sector) {
        showToast(i18n.selectSector, 'error');
        btn.disabled = false;
        btn.textContent = i18n.previewResults;
        return;
    }
    
    try {
        const response = await fetch('/discovery-pipeline/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        if (result.success) {
            const container = document.getElementById('preview-table-container');
            const tbody = document.getElementById('preview-table-body');
            const summary = document.getElementById('preview-summary');
            
            summary.textContent = i18n.foundResults
                .replace('%total%', result.total)
                .replace('%new%', result.new_leads)
                .replace('%duplicates%', result.duplicates);
            
            tbody.innerHTML = result.results.map(r => `
                <tr class="${r.is_duplicate ? 'rams-table__row--muted' : ''}">
                    <td class="rams-table__cell">${escapeHtml(r.name)}</td>
                    <td class="rams-table__cell">
                        ${r.website ? `<a href="${escapeHtml(r.website)}" target="_blank" class="rams-link">${escapeHtml(r.website)}</a>` : '—'}
                    </td>
                    <td class="rams-table__cell rams-text--muted">${escapeHtml(r.snippet || '—')}</td>
                    <td class="rams-table__cell rams-text--center">
                        ${r.is_duplicate 
                            ? `<span class="rams-badge rams-badge--muted">${i18n.statusDuplicate}</span>`
                            : `<span class="rams-badge rams-badge--green">${i18n.statusNew}</span>`}
                    </td>
                </tr>
            `).join('');
            
            container.classList.remove('rams-hidden');
            showToast(summary.textContent);
        } else {
            showToast(result.error, 'error');
        }
    } catch (e) {
        showToast(`${i18n.errorLabel}: ${e.message}`, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = i18n.previewResults;
    }
});

// Enrich Form
document.getElementById('enrich-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = i18n.processing;
    
    const data = {
        limit: parseInt(form.limit.value),
        enable_llm: form.enable_llm.checked
    };
    
    try {
        const response = await fetch('/discovery-pipeline/enrich-existing', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        const resultsDiv = document.getElementById('enrich-results');
        resultsDiv.classList.remove('rams-hidden');
        resultsDiv.querySelector('div').textContent = result.success 
            ? `✓ ${result.message}` 
            : `${i18n.errorLabel}: ${result.error}`;
        
        if (result.success) {
            showToast(result.message);
            startProgressPolling();
        } else {
            showToast(`${i18n.errorLabel}: ${result.error}`, 'error');
        }
    } catch (e) {
        showToast(`${i18n.errorLabel}: ${e.message}`, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = i18n.startEnrichment;
    }
});

// Custom Export Modal
