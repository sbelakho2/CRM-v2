{% extends 'base.html.twig' %}

{% block title %}Discovery Pipeline{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-8">
    <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
            <!-- Header -->
            <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">🔍 Automated Lead Discovery Pipeline</h1>
                    <p class="text-gray-600 mt-2">Run intelligent searches, auto-import leads, and enrich with contact data</p>
                </div>
                
                <!-- Export Dropdown -->
                <div class="relative inline-block" x-data="{ open: false }">
                    <button @click="open = !open" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Export CSV
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    <div x-show="open" @click.away="open = false" 
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         class="absolute right-0 mt-2 w-64 bg-white rounded-lg shadow-lg border z-50">
                        <div class="py-2">
                            <p class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase">Export Options</p>
                            <a href="{{ path('export_leads') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                📋 All Leads (Full Export)
                            </a>
                            <a href="{{ path('export_leads', {hasEmails: 1}) }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                📧 Leads with Emails Only
                            </a>
                            <a href="{{ path('export_leads', {hasContactForm: 1}) }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                📝 Leads with Contact Forms
                            </a>
                            <a href="{{ path('export_leads', {status: 'approved'}) }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                ✅ Approved Leads Only
                            </a>
                            <div class="border-t my-2"></div>
                            <a href="#" onclick="exportCustomLeads(); return false;" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                ⚙️ Custom Export (Filters)...
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-2 md:grid-cols-6 gap-4 mb-8">
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="text-xs text-gray-500 uppercase">Total Leads</div>
                    <div class="text-2xl font-bold text-blue-600">{{ stats.total_leads }}</div>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="text-xs text-gray-500 uppercase">Today</div>
                    <div class="text-2xl font-bold text-green-600">{{ stats.today_leads }}</div>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="text-xs text-gray-500 uppercase">With Emails</div>
                    <div class="text-2xl font-bold text-purple-600">{{ stats.with_emails }}</div>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="text-xs text-gray-500 uppercase">Has Contact Form</div>
                    <div class="text-2xl font-bold text-indigo-600">{{ stats.with_contact_forms|default(0) }}</div>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="text-xs text-gray-500 uppercase">Enrichment Rate</div>
                    <div class="text-2xl font-bold text-orange-600">{{ stats.enrichment_rate }}%</div>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="text-xs text-gray-500 uppercase">Pending Review</div>
                    <div class="text-2xl font-bold text-red-600">{{ stats.pending_review }}</div>
                </div>
            </div>
            
            <!-- Real-time Progress Bar -->
            <div id="progress-container" class="hidden mb-8">
                <div class="bg-white rounded-lg shadow p-6">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="font-semibold text-gray-700">🔄 Enrichment Progress</h3>
                        <span id="progress-status" class="text-sm text-gray-500">Processing...</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-4 mb-2">
                        <div id="progress-bar" class="bg-gradient-to-r from-blue-500 to-purple-500 h-4 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-gray-500">
                        <span id="progress-enriched">0 enriched</span>
                        <span id="progress-percent">0%</span>
                        <span id="progress-pending">0 pending</span>
                    </div>
                    <div id="progress-details" class="mt-3 text-sm text-gray-600 space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                            <span id="recently-scraped-text">0 leads scraped in last 5 min</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Pipeline Runner -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-semibold mb-4">🚀 Run Discovery Pipeline</h2>
                    
                    <form id="pipeline-form" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Target Sector *</label>
                            <select name="sector" required class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500">
                                <option value="">Select a sector...</option>
                                {% for sector in sectors %}
                                    <option value="{{ sector }}">{{ sector }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Geographic Focus</label>
                            <select name="location" class="w-full border rounded-lg px-3 py-2">
                                <option value="">All Locations</option>
                                {% for key, label in locations %}
                                    <option value="{{ key }}">{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <div class="space-y-2">
                            <label class="flex items-center gap-2">
                                <input type="checkbox" name="auto_import" checked class="rounded">
                                <span class="text-sm">Auto-import new leads</span>
                            </label>
                            <label class="flex items-center gap-2">
                                <input type="checkbox" name="enable_deep_scrape" checked class="rounded">
                                <span class="text-sm">Enable deep scraping (extract emails/phones)</span>
                            </label>
                            <label class="flex items-center gap-2">
                                <input type="checkbox" name="enable_llm" class="rounded">
                                <span class="text-sm">Use LLM enrichment (requires API key)</span>
                            </label>
                        </div>
                        
                        <div class="flex gap-3">
                            <button type="button" id="preview-btn" class="flex-1 px-4 py-2 border border-blue-600 text-blue-600 rounded-lg hover:bg-blue-50">
                                Preview Results
                            </button>
                            <button type="submit" id="run-btn" class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                                Run Pipeline
                            </button>
                        </div>
                    </form>
                    
                    <!-- Results -->
                    <div id="pipeline-results" class="mt-6 hidden">
                        <h3 class="font-medium text-gray-700 mb-2">Results</h3>
                        <div id="results-content" class="bg-gray-50 rounded-lg p-4 text-sm"></div>
                    </div>
                </div>

                <!-- Enrich Existing Leads -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-semibold mb-4">✨ Enrich Existing Leads</h2>
                    <p class="text-gray-600 mb-4">
                        Queue leads that have websites but no contact information for deep scraping.
                    </p>
                    
                    <form id="enrich-form" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Number of Leads</label>
                            <input type="number" name="limit" value="50" min="1" max="100" 
                                   class="w-full border rounded-lg px-3 py-2">
                            <p class="text-xs text-gray-500 mt-1">Max 100 per batch</p>
                        </div>
                        
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="enable_llm" class="rounded">
                            <span class="text-sm">Use LLM enrichment</span>
                        </label>
                        
                        <button type="submit" class="w-full px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
                            Start Enrichment
                        </button>
                    </form>
                    
                    <div id="enrich-results" class="mt-6 hidden">
                        <div class="bg-green-50 text-green-800 rounded-lg p-4 text-sm"></div>
                    </div>
                </div>
            </div>

            <!-- Preview Results Table -->
            <div id="preview-table-container" class="mt-8 hidden">
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="px-6 py-4 border-b">
                        <h3 class="text-lg font-semibold">Search Preview</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Company</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Website</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
                                </tr>
                            </thead>
                            <tbody id="preview-table-body" class="bg-white divide-y divide-gray-200">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
let progressInterval = null;
let isPolling = false;

function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `fixed top-4 right-4 px-4 py-2 rounded shadow-lg z-50 ${type === 'success' ? 'bg-green-500' : 'bg-red-500'} text-white`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 5000);
}

// Progress polling functions
function startProgressPolling() {
    if (isPolling) return;
    isPolling = true;
    
    document.getElementById('progress-container').classList.remove('hidden');
    
    // Poll every 3 seconds
    progressInterval = setInterval(async () => {
        try {
            const response = await fetch('/discovery-pipeline/progress');
            const data = await response.json();
            
            // Update progress bar
            const progressBar = document.getElementById('progress-bar');
            const progressPercent = document.getElementById('progress-percent');
            const progressStatus = document.getElementById('progress-status');
            const progressEnriched = document.getElementById('progress-enriched');
            const progressPending = document.getElementById('progress-pending');
            const recentlyScrapedText = document.getElementById('recently-scraped-text');
            
            progressBar.style.width = data.progress + '%';
            progressPercent.textContent = data.progress + '%';
            progressEnriched.textContent = data.enriched + ' enriched';
            progressPending.textContent = data.pending_enrichment + ' pending';
            recentlyScrapedText.textContent = data.recently_scraped + ' leads scraped in last 5 min';
            
            // Update status text
            if (data.recently_scraped > 0) {
                progressStatus.textContent = `Processing (${data.recently_scraped} active)...`;
                progressStatus.className = 'text-sm text-green-600 font-medium';
            } else if (data.pending_enrichment === 0) {
                progressStatus.textContent = 'Complete ✓';
                progressStatus.className = 'text-sm text-green-600 font-medium';
                stopProgressPolling();
            } else {
                progressStatus.textContent = 'Idle - Waiting for queue';
                progressStatus.className = 'text-sm text-gray-500';
            }
            
        } catch (e) {
            console.error('Progress poll failed:', e);
        }
    }, 3000);
    
    // Also poll immediately
    fetch('/discovery-pipeline/progress')
        .then(r => r.json())
        .then(data => {
            document.getElementById('progress-bar').style.width = data.progress + '%';
            document.getElementById('progress-percent').textContent = data.progress + '%';
        });
}

function stopProgressPolling() {
    if (progressInterval) {
        clearInterval(progressInterval);
        progressInterval = null;
    }
    isPolling = false;
}

// Pipeline Form
document.getElementById('pipeline-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('run-btn');
    btn.disabled = true;
    btn.textContent = 'Running...';
    
    const data = {
        sector: form.sector.value,
        location: form.location.value || null,
        auto_import: form.auto_import.checked,
        enable_deep_scrape: form.enable_deep_scrape.checked,
        enable_llm: form.enable_llm.checked
    };
    
    try {
        const response = await fetch('/discovery-pipeline/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        const resultsDiv = document.getElementById('pipeline-results');
        const contentDiv = document.getElementById('results-content');
        resultsDiv.classList.remove('hidden');
        
        if (result.success) {
            contentDiv.innerHTML = `
                <div class="text-green-600 font-medium mb-2">✓ ${result.message}</div>
                <div class="grid grid-cols-2 gap-2 text-gray-600">
                    <div>Searched: ${result.stats.searched}</div>
                    <div>Imported: ${result.stats.imported}</div>
                    <div>Duplicates: ${result.stats.duplicates}</div>
                    <div>Queued for scrape: ${result.stats.queued_for_scrape}</div>
                </div>
            `;
            showToast(result.message);
            
            // Start progress polling if leads were queued for scraping
            if (result.stats.queued_for_scrape > 0) {
                startProgressPolling();
            }
        } else {
            contentDiv.innerHTML = `<div class="text-red-600">Error: ${result.error}</div>`;
            showToast(result.error, 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = 'Run Pipeline';
    }
});

// Preview Button
document.getElementById('preview-btn').addEventListener('click', async () => {
    const form = document.getElementById('pipeline-form');
    const btn = document.getElementById('preview-btn');
    btn.disabled = true;
    btn.textContent = 'Loading...';
    
    const data = {
        sector: form.sector.value,
        location: form.location.value || null
    };
    
    if (!data.sector) {
        showToast('Please select a sector', 'error');
        btn.disabled = false;
        btn.textContent = 'Preview Results';
        return;
    }
    
    try {
        const response = await fetch('/discovery-pipeline/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        if (result.success) {
            const container = document.getElementById('preview-table-container');
            const tbody = document.getElementById('preview-table-body');
            
            tbody.innerHTML = result.results.map(r => `
                <tr class="${r.is_duplicate ? 'bg-gray-100' : ''}">
                    <td class="px-4 py-3 text-sm">${r.name}</td>
                    <td class="px-4 py-3 text-sm">
                        ${r.website ? `<a href="${r.website}" target="_blank" class="text-blue-600 hover:underline">${r.website}</a>` : '—'}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-600 max-w-md truncate">${r.snippet || '—'}</td>
                    <td class="px-4 py-3 text-center">
                        ${r.is_duplicate 
                            ? '<span class="px-2 py-1 text-xs bg-gray-200 rounded">Duplicate</span>'
                            : '<span class="px-2 py-1 text-xs bg-green-100 text-green-800 rounded">New</span>'}
                    </td>
                </tr>
            `).join('');
            
            container.classList.remove('hidden');
            showToast(`Found ${result.total} results (${result.new_leads} new, ${result.duplicates} duplicates)`);
        } else {
            showToast(result.error, 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = 'Preview Results';
    }
});

// Enrich Form
document.getElementById('enrich-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = 'Processing...';
    
    const data = {
        limit: parseInt(form.limit.value),
        enable_llm: form.enable_llm.checked
    };
    
    try {
        const response = await fetch('/discovery-pipeline/enrich-existing', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        const resultsDiv = document.getElementById('enrich-results');
        resultsDiv.classList.remove('hidden');
        resultsDiv.querySelector('div').textContent = result.success 
            ? `✓ ${result.message}` 
            : `Error: ${result.error}`;
        
        if (result.success) {
            showToast(result.message);
            // Start progress polling when enrichment begins
            startProgressPolling();
        } else {
            showToast(result.error, 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = 'Start Enrichment';
    }
});

// Custom Export Modal
function exportCustomLeads() {
    // Create modal
    const modal = document.createElement('div');
    modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
    modal.id = 'export-modal';
    
    modal.innerHTML = `
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4">
            <div class="px-6 py-4 border-b">
                <h3 class="text-lg font-semibold">Custom Export Options</h3>
            </div>
            <form id="custom-export-form" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Review Status</label>
                    <select name="status" class="w-full border rounded-lg px-3 py-2">
                        <option value="">All statuses</option>
                        <option value="pending">Pending</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Date From</label>
                        <input type="date" name="dateFrom" class="w-full border rounded-lg px-3 py-2">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Date To</label>
                        <input type="date" name="dateTo" class="w-full border rounded-lg px-3 py-2">
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Sector Filter</label>
                    <input type="text" name="sector" placeholder="e.g., Aerospace" class="w-full border rounded-lg px-3 py-2">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Region</label>
                    <select name="region" class="w-full border rounded-lg px-3 py-2">
                        <option value="">All regions</option>
                        <option value="north_america">North America</option>
                        <option value="europe">Europe</option>
                        <option value="asia_pacific">Asia Pacific</option>
                    </select>
                </div>
                
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Data Filters</label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="hasEmails" class="rounded">
                        <span class="text-sm">Only leads with email addresses</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="hasContactForm" class="rounded">
                        <span class="text-sm">Only leads with contact forms</span>
                    </label>
                </div>
                
                <div class="flex gap-3 pt-4">
                    <button type="button" onclick="closeExportModal()" class="flex-1 px-4 py-2 border rounded-lg hover:bg-gray-50">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                        Export CSV
                    </button>
                </div>
            </form>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    // Handle form submission
    document.getElementById('custom-export-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const form = e.target;
        const params = new URLSearchParams();
        
        if (form.status.value) params.append('status', form.status.value);
        if (form.dateFrom.value) params.append('dateFrom', form.dateFrom.value);
        if (form.dateTo.value) params.append('dateTo', form.dateTo.value);
        if (form.sector.value) params.append('sector', form.sector.value);
        if (form.region.value) params.append('region', form.region.value);
        if (form.hasEmails.checked) params.append('hasEmails', '1');
        if (form.hasContactForm.checked) params.append('hasContactForm', '1');
        
        // Trigger download
        window.location.href = '{{ path("export_leads") }}?' + params.toString();
        
        closeExportModal();
    });
}

function closeExportModal() {
    const modal = document.getElementById('export-modal');
    if (modal) modal.remove();
}
</script>
{% endblock %}
