                        <option value="">${i18n.allRegions}</option>
                        <option value="north_america">${i18n.regionNorthAmerica}</option>
                        <option value="europe">${i18n.regionEurope}</option>
                        <option value="asia_pacific">${i18n.regionAsiaPacific}</option>
                    </select>
                </div>
                
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">${i18n.dataFilters}</label>
                    <div class="rams-stack rams-gap-2">
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="hasEmails" class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label">${i18n.onlyWithEmails}</span>
                        </label>
                        <label class="rams-form__checkbox-container">
                            <input type="checkbox" name="hasContactForm" class="rams-form__checkbox-input">
                            <span class="rams-form__checkbox-label">${i18n.onlyWithContactForms}</span>
                        </label>
                    </div>
                </div>
                
                <div class="rams-modal__footer">
                    <button type="button" onclick="closeExportModal()" class="rams-btn">
                        ${i18n.cancel}
                    </button>
                    <button type="submit" class="rams-btn rams-btn--primary">
                        ${i18n.exportCsv}
                    </button>
                </div>
            </form>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    document.getElementById('custom-export-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const form = e.target;
        const params = new URLSearchParams();
        
        if (form.status.value) params.append('status', form.status.value);
        if (form.dateFrom.value) params.append('dateFrom', form.dateFrom.value);
        if (form.dateTo.value) params.append('dateTo', form.dateTo.value);
        if (form.sector.value) params.append('sector', form.sector.value);
        if (form.region.value) params.append('region', form.region.value);
        if (form.hasEmails.checked) params.append('hasEmails', '1');
        if (form.hasContactForm.checked) params.append('hasContactForm', '1');
        
        window.location.href = '{{ path("export_leads") }}?' + params.toString();
        
        closeExportModal();
    });
}

function closeExportModal() {
    const modal = document.getElementById('export-modal');
    if (modal) modal.remove();
}
</script>
{% endblock %}
