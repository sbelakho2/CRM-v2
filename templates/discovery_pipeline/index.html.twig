    const modal = document.createElement('div');
    modal.className = 'rams-modal-overlay';
    modal.id = 'export-modal';
    
    modal.innerHTML = `
        <div class="rams-modal">
            <div class="rams-modal__header">
                <h3 class="rams-modal__title">${i18n.exportTitle}</h3>
            </div>
            <form id="custom-export-form" class="rams-modal__body rams-stack rams-gap-4">
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">${i18n.reviewStatus}</label>
                    <select name="status" class="rams-form__select">
                        <option value="">${i18n.allStatuses}</option>
                        <option value="pending">${i18n.statusPending}</option>
