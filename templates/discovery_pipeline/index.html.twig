{% extends 'base.html.twig' %}

{% block title %}{{ 'discovery_pipeline.title'|trans|default('Discovery Pipeline') }}{% endblock %}

{% block body %}
<div class="rams-stack">
    {# Header Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <div>
                <h1 class="rams-module__title">🔍 {{ 'discovery_pipeline.title'|trans|default('Automated Lead Discovery Pipeline') }}</h1>
                <p class="rams-dymo">{{ 'discovery_pipeline.subtitle'|trans|default('Run intelligent searches, auto-import leads, and enrich with contact data') }}</p>
            </div>
            
            {# Export Dropdown #}
            <div class="rams-dropdown-container" id="export-dropdown">
                <button type="button" onclick="toggleExportDropdown()" class="rams-btn rams-btn--primary" aria-expanded="false" aria-haspopup="true">
                    <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    {{ 'common.export'|trans }} CSV
                    <svg class="rams-btn__icon--end" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div class="rams-dropdown rams-hidden" id="export-dropdown-menu">
                    <div class="rams-dropdown__content">
                        <p class="rams-dropdown__header">{{ 'discovery_pipeline.export_options'|trans|default('Export Options') }}</p>
                        <a href="{{ path('export_leads') }}" class="rams-dropdown__item">
                            📋 {{ 'discovery_pipeline.export_all'|trans|default('All Leads (Full Export)') }}
                        </a>
                        <a href="{{ path('export_leads', {hasEmails: 1}) }}" class="rams-dropdown__item">
                            📧 {{ 'discovery_pipeline.export_with_emails'|trans|default('Leads with Emails Only') }}
                        </a>
                        <a href="{{ path('export_leads', {hasContactForm: 1}) }}" class="rams-dropdown__item">
                            📝 {{ 'discovery_pipeline.export_with_forms'|trans|default('Leads with Contact Forms') }}
                        </a>
                        <a href="{{ path('export_leads', {status: 'approved'}) }}" class="rams-dropdown__item">
                            ✅ {{ 'discovery_pipeline.export_approved'|trans|default('Approved Leads Only') }}
                        </a>
                        <div class="rams-dropdown__divider"></div>
                        <a href="#" onclick="exportCustomLeads(); return false;" class="rams-dropdown__item">
                            ⚙️ {{ 'discovery_pipeline.export_custom'|trans|default('Custom Export (Filters)...') }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Stats Cards #}
    <div class="rams-grid rams-grid--6">
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'discovery_pipeline.total_leads'|trans|default('Total Leads') }}</span>
                <div class="rams-metric__value rams-text-info">{{ stats.total_leads }}</div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'discovery_pipeline.today'|trans|default('Today') }}</span>
                <div class="rams-metric__value rams-text-success">{{ stats.today_leads }}</div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'discovery_pipeline.with_emails'|trans|default('With Emails') }}</span>
                <div class="rams-metric__value">{{ stats.with_emails }}</div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'discovery_pipeline.has_contact_form'|trans|default('Has Contact Form') }}</span>
                <div class="rams-metric__value">{{ stats.with_contact_forms|default(0) }}</div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'discovery_pipeline.enrichment_rate'|trans|default('Enrichment Rate') }}</span>
                <div class="rams-metric__value rams-text-warning">{{ stats.enrichment_rate }}%</div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'discovery_pipeline.pending_review'|trans|default('Pending Review') }}</span>
                <div class="rams-metric__value rams-text-danger">{{ stats.pending_review }}</div>
            </div>
        </div>
    </div>
    
    {# Real-time Progress Bar #}
    <div id="progress-container" class="rams-hidden">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-module__header">
                    <h3 class="rams-module__title">🔄 {{ 'discovery_pipeline.enrichment_progress'|trans|default('Enrichment Progress') }}</h3>
                    <span id="progress-status" class="rams-dymo">{{ 'messages.processing'|trans }}...</span>
                </div>
                <div class="rams-progress">
                    <div id="progress-bar" class="rams-progress__bar" style="width: 0%"></div>
                </div>
                <div class="rams-metric">
                    <span id="progress-enriched" class="rams-dymo">0 {{ 'discovery_pipeline.enriched'|trans|default('enriched') }}</span>
                    <span id="progress-percent" class="rams-metric__value">0%</span>
                    <span id="progress-pending" class="rams-dymo">0 {{ 'common.pending'|trans }}</span>
                </div>
                <div id="progress-details" class="rams-stack">
                    <div class="rams-andon rams-andon--success">
                        <span class="rams-andon__light"></span>
                        <span id="recently-scraped-text" class="rams-dymo">0 {{ 'discovery_pipeline.leads_scraped'|trans|default('leads scraped in last 5 min') }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--2">
        {# Pipeline Runner Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">🚀 {{ 'discovery_pipeline.run_pipeline'|trans|default('Run Discovery Pipeline') }}</h2>
            </div>
            <div class="rams-module__content">
                <form id="pipeline-form" class="rams-form">
                    <div class="rams-form-group">
                        <label class="rams-label">{{ 'discovery_pipeline.target_sector'|trans|default('Target Sector') }} *</label>
                        <select name="sector" required class="rams-select">
                            <option value="">{{ 'discovery_pipeline.select_sector'|trans|default('Select a sector...') }}</option>
                            {% for sector in sectors %}
                                <option value="{{ sector }}">{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <div class="rams-form-group">
                        <label class="rams-label">{{ 'discovery_pipeline.geographic_focus'|trans|default('Geographic Focus') }}</label>
                        <select name="location" class="rams-select">
                            <option value="">{{ 'discovery_pipeline.all_locations'|trans|default('All Locations') }}</option>
                            {% for key, label in locations %}
                                <option value="{{ key }}">{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <div class="rams-stack">
                        <label class="rams-checkbox">
                            <input type="checkbox" name="auto_import" checked class="rams-checkbox__input">
                            <span class="rams-checkbox__label">{{ 'discovery_pipeline.auto_import'|trans|default('Auto-import new leads') }}</span>
                        </label>
                        <label class="rams-checkbox">
                            <input type="checkbox" name="enable_deep_scrape" checked class="rams-checkbox__input">
                            <span class="rams-checkbox__label">{{ 'discovery_pipeline.enable_deep_scrape'|trans|default('Enable deep scraping (extract emails/phones)') }}</span>
                        </label>
                        <label class="rams-checkbox">
                            <input type="checkbox" name="enable_llm" class="rams-checkbox__input">
                            <span class="rams-checkbox__label">{{ 'discovery_pipeline.use_llm'|trans|default('Use LLM enrichment (requires API key)') }}</span>
                        </label>
                    </div>
                    
                    <div class="rams-btn-group">
                        <button type="button" id="preview-btn" class="rams-btn rams-btn--secondary">
                            {{ 'discovery_pipeline.preview_results'|trans|default('Preview Results') }}
                        </button>
                        <button type="submit" id="run-btn" class="rams-btn rams-btn--primary">
                            {{ 'discovery_pipeline.run_pipeline_btn'|trans|default('Run Pipeline') }}
                        </button>
                    </div>
                </form>
                
                {# Results #}
                <div id="pipeline-results" class="rams-hidden">
                    <h3 class="rams-dymo">{{ 'discovery_pipeline.results'|trans|default('Results') }}</h3>
                    <div id="results-content" class="rams-module rams-module--muted"></div>
                </div>
            </div>
        </div>

        {# Enrich Existing Leads Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">✨ {{ 'discovery_pipeline.enrich_existing'|trans|default('Enrich Existing Leads') }}</h2>
            </div>
            <div class="rams-module__content">
                <p class="rams-text-muted">
                    {{ 'discovery_pipeline.enrich_description'|trans|default('Queue leads that have websites but no contact information for deep scraping.') }}
                </p>
                
                <form id="enrich-form" class="rams-form">
                    <div class="rams-form-group">
                        <label class="rams-label">{{ 'discovery_pipeline.number_of_leads'|trans|default('Number of Leads') }}</label>
                        <input type="number" name="limit" value="50" min="1" max="100" class="rams-input">
                        <p class="rams-text-muted">{{ 'discovery_pipeline.max_per_batch'|trans|default('Max 100 per batch') }}</p>
                    </div>
                    
                    <label class="rams-checkbox">
                        <input type="checkbox" name="enable_llm" class="rams-checkbox__input">
                        <span class="rams-checkbox__label">{{ 'discovery_pipeline.use_llm'|trans|default('Use LLM enrichment') }}</span>
                    </label>
                    
                    <button type="submit" class="rams-btn rams-btn--primary">
                        {{ 'discovery_pipeline.start_enrichment'|trans|default('Start Enrichment') }}
                    </button>
                </form>
                
                <div id="enrich-results" class="rams-hidden">
                    <div class="rams-alert rams-alert--success"></div>
                </div>
            </div>
        </div>
    </div>

    {# Preview Results Table #}
    <div id="preview-table-container" class="rams-mt-8 rams-hidden">
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="rams-module__title">{{ 'discovery_pipeline.search_preview'|trans|default('Search Preview') }}</h3>
            </div>
            <div class="rams-module__content rams-overflow-x-auto">
                <table class="rams-table rams-w-full">
                    <thead class="rams-table__header">
                        <tr>
                            <th class="rams-table__cell">{{ 'company.title_singular'|trans|default('Company') }}</th>
                            <th class="rams-table__cell">{{ 'company.website'|trans|default('Website') }}</th>
                            <th class="rams-table__cell">{{ 'common.description'|trans }}</th>
                            <th class="rams-table__cell rams-text-center">{{ 'common.status'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody id="preview-table-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
let progressInterval = null;
let isPolling = false;

// Export Dropdown Toggle (vanilla JS replacement for Alpine.js)
function toggleExportDropdown() {
    const menu = document.getElementById('export-dropdown-menu');
    const btn = document.querySelector('#export-dropdown button');
    const isOpen = !menu.classList.contains('rams-hidden');
    
    if (isOpen) {
        closeExportDropdown();
    } else {
        menu.classList.remove('rams-hidden');
        btn.setAttribute('aria-expanded', 'true');
        // Close when clicking outside
        document.addEventListener('click', handleExportDropdownOutsideClick);
    }
}

function closeExportDropdown() {
    const menu = document.getElementById('export-dropdown-menu');
    const btn = document.querySelector('#export-dropdown button');
    menu.classList.add('rams-hidden');
    btn.setAttribute('aria-expanded', 'false');
    document.removeEventListener('click', handleExportDropdownOutsideClick);
}

function handleExportDropdownOutsideClick(e) {
    const dropdown = document.getElementById('export-dropdown');
    if (!dropdown.contains(e.target)) {
        closeExportDropdown();
    }
}

function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `rams-alert ${type === 'success' ? 'rams-alert--success' : 'rams-alert--error'} rams-alert--toast`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 5000);
}

// Progress polling functions
function startProgressPolling() {
    if (isPolling) return;
    isPolling = true;
    
    document.getElementById('progress-container').classList.remove('rams-hidden');
    
    // Poll every 3 seconds
    progressInterval = setInterval(async () => {
        try {
            const response = await fetch('/discovery-pipeline/progress');
            const data = await response.json();
            
            // Update progress bar
            const progressBar = document.getElementById('progress-bar');
            const progressPercent = document.getElementById('progress-percent');
            const progressStatus = document.getElementById('progress-status');
            const progressEnriched = document.getElementById('progress-enriched');
            const progressPending = document.getElementById('progress-pending');
            const recentlyScrapedText = document.getElementById('recently-scraped-text');
            
            progressBar.style.width = data.progress + '%';
            progressPercent.textContent = data.progress + '%';
            progressEnriched.textContent = data.enriched + ' enriched';
            progressPending.textContent = data.pending_enrichment + ' pending';
            recentlyScrapedText.textContent = data.recently_scraped + ' leads scraped in last 5 min';
            
            // Update status text
            if (data.recently_scraped > 0) {
                progressStatus.textContent = `Processing (${data.recently_scraped} active)...`;
                progressStatus.className = 'rams-text--sm rams-text--success';
            } else if (data.pending_enrichment === 0) {
                progressStatus.textContent = 'Complete ✓';
                progressStatus.className = 'rams-text--sm rams-text--success';
                stopProgressPolling();
            } else {
                progressStatus.textContent = 'Idle - Waiting for queue';
                progressStatus.className = 'rams-text--sm rams-text--muted';
            }
            
        } catch (e) {
            console.error('Progress poll failed:', e);
        }
    }, 3000);
    
    // Also poll immediately
    fetch('/discovery-pipeline/progress')
        .then(r => r.json())
        .then(data => {
            document.getElementById('progress-bar').style.width = data.progress + '%';
            document.getElementById('progress-percent').textContent = data.progress + '%';
        });
}

function stopProgressPolling() {
    if (progressInterval) {
        clearInterval(progressInterval);
        progressInterval = null;
    }
    isPolling = false;
}

// Pipeline Form
document.getElementById('pipeline-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('run-btn');
    btn.disabled = true;
    btn.textContent = 'Running...';
    
    const data = {
        sector: form.sector.value,
        location: form.location.value || null,
        auto_import: form.auto_import.checked,
        enable_deep_scrape: form.enable_deep_scrape.checked,
        enable_llm: form.enable_llm.checked
    };
    
    try {
        const response = await fetch('/discovery-pipeline/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        const resultsDiv = document.getElementById('pipeline-results');
        const contentDiv = document.getElementById('results-content');
        resultsDiv.classList.remove('rams-hidden');
        
        if (result.success) {
            contentDiv.innerHTML = `
                <div class="rams-text--success rams-mb-2" style="font-weight: 500;">✓ ${result.message}</div>
                <div class="rams-grid rams-grid--2 rams-gap-2 rams-text--muted">
                    <div>Searched: ${result.stats.searched}</div>
                    <div>Imported: ${result.stats.imported}</div>
                    <div>Duplicates: ${result.stats.duplicates}</div>
                    <div>Queued for scrape: ${result.stats.queued_for_scrape}</div>
                </div>
            `;
            showToast(result.message);
            
            // Start progress polling if leads were queued for scraping
            if (result.stats.queued_for_scrape > 0) {
                startProgressPolling();
            }
        } else {
            contentDiv.innerHTML = `<div class="rams-text--danger">Error: ${result.error}</div>`;
            showToast(result.error, 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = 'Run Pipeline';
    }
});

// Preview Button
document.getElementById('preview-btn').addEventListener('click', async () => {
    const form = document.getElementById('pipeline-form');
    const btn = document.getElementById('preview-btn');
    btn.disabled = true;
    btn.textContent = 'Loading...';
    
    const data = {
        sector: form.sector.value,
        location: form.location.value || null
    };
    
    if (!data.sector) {
        showToast('Please select a sector', 'error');
        btn.disabled = false;
        btn.textContent = 'Preview Results';
        return;
    }
    
    try {
        const response = await fetch('/discovery-pipeline/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        if (result.success) {
            const container = document.getElementById('preview-table-container');
            const tbody = document.getElementById('preview-table-body');
            
            tbody.innerHTML = result.results.map(r => `
                <tr class="${r.is_duplicate ? 'rams-table__row--muted' : ''}">
                    <td class="rams-table__cell">${r.name}</td>
                    <td class="rams-table__cell">
                        ${r.website ? `<a href="${r.website}" target="_blank" class="rams-link">${r.website}</a>` : '—'}
                    </td>
                    <td class="rams-table__cell rams-text--muted">${r.snippet || '—'}</td>
                    <td class="rams-table__cell rams-text--center">
                        ${r.is_duplicate 
                            ? '<span class="rams-badge rams-badge--muted">Duplicate</span>'
                            : '<span class="rams-badge rams-badge--green">New</span>'}
                    </td>
                </tr>
            `).join('');
            
            container.classList.remove('rams-hidden');
            showToast(`Found ${result.total} results (${result.new_leads} new, ${result.duplicates} duplicates)`);
        } else {
            showToast(result.error, 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = 'Preview Results';
    }
});

// Enrich Form
document.getElementById('enrich-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = 'Processing...';
    
    const data = {
        limit: parseInt(form.limit.value),
        enable_llm: form.enable_llm.checked
    };
    
    try {
        const response = await fetch('/discovery-pipeline/enrich-existing', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        const resultsDiv = document.getElementById('enrich-results');
        resultsDiv.classList.remove('rams-hidden');
        resultsDiv.querySelector('div').textContent = result.success 
            ? `✓ ${result.message}` 
            : `Error: ${result.error}`;
        
        if (result.success) {
            showToast(result.message);
            // Start progress polling when enrichment begins
            startProgressPolling();
        } else {
            showToast(result.error, 'error');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    } finally {
        btn.disabled = false;
        btn.textContent = 'Start Enrichment';
    }
});

// Custom Export Modal
function exportCustomLeads() {
    // Create modal
    const modal = document.createElement('div');
    modal.className = 'rams-modal-overlay';
    modal.id = 'export-modal';
    
    modal.innerHTML = `
        <div class="rams-modal">
            <div class="rams-modal__header">
                <h3 class="rams-modal__title">Custom Export Options</h3>
            </div>
            <form id="custom-export-form" class="rams-modal__body rams-stack">
                <div class="rams-field">
                    <label class="rams-field__label">Review Status</label>
                    <select name="status" class="rams-input rams-select">
                        <option value="">All statuses</option>
                        <option value="pending">Pending</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </div>
                
                <div class="rams-grid rams-grid--2">
                    <div class="rams-field">
                        <label class="rams-field__label">Date From</label>
                        <input type="date" name="dateFrom" class="rams-input">
                    </div>
                    <div class="rams-field">
                        <label class="rams-field__label">Date To</label>
                        <input type="date" name="dateTo" class="rams-input">
                    </div>
                </div>
                
                <div class="rams-field">
                    <label class="rams-field__label">Sector Filter</label>
                    <input type="text" name="sector" placeholder="e.g., Aerospace" class="rams-input">
                </div>
                
                <div class="rams-field">
                    <label class="rams-field__label">Region</label>
                    <select name="region" class="rams-input rams-select">
                        <option value="">All regions</option>
                        <option value="north_america">North America</option>
                        <option value="europe">Europe</option>
                        <option value="asia_pacific">Asia Pacific</option>
                    </select>
                </div>
                
                <div class="rams-field rams-stack rams-stack--sm">
                    <label class="rams-field__label">Data Filters</label>
                    <label class="rams-checkbox">
                        <input type="checkbox" name="hasEmails" class="rams-checkbox__input">
                        <span class="rams-checkbox__label">Only leads with email addresses</span>
                    </label>
                    <label class="rams-checkbox">
                        <input type="checkbox" name="hasContactForm" class="rams-checkbox__input">
                        <span class="rams-checkbox__label">Only leads with contact forms</span>
                    </label>
                </div>
                
                <div class="rams-modal__footer">
                    <button type="button" onclick="closeExportModal()" class="rams-btn rams-btn--secondary">
                        Cancel
                    </button>
                    <button type="submit" class="rams-btn rams-btn--primary">
                        Export CSV
                    </button>
                </div>
            </form>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    // Handle form submission
    document.getElementById('custom-export-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const form = e.target;
        const params = new URLSearchParams();
        
        if (form.status.value) params.append('status', form.status.value);
        if (form.dateFrom.value) params.append('dateFrom', form.dateFrom.value);
        if (form.dateTo.value) params.append('dateTo', form.dateTo.value);
        if (form.sector.value) params.append('sector', form.sector.value);
        if (form.region.value) params.append('region', form.region.value);
        if (form.hasEmails.checked) params.append('hasEmails', '1');
        if (form.hasContactForm.checked) params.append('hasContactForm', '1');
        
        // Trigger download
        window.location.href = '{{ path("export_leads") }}?' + params.toString();
        
        closeExportModal();
    });
}

function closeExportModal() {
    const modal = document.getElementById('export-modal');
    if (modal) modal.remove();
}
</script>
{% endblock %}
