{% extends 'base.html.twig' %}

{% block title %}{{ 'guidance.all_notifications'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-4">
    {# Header Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <div>
                <h1 class="rams-page-title">{{ 'guidance.notifications'|trans }}</h1>
                <p class="rams-dymo">{{ 'guidance.subtitle'|trans }}</p>
            </div>
            <div class="rams-btn-group">
                {% if notifications|length > 0 %}
                    <button type="button" onclick="clearAllGuidanceNotifications()" class="rams-btn">
                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 4l-1 10H5L4 4M3 4h10M6 4V2h4v2"/>
                        </svg>
                        {{ 'guidance.clear_all'|trans }}
                    </button>
                {% endif %}
                <a href="{{ path('app_dashboard') }}" class="rams-btn--primary">
                    <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10 12l-6-4 6-4"/>
                    </svg>
                    {{ 'nav.dashboard'|trans }}
                </a>
            </div>
        </div>
    </div>

    {% if notifications|length == 0 %}
        {# Empty State #}
        <div class="rams-module">
            <div class="rams-module__content rams-rams-text--center rams-py-8">
                <div class="rams-andon rams-andon--success rams-mb-4">
                    <span class="rams-andon__light rams-andon__light--green"></span>
                </div>
                <h3 class="rams-rams-text--lg rams-text-bold rams-mb-2">{{ 'guidance.all_caught_up'|trans }}</h3>
                <p class="rams-dymo">{{ 'guidance.no_pending'|trans }}</p>
            </div>
        </div>
    {% else %}
        {# Notifications List #}
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-stack rams-gap-3">
                    {% for notification in notifications %}
                        <div class="rams-notification guidance-notification rams-notification--{{ notification.type ?? 'info' }}" data-notification-index="{{ loop.index0 }}">
                            {# Icon with Andon indicator #}
                            <div class="rams-notification__indicator">
                                <span class="rams-andon__light 
                                    {% if notification.type == 'success' %}rams-andon__light--green
                                    {% elseif notification.type == 'warning' %}rams-andon__light--yellow
                                    {% elseif notification.type == 'tip' %}rams-andon__light--blue
                                    {% else %}rams-andon__light--off{% endif %}">
                                </span>
                            </div>

                            {# Content #}
                            <div class="rams-notification__content">
                                <p class="rams-notification__message">{{ notification.message|raw }}</p>
                                <p class="rams-dymo rams-mt-1">{{ notification.timestamp|date('M d, Y g:i A') }}</p>
                            </div>

                            {# Action Buttons #}
                            <div class="rams-notification__actions">
                                {% if notification.actionUrl and notification.actionLabel %}
                                    <a href="{{ notification.actionUrl }}" class="rams-btn--primary rams-btn--sm">
                                        {{ notification.actionLabel }}
                                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M6 4l4 4-4 4"/>
                                        </svg>
                                    </a>
                                {% endif %}
                                {# Dismiss Button #}
                                <button type="button" onclick="dismissGuidanceNotification(this)" class="rams-btn--ghost rams-btn--sm" title="{{ 'common.close'|trans }}">
                                    <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4l8 8M4 12l8-8"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}
</div>

<script>
function dismissGuidanceNotification(button) {
    const notification = button.closest('.guidance-notification');
    const index = notification.getAttribute('data-notification-index');
    
    notification.style.transition = 'opacity 0.3s, transform 0.3s';
    notification.style.opacity = '0';
    notification.style.transform = 'translateX(100%)';
    
    fetch('{{ path('guidance_dismiss') }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'index=' + index
    }).then(response => {
        if (response.ok) {
            setTimeout(() => {
                notification.remove();
                const remaining = document.querySelectorAll('.guidance-notification').length;
                if (remaining === 0) {
                    location.reload();
                }
            }, 300);
        }
    });
}

function clearAllGuidanceNotifications() {
    ramsConfirm('{{ 'guidance.clear_confirm'|trans }}', function() {
        fetch('{{ path('guidance_dismiss_all') }}', {
            method: 'POST'
        }).then(response => {
            if (response.ok) {
                location.reload();
            }
        });
    }, {title: '{{ 'guidance.clear_all'|trans }}', variant: 'warning'});
}
</script>
{% endblock %}
