{% extends 'base.html.twig' %}

{% block title %}Quote Results{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Header with Geist-style typography -->
    <div class="border-b border-neutral-200/80 pb-5">
        <a href="{{ path('quote_estimator_list') }}" class="text-sm text-neutral-600 hover:text-neutral-900 inline-flex items-center mb-3">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Estimates
        </a>
        <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Quote Results</h1>
        <p class="mt-1.5 text-sm text-neutral-600">Estimate #{{ estimate.estimateNumber }}</p>
    </div>
    
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <!-- Customer Info -->
        <div class="rounded-xl border border-neutral-200/60 bg-white p-5">
            <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-600 mb-4">Customer</h2>
            <p class="text-neutral-700">
                <span class="font-medium text-neutral-900">{{ quoteData.customer_name | default('N/A') }}</span>
            </p>
        </div>

        <!-- Part Info -->
        <div class="rounded-xl border border-neutral-200/60 bg-white p-5">
            <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-600 mb-4">Part Details</h2>
            <p class="text-sm text-neutral-700">
                <span class="font-medium">Part #:</span> 
                <span class="text-neutral-900">{{ quoteData.part_number | default('N/A') }}</span>
            </p>
            <p class="text-sm text-neutral-700 mt-2">
                <span class="font-medium">Qty:</span> 
                <span class="text-neutral-900">{{ quoteData.quantity | default('N/A') }}</span>
            </p>
            {% if quoteData.delivery_date %}
            <p class="text-sm text-neutral-700 mt-2">
                <span class="font-medium">Required Date:</span> 
                <span class="text-neutral-900">{{ quoteData.delivery_date }}</span>
            </p>
            {% endif %}
        </div>

        <!-- Pricing Summary -->
        <div class="rounded-xl border border-neutral-200/60 bg-white p-5">
            <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-600 mb-4">Quote Summary</h2>
            <p class="text-sm text-neutral-700">
                <span class="font-medium">Status:</span> 
                <span class="ml-2 text-sm font-semibold text-amber-600">Pending Pricing</span>
            </p>
            <p class="text-sm text-neutral-700 mt-2">
                <span class="font-medium">Created:</span> 
                <span class="ml-2 text-sm text-neutral-900">{{ estimate.createdAt|date('M d, Y') }}</span>
            </p>
        </div>
    </div>

    <!-- Quote Details -->
    <div class="rounded-xl border border-neutral-200/60 bg-white p-6">
        <h2 class="text-lg font-semibold tracking-tight text-neutral-900 mb-4">Quote Details</h2>
        
        <div class="rounded-lg border border-amber-200/60 bg-amber-50/50 p-4 mb-4">
            <p class="text-sm text-amber-800">
                ⏳ <strong>Pricing in Progress:</strong> Your quote request has been saved. Our team will review and provide pricing shortly.
            </p>
        </div>

        {% if quoteData.special_requirements %}
        <div class="mt-4 rounded-lg border border-neutral-200/60 bg-neutral-50/50 p-4">
            <h3 class="font-medium text-neutral-900 mb-2">Special Requirements:</h3>
            <p class="text-sm text-neutral-700">{{ quoteData.special_requirements }}</p>
        </div>
        {% endif %}
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap gap-4 justify-center">
        <a href="{{ path('quote_estimator_index') }}" class="inline-flex items-center rounded-lg border border-neutral-200/60 bg-white px-6 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">
            ← New Quote Request
        </a>
        <button onclick="window.print()" class="inline-flex items-center rounded-lg bg-neutral-900 px-6 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-800">
            🖨️ Print
        </button>
    </div>
</div>
{% endblock %}
