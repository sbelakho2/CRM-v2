{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.estimator.estimate_results'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <a href="{{ path('quote_estimator_index') }}">{{ 'nav.quote_estimator'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ 'quote.estimator.estimate_results'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'quote.estimator.estimate_results'|trans }}</h1>
            <p class="rams-page__subtitle">{{ 'quote.estimator.estimate_number'|trans }} #{{ estimate.estimateNumber }}</p>
        </div>
        <div class="rams-page__actions">
            <button onclick="window.print()" class="rams-btn uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 6V2H12V6M4 11H12M3 6H13V12H3V6Z"/>
                </svg>
                {{ 'common.print'|trans }}
            </button>
        </div>
    </div>
    
    <div class="rams-grid rams-grid--3 rams-mb-6">
        {# Customer Info #}
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'company.name'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-base">{{ quoteData.customer_name | default('common.n_a'|trans) }}</div>
            </div>
        </div>

        {# Part Info #}
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'quote.estimator.part_number'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-base rams-text-break">{{ quoteData.part_number | default('common.n_a'|trans) }}</div>
            </div>
        </div>

        {# Quantity Info #}
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'common.quantity'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-base">{{ quoteData.quantity | default('common.n_a'|trans) }}</div>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--2 rams-gap-6">
        {# Delivery & Status #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.estimator.status_delivery'|trans|default('Status & Delivery') }}</h3>
            </div>
            <div class="rams-module__content">
                <dl class="rams-definition-list">
                    <div class="rams-definition-list__item">
                        <dt class="rams-definition-list__term">{{ 'common.status'|trans }}</dt>
                        <dd class="rams-definition-list__desc">
                            <span class="rams-badge rams-badge--warning uppercase">{{ 'quote.estimator.pending_pricing'|trans }}</span>
                        </dd>
                    </div>
                    {% if quoteData.delivery_date %}
                    <div class="rams-definition-list__item">
                        <dt class="rams-definition-list__term">{{ 'quote.estimator.required_date'|trans }}</dt>
                        <dd class="rams-definition-list__desc tabular-nums">{{ quoteData.delivery_date }}</dd>
                    </div>
                    {% endif %}
                    <div class="rams-definition-list__item">
                        <dt class="rams-definition-list__term">{{ 'quote.created_at'|trans }}</dt>
                        <dd class="rams-definition-list__desc tabular-nums text-xs">{{ estimate.createdAt|date('M d, Y H:i') }}</dd>
                    </div>
                </dl>
            </div>
        </div>

        {# Quote Details #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.estimator.quote_details'|trans }}</h2>
            </div>
            <div class="rams-module__content">
                <div class="rams-alert rams-alert--warning rams-mb-6">
                    <div class="rams-alert__content">
                        <div class="rams-alert__title uppercase">{{ 'quote.estimator.pricing_in_progress'|trans }}</div>
                        <p class="text-sm">{{ 'quote.estimator.pricing_message'|trans }}</p>
                    </div>
                </div>

                {% if quoteData.special_requirements %}
                    <div class="rams-flex rams-flex-col rams-gap-2">
                        <span class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.estimator.special_requirements'|trans }}</span>
                        <div class="text-sm text-rams-muted rams-bg-panel rams-p-4 rams-border border-rams-line rounded-rams-sm">
                            {{ quoteData.special_requirements|nl2br }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Actions #}
    <div class="rams-flex rams-justify-center rams-gap-4 rams-mt-8">
        <a href="{{ path('quote_estimator_index') }}" class="rams-btn uppercase">
            <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 8H4M8 4L4 8L8 12"/>
            </svg>
            {{ 'quote.estimator.new_quote_request'|trans }}
        </a>
    </div>
</div>
{% endblock %}
