{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.estimator.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ 'quote.estimator.title'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'quote.estimator.title'|trans }}</h1>
            <p class="rams-page__subtitle">{{ 'quote.estimator.subtitle'|trans }}</p>
        </div>
        <div class="rams-page__actions">
            <a href="{{ path('quote_estimator_list') }}" class="rams-btn uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="12" height="12" rx="1"/><path d="M5 5H11M5 8H11M5 11H8"/>
                </svg>
                {{ 'quote.estimator.saved_estimates'|trans|default('SAVED ESTIMATES') }}
            </a>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6">
        <div class="rams-grid-span-2">
            <div class="rams-module">
                <div class="rams-module__content">
                    {% if errors is defined and errors %}
                        <div class="rams-alert rams-alert--error rams-mb-6">
                            <div class="rams-alert__content">
                                <div class="rams-alert__title">{{ 'common.error'|trans }}</div>
                                {% for error in errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <form method="POST" action="{{ path('quote_estimator_calculate') }}" class="rams-form">
                        <div class="rams-grid rams-grid--2 rams-gap-4">
                            <div class="rams-form__group">
                                <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.estimator.customer_name'|trans }}</label>
                                <input type="text" name="customer_name" class="rams-form__input" placeholder="{{ 'quote.estimator.customer_name_placeholder'|trans }}">
                            </div>

                            <div class="rams-form__group">
                                <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.estimator.part_number'|trans }}</label>
                                <input type="text" name="part_number" class="rams-form__input" placeholder="{{ 'quote.estimator.part_number_placeholder'|trans }}">
                            </div>

                            <div class="rams-form__group">
                                <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'common.quantity'|trans }}</label>
                                <input type="number" name="quantity" class="rams-form__input" placeholder="{{ 'quote.estimator.quantity_placeholder'|trans }}">
                            </div>

                            <div class="rams-form__group">
                                <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.estimator.required_delivery'|trans }}</label>
                                <input type="date" name="delivery_date" class="rams-form__input">
                            </div>
                        </div>

                        <div class="rams-form__group rams-mt-4">
                            <label class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'quote.estimator.special_requirements'|trans }}</label>
                            <textarea name="special_requirements" rows="4" class="rams-form__input" placeholder="{{ 'quote.estimator.special_requirements_placeholder'|trans }}"></textarea>
                        </div>

                        <div class="rams-actions rams-mt-6">
                            <button type="submit" name="action" value="estimate" class="rams-btn rams-btn--primary uppercase">
                                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M8 2L10 6L14 8L10 10L8 14L6 10L2 8L6 6L8 2Z"/>
                                </svg>
                                {{ 'quote.estimator.generate_quote'|trans }}
                            </button>
                            <button type="submit" name="action" value="save" class="rams-btn uppercase">
                                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M3 13H13V5L10 2H3V13Z"/><path d="M10 2V5H13"/>
                                </svg>
                                {{ 'quote.estimator.save_for_later'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div>
            <div class="rams-module rams-module--guidance">
                <div class="rams-module__header">
                    <div class="rams-flex rams-gap-2 rams-items-center">
                        <div class="rams-andon rams-andon--info"><span class="rams-andon__light"></span></div>
                        <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mb-0">{{ 'quote.estimator.how_to_use'|trans }}</h3>
                    </div>
                </div>
                <div class="rams-module__content">
                    <ul class="rams-stack rams-gap-4 rams-p-0" style="list-style: none;">
                        <li class="rams-flex rams-gap-3">
                            <span class="font-mono text-3xs text-rams-muted rams-bg-panel rams-px-2 rams-py-1 rams-border rounded-rams-sm" style="height: fit-content;">01</span>
                            <span class="rams-text--xs rams-text--muted">{{ 'quote.estimator.instruction_1'|trans }}</span>
                        </li>
                        <li class="rams-flex rams-gap-3">
                            <span class="font-mono text-3xs text-rams-muted rams-bg-panel rams-px-2 rams-py-1 rams-border rounded-rams-sm" style="height: fit-content;">02</span>
                            <span class="rams-text--xs rams-text--muted">{{ 'quote.estimator.instruction_2'|trans }}</span>
                        </li>
                        <li class="rams-flex rams-gap-3">
                            <span class="font-mono text-3xs text-rams-muted rams-bg-panel rams-px-2 rams-py-1 rams-border rounded-rams-sm" style="height: fit-content;">03</span>
                            <span class="rams-text--xs rams-text--muted">{{ 'quote.estimator.instruction_3'|trans }}</span>
                        </li>
                        <li class="rams-flex rams-gap-3">
                            <span class="font-mono text-3xs text-rams-muted rams-bg-panel rams-px-2 rams-py-1 rams-border rounded-rams-sm" style="height: fit-content;">04</span>
                            <span class="rams-text--xs rams-text--muted">{{ 'quote.estimator.instruction_4'|trans }}</span>
                        </li>
                        <li class="rams-flex rams-gap-3">
                            <span class="font-mono text-3xs text-rams-muted rams-bg-panel rams-px-2 rams-py-1 rams-border rounded-rams-sm" style="height: fit-content;">05</span>
                            <span class="rams-text--xs rams-text--muted">{{ 'quote.estimator.instruction_5'|trans }}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
