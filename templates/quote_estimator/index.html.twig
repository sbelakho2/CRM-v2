{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.estimator.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-stack--lg">
    {# Page Header #}
    <header class="rams-module__header rams-module__header--rams-border-bottom">
        <h1 class="rams-heading rams-heading--1">{{ 'quote.estimator.title'|trans }}</h1>
        <p class="rams-text rams-text--muted">{{ 'quote.estimator.subtitle'|trans }}</p>
    </header>

    <div class="rams-page">
        <div class="rams-module">
            <div class="rams-module__content">
                {% if errors is defined and errors %}
                    <div class="rams-module rams-module--alert">
                        <h3 class="rams-heading rams-heading--4">{{ 'common.error'|trans }}:</h3>
                        {% for error in errors %}
                            <p class="rams-text rams-text--sm">{{ error }}</p>
                        {% endfor %}
                    </div>
                {% endif %}

                <form method="POST" action="{{ path('quote_estimator_calculate') }}">
                    <div class="rams-grid rams-grid--2 rams-gap-4">
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'quote.estimator.customer_name'|trans }}</label>
                            <input type="text" name="customer_name" class="rams-form__input" placeholder="{{ 'quote.estimator.customer_name_placeholder'|trans }}">
                        </div>

                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'quote.estimator.part_number'|trans }}</label>
                            <input type="text" name="part_number" class="rams-form__input" placeholder="{{ 'quote.estimator.part_number_placeholder'|trans }}">
                        </div>

                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'common.quantity'|trans }}</label>
                            <input type="number" name="quantity" class="rams-form__input" placeholder="{{ 'quote.estimator.quantity_placeholder'|trans }}">
                        </div>

                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'quote.estimator.required_delivery'|trans }}</label>
                            <input type="date" name="delivery_date" class="rams-form__input">
                        </div>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'quote.estimator.special_requirements'|trans }}</label>
                        <textarea name="special_requirements" rows="4" class="rams-form__textarea" placeholder="{{ 'quote.estimator.special_requirements_placeholder'|trans }}"></textarea>
                    </div>

                    <div class="rams-form__actions">
                        <button type="submit" name="action" value="estimate" class="rams-btn--primary">
                            {{ 'quote.estimator.generate_quote'|trans }}
                        </button>
                        <button type="submit" name="action" value="save" class="rams-btn">
                            {{ 'quote.estimator.save_for_later'|trans }}
                        </button>
                    </div>
                </form>

                <div class="rams-module rams-bg-soft">
                    <div class="rams-module__header">
                        <h3 class="rams-heading rams-heading--4">{{ 'quote.estimator.how_to_use'|trans }}</h3>
                    </div>
                    <div class="rams-module__content">
                        <ul class="rams-list rams-list--bullet">
                            <li class="rams-list__item">{{ 'quote.estimator.instruction_1'|trans }}</li>
                            <li class="rams-list__item">{{ 'quote.estimator.instruction_2'|trans }}</li>
                            <li class="rams-list__item">{{ 'quote.estimator.instruction_3'|trans }}</li>
                            <li class="rams-list__item">{{ 'quote.estimator.instruction_4'|trans }}</li>
                            <li class="rams-list__item">{{ 'quote.estimator.instruction_5'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
