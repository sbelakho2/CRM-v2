{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block body %}
<div class="rams-stack rams-stack--lg">
    {# Header #}
    <header class="rams-module__header rams-module__header--row rams-module__header--border-bottom">
        <div>
            <h1 class="rams-heading rams-heading--1">{{ pageTitle }}</h1>
            <p class="rams-text rams-text--muted">{{ 'quote.estimator.list_subtitle'|trans|default('Manage quote requests and estimates') }}</p>
        </div>
        <a href="{{ path('quote_estimator_index') }}" class="rams-btn rams-btn--secondary">
            <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 3V13M3 8H13"/>
            </svg>
            {{ 'quote.estimator.new_quote_request'|trans|default('New Quote Request') }}
        </a>
    </header>

    {# Filters #}
    <div class="rams-module">
        <div class="rams-module__content">
            <form method="GET" class="rams-form rams-form--inline">
                <div class="rams-form__group rams-form__group--flex-1">
                    <input 
                        type="text" 
                        name="search" 
                        placeholder="{{ 'quote.estimator.search_placeholder'|trans|default('Search by estimate number, customer name, or part number...') }}" 
                        value="{{ search }}"
                        class="rams-form__input"
                    >
                </div>
                <button type="submit" class="rams-btn rams-btn--secondary">
                    <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="7" cy="7" r="4"/>
                        <path d="M11 11L14 14"/>
                    </svg>
                    {{ 'common.search'|trans }}
                </button>
                {% if search %}
                    <a href="{{ path('quote_estimator_list') }}" class="rams-btn rams-btn--ghost">
                        {{ 'common.clear'|trans }}
                    </a>
                {% endif %}
            </form>
        </div>
    </div>

    {# Statistics #}
    <div class="rams-grid rams-grid--cols-3 rams-grid--gap-md">
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'quote.estimator.total_estimates'|trans|default('Total Estimates') }}</span>
                <p class="rams-metric rams-metric--lg">{{ estimates|length }}</p>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'quote.estimator.this_month'|trans|default('This Month') }}</span>
                <p class="rams-metric rams-metric--lg">
                    {% set thisMonth = estimates|filter(e => e.createdAt|date('Y-m') == 'now'|date('Y-m'))|length %}
                    {{ thisMonth }}
                </p>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'common.pending'|trans }}</span>
                <p class="rams-metric rams-metric--lg">{{ estimates|length }}</p>
            </div>
        </div>
    </div>

    {# Estimates Table #}
    <div class="rams-module">
        {% if estimates|length > 0 %}
            <div class="rams-table-container">
                <table class="rams-table">
                    <thead class="rams-table__header">
                        <tr>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.estimator.estimate_number'|trans|default('Estimate #') }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.estimator.customer'|trans|default('Customer') }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.estimator.part_number'|trans|default('Part Number') }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'common.quantity'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.estimator.delivery_date'|trans|default('Delivery Date') }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'quote.created_at'|trans }}</th>
                            <th class="rams-table__cell rams-table__cell--header">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="rams-table__body">
                        {% for estimate in estimates %}
                            {% set quoteData = quoteDataMap[estimate.id] ?? {} %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--purple">{{ estimate.estimateNumber }}</span>
                                </td>
                                <td class="rams-table__cell">
                                    {% if quoteData.customer_name %}
                                        <span class="rams-text rams-text--bold">{{ quoteData.customer_name }}</span>
                                    {% elseif estimate.company %}
                                        <span class="rams-text rams-text--bold">{{ estimate.company.name }}</span>
                                    {% else %}
                                        <span class="rams-text rams-text--muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    <code class="rams-code">{{ quoteData.part_number ?? '—' }}</code>
                                </td>
                                <td class="rams-table__cell">
                                    <span class="rams-text rams-text--bold">{{ quoteData.quantity ?? '—' }}</span>
                                </td>
                                <td class="rams-table__cell">
                                    {% if quoteData.delivery_date %}
                                        <span class="rams-text rams-text--sm">{{ quoteData.delivery_date|date('M d, Y') }}</span>
                                    {% else %}
                                        <span class="rams-text rams-text--muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">
                                    <span class="rams-badge rams-badge--yellow">{{ 'quote.estimator.pending_pricing'|trans|default('Pending Pricing') }}</span>
                                </td>
                                <td class="rams-table__cell">
                                    <span class="rams-text rams-text--sm rams-text--muted">{{ estimate.createdAt|date('M d, Y') }}</span>
                                </td>
                                <td class="rams-table__cell">
                                    <div class="rams-btn-group">
                                        <a href="{{ path('quote_estimator_results', {id: estimate.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">
                                            {{ 'common.view'|trans }}
                                        </a>
                                        <button onclick="deleteEstimate({{ estimate.id }})" class="rams-btn rams-btn--ghost rams-btn--sm rams-btn--danger">
                                            {{ 'common.delete'|trans }}
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="rams-empty-state">
                <svg class="rams-empty-state__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <h3 class="rams-empty-state__title">{{ 'quote.estimator.no_estimates'|trans|default('No Estimates Found') }}</h3>
                <p class="rams-empty-state__text">
                    {% if search %}
                        {{ 'quote.estimator.no_estimates_search'|trans|default('No estimates match your search criteria.') }}
                    {% else %}
                        {{ 'quote.estimator.no_estimates_start'|trans|default('Get started by creating your first quote request.') }}
                    {% endif %}
                </p>
                <a href="{{ path('quote_estimator_index') }}" class="rams-btn rams-btn--secondary">
                    {{ 'quote.estimator.create_new'|trans|default('Create New Quote Request') }}
                </a>
            </div>
        {% endif %}
    </div>
</div>

<script>
function deleteEstimate(id) {
    ramsConfirm('{{ 'quote.estimator.delete_confirm'|trans|default('Are you sure you want to delete this estimate? This action cannot be undone.') }}', function() {
        fetch(`/quote-estimator/${id}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.reload();
            } else {
                ramsAlert('{{ 'common.error'|trans }}: ' + data.message, {variant: 'error'});
            }
        })
        .catch(error => {
            ramsAlert('{{ 'quote.estimator.delete_error'|trans|default('Error deleting estimate') }}', {variant: 'error'});
            console.error(error);
        });
    }, {variant: 'danger', title: '{{ 'quote.estimator.delete'|trans|default('Delete Estimate') }}'});
}
</script>
{% endblock %}
