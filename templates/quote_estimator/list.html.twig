{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ 'nav.quote_estimator'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ pageTitle }}</h1>
            <p class="rams-page__subtitle">{{ 'quote.estimator.list_subtitle'|trans }}</p>
        </div>
        <div class="rams-page__actions">
            <a href="{{ path('quote_estimator_index') }}" class="rams-btn rams-btn--primary uppercase">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2V14M2 8H14"/>
                </svg>
                {{ 'quote.estimator.new_quote_request'|trans }}
            </a>
        </div>
    </div>

    {# Filters #}
    <div class="rams-module rams-mb-6">
        <div class="rams-module__content">
            <form method="GET" class="rams-flex rams-gap-2">
                <div class="rams-flex-grow">
                    <input 
                        type="text" 
                        name="search" 
                        placeholder="{{ 'quote.estimator.search_placeholder'|trans }}" 
                        value="{{ search }}"
                        class="rams-form__input"
                    >
                </div>
                <button type="submit" class="rams-btn uppercase">
                    <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="7" cy="7" r="4"/><path d="M10 10L13 13"/>
                    </svg>
                    {{ 'common.search'|trans }}
                </button>
                {% if search %}
                    <a href="{{ path('quote_estimator_list') }}" class="rams-btn rams-btn--ghost uppercase">
                        {{ 'common.clear'|trans }}
                    </a>
                {% endif %}
            </form>
        </div>
    </div>

    {# Statistics #}
    <div class="rams-grid rams-grid--3 rams-mb-6">
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'quote.estimator.total_estimates'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ estimates|length }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'quote.estimator.this_month'|trans }}</div>
                <div class="rams-metric__value tabular-nums">
                    {% set thisMonth = estimates|filter(e => e.createdAt|date('Y-m') == 'now'|date('Y-m'))|length %}
                    {{ thisMonth }}
                </div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-orange">{{ 'common.pending'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-rams-orange">{{ estimates|length }}</div>
            </div>
        </div>
    </div>

    {# Estimates Table #}
    <div class="rams-module">
        {% if estimates|length > 0 %}
            <div class="rams-table-container">
                <table class="rams-table">
                    <thead>
                        <tr>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'quote.estimator.estimate_number'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'quote.estimator.customer'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'quote.estimator.part_number'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'common.quantity'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'quote.estimator.delivery_date'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'common.status'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'quote.created_at'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for estimate in estimates %}
                            {% set quoteData = quoteDataMap[estimate.id] ?? {} %}
                            <tr>
                                <td>
                                    <span class="rams-badge rams-badge--neutral">{{ estimate.estimateNumber }}</span>
                                </td>
                                <td>
                                    {% if quoteData.customer_name %}
                                        <span class="font-medium">{{ quoteData.customer_name }}</span>
                                    {% elseif estimate.company %}
                                        <span class="font-medium">{{ estimate.company.name }}</span>
                                    {% else %}
                                        <span class="rams-text--muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <code class="font-mono text-xs">{{ quoteData.part_number ?? '—' }}</code>
                                </td>
                                <td class="tabular-nums">
                                    {{ quoteData.quantity ?? '—' }}
                                </td>
                                <td class="tabular-nums">
                                    {% if quoteData.delivery_date %}
                                        {{ quoteData.delivery_date|date('M d, Y') }}
                                    {% else %}
                                        <span class="rams-text--muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="rams-badge rams-badge--warning">{{ 'quote.estimator.pending_pricing'|trans }}</span>
                                </td>
                                <td class="tabular-nums text-rams-muted">
                                    {{ estimate.createdAt|date('M d, Y') }}
                                </td>
                                <td>
                                    <div class="rams-actions rams-actions--sm">
                                        <a href="{{ path('quote_estimator_results', {id: estimate.id}) }}" class="rams-btn rams-btn--ghost uppercase">
                                            {{ 'common.view'|trans }}
                                        </a>
                                        <button onclick="deleteEstimate({{ estimate.id }})" class="rams-btn rams-btn--ghost rams-btn--danger uppercase">
                                            {{ 'common.delete'|trans }}
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="rams-p-12 rams-text--center">
                <svg class="rams-icon rams-icon--xl rams-text--muted rams-mb-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="12" height="12" rx="1"/><path d="M5 5H11M5 8H11M5 11H8"/>
                </svg>
                <h3 class="font-mono text-xs uppercase tracking-widest text-rams-muted rams-mb-2">{{ 'quote.estimator.no_estimates'|trans }}</h3>
                <p class="rams-text--sm rams-text--muted rams-mb-6">
                    {% if search %}
                        {{ 'quote.estimator.no_estimates_search'|trans }}
                    {% else %}
                        {{ 'quote.estimator.no_estimates_start'|trans }}
                    {% endif %}
                </p>
                <a href="{{ path('quote_estimator_index') }}" class="rams-btn rams-btn--primary uppercase">
                    {{ 'quote.estimator.create_new'|trans }}
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function deleteEstimate(id) {
    ramsConfirm('{{ 'quote.estimator.delete_confirm'|trans }}', function() {
        fetch(`/quote-estimator/${id}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.reload();
            } else {
                ramsAlert('{{ 'common.error'|trans }}: ' + data.message, {variant: 'error'});
            }
        })
        .catch(error => {
            ramsAlert('{{ 'quote.estimator.delete_error'|trans }}', {variant: 'error'});
            console.error(error);
        });
    }, {variant: 'danger', title: '{{ 'quote.estimator.delete'|trans }}'});
}
</script>
{% endblock %}
