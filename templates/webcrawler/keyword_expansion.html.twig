{% extends 'base.html.twig' %}

{% block title %}{{ 'webcrawler.keyword_expansion'|trans }}{% endblock %}


{% block stylesheets %}
{{ parent() }}
<style>
    .rams-keyword-group { padding: var(--space-3); background: var(--rams-panel); border: 1px solid var(--rams-line); border-radius: var(--radius-sm); }
    .rams-keyword-group__title { margin: 0 0 var(--space-2); font-size: var(--text-sm); font-weight: 600; }
    .rams-keyword-group__keywords { margin: 0; font-size: var(--text-xs); color: var(--rams-muted); line-height: 1.6; }
    .rams-results { margin-top: var(--space-4); }
    .rams-results__title { margin: 0 0 var(--space-3); }
    .rams-results__actions { margin-top: var(--space-3); }
    .rams-keyword-cloud { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .rams-keyword-tag { display: inline-block; padding: 4px 10px; background: var(--rams-surface); border: 1px solid var(--rams-border); border-radius: 999px; font-size: var(--text-xs); }
</style>
{% endblock %}

{% block body %}
<div class="rams-module">
    <div class="rams-module__header">
        <div class="rams-breadcrumb">
            <a href="{{ path('app_webcrawler_index') }}" class="rams-breadcrumb__link">{{ 'webcrawler.title'|trans }}</a>
            <span class="rams-breadcrumb__separator">/</span>
            <span class="rams-breadcrumb__current">{{ 'webcrawler.keyword_expansion'|trans }}</span>
        </div>
        
        <div class="rams-module__header">
            <h1 class="rams-module__title">{{ 'webcrawler.keyword_expansion'|trans }}</h1>
            <p class="rams-text--sm rams-text--muted">{{ 'webcrawler.keyword_expansion_subtitle'|trans }}</p>
        </div>
    </div>

    <div class="rams-module__content">
        <div class="rams-module rams-module--inset"> 
            <div class="rams-module__content">
                <form id="expansion-form" class="rams-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('webcrawler_keyword_expansion') }}"> <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'webcrawler.base_sector'|trans }}</label>
                        <select name="sector" required class="rams-form__select">
                            {% for sector in sectors %}
                                <option value="{{ sector }}">{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'webcrawler.additional_keywords'|trans }} ({{ 'webcrawler.comma_separated'|trans }})</label>
                        <textarea name="keywords" rows="3" class="rams-form__textarea" placeholder="{{ 'webcrawler.keywords_placeholder_expansion'|trans }}"></textarea>
                    </div>

                    <div class="rams-form__actions">
                        <button type="submit" class="rams-btn rams-btn--primary">{{ 'webcrawler.generate_keywords'|trans }}</button>
                    </div>
                </form>

                <div id="expansion-results" class="rams-results rams-hidden">
                    <h3 class="rams-results__title">{{ 'webcrawler.expanded_keywords'|trans }}</h3>
                    <div id="keywords-list" class="rams-keyword-cloud"></div>
                    
                    <div class="rams-results__actions">
                        <button id="copy-keywords" class="rams-btn">{{ 'webcrawler.copy_all_keywords'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Keyword Suggestions -->
        <div class="rams-module rams-module--inset"> 
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.common_keywords_by_sector'|trans }}</h2>
            </div>
            
            <div class="rams-module__content">
                <div class="rams-grid rams-grid--2">
                    <div class="rams-keyword-group">
                        <h3 class="rams-keyword-group__title">{{ 'webcrawler.sector_automotive'|trans }}</h3>
                        <p class="rams-keyword-group__keywords">{{ 'webcrawler.keywords_automotive'|trans }}</p>
                    </div>
                    <div class="rams-keyword-group">
                        <h3 class="rams-keyword-group__title">{{ 'webcrawler.sector_aerospace'|trans }}</h3>
                        <p class="rams-keyword-group__keywords">{{ 'webcrawler.keywords_aerospace'|trans }}</p>
                    </div>
                    <div class="rams-keyword-group">
                        <h3 class="rams-keyword-group__title">{{ 'webcrawler.sector_industrial'|trans }}</h3>
                        <p class="rams-keyword-group__keywords">{{ 'webcrawler.keywords_industrial'|trans }}</p>
                    </div>
                    <div class="rams-keyword-group">
                        <h3 class="rams-keyword-group__title">{{ 'webcrawler.sector_electronics'|trans }}</h3>
                        <p class="rams-keyword-group__keywords">{{ 'webcrawler.keywords_electronics'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('expansion-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const resultsDiv = document.getElementById('expansion-results');
    const keywordsList = document.getElementById('keywords-list');
    
    try {
        const response = await fetch('{{ path('app_webcrawler_keyword_expansion') }}', {
            method: 'POST',
            body: formData
        });
        
        const data = await response.json();
        
        if (data.success) {
            resultsDiv.classList.remove('rams-hidden');
            keywordsList.innerHTML = data.keywords.map(kw => 
                `<span class="rams-keyword-tag">${kw}</span>`
            ).join('');
            
            // Store keywords for copying
            window.expandedKeywords = data.keywords;
        }
    } catch (error) {
        ramsAlert('{{ 'common.error'|trans }}: ' + error.message, {variant: 'error'});
    }
});

document.getElementById('copy-keywords').addEventListener('click', function() {
    if (window.expandedKeywords) {
        const text = window.expandedKeywords.join(', ');
        navigator.clipboard.writeText(text).then(() => {
            this.textContent = '✓ {{ 'common.copied'|trans }}';
            setTimeout(() => this.textContent = '{{ 'webcrawler.copy_all_keywords'|trans }}', 2000);
        });
    }
});
</script>
{% endblock %}
