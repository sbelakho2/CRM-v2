{% extends 'base.html.twig' %}

{% block title %}Keyword Expansion Tool{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <a href="{{ path('app_webcrawler_index') }}" class="text-blue-600 hover:text-blue-800 text-sm">
            ← Back to WebCrawler
        </a>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
        <h1 class="text-2xl font-bold mb-4">Keyword Expansion Tool</h1>
        <p class="text-gray-600 mb-6">Generate keyword variations for better search coverage</p>

        <form id="expansion-form" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Base Sector</label>
                <select name="sector" required class="w-full px-3 py-2 border border-gray-300 rounded-md">
                    {% for sector in sectors %}
                        <option value="{{ sector }}">{{ sector }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Additional Keywords (comma-separated)</label>
                <textarea name="keywords" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md" placeholder="e.g., tier 1, supplier, OEM"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Generate Keywords</button>
        </form>

        <div id="expansion-results" class="mt-6 hidden">
            <h3 class="text-lg font-semibold mb-3">Expanded Keywords</h3>
            <div id="keywords-list" class="flex flex-wrap gap-2"></div>
            
            <div class="mt-4">
                <button id="copy-keywords" class="btn btn-secondary text-sm">Copy All Keywords</button>
            </div>
        </div>
    </div>

    <!-- Keyword Suggestions -->
    <div class="mt-8 bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold mb-4">Common Keywords by Sector</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <h3 class="font-medium text-gray-900 mb-2">Automotive</h3>
                <p class="text-sm text-gray-600">OEM, Tier 1, Tier 2, vehicle, car, powertrain, chassis, assembly</p>
            </div>
            <div>
                <h3 class="font-medium text-gray-900 mb-2">Aerospace</h3>
                <p class="text-sm text-gray-600">aviation, aircraft, defense, MRO, avionics, cabin, landing gear</p>
            </div>
            <div>
                <h3 class="font-medium text-gray-900 mb-2">Industrial</h3>
                <p class="text-sm text-gray-600">manufacturing, factory, production, machinery, automation, robotics</p>
            </div>
            <div>
                <h3 class="font-medium text-gray-900 mb-2">Electronics</h3>
                <p class="text-sm text-gray-600">PCBA, PCB, EMS, SMT, assembly, contract manufacturer, electronics</p>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('expansion-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const resultsDiv = document.getElementById('expansion-results');
    const keywordsList = document.getElementById('keywords-list');
    
    try {
        const response = await fetch('{{ path('app_webcrawler_keyword_expansion') }}', {
            method: 'POST',
            body: formData
        });
        
        const data = await response.json();
        
        if (data.success) {
            resultsDiv.classList.remove('hidden');
            keywordsList.innerHTML = data.keywords.map(kw => 
                `<span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">${kw}</span>`
            ).join('');
            
            // Store keywords for copying
            window.expandedKeywords = data.keywords;
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
});

document.getElementById('copy-keywords').addEventListener('click', function() {
    if (window.expandedKeywords) {
        const text = window.expandedKeywords.join(', ');
        navigator.clipboard.writeText(text).then(() => {
            this.textContent = '✓ Copied!';
            setTimeout(() => this.textContent = 'Copy All Keywords', 2000);
        });
    }
});
</script>
{% endblock %}
