{% extends 'base.html.twig' %}

{% block title %}{{ 'webcrawler.keyword_expansion'|trans }}{% endblock %}

{% block body %}
<div class="rams-module">
    <div class="rams-module__header">
        <div class="rams-breadcrumb">
            <a href="{{ path('app_webcrawler_index') }}" class="rams-breadcrumb__link">{{ 'webcrawler.title'|trans }}</a>
            <span class="rams-breadcrumb__separator">/</span>
            <span class="rams-breadcrumb__current">{{ 'webcrawler.keyword_expansion'|trans }}</span>
        </div>
        
        <div class="rams-module__header-content">
            <h1 class="rams-module__title">{{ 'webcrawler.keyword_expansion'|trans }}</h1>
            <p class="rams-module__subtitle">{{ 'webcrawler.keyword_expansion_subtitle'|trans|default('Generate keyword variations for better search coverage') }}</p>
        </div>
    </div>

    <div class="rams-module__content">
        <div class="rams-module rams-module--nested">
            <div class="rams-module__content">
                <form id="expansion-form" class="rams-form">
                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'webcrawler.base_sector'|trans|default('Base Sector') }}</label>
                        <select name="sector" required class="rams-form__select">
                            {% for sector in sectors %}
                                <option value="{{ sector }}">{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'webcrawler.additional_keywords'|trans|default('Additional Keywords') }} ({{ 'webcrawler.comma_separated'|trans|default('comma-separated') }})</label>
                        <textarea name="keywords" rows="3" class="rams-form__textarea" placeholder="{{ 'webcrawler.keywords_placeholder_expansion'|trans|default('e.g., tier 1, supplier, OEM') }}"></textarea>
                    </div>

                    <div class="rams-form__actions">
                        <button type="submit" class="rams-btn rams-btn--primary">{{ 'webcrawler.generate_keywords'|trans|default('Generate Keywords') }}</button>
                    </div>
                </form>

                <div id="expansion-results" class="rams-results hidden">
                    <h3 class="rams-results__title">{{ 'webcrawler.expanded_keywords'|trans }}</h3>
                    <div id="keywords-list" class="rams-keyword-cloud"></div>
                    
                    <div class="rams-results__actions">
                        <button id="copy-keywords" class="rams-btn rams-btn--secondary">{{ 'webcrawler.copy_all_keywords'|trans|default('Copy All Keywords') }}</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Keyword Suggestions -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.common_keywords_by_sector'|trans|default('Common Keywords by Sector') }}</h2>
            </div>
            
            <div class="rams-module__content">
                <div class="rams-grid rams-grid--2">
                    <div class="rams-keyword-group">
                        <h3 class="rams-keyword-group__title">{{ 'webcrawler.sector_automotive'|trans|default('Automotive') }}</h3>
                        <p class="rams-keyword-group__keywords">OEM, Tier 1, Tier 2, vehicle, car, powertrain, chassis, assembly</p>
                    </div>
                    <div class="rams-keyword-group">
                        <h3 class="rams-keyword-group__title">{{ 'webcrawler.sector_aerospace'|trans|default('Aerospace') }}</h3>
                        <p class="rams-keyword-group__keywords">aviation, aircraft, defense, MRO, avionics, cabin, landing gear</p>
                    </div>
                    <div class="rams-keyword-group">
                        <h3 class="rams-keyword-group__title">{{ 'webcrawler.sector_industrial'|trans|default('Industrial') }}</h3>
                        <p class="rams-keyword-group__keywords">manufacturing, factory, production, machinery, automation, robotics</p>
                    </div>
                    <div class="rams-keyword-group">
                        <h3 class="rams-keyword-group__title">{{ 'webcrawler.sector_electronics'|trans|default('Electronics') }}</h3>
                        <p class="rams-keyword-group__keywords">PCBA, PCB, EMS, SMT, assembly, contract manufacturer, electronics</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('expansion-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const resultsDiv = document.getElementById('expansion-results');
    const keywordsList = document.getElementById('keywords-list');
    
    try {
        const response = await fetch('{{ path('app_webcrawler_keyword_expansion') }}', {
            method: 'POST',
            body: formData
        });
        
        const data = await response.json();
        
        if (data.success) {
            resultsDiv.classList.remove('hidden');
            keywordsList.innerHTML = data.keywords.map(kw => 
                `<span class="rams-keyword-tag">${kw}</span>`
            ).join('');
            
            // Store keywords for copying
            window.expandedKeywords = data.keywords;
        }
    } catch (error) {
        alert('{{ 'common.error'|trans }}: ' + error.message);
    }
});

document.getElementById('copy-keywords').addEventListener('click', function() {
    if (window.expandedKeywords) {
        const text = window.expandedKeywords.join(', ');
        navigator.clipboard.writeText(text).then(() => {
            this.textContent = '✓ {{ 'common.copied'|trans|default('Copied!') }}';
            setTimeout(() => this.textContent = '{{ 'webcrawler.copy_all_keywords'|trans|default('Copy All Keywords') }}', 2000);
        });
    }
});
</script>
{% endblock %}
