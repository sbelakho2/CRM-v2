{% extends 'base.html.twig' %}

{% block title %}{{ 'webcrawler.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-module">
    <div class="rams-module__header">
        <div class="rams-module__header-content">
            <h1 class="rams-module__title">{{ 'webcrawler.title'|trans }}</h1>
            <p class="rams-module__subtitle">{{ 'webcrawler.subtitle'|trans|default('Discover companies using Google Dorks and LinkedIn search') }}</p>
        </div>
    </div>

    <div class="rams-module__content">
        <!-- Stats -->
        <div class="rams-metrics-grid rams-metrics-grid--3">
            <div class="rams-metric">
                <span class="rams-metric__label">{{ 'lead.total_leads'|trans }}</span>
                <span class="rams-metric__value">{{ stats.total_leads }}</span>
            </div>
            <div class="rams-metric rams-metric--warning">
                <span class="rams-metric__label">{{ 'lead.pending_review'|trans }}</span>
                <span class="rams-metric__value">{{ stats.pending }}</span>
            </div>
            <div class="rams-metric rams-metric--success">
                <span class="rams-metric__label">{{ 'lead.approved_leads'|trans }}</span>
                <span class="rams-metric__value">{{ stats.approved }}</span>
            </div>
        </div>

        <!-- Discovery Form -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.start_discovery'|trans|default('Start New Discovery') }}</h2>
            </div>
            
            <div class="rams-module__content">
                <form id="discovery-form" class="rams-form">
                    <div class="rams-form__row rams-form__row--2">
                        <div class="rams-form__group">
                            <label class="rams-form__label">{{ 'company.sector'|trans }} *</label>
                            <select name="sector" required class="rams-form__select">
                                <option value="">{{ 'common.select'|trans }}...</option>
                                {% for sector in sectors %}
                                    <option value="{{ sector }}">{{ sector }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <div class="rams-form__group">
                            <label class="rams-form__label">{{ 'company.region'|trans }}</label>
                            <select name="location" class="rams-form__select">
                                <option value="">{{ 'webcrawler.all_locations'|trans|default('All locations') }}</option>
                                {% for code, name in locations %}
                                    <option value="{{ code }}">{{ name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'webcrawler.additional_keywords'|trans|default('Additional Keywords') }} ({{ 'webcrawler.comma_separated'|trans|default('comma-separated') }})</label>
                        <input type="text" name="keywords" placeholder="{{ 'webcrawler.keywords_placeholder'|trans|default('e.g., tier 1, supplier, PCBA') }}" class="rams-form__input">
                    </div>

                    <div class="rams-form__actions">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            {{ 'webcrawler.start_discovery'|trans|default('Start Discovery') }}
                        </button>
                        <a href="{{ path('app_webcrawler_keyword_expansion') }}" class="rams-btn rams-btn--secondary">{{ 'webcrawler.keyword_expansion'|trans }}</a>
                        <a href="{{ path('app_webcrawler_dork_generator') }}" class="rams-btn rams-btn--secondary">{{ 'webcrawler.dork_generator'|trans }}</a>
                    </div>
                </form>

                <!-- Results -->
                <div id="discovery-results" class="rams-results rams-hidden">
                    <h3 class="rams-results__title">{{ 'webcrawler.results'|trans }}</h3>
                    <div id="results-content"></div>
                </div>

                <!-- Loading -->
                <div id="discovery-loading" class="rams-loading rams-hidden">
                    <div class="rams-loading__spinner"></div>
                    <p class="rams-loading__message">{{ 'webcrawler.discovering'|trans|default('Discovering companies... This may take a few minutes.') }}</p>
                </div>
            </div>
        </div>

        <!-- Recent Discoveries -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.recent_discoveries'|trans|default('Recent Discoveries') }}</h2>
            </div>
            
            <div class="rams-module__content">
                {% if recent_leads|length > 0 %}
                    <table class="rams-table">
                        <thead class="rams-table__header">
                            <tr>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.company_name'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.website'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.region'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'lead.score'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'webcrawler.discovered'|trans|default('Discovered') }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for lead in recent_leads %}
                                <tr class="rams-table__row">
                                    <td class="rams-table__cell rams-table__cell--strong">{{ lead.companyName }}</td>
                                    <td class="rams-table__cell">
                                        {% if lead.websiteRoot %}
                                            <a href="{{ lead.websiteRoot }}" target="_blank" class="rams-link rams-link--external">
                                                {{ lead.websiteRoot|replace({'https://': '', 'http://': '', 'www.': ''}) }}
                                            </a>
                                        {% else %}
                                            <span class="rams-table__cell--muted">{{ 'common.n_a'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="rams-table__cell">{{ region_labels[lead.regionTag]|default(lead.regionTag ?? 'common.unknown'|trans) }}</td>
                                    <td class="rams-table__cell">
                                        <span class="rams-badge rams-badge--score rams-badge--score-{{ lead.leadScore >= 80 ? 'high' : (lead.leadScore >= 60 ? 'medium' : 'low') }}">
                                            {{ lead.leadScore }}
                                        </span>
                                    </td>
                                    <td class="rams-table__cell">
                                        <span class="rams-andon rams-andon--{{ lead.reviewStatus == 'approved' ? 'success' : (lead.reviewStatus == 'pending' ? 'warning' : 'danger') }}">
                                            {{ ('lead.statuses.' ~ lead.reviewStatus)|trans|upper }}
                                        </span>
                                    </td>
                                    <td class="rams-table__cell rams-table__cell--muted">{{ lead.createdAt|date('M d, Y') }}</td>
                                    <td class="rams-table__cell">
                                        <a href="{{ path('app_lead_review') }}?id={{ lead.id }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'lead.review'|trans }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="rams-empty-state">
                        <p class="rams-empty-state__message">{{ 'webcrawler.no_discoveries'|trans|default('No discoveries yet. Start a new discovery above.') }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('discovery-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const resultsDiv = document.getElementById('discovery-results');
    const loadingDiv = document.getElementById('discovery-loading');
    const resultsContent = document.getElementById('results-content');
    
    // Show loading
    resultsDiv.classList.add('rams-hidden');
    loadingDiv.classList.remove('rams-hidden');
    
    try {
        const response = await fetch('{{ path('app_webcrawler_discover') }}', {
            method: 'POST',
            body: formData
        });
        
        const data = await response.json();
        
        // Hide loading
        loadingDiv.classList.add('rams-hidden');
        
        if (data.success) {
            // Show results
            resultsDiv.classList.remove('rams-hidden');
            resultsContent.innerHTML = `
                <div class="rams-alert rams-alert--success">
                    <p class="rams-alert__title">${data.message}</p>
                    <p class="rams-alert__message">{{ 'webcrawler.found_companies'|trans|default('Found') }} ${data.discovered} {{ 'company.title'|trans|lower }}</p>
                </div>
                ${data.companies.length > 0 ? `
                    <div class="rams-discovery-list">
                        ${data.companies.slice(0, 10).map(c => `
                            <div class="rams-discovery-item">
                                <div class="rams-discovery-item__name">${c.name}</div>
                                ${c.website ? `<div class="rams-discovery-item__website">${c.website}</div>` : ''}
                                ${c.linkedin ? `<a href="${c.linkedin}" target="_blank" class="rams-link rams-link--external">LinkedIn</a>` : ''}
                            </div>
                        `).join('')}
                    </div>
                ` : ''}
            `;
        } else {
            resultsDiv.classList.remove('rams-hidden');
            resultsContent.innerHTML = `
                <div class="rams-alert rams-alert--danger">
                    <p class="rams-alert__title">{{ 'common.error'|trans }}</p>
                    <p class="rams-alert__message">${data.error}</p>
                </div>
            `;
        }
    } catch (error) {
        loadingDiv.classList.add('rams-hidden');
        resultsDiv.classList.remove('rams-hidden');
        resultsContent.innerHTML = `
            <div class="rams-alert rams-alert--danger">
                <p class="rams-alert__title">{{ 'common.error'|trans }}</p>
                <p class="rams-alert__message">{{ 'webcrawler.discovery_failed'|trans|default('Failed to start discovery:') }} ${error.message}</p>
            </div>
        `;
    }
});
</script>
{% endblock %}
