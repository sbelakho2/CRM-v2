{% extends 'base.html.twig' %}

{% block title %}{{ 'webcrawler.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'webcrawler.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'webcrawler.subtitle'|trans }}</p>
        </div>
    </div>

    {# Stats #}
    <div class="rams-grid rams-grid--3">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'webcrawler.stats.discovered'|trans }}</span>
                    <span class="rams-metric__value">{{ stats.discovered }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'webcrawler.stats.approved'|trans }}</span>
                    <span class="rams-metric__value rams-text--warning">{{ stats.approved }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'webcrawler.stats.active'|trans }}</span>
                    <span class="rams-metric__value rams-text--success">{{ stats.active }}</span>
                </div>
            </div>
        </div>
    </div>

    {# Discovery Form #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'webcrawler.start_discovery'|trans }}</h2>
        </div>
        
        <div class="rams-module__content">
            <form id="discovery-form" class="rams-form">
                <div class="rams-grid rams-grid--2">
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'company.sector'|trans }}</label>
                        <select name="sector" class="rams-form__select">
                            <option value="">{{ 'common.select'|trans }}...</option>
                            {% for sector in sectors %}
                                <option value="{{ sector }}">{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'company.region'|trans }}</label>
                        <select name="location" class="rams-form__select">
                            <option value="">{{ 'webcrawler.all_locations'|trans }}</option>
                            {% for code, name in locations %}
                                <option value="{{ code }}">{{ name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'webcrawler.additional_keywords'|trans }} ({{ 'webcrawler.comma_separated'|trans }})</label>
                    <input type="text" name="keywords" placeholder="{{ 'webcrawler.keywords_placeholder'|trans }}" class="rams-form__input">
                </div>

                <div class="rams-form__actions">
                    <button type="submit" id="btn-start" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        {{ 'webcrawler.start_discovery'|trans }}
                    </button>
                    <button type="button" id="btn-stop" class="rams-btn rams-btn--danger rams-hidden" onclick="stopDiscovery()">
                        Stop Discovery
                    </button>
                    <a href="{{ path('app_webcrawler_keyword_expansion') }}" class="rams-btn">{{ 'webcrawler.keyword_expansion'|trans }}</a>
                    <a href="{{ path('app_webcrawler_dork_generator') }}" class="rams-btn">{{ 'webcrawler.dork_generator'|trans }}</a>
                </div>
            </form>

            {# Live Status Panel #}
            <div id="discovery-status" class="rams-hidden rams-mt-6">
                <div style="background: var(--rams-bg-alt, #f8fafc); border: 1px solid var(--rams-border, #e2e8f0); border-radius: 0.5rem; padding: 1rem;">
                    <div class="rams-flex" style="justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                        <div class="rams-flex" style="align-items: center; gap: 0.5rem;">
                            <span id="status-indicator" class="rams-andon__light rams-andon__light--yellow rams-pulse" style="width: 12px; height: 12px;"></span>
                            <strong id="status-label">Discovery Running</strong>
                        </div>
                        <span id="status-time" style="font-size: 0.8rem; color: var(--rams-text-muted, #64748b);"></span>
                    </div>
                    <div class="rams-grid rams-grid--3" style="gap: 0.75rem; font-size: 0.85rem;">
                        <div><span style="color: var(--rams-text-muted);">Searches:</span> <strong id="stat-searches">0</strong></div>
                        <div><span style="color: var(--rams-text-muted);">BEG Pass:</span> <strong id="stat-beg-pass">0</strong></div>
                        <div><span style="color: var(--rams-text-muted);">BEG Fail:</span> <strong id="stat-beg-fail">0</strong></div>
                        <div><span style="color: var(--rams-text-muted);">BEG Rescue:</span> <strong id="stat-beg-rescue">0</strong></div>
                        <div><span style="color: var(--rams-text-muted);">Loc Reject:</span> <strong id="stat-loc-reject">0</strong></div>
                        <div><span style="color: var(--rams-text-muted);">Loc Rescue:</span> <strong id="stat-loc-rescue">0</strong></div>
                        <div><span style="color: var(--rams-text-muted);">Saved:</span> <strong id="stat-saved">0</strong></div>
                        <div><span style="color: var(--rams-text-muted);">Log Lines:</span> <strong id="stat-lines">0</strong></div>
                        <div><span style="color: var(--rams-text-muted);">Total Discovered:</span> <strong id="stat-total">{{ stats.discovered }}</strong></div>
                    </div>
                </div>
            </div>

            {# Results #}
            <div id="discovery-results" class="rams-hidden rams-mt-6">
                <h3 class="rams-dymo rams-mb-3">{{ 'webcrawler.results'|trans }}</h3>
                <div id="results-content"></div>
            </div>
        </div>
    </div>

    {# Recent Discoveries #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'webcrawler.recent_discoveries'|trans }}</h2>
        </div>
        
        <div class="rams-module__content rams-module__content--flush">
            {% if recent_companies|length > 0 %}
                <div class="rams-table-container">
                    <table class="rams-table">
                        <thead class="rams-table__header">
                            <tr>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.company_name'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.website'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.region'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'lead.score'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'webcrawler.discovered'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody class="rams-table__body">
                            {% for company in recent_companies %}
                                <tr class="rams-table__row">
                                    <td class="rams-table__cell rams-text--bold">{{ company.name }}</td>
                                    <td class="rams-table__cell">
                                        {% if company.website %}
                                            <a href="{{ company.website }}" target="_blank" class="rams-link rams-text--xs">
                                                {{ company.website|replace({'https://': '', 'http://': '', 'www.': ''}) }}
                                            </a>
                                        {% else %}
                                            <span class="rams-text--muted rams-text--xs">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="rams-table__cell rams-text--xs">{{ region_labels[company.region]|default(company.region ?? 'common.unknown'|trans) }}</td>
                                    <td class="rams-table__cell">
                                        <span class="rams-badge rams-badge--info">{{ 'webcrawler.status.pending_review'|trans }}</span>
                                    </td>
                                    <td class="rams-table__cell">
                                        {% if company.companyStatus == 'discovered' %}
                                            <span class="rams-badge rams-badge--warning">{{ 'webcrawler.status.discovered'|trans }}</span>
                                        {% elseif company.companyStatus == 'approved' %}
                                            <span class="rams-badge rams-badge--info">{{ 'webcrawler.status.approved'|trans }}</span>
                                        {% elseif company.companyStatus == 'active' %}
                                            <span class="rams-badge rams-badge--success">{{ 'webcrawler.status.active'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="rams-table__cell rams-text--muted rams-text--xs">{{ company.createdAt|date('M d, Y') }}</td>
                                    <td class="rams-table__cell rams-table__cell--actions">
                                        {% if company.companyStatus == 'discovered' %}
                                            <form method="post" action="{{ path('app_company_approve', {id: company.id}) }}" style="display:inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ company.id) }}">
                                                <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.approve'|trans }}</button>
                                            </form>
                                            <form method="post" action="{{ path('app_company_delete', {id: company.id}) }}" style="display:inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ company.id) }}">
                                                <input type="hidden" name="_redirect" value="discovered">
                                                <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.delete'|trans }}</button>
                                            </form>
                                        {% else %}
                                            <a href="{{ path('app_company_show', {id: company.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }}</a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="rams-empty-state">
                    <h3 class="rams-empty-state__title">{{ 'webcrawler.no_discoveries'|trans }}</h3>
                </div>
            {% endif %}
        </div>
    </div>
</div>
<script>
let pollTimer = null;

// On page load, check if a discovery is already running
checkStatus();

document.getElementById('discovery-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const btnStart = document.getElementById('btn-start');
    const btnStop = document.getElementById('btn-stop');
    const statusDiv = document.getElementById('discovery-status');
    const resultsDiv = document.getElementById('discovery-results');

    btnStart.disabled = true;
    btnStart.textContent = 'Starting...';
    resultsDiv.classList.add('rams-hidden');

    try {
        const response = await fetch('{{ path('app_webcrawler_discover') }}', {
            method: 'POST',
            body: formData
        });

        // Check if response is JSON (session might have expired)
        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
            if (response.redirected || response.url.includes('/login')) {
                showError('Session expired. Please <a href="/login" class="rams-link">log in again</a>.');
            } else {
                showError('Server returned an invalid response. Please refresh the page.');
            }
            btnStart.disabled = false;
            btnStart.textContent = '{{ 'webcrawler.start_discovery'|trans }}';
            return;
        }

        const data = await response.json();
        
        if (data.success && data.async) {
            // Show live status panel
            statusDiv.classList.remove('rams-hidden');
            btnStop.classList.remove('rams-hidden');
            btnStart.classList.add('rams-hidden');
            
            document.getElementById('status-label').textContent = 
                data.status === 'already_running' ? 'Discovery Already Running' : 'Discovery Started';
            
            // Start polling
            startPolling();
        } else if (!data.success) {
            showError(data.error || 'Failed to start discovery');
            btnStart.disabled = false;
            btnStart.textContent = '{{ 'webcrawler.start_discovery'|trans }}';
        }
    } catch (error) {
        showError('Failed to start discovery: ' + error.message);
        btnStart.disabled = false;
        btnStart.textContent = '{{ 'webcrawler.start_discovery'|trans }}';
    }
});

function startPolling() {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = setInterval(checkStatus, 5000);
}

async function checkStatus() {
    try {
        const response = await fetch('{{ path('app_webcrawler_discover_status') }}');
        
        // Check if response is JSON (session might have expired)
        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
            // Session expired - stop polling silently
            if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
            return;
        }
        
        const data = await response.json();

        const statusDiv = document.getElementById('discovery-status');
        const btnStart = document.getElementById('btn-start');
        const btnStop = document.getElementById('btn-stop');

        if (data.running) {
            statusDiv.classList.remove('rams-hidden');
            btnStop.classList.remove('rams-hidden');
            btnStart.classList.add('rams-hidden');
            
            document.getElementById('status-label').textContent = 'Discovery Running' + 
                (data.sector ? ` — ${data.sector}` : '') +
                (data.location ? ` (${data.location})` : '');
            document.getElementById('status-indicator').className = 'rams-andon__light rams-andon__light--yellow rams-pulse';
            
            if (data.started_at) {
                const started = new Date(data.started_at);
                const elapsed = Math.round((Date.now() - started.getTime()) / 60000);
                document.getElementById('status-time').textContent = `Running ${elapsed} min`;
            }

            // Update stats
            const s = data.stats || {};
            document.getElementById('stat-searches').textContent = s.searches || 0;
            document.getElementById('stat-beg-pass').textContent = s.beg_pass || 0;
            document.getElementById('stat-beg-fail').textContent = s.beg_fail || 0;
            document.getElementById('stat-beg-rescue').textContent = s.beg_rescue || 0;
            document.getElementById('stat-loc-reject').textContent = s.location_reject || 0;
            document.getElementById('stat-loc-rescue').textContent = s.location_rescue || 0;
            document.getElementById('stat-saved').textContent = s.saved || 0;
            document.getElementById('stat-lines').textContent = s.log_lines || 0;
            document.getElementById('stat-total').textContent = data.discovered_total || 0;

            if (!pollTimer) startPolling();
        } else if (statusDiv && !statusDiv.classList.contains('rams-hidden')) {
            // Was running, now finished
            document.getElementById('status-label').textContent = 'Discovery Completed';
            document.getElementById('status-indicator').className = 'rams-andon__light rams-andon__light--green';
            document.getElementById('status-time').textContent = 'Finished';
            
            btnStop.classList.add('rams-hidden');
            btnStart.classList.remove('rams-hidden');
            btnStart.disabled = false;
            btnStart.textContent = '{{ 'webcrawler.start_discovery'|trans }}';

            if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }

            // Show completion message
            const resultsDiv = document.getElementById('discovery-results');
            const resultsContent = document.getElementById('results-content');
            resultsDiv.classList.remove('rams-hidden');
            const saved = (data.stats || {}).saved || 0;
            resultsContent.innerHTML = `
                <div class="rams-alert rams-alert--success">
                    <p class="rams-alert__title">Discovery Complete</p>
                    <p class="rams-alert__message">${saved} companies saved. Total discovered: ${data.discovered_total || 0}.</p>
                    <p class="rams-alert__message"><a class="rams-link" href="{{ path('app_company_discovered') }}">Review discovered companies</a></p>
                </div>`;
        } else {
            // Nothing running, reset UI
            btnStop.classList.add('rams-hidden');
            btnStart.classList.remove('rams-hidden');
            btnStart.disabled = false;
            btnStart.textContent = '{{ 'webcrawler.start_discovery'|trans }}';
            if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
        }
    } catch (e) {
        // Silently ignore polling errors
    }
}

async function stopDiscovery() {
    if (!confirm('Stop the running discovery?')) return;
    try {
        await fetch('{{ path('app_webcrawler_discover_stop') }}', { method: 'POST' });
        document.getElementById('status-label').textContent = 'Discovery Stopped';
        document.getElementById('status-indicator').className = 'rams-andon__light rams-andon__light--red';
        document.getElementById('btn-stop').classList.add('rams-hidden');
        document.getElementById('btn-start').classList.remove('rams-hidden');
        document.getElementById('btn-start').disabled = false;
        document.getElementById('btn-start').textContent = '{{ 'webcrawler.start_discovery'|trans }}';
        if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    } catch (e) {
        alert('Failed to stop: ' + e.message);
    }
}

function showError(message) {
    const resultsDiv = document.getElementById('discovery-results');
    const resultsContent = document.getElementById('results-content');
    resultsDiv.classList.remove('rams-hidden');
    resultsContent.innerHTML = `
        <div class="rams-alert rams-alert--danger">
            <p class="rams-alert__title">{{ 'common.error'|trans }}</p>
            <p class="rams-alert__message">${message}</p>
        </div>`;
}
</script>
{% endblock %}
