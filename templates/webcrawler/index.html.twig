{% extends 'base.html.twig' %}

{% block title %}{{ 'webcrawler.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'webcrawler.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'webcrawler.subtitle'|trans }}</p>
        </div>
    </div>

    {# Stats #}
    <div class="rams-grid rams-grid--3">
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'lead.total_leads'|trans }}</span>
                    <span class="rams-metric__value">{{ stats.total_leads }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'lead.pending_review'|trans }}</span>
                    <span class="rams-metric__value rams-text--warning">{{ stats.pending }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <div class="rams-metric">
                    <span class="rams-metric__label">{{ 'lead.approved_leads'|trans }}</span>
                    <span class="rams-metric__value rams-text--success">{{ stats.approved }}</span>
                </div>
            </div>
        </div>
    </div>

    {# Discovery Form #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'webcrawler.start_discovery'|trans }}</h2>
        </div>
        
        <div class="rams-module__content">
            <form id="discovery-form" class="rams-form">
                <div class="rams-grid rams-grid--2">
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'company.sector'|trans }} *</label>
                        <select name="sector" required class="rams-form__select">
                            <option value="">{{ 'common.select'|trans }}...</option>
                            {% for sector in sectors %}
                                <option value="{{ sector }}">{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <div class="rams-form__group">
                        <label class="rams-form__label rams-dymo">{{ 'company.region'|trans }}</label>
                        <select name="location" class="rams-form__select">
                            <option value="">{{ 'webcrawler.all_locations'|trans }}</option>
                            {% for code, name in locations %}
                                <option value="{{ code }}">{{ name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'webcrawler.additional_keywords'|trans }} ({{ 'webcrawler.comma_separated'|trans }})</label>
                    <input type="text" name="keywords" placeholder="{{ 'webcrawler.keywords_placeholder'|trans }}" class="rams-form__input">
                </div>

                <div class="rams-form__actions">
                    <button type="submit" class="rams-btn rams-btn--primary">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        {{ 'webcrawler.start_discovery'|trans }}
                    </button>
                    <a href="{{ path('app_webcrawler_keyword_expansion') }}" class="rams-btn">{{ 'webcrawler.keyword_expansion'|trans }}</a>
                    <a href="{{ path('app_webcrawler_dork_generator') }}" class="rams-btn">{{ 'webcrawler.dork_generator'|trans }}</a>
                </div>
            </form>

            {# Results #}
            <div id="discovery-results" class="rams-hidden rams-mt-6">
                <h3 class="rams-dymo rams-mb-3">{{ 'webcrawler.results'|trans }}</h3>
                <div id="results-content"></div>
            </div>

            {# Loading #}
            <div id="discovery-loading" class="rams-hidden rams-mt-6">
                <div class="rams-flex rams-flex-col rams-items-center rams-p-8">
                    <div class="rams-andon">
                        <span class="rams-andon__light rams-andon__light--yellow rams-pulse"></span>
                    </div>
                    <p class="rams-mt-2 rams-text--muted">{{ 'webcrawler.discovering'|trans }}</p>
                </div>
            </div>
        </div>
    </div>

    {# Recent Discoveries #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'webcrawler.recent_discoveries'|trans }}</h2>
        </div>
        
        <div class="rams-module__content rams-module__content--flush">
            {% if recent_leads|length > 0 %}
                <div class="rams-table-container">
                    <table class="rams-table">
                        <thead class="rams-table__header">
                            <tr>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.company_name'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.website'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'company.region'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'lead.score'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header">{{ 'webcrawler.discovered'|trans }}</th>
                                <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody class="rams-table__body">
                            {% for lead in recent_leads %}
                                <tr class="rams-table__row">
                                    <td class="rams-table__cell rams-text--bold">{{ lead.companyName }}</td>
                                    <td class="rams-table__cell">
                                        {% if lead.websiteRoot %}
                                            <a href="{{ lead.websiteRoot }}" target="_blank" class="rams-link rams-text--xs">
                                                {{ lead.websiteRoot|replace({'https://': '', 'http://': '', 'www.': ''}) }}
                                            </a>
                                        {% else %}
                                            <span class="rams-text--muted rams-text--xs">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="rams-table__cell rams-text--xs">{{ region_labels[lead.regionTag]|default(lead.regionTag ?? 'common.unknown'|trans) }}</td>
                                    <td class="rams-table__cell">
                                        <span class="rams-badge {% if lead.leadScore >= 80 %}rams-badge--success{% elseif lead.leadScore >= 60 %}rams-badge--warning{% else %}rams-badge--info{% endif %}">
                                            {{ lead.leadScore }}
                                        </span>
                                    </td>
                                    <td class="rams-table__cell">
                                        <div class="rams-andon">
                                            <span class="rams-andon__light rams-andon__light--{{ lead.reviewStatus == 'approved' ? 'green' : (lead.reviewStatus == 'pending' ? 'yellow' : 'red') }}"></span>
                                            <span class="rams-andon__text">{{ ('lead.statuses.' ~ lead.reviewStatus)|trans }}</span>
                                        </div>
                                    </td>
                                    <td class="rams-table__cell rams-text--muted rams-text--xs">{{ lead.createdAt|date('M d, Y') }}</td>
                                    <td class="rams-table__cell rams-table__cell--actions">
                                        <a href="{{ path('app_lead_review') }}?id={{ lead.id }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'lead.review'|trans }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="rams-empty-state">
                    <h3 class="rams-empty-state__title">{{ 'webcrawler.no_discoveries'|trans }}</h3>
                </div>
            {% endif %}
        </div>
    </div>
</div>
<script>
document.getElementById('discovery-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const resultsDiv = document.getElementById('discovery-results');
    const loadingDiv = document.getElementById('discovery-loading');
    const resultsContent = document.getElementById('results-content');
    
    // Show loading
    resultsDiv.classList.add('rams-hidden');
    loadingDiv.classList.remove('rams-hidden');
    
    try {
        const response = await fetch('{{ path('app_webcrawler_discover') }}', {
            method: 'POST',
            body: formData
        });
        
        const data = await response.json();
        
        // Hide loading
        loadingDiv.classList.add('rams-hidden');
        
        if (data.success) {
            // Show results
            resultsDiv.classList.remove('rams-hidden');
            resultsContent.innerHTML = `
                <div class="rams-alert rams-alert--success">
                    <p class="rams-alert__title">${data.message}</p>
                    <p class="rams-alert__message">{{ 'webcrawler.found_companies'|trans }} ${data.discovered} {{ 'company.title'|trans|lower }}</p>
                </div>
                ${data.companies.length > 0 ? `
                    <div class="rams-discovery-list">
                        ${data.companies.map(c => `
                            <div class="rams-discovery-item" style="padding: 0.75rem; border-bottom: 1px solid var(--rams-border, #e2e8f0); display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <div class="rams-discovery-item__name" style="font-weight: 600;">
                                        <a href="/companies/${c.id}" style="color: var(--rams-primary, #2563eb); text-decoration: none;">${c.name}</a>
                                        ${c.sector ? `<span style="font-size: 0.75rem; background: var(--rams-bg-alt, #f1f5f9); padding: 0.125rem 0.5rem; border-radius: 9999px; margin-left: 0.5rem;">${c.sector}</span>` : ''}
                                    </div>
                                    ${c.website ? `<div class="rams-discovery-item__website" style="font-size: 0.85rem; color: var(--rams-text-muted, #64748b);"><a href="${c.website}" target="_blank" rel="noopener">${c.website}</a></div>` : ''}
                                    <div style="font-size: 0.8rem; color: var(--rams-text-muted, #64748b); margin-top: 0.25rem;">
                                        ${c.country ? `📍 ${c.city ? c.city + ', ' : ''}${c.country}` : ''}
                                        ${c.linkedin_url ? ` · <a href="${c.linkedin_url}" target="_blank" rel="noopener" style="color: #0077b5;">🔗 LinkedIn</a>` : ''}
                                        ${c.physical_site ? ` · 🏭 ${c.physical_site}` : ''}
                                    </div>
                                </div>
                                <div style="text-align: right; font-size: 0.8rem; color: var(--rams-text-muted, #64748b);">
                                    ${c.account_tier ? `Tier ${c.account_tier}` : ''}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                ` : ''}
            `;
        } else {
            resultsDiv.classList.remove('rams-hidden');
            resultsContent.innerHTML = `
                <div class="rams-alert rams-alert--danger">
                    <p class="rams-alert__title">{{ 'common.error'|trans }}</p>
                    <p class="rams-alert__message">${data.error}</p>
                </div>
            `;
        }
    } catch (error) {
        loadingDiv.classList.add('rams-hidden');
        resultsDiv.classList.remove('rams-hidden');
        resultsContent.innerHTML = `
            <div class="rams-alert rams-alert--danger">
                <p class="rams-alert__title">{{ 'common.error'|trans }}</p>
                <p class="rams-alert__message">{{ 'webcrawler.discovery_failed'|trans }} ${error.message}</p>
            </div>
        `;
    }
});
</script>
{% endblock %}
