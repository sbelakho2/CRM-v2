{% extends 'base.html.twig' %}

{% block title %}{{ 'webcrawler.dork_generator'|trans }}{% endblock %}

{% block body %}
<div class="rams-module">
    <div class="rams-module__header">
        <div class="rams-breadcrumb">
            <a href="{{ path('app_webcrawler_index') }}" class="rams-breadcrumb__link">{{ 'webcrawler.title'|trans }}</a>
            <span class="rams-breadcrumb__separator">/</span>
            <span class="rams-breadcrumb__current">{{ 'webcrawler.dork_generator'|trans }}</span>
        </div>
        
        <div class="rams-module__header-content">
            <h1 class="rams-module__title">{{ 'webcrawler.dork_generator'|trans }}</h1>
            <p class="rams-module__subtitle">{{ 'webcrawler.dork_generator_subtitle'|trans }}</p>
        </div>
    </div>

    <div class="rams-module__content">
        <!-- Quick Generator -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.quick_generator'|trans }}</h2>
            </div>
            
            <div class="rams-module__content">
                <div class="rams-form__row rams-form__row--2">
                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'webcrawler.company_domain'|trans }}</label>
                        <input type="text" id="domain-input" placeholder="{{ 'webcrawler.domain_placeholder'|trans }}" class="rams-form__input">
                    </div>
                    
                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'company.sector'|trans }}</label>
                        <select id="sector-input" class="rams-form__select">
                            <option value="">{{ 'common.select'|trans }}...</option>
                            {% for sector in sectors %}
                                <option value="{{ sector }}">{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div id="generated-dorks" class="rams-dork-list"></div>
            </div>
        </div>

        <!-- Dork Templates -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.dork_templates'|trans }}</h2>
            </div>
            
            <div class="rams-module__content">
                {% for category, templates in dork_templates %}
                    <div class="rams-template-group">
                        <h3 class="rams-template-group__title">{{ category }}</h3>
                        <div class="rams-template-list">
                            {% for template in templates %}
                                <div class="rams-template-item">
                                    <code class="rams-template-item__code">{{ template }}</code>
                                    <button onclick="copyDork('{{ template|escape('js') }}')" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.copy'|trans }}</button>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Advanced Tips -->
        <div class="rams-alert rams-alert--info">
            <h3 class="rams-alert__title">{{ 'webcrawler.dork_tips_title'|trans }}</h3>
            <ul class="rams-alert__list">
                <li>• <code>{{ 'webcrawler.tip_code_site'|trans }}</code> - {{ 'webcrawler.tip_site'|trans }}</li>
                <li>• <code>{{ 'webcrawler.tip_code_inurl'|trans }}</code> - {{ 'webcrawler.tip_inurl'|trans }}</li>
                <li>• <code>{{ 'webcrawler.tip_code_intitle'|trans }}</code> - {{ 'webcrawler.tip_intitle'|trans }}</li>
                <li>• <code>"{{ 'webcrawler.tip_exact_example'|trans }}"</code> - {{ 'webcrawler.tip_exact'|trans }}</li>
                <li>• <code>{{ 'webcrawler.tip_or_example'|trans }}</code> - {{ 'webcrawler.tip_or'|trans }}</li>
                <li>• <code>{{ 'webcrawler.tip_code_exclude'|trans }}</code> - {{ 'webcrawler.tip_exclude'|trans }}</li>
                <li>• <code>{{ 'webcrawler.tip_code_filetype_pdf'|trans }}</code> - {{ 'webcrawler.tip_filetype'|trans }}</li>
            </ul>
        </div>

        <!-- Example Searches -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.example_searches'|trans }}</h2>
            </div>
            
            <div class="rams-module__content">
                <div class="rams-example-list">
                    <div class="rams-example-item">
                        <div class="rams-example-item__label">{{ 'webcrawler.example_automotive'|trans }}</div>
                        <code class="rams-example-item__code">
                            {{ 'webcrawler.example_query_automotive'|trans }}
                        </code>
                    </div>
                    
                    <div class="rams-example-item">
                        <div class="rams-example-item__label">{{ 'webcrawler.example_supplier_portals'|trans }}</div>
                        <code class="rams-example-item__code">
                            {{ 'webcrawler.example_query_supplier_portals'|trans }}
                        </code>
                    </div>
                    
                    <div class="rams-example-item">
                        <div class="rams-example-item__label">{{ 'webcrawler.example_aerospace'|trans }}</div>
                        <code class="rams-example-item__code">
                            {{ 'webcrawler.example_query_aerospace'|trans }}
                        </code>
                    </div>
                    
                    <div class="rams-example-item">
                        <div class="rams-example-item__label">{{ 'webcrawler.example_electronics'|trans }}</div>
                        <code class="rams-example-item__code">
                            {{ 'webcrawler.example_query_electronics'|trans }}
                        </code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function copyDork(template) {
    navigator.clipboard.writeText(template).then(() => {
        // Show temporary feedback
        event.target.textContent = '✓ {{ 'common.copied'|trans }}';
        setTimeout(() => event.target.textContent = '{{ 'common.copy'|trans }}', 2000);
    });
}

// Generate dorks on input
const domainInput = document.getElementById('domain-input');
const sectorInput = document.getElementById('sector-input');
const generatedDorks = document.getElementById('generated-dorks');

function generateDorks() {
    const domain = domainInput.value.trim();
    const sector = sectorInput.value;
    const dorkTemplates = {
        domainSupplierPortal: "{{ 'webcrawler.dork_domain_supplier_portal'|trans|e('js') }}",
        domainVendorRegistration: "{{ 'webcrawler.dork_domain_vendor_registration'|trans|e('js') }}",
        domainContactProcurement: "{{ 'webcrawler.dork_domain_contact_procurement'|trans|e('js') }}",
        domainLinkedin: "{{ 'webcrawler.dork_domain_linkedin'|trans|e('js') }}",
        sectorSupplierManufacturer: "{{ 'webcrawler.dork_sector_supplier_manufacturer'|trans|e('js') }}",
        sectorFreeZoneSupplier: "{{ 'webcrawler.dork_sector_free_zone_supplier'|trans|e('js') }}",
        domainSectorContact: "{{ 'webcrawler.dork_domain_sector_contact'|trans|e('js') }}"
    };
    const tokenMap = {
        domain: ['%domain%', '%نطاق%'],
        sector: ['%sector%', '%قطاع%'],
        company: ['%company%', '%شركة%']
    };
    const replaceTokens = (template, tokens, value) => tokens.reduce((acc, token) => acc.split(token).join(value), template);
    
    if (!domain && !sector) {
        generatedDorks.innerHTML = '';
        return;
    }
    
    const dorks = [];
    
    if (domain) {
        const companyName = domain.replace('.com', '');
        dorks.push(replaceTokens(dorkTemplates.domainSupplierPortal, tokenMap.domain, domain));
        dorks.push(replaceTokens(dorkTemplates.domainVendorRegistration, tokenMap.domain, domain));
        dorks.push(replaceTokens(dorkTemplates.domainContactProcurement, tokenMap.domain, domain));
        dorks.push(replaceTokens(dorkTemplates.domainLinkedin, tokenMap.company, companyName));
    }
    
    if (sector) {
        dorks.push(replaceTokens(dorkTemplates.sectorSupplierManufacturer, tokenMap.sector, sector));
        dorks.push(replaceTokens(dorkTemplates.sectorFreeZoneSupplier, tokenMap.sector, sector));
    }
    
    if (domain && sector) {
        const domainReplaced = replaceTokens(dorkTemplates.domainSectorContact, tokenMap.domain, domain);
        dorks.push(replaceTokens(domainReplaced, tokenMap.sector, sector));
    }
    
    generatedDorks.innerHTML = dorks.map(dork => `
        <div class="rams-dork-item">
            <code class="rams-dork-item__code">${dork}</code>
            <div class="rams-dork-item__actions">
                <button onclick="copyDork('${dork.replace(/'/g, "\\'")}')" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.copy'|trans }}</button>
                <a href="https://www.google.com/search?q=${encodeURIComponent(dork)}" target="_blank" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.search'|trans }}</a>
            </div>
        </div>
    `).join('');
}

domainInput.addEventListener('input', generateDorks);
sectorInput.addEventListener('change', generateDorks);
</script>
{% endblock %}
