{% extends 'base.html.twig' %}

{% block title %}{{ 'webcrawler.dork_generator'|trans }}{% endblock %}

{% block body %}
<div class="rams-module">
    <div class="rams-module__header">
        <div class="rams-breadcrumb">
            <a href="{{ path('app_webcrawler_index') }}" class="rams-breadcrumb__link">{{ 'webcrawler.title'|trans }}</a>
            <span class="rams-breadcrumb__separator">/</span>
            <span class="rams-breadcrumb__current">{{ 'webcrawler.dork_generator'|trans }}</span>
        </div>
        
        <div class="rams-module__header-content">
            <h1 class="rams-module__title">{{ 'webcrawler.dork_generator'|trans }}</h1>
            <p class="rams-module__subtitle">{{ 'webcrawler.dork_generator_subtitle'|trans|default('Generate custom Google search queries for company discovery') }}</p>
        </div>
    </div>

    <div class="rams-module__content">
        <!-- Quick Generator -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.quick_generator'|trans|default('Quick Generator') }}</h2>
            </div>
            
            <div class="rams-module__content">
                <div class="rams-form__row rams-form__row--2">
                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'webcrawler.company_domain'|trans|default('Company/Domain') }}</label>
                        <input type="text" id="domain-input" placeholder="example.com" class="rams-form__input">
                    </div>
                    
                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'company.sector'|trans }}</label>
                        <select id="sector-input" class="rams-form__select">
                            <option value="">{{ 'common.select'|trans }}...</option>
                            {% for sector in sectors %}
                                <option value="{{ sector }}">{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div id="generated-dorks" class="rams-dork-list"></div>
            </div>
        </div>

        <!-- Dork Templates -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.dork_templates'|trans|default('Dork Templates') }}</h2>
            </div>
            
            <div class="rams-module__content">
                {% for category, templates in dork_templates %}
                    <div class="rams-template-group">
                        <h3 class="rams-template-group__title">{{ category }}</h3>
                        <div class="rams-template-list">
                            {% for template in templates %}
                                <div class="rams-template-item">
                                    <code class="rams-template-item__code">{{ template }}</code>
                                    <button onclick="copyDork('{{ template|escape('js') }}')" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.copy'|trans }}</button>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Advanced Tips -->
        <div class="rams-alert rams-alert--info">
            <h3 class="rams-alert__title">{{ 'webcrawler.dork_tips_title'|trans|default('Google Dork Tips') }}</h3>
            <ul class="rams-alert__list">
                <li>• <code>site:</code> - {{ 'webcrawler.tip_site'|trans|default('Search within a specific domain') }}</li>
                <li>• <code>inurl:</code> - {{ 'webcrawler.tip_inurl'|trans|default('Search for text in URL') }}</li>
                <li>• <code>intitle:</code> - {{ 'webcrawler.tip_intitle'|trans|default('Search for text in page title') }}</li>
                <li>• <code>"exact phrase"</code> - {{ 'webcrawler.tip_exact'|trans|default('Search for exact phrase match') }}</li>
                <li>• <code>OR</code> - {{ 'webcrawler.tip_or'|trans|default('Search for either term (must be uppercase)') }}</li>
                <li>• <code>-keyword</code> - {{ 'webcrawler.tip_exclude'|trans|default('Exclude results with keyword') }}</li>
                <li>• <code>filetype:pdf</code> - {{ 'webcrawler.tip_filetype'|trans|default('Search for specific file types') }}</li>
            </ul>
        </div>

        <!-- Example Searches -->
        <div class="rams-module rams-module--nested">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'webcrawler.example_searches'|trans|default('Example Searches') }}</h2>
            </div>
            
            <div class="rams-module__content">
                <div class="rams-example-list">
                    <div class="rams-example-item">
                        <div class="rams-example-item__label">{{ 'webcrawler.example_automotive'|trans|default('Find Automotive Suppliers in Morocco') }}</div>
                        <code class="rams-example-item__code">
                            "automotive" "morocco" ("tier 1" OR "tier 2" OR "supplier") -jobs -careers
                        </code>
                    </div>
                    
                    <div class="rams-example-item">
                        <div class="rams-example-item__label">{{ 'webcrawler.example_supplier_portals'|trans|default('Find Companies with Supplier Portals') }}</div>
                        <code class="rams-example-item__code">
                            site:*.ma inurl:supplier OR inurl:vendor "portal" OR "registration"
                        </code>
                    </div>
                    
                    <div class="rams-example-item">
                        <div class="rams-example-item__label">{{ 'webcrawler.example_aerospace'|trans|default('Find Aerospace Companies in Free Zones') }}</div>
                        <code class="rams-example-item__code">
                            "aerospace" ("tanger free zone" OR "atlantic free zone") manufacturer OR supplier
                        </code>
                    </div>
                    
                    <div class="rams-example-item">
                        <div class="rams-example-item__label">{{ 'webcrawler.example_electronics'|trans|default('Find Electronics Manufacturing Services') }}</div>
                        <code class="rams-example-item__code">
                            "morocco" ("EMS" OR "PCBA" OR "PCB assembly") contract manufacturer
                        </code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function copyDork(template) {
    navigator.clipboard.writeText(template).then(() => {
        // Show temporary feedback
        event.target.textContent = '✓ {{ 'common.copied'|trans|default('Copied') }}';
        setTimeout(() => event.target.textContent = '{{ 'common.copy'|trans }}', 2000);
    });
}

// Generate dorks on input
const domainInput = document.getElementById('domain-input');
const sectorInput = document.getElementById('sector-input');
const generatedDorks = document.getElementById('generated-dorks');

function generateDorks() {
    const domain = domainInput.value.trim();
    const sector = sectorInput.value;
    
    if (!domain && !sector) {
        generatedDorks.innerHTML = '';
        return;
    }
    
    const dorks = [];
    
    if (domain) {
        dorks.push(`site:${domain} "supplier portal"`);
        dorks.push(`site:${domain} "vendor registration"`);
        dorks.push(`site:${domain} contact procurement`);
        dorks.push(`site:linkedin.com/company "${domain.replace('.com', '')}"`);
    }
    
    if (sector) {
        dorks.push(`"${sector}" morocco supplier manufacturer`);
        dorks.push(`"${sector}" "free zone" supplier`);
    }
    
    if (domain && sector) {
        dorks.push(`"${domain}" "${sector}" contact`);
    }
    
    generatedDorks.innerHTML = dorks.map(dork => `
        <div class="rams-dork-item">
            <code class="rams-dork-item__code">${dork}</code>
            <div class="rams-dork-item__actions">
                <button onclick="copyDork('${dork.replace(/'/g, "\\'")}')" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.copy'|trans }}</button>
                <a href="https://www.google.com/search?q=${encodeURIComponent(dork)}" target="_blank" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.search'|trans }}</a>
            </div>
        </div>
    `).join('');
}

domainInput.addEventListener('input', generateDorks);
sectorInput.addEventListener('change', generateDorks);
</script>
{% endblock %}
