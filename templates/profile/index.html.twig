{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.my_profile'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Header Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h1 class="rams-module__title">{{ 'profile.my_profile'|trans }}</h1>
            <p class="rams-dymo">{{ 'profile.subtitle'|trans }}</p>
        </div>
    </div>

    {# Flash Messages #}
    {% for message in app.flashes('success') %}
        <div class="rams-alert rams-alert--success">
            <span class="rams-alert__icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </span>
            <span class="rams-alert__text">{{ message }}</span>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="rams-alert rams-alert--error">
            <span class="rams-alert__icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </span>
            <span class="rams-alert__text">{{ message }}</span>
        </div>
    {% endfor %}

    <div class="rams-grid rams-grid--2">
        {# User Information Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'profile.account_info'|trans }}</h2>
            </div>
            <div class="rams-module__content rams-p-6">
                <div class="rams-stack rams-gap-4">
                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'user.full_name'|trans }}</label>
                        <p class="rams-dymo rams-text--lg">{{ user.fullName }}</p>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'common.email'|trans }}</label>
                        <p class="rams-dymo rams-text--lg">{{ user.email }}</p>
                    </div>

                    {% if user.role %}
                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'user.role'|trans }}</label>
                        <p class="rams-dymo rams-text--lg">{{ user.role }}</p>
                    </div>
                    {% endif %}

                    {% if user.territory %}
                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'user.territory'|trans }}</label>
                        <p class="rams-dymo rams-text--lg">{{ user.territory }}</p>
                    </div>
                    {% endif %}

                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'user.roles'|trans }}</label>
                        <div class="rams-flex rams-flex-wrap rams-gap-2">
                            {% for role in user.roles %}
                                <span class="rams-badge rams-badge--info">
                                    {{ role|replace({'ROLE_': ''}) }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="rams-form__group">
                        <label class="rams-form__label">{{ 'common.status'|trans }}</label>
                        <span class="rams-badge {{ user.active ? 'rams-badge--success' : 'rams-badge--danger' }}">
                            {{ user.active ? 'common.active'|trans : 'common.inactive'|trans }}
                        </span>
                    </div>
                </div>
            </div>
        </div>

        {# Change Password Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'profile.change_password'|trans }}</h2>
            </div>
            <div class="rams-module__content rams-p-6">
                {{ form_start(form, {'attr': {'class': 'rams-stack rams-gap-4'}}) }}
                    <div class="rams-form__group">
                        {{ form_label(form.currentPassword, 'profile.current_password'|trans, {'label_attr': {'class': 'rams-form__label'}}) }}
                        {{ form_widget(form.currentPassword, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.currentPassword) }}
                    </div>

                    <div class="rams-form__group">
                        {{ form_label(form.newPassword.first, 'profile.new_password'|trans, {'label_attr': {'class': 'rams-form__label'}}) }}
                        {{ form_widget(form.newPassword.first, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.newPassword.first) }}
                    </div>

                    <div class="rams-form__group">
                        {{ form_label(form.newPassword.second, 'profile.confirm_password'|trans, {'label_attr': {'class': 'rams-form__label'}}) }}
                        {{ form_widget(form.newPassword.second, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.newPassword.second) }}
                    </div>

                    <div class="rams-module__footer rams-flex rams-justify-end">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            {{ 'profile.update_password'|trans }}
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        {# Preferences Module #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="rams-module__title">{{ 'profile.preferences'|trans }}</h2>
            </div>
            <div class="rams-module__content rams-p-6">
                {{ form_start(preferenceForm, {'attr': {'class': 'rams-stack rams-gap-4'}}) }}
                    <div class="rams-form__group">
                        {{ form_label(preferenceForm.displayCurrency, 'profile.display_currency'|trans, {'label_attr': {'class': 'rams-form__label'}}) }}
                        {{ form_widget(preferenceForm.displayCurrency, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(preferenceForm.displayCurrency) }}
                        <span class="rams-form__hint">{{ 'profile.display_currency_hint'|trans }}</span>
                    </div>

                    <div class="rams-form__group">
                        {{ form_label(preferenceForm.preferredLocale, 'profile.language'|trans, {'label_attr': {'class': 'rams-form__label'}}) }}
                        {{ form_widget(preferenceForm.preferredLocale, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(preferenceForm.preferredLocale) }}
                        <span class="rams-form__hint">{{ 'profile.language_hint'|trans }}</span>
                    </div>

                    <div class="rams-form__group">
                        {{ form_label(preferenceForm.preferredTimezone, 'profile.timezone'|trans, {'label_attr': {'class': 'rams-form__label'}}) }}
                        {{ form_widget(preferenceForm.preferredTimezone, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(preferenceForm.preferredTimezone) }}
                        <span class="rams-form__hint">{{ 'profile.timezone_hint'|trans }}</span>
                    </div>

                    <div class="rams-module__footer rams-flex rams-justify-end">
                        <button type="submit" class="rams-btn rams-btn--primary">
                            {{ 'profile.update_preferences'|trans }}
                        </button>
                    </div>
                {{ form_end(preferenceForm) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
