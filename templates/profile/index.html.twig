{% extends 'base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-neutral-200/80 pb-5">
        <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">My Profile</h1>
        <p class="mt-1 text-sm text-neutral-600">View your account information and update your password</p>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="p-4 rounded-lg bg-green-50 border border-green-200 text-green-800">
            {{ message }}
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-red-800">
            {{ message }}
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- User Information -->
        <div class="rounded-xl border border-neutral-200/60 bg-white p-6">
            <h2 class="text-lg font-semibold text-neutral-900 mb-4">Account Information</h2>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-neutral-700 mb-1">Full Name</label>
                    <p class="text-neutral-900">{{ user.fullName }}</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-neutral-700 mb-1">Email</label>
                    <p class="text-neutral-900">{{ user.email }}</p>
                </div>

                {% if user.role %}
                <div>
                    <label class="block text-sm font-medium text-neutral-700 mb-1">Role</label>
                    <p class="text-neutral-900">{{ user.role }}</p>
                </div>
                {% endif %}

                {% if user.territory %}
                <div>
                    <label class="block text-sm font-medium text-neutral-700 mb-1">Territory</label>
                    <p class="text-neutral-900">{{ user.territory }}</p>
                </div>
                {% endif %}

                <div>
                    <label class="block text-sm font-medium text-neutral-700 mb-1">Roles</label>
                    <div class="flex flex-wrap gap-2">
                        {% for role in user.roles %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-blue-100 text-blue-800">
                                {{ role|replace({'ROLE_': ''}) }}
                            </span>
                        {% endfor %}
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-neutral-700 mb-1">Status</label>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium {{ user.active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
                        {{ user.active ? 'Active' : 'Inactive' }}
                    </span>
                </div>
            </div>
        </div>

        <!-- Change Password -->
        <div class="rounded-xl border border-neutral-200/60 bg-white p-6">
            <h2 class="text-lg font-semibold text-neutral-900 mb-4">Change Password</h2>
            
            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
                <div>
                    {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'block text-sm font-medium text-neutral-700 mb-1'}}) }}
                    {{ form_widget(form.currentPassword) }}
                    {{ form_errors(form.currentPassword) }}
                </div>

                <div>
                    {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'block text-sm font-medium text-neutral-700 mb-1'}}) }}
                    {{ form_widget(form.newPassword.first) }}
                    {{ form_errors(form.newPassword.first) }}
                </div>

                <div>
                    {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'block text-sm font-medium text-neutral-700 mb-1'}}) }}
                    {{ form_widget(form.newPassword.second) }}
                    {{ form_errors(form.newPassword.second) }}
                </div>

                <div class="flex justify-end pt-2">
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
                        Update Password
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
