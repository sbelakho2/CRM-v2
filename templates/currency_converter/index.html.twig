{% extends 'base.html.twig' %}

{% block title %}{{ 'currency_converter.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ 'currency_converter.title'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'currency_converter.title'|trans }}</h1>
            <p class="rams-page__subtitle">{{ 'currency_converter.subtitle'|trans }}</p>
        </div>
        <div class="rams-page__actions mobile-stack">
            <button type="button" id="btn-refresh-rates" class="rams-btn rams-btn--primary uppercase" title="{{ 'currency_converter.refresh_all_tooltip'|trans }}">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 8a6 6 0 0110.472-4M14 8a6 6 0 01-10.472 4"/>
                    <path d="M14 2v4h-4M2 14v-4h4"/>
                </svg>
                {{ 'currency_converter.refresh_all'|trans }}
            </button>
        </div>
    </div>

    {# ── System Rate Status ───────────────────────────────── #}
    <div class="rams-grid rams-grid--4 rams-mb-6" id="status-cards">
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'currency_converter.status.total_pairs'|trans }}</div>
                <div class="rams-metric__value tabular-nums" id="stat-total">{{ freshness|length }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'currency_converter.status.fresh_rates'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-rams-green" id="stat-fresh">—</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'currency_converter.status.stale_rates'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-rams-orange" id="stat-stale">—</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'currency_converter.status.data_source'|trans }}</div>
                <div class="rams-flex rams-items-center rams-gap-2 rams-mt-1">
                    <div class="w-2 h-2 rounded-full bg-rams-green"></div>
                    <span class="font-mono text-3xs uppercase text-rams-green">{{ 'currency_converter.status.live'|trans }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--2 rams-gap-6">
        {# ── Converter Module ─────────────────────────────── #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'currency_converter.convert_heading'|trans }}</h2>
                <span class="rams-badge rams-badge--steel uppercase">{{ 'currency_converter.badge_live'|trans }}</span>
            </div>
            <div class="rams-module__content">
                <form id="converter-form" class="rams-form" autocomplete="off">
                    {# Amount Input #}
                    <div class="rams-form__group">
                        <label for="convert-amount" class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'currency_converter.amount_label'|trans }}</label>
                        <input
                            type="number"
                            id="convert-amount"
                            name="amount"
                            class="rams-form__input"
                            value="1000"
                            min="0.01"
                            step="any"
                            placeholder="{{ 'currency_converter.amount_placeholder'|trans }}"
                            required
                        >
                    </div>

                    {# From Currency #}
                    <div class="rams-form__group">
                        <label for="convert-from" class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'currency_converter.from_label'|trans }}</label>
                        <select id="convert-from" name="from" class="rams-form__select">
                            {% for code, label in currencies %}
                                <option value="{{ code }}" {{ code == 'USD' ? 'selected' : '' }}>
                                    {{ currency_symbol(code) }} {{ label }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Swap Button #}
                    <div class="rams-flex rams-justify-center rams-my-2">
                        <button type="button" id="btn-swap" class="rams-btn" title="{{ 'currency_converter.swap_tooltip'|trans }}">
                            <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M4 10h8M12 10l-3-3M12 10l-3 3M12 6H4M4 6l3-3M4 6l3 3"/>
                            </svg>
                        </button>
                    </div>

                    {# To Currency #}
                    <div class="rams-form__group">
                        <label for="convert-to" class="rams-form__label font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'currency_converter.to_label'|trans }}</label>
                        <select id="convert-to" name="to" class="rams-form__select">
                            {% for code, label in currencies %}
                                <option value="{{ code }}" {{ code == displayCurrency ? 'selected' : '' }}>
                                    {{ currency_symbol(code) }} {{ label }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Convert Button #}
                    <div class="rams-actions rams-mt-6 mobile-stack">
                        <button type="submit" id="btn-convert" class="rams-btn rams-btn--primary uppercase rams-w-full">
                            {{ 'currency_converter.convert_btn'|trans }}
                        </button>
                    </div>
                </form>

                {# ── Result Display ─────────────────────────── #}
                <div id="result-panel" class="rams-mt-6 rams-p-6 rams-bg-panel border border-rams-line rounded-rams-sm rams-text--center" style="display: none;">
                    <div class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mb-2">{{ 'currency_converter.result_label'|trans }}</div>
                    <div class="rams-metric__value tabular-nums text-2xl rams-mb-1" id="result-amount">—</div>
                    <div class="text-sm text-rams-muted" id="result-detail"></div>
                    
                    <div class="rams-grid rams-grid--3 rams-gap-4 rams-mt-6 pt-6 border-t border-rams-line">
                        <div>
                            <div class="font-mono text-3xs uppercase text-rams-muted">{{ 'currency_converter.rate_label'|trans }}</div>
                            <div class="font-mono text-xs tabular-nums" id="result-rate">—</div>
                        </div>
                        <div>
                            <div class="font-mono text-3xs uppercase text-rams-muted">{{ 'currency_converter.source_label'|trans }}</div>
                            <div class="font-mono text-xs" id="result-source">—</div>
                        </div>
                        <div>
                            <div class="font-mono text-3xs uppercase text-rams-muted">{{ 'currency_converter.timestamp_label'|trans }}</div>
                            <div class="font-mono text-xs tabular-nums" id="result-timestamp">—</div>
                        </div>
                    </div>
                    
                    <div id="result-warning" class="rams-alert rams-alert--warning rams-mt-4" style="display: none;">
                        <div class="rams-alert__content" id="result-warning-text"></div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Active Rates Module ──────────────────────────── #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'currency_converter.active_rates_heading'|trans }}</h2>
                <span class="rams-badge rams-badge--neutral uppercase" id="rates-count-badge">{{ freshness|length }} {{ 'currency_converter.pairs'|trans }}</span>
            </div>
            <div class="rams-table-container" style="max-height: 560px;">
                <table class="rams-table" id="rates-table">
                    <thead>
                        <tr>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'currency_converter.col_pair'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'currency_converter.col_rate'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'currency_converter.col_age'|trans }}</th>
                            <th class="font-mono text-2xs uppercase tracking-widest">{{ 'currency_converter.col_status'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody id="rates-tbody">
                        {% for pair, info in freshness %}
                            <tr>
                                <td class="font-mono text-xs uppercase">{{ pair }}</td>
                                <td class="font-mono text-xs tabular-nums">{{ info.rate|number_format(6) }}</td>
                                <td class="text-xs text-rams-muted tabular-nums">{{ info.age_hours|number_format(1) }}h</td>
                                <td>
                                    {% if info.stale %}
                                        <div class="rams-flex rams-items-center rams-gap-2">
                                            <div class="w-2 h-2 rounded-full bg-rams-orange"></div>
                                            <span class="font-mono text-3xs uppercase text-rams-orange">{{ 'currency_converter.stale'|trans }}</span>
                                        </div>
                                    {% else %}
                                        <div class="rams-flex rams-items-center rams-gap-2">
                                            <div class="w-2 h-2 rounded-full bg-rams-green"></div>
                                            <span class="font-mono text-3xs uppercase text-rams-green">{{ 'currency_converter.fresh'|trans }}</span>
                                        </div>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="rams-text--center rams-p-8 rams-text--muted">
                                    {{ 'currency_converter.no_rates'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Info Module ──────────────────────────────────────── #}
    <div class="rams-module rams-mt-6">
        <div class="rams-module__header">
            <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'currency_converter.info_heading'|trans }}</h3>
        </div>
        <div class="rams-module__content">
            <div class="rams-grid rams-grid--3 rams-gap-6">
                <div>
                    <div class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mb-3">{{ 'currency_converter.info_sources_title'|trans }}</div>
                    <ul class="rams-list">
                        <li class="rams-list__item">ECB / Frankfurter.app</li>
                        <li class="rams-list__item">ExchangeRate-API</li>
                        <li class="rams-list__item">Bank of England</li>
                        <li class="rams-list__item">Banque Centrale de Tunisie</li>
                    </ul>
                </div>
                <div>
                    <div class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mb-3">{{ 'currency_converter.info_how_title'|trans }}</div>
                    <ul class="rams-list">
                        <li class="rams-list__item">{{ 'currency_converter.info_how_1'|trans }}</li>
                        <li class="rams-list__item">{{ 'currency_converter.info_how_2'|trans }}</li>
                        <li class="rams-list__item">{{ 'currency_converter.info_how_3'|trans }}</li>
                    </ul>
                </div>
                <div>
                    <div class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mb-3">{{ 'currency_converter.info_system_title'|trans }}</div>
                    <ul class="rams-list">
                        <li class="rams-list__item">{{ 'currency_converter.info_system_1'|trans }}</li>
                        <li class="rams-list__item">{{ 'currency_converter.info_system_2'|trans }}</li>
                        <li class="rams-list__item">{{ 'currency_converter.info_system_3'|trans }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    'use strict';

    const convertUrl   = '{{ path("currency_converter_convert") }}';
    const refreshUrl   = '{{ path("currency_converter_refresh") }}';
    const statusUrl    = '{{ path("currency_converter_status") }}';

    // ── DOM refs ──────────────────────────────────────────────
    const form          = document.getElementById('converter-form');
    const amountInput   = document.getElementById('convert-amount');
    const fromSelect    = document.getElementById('convert-from');
    const toSelect      = document.getElementById('convert-to');
    const btnSwap       = document.getElementById('btn-swap');
    const btnRefresh    = document.getElementById('btn-refresh-rates');
    const btnConvert    = document.getElementById('btn-convert');
    const resultPanel   = document.getElementById('result-panel');
    const resultAmount  = document.getElementById('result-amount');
    const resultDetail  = document.getElementById('result-detail');
    const resultRate    = document.getElementById('result-rate');
    const resultSource  = document.getElementById('result-source');
    const resultTs      = document.getElementById('result-timestamp');
    const resultWarn    = document.getElementById('result-warning');
    const resultWarnTxt = document.getElementById('result-warning-text');
    const statTotal     = document.getElementById('stat-total');
    const statFresh     = document.getElementById('stat-fresh');
    const statStale     = document.getElementById('stat-stale');

    // ── Convert ───────────────────────────────────────────────
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const amount = parseFloat(amountInput.value);
        if (!amount || amount <= 0) return;

        btnConvert.disabled = true;
        btnConvert.textContent = '{{ 'currency_converter.converting'|trans }}';

        try {
            const resp = await fetch(convertUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({
                    amount: amount,
                    from: fromSelect.value,
                    to: toSelect.value
                })
            });
            const data = await resp.json();

            if (data.success) {
                resultPanel.style.display = '';
                resultAmount.textContent = data.formatted;
                resultDetail.textContent = `${numberFmt(data.amount)} ${data.from} = ${numberFmt(data.result)} ${data.to}`;
                resultRate.textContent = data.rate;
                resultSource.textContent = prettifySource(data.source);
                resultTs.textContent = data.timestamp;

                if (data.stale || data.warning) {
                    resultWarn.style.display = '';
                    resultWarnTxt.textContent = data.warning || '{{ 'currency_converter.stale_warning'|trans }}';
                } else {
                    resultWarn.style.display = 'none';
                }

                // Refresh status cards since conversion auto-persists rates
                updateStatusCards();
            } else {
                alert(data.error || '{{ 'currency_converter.error_generic'|trans }}');
            }
        } catch (err) {
            console.error(err);
            alert('{{ 'currency_converter.error_network'|trans }}');
        } finally {
            btnConvert.disabled = false;
            btnConvert.textContent = '{{ 'currency_converter.convert_btn'|trans }}';
        }
    });

    // ── Swap currencies ───────────────────────────────────────
    btnSwap.addEventListener('click', function() {
        const tmp = fromSelect.value;
        fromSelect.value = toSelect.value;
        toSelect.value = tmp;
    });

    // ── Refresh all system rates ──────────────────────────────
    btnRefresh.addEventListener('click', async function() {
        btnRefresh.disabled = true;
        const origHtml = btnRefresh.innerHTML;
        btnRefresh.innerHTML = '<svg class="rams-btn__icon rams-spin" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M2 8a6 6 0 0110.472-4M14 8a6 6 0 01-10.472 4"/><path d="M14 2v4h-4M2 14v-4h4"/></svg> {{ 'currency_converter.refreshing'|trans }}';

        try {
            const resp = await fetch(refreshUrl, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await resp.json();

            if (data.success) {
                // Rebuild the rates table
                rebuildRatesTable(data.rates);
                updateStatusFromData(data.rates);
            } else {
                alert(data.error || '{{ 'currency_converter.error_refresh'|trans }}');
            }
        } catch (err) {
            console.error(err);
            alert('{{ 'currency_converter.error_network'|trans }}');
        } finally {
            btnRefresh.disabled = false;
            btnRefresh.innerHTML = origHtml;
        }
    });

    // ── Helpers ────────────────────────────────────────────────
    function numberFmt(n) {
        return parseFloat(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 6 });
    }

    function prettifySource(src) {
        return (src || 'unknown')
            .replace(/_/g, ' ')
            .replace(/\b\w/g, c => c.toUpperCase());
    }

    async function updateStatusCards() {
        try {
            const resp = await fetch(statusUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await resp.json();
            statTotal.textContent = data.total;
            statFresh.textContent = data.fresh;
            statStale.textContent = data.stale;
        } catch (e) { /* silent */ }
    }

    function updateStatusFromData(rates) {
        let fresh = 0, stale = 0, total = 0;
        for (const pair in rates) {
            total++;
            if (rates[pair].stale) stale++; else fresh++;
        }
        statTotal.textContent = total;
        statFresh.textContent = fresh;
        statStale.textContent = stale;
    }

    function rebuildRatesTable(rates) {
        const tbody = document.getElementById('rates-tbody');
        const badge = document.getElementById('rates-count-badge');
        let html = '';
        let count = 0;

        for (const pair in rates) {
            const info = rates[pair];
            count++;
            const statusHtml = info.stale
                ? '<span class="rams-andon"><span class="rams-andon__light rams-andon__light--amber"></span><span class="rams-andon__text rams-andon__text--amber">{{ 'currency_converter.stale'|trans }}</span></span>'
                : '<span class="rams-andon"><span class="rams-andon__light rams-andon__light--green"></span><span class="rams-andon__text rams-andon__text--green">{{ 'currency_converter.fresh'|trans }}</span></span>';
            html += `<tr>
                <td class="rams-table__td rams-text--mono">${pair}</td>
                <td class="rams-table__td rams-text--mono">${parseFloat(info.rate).toFixed(6)}</td>
                <td class="rams-table__td rams-text--muted">${parseFloat(info.age_hours).toFixed(1)}h</td>
                <td class="rams-table__td">${statusHtml}</td>
            </tr>`;
        }

        tbody.innerHTML = html || '<tr><td class="rams-table__td" colspan="4" style="text-align:center;">{{ 'currency_converter.no_rates'|trans }}</td></tr>';
        badge.textContent = count + ' {{ 'currency_converter.pairs'|trans }}';
    }

    // ── Init ──────────────────────────────────────────────────
    updateStatusCards();
})();
</script>
<style>
@keyframes rams-spin { to { transform: rotate(360deg); } }
.rams-spin { animation: rams-spin 1s linear infinite; }
</style>
{% endblock %}
