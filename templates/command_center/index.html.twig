{% extends 'base.html.twig' %}

{% block title %}{{ 'command_center.title'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div class="rams-page__header-content">
             <div class="rams-breadcrumb">
                <a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans }}</a>
                <span class="rams-breadcrumb-separator">/</span>
                <span>{{ 'command_center.title'|trans }}</span>
            </div>
            <h1 class="rams-page__title">{{ 'command_center.title'|trans }}</h1>
            <p class="rams-page__subtitle">{{ 'command_center.overview'|trans }}</p>
        </div>
        <div class="rams-page__actions mobile-stack">
            <span class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mr-4">{{ 'common.date'|trans }}: {{ data.timestamp|date('H:i:s') }}</span>
            <button class="rams-btn uppercase" onclick="location.reload()">
                <svg class="rams-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                {{ 'common.refresh'|trans }}
            </button>
        </div>
    </div>

    {# Key Metrics Row #}
    <div class="rams-grid rams-grid--6 rams-gap-4 rams-mb-6">
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'lead.title'|trans }} {{ 'dashboard.this_week'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ data.key_metrics.leads_this_week }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'dashboard.conversion_rate'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-rams-green">{{ data.key_metrics.lead_conversion_rate }}%</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'quote.title'|trans }} {{ 'dashboard.this_week'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ data.key_metrics.quotes_this_week }}</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'dashboard.win_rate'|trans }}</div>
                <div class="rams-metric__value tabular-nums text-rams-orange">{{ data.key_metrics.quote_win_rate }}%</div>
            </div>
        </div>
        <div class="rams-module rams-p-4">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'common.value'|trans }}</div>
                <div class="rams-metric__value tabular-nums">{{ (data.key_metrics.avg_quote_value / 1000)|format_currency(data.key_metrics.avg_quote_value_currency|default(display_currency())) }}k</div>
            </div>
        </div>
        <div class="rams-module rams-p-4 {% if data.supply_alerts.summary.critical > 0 %}border-rams-red{% endif %}">
            <div class="rams-metric">
                <div class="rams-metric__label text-rams-muted">{{ 'command_center.alerts'|trans }}</div>
                <div class="rams-metric__value tabular-nums {% if data.supply_alerts.summary.critical > 0 %}text-rams-red{% endif %}">{{ data.supply_alerts.summary.total_alerts }}</div>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6">
        {# Left Column - Lead Inflow #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'command_center.lead_inflow'|trans }}</h2>
                <span class="rams-badge rams-badge--warning uppercase">{{ data.lead_inflow.summary.pending_review }} {{ 'common.pending'|trans }}</span>
            </div>
            <div class="rams-module__content">
                {# Summary Stats #}
                <div class="rams-grid rams-grid--3 rams-gap-4 rams-mb-6">
                    <div class="rams-metric">
                        <div class="rams-metric__label text-rams-muted">{{ 'dashboard.today'|trans }}</div>
                        <div class="rams-metric__value tabular-nums text-base">{{ data.lead_inflow.summary.today }}</div>
                    </div>
                    <div class="rams-metric">
                        <div class="rams-metric__label text-rams-muted">{{ 'dashboard.this_week'|trans }}</div>
                        <div class="rams-metric__value tabular-nums text-base">{{ data.lead_inflow.summary.this_week }}</div>
                    </div>
                    <div class="rams-metric">
                        <div class="rams-metric__label text-rams-red">{{ 'rfq.priorities.high'|trans }}</div>
                        <div class="rams-metric__value tabular-nums text-base text-rams-red">{{ data.lead_inflow.summary.high_priority_count }}</div>
                    </div>
                </div>

                {# High Priority Leads #}
                <div class="rams-mb-6">
                    <h3 class="font-mono text-3xs uppercase tracking-widest text-rams-muted rams-mb-3">{{ 'rfq.priorities.high'|trans }} {{ 'lead.title'|trans }}</h3>
                    {% if data.lead_inflow.high_priority_leads|length > 0 %}
                        <div class="rams-flex rams-flex-col rams-gap-2">
                            {% for lead in data.lead_inflow.high_priority_leads|slice(0, 5) %}
                                <a href="{{ path('app_lead_show', {id: lead.id}) }}" class="rams-p-3 rams-bg-panel border border-rams-line rounded-rams-sm rams-no-underline hover:border-rams-steel transition-colors">
                                    <div class="rams-flex rams-justify-between rams-items-center">
                                        <div class="rams-flex-1 rams-overflow-hidden">
                                            <div class="font-bold text-sm rams-truncate">{{ lead.company_name }}</div>
                                            <div class="rams-flex rams-items-center rams-gap-2 rams-mt-1">
                                                <span class="font-mono text-3xs uppercase text-rams-muted">{{ lead.region }}</span>
                                                {% if lead.defense_flag %}
                                                    <span class="rams-badge rams-badge--danger text-3xs uppercase">{{ 'lead.defense'|trans }}</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="rams-flex rams-items-center rams-gap-2">
                                            <span class="rams-badge rams-badge--{{ lead.score >= 80 ? 'success' : (lead.score >= 60 ? 'warning' : 'neutral') }} tabular-nums">
                                                {{ lead.score }}
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="rams-p-4 rams-bg-panel rams-rounded-rams-sm text-rams-muted text-xs">
                            {{ 'lead.no_leads'|trans }}
                        </div>
                    {% endif %}
                </div>

                {# Leads by Region #}
                <div class="pt-6 border-t border-rams-line">
                    <h3 class="font-mono text-3xs uppercase tracking-widest text-rams-muted rams-mb-3">{{ 'company.region'|trans }}</h3>
                    <div class="rams-flex rams-flex-col rams-gap-2">
                        {% for region, count in data.lead_inflow.by_region %}
                            <div class="rams-flex rams-justify-between rams-items-center">
                                <span class="font-mono text-3xs uppercase text-rams-muted">{{ region_labels[region] ?? (region ?: 'common.unknown'|trans) }}</span>
                                <span class="rams-badge rams-badge--neutral tabular-nums">{{ count }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# Middle Column - Quote Status #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'command_center.quote_status'|trans }}</h2>
                <span class="rams-badge rams-badge--success uppercase">{{ (data.quotes_status.summary.pipeline_value / 1000)|format_currency(data.quotes_status.summary.pipeline_currency|default(display_currency())) }}k</span>
            </div>
            <div class="rams-module__content">
                {# Quote Stats #}
                <div class="rams-grid rams-grid--3 rams-gap-4 rams-mb-6">
                    <div class="rams-metric">
                        <div class="rams-metric__label text-rams-orange">{{ 'common.pending'|trans }}</div>
                        <div class="rams-metric__value tabular-nums text-base text-rams-orange">{{ data.quotes_status.summary.pending_approval }}</div>
                    </div>
                    <div class="rams-metric">
                        <div class="rams-metric__label text-rams-muted">{{ 'common.active'|trans }}</div>
                        <div class="rams-metric__value tabular-nums text-base">{{ data.quotes_status.summary.active_interactive }}</div>
                    </div>
                    <div class="rams-metric">
                        <div class="rams-metric__label text-rams-green">{{ 'common.value'|trans }}</div>
                        <div class="rams-metric__value tabular-nums text-base text-rams-green">{{ data.quotes_status.summary.high_value_count }}</div>
                    </div>
                </div>

                {# Recent Quote Activity #}
                <div class="rams-mb-6">
                    <h3 class="font-mono text-3xs uppercase tracking-widest text-rams-muted rams-mb-3">{{ 'dashboard.recent_activity'|trans }}</h3>
                    {% if data.quotes_status.active_interactive|length > 0 %}
                        <div class="rams-flex rams-flex-col rams-gap-2">
                            {% for quote in data.quotes_status.active_interactive|slice(0, 4) %}
                                <a href="{{ path('app_quote_copilot_results', {id: quote.id}) }}" class="rams-p-3 rams-bg-panel border border-rams-line rounded-rams-sm rams-no-underline hover:border-rams-steel transition-colors">
                                    <div class="rams-flex rams-justify-between rams-items-center">
                                        <div class="rams-flex-1 rams-overflow-hidden">
                                            <div class="font-mono text-xs font-bold">{{ quote.quote_number }}</div>
                                            <div class="text-3xs text-rams-muted uppercase rams-truncate rams-mt-1">{{ quote.company }}</div>
                                        </div>
                                        <div class="rams-flex rams-flex-col rams-items-end">
                                            <span class="rams-badge rams-badge--neutral text-3xs uppercase">{{ quote.view_count }} {{ 'quote.review.views'|trans|default('VIEWS') }}</span>
                                            <span class="font-mono text-3xs text-rams-muted uppercase rams-mt-1">{{ quote.last_viewed }}</span>
                                        </div>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="rams-p-4 rams-bg-panel rams-rounded-rams-sm text-rams-muted text-xs">
                            {{ 'table.no_data'|trans }}
                        </div>
                    {% endif %}
                </div>

                {# High Value Quotes #}
                <div class="pt-6 border-t border-rams-line">
                    <h3 class="font-mono text-3xs uppercase tracking-widest text-rams-muted rams-mb-3">{{ 'common.value'|trans }}</h3>
                    <div class="rams-flex rams-flex-col rams-gap-2">
                        {% for quote in data.quotes_status.high_value_quotes|slice(0, 3) %}
                            <div class="rams-flex rams-justify-between rams-items-center rams-px-2">
                                <div class="rams-overflow-hidden">
                                    <a href="{{ path('app_quote_copilot_results', {id: quote.id}) }}" class="font-mono text-xs font-bold rams-block rams-truncate">{{ quote.quote_number }}</a>
                                    <span class="text-3xs text-rams-muted uppercase rams-block rams-truncate">{{ quote.company }}</span>
                                </div>
                                <div class="rams-flex rams-flex-col rams-items-end">
                                    <span class="font-mono text-xs font-bold tabular-nums">{{ (quote.total_cost / 1000)|format_currency(quote.currency|default(display_currency()), null, 1) }}k</span>
                                    <span class="rams-badge rams-badge--{{ quote.status == 'approved' ? 'success' : 'neutral' }} text-3xs uppercase">
                                        {{ quote.status }}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# Right Column - Supply Alerts #}
        <div class="rams-module">
            <div class="rams-module__header">
                <h2 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'command_center.supply_alerts'|trans }}</h2>
                <span class="rams-badge rams-badge--{{ data.supply_alerts.summary.critical > 0 ? 'danger' : 'warning' }} uppercase">
                    {{ data.supply_alerts.summary.critical }} {{ 'common.critical'|trans }}
                </span>
            </div>
            <div class="rams-module__content">
                {# Alert Summary #}
                <div class="rams-grid rams-grid--3 rams-gap-4 rams-mb-6">
                    <div class="rams-metric">
                        <div class="rams-metric__label text-rams-red">{{ 'rfq.priorities.urgent'|trans }}</div>
                        <div class="rams-metric__value tabular-nums text-base text-rams-red">{{ data.supply_alerts.summary.critical }}</div>
                    </div>
                    <div class="rams-metric">
                        <div class="rams-metric__label text-rams-orange">{{ 'common.warning'|trans }}</div>
                        <div class="rams-metric__value tabular-nums text-base text-rams-orange">{{ data.supply_alerts.summary.warning }}</div>
                    </div>
                    <div class="rams-metric">
                        <div class="rams-metric__label text-rams-muted">{{ 'common.total'|trans }}</div>
                        <div class="rams-metric__value tabular-nums text-base">{{ data.supply_alerts.summary.total_alerts }}</div>
                    </div>
                </div>

                {# Alert List #}
                <div>
                    <h3 class="font-mono text-3xs uppercase tracking-widest text-rams-muted rams-mb-3">{{ 'command_center.alerts'|trans }}</h3>
                    {% if data.supply_alerts.alerts|length > 0 %}
                        <div class="rams-flex rams-flex-col rams-gap-2 rams-max-h-[400px] overflow-y-auto pr-2">
                            {% for alert in data.supply_alerts.alerts|slice(0, 10) %}
                                <div class="rams-alert rams-alert--{{ alert.severity == 'critical' ? 'error' : 'warning' }} rams-p-3">
                                    <div class="rams-alert__content">
                                        <div class="rams-flex rams-justify-between rams-items-center rams-mb-1">
                                            <span class="rams-badge rams-badge--{{ alert.severity == 'critical' ? 'danger' : 'warning' }} text-3xs uppercase">
                                                {{ alert.type|replace({'_': ' '}) }}
                                            </span>
                                        </div>
                                        <p class="font-mono text-3xs uppercase rams-mb-0">{{ alert.message }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="rams-p-8 rams-bg-panel border border-rams-line rounded-rams-sm rams-text--center">
                            <div class="w-2 h-2 rounded-full bg-rams-green mx-auto rams-mb-2"></div>
                            <div class="font-mono text-2xs uppercase text-rams-green font-bold">{{ 'status_bar.operational'|trans }}</div>
                            <div class="text-3xs text-rams-muted uppercase rams-mt-1">{{ 'command_center.supply_alerts'|trans }} - {{ 'common.none'|trans }}</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Activity Feed Row #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'dashboard.recent_activity'|trans }}</h2>
            <a href="{{ path('app_activity_index') }}" class="rams-btn rams-btn--ghost uppercase text-xs">{{ 'common.view'|trans }} {{ 'common.all'|trans }}</a>
        </div>
        <div class="rams-module__content">
            <div class="rams-grid rams-grid--4 rams-gap-4">
                {% for activity in data.activity_feed|slice(0, 8) %}
                    <div class="rams-flex rams-items-center rams-gap-3 rams-p-3 rams-bg-panel border border-rams-line rounded-rams-sm">
                        <span class="rams-badge rams-badge--neutral text-3xs uppercase font-mono">
                            {{ activity.type|slice(0, 3) }}
                        </span>
                        <div class="rams-flex-1 rams-overflow-hidden">
                            <div class="font-bold text-xs rams-truncate">{{ activity.company_name ?: 'common.n_a'|trans }}</div>
                            <div class="text-3xs text-rams-muted rams-truncate font-mono uppercase">{{ activity.subject }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{# Lead Analysis Modal #}
<div id="leadAnalysisModal" class="rams-modal rams-modal--hidden">
    <div class="rams-modal__backdrop" onclick="closeLeadModal()"></div>
    <div class="rams-modal__content">
        <div class="rams-modal__header">
            <h3 class="font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'guidance.title'|trans }}</h3>
            <button class="rams-modal__close" onclick="closeLeadModal()">×</button>
        </div>
        <div class="rams-modal__body" id="leadAnalysisContent">
            <div class="rams-flex rams-flex-col rams-items-center rams-p-8">
                <div class="rams-andon">
                    <span class="rams-andon__light rams-andon__light--amber rams-pulse"></span>
                </div>
                <p class="rams-mt-4 rams-text--muted rams-text--sm uppercase font-mono">{{ 'common.loading'|trans }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function analyzeLeadQuick(leadId) {
    document.getElementById('leadAnalysisModal').classList.remove('rams-hidden');
    document.getElementById('leadAnalysisContent').innerHTML = `
        <div class="rams-flex rams-flex-col rams-items-center rams-p-6">
            <div class="rams-andon">
                <span class="rams-andon__light rams-andon__light--amber rams-pulse"></span>
            </div>
            <p class="rams-mt-2 font-mono text-2xs uppercase tracking-widest text-rams-muted">{{ 'common.loading'|trans }}</p>
        </div>
    `;
    
    fetch(`/command-center/lead/${leadId}/analysis`)
        .then(response => response.json())
        .then(data => {
            let html = `
                <div class="rams-mb-4">
                    <h5 class="rams-text--lg rams-font-semibold">${data.company_name}</h5>
                    <div class="rams-flex rams-gap-2 rams-mt-2">
                        <span class="rams-badge ${data.fit_grade === 'A' ? 'rams-badge--success' : data.fit_grade === 'B' ? 'rams-badge--info' : data.fit_grade === 'C' ? 'rams-badge--warning' : ''}">
                            {{ 'lead.score'|trans }}: ${data.fit_grade}
                        </span>
                        <span class="rams-badge rams-badge--neutral">{{ 'common.total'|trans }}: ${data.overall_fit_score}</span>
                        <span class="rams-badge rams-badge--neutral">{{ 'rfq.priority'|trans }}: ${data.priority_score}</span>
                    </div>
                </div>
            `;
            
            if (data.pain_points && data.pain_points.length > 0) {
                html += `<div class="rams-border-t border-rams-line rams-pt-3 rams-mt-3"><h6 class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mb-2">{{ 'guidance.tips'|trans }}</h6><div class="rams-flex rams-flex-col rams-gap-2">`;
                data.pain_points.forEach(pp => {
                    html += `<div class="rams-alert rams-alert--info"><div class="rams-alert__content"><strong>${pp.type.replace('_', ' ').toUpperCase()}</strong> (${pp.confidence})<br><small class="rams-text--muted">${pp.pitch}</small></div></div>`;
                });
                html += `</div></div>`;
            }
            
            if (data.conversation_starters && data.conversation_starters.length > 0) {
                html += `<div class="rams-border-t border-rams-line rams-pt-3 rams-mt-3"><h6 class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mb-2">{{ 'common.notes'|trans }}</h6>`;
                data.conversation_starters.slice(0, 3).forEach(cs => {
                    html += `<div class="rams-p-3 rams-bg-panel border border-rams-line rounded-rams-sm rams-mb-2"><div class="rams-module__content"><em>"${cs.opener}"</em><br><small class="rams-text--muted">${cs.follow_up}</small></div></div>`;
                });
                html += `</div>`;
            }
            
            if (data.next_steps && data.next_steps.length > 0) {
                html += `<div class="rams-border-t border-rams-line rams-pt-3 rams-mt-3"><h6 class="font-mono text-2xs uppercase tracking-widest text-rams-muted rams-mb-2">{{ 'common.actions'|trans }}</h6><ol class="rams-list rams-list--ordered">`;
                data.next_steps.forEach(ns => {
                    html += `<li class="rams-list__item"><strong>${ns.action}</strong>: ${ns.description} <span class="rams-badge rams-badge--neutral">${ns.timeframe}</span></li>`;
                });
                html += `</ol></div>`;
            }
            
            html += `<div class="rams-mt-6"><a href="/lead/${leadId}" class="rams-btn rams-btn--primary uppercase">{{ 'common.view'|trans }} {{ 'common.details'|trans }}</a></div>`;
            
            document.getElementById('leadAnalysisContent').innerHTML = html;
        })
        .catch(error => {
            document.getElementById('leadAnalysisContent').innerHTML = `
                <div class="rams-alert rams-alert--error">{{ 'common.error'|trans }}: ${error.message}</div>
            `;
        });
}

function closeLeadModal() {
    document.getElementById('leadAnalysisModal').classList.add('rams-modal--hidden');
}

document.getElementById('leadAnalysisModal').addEventListener('click', function(e) {
    if (e.target === this) closeLeadModal();
});

setTimeout(() => location.reload(), 300000);
</script>
{% endblock %}
