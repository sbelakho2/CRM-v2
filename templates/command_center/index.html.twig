{% extends 'base.html.twig' %}

{% block title %}Command Center - Starz CRM{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0"><i class="bi bi-speedometer2 text-primary me-2"></i>Command Center</h1>
            <small class="text-muted">Real-time overview of leads, quotes, and supply chain alerts</small>
        </div>
        <div>
            <span class="badge bg-secondary">Last updated: {{ data.timestamp|date('H:i:s') }}</span>
            <button class="btn btn-sm btn-outline-primary ms-2" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    {# Key Metrics Row #}
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card bg-primary text-white h-100">
                <div class="card-body text-center">
                    <div class="h2 mb-0">{{ data.key_metrics.leads_this_week }}</div>
                    <small>Leads This Week</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-success text-white h-100">
                <div class="card-body text-center">
                    <div class="h2 mb-0">{{ data.key_metrics.lead_conversion_rate }}%</div>
                    <small>Lead Conversion</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-white h-100">
                <div class="card-body text-center">
                    <div class="h2 mb-0">{{ data.key_metrics.quotes_this_week }}</div>
                    <small>Quotes This Week</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body text-center">
                    <div class="h2 mb-0">{{ data.key_metrics.quote_win_rate }}%</div>
                    <small>Quote Win Rate</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-dark text-white h-100">
                <div class="card-body text-center">
                    <div class="h2 mb-0">${{ (data.key_metrics.avg_quote_value / 1000)|number_format(1) }}k</div>
                    <small>Avg Quote Value</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card {% if data.supply_alerts.summary.critical > 0 %}bg-danger{% else %}bg-secondary{% endif %} text-white h-100">
                <div class="card-body text-center">
                    <div class="h2 mb-0">{{ data.supply_alerts.summary.total_alerts }}</div>
                    <small>Supply Alerts</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        {# Left Column - Lead Inflow #}
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-funnel me-2"></i>Lead Inflow (LeadBot)</span>
                    <span class="badge bg-light text-primary">{{ data.lead_inflow.summary.pending_review }} pending</span>
                </div>
                <div class="card-body">
                    {# Summary Stats #}
                    <div class="row text-center mb-3 g-2">
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="h4 mb-0 text-primary">{{ data.lead_inflow.summary.today }}</div>
                                <small class="text-muted">Today</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="h4 mb-0 text-info">{{ data.lead_inflow.summary.this_week }}</div>
                                <small class="text-muted">This Week</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="h4 mb-0 text-danger">{{ data.lead_inflow.summary.high_priority_count }}</div>
                                <small class="text-muted">High Priority</small>
                            </div>
                        </div>
                    </div>

                    {# High Priority Leads #}
                    <h6 class="border-bottom pb-2 mb-3">
                        <i class="bi bi-star-fill text-warning me-1"></i>High Priority Leads
                    </h6>
                    {% if data.lead_inflow.high_priority_leads|length > 0 %}
                        <div class="list-group list-group-flush">
                            {% for lead in data.lead_inflow.high_priority_leads|slice(0, 5) %}
                                <a href="/lead/{{ lead.id }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2">
                                    <div>
                                        <strong>{{ lead.company_name }}</strong>
                                        <br>
                                        <small class="text-muted">
                                            {{ lead.region }} 
                                            {% if lead.defense_flag %}<span class="badge bg-dark">Defense</span>{% endif %}
                                        </small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-{% if lead.score >= 80 %}success{% elseif lead.score >= 60 %}warning{% else %}secondary{% endif %}">
                                            {{ lead.score }}
                                        </span>
                                        <br>
                                        <button class="btn btn-sm btn-outline-primary mt-1" 
                                                onclick="event.preventDefault(); analyzeLeadQuick({{ lead.id }})">
                                            <i class="bi bi-lightbulb"></i>
                                        </button>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-inbox h3"></i>
                            <p class="mb-0">No high-priority leads pending</p>
                        </div>
                    {% endif %}

                    {# Leads by Region Chart Placeholder #}
                    <h6 class="border-bottom pb-2 mt-4 mb-3">
                        <i class="bi bi-globe me-1"></i>By Region
                    </h6>
                    <div class="small">
                        {% for region, count in data.lead_inflow.by_region %}
                            <div class="d-flex justify-content-between mb-1">
                                <span>{{ region|default('Unknown') }}</span>
                                <span class="badge bg-secondary">{{ count }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# Middle Column - Quote Status #}
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-file-earmark-text me-2"></i>Quote Status (Quote Buddy)</span>
                    <span class="badge bg-light text-success">${{ (data.quotes_status.summary.pipeline_value / 1000)|number_format(0) }}k pipeline</span>
                </div>
                <div class="card-body">
                    {# Quote Stats #}
                    <div class="row text-center mb-3 g-2">
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="h4 mb-0 text-warning">{{ data.quotes_status.summary.pending_approval }}</div>
                                <small class="text-muted">Pending</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="h4 mb-0 text-info">{{ data.quotes_status.summary.active_interactive }}</div>
                                <small class="text-muted">Active Live</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="h4 mb-0 text-success">{{ data.quotes_status.summary.high_value_count }}</div>
                                <small class="text-muted">High Value</small>
                            </div>
                        </div>
                    </div>

                    {# Interactive Quotes with Activity #}
                    <h6 class="border-bottom pb-2 mb-3">
                        <i class="bi bi-eye-fill text-info me-1"></i>Recently Viewed (Interactive)
                    </h6>
                    {% if data.quotes_status.active_interactive|length > 0 %}
                        <div class="list-group list-group-flush">
                            {% for quote in data.quotes_status.active_interactive|slice(0, 4) %}
                                <a href="/quote-copilot/results/{{ quote.id }}" class="list-group-item list-group-item-action py-2">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>{{ quote.quote_number }}</strong>
                                            <br>
                                            <small class="text-muted">{{ quote.company }}</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-info">{{ quote.view_count }} views</span>
                                            <br>
                                            <small class="text-muted">{{ quote.last_viewed }}</small>
                                        </div>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-eye-slash h3"></i>
                            <p class="mb-0">No recent customer views</p>
                        </div>
                    {% endif %}

                    {# High Value Quotes #}
                    <h6 class="border-bottom pb-2 mt-4 mb-3">
                        <i class="bi bi-currency-dollar text-success me-1"></i>High Value Quotes
                    </h6>
                    {% for quote in data.quotes_status.high_value_quotes|slice(0, 3) %}
                        <div class="d-flex justify-content-between mb-2">
                            <div>
                                <a href="/quote-copilot/results/{{ quote.id }}">{{ quote.quote_number }}</a>
                                <small class="text-muted d-block">{{ quote.company }}</small>
                            </div>
                            <div class="text-end">
                                <strong>${{ (quote.total_cost / 1000)|number_format(1) }}k</strong>
                                <br>
                                <span class="badge bg-{% if quote.status == 'sent' %}primary{% elseif quote.status == 'approved' %}success{% else %}secondary{% endif %}">
                                    {{ quote.status }}
                                </span>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted small">No high-value quotes in pipeline</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Right Column - Supply Alerts #}
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header {% if data.supply_alerts.summary.critical > 0 %}bg-danger{% else %}bg-warning{% endif %} text-{% if data.supply_alerts.summary.critical > 0 %}white{% else %}dark{% endif %} d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-exclamation-triangle me-2"></i>Supply Alerts</span>
                    <span class="badge bg-{% if data.supply_alerts.summary.critical > 0 %}light text-danger{% else %}dark{% endif %}">
                        {{ data.supply_alerts.summary.critical }} critical
                    </span>
                </div>
                <div class="card-body">
                    {# Alert Summary #}
                    <div class="row text-center mb-3 g-2">
                        <div class="col-4">
                            <div class="border border-danger rounded p-2">
                                <div class="h4 mb-0 text-danger">{{ data.supply_alerts.summary.critical }}</div>
                                <small class="text-muted">Critical</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border border-warning rounded p-2">
                                <div class="h4 mb-0 text-warning">{{ data.supply_alerts.summary.warning }}</div>
                                <small class="text-muted">Warning</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="h4 mb-0 text-secondary">{{ data.supply_alerts.summary.total_alerts }}</div>
                                <small class="text-muted">Total</small>
                            </div>
                        </div>
                    </div>

                    {# Alert List #}
                    <h6 class="border-bottom pb-2 mb-3">
                        <i class="bi bi-bell-fill me-1"></i>Recent Alerts
                    </h6>
                    {% if data.supply_alerts.alerts|length > 0 %}
                        <div class="list-group list-group-flush" style="max-height: 350px; overflow-y: auto;">
                            {% for alert in data.supply_alerts.alerts|slice(0, 10) %}
                                <div class="list-group-item {% if alert.severity == 'critical' %}list-group-item-danger{% elseif alert.severity == 'warning' %}list-group-item-warning{% endif %} py-2">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <span class="badge bg-{% if alert.severity == 'critical' %}danger{% else %}warning text-dark{% endif %} me-1">
                                                {{ alert.type|replace({'_': ' '})|title }}
                                            </span>
                                            <br>
                                            <small>{{ alert.message }}</small>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center text-success py-4">
                            <i class="bi bi-check-circle h2"></i>
                            <p class="mb-0">No supply chain alerts</p>
                            <small class="text-muted">All systems operational</small>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Activity Feed Row #}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-activity me-2"></i>Recent Activity</span>
                    <a href="/activities" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    <div class="row">
                        {% for activity in data.activity_feed|slice(0, 8) %}
                            <div class="col-md-3 mb-2">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-{% if activity.type == 'CALL' %}primary{% elseif activity.type == 'EMAIL' %}info{% elseif activity.type == 'MEETING' %}success{% else %}secondary{% endif %} me-2">
                                        {{ activity.type }}
                                    </span>
                                    <div class="small text-truncate">
                                        <strong>{{ activity.company_name|default('—') }}</strong>
                                        <br>
                                        <span class="text-muted">{{ activity.subject|slice(0, 30) }}...</span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Lead Analysis Modal #}
<div class="modal fade" id="leadAnalysisModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-lightbulb text-warning me-2"></i>Sales Intelligence</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="leadAnalysisContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Analyzing lead...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function analyzeLeadQuick(leadId) {
    const modal = new bootstrap.Modal(document.getElementById('leadAnalysisModal'));
    modal.show();
    
    document.getElementById('leadAnalysisContent').innerHTML = `
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Analyzing lead...</p>
        </div>
    `;
    
    fetch(`/command-center/lead/${leadId}/analysis`)
        .then(response => response.json())
        .then(data => {
            let html = `
                <div class="mb-3">
                    <h5>${data.company_name}</h5>
                    <div class="d-flex gap-2 mb-3">
                        <span class="badge bg-${data.fit_grade === 'A' ? 'success' : data.fit_grade === 'B' ? 'primary' : data.fit_grade === 'C' ? 'warning' : 'secondary'} fs-6">
                            Fit Grade: ${data.fit_grade}
                        </span>
                        <span class="badge bg-info fs-6">Score: ${data.overall_fit_score}</span>
                        <span class="badge bg-dark fs-6">Priority: ${data.priority_score}</span>
                    </div>
                </div>
            `;
            
            // Pain Points
            if (data.pain_points && data.pain_points.length > 0) {
                html += `<h6 class="border-bottom pb-2"><i class="bi bi-target text-danger me-1"></i>Identified Pain Points</h6><ul class="list-unstyled">`;
                data.pain_points.forEach(pp => {
                    html += `<li class="mb-2"><strong>${pp.type.replace('_', ' ').toUpperCase()}</strong> (${pp.confidence})<br><small class="text-muted">${pp.pitch}</small></li>`;
                });
                html += `</ul>`;
            }
            
            // Conversation Starters
            if (data.conversation_starters && data.conversation_starters.length > 0) {
                html += `<h6 class="border-bottom pb-2 mt-3"><i class="bi bi-chat-quote text-primary me-1"></i>Conversation Starters</h6>`;
                data.conversation_starters.slice(0, 3).forEach(cs => {
                    html += `<div class="alert alert-light mb-2"><em>"${cs.opener}"</em><br><small class="text-muted">${cs.follow_up}</small></div>`;
                });
            }
            
            // Next Steps
            if (data.next_steps && data.next_steps.length > 0) {
                html += `<h6 class="border-bottom pb-2 mt-3"><i class="bi bi-list-check text-success me-1"></i>Recommended Next Steps</h6><ol>`;
                data.next_steps.forEach(ns => {
                    html += `<li><strong>${ns.action}</strong>: ${ns.description} <span class="badge bg-secondary">${ns.timeframe}</span></li>`;
                });
                html += `</ol>`;
            }
            
            html += `<div class="mt-3"><a href="/lead/${leadId}" class="btn btn-primary">View Full Lead Details</a></div>`;
            
            document.getElementById('leadAnalysisContent').innerHTML = html;
        })
        .catch(error => {
            document.getElementById('leadAnalysisContent').innerHTML = `
                <div class="alert alert-danger">Failed to load analysis: ${error.message}</div>
            `;
        });
}

// Auto-refresh every 5 minutes
setTimeout(() => location.reload(), 300000);
</script>
{% endblock %}
