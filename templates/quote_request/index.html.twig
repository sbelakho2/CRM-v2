{% extends 'base.html.twig' %}

{% block title %}{{ 'quote_request.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
    <div class="rams-page__header">
        <div>
            <h1 class="rams-page__title">{{ 'quote_request.title'|trans }}</h1>
            <p class="rams-page__subtitle">{{ 'quote_request.subtitle'|trans }}</p>
        </div>
    </div>

    <div class="rams-tabs rams-mb-4" role="tablist" aria-label="{{ 'quote_request.filter_status'|trans }}">
        <a href="{{ path('app_quote_request_index', {status: 'open'}) }}"
           class="rams-tab {{ current_status == 'open' ? 'rams-tab--active' : '' }}">{{ 'quote_request.open'|trans }}</a>
        {% for key, label in statuses %}
            <a href="{{ path('app_quote_request_index', {status: key}) }}"
               class="rams-tab {{ current_status == key ? 'rams-tab--active' : '' }}">{{ label }}
                ({{ status_counts[key] ?? 0 }})</a>
        {% endfor %}
    </div>

    {% if requests is empty %}
        <div class="rams-module">
            <div class="rams-empty-state">
                <p class="rams-empty-state__title">{{ 'quote_request.empty_title'|trans }}</p>
                <p class="rams-empty-state__body">
                    {% if current_status == 'open' %}
                        {{ 'quote_request.empty_body'|trans }}
                    {% else %}
                        {{ 'quote_request.empty_filtered'|trans }}
                    {% endif %}
                </p>
                {% if current_status != 'open' %}
                    <a href="{{ path('app_quote_request_index', {status: 'open'}) }}" class="rams-btn rams-btn--secondary">{{ 'quote_request.show_open'|trans }}</a>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="rams-table-container">
            <table class="rams-table" aria-label="Quote requests">
                <thead>
                    <tr>
                        <th scope="col">{{ 'quote_request.received'|trans }}</th>
                        <th scope="col">{{ 'quote_request.quote'|trans }}</th>
                        <th scope="col">{{ 'quote_request.type'|trans }}</th>
                        <th scope="col">{{ 'quote_request.quantity'|trans }}</th>
                        <th scope="col">{{ 'quote_request.estimated'|trans }}</th>
                        <th scope="col">{{ 'quote_request.status'|trans }}</th>
                        <th scope="col">{{ 'quote_request.customer_notes'|trans }}</th>
                        <th scope="col">{{ 'quote_request.action'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for req in requests %}
                        <tr>
                            <td>{{ req.createdAt ? req.createdAt|date('Y-m-d H:i') : '—' }}</td>
                            <td>
                                {% if req.quote %}
                                    <a href="{{ path('quote_review_detail', {id: req.quote.id}) }}" class="rams-link rams-text--bold">
                                        {{ req.quote.quoteNumber }}
                                    </a>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td>{{ req.requestType|replace({'_': ' '})|title }}</td>
                            <td class="rams-font-mono">{{ req.requestedQuantity ?? '—' }}</td>
                            <td class="rams-font-mono">{{ req.estimatedTotal ? req.estimatedTotal ~ ' ' ~ req.currency : '—' }}</td>
                            <td>
                                {% set badge = req.status == 'new' ? 'warning' : (req.status == 'handled' ? 'success' : 'info') %}
                                <span class="rams-badge rams-badge--{{ badge }} rams-badge--small">
                                    {{ statuses[req.status] ?? req.status }}
                                </span>
                            </td>
                            <td class="rams-table__cell--truncate rams-w-280" title="{{ req.customerNotes }}">{{ req.customerNotes ?? '—' }}</td>
                            <td>
                                {% if req.status != 'handled' %}
                                    <form method="post" class="rams-flex rams-gap-2"
                                          action="{{ path('app_quote_request_status', {id: req.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('quote_request_status' ~ req.id) }}">
                                        {% if req.status == 'new' %}
                                            <input type="hidden" name="status" value="in_review">
                                            <button type="submit" class="rams-btn rams-btn--secondary rams-btn--sm">{{ 'quote_request.start_review'|trans }}</button>
                                        {% else %}
                                            <input type="hidden" name="status" value="handled">
                                            <input type="text" name="resolution_notes" class="rams-input"
                                                   placeholder="{{ 'quote_request.resolution'|trans }}" aria-label="{{ 'quote_request.resolution'|trans }}">
                                            <button type="submit" class="rams-btn rams-btn--primary rams-btn--sm">{{ 'quote_request.mark_handled'|trans }}</button>
                                        {% endif %}
                                    </form>
                                {% else %}
                                    <span class="rams-text--muted">
                                        {% if req.handledBy %}by {{ req.handledBy }}{% else %}—{% endif %}
                                    </span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
