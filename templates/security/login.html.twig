{% extends 'base_login.html.twig' %}

{% block title %}{{ 'auth.login.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-auth-module">
    {# Logo Section #}
    <div class="rams-auth-logo">
        <div class="rams-auth-logo__symbol">
            <img src="{{ asset('images/logo.png') }}" alt="{{ 'app.name'|trans }} logo" class="rams-logo-image" width="272" height="242"> 
        </div>
        <div class="rams-auth-logo__title">{{ 'app.name'|trans }}</div>
        <div class="rams-auth-logo__subtitle">{{ 'auth.login.subtitle'|trans }}</div>
    </div>
    
    {# Login Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <span class="rams-dymo">{{ 'auth.login.module_title'|trans }}</span>
        </div>
        
        <div class="rams-module__content">
            {# Error Alert #}
            {% if error %}
                <div class="rams-alert rams-alert--error rams-mb-4" role="alert">
                    <svg class="rams-alert__icon" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    <div class="rams-alert__content">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                </div>
            {% endif %}
            
            <form action="{{ path('app_login') }}" method="post" class="rams-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                
                {# Email Field #}
                <div class="rams-form__group">
                    <label for="email" class="rams-form__label">{{ 'auth.email'|trans }}</label>
                    <input type="email" 
                           id="email" 
                           name="_username" 
                           class="rams-form__input" 
                           value="{{ last_username }}"
                           autocomplete="email"
                           required
                           placeholder="{{ 'auth.email_placeholder'|trans }}"
                           aria-describedby="email-hint">
                    <span id="email-hint" class="rams-form__hint">{{ 'auth.email_hint'|trans }}</span>
                </div>
                
                {# Password Field #}
                <div class="rams-form__group">
                    <label for="password" class="rams-form__label">{{ 'auth.password'|trans }}</label>
                    <input type="password" 
                           id="password" 
                           name="_password" 
                           class="rams-form__input" 
                           autocomplete="current-password"
                           required
                           placeholder="{{ 'auth.password_placeholder'|trans }}">
                </div>
                
                {# Remember Me #}
                <div class="rams-form__group">
                    <label class="rams-form__checkbox">
                        <input type="checkbox" name="_remember_me" class="rams-form__checkbox-input">
                        <span class="rams-form__checkbox-label">{{ 'auth.remember_me'|trans }}</span>
                    </label>
                </div>
                
                {# Submit Button #}
                <div class="rams-form__group rams-mt-4">
                    <button type="submit" class="rams-btn rams-btn--primary rams-btn--full">
                        {{ 'auth.login.submit'|trans }}
                    </button>
                </div>
            </form>
        </div>
        
        <div class="rams-module__footer">
            <a href="{{ path('app_forgot_password') }}" class="rams-link">{{ 'auth.forgot_password_link'|trans }}</a>
        </div>
    </div>
    
    {# System Status #}
    <div class="rams-text--center rams-mt-4">
        <div class="rams-andon">
            <span class="rams-andon__light rams-andon__light--green"></span>
            <span class="rams-andon__text rams-andon__text--muted">{{ 'status_bar.system_online'|trans }}</span>
        </div>
    </div>
</div>
{% endblock %}
