{% extends 'base_login.html.twig' %}

{% block title %}Login - STARZ Morocco CRM{% endblock %}

{% block body %}
<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo-text">STARZ Morocco</div>
            <h2 class="login-title">Welcome Back</h2>
            <p class="login-subtitle">Sign in to your CRM account</p>
        </div>
        
        <form action="{{ path('app_login') }}" method="post">
            {% if error %}
                <div class="error-message">
                    <strong>Login Failed:</strong><br>
                    {% if error.messageKey == 'Invalid credentials.' %}
                        The email or password you entered is incorrect. Please try again.
                    {% else %}
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    {% endif %}
                </div>
            {% endif %}

            <div class="form-group">
                <label for="email" class="form-label">Email Address</label>
                <input id="email" 
                       name="_username" 
                       type="email" 
                       autocomplete="email" 
                       required 
                       class="form-input" 
                       placeholder="Enter your email"
                       value="{{ last_username }}"
                       autofocus>
            </div>
            
            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input id="password" 
                       name="_password" 
                       type="password" 
                       autocomplete="current-password" 
                       required 
                       class="form-input" 
                       placeholder="Enter your password">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-primary">
                Sign In
            </button>
        </form>
    </div>
</div>
{% endblock %}
