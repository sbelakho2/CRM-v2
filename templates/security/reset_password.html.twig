{% extends 'base_login.html.twig' %}

{% block title %}{{ 'auth.reset_password.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-auth-module">
    {# Logo Section #}
    <div class="rams-auth-logo">
        <div class="rams-auth-logo__symbol">
            <img src="{{ asset('images/logo.png') }}" alt="{{ 'app.name'|trans }} logo" class="rams-logo-image" width="272" height="242"> 
        </div>
        <div class="rams-auth-logo__title">{{ 'app.name'|trans }}</div>
        <div class="rams-auth-logo__subtitle">{{ 'auth.reset_password.subtitle'|trans }}</div>
    </div>
    
    {# Reset Password Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <span class="rams-dymo">{{ 'auth.reset_password.module_title'|trans }}</span>
        </div>
        
        <div class="rams-module__content">
            {# Error Message #}
            {% for message in app.flashes('error') %}
                <div class="rams-alert rams-alert--error rams-mb-4" role="alert">
                    <svg class="rams-alert__icon" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    <div class="rams-alert__content">{{ message }}</div>
                </div>
            {% endfor %}
            
            <form method="post" class="rams-form" id="reset-password-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
                {# New Password Field #}
                <div class="rams-form__group">
                    <label for="password" class="rams-form__label">{{ 'auth.new_password'|trans }}</label>
                    <input type="password" 
                           id="password" 
                           name="password" 
                           class="rams-form__input" 
                           autocomplete="new-password"
                           required
                           minlength="8"
                           placeholder="{{ 'auth.new_password_placeholder'|trans }}">
                    <span class="rams-form__hint">{{ 'auth.password_requirements'|trans }}</span>
                </div>
                
                {# Confirm Password Field #}
                <div class="rams-form__group">
                    <label for="confirm_password" class="rams-form__label">{{ 'auth.confirm_password'|trans }}</label>
                    <input type="password" 
                           id="confirm_password" 
                           name="confirm_password" 
                           class="rams-form__input" 
                           autocomplete="new-password"
                           required
                           minlength="8"
                           placeholder="{{ 'auth.confirm_password_placeholder'|trans }}">
                </div>
                
                {# Submit Button #}
                <div class="rams-form__group rams-mt-4">
                    <button type="submit" class="rams-btn rams-btn--primary rams-btn--full">
                        {{ 'auth.reset_password.submit'|trans }}
                    </button>
                </div>
            </form>
        </div>
        
        <div class="rams-module__footer">
            <a href="{{ path('app_login') }}" class="rams-link">{{ 'auth.back_to_login'|trans }}</a>
        </div>
    </div>
    
    {# System Status #}
    <div class="rams-text--center rams-mt-4">
        <div class="rams-andon">
            <span class="rams-andon__light rams-andon__light--green"></span>
            <span class="rams-andon__text rams-andon__text--muted">{{ 'status_bar.system_online'|trans }}</span>
        </div>
    </div>
</div>

<script>
    document.getElementById('reset-password-form').addEventListener('submit', function(e) {
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirm_password').value;
        
        // Remove any existing validation alert
        const existingAlert = document.getElementById('password-mismatch-alert');
        if (existingAlert) {
            existingAlert.remove();
        }
        
        if (password !== confirmPassword) {
            e.preventDefault();
            
            // Create Rams-styled alert element
            const alertDiv = document.createElement('div');
            alertDiv.id = 'password-mismatch-alert';
            alertDiv.className = 'rams-alert rams-alert--error rams-mb-4';
            alertDiv.setAttribute('role', 'alert');
            alertDiv.innerHTML = `
                <svg class="rams-alert__icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <div class="rams-alert__content">{{ 'validation.password_mismatch'|trans }}</div>
            `;
            
            // Insert alert before the form
            const form = document.getElementById('reset-password-form');
            form.parentNode.insertBefore(alertDiv, form);
            
            // Scroll to alert and focus on confirm password field
            alertDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
            document.getElementById('confirm_password').focus();
            
            return false;
        }
    });
</script>
{% endblock %}
