{% extends 'base_login.html.twig' %}

{% block title %}{{ 'auth.forgot_password.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-auth-module">
    {# Logo Section #}
    <div class="rams-auth-logo">
        <div class="rams-auth-logo__symbol">
            <img src="{{ asset('images/starz-mark.svg') }}" data-theme-src="light:/images/starz-mark.svg|dark:/images/starz-mark-inverse.svg" alt="{{ 'app.name'|trans }} logo" class="rams-logo-image" width="272" height="220"> 
        </div>
        <div class="rams-auth-logo__title">{{ 'app.name'|trans }}</div>
        <div class="rams-auth-logo__subtitle">{{ 'auth.forgot_password.subtitle'|trans }}</div>
    </div>
    
    {# Forgot Password Module #}
    <div class="rams-module">
        <div class="rams-module__header">
            <span class="rams-dymo">{{ 'auth.forgot_password.module_title'|trans }}</span>
        </div>
        
        <div class="rams-module__content">
            {# Success Message #}
            {% for message in app.flashes('success') %}
                <div class="rams-alert rams-alert--success rams-mb-4" role="alert">
                    <svg class="rams-alert__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <div class="rams-alert__content">{{ message }}</div>
                </div>
            {% endfor %}
            
            {# Error Message #}
            {% for message in app.flashes('error') %}
                <div class="rams-alert rams-alert--error rams-mb-4" role="alert">
                    <svg class="rams-alert__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    <div class="rams-alert__content">{{ message }}</div>
                </div>
            {% endfor %}
            
            <p class="rams-text--muted rams-mb-4">{{ 'auth.forgot_password.instructions'|trans }}</p>
            
            <form method="post" class="rams-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
                {# Email Field #}
                <div class="rams-form__group">
                    <label for="email" class="rams-form__label">{{ 'auth.email'|trans }}</label>
                    <input type="email" 
                           id="email" 
                           name="email" 
                           class="rams-form__input" 
                           autocomplete="email"
                           required
                           placeholder="{{ 'auth.email_placeholder'|trans }}">
                </div>
                
                {# Submit Button #}
                <div class="rams-form__group rams-mt-4">
                    <button type="submit" class="rams-btn rams-btn--primary rams-btn--full">
                        {{ 'auth.forgot_password.submit'|trans }}
                    </button>
                </div>
            </form>
        </div>
        
        <div class="rams-module__footer">
            <a href="{{ path('app_login') }}" class="rams-link">{{ 'auth.back_to_login'|trans }}</a>
        </div>
    </div>
    
    {# System Status #}
    <div class="rams-text--center rams-mt-4">
        <div class="rams-andon">
            <span class="rams-andon__light rams-andon__light--green"></span>
            <span class="rams-andon__text rams-andon__text--muted">{{ 'status_bar.system_online'|trans }}</span>
        </div>
    </div>
</div>
{% endblock %}
