{% extends 'base.html.twig' %}

{% block title %}{{ 'supplier.portal.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'supplier.portal.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'supplier.portal.subtitle'|trans }}</p>
        </div>
        <div class="rams-page-actions">
            <a href="#add-supplier" class="rams-btn rams-btn--primary">
                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 3V13M3 8H13"/>
                </svg>
                {{ 'supplier.portal.add_supplier'|trans }}
            </a>
        </div>
    </div>

    {# Add Supplier (Discover Portal) #}
    <div id="add-supplier" class="rams-module">
        <div class="rams-module__header">
            <h3>{{ 'supplier.portal.add_supplier'|trans }}</h3>
        </div>
        <div class="rams-module__content">
            <p class="rams-text--sm rams-text--muted rams-mb-3">{{ 'supplier.portal.add_supplier_help'|trans }}</p>
            <form method="post" action="{{ path('supplier_portal_discover') }}" class="rams-form rams-grid rams-grid--3">
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'supplier.portal.company_name'|trans }}</label>
                    <input type="text" name="company_name" class="rams-form__input" placeholder="{{ 'supplier.portal.company_name_placeholder'|trans }}" required>
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'supplier.portal.domain'|trans }}</label>
                    <input type="text" name="domain" class="rams-form__input" placeholder="{{ 'supplier.portal.domain_placeholder'|trans }}">
                </div>
                <div class="rams-form__group rams-form__group--actions">
                    <button type="submit" class="rams-btn rams-btn--primary rams-w-full">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="7" cy="7" r="4"/>
                            <path d="M11 11L14 14"/>
                        </svg>
                        {{ 'supplier.portal.discover'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Search and Filter #}
    <div class="rams-module">
        <div class="rams-module__content">
            <form class="rams-form rams-grid rams-grid--3">
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'common.search'|trans }}</label>
                    <input type="text" placeholder="{{ 'supplier.portal.search_placeholder'|trans }}" class="rams-form__input">
                </div>
                <div class="rams-form__group">
                    <label class="rams-form__label rams-dymo">{{ 'common.status'|trans }}</label>
                    <select class="rams-form__select">
                        <option value="">{{ 'supplier.portal.all_statuses'|trans }}</option>
                        <option value="active">{{ 'common.active'|trans }}</option>
                        <option value="inactive">{{ 'common.inactive'|trans }}</option>
                        <option value="pending">{{ 'supplier.portal.pending_approval'|trans }}</option>
                    </select>
                </div>
                <div class="rams-form__group rams-form__group--actions">
                    <button type="submit" class="rams-btn rams-w-full">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="7" cy="7" r="4"/>
                            <path d="M11 11L14 14"/>
                        </svg>
                        {{ 'common.filter'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Suppliers Table #}
    <div class="rams-module">
        <div class="rams-table-container">
            <table class="rams-table">
                <thead class="rams-table__header">
                    <tr>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'supplier.portal.name'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'common.contact'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'common.email'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'supplier.portal.region'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="rams-table__body">
                    {% if suppliers | default([]) %}
                        {% for supplier in suppliers %}
                            {% set status_raw = supplier.status|default('') %}
                            {% set status_label = status_raw == 'Active'
                                ? 'supplier.portal.status_active'|trans
                                : (status_raw == 'Pending'
                                    ? 'supplier.portal.status_pending'|trans
                                    : (status_raw == 'Inactive'
                                        ? 'supplier.portal.status_inactive'|trans
                                        : (status_raw ? status_raw : 'common.n_a'|trans))) %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell rams-text--bold">{{ supplier.name }}</td>
                                <td class="rams-table__cell">{{ supplier.contact_name | default('common.contact'|trans) }}</td>
                                <td class="rams-table__cell rams-text--muted rams-text--xs">{{ supplier.email | default('common.n_a'|trans) }}</td>
                                <td class="rams-table__cell">
                                    {% if status_raw == 'Active' %}
                                        <span class="rams-badge rams-badge--success">{{ status_label }}</span>
                                    {% elseif status_raw == 'Pending' %}
                                        <span class="rams-badge rams-badge--warning">{{ status_label }}</span>
                                    {% else %}
                                        <span class="rams-badge">{{ status_label }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell rams-text--xs">{{ supplier.region | default('common.n_a'|trans) }}</td>
                                <td class="rams-table__cell rams-table__cell--actions">
                                    <div class="rams-btn-group">
                                        <a href="{{ path('supplier_portal_detail', {id: supplier.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }}</a>
                                        <button class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.edit'|trans }}</button>
                                        <button class="rams-btn rams-btn--ghost rams-btn--sm rams-btn--danger">{{ 'common.delete'|trans }}</button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="rams-table__cell">
                                <div class="rams-empty-state">
                                    <svg class="rams-empty-state__icon" width="32" height="32" viewBox="0 0 16 16" fill="none" stroke="currentColor">
                                        <path d="M2 4L8 2L14 4V12L8 14L2 12V4Z" stroke-width="1.5"/>
                                        <path d="M2 4L8 6L14 4" stroke-width="1.5"/>
                                        <path d="M8 6V14" stroke-width="1.5"/>
                                    </svg>
                                    <h3 class="rams-empty-state__title">{{ 'supplier.portal.no_suppliers'|trans }}</h3>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    {# Pagination #}
    <div class="rams-flex rams-justify-between rams-items-center">
        <p class="rams-text--muted rams-text--xs">
            {{ 'common.showing'|trans }} <span class="rams-badge">{{ suppliers | length }}</span> {{ 'common.of'|trans }} 100+ {{ 'supplier.portal.suppliers'|trans }}
        </p>
        <div class="rams-btn-group">
            <button class="rams-btn rams-btn--sm">{{ 'common.previous'|trans }}</button>
            <button class="rams-btn rams-btn--sm">{{ 'common.next'|trans }}</button>
        </div>
    </div>
</div>
{% endblock %}
