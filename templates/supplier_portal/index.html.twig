{% extends 'base.html.twig' %}

{% block title %}{{ 'supplier.portal.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-stack--lg">
    {# Header #}
    <div class="rams-page-header">
        <div class="rams-page-header__row">
            <div>
                <h1 class="rams-heading rams-heading--1">{{ 'supplier.portal.title'|trans }}</h1>
                <p class="rams-text rams-text--muted">{{ 'supplier.portal.subtitle'|trans }}</p>
            </div>
            <a href="#" class="rams-btn rams-btn--secondary">
                + {{ 'supplier.portal.add_supplier'|trans }}
            </a>
        </div>
    </div>

    {# Search and Filter #}
    <div class="rams-module rams-module--compact">
        <div class="rams-module__content">
            <form class="rams-form--inline rams-grid rams-grid--cols-3 rams-grid--gap-md">
                <div class="rams-form__group">
                    <input type="text" placeholder="{{ 'supplier.portal.search_placeholder'|trans }}" class="rams-form__input">
                </div>
                <div class="rams-form__group">
                    <select class="rams-form__select">
                        <option value="">{{ 'supplier.portal.all_statuses'|trans }}</option>
                        <option value="active">{{ 'common.active'|trans }}</option>
                        <option value="inactive">{{ 'common.inactive'|trans }}</option>
                        <option value="pending">{{ 'supplier.portal.pending_approval'|trans }}</option>
                    </select>
                </div>
                <button type="submit" class="rams-btn rams-btn--secondary">
                    {{ 'common.filter'|trans }}
                </button>
            </form>
        </div>
    </div>

    {# Suppliers Table #}
    <div class="rams-module">
        <div class="rams-module__content rams-module__content--flush">
            <table class="rams-table">
                <thead class="rams-table__header">
                    <tr>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'supplier.portal.name'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'common.contact'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'common.email'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'common.status'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'supplier.portal.region'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header rams-text--right">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if suppliers | default([]) %}
                        {% for supplier in suppliers %}
                            <tr class="rams-table__row">
                                <td class="rams-table__cell rams-text--bold">{{ supplier.name }}</td>
                                <td class="rams-table__cell">{{ supplier.contact_name | default('Contact') }}</td>
                                <td class="rams-table__cell">{{ supplier.email | default('N/A') }}</td>
                                <td class="rams-table__cell">
                                    {% if supplier.status == 'Active' %}
                                        <span class="rams-badge rams-badge--green">{{ supplier.status }}</span>
                                    {% elseif supplier.status == 'Pending' %}
                                        <span class="rams-badge rams-badge--yellow">{{ supplier.status }}</span>
                                    {% else %}
                                        <span class="rams-badge rams-badge--gray">{{ supplier.status }}</span>
                                    {% endif %}
                                </td>
                                <td class="rams-table__cell">{{ supplier.region | default('N/A') }}</td>
                                <td class="rams-table__cell rams-text--right">
                                    <div class="rams-btn-group rams-btn-group--compact">
                                        <a href="{{ path('supplier_portal_detail', {id: supplier.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.view'|trans }}</a>
                                        <button class="rams-btn rams-btn--ghost rams-btn--sm">{{ 'common.edit'|trans }}</button>
                                        <button class="rams-btn rams-btn--ghost rams-btn--sm rams-text--danger">{{ 'common.remove'|trans }}</button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="rams-table__cell">
                                <div class="rams-empty-state">
                                    <div class="rams-empty-state__icon">📦</div>
                                    <p class="rams-text rams-text--muted">{{ 'supplier.portal.no_suppliers'|trans }}</p>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    {# Pagination #}
    <div class="rams-pagination">
        <p class="rams-text rams-text--sm rams-text--muted">
            {{ 'common.showing'|trans }} {{ suppliers | length }} {{ 'common.of'|trans }} 100+ {{ 'supplier.portal.suppliers'|trans }}
        </p>
        <div class="rams-btn-group">
            <button class="rams-btn rams-btn--secondary rams-btn--sm">{{ 'common.previous'|trans }}</button>
            <button class="rams-btn rams-btn--secondary rams-btn--sm">{{ 'common.next'|trans }}</button>
        </div>
    </div>
</div>
{% endblock %}
