{% extends 'base.html.twig' %}

{% block title %}{{ 'supplier.portal.details'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <nav class="rams-breadcrumb rams-mb-2">
                <ol class="rams-breadcrumb__list">
                    <li class="rams-breadcrumb__item"><a href="{{ path('supplier_portal_index') }}" class="rams-breadcrumb__link">{{ 'nav.supplier_portal'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ supplier.name }}</li>
                </ol>
            </nav>
            <h1 class="rams-page-title">{{ supplier.name }}</h1>
            <p class="rams-page-subtitle">{{ supplier.region }}</p>
        </div>
        <div class="rams-page-actions mobile-stack">
            {% set status_raw = supplier.status|default('') %}
            {% set status_label = status_raw == 'Active'
                ? 'supplier.portal.status_active'|trans
                : (status_raw == 'Pending'
                    ? 'supplier.portal.status_pending'|trans
                    : (status_raw == 'Inactive'
                        ? 'supplier.portal.status_inactive'|trans
                        : (status_raw ? status_raw : 'common.n_a'|trans))) %}
            <span class="rams-badge">{{   status_label }}</span>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack">
        {# Main Content #}
        <div class="rams-stack rams-gap-6 rams-grid-span-2 mobile-w-full">
            {# Supplier Header Metrics #}
            <div class="rams-module">
                <div class="rams-module__content">
                    <div class="rams-grid rams-grid--3 rams-gap-4">
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'supplier.portal.priority'|trans }}</span>
                            <span class="rams-metric__value rams-text--xl">{{ supplier.priority }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'supplier.portal.contact_name'|trans }}</span>
                            <span class="rams-metric__value rams-text--lg">{{ supplier.contact_name | default('common.n_a'|trans) }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'supplier.portal.portal_sla'|trans }}</span>
                            <span class="rams-metric__value rams-text--lg">{{ supplier.portal_sla_days | default('common.n_a'|trans) }}</span>
                            <span class="rams-metric__unit">{{ 'common.days'|trans|lower }}</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Company Information #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'supplier.portal.company_info'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-definition-list rams-grid rams-grid--2">
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'supplier.portal.website'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                <a href="{{ supplier.website }}" target="_blank" class="rams-link">{{ supplier.website | default('common.n_a'|trans) }}</a>
                            </dd>
                        </div>
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.email'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ supplier.email | default('common.n_a'|trans) }}</dd>
                        </div>
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'supplier.portal.portal_url'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                <a href="{{ supplier.portal_url }}" target="_blank" class="rams-link">{{ supplier.portal_url | default('common.n_a'|trans) }}</a>
                            </dd>
                        </div>
                        <div class="rams-definition-list__item rams-grid-span-2">
                            <dt class="rams-definition-list__term">{{ 'common.notes'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ supplier.notes | default('messages.no_notes'|trans) }}</dd>
                        </div>
                        <div class="rams-definition-list__item rams-grid-span-2">
                            <dt class="rams-definition-list__term">{{ 'supplier.portal.next_step'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ supplier.next_step | default('messages.no_next_step'|trans) }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# Compliance & NDA #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'supplier.portal.compliance_nda'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-3">
                        <div class="rams-flex rams-justify-between rams-items-center rams-p-3 rams-bg-panel rams-border rams-rounded">
                            <span class="rams-text--sm">{{ 'supplier.portal.compliance_required'|trans }}</span>
                            <span class="rams-text--bold rams-text--sm">{{ supplier.compliance_required | default('messages.not_specified'|trans) }}</span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center rams-p-3 rams-bg-panel rams-border rams-rounded">
                            <span class="rams-text--sm">{{ 'supplier.portal.compliance_provided'|trans }}</span>
                            <span class="rams-badge rams-badge--{% if supplier.compliance_provided %}success{% else %}danger{% endif %}">
                                {{ (supplier.compliance_provided ? 'common.yes' : 'common.no')|trans }}
                            </span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center rams-p-3 rams-bg-panel rams-border rams-rounded">
                            <span class="rams-text--sm">{{ 'supplier.portal.nda_sent'|trans }}</span>
                            <span class="rams-badge rams-badge--{% if supplier.nda_sent %}success{% else %}warning{% endif %}">
                                {{ (supplier.nda_sent ? 'common.yes' : 'common.no')|trans }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Sidebar #}
        <div class="rams-stack rams-gap-6 mobile-w-full">
            {# Performance Metrics #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'supplier.portal.performance'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-empty-state"> <svg class="rams-empty-state__icon" width="32" height="32" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"> <path d="M2 4L8 2L14 4V12L8 14L2 12V4Z" stroke-width="1.5"/> <path d="M2 4L8 6L14 4" stroke-width="1.5"/> <path d="M8 6V14" stroke-width="1.5"/> </svg> <p class="rams-empty-state__title rams-text--muted">{{ 'table.no_data'|trans }}</p>  
                        
                               
                                     
                                      
                            
                              
                                        
                            
                        
                        
                               
                                     
                                      
                            
                              
                                       
                            
                        
                          
                                 
                                  
                        
                    </div>
                </div>
            </div>

            {# Statistics #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'supplier.portal.statistics'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-empty-state"> <svg class="rams-empty-state__icon" width="32" height="32" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"> <path d="M2 4L8 2L14 4V12L8 14L2 12V4Z" stroke-width="1.5"/> <path d="M2 4L8 6L14 4" stroke-width="1.5"/> <path d="M8 6V14" stroke-width="1.5"/> </svg> <p class="rams-empty-state__title rams-text--muted">{{ 'table.no_data'|trans }}</p>  
                            
                                   
                                   
                        
                            
                                   
                                   
                        
                            
                                   
                                   
                        
                    </div>
                </div>
            </div>

            {# Quick Actions #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'common.actions'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-2">
                        {% if supplier.portal_url %} <a href="{{ supplier.portal_url }}" target="_blank" rel="noopener noreferrer"  class="rams-btn rams-btn--primary rams-w-full rams-no-underline rams-text--center"> 
                            {{ 'supplier.portal.view_portal'|trans }}
                        </a> {% endif %} {% if supplier.email %} <a href="mailto:{{ supplier.email }}" 
                         class="rams-btn rams-w-full rams-no-underline rams-text--center"> 
                            {{ 'supplier.portal.send_message'|trans }}
                        </a> {% endif %} 
                          
                              
                        
                            
                              
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
