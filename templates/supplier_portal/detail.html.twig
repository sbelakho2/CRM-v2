{% extends 'base.html.twig' %}

{% block title %}{{ 'supplier.portal.details'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <nav class="rams-breadcrumb rams-mb-2">
                <ol class="rams-breadcrumb__list">
                    <li class="rams-breadcrumb__item"><a href="{{ path('supplier_portal_index') }}" class="rams-breadcrumb__link">{{ 'nav.supplier_portal'|trans }}</a></li>
                    <li class="rams-breadcrumb__separator">/</li>
                    <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ supplier.name }}</li>
                </ol>
            </nav>
            <h1 class="rams-page-title">{{ supplier.name }}</h1>
            <p class="rams-page-subtitle">{{ supplier.region }}</p>
        </div>
        <div class="rams-page-actions">
            <span class="rams-badge rams-badge--lg">{{ supplier.status }}</span>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6">
        {# Main Content #}
        <div class="rams-stack rams-gap-6 rams-grid-span-2">
            {# Supplier Header Metrics #}
            <div class="rams-module">
                <div class="rams-module__content">
                    <div class="rams-grid rams-grid--3 rams-gap-4">
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'supplier.portal.priority'|trans }}</span>
                            <span class="rams-metric__value rams-rams-text--xl">{{ supplier.priority }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'supplier.portal.contact_name'|trans }}</span>
                            <span class="rams-metric__value rams-rams-text--lg">{{ supplier.contact_name | default('common.n_a'|trans) }}</span>
                        </div>
                        <div class="rams-metric">
                            <span class="rams-metric__label">{{ 'supplier.portal.portal_sla'|trans }}</span>
                            <span class="rams-metric__value rams-rams-text--lg">{{ supplier.portal_sla_days | default('common.n_a'|trans) }}</span>
                            <span class="rams-metric__unit">{{ 'common.days'|trans|lower }}</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Company Information #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'supplier.portal.company_info'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-definition-list rams-grid rams-grid--2">
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'supplier.portal.website'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                <a href="{{ supplier.website }}" target="_blank" class="rams-link">{{ supplier.website | default('common.n_a'|trans) }}</a>
                            </dd>
                        </div>
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.email'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ supplier.email | default('common.n_a'|trans) }}</dd>
                        </div>
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'supplier.portal.portal_url'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                <a href="{{ supplier.portal_url }}" target="_blank" class="rams-link">{{ supplier.portal_url | default('common.n_a'|trans) }}</a>
                            </dd>
                        </div>
                        <div class="rams-definition-list__item rams-grid-span-2">
                            <dt class="rams-definition-list__term">{{ 'common.notes'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ supplier.notes | default('messages.no_notes'|trans) }}</dd>
                        </div>
                        <div class="rams-definition-list__item rams-grid-span-2">
                            <dt class="rams-definition-list__term">{{ 'supplier.portal.next_step'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ supplier.next_step | default('messages.no_next_step'|trans) }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# Compliance & NDA #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'supplier.portal.compliance_nda'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-3">
                        <div class="rams-flex rams-justify-between rams-items-center rams-p-3 rams-bg-panel rams-border rams-rounded">
                            <span class="rams-rams-text--sm">{{ 'supplier.portal.compliance_required'|trans }}</span>
                            <span class="rams-text-bold rams-rams-text--sm">{{ supplier.compliance_required | default('messages.not_specified'|trans) }}</span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center rams-p-3 rams-bg-panel rams-border rams-rounded">
                            <span class="rams-rams-text--sm">{{ 'supplier.portal.compliance_provided'|trans }}</span>
                            <span class="rams-badge rams-badge--{% if supplier.compliance_provided %}success{% else %}danger{% endif %}">
                                {{ (supplier.compliance_provided ? 'common.yes' : 'common.no')|trans }}
                            </span>
                        </div>
                        <div class="rams-flex rams-justify-between rams-items-center rams-p-3 rams-bg-panel rams-border rams-rounded">
                            <span class="rams-rams-text--sm">{{ 'supplier.portal.nda_sent'|trans }}</span>
                            <span class="rams-badge rams-badge--{% if supplier.nda_sent %}success{% else %}warning{% endif %}">
                                {{ (supplier.nda_sent ? 'common.yes' : 'common.no')|trans }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Sidebar #}
        <div class="rams-stack rams-gap-6">
            {# Performance Metrics #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'supplier.portal.performance'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-4">
                        <div>
                            <div class="rams-flex rams-justify-between rams-mb-1">
                                <span class="rams-rams-text--xs rams-rams-text--muted uppercase">{{ 'supplier.portal.on_time_delivery'|trans }}</span>
                                <span class="rams-rams-text--xs rams-text-bold">{{ supplier.on_time_rate | default(95) }}%</span>
                            </div>
                            <div class="rams-progress rams-progress--compact">
                                <div class="rams-progress__bar rams-progress__bar--success" style="width: {{ supplier.on_time_rate | default(95) }}%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="rams-flex rams-justify-between rams-mb-1">
                                <span class="rams-rams-text--xs rams-rams-text--muted uppercase">{{ 'supplier.portal.quality_score'|trans }}</span>
                                <span class="rams-rams-text--xs rams-text-bold">{{ supplier.quality_score | default(88) }}/100</span>
                            </div>
                            <div class="rams-progress rams-progress--compact">
                                <div class="rams-progress__bar" style="width: {{ supplier.quality_score | default(88) }}%"></div>
                            </div>
                        </div>
                        <div class="rams-flex rams-justify-between">
                            <span class="rams-rams-text--xs rams-rams-text--muted uppercase">{{ 'supplier.portal.response_time'|trans }}</span>
                            <span class="rams-rams-text--xs rams-text-bold">{{ supplier.response_time | default('2h') }}</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Statistics #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'supplier.portal.statistics'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-2">
                        <div class="rams-module rams-module--inset rams-p-3 rams-bg-info-subtle">
                            <span class="rams-text-2xs rams-rams-text--info uppercase rams-mb-1 rams-block">{{ 'supplier.portal.total_orders'|trans }}</span>
                            <span class="rams-metric__value rams-rams-text--info rams-text-2xl">{{ supplier.total_orders | default(0) }}</span>
                        </div>
                        <div class="rams-module rams-module--inset rams-p-3 rams-bg-success-subtle">
                            <span class="rams-text-2xs rams-rams-text--success uppercase rams-mb-1 rams-block">{{ 'supplier.portal.total_spent'|trans }}</span>
                            <span class="rams-metric__value rams-rams-text--success rams-text-2xl">{{ supplier.total_spent|default(0)|format_currency(supplier.total_spent_currency|default(supplier.currency|default(display_currency())), null, 0) }}</span>
                        </div>
                        <div class="rams-module rams-module--inset rams-p-3 rams-bg-warning-subtle">
                            <span class="rams-text-2xs rams-rams-text--warning uppercase rams-mb-1 rams-block">{{ 'supplier.portal.avg_order_value'|trans }}</span>
                            <span class="rams-metric__value rams-rams-text--warning rams-text-2xl">{{ supplier.avg_order_value|default(0)|format_currency(supplier.avg_order_value_currency|default(supplier.currency|default(display_currency())), null, 0) }}</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Quick Actions #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'common.actions'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-2">
                        <button class="rams-btn--primary rams-w-full">
                            {{ 'supplier.portal.view_portal'|trans }}
                        </button>
                        <button class="rams-btn rams-w-full">
                            {{ 'supplier.portal.send_message'|trans }}
                        </button>
                        <button class="rams-btn rams-w-full">
                            {{ 'supplier.portal.edit_details'|trans }}
                        </button>
                        <button class="rams-btn--danger rams-btn--ghost rams-w-full">
                            {{ 'supplier.portal.deactivate'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
