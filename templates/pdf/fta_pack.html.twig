{# PDF FTA Pack Template - Sensei-Rams Industrial Functionalist Design System #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ 'pdf.fta.title'|trans }} - {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}</title>
    {% include 'pdf/base.css.twig' %}
    <style>
        .fta-header {
            background: var(--rams-dark);
            color: white;
            padding: 15pt;
            margin: -15pt -15pt 15pt -15pt;
        }
        .fta-header h1 {
            color: white;
            border-bottom: none;
            margin: 0;
            font-size: 18pt;
        }
        .fta-badge {
            display: inline-block;
            padding: 4pt 12pt;
            border-radius: 3pt;
            font-size: 9pt;
            font-weight: bold;
            text-transform: rams-uppercase;
            letter-spacing: 0.05em;
        }
        .fta-eligible { background: #2D8C3C; color: white; }
        .fta-partial { background: #FFBE00; color: #1A1A1A; }
        .fta-ineligible { background: #D62D2D; color: white; }
        .fta-pending { background: #4A90E2; color: white; }
        .country-flag {
            display: inline-block;
            width: 24pt;
            height: 16pt;
            background: var(--rams-panel);
            border: 1pt solid var(--rams-border);
            vertical-align: middle;
            margin-right: 5pt;
            text-align: center;
            font-size: 8pt;
            line-height: 16pt;
        }
        .origin-card {
            border: 1px solid var(--rams-border);
            margin: 12pt 0;
            background: white;
        }
        .origin-card-header {
            background: var(--rams-panel);
            padding: 10pt 12pt;
            border-bottom: 1px solid var(--rams-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .origin-card-body {
            padding: 12pt;
        }
        .tariff-table th {
            background: var(--rams-dark);
        }
        .savings-highlight {
            background: #e8f5ea;
            border: 2px solid #2D8C3C;
            padding: 15pt;
            margin: 15pt 0;
            border-radius: 3pt;
        }
        .savings-value {
            font-size: 28pt;
            font-weight: bold;
            color: #2D8C3C;
        }
        .savings-label {
            font-size: 10pt;
            color: var(--rams-muted);
            text-transform: rams-uppercase;
            letter-spacing: 0.05em;
        }
        .rule-box {
            background: var(--rams-panel);
            border-left: 4px solid var(--rams-orange);
            padding: 10pt 12pt;
            margin: 10pt 0;
        }
        .rule-box strong {
            color: var(--rams-foreground);
        }
        .rule-box code {
            background: var(--rams-dark);
            color: var(--rams-orange);
            padding: 2pt 4pt;
            border-radius: 2pt;
            font-family: 'Courier New', monospace;
            font-size: 9pt;
        }
        .declaration-box {
            border: 2px solid var(--rams-dark);
            padding: 15pt;
            margin: 15pt 0;
            background: white;
        }
        .declaration-title {
            font-size: 12pt;
            font-weight: bold;
            text-transform: rams-uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 10pt;
            padding-bottom: 5pt;
            border-bottom: 1px solid var(--rams-border);
        }
        .signature-area {
            display: flex;
            gap: 20pt;
            margin-top: 20pt;
        }
        .signature-line {
            flex: 1;
            border-top: 1pt solid var(--rams-dark);
            padding-top: 5pt;
        }
        .stats-row {
            display: flex;
            gap: 10pt;
            margin: 15pt 0;
        }
        .stat-item {
            flex: 1;
            background: var(--rams-panel);
            padding: 12pt;
            text-align: center;
            border-bottom: 3px solid var(--rams-orange);
        }
        .stat-value {
            font-size: 20pt;
            font-weight: bold;
            color: var(--rams-foreground);
        }
        .stat-label {
            font-size: 8pt;
            color: var(--rams-muted);
            text-transform: rams-uppercase;
        }
        .checklist-item {
            display: flex;
            gap: 8pt;
            padding: 6pt 0;
            border-bottom: 1px dashed var(--rams-border);
        }
        .checklist-item:last-child {
            border-bottom: none;
        }
        .check-box {
            width: 14pt;
            height: 14pt;
            border: 1.5pt solid var(--rams-dark);
            border-radius: 2pt;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10pt;
            flex-shrink: 0;
        }
        .check-box.checked {
            background: #2D8C3C;
            border-color: #2D8C3C;
            color: white;
        }
        .check-box.failed {
            background: #D62D2D;
            border-color: #D62D2D;
            color: white;
        }
    </style>
</head>
<body>
    <div class="fta-header">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h1>{{ 'pdf.fta.pack_title'|trans }}</h1>
            <span class="fta-badge fta-{{ ftaData.status ?? 'pending' }}">{{ (ftaData.statusLabel ?? 'common.pending'|trans)|upper }}</span>
        </div>
        <p style="margin: 8pt 0 0 0; color: #ccc; font-size: 9pt;">
            {{ 'pdf.quote.quote_number'|trans }}: {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }} • 
            {{ 'common.company'|trans }}: {{ quote.company.name ?? 'common.n_a'|trans }} • 
            {{ 'pdf.fta.export_date'|trans|default('Export Date') }}: {{ ftaData.exportDate ?? 'common.tbd'|trans|default('TBD') }}
        </p>
    </div>

    {# Agreement Summary #}
    <h3>{{ 'pdf.fta.agreement_summary'|trans }}</h3>
    
    <table>
        <tr>
            <td style="width: 25%; background: var(--rams-panel);"><strong>{{ 'pdf.fta.agreement'|trans }}</strong></td>
            <td style="width: 25%;">{{ ftaData.agreementName ?? 'common.n_a'|trans }}</td>
            <td style="width: 25%; background: var(--rams-panel);"><strong>{{ 'pdf.fta.origin_country'|trans }}</strong></td>
            <td style="width: 25%;"><span class="country-flag">{{ ftaData.originFlag ?? '--' }}</span> {{ ftaData.originCountry ?? 'common.n_a'|trans }}</td>
        </tr>
        <tr>
            <td style="background: var(--rams-panel);"><strong>{{ 'pdf.fta.destination'|trans }}</strong></td>
            <td><span class="country-flag">{{ ftaData.destFlag ?? '--' }}</span> {{ ftaData.destination ?? 'common.n_a'|trans }}</td>
            <td style="background: var(--rams-panel);"><strong>{{ 'pdf.fta.hs_code'|trans }}</strong></td>
            <td>{{ ftaData.hsCode ?? 'common.n_a'|trans }} - {{ ftaData.hsDescription ?? 'common.n_a'|trans }}</td>
        </tr>
        <tr>
            <td style="background: var(--rams-panel);"><strong>{{ 'pdf.fta.normal_tariff'|trans }}</strong></td>
            <td>{{ ftaData.normalTariff ?? '0.0' }}%</td>
            <td style="background: var(--rams-panel);"><strong>{{ 'pdf.fta.fta_tariff'|trans }}</strong></td>
            <td style="color: #2D8C3C; font-weight: bold;">{{ ftaData.ftaTariff ?? '0.0' }}%</td>
        </tr>
    </table>

    {# Potential Savings #}
    {% set savings = ftaData.potentialSavings ?? 0 %}
    {% if savings > 0 %}
    <div class="savings-highlight">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div class="savings-label">{{ 'pdf.fta.potential_savings'|trans }}</div>
                <div class="savings-value">${{ savings|number_format(2) }}</div>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 9pt; color: var(--rams-muted);">{{ 'common.value'|trans }}: ${{ (ftaData.declaredValue ?? 0)|number_format(2) }}</div>
                <div style="font-size: 12pt; font-weight: bold; color: #2D8C3C;">{{ ftaData.savingsPercent ?? 0 }}% {{ 'pdf.fta.duty_avoided'|trans|default('duty avoided') }}</div>
            </div>
        </div>
    </div>
    {% endif %}

    {# Qualification Statistics #}
    <div class="stats-row">
        <div class="stat-item">
            <div class="stat-value">{{ ftaData.originatingParts ?? 0 }}</div>
            <div class="stat-label">{{ 'pdf.fta.originating'|trans }}</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">{{ ftaData.nonOriginatingParts ?? 0 }}</div>
            <div class="stat-label">{{ 'pdf.fta.non_originating'|trans }}</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">{{ (ftaData.rvcPercent ?? 0)|number_format(1) }}%</div>
            <div class="stat-label">{{ 'pdf.fta.rvc'|trans }}</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">{{ ftaData.originCriteria ?? 'common.n_a'|trans }}</div>
            <div class="stat-label">{{ 'pdf.fta.origin_criteria'|trans }}</div>
        </div>
    </div>

    {# Rules of Origin #}
    <h3>{{ 'pdf.fta.rules'|trans }}</h3>
    
    <div class="rule-box">
        <strong>{{ 'pdf.fta.product_rule'|trans }}:</strong><br>
        <span style="font-size: 9pt; color: var(--rams-muted);">
            {{ ftaData.productRule ?? 'pdf.fta.rule_not_defined'|trans|default('Product-specific rule not defined for this HS code.') }}
        </span>
    </div>

    <div class="rule-box">
        <strong>{{ 'pdf.fta.method_used'|trans }}:</strong> {{ ftaData.qualificationMethod ?? 'common.n_a'|trans }}<br>
        <code>RVC = ((NC - VNM) / NC) × 100</code><br>
        <span style="font-size: 9pt; color: var(--rams-muted);">
            {{ 'pdf.fta.method_desc'|trans|default('Where NC = Net Cost, VNM = Value of Non-Originating Materials') }}
        </span>
    </div>

    {# Origin Determination by Component #}
    <h3>{{ 'pdf.fta.component_analysis'|trans }}</h3>
    
    <table>
        <thead>
            <tr>
                <th style="width: 5%;">#</th>
                <th style="width: 18%;">{{ 'pdf.quote.mpn'|trans }}</th>
                <th style="width: 15%;">{{ 'pdf.fta.manufacturer'|trans }}</th>
                <th style="width: 10%;">{{ 'pdf.fta.coo'|trans }}</th>
                <th class="rams-text--right" style="width: 12%;">{{ 'pdf.fta.value'|trans }}</th>
                <th class="rams-text--center" style="width: 12%;">{{ 'pdf.fta.origin_status'|trans }}</th>
                <th style="width: 28%;">{{ 'pdf.fta.notes'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for part in ftaData.components ?? [] %}
            <tr>
                <td class="rams-text--center">{{ loop.index }}</td>
                <td><strong>{{ part.mpn ?? 'common.n_a'|trans }}</strong></td>
                <td>{{ part.manufacturer ?? 'common.n_a'|trans }}</td>
                <td class="rams-text--center"><span class="country-flag">{{ part.cooFlag ?? '--' }}</span></td>
                <td class="rams-text--right">${{ (part.value ?? 0)|number_format(2) }}</td>
                <td class="rams-text--center"><span class="fta-badge fta-{{ part.status ?? 'pending' }}">{{ (part.statusLabel ?? 'common.tbd'|trans)|upper }}</span></td>
                <td>{{ part.notes ?? '-' }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" class="rams-text--center" style="padding: 15pt; color: var(--rams-muted);">
                    {{ 'pdf.fta.no_data'|trans }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {# RVC Calculation #}
    <h3>{{ 'pdf.fta.rvc_calculation'|trans }}</h3>
    
    <table>
        <tr>
            <td style="width: 60%; background: var(--rams-panel);"><strong>{{ 'pdf.fta.net_cost'|trans }}</strong></td>
            <td class="rams-text--right" style="width: 40%;">${{ (ftaData.netCost ?? 0)|number_format(2) }}</td>
        </tr>
        <tr>
            <td style="background: var(--rams-panel);"><strong>{{ 'pdf.fta.vnm'|trans }}</strong></td>
            <td class="rams-text--right">${{ (ftaData.vnm ?? 0)|number_format(2) }}</td>
        </tr>
        <tr>
            <td style="background: var(--rams-panel);"><strong>{{ 'pdf.fta.originating_value'|trans }}</strong></td>
            <td class="rams-text--right">${{ (ftaData.originatingValue ?? 0)|number_format(2) }}</td>
        </tr>
        <tr class="total-row">
            <td><strong>{{ 'pdf.fta.rvc_result'|trans }}</strong></td>
            <td class="rams-text--right">{{ (ftaData.rvcPercent ?? 0)|number_format(1) }}%</td>
        </tr>
        <tr>
            <td style="background: var(--rams-panel);"><strong>{{ 'pdf.fta.threshold'|trans }}</strong></td>
            <td class="rams-text--right">{{ ftaData.rvcThreshold ?? 0 }}%</td>
        </tr>
        <tr>
            <td style="background: #e8f5ea;"><strong style="color: #2D8C3C;">{{ 'pdf.fta.qualification'|trans }}</strong></td>
            <td class="rams-text--right" style="background: #e8f5ea; color: #2D8C3C; font-weight: bold;">{{ ftaData.qualificationStatus ?? 'pdf.fta.not_qualified'|trans|default('DOES NOT QUALIFY') }}</td>
        </tr>
    </table>

    {# Documentation Checklist #}
    <h3>{{ 'pdf.fta.checklist'|trans }}</h3>
    
    <div style="background: var(--rams-panel); padding: 12pt; border-radius: 3pt;">
        {% for item in ftaData.checklist ?? [] %}
        <div class="checklist-item">
            <div class="check-box {{ item.checked ? 'checked' : '' }}">{{ item.checked ? '✓' : '' }}</div>
            <div style="flex: 1;">
                <strong>{{ item.title ?? 'pdf.fta.document'|trans }}</strong><br>
                <span style="font-size: 9pt; color: var(--rams-muted);">{{ item.description ?? '' }}</span>
            </div>
        </div>
        {% else %}
        <div style="padding: 10pt; text-align: center; color: var(--rams-muted);">
            {{ 'pdf.fta.no_data'|trans }}
        </div>
        {% endfor %}
    </div>

    {# Certification Statement #}
    <div class="declaration-box" style="page-break-inside: avoid;">
        <div class="declaration-title">{{ 'pdf.fta.certification_title'|trans }}</div>
        
        <p style="font-size: 9pt; margin: 0 0 10pt 0;">
            {{ 'pdf.fta.certification_text'|trans }}
        </p>
        
        <table style="margin: 10pt 0; border: none;">
            <tr>
                <td style="border: none; width: 50%; padding: 3pt;">
                    <strong>{{ 'pdf.fta.certifier_name'|trans }}:</strong> {{ ftaData.certifierName ?? '_________________________' }}
                </td>
                <td style="border: none; width: 50%; padding: 3pt;">
                    <strong>{{ 'pdf.fta.certifier_title'|trans }}:</strong> {{ ftaData.certifierTitle ?? '_________________________' }}
                </td>
            </tr>
            <tr>
                <td style="border: none; padding: 3pt;">
                    <strong>{{ 'pdf.fta.company_name'|trans }}:</strong> {{ ftaData.certifierCompany ?? 'app.company'|trans }}
                </td>
                <td style="border: none; padding: 3pt;">
                    <strong>{{ 'pdf.fta.date'|trans }}:</strong> {{ ftaData.certificationDate ?? '_________________________' }}
                </td>
            </tr>
        </table>
        
        <div class="signature-area">
            <div class="signature-line">
                <div style="font-size: 8pt; color: var(--rams-muted); text-transform: rams-uppercase;">{{ 'pdf.fta.signature'|trans }}</div>
            </div>
            <div style="width: 150pt; text-align: center; border-top: 1pt solid var(--rams-dark); padding-top: 5pt;">
                <div style="font-size: 8pt; color: var(--rams-muted); text-transform: rams-uppercase;">{{ 'pdf.fta.date'|trans }}</div>
            </div>
        </div>
    </div>

    <div class="footer">
        <strong>{{ 'app.company'|trans }}</strong> • {{ 'pdf.fta.footer'|trans }}<br>
        {{ 'pdf.generated_on'|trans }}: {{ "now"|date('Y-m-d H:i') }} UTC • {{ 'pdf.fta.disclaimer'|trans }}
    </div>
</body>
</html>
