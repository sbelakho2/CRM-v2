{# PDF Exceptions Report Template - Sensei-Rams Industrial Functionalist Design System #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ 'pdf.exceptions.title'|trans }} - {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}</title>
    {% include 'pdf/base.css.twig' %}
    <style>
        .exception-card {
            border: 1px solid var(--rams-border);
            margin: 12pt 0;
            page-break-inside: avoid;
        }
        .exception-header {
            background: var(--rams-dark);
            color: white;
            padding: 8pt 12pt;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .exception-header h4 {
            margin: 0;
            color: white;
            font-size: 10pt;
        }
        .exception-body {
            padding: 12pt;
            background: white;
        }
        .exception-type {
            display: inline-block;
            padding: 2pt 8pt;
            border-radius: 2pt;
            font-size: 8pt;
            font-weight: bold;
            text-transform: uppercase; 
        }
        .type-no-stock { background: #D62D2D; color: white; }
        .type-long-lead { background: #FFBE00; color: #1A1A1A; }
        .type-eol { background: #8B4513; color: white; }
        .type-moq { background: #4A90E2; color: white; }
        .type-price { background: #9C27B0; color: white; }
        .type-alt-required { background: #FF5722; color: white; }
        .type-custom { background: #607D8B; color: white; }
        .alt-section {
            background: var(--rams-panel);
            border-left: 3px solid var(--rams-orange);
            padding: 10pt;
            margin-top: 10pt;
        }
        .alt-section h5 {
            margin: 0 0 8pt 0;
            font-size: 9pt;
            text-transform: uppercase; 
            letter-spacing: 0.05em;
            color: var(--rams-foreground);
        }
        .alt-part {
            display: flex;
            gap: 10pt;
            padding: 5pt 0;
            border-bottom: 1px dashed var(--rams-border);
        }
        .alt-part:last-child {
            border-bottom: none;
        }
        .summary-grid {
            display: flex;
            gap: 12pt;
            margin: 15pt 0;
        }
        .summary-item {
            flex: 1;
            background: var(--rams-panel);
            padding: 10pt;
            text-align: center;
            border-bottom: 3px solid var(--rams-orange);
        }
        .summary-value {
            font-size: 20pt;
            font-weight: bold;
            color: var(--rams-foreground);
        }
        .summary-label {
            font-size: 8pt;
            color: var(--rams-muted);
            text-transform: uppercase; 
            letter-spacing: 0.05em;
        }
        .impact-high { color: #D62D2D; }
        .impact-medium { color: #FFBE00; }
        .impact-low { color: #2D8C3C; }
        .action-required {
            background: #fff8e5;
            border: 1px solid #FFBE00;
            padding: 8pt 12pt;
            margin: 10pt 0;
            border-radius: 3pt;
        }
        .action-required strong {
            color: #b38600;
        }
        .resolution-option {
            background: white;
            border: 1px solid var(--rams-border);
            padding: 8pt;
            margin: 5pt 0;
            border-radius: 2pt;
        }
        .resolution-option:hover {
            border-color: var(--rams-orange);
        }
        .option-label {
            font-weight: 600;
            color: var(--rams-foreground);
        }
        .option-impact {
            font-size: 8pt;
            color: var(--rams-muted);
            margin-top: 3pt;
        }
    </style>
</head>
<body>
    <div class="header clearfix">
        <div style="float: left;">
            <h2>{{ issuer.name|default('app.company'|trans) }}</h2>
            <p>{{ 'pdf.exceptions.subtitle'|trans }}</p>
        </div>
        <div class="doc-info">
            <strong>{{ 'pdf.exceptions.report'|trans }}</strong>
            Quote: {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}<br>
            Date: {{ "now"|date('Y-m-d') }}<br>
            Status: {{ (quote.status ?? 'draft')|upper }}
        </div>
        <div style="clear: both;"></div>
    </div>

    {# Executive Summary #}
    <h3>{{ 'pdf.exceptions.summary'|trans }}</h3>
    
    <div class="summary-grid">
        <div class="summary-item">
            <div class="summary-value impact-high">{{ exceptionData.criticalCount ?? 0 }}</div>
            <div class="summary-label">{{ 'pdf.exceptions.critical'|trans }}</div>
        </div>
        <div class="summary-item">
            <div class="summary-value impact-medium">{{ exceptionData.warningCount ?? 0 }}</div>
            <div class="summary-label">{{ 'pdf.exceptions.warnings'|trans }}</div>
        </div>
        <div class="summary-item">
            <div class="summary-value">{{ exceptionData.totalExceptions ?? 0 }}</div>
            <div class="summary-label">{{ 'pdf.exceptions.total'|trans }}</div>
        </div>
        <div class="summary-item">
            <div class="summary-value">{{ (exceptionData.impactValue ?? 0)|format_currency(quote.currency|default('USD'), quote.currency|default('USD'), 2) }}</div>
            <div class="summary-label">{{ 'pdf.exceptions.impact'|trans }}</div>
        </div>
    </div>

    {% if exceptionData.actionRequired is defined and exceptionData.actionRequired %}
    <div class="action-required">
        <strong>⚠ {{ 'pdf.exceptions.action_required'|trans }}:</strong>
        {{ exceptionData.actionSummary|default('pdf.exceptions.action_summary_default'|trans) }}
    </div>
    {% endif %}

    {# Exception Categories Summary #}
    <h3>{{ 'pdf.exceptions.by_category'|trans }}</h3>
    <table aria-label="{{ 'pdf.exceptions.by_category'|trans }}">
        <thead>
            <tr>
                <th scope="col" style="width: 25%;">{{ 'pdf.exceptions.category'|trans }}</th>
                <th scope="col" class="rams-text--center" style="width: 10%;">{{ 'pdf.exceptions.count'|trans }}</th>
                <th scope="col" style="width: 25%;">{{ 'pdf.exceptions.impact_level'|trans }}</th>
                <th scope="col" class="rams-text--right" style="width: 20%;">{{ 'pdf.exceptions.cost_impact'|trans }}</th>
                <th scope="col" class="rams-text--right" style="width: 20%;">{{ 'pdf.exceptions.lead_impact'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for category in exceptionData.categories   %}
            <tr>
                <td><span class="exception-type type-{{ category.type }}">{{ category.name   }}</span></td>
                <td class="rams-text--center">{{ category.count   }}</td>
                <td><span class="impact-{{ category.impact }}">{{ category.impact|capitalize  }}</span></td>
                <td class="rams-text--right">{% if category.costImpact > 0   %}{{ category.costImpact|format_currency(quote.currency|default('USD'), quote.currency|default('USD'), 2) }}{% else %}—{% endif %}</td>
                <td class="rams-text--right">{% if category.leadImpact > 0   %}+{{ category.leadImpact }} {{ 'common.days'|trans }}{% else %}—{% endif %}</td>
            </tr>
            {% else %}
            <tr>
                    
                <td colspan="5" class="rams-text--center" style="padding: 15pt; color: var(--rams-muted);"> 
                   
                 
                  {{ 'pdf.exceptions.no_exceptions'|trans }} </td>  
            
            
                    
                 
                   
                 
                    
            
            
                    
                 
                   
                 
                    
            
            
                    
                 
                   
                 
                 
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Detailed Exceptions #}
    <h3>{{ 'pdf.exceptions.detailed'|trans }}</h3>
    
    {% for exception in exceptions ?? [] %}
    <div class="exception-card">
        <div class="exception-header">
            <h4>{{ 'pdf.exceptions.line'|trans }} {{ exception.lineNumber ?? loop.index }}: {{ exception.mpn ?? 'pdf.exceptions.unknown_mpn'|trans }}</h4>
            <span class="exception-type type-{{ exception.type ?? 'custom' }}">{{ exception.typeName ?? 'pdf.exceptions.exception'|trans }}</span>
        </div>
        <div class="exception-body">
            <table style="margin: 0; border: none;">
                <tr>
                    <td style="border: none; padding: 2pt 10pt 2pt 0; width: 120pt;"><strong>{{ 'pdf.exceptions.manufacturer'|trans }}:</strong></td>
                    <td style="border: none; padding: 2pt 0;">{{ exception.manufacturer ?? 'common.n_a'|trans }}</td>
                    <td style="border: none; padding: 2pt 10pt 2pt 0; width: 120pt;"><strong>{{ 'pdf.exceptions.required_qty'|trans }}:</strong></td>
                    <td style="border: none; padding: 2pt 0;">{{ exception.requiredQty ?? 0 }}</td>
                </tr>
                <tr>
                    <td style="border: none; padding: 2pt 10pt 2pt 0;"><strong>{{ 'pdf.exceptions.description'|trans }}:</strong></td>
                    <td style="border: none; padding: 2pt 0;" colspan="3">{{ exception.description ?? 'common.n_a'|trans }}</td>
                </tr>
                <tr>
                    <td style="border: none; padding: 2pt 10pt 2pt 0;"><strong>{{ 'pdf.exceptions.issue'|trans }}:</strong></td>
                    <td style="border: none; padding: 2pt 0;" colspan="3"><span class="impact-{{ exception.severity ?? 'medium' }}">{{ exception.issue ?? 'pdf.exceptions.requires_resolution'|trans }}</span></td>
                </tr>
            </table>

            {# Resolution Options #}
            {% if exception.resolutionOptions is defined and exception.resolutionOptions|length > 0 %}
            <div class="alt-section">
                <h5>{{ 'pdf.exceptions.resolution_options'|trans }}</h5>
                {% for option in exception.resolutionOptions %}
                <div class="resolution-option">
                    <div class="option-label">{{ loop.index }}. {{ option.name ?? 'pdf.exceptions.option'|trans }}</div>
                    <div class="option-impact">
                        {% if option.costDelta is defined %}{{ 'common.price'|trans }}: {% if option.costDelta >= 0 %}+{% endif %}{{ option.costDelta|format_currency(quote.currency|default('USD'), quote.currency|default('USD'), 2) }} | {% endif %}
                        {% if option.leadDelta is defined %}{{ 'pdf.exceptions.lead_impact'|trans }}: {% if option.leadDelta >= 0 %}+{% endif %}{{ option.leadDelta }} {{ 'common.days'|trans }} | {% endif %}
                        {{ option.notes ?? '' }}
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}

            {# Alternative Parts #}
            {% if exception.alternatives is defined and exception.alternatives|length > 0 %}
            <div class="alt-section">
                <h5>{{ 'pdf.exceptions.alternatives'|trans }}</h5>
                {% for alt in exception.alternatives %}
                <div class="alt-part">
                    <div style="flex: 1;">
                        <strong>{{ alt.mpn ?? 'common.n_a'|trans }}</strong><br>
                        <span style="font-size: 8pt; color: var(--rams-muted);">{{ alt.manufacturer ?? 'common.n_a'|trans }}</span>
                    </div>
                    <div style="flex: 2; font-size: 9pt;">{{ alt.description ?? 'common.n_a'|trans }}</div>
                    <div style="width: 80pt; text-align: right;">
                        {{ (alt.unitPrice ?? 0)|format_currency(quote.currency|default('USD'), quote.currency|default('USD'), 4) }}<br>
                        <span style="font-size: 8pt; color: var(--rams-muted);">{{ alt.stock ?? 0 }} {{ 'pdf.exceptions.in_stock'|trans }}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
    {% else %}
    <div style="padding: 20pt; text-align: center; border: 1px dashed var(--rams-border); color: var(--rams-muted);">
        {{ 'pdf.exceptions.no_exceptions'|trans }}
    </div>
    {% endfor %}

    {# Next Steps #}
    <h3>{{ 'pdf.exceptions.next_steps'|trans }}</h3>
    <div style="background: var(--rams-panel); padding: 12pt; border-left: 4px solid var(--rams-orange);">
        <ol style="margin: 0; padding-left: 15pt;">
            <li style="margin-bottom: 8pt;">{{ 'pdf.exceptions.step1'|trans }}</li>
            <li style="margin-bottom: 8pt;">{{ 'pdf.exceptions.step2'|trans }}</li>
            <li style="margin-bottom: 8pt;">{{ 'pdf.exceptions.step3'|trans }}</li>
            <li>{{ 'pdf.exceptions.step4'|trans }}</li>
        </ol>
    </div>

    <div class="footer">
        <strong>{{ issuer.name|default('app.company'|trans) }}</strong> • {{ 'pdf.exceptions.footer'|trans }}<br>
        {{ 'pdf.generated_on'|trans }}: {{ "now"|date('Y-m-d H:i') }} UTC
    </div>
</body>
</html>
