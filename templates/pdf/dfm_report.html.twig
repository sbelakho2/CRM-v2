{# PDF DFM Report Template - Sensei-Rams Industrial Functionalist Design System #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ 'pdf.dfm.title'|trans|default('DFM/DFA Analysis Report') }} - {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}</title>
    {% include 'pdf/base.css.twig' %}
    <style>
        .severity-critical {
            background: #D62D2D;
            color: white;
            padding: 2pt 6pt;
            border-radius: 2pt;
            font-size: 8pt;
            font-weight: bold;
            text-transform: uppercase; 
        }
        .severity-warning {
            background: #FFBE00;
            color: #1A1A1A;
            padding: 2pt 6pt;
            border-radius: 2pt;
            font-size: 8pt;
            font-weight: bold;
            text-transform: uppercase; 
        }
        .severity-info {
            background: #4A90E2;
            color: white;
            padding: 2pt 6pt;
            border-radius: 2pt;
            font-size: 8pt;
            font-weight: bold;
            text-transform: uppercase; 
        }
        .severity-pass {
            background: #2D8C3C;
            color: white;
            padding: 2pt 6pt;
            border-radius: 2pt;
            font-size: 8pt;
            font-weight: bold;
            text-transform: uppercase; 
        }
        .dfm-card {
            border: 1px solid var(--rams-border);
            margin: 10pt 0;
            background: white;
        }
        .dfm-card-header {
            background: var(--rams-dark);
            color: white;
            padding: 8pt 12pt;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .dfm-card-header h4 {
            margin: 0;
            color: white;
            font-size: 11pt;
        }
        .dfm-card-body {
            padding: 12pt;
        }
        .check-item {
            display: flex;
            padding: 6pt 0;
            border-bottom: 1px solid var(--rams-panel);
        }
        .check-item:last-child {
            border-bottom: none;
        }
        .check-status {
            width: 20pt;
            flex-shrink: 0;
        }
        .check-icon {
            width: 14pt;
            height: 14pt;
            border-radius: 50%;
            display: inline-block;
            text-align: center;
            line-height: 14pt;
            font-family: 'JetBrains Mono', 'Courier New', monospace;
            font-size: 8pt;
            font-weight: bold;
        }
        .check-icon.pass { background: #2D8C3C; color: white; }
        .check-icon.fail { background: #D62D2D; color: white; }
        .check-icon.warn { background: #FFBE00; color: #1A1A1A; }
        .check-icon.info { background: #4A90E2; color: white; }
        .check-details {
            flex: 1;
        }
        .check-name {
            font-weight: 600;
            color: var(--rams-foreground);
        }
        .check-desc {
            font-size: 9pt;
            color: var(--rams-muted);
            margin-top: 2pt;
        }
        .score-circle {
            width: 80pt;
            height: 80pt;
            border-radius: 50%;
            border: 6pt solid var(--rams-panel);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            margin: 0 auto;
        }
        .score-circle.excellent { border-color: #2D8C3C; }
        .score-circle.good { border-color: #4A90E2; }
        .score-circle.warning { border-color: #FFBE00; }
        .score-circle.critical { border-color: #D62D2D; }
        .score-value {
            font-size: 24pt;
            font-weight: bold;
            color: var(--rams-foreground);
        }
        .score-label {
            font-size: 8pt;
            text-transform: uppercase; 
            letter-spacing: 0.05em;
            color: var(--rams-muted);
        }
        .summary-boxes {
            display: flex;
            gap: 10pt;
            margin: 15pt 0;
        }
        .summary-box {
            flex: 1;
            padding: 10pt;
            text-align: center;
            border-radius: 3pt;
        }
        .summary-box.critical { background: #fdeaea; border: 1px solid #D62D2D; }
        .summary-box.warning { background: #fff8e5; border: 1px solid #FFBE00; }
        .summary-box.info { background: #e8f4fd; border: 1px solid #4A90E2; }
        .summary-box.pass { background: #e8f5ea; border: 1px solid #2D8C3C; }
        .summary-count {
            font-size: 22pt;
            font-weight: bold;
        }
        .summary-label {
            font-size: 8pt;
            text-transform: uppercase; 
            letter-spacing: 0.05em;
        }
        .recommendation-box {
            background: var(--rams-panel);
            border-left: 4px solid var(--rams-orange);
            padding: 12pt;
            margin: 10pt 0;
        }
        .recommendation-box strong {
            color: var(--rams-foreground);
            display: block;
            margin-bottom: 5pt;
        }
    </style>
</head>
<body>
    <div class="header clearfix">
        <div style="float: left;">
            <h2>{{ issuer.name|default('app.company'|trans|default('Sensei-Rams Electronics')) }}</h2>
            <p>{{ 'pdf.dfm.subtitle'|trans|default('Design for Manufacturability Analysis') }}</p>
        </div>
        <div class="doc-info">
            <strong>{{ 'pdf.dfm.report'|trans|default('DFM/DFA REPORT') }}</strong>
            Quote: {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}<br>
            Date: {{ "now"|date('Y-m-d') }}<br>
            Analyst: {{ analyst ?? 'Automated DFM Engine' }}
        </div>
        <div style="clear: both;"></div>
    </div>

    {# Overall Score #}
    {% set hasFindings = dfmData is defined and dfmData.findingCount is defined and dfmData.findingCount > 0 %} {% if hasFindings %} <h3>{{ 'pdf.dfm.overall_score'|trans|default('Overall DFM Score') }}</h3>
    
    {% set score = dfmData.overallScore   %}
    {% set scoreClass = score >= 90 ? 'excellent' : (score >= 75 ? 'good' : (score >= 60 ? 'warning' : 'critical')) %}
    
    <div style="display: flex; gap: 20pt; align-items: center;">
        <div style="flex: 0 0 100pt;">
            <div class="score-circle {{ scoreClass }}">
                <span class="score-value">{{ score }}</span>
                <span class="score-label">/ 100</span>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="summary-boxes">
                <div class="summary-box critical">
                    <div class="summary-count" style="color: #D62D2D;">{{ dfmData.criticalCount   }}</div>
                    <div class="summary-label">{{ 'pdf.dfm.critical'|trans|default('Critical') }}</div>
                </div>
                <div class="summary-box warning">
                    <div class="summary-count" style="color: #b38600;">{{ dfmData.warningCount   }}</div>
                    <div class="summary-label">{{ 'pdf.dfm.warnings'|trans|default('Warnings') }}</div>
                </div>
                <div class="summary-box info">
                    <div class="summary-count" style="color: #4A90E2;">{{ dfmData.infoCount   }}</div>
                    <div class="summary-label">{{ 'pdf.dfm.info'|trans|default('Info') 
                
                  
                           
                       }}</div>
                </div>
            </div>
            <p style="margin: 0; color: var(--rams-muted); font-size: 9pt;">
                {% if score >= 90 %}
                    {{ 'pdf.dfm.score_excellent'|trans|default('Excellent design. Ready for production with minor optimizations.') }}
                {% elseif score >= 75 %}
                    {{ 'pdf.dfm.score_good'|trans|default('Good design. Address warnings before production for optimal yield.') }}
                {% elseif score >= 60 %}
                    {{ 'pdf.dfm.score_warning'|trans|default('Design needs attention. Review critical issues before proceeding.') }}
                {% else %}
                    {{ 'pdf.dfm.score_critical'|trans|default('Significant manufacturability concerns. Design review required.') }}
                {% endif %}
            </p>
        </div>
    </div>

    {# Component Placement Analysis #}
    <div class="dfm-card">
        <div class="dfm-card-header">
            <h4>{{ 'pdf.dfm.component_placement'|trans|default('Component Placement Analysis') }}</h4>
                     
        </div>
        <div class="dfm-card-body">
            {% if dfmData.placementChecks|length > 0 %} {% for check in dfmData.placementChecks   %}
            <div class="check-item">
                <div class="check-status">
                    <span class="check-icon {{ check.status }}">
                        {% if check.status == 'pass' %}OK{% elseif check.status == 'fail' %}X{% elseif check.status == 'warn' %}!{% else %}i{% endif %}
                    </span>
                </div>
                <div class="check-details">
                    <div class="check-name">{{ check.name }}</div>
                    <div class="check-desc">{{ check.description }}</div>
                </div>
            </div>
            {% endfor %}
            {% else %}
            <div class="check-item">
                <div class="check-details">
                    <div class="check-name">{{ 'pdf.dfm.no_findings'|trans|default('No issues detected for this category.') }}</div>
                </div>
            </div>
            {% endif %}
            </div>
        </div>
        {# Solder Paste & Reflow Analysis #}
        <div class="dfm-card">
            <div class="dfm-card-header">
                <h4>{{ 'pdf.dfm.solder_analysis'|trans|default('Solder Paste & Reflow Analysis') }}</h4>
            </div>
            <div class="dfm-card-body">
                {% if dfmData.solderChecks|length > 0 %}
                {% for check in dfmData.solderChecks %}
                <div class="check-item">
                    <div class="check-status">
                        <span class="check-icon {{ check.status }}">
                            {% if check.status == 'pass' %}OK{% elseif check.status == 'fail' %}X{% elseif check.status == 'warn' %}!{% else %}i{% endif %}
                        </span>
                    </div>
                    <div class="check-details">
                        <div class="check-name">{{ check.name }}</div>
                        <div class="check-desc">{{ check.description
                
            
             
                   
                 
                        
                                  
                
            
             
                   
                 
                        
                               }}</div>
                </div>
            </div>
            {% endfor %} {% else %} <div class="check-item"> <div class="check-details"> <div class="check-name">{{ 'pdf.dfm.no_findings'|trans|default('No issues detected for this category.') }}</div> </div> </div> {% endif %}
        </div>
    </div>

    {# BOM Quality Analysis #}
    <div class="dfm-card">
        <div class="dfm-card-header">
            <h4>{{ 'pdf.dfm.bom_quality'|trans|default('BOM Quality Analysis') }}</h4>
                     
        </div>
        <div class="dfm-card-body">
            {% if dfmData.bomChecks|length > 0 %} {% for check in dfmData.bomChecks %} <div class="check-item">
                <div class="check-status"> <span  class="check-icon {{ check.status }}"> {% if check.status == 'pass' %}OK{% elseif check.status == 'fail' %}X{% elseif check.status ==       'warn' %}!{% else %}i{% endif %} </span> </div>             
                <div class="check-details">
                    <div class="check-name">{{ check.name   }}</div>
                    <div class="check-desc">{{ check.description }}</div> </div> </div> 
                        {% endfor       %}
                                    
                        {% else %}
                                   
                          
                    
                
            
            <div class="check-item">
                                       
                <div class="check-details">
                    <div class="check-name">{{ 'pdf.dfm.no_findings'|trans|default('No issues detected for this category.')   }}</div>
                    </div> </div>  
                               
                                   
                          
                                   
                        {% endif %}
                    
                
            
             
                   
                 
                        
                              
                
            
        </div>
    </div>

    {# Issues & Recommendations #}
    {% if dfmData.issues is defined and dfmData.issues|length > 0 %}
    <h3>{{ 'pdf.dfm.issues'|trans|default('Issues & Recommendations') }}</h3>
    <table aria-label="{{ 'pdf.dfm.issues'|trans|default('Issues & Recommendations') }}">
        <thead>
            <tr>
                <th scope="col" style="width: 10%;">{{ 'pdf.dfm.severity'|trans|default('Severity') }}</th>
                <th scope="col" style="width: 20%;">{{ 'pdf.dfm.category'|trans|default('Category') }}</th>
                <th scope="col" style="width: 30%;">{{ 'pdf.dfm.issue'|trans|default('Issue') }}</th>
                <th scope="col" style="width: 40%;">{{ 'pdf.dfm.recommendation'|trans|default('Recommendation') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for issue in dfmData.issues %}
            <tr>
                <td class="rams-text--center"> {% set sevClass = issue.severity == 'CRITICAL' or issue.severity == 'HIGH' ? 'critical' : (issue.severity == 'MEDIUM' ? 'warning' : 'info') %} <span  class="severity-{{ sevClass }}">{{ issue.severity }}</span> </td>       
                <td>{{ issue.category   }}</td>
                <td>{{ issue.description   }}</td>
                <td>{{ issue.recommendation      }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    {# Summary Recommendation #}
    <div class="recommendation-box">
        <strong>{{ 'pdf.dfm.engineering_summary'|trans|default('Engineering Summary') }}</strong>
        {% if score >= 90 %}
            {{ 'pdf.dfm.summary_excellent'|trans|default('This design demonstrates excellent manufacturability. Proceed to production with standard process parameters. Minor optimizations noted above may improve first-pass yield.') }}
        {% elseif score >= 75 %}
            {{ 'pdf.dfm.summary_good'|trans|default('Design is production-ready with recommended modifications. Address warning items before finalizing to avoid potential yield issues during assembly.') }}
        {% elseif score >= 60 %}
            {{ 'pdf.dfm.summary_warning'|trans|default('Design review recommended before production release. Critical items may impact assembly yield or product reliability. Engineering consultation advised.') }}
        {% else %}
            {{ 'pdf.dfm.summary_critical'|trans|default('Significant design changes required. Multiple critical issues identified that will impact manufacturability. Recommend ECO cycle before production.') }}
        {% endif %}
    </div>

    {% else %} <div class="dfm-card"> <div class="dfm-card-header"> <h4>{{ 'pdf.dfm.title'|trans|default('DFM/DFA Analysis Report') }}</h4> </div> <div class="dfm-card-body"> <p>{{ 'pdf.dfm.no_data'|trans|default('No DFM findings are available for this quote. Run the DFM analysis to generate manufacturability results.') }}</p> </div> </div> {% endif %} <div class="footer">
        <strong>{{ issuer.name|default('app.company'|trans|default('Sensei-Rams Electronics')) }}</strong> • {{ 'pdf.dfm.footer_note'|trans|default('DFM Analysis Report') }}<br>
        {{ 'pdf.generated_on'|trans|default('Generated') }}: {{ "now"|date('Y-m-d H:i') }} UTC • {{ 'pdf.dfm.engine'|trans|default('DFM Engine v2.1') }}
    </div>
</body>
</html>
