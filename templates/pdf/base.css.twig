{# Base CSS for all PDF documents - Sensei-Rams Industrial Functionalist Design System #}
<style>
@page {
    margin: 20mm 15mm;
}

body {
    font-family: 'DejaVu Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    font-size: 10pt;
    color: #1a1a1a;
    line-height: 1.5;
    background: #f5f5f5;
}

h1, h2, h3, h4 {
    font-family: 'DejaVu Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    color: #1a1a1a;
    margin-top: 10pt;
    margin-bottom: 8pt;
    font-weight: 600;
    letter-spacing: -0.02em;
}

h1 {
    font-size: 20pt;
    margin-top: 0;
    padding-bottom: 5pt;
    border-bottom: 3px solid #FFBE00;
}

h2 {
    font-size: 16pt;
    border-bottom: 2px solid #3a3a3a;
    padding-bottom: 4pt;
}

h3 {
    font-size: 12pt;
}

h4 {
    font-size: 11pt;
    font-weight: 600;
}

p {
    margin: 6pt 0;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin: 10pt 0;
    background: white;
}

th {
    background: #2a2a2a;
    color: #ffffff;
    font-weight: 600;
    text-align: left;
    padding: 8pt;
    border: 1px solid #3a3a3a;
    text-transform: uppercase;
    font-size: 9pt;
    letter-spacing: 0.05em;
}

td {
    padding: 6pt 8pt;
    border: 1px solid #d0d0d0;
    vertical-align: top;
}

tr:nth-child(even) td {
    background: #f9f9f9;
}

.header {
    border-bottom: 3px solid #FFBE00;
    padding-bottom: 10pt;
    margin-bottom: 20pt;
}

.logo {
    float: left;
    max-height: 50pt;
}

.doc-info {
    float: right;
    text-align: right;
    font-size: 9pt;
    color: #4a4a4a;
}

.doc-info strong {
    font-size: 14pt;
    color: #1a1a1a;
    display: block;
    margin-bottom: 5pt;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}

.clearfix::after {
    content: "";
    display: table;
    clear: both;
}

.footer {
    font-size: 8pt;
    color: #4a4a4a;
    text-align: center;
    border-top: 2px solid #FFBE00;
    padding-top: 8pt;
    margin-top: 20pt;
}

.total-row {
    background: #1a1a1a !important;
    color: #FFBE00 !important;
    font-weight: bold;
}

.total-row td {
    border-color: #2a2a2a !important;
}

.subtotal-row {
    background: #3a3a3a !important;
    color: #ffffff !important;
    font-weight: 600;
}

.subtotal-row td {
    border-color: #4a4a4a !important;
}

.warning-box {
    background: #fef9e7;
    border-left: 4px solid #FFBE00;
    padding: 10pt;
    margin: 10pt 0;
}

.info-box {
    background: #f0f0f0;
    border-left: 4px solid #4a4a4a;
    padding: 10pt;
    margin: 10pt 0;
}

.success-box {
    background: #e8f5e9;
    border-left: 4px solid #4caf50;
    padding: 10pt;
    margin: 10pt 0;
}

.danger-box {
    background: #ffebee;
    border-left: 4px solid #f44336;
    padding: 10pt;
    margin: 10pt 0;
}

.text-right {
    text-align: right;
}

.text-center {
    text-align: center;
}

.text-muted {
    color: #5a5a5a;
}

.small {
    font-size: 8pt;
}

.badge {
    display: inline-block;
    padding: 2pt 6pt;
    border-radius: 2pt;
    font-size: 8pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.badge-success {
    background: #4caf50;
    color: white;
}

.badge-warning {
    background: #FFBE00;
    color: #1a1a1a;
}

.badge-danger {
    background: #f44336;
    color: white;
}

.badge-info {
    background: #3a3a3a;
    color: white;
}

.accent {
    color: #FFBE00;
}

.accent-bg {
    background: #FFBE00;
    color: #1a1a1a;
}
</style>
