{# Base CSS for all PDF documents - Sensei-Rams Industrial Functionalist Design System #}
<style>
/* Sensei-Rams Design System Color Variables for PDF */
:root {
    --rams-orange: #FFBE00;
    --rams-green: #2D8C3C;
    --rams-red: #D62D2D;
    --rams-steel: #4A90E2;
    --rams-foreground: #1A1A1A;
    --rams-muted: #5A5A5A;
    --rams-border: #D0D0D0;
    --rams-panel: #F5F5F5;
    --rams-background: #FFFFFF;
    --rams-dark: #2A2A2A;
}

@page {
    margin: 20mm 15mm;
}

body {
    font-family: 'DejaVu Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    font-size: 10pt;
    color: var(--rams-foreground);
    line-height: 1.5;
    background: var(--rams-panel);
}

h1, h2, h3, h4 {
    font-family: 'DejaVu Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    color: var(--rams-foreground);
    margin-top: 10pt;
    margin-bottom: 8pt;
    font-weight: 600;
    letter-spacing: -0.02em;
}

h1 {
    font-size: 20pt;
    margin-top: 0;
    padding-bottom: 5pt;
    border-bottom: 3px solid var(--rams-orange);
}

h2 {
    font-size: 16pt;
    border-bottom: 2px solid var(--rams-dark);
    padding-bottom: 4pt;
}

h3 {
    font-size: 12pt;
}

h4 {
    font-size: 11pt;
    font-weight: 600;
}

p {
    margin: 6pt 0;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin: 10pt 0;
    background: white;
}

th {
    background: var(--rams-dark);
    color: var(--rams-background);
    font-weight: 600;
    text-align: left;
    padding: 8pt;
    border: 1px solid var(--rams-dark);
    text-transform: uppercase;
    font-size: 9pt;
    letter-spacing: 0.05em;
}

td {
    padding: 6pt 8pt;
    border: 1px solid var(--rams-border);
    vertical-align: top;
}

tr:nth-child(even) td {
    background: #f9f9f9;
}

.header {
    border-bottom: 3px solid var(--rams-orange);
    padding-bottom: 10pt;
    margin-bottom: 20pt;
}

.logo {
    float: left;
    max-height: 50pt;
}

.doc-info {
    float: right;
    text-align: right;
    font-size: 9pt;
    color: var(--rams-muted);
}

.doc-info strong {
    font-size: 14pt;
    color: var(--rams-foreground);
    display: block;
    margin-bottom: 5pt;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}

.clearfix::after {
    content: "";
    display: table;
    clear: both;
}

.footer {
    font-size: 8pt;
    color: var(--rams-muted);
    text-align: center;
    border-top: 2px solid var(--rams-orange);
    padding-top: 8pt;
    margin-top: 20pt;
}

.total-row {
    background: var(--rams-foreground) !important;
    color: var(--rams-orange) !important;
    font-weight: bold;
}

.total-row td {
    border-color: var(--rams-dark) !important;
}

.subtotal-row {
    background: var(--rams-dark) !important;
    color: var(--rams-background) !important;
    font-weight: 600;
}

.subtotal-row td {
    border-color: var(--rams-muted) !important;
}

.warning-box {
    background: #fef9e7;
    border-left: 4px solid var(--rams-orange);
    padding: 10pt;
    margin: 10pt 0;
}

.info-box {
    background: var(--rams-panel);
    border-left: 4px solid var(--rams-muted);
    padding: 10pt;
    margin: 10pt 0;
}

.success-box {
    background: #e8f5e9;
    border-left: 4px solid var(--rams-green);
    padding: 10pt;
    margin: 10pt 0;
}

.danger-box {
    background: #ffebee;
    border-left: 4px solid var(--rams-red);
    padding: 10pt;
    margin: 10pt 0;
}

.text-right {
    text-align: right;
}

.text-center {
    text-align: center;
}

.text-muted {
    color: var(--rams-muted);
}

.small {
    font-size: 8pt;
}

.badge {
    display: inline-block;
    padding: 2pt 6pt;
    border-radius: 2pt;
    font-size: 8pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.badge-success {
    background: var(--rams-green);
    color: white;
}

.badge-warning {
    background: var(--rams-orange);
    color: var(--rams-foreground);
}

.badge-danger {
    background: var(--rams-red);
    color: white;
}

.badge-info {
    background: var(--rams-dark);
    color: white;
}

.accent {
    color: var(--rams-orange);
}

.accent-bg {
    background: var(--rams-orange);
    color: var(--rams-foreground);
}
</style>
