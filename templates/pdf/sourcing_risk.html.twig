{# PDF Sourcing Risk Report Template - Sensei-Rams Industrial Functionalist Design System #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ 'pdf.sourcing_risk.title'|trans }} - {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}</title>
    {% include 'pdf/base.css.twig' %}
    <style>
        .risk-gauge {
            display: flex;
            align-items: center;
            gap: 15pt;
            margin: 15pt 0;
        }
        .risk-score-large {
            width: 100pt;
            height: 100pt;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            border: 8pt solid var(--rams-panel);
        }
        .risk-score-large.low { border-color: #2D8C3C; }
        .risk-score-large.medium { border-color: #FFBE00; }
        .risk-score-large.high { border-color: #FF5722; }
        .risk-score-large.critical { border-color: #D62D2D; }
        .risk-value {
            font-size: 28pt;
            font-weight: bold;
        }
        .risk-label {
            font-size: 9pt;
            text-transform: rams-uppercase;
            letter-spacing: 0.05em;
            color: var(--rams-muted);
        }
        .risk-bar {
            height: 8pt;
            background: var(--rams-panel);
            border-radius: 4pt;
            overflow: hidden;
            flex: 1;
        }
        .risk-bar-fill {
            height: 100%;
            transition: width 0.3s;
        }
        .risk-bar-fill.low { background: #2D8C3C; }
        .risk-bar-fill.medium { background: #FFBE00; }
        .risk-bar-fill.high { background: #FF5722; }
        .risk-bar-fill.critical { background: #D62D2D; }
        .risk-category {
            border: 1px solid var(--rams-border);
            margin: 12pt 0;
            background: white;
        }
        .risk-category-header {
            background: var(--rams-panel);
            padding: 10pt 12pt;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--rams-border);
        }
        .risk-category-header h4 {
            margin: 0;
            font-size: 11pt;
        }
        .risk-badge {
            display: inline-block;
            padding: 3pt 10pt;
            border-radius: 10pt;
            font-size: 8pt;
            font-weight: bold;
            text-transform: rams-uppercase;
        }
        .risk-badge.low { background: #e8f5ea; color: #2D8C3C; }
        .risk-badge.medium { background: #fff8e5; color: #b38600; }
        .risk-badge.high { background: #ffeee8; color: #FF5722; }
        .risk-badge.critical { background: #fdeaea; color: #D62D2D; }
        .risk-category-body {
            padding: 12pt;
        }
        .supplier-card {
            display: flex;
            gap: 12pt;
            padding: 10pt;
            margin: 8pt 0;
            background: var(--rams-panel);
            border-radius: 3pt;
        }
        .supplier-logo {
            width: 40pt;
            height: 40pt;
            background: white;
            border-radius: 4pt;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16pt;
            font-weight: bold;
            color: var(--rams-muted);
        }
        .supplier-info { flex: 1; }
        .supplier-name {
            font-weight: 600;
            color: var(--rams-foreground);
        }
        .supplier-details {
            font-size: 9pt;
            color: var(--rams-muted);
        }
        .supplier-metrics {
            text-align: right;
        }
        .heat-map {
            width: 100%;
            border-collapse: collapse;
            margin: 15pt 0;
        }
        .heat-map th, .heat-map td {
            padding: 8pt;
            text-align: center;
            font-size: 9pt;
        }
        .heat-map .risk-low { background: #e8f5ea; }
        .heat-map .risk-medium { background: #fff8e5; }
        .heat-map .risk-high { background: #ffeee8; }
        .heat-map .risk-critical { background: #fdeaea; }
        .mitigation-item {
            display: flex;
            gap: 10pt;
            padding: 10pt;
            margin: 8pt 0;
            background: var(--rams-panel);
            border-left: 3px solid var(--rams-orange);
        }
        .mitigation-priority {
            width: 24pt;
            height: 24pt;
            border-radius: 50%;
            background: var(--rams-orange);
            color: var(--rams-foreground);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 10pt;
        }
        .stats-grid {
            display: flex;
            gap: 10pt;
            margin: 15pt 0;
        }
        .stat-box {
            flex: 1;
            background: var(--rams-panel);
            padding: 12pt;
            text-align: center;
            border-bottom: 3px solid var(--rams-dark);
        }
        .stat-value {
            font-size: 18pt;
            font-weight: bold;
            color: var(--rams-foreground);
        }
        .stat-label {
            font-size: 8pt;
            color: var(--rams-muted);
            text-transform: rams-uppercase;
            letter-spacing: 0.05em;
        }
    </style>
</head>
<body>
    <div class="header clearfix">
        <div style="float: left;">
            <h2>{{ 'app.company'|trans }}</h2>
            <p>{{ 'pdf.sourcing_risk.subtitle'|trans }}</p>
        </div>
        <div class="doc-info">
            <strong>{{ 'pdf.sourcing_risk.report'|trans }}</strong>
            Quote: {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}<br>
            Date: {{ "now"|date('Y-m-d') }}<br>
            Analyst: {{ analyst ?? 'Risk Engine v3' }}
        </div>
        <div style="clear: both;"></div>
    </div>

    {# Overall Risk Score #}
    {% set overallRisk = riskData.overallScore ?? 35 %}
    {% set riskLevel = overallRisk < 25 ? 'low' : (overallRisk < 50 ? 'medium' : (overallRisk < 75 ? 'high' : 'critical')) %}
    
    <h3>{{ 'pdf.sourcing_risk.overall'|trans }}</h3>
    
    <div class="risk-gauge">
        <div class="risk-score-large {{ riskLevel }}">
            <span class="risk-value">{{ overallRisk }}</span>
            <span class="risk-label">/ 100</span>
        </div>
        <div style="flex: 1;">
            <div style="font-size: 14pt; font-weight: 600; margin-bottom: 5pt;">
                {{ 'pdf.sourcing_risk.level'|trans }}: 
                <span class="risk-badge {{ riskLevel }}">{{ riskLevel|upper }}</span>
            </div>
            <p style="color: var(--rams-muted); font-size: 10pt; margin: 5pt 0;">
                {% if riskLevel == 'low' %}
                    {{ 'pdf.sourcing_risk.low_desc'|trans }}
                {% elseif riskLevel == 'medium' %}
                    {{ 'pdf.sourcing_risk.medium_desc'|trans }}
                {% elseif riskLevel == 'high' %}
                    {{ 'pdf.sourcing_risk.high_desc'|trans }}
                {% else %}
                    {{ 'pdf.sourcing_risk.critical_desc'|trans }}
                {% endif %}
            </p>
            <div class="risk-bar">
                <div class="risk-bar-fill {{ riskLevel }}" style="width: {{ overallRisk }}%;"></div>
            </div>
        </div>
    </div>

    {# Risk Summary Stats #}
    <div class="stats-grid">
        <div class="stat-box">
            <div class="stat-value">{{ riskData.singleSourceParts ?? 4 }}</div>
            <div class="stat-label">{{ 'pdf.sourcing_risk.single_source'|trans }}</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">{{ riskData.longLeadParts ?? 7 }}</div>
            <div class="stat-label">{{ 'pdf.sourcing_risk.long_lead'|trans }}</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">{{ riskData.eolParts ?? 2 }}</div>
            <div class="stat-label">{{ 'pdf.sourcing_risk.eol_nrnd'|trans }}</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">{{ riskData.allocationParts ?? 3 }}</div>
            <div class="stat-label">{{ 'pdf.sourcing_risk.allocation'|trans }}</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">{{ (riskData.geoConcentration ?? 68)|number_format(0) }}%</div>
            <div class="stat-label">{{ 'pdf.sourcing_risk.geo_concentration'|trans }}</div>
        </div>
    </div>

    {# Risk Categories #}
    <h3>{{ 'pdf.sourcing_risk.by_category'|trans }}</h3>

    {# Supply Availability Risk #}
    <div class="risk-category">
        <div class="risk-category-header">
            <h4>{{ 'pdf.sourcing_risk.availability'|trans }}</h4>
            <span class="risk-badge {{ (riskData.availabilityLevel ?? 'medium') }}">{{ riskData.availabilityScore ?? 42 }}/100</span>
        </div>
        <div class="risk-category-body">
            <table>
                <thead>
                    <tr>
                        <th style="width: 20%;">{{ 'pdf.quote.mpn'|trans }}</th>
                        <th style="width: 15%;">{{ 'pdf.sourcing_risk.manufacturer'|trans }}</th>
                        <th class="rams-text--center" style="width: 10%;">{{ 'pdf.sourcing_risk.stock'|trans }}</th>
                        <th class="rams-text--center" style="width: 12%;">{{ 'pdf.sourcing_risk.lead_time'|trans }}</th>
                        <th class="rams-text--center" style="width: 10%;">{{ 'pdf.sourcing_risk.sources'|trans }}</th>
                        <th class="rams-text--center" style="width: 10%;">{{ 'pdf.sourcing_risk.risk'|trans }}</th>
                        <th style="width: 23%;">{{ 'pdf.sourcing_risk.notes'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for part in riskData.availabilityRisks ?? [] %}
                    <tr class="heat-map risk-{{ part.level ?? 'low' }}">
                        <td><strong>{{ part.mpn ?? 'common.n_a'|trans }}</strong></td>
                        <td>{{ part.manufacturer ?? 'common.n_a'|trans }}</td>
                        <td class="rams-text--center">{{ part.stock ?? 0 }}</td>
                        <td class="rams-text--center">{{ part.leadTime ?? 'common.n_a'|trans }}</td>
                        <td class="rams-text--center">{{ part.sourceCount ?? 1 }}</td>
                        <td class="rams-text--center"><span class="risk-badge {{ part.level ?? 'low' }}">{{ (part.level ?? 'Low')|upper }}</span></td>
                        <td>{{ part.notes ?? '-' }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="rams-text--center" style="padding: 20pt; color: var(--rams-muted);">
                            {{ 'pdf.sourcing_risk.no_risks'|trans }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Supplier Concentration Risk #}
    <div class="risk-category">
        <div class="risk-category-header">
            <h4>{{ 'pdf.sourcing_risk.supplier_concentration'|trans }}</h4>
            <span class="risk-badge {{ (riskData.concentrationLevel ?? 'medium') }}">{{ riskData.concentrationScore ?? 38 }}/100</span>
        </div>
        <div class="risk-category-body">
            {% for supplier in riskData.topSuppliers ?? [] %}
            <div class="supplier-card">
                <div class="supplier-logo">{{ supplier.initials ?? 'XX' }}</div>
                <div class="supplier-info">
                    <div class="supplier-name">{{ supplier.name ?? 'pdf.sourcing_risk.unknown_supplier'|trans }}</div>
                    <div class="supplier-details">
                        {{ supplier.partCount ?? 0 }} {{ 'pdf.sourcing_risk.parts'|trans|lower }} ({{ supplier.percentage ?? 0 }}% of BOM value) • 
                        {{ supplier.region ?? 'common.unknown'|trans }}
                    </div>
                </div>
                <div class="supplier-metrics">
                    <span class="risk-badge {{ supplier.riskLevel ?? 'low' }}">{{ (supplier.riskLevel|default('Low'))|upper }}</span>
                </div>
            </div>
            {% else %}
            <div style="padding: 15pt; text-align: center; color: var(--rams-muted);">
                {{ 'pdf.sourcing_risk.no_data'|trans }}
            </div>
            {% endfor %}
        </div>
    </div>

    {# Geographic Risk Heat Map #}
    <h3>{{ 'pdf.sourcing_risk.geographic'|trans }}</h3>
    <table class="heat-map">
        <thead>
            <tr>
                <th style="width: 25%;">{{ 'pdf.sourcing_risk.region'|trans }}</th>
                <th class="rams-text--center" style="width: 15%;">{{ 'pdf.sourcing_risk.parts'|trans }}</th>
                <th class="rams-text--center" style="width: 15%;">{{ 'pdf.sourcing_risk.value_pct'|trans }}</th>
                <th class="rams-text--center" style="width: 15%;">{{ 'pdf.sourcing_risk.risk_score'|trans }}</th>
                <th style="width: 30%;">{{ 'pdf.sourcing_risk.primary_concern'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for region in riskData.geoRisks ?? [] %}
            <tr class="risk-{{ region.level ?? 'low' }}">
                <td><strong>{{ region.name ?? 'common.unknown'|trans }}</strong></td>
                <td class="rams-text--center">{{ region.partCount ?? 0 }}</td>
                <td class="rams-text--center">{{ region.valuePct ?? 0 }}%</td>
                <td class="rams-text--center">{{ region.score ?? 0 }}/100</td>
                <td>{{ region.concern ?? 'common.none'|trans }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="rams-text--center" style="padding: 15pt; color: var(--rams-muted);">
                    {{ 'pdf.sourcing_risk.no_data'|trans }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Risk Mitigation Recommendations #}
    <h3>{{ 'pdf.sourcing_risk.mitigation'|trans }}</h3>
    
    {% for rec in riskData.mitigations ?? [] %}
    <div class="mitigation-item">
        <div class="mitigation-priority">{{ loop.index }}</div>
        <div style="flex: 1;">
            <strong>{{ rec.title ?? 'pdf.sourcing_risk.recommendation'|trans }}</strong><br>
            <span style="color: var(--rams-muted); font-size: 9pt;">{{ rec.description ?? 'pdf.sourcing_risk.no_description'|trans }}</span>
            {% if rec.impact is defined %}
            <div style="margin-top: 5pt;">
                <span class="risk-badge {{ rec.impact ?? 'medium' }}">{{ rec.impactLabel ?? ('pdf.sourcing_risk.impact'|trans ~ ': ' ~ 'common.medium'|trans) }}</span>
            </div>
            {% endif %}
        </div>
    </div>
    {% else %}
    <div style="padding: 15pt; text-align: center; border: 1px dashed var(--rams-border); color: var(--rams-muted);">
        {{ 'pdf.sourcing_risk.no_risks'|trans }}
    </div>
    {% endfor %}

    <div class="footer">
        <strong>{{ 'app.company'|trans }}</strong> • {{ 'pdf.sourcing_risk.footer'|trans }}<br>
        {{ 'pdf.generated_on'|trans }}: {{ "now"|date('Y-m-d H:i') }} UTC • {{ 'pdf.sourcing_risk.engine'|trans }}
    </div>
</body>
</html>
