<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Quote #{{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}</title>
    <style>
        body { font-family: 'DejaVu Sans', Arial, sans-serif; font-size: 10pt; color: #333; }
        .header { border-bottom: 3px solid #9B6B9E; padding-bottom: 10pt; margin-bottom: 15pt; }
        .header h2 { margin: 0; color: #9B6B9E; }
        .doc-info { float: right; text-align: right; font-size: 9pt; }
        table { width: 100%; border-collapse: collapse; margin: 10pt 0; }
        th { background: #9B6B9E; color: white; padding: 8pt 5pt; text-align: left; }
        td { padding: 6pt 5pt; border: 1px solid #ddd; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .total-row { background: #f0f0f0; font-weight: bold; }
        .footer { margin-top: 20pt; padding-top: 10pt; border-top: 1px solid #ddd; font-size: 8pt; color: #666; }
    </style>
</head>
<body>
    <div class="header clearfix">
        <div style="float: left;">
            <h2 style="margin: 0; border: none; color: #9B6B9E;">CRM Starz Morocco</h2>
            <p style="margin: 2pt 0; font-size: 9pt; color: #666;">Electronics Manufacturing & Sourcing</p>
        </div>
        
        <div class="doc-info">
            <strong>QUOTATION</strong><br>
            Quote #: {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}<br>
            Date: {{ quote.createdAt|date('Y-m-d') }}<br>
            Valid Until: {{ quote.createdAt|date_modify('+30 days')|date('Y-m-d') }}
        </div>
        <div style="clear: both;"></div>
    </div>
    
    <h3>Quote for {{ quote.company.name }}</h3>
    
    <table style="margin-bottom: 15pt; border: none;">
        <tr>
            <td style="width: 50%; border: none; vertical-align: top;">
                <strong>Company:</strong> {{ quote.company.name }}<br>
                <strong>Quantity:</strong> {{ quote.quantity ?? 'N/A' }}<br>
                <strong>Ship To:</strong> {{ quote.shipToCountry ?? 'N/A' }}
            </td>
            <td style="width: 50%; border: none; vertical-align: top;">
                <strong>Incoterms:</strong> {{ quote.incoterms ?? 'FCA' }}<br>
                <strong>Coverage:</strong> {{ quote.coveragePercent|default(0)|number_format(1) }}%<br>
                <strong>Status:</strong> {{ quote.status|upper }}
            </td>
        </tr>
    </table>
    
    <h3>Bill of Materials</h3>
    <table>
        <thead>
            <tr>
                <th style="width: 5%;">Line</th>
                <th style="width: 18%;">MPN</th>
                <th style="width: 15%;">Manufacturer</th>
                <th style="width: 32%;">Description</th>
                <th style="width: 8%;">Qty</th>
                <th style="width: 11%;">Unit Price</th>
                <th style="width: 11%;">Ext. Price</th>
            </tr>
        </thead>
        <tbody>
            {% for line in quote.bomLines %}
            <tr>
                <td class="text-center">{{ line.lineNumber ?? loop.index }}</td>
                <td>{{ line.mpn ?? 'N/A' }}</td>
                <td>{{ line.manufacturer ?? 'N/A' }}</td>
                <td>{{ line.description ?? '' }}</td>
                <td class="text-right">{{ line.quantity ?? '' }}</td>
                <td class="text-right">
                    {% if line.unitPrice %}${{ line.unitPrice|number_format(4) }}{% else %}-{% endif %}
                </td>
                <td class="text-right">
                    {% if line.extendedPrice %}${{ line.extendedPrice|number_format(2) }}{% else %}-{% endif %}
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" style="text-align: center; padding: 15pt;">No BOM lines available</td>
            </tr>
            {% endfor %}
            
            <tr class="total-row">
                <td colspan="6" class="text-right"><strong>TOTAL</strong></td>
                <td class="text-right"><strong>${{ quote.totalCost|default(0)|number_format(2) }}</strong></td>
            </tr>
        </tbody>
    </table>
    
    {% if quote.notes %}
    <h3>Notes</h3>
    <p>{{ quote.notes }}</p>
    {% endif %}
    
    <h3>Payment & Delivery Terms</h3>
    <p style="font-size: 9pt;">
        • Payment: Net 30 days from invoice date<br>
        • Delivery: 2-4 weeks from order confirmation<br>
        • This quote is valid for 30 days from the date of issue<br>
        • Prices are in USD and subject to change based on currency fluctuations<br>
        • Minimum order value: $500 USD
    </p>
    
    <div class="footer">
        <strong>CRM Starz Morocco</strong> | Casablanca, Morocco | sales@crm-starz.ma<br>
        Generated on {{ "now"|date('Y-m-d H:i:s') }}
    </div>
</body>
</html>