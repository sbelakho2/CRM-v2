{% extends 'base.html.twig' %}

{% block title %}{{ 'contact.new.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="Breadcrumb">
        <ol class="rams-breadcrumb__list">
            <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item"><a href="{{ path('app_contact_index') }}" class="rams-breadcrumb__link">{{ 'contact.index.title'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ 'common.new'|trans }}</li>
        </ol>
    </nav>

    {# Page Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'contact.new.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'contact.new.subtitle'|trans }}</p>
        </div>
    </div>

    {# Form Module #}
    <div class="rams-module rams-module--narrow rams-mx-auto">
        <div class="rams-module__header">
            <h2 class="rams-module__title">{{ 'contact.show.contact_information'|trans }}</h2>
        </div>
        <div class="rams-module__content">
            {{ form_start(form, {'attr': {'class': 'rams-form'}}) }}

                {# Name Row #}
                <div class="rams-grid rams-grid--2 rams-gap-4">
                    <div class="rams-form__group">
                        {{ form_label(form.firstName, 'contact.fields.first_name'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.firstName, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.firstName) }}
                    </div>
                    <div class="rams-form__group">
                        {{ form_label(form.lastName, 'contact.fields.last_name'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.lastName, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.lastName) }}
                    </div>
                </div>

                {# Company and Job Title Row #}
                <div class="rams-grid rams-grid--2 rams-gap-4">
                    <div class="rams-form__group">
                        {{ form_label(form.company, 'contact.fields.company'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.company, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.company) }}
                    </div>
                    <div class="rams-form__group">
                        {{ form_label(form.jobTitle, 'contact.fields.job_title'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                        {{ form_widget(form.jobTitle, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.jobTitle) }}
                    </div>
                </div>

                {# Role #}
                <div class="rams-form__group">
                    {{ form_label(form.role, 'contact.fields.role'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                    {{ form_widget(form.role, {'attr': {'class': 'rams-form__select'}}) }}
                    {{ form_errors(form.role) }}
                </div>

                <div class="rams-divider rams-my-4"></div>

                {# Contact Details Section #}
                <div class="rams-stack rams-gap-4">
                    <h3 class="rams-module__title rams-rams-text--xs">{{ 'contact.new.contact_details'|trans }}</h3>
                    
                    {# Email and Phone Row #}
                    <div class="rams-grid rams-grid--2 rams-gap-4">
                        <div class="rams-form__group">
                            {{ form_label(form.email, 'contact.fields.email'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                            <div class="rams-flex rams-items-center rams-gap-2">
                                <span class="rams-rams-text--lg">📧</span>
                                {{ form_widget(form.email, {'attr': {'class': 'rams-form__input'}}) }}
                            </div>
                            {{ form_errors(form.email) }}
                        </div>
                        <div class="rams-form__group">
                            {{ form_label(form.phone, 'contact.fields.phone'|trans, {'label_attr': {'class': 'rams-form__label rams-dymo'}}) }}
                            <div class="rams-flex rams-items-center rams-gap-2">
                                <span class="rams-rams-text--lg">📞</span>
                                {{ form_widget(form.phone, {'attr': {'class': 'rams-form__input'}}) }}
                            </div>
                            {{ form_errors(form.phone) }}
                        </div>
                    </div>
                </div>

                <div class="rams-form__actions">
                    <button type="submit" class="rams-btn--primary">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        {{ 'contact.actions.create'|trans }}
                    </button>
                    <a href="{{ path('app_contact_index') }}" class="rams-btn--ghost">
                        {{ 'common.cancel'|trans }}
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
