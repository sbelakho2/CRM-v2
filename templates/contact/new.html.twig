{% extends 'base.html.twig' %}

{% block title %}New Contact{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        {# Breadcrumb #}
        <nav class="mb-6">
            <ol class="flex items-center gap-2 text-sm">
                <li><a href="{{ path('app_dashboard') }}" class="text-neutral-600 hover:text-neutral-900">Dashboard</a></li>
                <li class="text-neutral-400">/</li>
                <li><a href="{{ path('app_contact_index') }}" class="text-neutral-600 hover:text-neutral-900">Contacts</a></li>
                <li class="text-neutral-400">/</li>
                <li class="text-neutral-900 font-medium">New</li>
            </ol>
        </nav>

        {# Header #}
        <div class="mb-6">
            <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Create New Contact</h1>
            <p class="mt-1 text-sm text-neutral-600">Add a new contact to your CRM database</p>
        </div>

        {# Form Card #}
        <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                {# Name Row #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_label(form.firstName, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                        {{ form_widget(form.firstName, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                        {{ form_errors(form.firstName, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    </div>
                    <div>
                        {{ form_label(form.lastName, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                        {{ form_widget(form.lastName, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                        {{ form_errors(form.lastName, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    </div>
                </div>

                {# Company and Job Title Row #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_label(form.company, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                        {{ form_widget(form.company, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                        {{ form_errors(form.company, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    </div>
                    <div>
                        {{ form_label(form.jobTitle, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                        {{ form_widget(form.jobTitle, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                        {{ form_errors(form.jobTitle, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    </div>
                </div>

                {# Role #}
                <div>
                    {{ form_label(form.role, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                    {{ form_widget(form.role, {'attr': {'class': 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                    {{ form_errors(form.role, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                </div>

                {# Divider #}
                <div class="border-t border-neutral-200"></div>

                {# Contact Details Section #}
                <div class="space-y-6">
                    <h3 class="text-sm font-semibold text-neutral-900">Contact Details</h3>
                    
                    {# Email and Phone Row #}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.email, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none">
                                    <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                                {{ form_widget(form.email, {'attr': {'class': 'w-full pl-10 pr-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                            </div>
                            {{ form_errors(form.email, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                        </div>
                        <div>
                            {{ form_label(form.phone, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none">
                                    <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                </div>
                                {{ form_widget(form.phone, {'attr': {'class': 'w-full pl-10 pr-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                            </div>
                            {{ form_errors(form.phone, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                        </div>
                    </div>

                    {# LinkedIn URL #}
                    <div>
                        {{ form_label(form.linkedInUrl, null, {'label_attr': {'class': 'block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2'}}) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none">
                                <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                            </div>
                            {{ form_widget(form.linkedInUrl, {'attr': {'class': 'w-full pl-10 pr-4 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-colors'}}) }}
                        </div>
                        {{ form_errors(form.linkedInUrl, {'attr': {'class': 'mt-1 text-xs text-red-600'}}) }}
                    </div>
                </div>

                {# Action Buttons #}
                <div class="flex items-center gap-3 pt-4 border-t border-neutral-200">
                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-neutral-900 text-white text-sm font-medium rounded-lg hover:bg-neutral-800 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Create Contact
                    </button>
                    <a href="{{ path('app_contact_index') }}" class="inline-flex items-center gap-2 px-5 py-2.5 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">
                        Cancel
                    </a>
                </div>

            {{ form_end(form) }}
        </div>

    </div>
</div>

<style>
/* Custom styles for Symfony form elements */
.form-input,
.form-select {
    @apply w-full px-4 py-2.5 border border-neutral-200 rounded-lg text-sm;
    @apply focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500;
    @apply transition-colors;
}

select.form-select {
    @apply bg-white;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 0.5rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
    padding-right: 2.5rem;
}
</style>
{% endblock %}
