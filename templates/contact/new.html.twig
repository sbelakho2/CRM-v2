{% extends 'base.html.twig' %}

{% block title %}{{ 'contact.new.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-container rams-container--narrow">
    
    {# Breadcrumb #}
    <nav class="rams-breadcrumb">
        <ol class="rams-breadcrumb__list">
            <li><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li><a href="{{ path('app_contact_index') }}" class="rams-breadcrumb__link">{{ 'contact.index.title'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__current">{{ 'common.new'|trans }}</li>
        </ol>
    </nav>

    {# Header #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'contact.new.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'contact.new.subtitle'|trans }}</p>
        </div>
    </div>

    {# Form Module #}
    <div class="rams-module">
        <div class="rams-module__content">
            {{ form_start(form, {'attr': {'class': 'rams-form'}}) }}

                {# Name Row #}
                <div class="rams-grid rams-grid--2">
                    <div class="rams-form__group">
                        {{ form_label(form.firstName, 'contact.fields.first_name'|trans, {'label_attr': {'class': 'rams-dymo'}}) }}
                        {{ form_widget(form.firstName, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.firstName) }}
                    </div>
                    <div class="rams-form__group">
                        {{ form_label(form.lastName, 'contact.fields.last_name'|trans, {'label_attr': {'class': 'rams-dymo'}}) }}
                        {{ form_widget(form.lastName, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.lastName) }}
                    </div>
                </div>

                {# Company and Job Title Row #}
                <div class="rams-grid rams-grid--2">
                    <div class="rams-form__group">
                        {{ form_label(form.company, 'contact.fields.company'|trans, {'label_attr': {'class': 'rams-dymo'}}) }}
                        {{ form_widget(form.company, {'attr': {'class': 'rams-form__select'}}) }}
                        {{ form_errors(form.company) }}
                    </div>
                    <div class="rams-form__group">
                        {{ form_label(form.jobTitle, 'contact.fields.job_title'|trans, {'label_attr': {'class': 'rams-dymo'}}) }}
                        {{ form_widget(form.jobTitle, {'attr': {'class': 'rams-form__input'}}) }}
                        {{ form_errors(form.jobTitle) }}
                    </div>
                </div>

                {# Role #}
                <div class="rams-form__group">
                    {{ form_label(form.role, 'contact.fields.role'|trans, {'label_attr': {'class': 'rams-dymo'}}) }}
                    {{ form_widget(form.role, {'attr': {'class': 'rams-form__select'}}) }}
                    {{ form_errors(form.role) }}
                </div>

                {# Divider #}
                <div class="rams-divider"></div>

                {# Contact Details Section #}
                <div class="rams-form-section">
                    <h3 class="rams-form-section__title">{{ 'contact.new.contact_details'|trans }}</h3>
                    
                    {# Email and Phone Row #}
                    <div class="rams-grid rams-grid--2">
                        <div class="rams-form__group">
                            {{ form_label(form.email, 'contact.fields.email'|trans, {'label_attr': {'class': 'rams-dymo'}}) }}
                            <div class="rams-form__input-wrapper rams-form__input-wrapper--icon">
                                <svg class="rams-form__input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                {{ form_widget(form.email, {'attr': {'class': 'rams-form__input rams-form__input--with-icon'}}) }}
                            </div>
                            {{ form_errors(form.email) }}
                        </div>
                        <div class="rams-form__group">
                            {{ form_label(form.phone, 'contact.fields.phone'|trans, {'label_attr': {'class': 'rams-dymo'}}) }}
                            <div class="rams-form__input-wrapper rams-form__input-wrapper--icon">
                                <svg class="rams-form__input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                                {{ form_widget(form.phone, {'attr': {'class': 'rams-form__input rams-form__input--with-icon'}}) }}
                            </div>
                            {{ form_errors(form.phone) }}
                        </div>
                    </div>

                    {# LinkedIn URL #}
                    <div class="rams-form__group">
                        {{ form_label(form.linkedInUrl, 'contact.fields.linkedin_url'|trans, {'label_attr': {'class': 'rams-dymo'}}) }}
                        <div class="rams-form__input-wrapper rams-form__input-wrapper--icon">
                            <svg class="rams-form__input-icon rams-icon--linkedin" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                            </svg>
                            {{ form_widget(form.linkedInUrl, {'attr': {'class': 'rams-form__input rams-form__input--with-icon'}}) }}
                        </div>
                        {{ form_errors(form.linkedInUrl) }}
                    </div>
                </div>

            <div class="rams-module__footer">
                <div class="rams-btn-group">
                    <button type="submit" class="rams-btn rams-btn--primary">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        {{ 'contact.actions.create'|trans }}
                    </button>
                    <a href="{{ path('app_contact_index') }}" class="rams-btn rams-btn--secondary">
                        {{ 'common.cancel'|trans }}
                    </a>
                </div>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

</div>
{% endblock %}
