{% extends 'base.html.twig' %}

{% block title %}{{ contact.firstName }} {{ contact.lastName }}{% endblock %}

{% block body %}
<div class="rams-stack rams-gap-6">
    {# Breadcrumb #}
    <nav class="rams-breadcrumb" aria-label="Breadcrumb">
        <ol class="rams-breadcrumb__list">
            <li class="rams-breadcrumb__item"><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item"><a href="{{ path('app_contact_index') }}" class="rams-breadcrumb__link">{{ 'contact.index.title'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__item rams-breadcrumb__item--current">{{ contact.firstName }} {{ contact.lastName }}</li>
        </ol>
    </nav>

    {# Page Header #}
    <div class="rams-page-header">
        <div class="rams-flex rams-items-center rams-gap-4 mobile-stack">
            <div class="rams-badge rams-badge--xl rams-badge--circle rams-badge--primary">
                {{ contact.firstName|slice(0, 1) }}{{ contact.lastName|slice(0, 1) }}
            </div>
            <div>
                <h1 class="rams-page-title">{{ contact.firstName }} {{ contact.lastName }}</h1>
                <div class="rams-flex rams-items-center rams-gap-2 rams-mt-1">
                    {% if contact.jobTitle %}
                        <span class="rams-text--muted rams-text--sm">{{ contact.jobTitle }}</span>
                    {% endif %}
                    {% if safe_company_id(contact) %}
                        <span class="rams-text--muted rams-text--xs">·</span>
                        <a href="{{ path('app_company_show', {id: safe_company_id(contact)}) }}" class="rams-link rams-text--sm">
                            {{ safe_company_name(contact) }}
                        </a>
                    {% endif %}
                    {% if contact.role %}
                        <span class="rams-badge">{{ contact.role }}</span>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <div class="rams-page-actions mobile-stack">
            <div class="rams-btn-group mobile-stack">
                <a href="{{ path('app_contact_edit', {id: contact.id}) }}" class="rams-btn">
                    <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 2L14 5L6 13H3V10L11 2Z"/>
                    </svg>
                    {{ 'common.edit'|trans }}
                </a>
                <form method="post" action="{{ path('app_contact_delete', {id: contact.id}) }}" class="rams-inline-block" onsubmit="return ramsConfirmSubmit(event, '{{ 'contact.confirm.delete'|trans }}', {variant: 'danger'})">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">
                    <button type="submit" class="rams-btn rams-btn--danger">
                        <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M2 4H14M5 4V2H11V4M6 7V11M10 7V11M3 4L4 14H12L13 4"/>
                        </svg>
                        {{ 'common.delete'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="rams-grid rams-grid--3 rams-gap-6 mobile-stack">
        {# Main Content #}
        <div class="rams-grid-span-2 rams-stack rams-gap-6 mobile-w-full">
            {# Contact Information Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'contact.show.contact_information'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-definition-list rams-grid rams-grid--2">
                        {% if contact.email %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'contact.fields.email'|trans }}</dt>
                                <dd class="rams-definition-list__desc">
                                    <a href="mailto:{{ contact.email }}" class="rams-link">{{ contact.email }}</a>
                                </dd>
                            </div>
                        {% endif %}
                        {% if contact.phone %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'contact.fields.phone'|trans }}</dt>
                                <dd class="rams-definition-list__desc">
                                    <a href="tel:{{ contact.phone }}" class="rams-link">{{ contact.phone }}</a>
                                </dd>
                            </div>
                        {% endif %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'contact.fields.company'|trans }}</dt>
                            <dd class="rams-definition-list__desc">
                                {% if safe_company_id(contact) %}
                                    <a href="{{ path('app_company_show', {id: safe_company_id(contact)}) }}" class="rams-link">
                                        {{ safe_company_name(contact) }}
                                    </a>
                                {% else %}
                                    <span class="rams-text--muted">—</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'contact.fields.role'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ contact.role ?? '—' }}</dd>
                        </div>
                        {% if contact.linkedInUrl %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'contact.linkedin.label'|trans }}</dt>
                                <dd class="rams-definition-list__desc">
                                    <a href="{{ contact.linkedInUrl }}" target="_blank" rel="noopener" class="rams-link" style="color: #0077b5;">
                                        <svg style="width:14px;height:14px;vertical-align:middle;margin-right:4px;" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                        </svg>
                                        {{ 'contact.actions.view_profile'|trans }}
                                    </a>
                                </dd>
                            </div>
                        {% endif %}
                        {% if contact.source %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'contact.fields.source'|trans }}</dt>
                                <dd class="rams-definition-list__desc">
                                    <span class="rams-badge rams-badge--info">{{ contact.source }}</span>
                                </dd>
                            </div>
                        {% endif %}
                        {% if contact.primaryContact %}
                            <div class="rams-definition-list__item">
                                <dt class="rams-definition-list__term">{{ 'contact.decision_maker.label'|trans }}</dt>
                                <dd class="rams-definition-list__desc">
                                    <span class="rams-badge rams-badge--success">★ {{ 'contact.decision_maker.label'|trans }}</span>
                                </dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            </div>

            {# Recent Activities Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'contact.show.recent_activities'|trans }}</h2>
                    <a href="{{ path('app_activity_new', {contact: contact.id, redirect: 'app_contact_show', redirect_params: {id: contact.id}|json_encode}) }}" class="rams-btn rams-btn--ghost rams-btn--sm">+ {{ 'activity.actions.log'|trans }}</a>
                </div>
                <div class="rams-module__content">
                    {% if contact.activities is empty %}
                        <div class="rams-empty-state">
                            <p class="rams-text--muted rams-text--sm">{{ 'activity.empty.no_activities'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="rams-stack rams-gap-4">
                            {% for activity in contact.activities|slice(0, 8) %}
                                <div class="rams-flex rams-items-start rams-gap-3">
                                    <div class="rams-andon rams-mt-1">
                                        <span class="rams-andon__light rams-andon__light--{{ activity.type == 'Call' ? 'info' : (activity.type == 'Email' ? 'yellow' : (activity.type == 'Meeting' ? 'green' : '')) }}"></span>
                                    </div>
                                    <div class="rams-flex-1">
                                        <div class="rams-flex rams-justify-between rams-items-center rams-mb-1">
                                            <span class="rams-text--sm rams-text--bold rams-uppercase rams-font-mono">{{ activity.type }}</span>
                                            <span class="rams-text--muted rams-text-2xs rams-font-mono">{{ activity.activityDate|date('M d, Y') }}</span>
                                        </div>
                                        {% if activity.notes %}
                                            <p class="rams-text--muted rams-text--xs">{{ activity.notes|slice(0, 120) }}{% if activity.notes|length > 120 %}...{% endif %}</p>
                                        {% endif %}
                                        <p class="rams-text--muted rams-text-3xs rams-font-mono rams-mt-1">{{ activity.user.firstName }} {{ activity.user.lastName }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Sidebar #}
        <div class="rams-stack rams-gap-6 mobile-w-full">
            {# Contact Details Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'common.details'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-2">
                        {% if contact.source %}
                            <div class="rams-flex rams-justify-between rams-items-center">
                                <span class="rams-text--muted rams-text--xs">{{ 'contact.fields.source'|trans }}</span>
                                <span class="rams-badge">{{ contact.source }}</span>
                            </div>
                        {% endif %}
                        {% if contact.primaryContact %}
                            <div class="rams-flex rams-justify-between rams-items-center">
                                <span class="rams-text--muted rams-text--xs">{{ 'contact.decision_maker.label'|trans }}</span>
                                <span class="rams-badge rams-badge--success">★ {{ 'common.yes'|trans }}</span>
                            </div>
                        {% endif %}
                        <div class="rams-flex rams-justify-between rams-items-center">
                            <span class="rams-text--muted rams-text--xs">{{ 'contact.created_at'|trans }}</span>
                            <span class="rams-text--xs rams-font-mono">{{ contact.createdAt|date('M d, Y') }}</span>
                        </div>
                        {% if contact.notes %}
                            <div class="rams-mt-2">
                                <span class="rams-text--muted rams-text--xs">{{ 'contact.fields.notes'|trans }}</span>
                                <p class="rams-text--xs rams-mt-1 rams-whitespace-pre-line">{{ contact.notes }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Quick Actions Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'common.quick_actions'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-stack rams-gap-2">
                        {% if contact.email %}
                            <a href="mailto:{{ contact.email }}" class="rams-btn rams-w-full">
                                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M2 4L8 8L14 4V12H2V4Z"/>
                                </svg>
                                {{ 'contact.actions.send_email'|trans }}
                            </a>
                        {% endif %}
                        {% if contact.phone %}
                            <a href="tel:{{ contact.phone }}" class="rams-btn rams-w-full">
                                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 3H6L7 6L5 7C6 9 7 10 9 11L10 9L13 10V13C13 14 12 14 12 14C6 14 2 10 2 4C2 4 2 3 3 3Z"/>
                                </svg>
                                {{ 'contact.actions.call'|trans }}
                            </a>
                        {% endif %}
                        {% if contact.linkedInUrl %}
                            <a href="{{ contact.linkedInUrl }}" target="_blank" rel="noopener" class="rams-btn rams-w-full" style="color: #0077b5;">
                                <svg class="rams-btn__icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                                {{ 'contact.linkedin.label'|trans }}
                            </a>
                        {% endif %}
                        <a href="{{ path('app_activity_new', {contact: contact.id}) }}" class="rams-btn rams-btn--primary rams-w-full rams-mt-2">
                            {{ 'activity.actions.log'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
