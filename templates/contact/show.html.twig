{% extends 'base.html.twig' %}

{% block title %}{{ contact.firstName }} {{ contact.lastName }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        {# Breadcrumb #}
        <nav class="mb-6">
            <ol class="flex items-center gap-2 text-sm">
                <li><a href="{{ path('app_dashboard') }}" class="text-neutral-600 hover:text-neutral-900">Dashboard</a></li>
                <li class="text-neutral-400">/</li>
                <li><a href="{{ path('app_contact_index') }}" class="text-neutral-600 hover:text-neutral-900">Contacts</a></li>
                <li class="text-neutral-400">/</li>
                <li class="text-neutral-900 font-medium">{{ contact.firstName }} {{ contact.lastName }}</li>
            </ol>
        </nav>

        {# Header #}
        <div class="flex items-start justify-between mb-6">
            <div class="flex items-start gap-4">
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-white font-semibold text-xl">
                    {{ contact.firstName|slice(0, 1) }}{{ contact.lastName|slice(0, 1) }}
                </div>
                <div class="flex-1">
                    <h1 class="text-3xl font-semibold tracking-tight text-neutral-900">{{ contact.firstName }} {{ contact.lastName }}</h1>
                    <div class="mt-2 flex items-center gap-3">
                        {% if contact.jobTitle %}
                            <span class="text-sm text-neutral-600">{{ contact.jobTitle }}</span>
                        {% endif %}
                        {% if contact.company %}
                            <span class="text-neutral-400">·</span>
                            <a href="{{ path('app_company_show', {id: contact.company.id}) }}" class="text-sm text-blue-600 hover:text-blue-700">
                                {{ contact.company.name }}
                            </a>
                        {% endif %}
                    </div>
                    {% if contact.role %}
                        <div class="mt-2">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-neutral-100 text-neutral-700">
                                {{ contact.role }}
                            </span>
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <div class="flex items-center gap-3">
                <a href="{{ path('app_contact_edit', {id: contact.id}) }}" class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 text-neutral-700 text-sm font-medium rounded-lg hover:bg-neutral-50 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Edit
                </a>
                <form method="post" action="{{ path('app_contact_delete', {id: contact.id}) }}" onsubmit="return confirm('Are you sure you want to delete this contact?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">
                    <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 border border-red-200 text-red-700 text-sm font-medium rounded-lg hover:bg-red-50 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        Delete
                    </button>
                </form>
            </div>
        </div>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 px-4 py-3 rounded-lg {% if label == 'success' %}bg-emerald-50 text-emerald-800 border border-emerald-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            {# Main Content #}
            <div class="lg:col-span-2 space-y-6">
                
                {# Contact Information Card #}
                <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
                    <h2 class="text-base font-semibold text-neutral-900 mb-4">Contact Information</h2>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                        {% if contact.email %}
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Email</dt>
                                <dd class="mt-1">
                                    <a href="mailto:{{ contact.email }}" class="text-sm text-blue-600 hover:text-blue-700">{{ contact.email }}</a>
                                </dd>
                            </div>
                        {% endif %}
                        {% if contact.phone %}
                            <div>
                                <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Phone</dt>
                                <dd class="mt-1">
                                    <a href="tel:{{ contact.phone }}" class="text-sm text-blue-600 hover:text-blue-700">{{ contact.phone }}</a>
                                </dd>
                            </div>
                        {% endif %}
                        <div>
                            <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Company</dt>
                            <dd class="mt-1 text-sm text-neutral-900">
                                {% if contact.company %}
                                    <a href="{{ path('app_company_show', {id: contact.company.id}) }}" class="text-blue-600 hover:text-blue-700">
                                        {{ contact.company.name }}
                                    </a>
                                {% else %}
                                    —
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-neutral-500 uppercase tracking-wide">Role</dt>
                            <dd class="mt-1 text-sm text-neutral-900">{{ contact.role ?? '—' }}</dd>
                        </div>
                    </dl>
                </div>

                {# LinkedIn Integration Card #}
                {% if contact.linkedInUrl %}
                    <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-2">
                                <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                                <h2 class="text-base font-semibold text-neutral-900">LinkedIn Outreach</h2>
                            </div>
                            <a href="{{ contact.linkedInUrl }}" target="_blank" class="text-sm text-blue-600 hover:text-blue-700">View Profile</a>
                        </div>

                        {% if linkedInMetrics %}
                            <div class="grid grid-cols-3 gap-4 mb-4">
                                <div class="text-center p-3 rounded-lg bg-neutral-50">
                                    <div class="text-2xl font-semibold text-neutral-900">{{ linkedInMetrics.connection_requests }}</div>
                                    <div class="text-xs text-neutral-600 mt-1">Connections</div>
                                </div>
                                <div class="text-center p-3 rounded-lg bg-neutral-50">
                                    <div class="text-2xl font-semibold text-neutral-900">{{ linkedInMetrics.inmails }}</div>
                                    <div class="text-xs text-neutral-600 mt-1">InMails</div>
                                </div>
                                <div class="text-center p-3 rounded-lg bg-neutral-50">
                                    <div class="text-2xl font-semibold text-neutral-900">{{ linkedInMetrics.profile_views }}</div>
                                    <div class="text-xs text-neutral-600 mt-1">Profile Views</div>
                                </div>
                            </div>
                        {% endif %}

                        <form method="post" action="{{ path('app_contact_linkedin_outreach', {id: contact.id}) }}" class="space-y-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('linkedin_outreach' ~ contact.id) }}">
                            <div>
                                <label class="block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2">Outreach Type</label>
                                <select name="type" class="w-full px-4 py-2 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                                    <option value="Connection Request">Connection Request</option>
                                    <option value="LinkedIn Message">LinkedIn Message</option>
                                    <option value="LinkedIn InMail">LinkedIn InMail</option>
                                    <option value="Profile View">Profile View</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-neutral-700 uppercase tracking-wide mb-2">Notes</label>
                                <textarea name="notes" rows="2" class="w-full px-4 py-2 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500" placeholder="Optional notes about this outreach..."></textarea>
                            </div>
                            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                                Track Outreach
                            </button>
                        </form>
                    </div>
                {% endif %}

                {# Recent Activities #}
                <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-base font-semibold text-neutral-900">Recent Activities</h2>
                        <a href="{{ path('app_activity_new', {contact: contact.id}) }}" class="text-sm text-blue-600 hover:text-blue-700 font-medium">+ Log Activity</a>
                    </div>
                    {% if contact.activities is empty %}
                        <div class="text-center py-8 text-sm text-neutral-500">
                            No activities recorded
                        </div>
                    {% else %}
                        <div class="space-y-3">
                            {% for activity in contact.activities|slice(0, 8) %}
                                <div class="flex items-start gap-3 p-3 border border-neutral-200/60 rounded-lg hover:bg-neutral-50">
                                    <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0
                                        {% if activity.type == 'Call' %}bg-blue-50 text-blue-600
                                        {% elseif activity.type == 'Email' %}bg-purple-50 text-purple-600
                                        {% elseif activity.type == 'Meeting' %}bg-emerald-50 text-emerald-600
                                        {% elseif activity.type starts with 'LinkedIn' %}bg-blue-50 text-blue-700
                                        {% else %}bg-neutral-50 text-neutral-600{% endif %}">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-neutral-900">{{ activity.type }}</p>
                                        {% if activity.notes %}
                                            <p class="text-xs text-neutral-500 mt-0.5">{{ activity.notes|slice(0, 80) }}...</p>
                                        {% endif %}
                                        <p class="text-xs text-neutral-400 mt-1">{{ activity.activityDate|date('M d, Y') }} · {{ activity.user.firstName }} {{ activity.user.lastName }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

            </div>

            {# Sidebar #}
            <div class="space-y-6">
                
                {# Quick Actions Card #}
                <div class="bg-white rounded-xl border border-neutral-200/60 p-6">
                    <h2 class="text-base font-semibold text-neutral-900 mb-4">Quick Actions</h2>
                    <div class="space-y-2">
                        {% if contact.email %}
                            <a href="mailto:{{ contact.email }}" class="flex items-center gap-3 p-3 border border-neutral-200/60 rounded-lg hover:bg-neutral-50 transition-colors">
                                <div class="w-8 h-8 rounded-lg bg-purple-50 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                                <span class="text-sm font-medium text-neutral-900">Send Email</span>
                            </a>
                        {% endif %}
                        {% if contact.phone %}
                            <a href="tel:{{ contact.phone }}" class="flex items-center gap-3 p-3 border border-neutral-200/60 rounded-lg hover:bg-neutral-50 transition-colors">
                                <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                </div>
                                <span class="text-sm font-medium text-neutral-900">Call</span>
                            </a>
                        {% endif %}
                        <a href="{{ path('app_activity_new', {contact: contact.id}) }}" class="flex items-center gap-3 p-3 border border-neutral-200/60 rounded-lg hover:bg-neutral-50 transition-colors">
                            <div class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center">
                                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                </svg>
                            </div>
                            <span class="text-sm font-medium text-neutral-900">Log Activity</span>
                        </a>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>
{% endblock %}
