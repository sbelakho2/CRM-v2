{% extends 'base.html.twig' %}

{% block title %}{{ contact.firstName }} {{ contact.lastName }}{% endblock %}

{% block body %}
<div class="rams-container">
    
    {# Breadcrumb #}
    <nav class="rams-breadcrumb">
        <ol class="rams-breadcrumb__list">
            <li><a href="{{ path('app_dashboard') }}" class="rams-breadcrumb__link">{{ 'nav.dashboard'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li><a href="{{ path('app_contact_index') }}" class="rams-breadcrumb__link">{{ 'contact.index.title'|trans }}</a></li>
            <li class="rams-breadcrumb__separator">/</li>
            <li class="rams-breadcrumb__current">{{ contact.firstName }} {{ contact.lastName }}</li>
        </ol>
    </nav>

    {# Header #}
    <div class="rams-page-header rams-page-header--with-avatar">
        <div class="rams-profile-header">
            <div class="rams-avatar rams-avatar--large">
                {{ contact.firstName|slice(0, 1) }}{{ contact.lastName|slice(0, 1) }}
            </div>
            <div class="rams-profile-header__content">
                <h1 class="rams-page-title">{{ contact.firstName }} {{ contact.lastName }}</h1>
                <div class="rams-profile-header__meta">
                    {% if contact.jobTitle %}
                        <span class="rams-text--secondary">{{ contact.jobTitle }}</span>
                    {% endif %}
                    {% if contact.company %}
                        <span class="rams-separator">·</span>
                        <a href="{{ path('app_company_show', {id: contact.company.id}) }}" class="rams-link">
                            {{ contact.company.name }}
                        </a>
                    {% endif %}
                </div>
                {% if contact.role %}
                    <div class="rams-profile-header__badges">
                        <span class="rams-badge">{{ contact.role }}</span>
                    </div>
                {% endif %}
            </div>
        </div>
        
        <div class="rams-btn-group">
            <a href="{{ path('app_contact_edit', {id: contact.id}) }}" class="rams-btn rams-btn--secondary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                {{ 'common.edit'|trans }}
            </a>
            <form method="post" action="{{ path('app_contact_delete', {id: contact.id}) }}" onsubmit="return confirm('{{ 'contact.confirm.delete'|trans }}');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">
                <button type="submit" class="rams-btn rams-btn--danger">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    {{ 'common.delete'|trans }}
                </button>
            </form>
        </div>
    </div>

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rams-alert rams-alert--{{ label == 'success' ? 'success' : 'info' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="rams-grid rams-grid--sidebar">
        
        {# Main Content #}
        <div class="rams-grid__main">
            
            {# Contact Information Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'contact.show.contact_information'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <dl class="rams-detail-list rams-detail-list--grid">
                        {% if contact.email %}
                            <div class="rams-detail-list__item">
                                <dt class="rams-dymo">{{ 'contact.fields.email'|trans }}</dt>
                                <dd>
                                    <a href="mailto:{{ contact.email }}" class="rams-link">{{ contact.email }}</a>
                                </dd>
                            </div>
                        {% endif %}
                        {% if contact.phone %}
                            <div class="rams-detail-list__item">
                                <dt class="rams-dymo">{{ 'contact.fields.phone'|trans }}</dt>
                                <dd>
                                    <a href="tel:{{ contact.phone }}" class="rams-link">{{ contact.phone }}</a>
                                </dd>
                            </div>
                        {% endif %}
                        <div class="rams-detail-list__item">
                            <dt class="rams-dymo">{{ 'contact.fields.company'|trans }}</dt>
                            <dd>
                                {% if contact.company %}
                                    <a href="{{ path('app_company_show', {id: contact.company.id}) }}" class="rams-link">
                                        {{ contact.company.name }}
                                    </a>
                                {% else %}
                                    <span class="rams-text--muted">—</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div class="rams-detail-list__item">
                            <dt class="rams-dymo">{{ 'contact.fields.role'|trans }}</dt>
                            <dd>{{ contact.role ?? '—' }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# LinkedIn Integration Module #}
            {% if contact.linkedInUrl %}
                <div class="rams-module">
                    <div class="rams-module__header">
                        <div class="rams-module__header-left">
                            <svg class="w-5 h-5 rams-icon--linkedin" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                            </svg>
                            <h2 class="rams-module__title">{{ 'contact.show.linkedin_outreach'|trans }}</h2>
                        </div>
                        <a href="{{ contact.linkedInUrl }}" target="_blank" class="rams-link">{{ 'contact.actions.view_profile'|trans }}</a>
                    </div>
                    <div class="rams-module__content">
                        {% if linkedInMetrics %}
                            <div class="rams-metrics-row">
                                <div class="rams-metric-box">
                                    <div class="rams-metric rams-metric--large">{{ linkedInMetrics.connection_requests }}</div>
                                    <div class="rams-dymo">{{ 'contact.linkedin.connections'|trans }}</div>
                                </div>
                                <div class="rams-metric-box">
                                    <div class="rams-metric rams-metric--large">{{ linkedInMetrics.inmails }}</div>
                                    <div class="rams-dymo">{{ 'contact.linkedin.inmails'|trans }}</div>
                                </div>
                                <div class="rams-metric-box">
                                    <div class="rams-metric rams-metric--large">{{ linkedInMetrics.profile_views }}</div>
                                    <div class="rams-dymo">{{ 'contact.linkedin.profile_views'|trans }}</div>
                                </div>
                            </div>
                        {% endif %}

                        <form method="post" action="{{ path('app_contact_linkedin_outreach', {id: contact.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('linkedin_outreach' ~ contact.id) }}">
                            <div class="rams-form__group">
                                <label class="rams-dymo">{{ 'contact.linkedin.outreach_type'|trans }}</label>
                                <select name="type" class="rams-form__select">
                                    <option value="Connection Request">{{ 'contact.linkedin.type.connection_request'|trans }}</option>
                                    <option value="LinkedIn Message">{{ 'contact.linkedin.type.message'|trans }}</option>
                                    <option value="LinkedIn InMail">{{ 'contact.linkedin.type.inmail'|trans }}</option>
                                    <option value="Profile View">{{ 'contact.linkedin.type.profile_view'|trans }}</option>
                                </select>
                            </div>
                            <div class="rams-form__group">
                                <label class="rams-dymo">{{ 'common.notes'|trans }}</label>
                                <textarea name="notes" rows="2" class="rams-form__input" placeholder="{{ 'contact.linkedin.notes_placeholder'|trans }}"></textarea>
                            </div>
                            <button type="submit" class="rams-btn rams-btn--secondary rams-btn--full">
                                {{ 'contact.linkedin.track_outreach'|trans }}
                            </button>
                        </form>
                    </div>
                </div>
            {% endif %}

            {# Recent Activities Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'contact.show.recent_activities'|trans }}</h2>
                    <a href="{{ path('app_activity_new', {contact: contact.id}) }}" class="rams-link">+ {{ 'activity.actions.log'|trans }}</a>
                </div>
                <div class="rams-module__content">
                    {% if contact.activities is empty %}
                        <div class="rams-empty-state rams-empty-state--compact">
                            <p class="rams-text--muted">{{ 'activity.empty.no_activities'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="rams-activity-list">
                            {% for activity in contact.activities|slice(0, 8) %}
                                <div class="rams-activity-item">
                                    <div class="rams-andon rams-andon--{{ activity.type == 'Call' ? 'info' : (activity.type == 'Email' ? 'secondary' : (activity.type == 'Meeting' ? 'success' : 'default')) }}">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                        </svg>
                                    </div>
                                    <div class="rams-activity-item__content">
                                        <p class="rams-activity-item__title">{{ activity.type }}</p>
                                        {% if activity.notes %}
                                            <p class="rams-activity-item__description">{{ activity.notes|slice(0, 80) }}...</p>
                                        {% endif %}
                                        <p class="rams-activity-item__meta">{{ activity.activityDate|date('M d, Y') }} · {{ activity.user.firstName }} {{ activity.user.lastName }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>

        {# Sidebar #}
        <div class="rams-grid__sidebar">
            
            {# Quick Actions Module #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-module__title">{{ 'common.quick_actions'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <div class="rams-action-list">
                        {% if contact.email %}
                            <a href="mailto:{{ contact.email }}" class="rams-action-item">
                                <div class="rams-andon rams-andon--secondary">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                                <span>{{ 'contact.actions.send_email'|trans }}</span>
                            </a>
                        {% endif %}
                        {% if contact.phone %}
                            <a href="tel:{{ contact.phone }}" class="rams-action-item">
                                <div class="rams-andon rams-andon--info">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                </div>
                                <span>{{ 'contact.actions.call'|trans }}</span>
                            </a>
                        {% endif %}
                        <a href="{{ path('app_activity_new', {contact: contact.id}) }}" class="rams-action-item">
                            <div class="rams-andon rams-andon--success">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                </svg>
                            </div>
                            <span>{{ 'activity.actions.log'|trans }}</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
{% endblock %}
