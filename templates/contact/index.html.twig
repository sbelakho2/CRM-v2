{% extends 'base.html.twig' %}

{% block title %}{{ 'contact.index.title'|trans }}{% endblock %}

{% block body %}
<div class="rams-page">
        
    {# Header with Create Button #}
    <div class="rams-page-header">
        <div>
            <h1 class="rams-page-title">{{ 'contact.index.title'|trans }}</h1>
            <p class="rams-page-subtitle">{{ 'contact.index.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('app_contact_new') }}" class="rams-btn rams-btn--primary">
            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            {{ 'contact.actions.new'|trans }}
        </a>
    </div>

    {# Filters - Compact horizontal layout #}
    <div class="rams-module rams-mb-6">  
        <div class="rams-module__content"> 
            <form method="get" action="{{ path('app_contact_index') }}" class="rams-stack rams-gap-3"> 
                <div class="rams-flex rams-flex-wrap rams-items-end rams-gap-3">    
                    <div class="rams-flex-1">  
                        <label for="contact-filter-search" class="rams-text--xs rams-text--muted rams-mb-1 rams-block">{{      'common.search'|trans }}</label>
                        <input type="text" name="search" id="contact-filter-search" placeholder="{{ 'contact.filters.search_placeholder'|trans }}" value="{{ current_search }}" class="rams-input rams-text--sm rams-w-full">   
                    </div>
                    <div class="rams-w-auto"> 
                        <label for="contact-filter-role" class="rams-text--xs rams-text--muted rams-mb-1 rams-block">{{      'contact.fields.role'|trans }}</label>
                        <select name="role" id="contact-filter-role" class="rams-input rams-text--sm rams-w-full">   
                            <option value="">{{ 'contact.filters.all_roles'|trans }}</option>
                            {% for role in roles %}
                                <option value="{{ role }}" {{ current_role == role ? 'selected' : '' }}>{{ role }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="rams-w-auto"> 
                        <label for="contact-filter-company" class="rams-text--xs rams-text--muted rams-mb-1 rams-block">{{      'contact.fields.company'|trans }}</label>
                        <select name="company" id="contact-filter-company" class="rams-input rams-text--sm rams-w-full">   
                            <option value="">{{ 'contact.filters.all_companies'|trans }}</option>
                            {% for company in companies %}
                                <option value="{{ company.id }}" {{ current_company == company.id ? 'selected' : '' }}>{{ company.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="rams-flex rams-items-end rams-gap-2">   
                        <button type="submit" class="rams-btn rams-btn--primary rams-text--sm">{{    'common.apply_filters'|trans }}</button>
                        <a href="{{ path('app_contact_index') }}" class="rams-btn rams-text--sm">{{    'common.clear'|trans }}</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rams-alert rams-alert--{{ label == 'success' ? 'success' : 'info' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {# Results Count #}
    <div class="rams-results-count">
        {{ 'common.showing'|trans }} <span class="rams-font-mono rams-text--bold">{{ contacts|length }}</span> {{ 'contact.index.contacts'|trans }}
    </div>

    {# Contacts Table Module #}
    <div class="rams-module">
        <div class="rams-module__content rams-module__content--flush">
            <div class="rams-table-container">
            <table class="rams-table data-table">
                <caption class="rams-sr-only">{{ 'contact.index.title'|trans }}</caption>
                <thead>
                    <tr>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'contact.table.contact'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'contact.fields.company'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'contact.fields.role'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'contact.table.contact_info'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header rams-table__cell--actions">
                            <span class="rams-sr-only">{{ 'common.actions'|trans }}</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for contact in contacts %}
                        <tr class="rams-table__row">
                            <td class="rams-table__cell">
                                <div class="rams-contact-avatar">
                                    <div class="rams-contact-avatar__icon">
                                        {{ contact.firstName|slice(0, 1) }}{{ contact.lastName|slice(0, 1) }}
                                    </div>
                                    <div class="rams-contact-avatar__details">
                                        <div class="rams-contact-avatar__name">{{ contact.firstName }} {{ contact.lastName }}</div>
                                        {% if contact.jobTitle %}
                                            <div class="rams-contact-avatar__subtitle">{{ contact.jobTitle }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                            <td class="rams-table__cell">
                                {% if safe_company_id(contact) %}
                                    <a href="{{ path('app_company_show', {id: safe_company_id(contact)}) }}" class="rams-link">
                                        {{ safe_company_name(contact) }}
                                    </a>
                                {% else %}
                                    <span class="rams-text--muted">—</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell">
                                {% if contact.role %}
                                    <span class="rams-badge">{{ contact.role }}</span>
                                {% else %}
                                    <span class="rams-text--muted">—</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell">
                                <div class="rams-contact-icons">
                                    {% if contact.email %}
                                        <a href="mailto:{{ contact.email }}" class="rams-icon-link" title="{{ contact.email }}" aria-label="{{ contact.email }}">
                                            <svg class="rams-icon-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                            </svg>
                                        </a>
                                    {% endif %}
                                    {% if contact.phone %}
                                        <a href="tel:{{ contact.phone }}" class="rams-icon-link" title="{{ contact.phone }}" aria-label="{{ contact.phone }}">
                                            <svg class="rams-icon-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                            </svg>
                                        </a>
                                    {% endif %}
                                    {% if contact.linkedInUrl %}
                                        <a href="{{ contact.linkedInUrl }}" target="_blank" rel="noopener" class="rams-icon-link rams-link--linkedin" title="{{ 'contact.linkedin.label'|trans }}" aria-label="{{ 'contact.linkedin.label'|trans }}">
                                            <svg class="rams-icon-sm" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                            </svg>
                                        </a>
                                    {% endif %}
                                    {% if contact.primaryContact %}
                                        <span class="rams-badge rams-badge--success" title="{{ 'contact.decision_maker.label'|trans }}" style="font-size: 0.65rem;">★ {{ 'contact.decision_maker.short'|trans }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="rams-table__cell rams-table__cell--actions">
                                <a href="{{ path('app_contact_show', {id: contact.id}) }}" class="rams-btn rams-btn--ghost">{{ 'common.view'|trans }}</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="rams-table__cell rams-table__cell">
                                <div class="rams-empty-state">
                                    <svg class="rams-empty-state__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <circle cx="8" cy="5" r="3" stroke-width="2"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 13C2 10 5 9 8 9C11 9 14 10 14 13"/>
                                    </svg>
                                    <h3 class="rams-empty-state__title">{{ 'contact.empty.title'|trans }}</h3>
                                    <p class="rams-empty-state__description">{{ 'contact.empty.description'|trans }}</p>
                                    <a href="{{ path('app_contact_new') }}" class="rams-btn rams-btn--primary">
                                        <svg class="rams-icon-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                        </svg>
                                        {{ 'contact.actions.create_first'|trans }}
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
