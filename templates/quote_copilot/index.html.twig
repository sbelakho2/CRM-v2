{% extends 'base.html.twig' %}

{% block title %}Quote Co-Pilot{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-lg p-4 {% if label == 'error' %}bg-red-50 border border-red-200 text-red-800{% elseif label == 'success' %}bg-green-50 border border-green-200 text-green-800{% else %}bg-blue-50 border border-blue-200 text-blue-800{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Header with Geist-style typography -->
    <div class="border-b border-neutral-200/80 pb-5">
        <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Quote Co-Pilot</h1>
        <p class="mt-1.5 text-sm text-neutral-600">Upload BOM files and get automated quote generation with pricing coverage analysis</p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <!-- Upload Section -->
        <div class="lg:col-span-2">
            <div class="rounded-xl border border-neutral-200/60 bg-white p-8">
                <h2 class="text-lg font-semibold tracking-tight text-neutral-900 mb-6">Upload BOM File</h2>
                
                <form method="POST" action="{{ path('quote_copilot_process') }}" enctype="multipart/form-data" class="space-y-6" id="bom-upload-form">
                    <!-- Company Selection -->
                    <div>
                        <label class="text-sm font-medium text-neutral-900">Customer Company</label>
                        <select name="company_id" required class="mt-1 w-full rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-neutral-900 transition-colors hover:border-neutral-300 focus:border-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-400">
                            <option value="">Select a company...</option>
                            {% for company in companies %}
                                <option value="{{ company.id }}">{{ company.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- BOM File Upload -->
                    <div>
                        <label class="text-sm font-medium text-neutral-900">BOM File (CSV)</label>
                        <div class="mt-2 rounded-lg border-2 border-dashed border-neutral-300 p-8 text-center transition-colors hover:bg-neutral-50">
                            <svg class="mx-auto mb-4 h-12 w-12 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            <p class="mb-2 text-sm font-semibold text-neutral-900">Click to upload BOM CSV</p>
                            <p class="mb-4 text-xs text-neutral-600">CSV format with columns: Part Number, Description, Quantity, Manufacturer, Reference Designators</p>
                            <input type="file" name="bom_file" required accept=".csv" class="hidden" id="bom-file-input" onchange="displayFileName(this)">
                            <button type="button" onclick="document.getElementById('bom-file-input').click()" class="inline-flex items-center rounded-lg bg-neutral-900 px-6 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-800">
                                Choose CSV File
                            </button>
                            <div id="file-name-display" class="mt-3 text-sm text-neutral-600"></div>
                        </div>
                    </div>

                    <!-- Shipment Details -->
                    <div class="rounded-lg bg-neutral-50/50 p-4 space-y-4 border border-neutral-200/60">
                        <h3 class="text-sm font-semibold text-neutral-900">Shipment Details</h3>
                        
                        <div>
                            <label class="text-sm font-medium text-neutral-900">Destination Country</label>
                            <select name="ship_to_country" required class="mt-1 w-full rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-neutral-900 transition-colors hover:border-neutral-300 focus:border-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-400">
                                <option value="">Select destination...</option>
                                {% for code, name in countries %}
                                    <option value="{{ code }}">{{ name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div>
                            <label class="text-sm font-medium text-neutral-900">Assembly Quantity</label>
                            <input type="number" name="quantity" value="100" min="1" required class="mt-1 w-full rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-neutral-900 transition-colors hover:border-neutral-300 focus:border-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-400">
                            <p class="mt-1 text-xs text-neutral-500">Number of PCB assemblies to produce</p>
                        </div>

                        <div>
                            <label class="text-sm font-medium text-neutral-900">Incoterms</label>
                            <select name="incoterms" class="mt-1 w-full rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-neutral-900 transition-colors hover:border-neutral-300 focus:border-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-400">
                                <option value="FCA">FCA (Free Carrier)</option>
                                <option value="CIF">CIF (Cost, Insurance & Freight)</option>
                                <option value="DDP">DDP (Delivered Duty Paid)</option>
                                <option value="EXW">EXW (Ex Works)</option>
                            </select>
                        </div>

                        <div>
                            <label class="text-sm font-medium text-neutral-900">Notes (optional)</label>
                            <textarea name="notes" rows="3" class="mt-1 w-full rounded-lg border border-neutral-200/60 bg-white px-4 py-2 text-neutral-900 transition-colors hover:border-neutral-300 focus:border-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-400" placeholder="Special requirements, RFQ reference, etc."></textarea>
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="flex gap-4">
                        <button type="submit" class="flex-1 inline-flex items-center justify-center rounded-lg bg-neutral-900 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-neutral-800">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                            Generate Quote
                        </button>
                        <button type="reset" onclick="document.getElementById('file-name-display').textContent = ''" class="flex-1 inline-flex items-center justify-center rounded-lg border border-neutral-200/60 bg-white px-6 py-3 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-50">
                            Clear Form
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Info Sidebar -->
        <div class="space-y-6">
            <!-- Process Steps -->
            <div class="rounded-xl border border-neutral-200/60 bg-white p-6">
                <h3 class="text-sm font-medium uppercase tracking-wide text-neutral-600 mb-4">How It Works</h3>
                <ol class="space-y-3 text-sm text-neutral-700">
                    <li class="flex gap-3">
                        <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-neutral-900 text-white text-xs font-semibold">1</span>
                        <span>Upload your BOM CSV file</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-neutral-900 text-white text-xs font-semibold">2</span>
                        <span>System parses components and looks up pricing</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-neutral-900 text-white text-xs font-semibold">3</span>
                        <span>Pricing coverage % calculated</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-neutral-900 text-white text-xs font-semibold">4</span>
                        <span>Review quote and publish to customer</span>
                    </li>
                </ol>
            </div>

            <!-- Coverage Metrics -->
            <div class="rounded-xl border border-neutral-200/60 bg-white p-6">
                <h3 class="text-sm font-medium uppercase tracking-wide text-neutral-600 mb-4">Coverage Metrics</h3>
                <ul class="space-y-3 text-sm text-neutral-700">
                    <li class="flex gap-2">
                        <span class="font-semibold text-green-600">✓</span>
                        <span><strong>High (>90%):</strong> Auto-publish eligible</span>
                    </li>
                    <li class="flex gap-2">
                        <span class="font-semibold text-yellow-600">⚠</span>
                        <span><strong>Medium (60-90%):</strong> Review required</span>
                    </li>
                    <li class="flex gap-2">
                        <span class="font-semibold text-red-600">✗</span>
                        <span><strong>Low (<60%):</strong> Manual pricing needed</span>
                    </li>
                </ul>
            </div>

            <!-- Sample BOM Format -->
            <div class="rounded-xl border border-neutral-200/60 bg-white p-6">
                <h3 class="text-sm font-medium uppercase tracking-wide text-neutral-600 mb-4">CSV Format Example</h3>
                <div class="text-xs text-neutral-700 font-mono bg-neutral-50 p-3 rounded border border-neutral-200 overflow-x-auto">
                    <div>Part Number,Description,Quantity,Manufacturer,Reference Designators</div>
                    <div class="text-neutral-500">STM32F407VGT6,MCU 32-bit,1,STMicroelectronics,U1</div>
                    <div class="text-neutral-500">GRM155R71C104KA88D,CAP 100nF,10,Murata,C1-C10</div>
                </div>
                <a href="/samples/sample-bom.csv" download class="mt-3 inline-flex items-center text-xs text-neutral-600 hover:text-neutral-900">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    Download sample BOM
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function displayFileName(input) {
    const display = document.getElementById('file-name-display');
    if (input.files && input.files[0]) {
        display.textContent = '✓ ' + input.files[0].name;
        display.classList.add('text-green-600', 'font-medium');
    } else {
        display.textContent = '';
    }
}
</script>
{% endblock %}
