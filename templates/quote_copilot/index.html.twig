{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.copilot.title'|trans }}{% endblock %}


{% block stylesheets %}
{{ parent() }}
<style>
    .rams-list__item { display: flex; align-items: flex-start; gap: var(--space-2); }
    .rams-list__number { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--rams-panel); border: 1px solid var(--rams-line); display: flex; align-items: center; justify-content: center; font-size: var(--text-2xs); font-weight: 700; color: var(--rams-muted); }
    .rams-list__text { font-size: var(--text-sm); }
</style>
{% endblock %}

{% block body %}
{# Loading Overlay #}
<div id="loading-overlay" class="rams-loading-overlay rams-hidden-soft">
    <div class="rams-loading-overlay__content">
        <div class="rams-loading-spinner">
            <svg class="rams-loading-spinner__svg" viewBox="0 0 50 50" aria-hidden="true">
                <circle class="rams-loading-spinner__circle" cx="25" cy="25" r="20" fill="none" stroke-width="4"></circle>
            </svg>
        </div>
        <h2 class="rams-loading-overlay__title">{{ 'quote.copilot.processing_title'|trans }}</h2>
        <p class="rams-loading-overlay__message">{{ 'quote.copilot.processing_message'|trans }}</p>
        <p class="rams-loading-overlay__hint">{{ 'quote.copilot.processing_hint'|trans }}</p>
    </div>
</div>

<div class="rams-stack rams-stack--lg">
    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rams-andon rams-andon--{{ label == 'error' ? 'red' : (label == 'success' ? 'green' : 'blue') }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {# Page Header #}
    <header class="rams-module__header rams-module__header--border-bottom">
        <h1 class="rams-heading rams-heading--1">{{ 'quote.copilot.title'|trans }}</h1>
        <p class=" rams-text--muted">{{ 'quote.copilot.subtitle'|trans }}</p>
    </header>

    <div class="rams-grid rams-grid--3 rams-gap-6">
        {# Upload Section - 2 columns #}
        <div class="rams-grid-span-2">
            <div class="rams-module">
                <div class="rams-module__header">
                    <h2 class="rams-heading rams-heading--3">{{ 'quote.copilot.upload_bom'|trans }}</h2>
                </div>
                <div class="rams-module__content">
                    <form method="POST" action="{{ path('quote_copilot_process') }}" enctype="multipart/form-data" id="bom-upload-form">
                        {# Issuing Company Selection #}
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'quote.issuing_company'|trans({}, 'messages')|default('Issuing Company') }}</label>
                            <select name="issuing_company" required class="rams-form__select">
                                {% for key, profile in issuingCompanies %}
                                    <option value="{{ key }}" {{ key == defaultIssuer ? 'selected' : '' }}>{{ profile.name }} ({{ profile.country }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Company Selection #}
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'quote.company'|trans }}</label>
                            <select name="company_id" required class="rams-form__select">
                                <option value="">{{ 'common.select'|trans }}...</option>
                                {% for company in companies %}
                                    <option value="{{ company.id }}">{{ company.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        {# BOM File Upload #}
                        <div class="rams-form__group">
                            <label class="rams-form__label rams-dymo">{{ 'quote.copilot.bom_file'|trans }}</label>
                            <div class="rams-upload-zone" role="button" tabindex="0" onclick="document.getElementById('bom-file-input').click()" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); document.getElementById('bom-file-input').click(); }">
                                <svg class="rams-upload-zone__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
                                </svg>
                                <p class="rams-upload-zone__title">{{ 'quote.copilot.click_to_upload'|trans }}</p>
                                <p class="rams-upload-zone__hint">{{ 'quote.copilot.csv_format_hint'|trans }}</p>
                                <input type="file" name="bom_file" required accept=".csv,.xlsx,.xls" class="rams-sr-only" id="bom-file-input" onchange="displayFileName(this)">
                                <button type="button" class="rams-btn rams-btn--primary">{{  'quote.copilot.choose_file'|trans }}</button>
                                <div id="file-name-display" class="rams-upload-zone__filename"></div>
                            </div>
                        </div>

                        {# Shipment Details #}
                        <div class="rams-module rams-module--inset">
                            <div class="rams-module__header">
                                <h3 class="rams-heading rams-heading--4 rams-dymo">{{ 'quote.copilot.shipment_details'|trans }}</h3>
                            </div>
                            <div class="rams-module__content">
                                <div class="rams-form__group">
                                    <label class="rams-form__label rams-dymo">{{ 'quote.copilot.destination_country'|trans }}</label>
                                    <select name="ship_to_country" required class="rams-form__select">
                                        <option value="">{{ 'common.select'|trans }}...</option>
                                        {% for code, name in countries %}
                                            <option value="{{ code }}">{{ name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="rams-form__group">
                                    <label class="rams-form__label rams-dymo">{{ 'quote.copilot.board_count'|trans }}</label>
                                    <input type="number" name="board_count" value="1" min="1" required class="rams-form__input">
                                    <p class="rams-form__hint">{{ 'quote.copilot.board_count_hint'|trans }}</p>
                                </div>

                                <div class="rams-form__group">
                                    <label class="rams-form__label rams-dymo">{{ 'quote.copilot.order_multiple'|trans }}</label>
                                    <select name="order_multiple" class="rams-form__select">
                                        <option value="1">1 (no rounding)</option>
                                        <option value="10" selected>10</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                        <option value="250">250</option>
                                        <option value="500">500</option>
                                        <option value="1000">1000</option>
                                    </select>
                                    <p class="rams-form__hint">{{ 'quote.copilot.order_multiple_hint'|trans }}</p>
                                </div>

                                <div class="rams-form__group">
                                    <label class="rams-form__label rams-dymo">{{ 'quote.copilot.pricing_providers'|trans }}</label>
                                    <div class="rams-form__group rams-flex rams-gap-3">
                                        <label class="rams-form__checkbox rams-stack-h">
                                            <input type="checkbox" name="providers[]" value="alibaba" checked class="rams-form__checkbox">
                                            <span>Alibaba</span>
                                        </label>
                                        <label class="rams-form__checkbox rams-stack-h">
                                            <input type="checkbox" name="providers[]" value="mouser" checked class="rams-form__checkbox">
                                            <span>Mouser</span>
                                        </label>
                                        <label class="rams-form__checkbox rams-stack-h">
                                            <input type="checkbox" name="providers[]" value="digikey" checked class="rams-form__checkbox">
                                            <span>DigiKey</span>
                                        </label>
                                        <label class="rams-form__checkbox rams-stack-h">
                                            <input type="checkbox" name="providers[]" value="nexar" checked class="rams-form__checkbox">
                                            <span>Nexar</span>
                                        </label>
                                    </div>
                                    <p class="rams-form__hint">{{ 'quote.copilot.pricing_providers_hint'|trans }}</p>
                                </div>

                                <div class="rams-form__group">
                                    <label class="rams-form__label rams-dymo">{{ 'quote.copilot.incoterms_label'|trans }}</label>
                                    <select name="incoterms" class="rams-form__select">
                                        <option value="FCA">{{ 'quote.copilot.incoterms.fca'|trans }}</option>
                                        <option value="CIF">{{ 'quote.copilot.incoterms.cif'|trans }}</option>
                                        <option value="DDP">{{ 'quote.copilot.incoterms.ddp'|trans }}</option>
                                        <option value="EXW">{{ 'quote.copilot.incoterms.exw'|trans }}</option>
                                    </select>
                                </div>

                                <div class="rams-form__group">
                                    <label class="rams-form__label rams-dymo">{{ 'common.notes'|trans }} ({{ 'common.optional'|trans|lower }})</label>
                                    <textarea name="notes" rows="3" class="rams-form__textarea" placeholder="{{ 'quote.copilot.notes_placeholder'|trans }}"></textarea>
                                </div>
                            </div>
                        </div>

                        {# Submit Buttons #}
                        <div class="rams-form__actions">
                            <button type="submit" class="rams-btn rams-btn--primary rams-btn--lg"> 
                                <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                                {{ 'quote.copilot.generate_quote'|trans }}
                            </button>
                            <button type="reset" onclick="document.getElementById('file-name-display').textContent = ''" class="rams-btn rams-btn--lg"> 
                                {{ 'common.clear'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {# Info Sidebar - 1 column #}
        <div class="rams-stack rams-stack--md">
            {# Process Steps #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <span class="rams-dymo">{{ 'quote.copilot.how_it_works'|trans }}</span>
                </div>
                <div class="rams-module__content">
                    <ol class="rams-list">
                        <li class="rams-list__item">
                            <span class="rams-list__number">1</span>
                            <span class="rams-list__text">{{ 'quote.copilot.step_1'|trans }}</span>
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-list__number">2</span>
                            <span class="rams-list__text">{{ 'quote.copilot.step_2'|trans }}</span>
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-list__number">3</span>
                            <span class="rams-list__text">{{ 'quote.copilot.step_3'|trans }}</span>
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-list__number">4</span>
                            <span class="rams-list__text">{{ 'quote.copilot.step_4'|trans }}</span>
                        </li>
                    </ol>
                </div>
            </div>

            {# Coverage Metrics #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <span class="rams-dymo">{{ 'quote.copilot.coverage_metrics'|trans }}</span>
                </div>
                <div class="rams-module__content">
                    <ul class="rams-list rams-list">
                        <li class="rams-list__item">
                            <span class="rams-andon rams-andon--success"><span class="rams-andon__light"></span></span>
                            <span><strong>{{ 'quote.copilot.coverage_high'|trans }}</strong> {{ 'quote.copilot.auto_publish_eligible'|trans }}</span>
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-andon rams-andon--warning"><span class="rams-andon__light"></span></span>
                            <span><strong>{{ 'quote.copilot.coverage_medium'|trans }}</strong> {{ 'quote.copilot.review_required'|trans }}</span>
                        </li>
                        <li class="rams-list__item">
                            <span class="rams-andon rams-andon--error"><span class="rams-andon__light"></span></span>
                            <span><strong>{{ 'quote.copilot.coverage_low'|trans }}</strong> {{ 'quote.copilot.manual_pricing_needed'|trans }}</span>
                        </li>
                    </ul>
                </div>
            </div>

            {# Sample BOM Format #}
            <div class="rams-module">
                <div class="rams-module__header">
                    <span class="rams-dymo">{{ 'quote.copilot.csv_format_example'|trans }}</span>
                </div>
                <div class="rams-module__content">
                    <div class="rams-code">
                        <code>{{ 'quote.copilot.sample_header'|trans }}</code>
                        <code class="rams-code rams-text--muted">{{ 'quote.copilot.sample_row_1'|trans }}</code>
                        <code class="rams-code rams-text--muted">{{ 'quote.copilot.sample_row_2'|trans }}</code>
                    </div>
                    <p class="rams-form__hint">{{ 'quote.copilot.upload_spec_intro'|trans }}</p>
                    <a href="/samples/quote-copilot-upload-template.csv" download class="rams-link rams-link--plain">
                        <svg class="rams-link__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                        {{ 'quote.copilot.download_template'|trans }}
                    </a>
                    <a href="/samples/quote-copilot-upload-spec.html" class="rams-link rams-link--plain">
                        <svg class="rams-link__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v11.494m0 0a8.25 8.25 0 100-11.494m0 11.494A8.25 8.25 0 0112 6.253"></path>
                        </svg>
                        {{ 'quote.copilot.open_upload_spec'|trans }}
                    </a>
                    <a href="/samples/sample-bom.csv" download class="rams-link rams-link--plain">
                        <svg class="rams-link__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                        {{ 'quote.copilot.download_sample'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function displayFileName(input) {
    const display = document.getElementById('file-name-display');
    if (input.files && input.files[0]) {
        display.textContent = input.files[0].name;
        display.classList.add('rams-upload-zone__filename--success');
    } else {
        display.textContent = '';
        display.classList.remove('rams-upload-zone__filename--success');
    }
}

// Show loading overlay on form submit
document.getElementById('bom-upload-form').addEventListener('submit', function(e) {
    const fileInput = document.getElementById('bom-file-input');
    if (fileInput.files && fileInput.files[0]) {
        document.getElementById('loading-overlay').style.display = 'flex';
        // Disable submit button to prevent double-submit
        this.querySelector('button[type="submit"]').disabled = true;
    }
});
</script>
{% endblock %}
