{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.copilot.list'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-stack--lg">
    {# Header #}
    <header class="rams-module__header rams-module__header--row rams-module__header--border-bottom">
        <div>
            <h1 class="rams-heading rams-heading--1">{{ 'quote.copilot.list'|trans }}</h1>
            <p class="rams-text rams-text--muted">{{ 'quote.copilot.list_subtitle'|trans|default('Automated quotes generated from BOM files') }}</p>
        </div>
        <a href="{{ path('quote_copilot_index') }}" class="rams-btn rams-btn--secondary">
            <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 3V13M3 8H13"/>
            </svg>
            {{ 'quote.copilot.new_quote'|trans }}
        </a>
    </header>

    {# Quotes Table #}
    <div class="rams-module">
        <div class="rams-table-container">
            <table class="rams-table">
                <thead class="rams-table__header">
                    <tr>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.quote_number'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.company'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.created_at'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.quantity'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.ship_to'|trans|default('Ship To') }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.coverage'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.total'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.status'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="rams-table__body">
                    {% for quote in quotes %}
                        <tr class="rams-table__row">
                            <td class="rams-table__cell rams-table__cell--bold">
                                {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}
                            </td>
                            <td class="rams-table__cell">
                                {{ quote.company.name }}
                            </td>
                            <td class="rams-table__cell">
                                {{ quote.createdAt|date('M d, Y') }}
                            </td>
                            <td class="rams-table__cell">
                                {{ quote.quantity ?? 'common.n_a'|trans }}
                            </td>
                            <td class="rams-table__cell">
                                {{ quote.shipToCountry ?? 'common.n_a'|trans }}
                            </td>
                            <td class="rams-table__cell">
                                {% set coverage = quote.coveragePercent|default(0) %}
                                <div class="rams-progress rams-progress--sm">
                                    <div class="rams-progress__bar rams-progress__bar--{% if coverage >= 90 %}green{% elseif coverage >= 60 %}yellow{% else %}red{% endif %}" style="width: {{ coverage }}%"></div>
                                    <span class="rams-progress__label">{{ coverage|number_format(0) }}%</span>
                                </div>
                            </td>
                            <td class="rams-table__cell rams-table__cell--bold">
                                {{ quote.totalCost|format_currency(quote.currency, null, 2) }}
                            </td>
                            <td class="rams-table__cell">
                                {% if quote.status == 'sent' %}
                                    <span class="rams-badge rams-badge--green">{{ 'quote.copilot.status_sent'|trans|default('Sent') }}</span>
                                {% elseif quote.status == 'draft' %}
                                    <span class="rams-badge rams-badge--gray">{{ 'quote.copilot.status_draft'|trans|default('Draft') }}</span>
                                {% else %}
                                    <span class="rams-badge rams-badge--blue">{{ quote.status|capitalize }}</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell rams-table__cell--actions">
                                <div class="rams-btn-group">
                                    <a href="{{ path('quote_copilot_results', {'id': quote.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'common.view'|trans }}">
                                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 8C1 8 3 3 8 3C13 3 15 8 15 8C15 8 13 13 8 13C3 13 1 8 1 8Z"/>
                                            <circle cx="8" cy="8" r="2"/>
                                        </svg>
                                    </a>
                                    <a href="{{ path('quote_copilot_pdf', {'id': quote.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'common.download'|trans }} PDF">
                                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M8 3V11M5 8L8 11L11 8"/>
                                            <path d="M3 13H13"/>
                                        </svg>
                                    </a>
                                    <a href="{{ path('quote_copilot_excel', {'id': quote.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'common.export'|trans }} Excel">
                                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="3" width="10" height="10" rx="1"/>
                                            <path d="M3 6H13M6 3V13"/>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="rams-table__cell rams-table__cell--empty">
                                <div class="rams-empty-state">
                                    <p class="rams-empty-state__text">{{ 'quote.copilot.no_quotes'|trans|default('No quotes found') }}</p>
                                    <a href="{{ path('quote_copilot_index') }}" class="rams-link">
                                        {{ 'quote.copilot.create_first'|trans|default('Create your first quote') }} →
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
