{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.copilot.list'|trans }}{% endblock %}

{% block body %}
<div class="rams-stack rams-stack--lg">
    {# Header #}
    <header class="rams-module__header rams-module__header--row rams-module__header--border-bottom">
        <div>
            <h1 class="rams-heading rams-heading--1">{{ 'quote.copilot.list'|trans }}</h1>
            <p class=" rams-text--muted">{{ 'quote.copilot.list_subtitle'|trans }}</p>
        </div>
        <a href="{{ path('quote_copilot_index') }}" class="rams-btn">
            <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M8 3V13M3 8H13"/>
            </svg>
            {{ 'quote.copilot.new_quote'|trans }}
        </a>
    </header>

    {# Quotes Table #}
    <div class="rams-module">
        <div class="rams-table-container">
            <table class="rams-table" aria-label="{{ 'quote.copilot.list'|trans }}">
                <caption class="rams-sr-only">{{ 'quote.copilot.list'|trans }}</caption>
                <thead>
                    <tr>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.quote_number'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.company'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.created_at'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.quantity'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.ship_to'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.coverage'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.total'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.status'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header rams-table__cell--actions">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for quote in quotes %}
                        {% set q = quote[0] is defined ? quote[0] : quote %}
                        <tr class="rams-table__row">
                            <td class="rams-table__cell rams-text--bold">
                                {{ q.quoteNumber ?? ('Q-' ~ q.id) }}
                            </td>
                            <td class="rams-table__cell">
                                {{ quote.company_name ?? ('common.n_a'|trans) }}
                            </td>
                            <td class="rams-table__cell">
                                {{ q.createdAt|date('M d, Y') }}
                            </td>
                            <td class="rams-table__cell">
                                {{ q.quantity ?? 'common.n_a'|trans }}
                            </td>
                            <td class="rams-table__cell">
                                {{ q.shipToCountry ?? 'common.n_a'|trans }}
                            </td>
                            <td class="rams-table__cell">
                                {% set coverage = q.coveragePercent|default(0) %}
                                <div class="rams-progress rams-progress--compact"> 
                                    <div class="rams-progress__bar rams-progress__bar--{% if coverage >= 90 %}green{% elseif coverage >= 60 %}yellow{% else %}red{% endif %}" style="--rams-meter-value: {{ coverage|default(0) }}%"></div>
                                    <span class="rams-text--xs rams-text--muted">{{ coverage|number_format(0) }}%</span>
                                </div>
                            </td>
                            <td class="rams-table__cell rams-text--bold">
                                {{ q.totalCost|format_currency(q.currency, null, 2) }}
                            </td>
                            <td class="rams-table__cell">
                                {% if q.status == 'sent' %}
                                    <span class="rams-status-chip rams-status-chip--ok">{{ 'quote.copilot.status_sent'|trans }}</span>
                                {% elseif q.status == 'draft' %}
                                    <span class="rams-badge rams-badge--gray">{{ 'quote.copilot.status_draft'|trans }}</span>
                                {% else %}
                                    <span class="rams-badge rams-badge--blue">{{ q.status|capitalize }}</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell rams-table__cell--actions">
                                <div class="rams-btn-group mobile-stack">
                                    <a href="{{ path('quote_copilot_results', {'id': q.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'common.view'|trans }}" aria-label="{{ 'common.view'|trans }}">
                                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M1 8C1 8 3 3 8 3C13 3 15 8 15 8C15 8 13 13 8 13C3 13 1 8 1 8Z"/>
                                            <circle cx="8" cy="8" r="2"/>
                                        </svg>
                                    </a>
                                    <a href="{{ path('quote_copilot_pdf', {'id': q.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'quote.copilot.download_pdf'|trans }}" aria-label="{{ 'quote.copilot.download_pdf'|trans }}">
                                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M8 3V11M5 8L8 11L11 8"/>
                                            <path d="M3 13H13"/>
                                        </svg>
                                    </a>
                                    <a href="{{ path('quote_copilot_customer_excel', {'id': q.id}) }}" class="rams-btn rams-btn--ghost rams-btn--sm" title="{{ 'quote.copilot.download_customer_excel'|trans({}, 'messages')|default('Customer Excel') }}" aria-label="{{ 'quote.copilot.download_customer_excel'|trans({}, 'messages')|default('Customer Excel') }}">
                                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <rect x="3" y="3" width="10" height="10" rx="1"/>
                                            <path d="M3 6H13M6 3V13"/>
                                        </svg>
                                    </a>
                                    <a href="{{ path('quote_copilot_full_excel', {'id': q.id}) }}" class="rams-btn rams-btn--ghost rams-btn--accent rams-btn--sm" title="{{ 'quote.copilot.download_full_excel'|trans({}, 'messages')|default('Full Sourcing Excel') }}" aria-label="{{ 'quote.copilot.download_full_excel'|trans({}, 'messages')|default('Full Sourcing Excel') }}">
                                        <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <rect x="3" y="3" width="10" height="10" rx="1"/>
                                            <path d="M3 6H13M3 9H13M6 3V13M10 3V13"/>
                                        </svg>
                                    </a>
                                    <form action="{{ path('quote_copilot_delete', {'id': q.id}) }}" method="POST" class="rams-inline" onsubmit="return ramsConfirmSubmit(event, '{{ 'quote.copilot.confirm_delete'|trans|e('js') }}', {variant: 'danger'});">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-quote-' ~ q.id) }}">
                                        <button type="submit" class="rams-btn rams-btn--ghost rams-btn--sm rams-btn--danger" title="{{ 'common.delete'|trans }}" aria-label="{{ 'common.delete'|trans }}">
                                            <svg class="rams-btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M3 5H13M5 5V13H11V5M7 7V11M9 7V11M6 5V3H10V5"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="rams-table__cell rams-table__cell">
                                <div class="rams-empty-state">
                                    <p class="rams-empty-state__text">{{ 'quote.copilot.no_quotes'|trans }}</p>
                                    <a href="{{ path('quote_copilot_index') }}" class="rams-link">
                                        {{ 'quote.copilot.create_first'|trans }} →
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
