{% extends 'base.html.twig' %}

{% block title %}Quote Co-Pilot - All Quotes{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-neutral-200/80 pb-5">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Quote Co-Pilot Quotes</h1>
            <p class="text-sm text-neutral-600 mt-1">Automated quotes generated from BOM files</p>
        </div>
        <a href="{{ path('quote_copilot_index') }}" class="inline-flex items-center rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-800">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="mr-2">
                <path d="M8 3V13M3 8H13"/>
            </svg>
            New Quote
        </a>
    </div>

    <!-- Quotes Table -->
    <div class="card">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-neutral-200">
                <thead class="bg-neutral-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Quote #</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Company</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Created</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Quantity</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Ship To</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Coverage</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Total</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-neutral-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-neutral-200">
                    {% for quote in quotes %}
                        <tr class="hover:bg-neutral-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-neutral-900">
                                {{ quote.quoteNumber ?? ('Q-' ~ quote.id) }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-700">
                                {{ quote.company.name }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-700">
                                {{ quote.createdAt|date('M d, Y') }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-700">
                                {{ quote.quantity ?? 'N/A' }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-700">
                                {{ quote.shipToCountry ?? 'N/A' }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                {% set coverage = quote.coveragePercent|default(0) %}
                                <div class="flex items-center gap-2">
                                    <div class="flex-1 h-2 bg-neutral-200 rounded-full overflow-hidden" style="width: 60px;">
                                        <div class="h-full bg-green-500" style="width: {{ coverage }}%"></div>
                                    </div>
                                    <span class="text-neutral-700">{{ coverage|number_format(0) }}%</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-neutral-900">
                                ${{ quote.totalCost|number_format(2) }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if quote.status == 'sent' %}
                                    <span class="badge badge-success">Sent</span>
                                {% elseif quote.status == 'draft' %}
                                    <span class="badge badge-secondary">Draft</span>
                                {% else %}
                                    <span class="badge">{{ quote.status|capitalize }}</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <div class="flex justify-end gap-2">
                                    <a href="{{ path('quote_copilot_results', {'id': quote.id}) }}" class="text-neutral-600 hover:text-neutral-900" title="View">
                                        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 8C1 8 3 3 8 3C13 3 15 8 15 8C15 8 13 13 8 13C3 13 1 8 1 8Z"/>
                                            <circle cx="8" cy="8" r="2"/>
                                        </svg>
                                    </a>
                                    <a href="{{ path('quote_copilot_pdf', {'id': quote.id}) }}" class="text-neutral-600 hover:text-neutral-900" title="Download PDF">
                                        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M8 3V11M5 8L8 11L11 8"/>
                                            <path d="M3 13H13"/>
                                        </svg>
                                    </a>
                                    <a href="{{ path('quote_copilot_excel', {'id': quote.id}) }}" class="text-neutral-600 hover:text-neutral-900" title="Export Excel">
                                        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="3" width="10" height="10" rx="1"/>
                                            <path d="M3 6H13M6 3V13"/>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="px-6 py-12 text-center">
                                <div class="text-neutral-500">
                                    <p class="mb-4">No quotes found</p>
                                    <a href="{{ path('quote_copilot_index') }}" class="text-neutral-700 hover:text-neutral-900 font-medium">
                                        Create your first quote →
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
