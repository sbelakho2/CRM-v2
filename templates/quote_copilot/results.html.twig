{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.copilot.results'|trans }} {{ quote.quoteNumber }}{% endblock %}

{% block body %}
<div class="rams-stack rams-stack--lg">
    {# Header with Back Link #}
    <header class="rams-module__header rams-module__header--border-bottom">
        <a href="{{ path('quote_copilot_index') }}" class="rams-link rams-link--back">
            <svg class="rams-link__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            {{ 'quote.copilot.back'|trans|default('Back to Quote Co-Pilot') }}
        </a>
        <div class="rams-module__header--row">
            <div>
                <h1 class="rams-heading rams-heading--1">{{ 'quote.title_singular'|trans }} {{ quote.quoteNumber }}</h1>
                <p class="rams-text rams-text--muted">{{ quote.company.name }} • {{ 'quote.created_at'|trans }} {{ quote.createdAt|date('M d, Y') }}</p>
            </div>
            <div class="rams-badge-group">
                {% if quote.coveragePercent >= 90 %}
                    <span class="rams-badge rams-badge--green">{{ 'quote.copilot.coverage_high_label'|trans|default('High Coverage') }}</span>
                {% elseif quote.coveragePercent >= 60 %}
                    <span class="rams-badge rams-badge--yellow">{{ 'quote.copilot.coverage_medium_label'|trans|default('Medium Coverage') }}</span>
                {% else %}
                    <span class="rams-badge rams-badge--red">{{ 'quote.copilot.coverage_low_label'|trans|default('Low Coverage') }}</span>
                {% endif %}
                <span class="rams-badge rams-badge--gray">{{ quote.status|upper }}</span>
            </div>
        </div>
    </header>

    {# Coverage Metrics #}
    <div class="rams-grid rams-grid--cols-4 rams-grid--gap-md">
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'quote.copilot.coverage'|trans }}</span>
                <p class="rams-metric rams-metric--xl">{{ quote.coveragePercent|number_format(1) }}%</p>
                <p class="rams-text rams-text--sm rams-text--muted">{{ 'quote.copilot.parts_sourced'|trans|default('Parts sourced with pricing') }}</p>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'quote.copilot.total_cost'|trans }}</span>
                <p class="rams-metric rams-metric--xl">{{ quote.totalCost|format_currency(quote.currency, null, 2) }}</p>
                <p class="rams-text rams-text--sm rams-text--muted">{{ quote.currency }}</p>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'quote.copilot.bom_lines'|trans|default('BOM Lines') }}</span>
                <p class="rams-metric rams-metric--xl">{{ quote.bomLines|length }}</p>
                <p class="rams-text rams-text--sm rams-text--muted">{{ 'quote.copilot.component_types'|trans|default('Component types') }}</p>
            </div>
        </div>
        <div class="rams-module">
            <div class="rams-module__content">
                <span class="rams-dymo">{{ 'quote.quantity'|trans }}</span>
                <p class="rams-metric rams-metric--xl">{{ quote.quantity }}</p>
                <p class="rams-text rams-text--sm rams-text--muted">{{ 'quote.copilot.units_to_produce'|trans|default('Units to produce') }}</p>
            </div>
        </div>
    </div>

    {# BOM Lines Table #}
    <div class="rams-module">
        <div class="rams-module__header">
            <h2 class="rams-heading rams-heading--3">{{ 'quote.copilot.bill_of_materials'|trans|default('Bill of Materials') }}</h2>
        </div>
        <div class="rams-table-container">
            <table class="rams-table">
                <thead class="rams-table__header">
                    <tr>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.line'|trans|default('Line') }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.mpn'|trans|default('MPN') }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.manufacturer'|trans|default('Manufacturer') }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'common.description'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header rams-table__cell--right">{{ 'common.quantity'|trans }}</th>
                        <th class="rams-table__cell rams-table__cell--header rams-table__cell--right">{{ 'quote.copilot.unit_price'|trans|default('Unit Price') }}</th>
                        <th class="rams-table__cell rams-table__cell--header rams-table__cell--right">{{ 'quote.copilot.ext_price'|trans|default('Ext. Price') }}</th>
                        <th class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.source'|trans|default('Source') }}</th>
                    </tr>
                </thead>
                <tbody class="rams-table__body">
                    {% for line in quote.bomLines %}
                        <tr class="rams-table__row">
                            <td class="rams-table__cell">{{ line.lineNumber }}</td>
                            <td class="rams-table__cell"><code class="rams-code">{{ line.mpn }}</code></td>
                            <td class="rams-table__cell">{{ line.manufacturer }}</td>
                            <td class="rams-table__cell rams-table__cell--truncate" title="{{ line.description }}">{{ line.description|length > 40 ? line.description|slice(0, 40) ~ '...' : line.description }}</td>
                            <td class="rams-table__cell rams-table__cell--right">{{ line.quantity }}</td>
                            <td class="rams-table__cell rams-table__cell--right">
                                {% if line.unitPrice %}
                                    {{ line.unitPrice|format_currency(quote.currency, null, 4) }}
                                {% else %}
                                    <span class="rams-text rams-text--danger">—</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell rams-table__cell--right rams-text--bold">
                                {% if line.extendedPrice %}
                                        {{ line.extendedPrice|format_currency(quote.currency, null, 2) }}
                                {% else %}
                                    <span class="rams-text rams-text--danger">—</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell">
                                {% if line.hasException %}
                                    <span class="rams-badge rams-badge--red">{{ line.exceptionReason }}</span>
                                {% else %}
                                    <span class="rams-badge rams-badge--green">{{ line.procurementSource }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot class="rams-table__footer">
                    <tr>
                        <td colspan="6" class="rams-table__cell rams-table__cell--right rams-text--bold">{{ 'common.total'|trans }}:</td>
                            <td class="rams-table__cell rams-table__cell--right rams-text--bold">{{ quote.totalCost|format_currency(quote.currency, null, 2) }}</td>
                        <td class="rams-table__cell"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    {# Quote Details #}
    <div class="rams-grid rams-grid--cols-2 rams-grid--gap-lg">
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-dymo">{{ 'quote.copilot.shipment_details'|trans|default('Shipment Details') }}</span>
            </div>
            <div class="rams-module__content">
                <dl class="rams-definition-list">
                    <div class="rams-definition-list__item">
                        <dt class="rams-definition-list__term">{{ 'quote.copilot.destination'|trans|default('Destination') }}</dt>
                        <dd class="rams-definition-list__desc">{{ quote.shipToCountry }}</dd>
                    </div>
                    <div class="rams-definition-list__item">
                        <dt class="rams-definition-list__term">{{ 'quote.copilot.incoterms'|trans|default('Incoterms') }}</dt>
                        <dd class="rams-definition-list__desc">{{ quote.incoterms }}</dd>
                    </div>
                    {% if quote.notes %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.notes'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ quote.notes }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </div>
        </div>

        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-dymo">{{ 'common.actions'|trans }}</span>
            </div>
            <div class="rams-module__content">
                <div class="rams-stack rams-stack--sm">
                    <a href="{{ path('quote_copilot_pdf', {id: quote.id}) }}" class="rams-btn rams-btn--primary rams-btn--block">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        {{ 'quote.copilot.download_pdf'|trans|default('Download PDF') }}
                    </a>
                    
                    {% if quote.coveragePercent >= 60 %}
                        <button onclick="initiatePublish({{ quote.id }})" class="rams-btn rams-btn--secondary rams-btn--block">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                            </svg>
                            {{ 'quote.copilot.publish'|trans }}
                        </button>
                    {% else %}
                        <div class="rams-andon rams-andon--yellow">
                            <p class="rams-text rams-text--sm">
                                <strong>⚠ {{ 'quote.copilot.coverage_too_low'|trans|default('Coverage too low:') }}</strong> {{ 'quote.copilot.coverage_requirement'|trans|default('Requires ≥60% to publish. Manual pricing needed for missing parts.') }}
                            </p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# Contact Selection Modal #}
<div id="contactModal" class="rams-modal rams-modal--hidden">
    <div class="rams-modal__backdrop" onclick="closeContactModal()"></div>
    <div class="rams-modal__content">
        <div class="rams-modal__header">
            <h3 class="rams-heading rams-heading--3">{{ 'quote.copilot.select_contact'|trans|default('Select Contact') }}</h3>
            <p class="rams-text rams-text--muted">{{ 'quote.copilot.select_contact_hint'|trans|default('Choose who should receive this quote') }}</p>
        </div>
        <div id="contactList" class="rams-modal__body">
            {# Contacts will be loaded here #}
        </div>
        <div class="rams-modal__footer">
            <button onclick="closeContactModal()" class="rams-btn rams-btn--secondary">
                {{ 'common.cancel'|trans }}
            </button>
        </div>
    </div>
</div>

<script>
let currentQuoteId = null;

async function initiatePublish(quoteId) {
    currentQuoteId = quoteId;
    
    try {
        const response = await fetch(`/quote-copilot/${quoteId}/contacts`);
        const data = await response.json();
        
        if (!data.success) {
            ramsAlert('{{ 'quote.copilot.error_loading_contacts'|trans|default('Error loading contacts') }}: ' + data.message, {variant: 'error'});
            return;
        }
        
        if (data.count === 0) {
            ramsAlert('{{ 'quote.copilot.no_contacts'|trans|default('No contacts with email addresses found for this company. Please add a contact first.') }}', {variant: 'warning'});
            return;
        }
        
        if (data.count === 1) {
            ramsConfirm(`{{ 'quote.copilot.send_to'|trans|default('Send quote to') }} ${data.contacts[0].name} (${data.contacts[0].email})?`, function() {
                publishQuote(quoteId, data.contacts[0].id);
            });
        } else {
            showContactModal(data.contacts);
        }
    } catch (error) {
        ramsAlert('{{ 'quote.copilot.error_loading_contacts'|trans|default('Error loading contacts') }}', {variant: 'error'});
        console.error(error);
    }
}

function showContactModal(contacts) {
    const contactList = document.getElementById('contactList');
    contactList.innerHTML = contacts.map(contact => {
        const escapedName = contact.name.replace(/'/g, '&apos;').replace(/"/g, '&quot;');
        const escapedEmail = contact.email.replace(/'/g, '&apos;').replace(/"/g, '&quot;');
        return `
        <div class="rams-list-item rams-list-item--clickable" onclick="selectContact(${contact.id}, '${escapedName}', '${escapedEmail}')">
            <div class="rams-list-item__content">
                <p class="rams-text rams-text--bold">${contact.name}</p>
                <p class="rams-text rams-text--sm rams-text--muted">${contact.email}</p>
                ${contact.role ? `<p class="rams-text rams-text--xs rams-text--muted">${contact.role}</p>` : ''}
            </div>
            <svg class="rams-list-item__chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </div>
    `}).join('');
    
    document.getElementById('contactModal').classList.remove('rams-modal--hidden');
}

function closeContactModal() {
    document.getElementById('contactModal').classList.add('rams-modal--hidden');
    currentQuoteId = null;
}

function selectContact(contactId, contactName, contactEmail) {
    const unescapeName = contactName.replace(/&apos;/g, "'").replace(/&quot;/g, '"');
    const unescapeEmail = contactEmail.replace(/&apos;/g, "'").replace(/&quot;/g, '"');
    
    ramsConfirm(`{{ 'quote.copilot.send_to'|trans|default('Send quote to') }} ${unescapeName} (${unescapeEmail})?`, function() {
        closeContactModal();
        publishQuote(currentQuoteId, contactId);
    });
}

async function publishQuote(quoteId, contactId) {
    try {
        const response = await fetch(`/quote-copilot/${quoteId}/publish`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ contactId: contactId })
        });
        
        const data = await response.json();
        
        if (data.success) {
            ramsAlert('{{ 'quote.copilot.publish_success'|trans|default('Quote published successfully!') }}', {variant: 'success', onClose: function() { window.location.reload(); }});
        } else {
            ramsAlert('{{ 'common.error'|trans }}: ' + data.message, {variant: 'error'});
        }
    } catch (error) {
        ramsAlert('{{ 'quote.copilot.publish_error'|trans|default('Error publishing quote') }}', {variant: 'error'});
        console.error(error);
    }
}
</script>
{% endblock %}