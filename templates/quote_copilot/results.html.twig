{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.copilot.results'|trans }} {{ quote.quoteNumber }}{% endblock %}


{% block stylesheets %}
{{ parent() }}
<style>
    .rams-list__item--clickable { cursor: pointer; transition: background var(--duration-fast); }
    .rams-list__item--clickable:hover { background: var(--rams-surface-hover); }
</style>
{% endblock %}

{% block body %}
<div class="rams-stack rams-stack--lg">
    {# Header with Back Link #}
    <header class="rams-module__header rams-module__header--border-bottom rams-mb-6">
        <a href="{{ path('quote_copilot_index') }}" class="rams-link rams-link--back">
            <svg class="rams-link__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            {{ 'quote.copilot.back'|trans }}
        </a>
        <div class="rams-module__header--row">
            <div>
                <h1 class="rams-heading rams-heading--1">{{ 'quote.title_singular'|trans }} {{ quote.quoteNumber }}</h1>
                <p class=" rams-text--muted">{{ company_name ?? ('common.n_a'|trans) }} • {{ 'quote.created_at'|trans }} {{ quote.createdAt|date('M d, Y') }}</p>
            </div>
            <div class="rams-badge-group">
                {% if quote.coveragePercent >= 90 %}
                    <span class="rams-badge rams-badge--green">{{ 'quote.copilot.coverage_high_label'|trans }}</span>
                {% elseif quote.coveragePercent >= 60 %}
                    <span class="rams-badge rams-badge--yellow">{{ 'quote.copilot.coverage_medium_label'|trans }}</span>
                {% else %}
                    <span class="rams-badge rams-badge--red">{{ 'quote.copilot.coverage_low_label'|trans }}</span>
                {% endif %}
                <span class="rams-badge rams-badge--gray">{{ quote.status|upper }}</span>
            </div>
        </div>
    </header>

    {# Coverage Metrics #}
    <div class="rams-metrics-grid rams-metrics-grid--4col">
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content">
                <div class="rams-metric rams-metric--lg">
                    <span class="rams-metric__label">{{ 'quote.copilot.coverage'|trans }}</span>
                    <span class="rams-metric__value">
                        {{ quote.coveragePercent|number_format(1) }}<span class="rams-metric__unit">%</span>
                    </span>
                    <span class=" rams-text--3xs rams-text--muted rams-uppercase rams-font-mono">{{ 'quote.copilot.parts_sourced'|trans }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content">
                <div class="rams-metric rams-metric--lg">
                    <span class="rams-metric__label">{{ 'quote.copilot.total_cost'|trans }}</span>
                    <span class="rams-metric__value">
                        {{ quote.totalCost|format_currency(quote.currency, null, 2) }}
                    </span>
                    <span class=" rams-text--3xs rams-text--muted rams-uppercase rams-font-mono">{{ quote.currency }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content">
                <div class="rams-metric rams-metric--lg">
                    <span class="rams-metric__label">{{ 'quote.copilot.bom_lines'|trans }}</span>
                    <span class="rams-metric__value">
                        {{ quote.bomLines|length }}
                    </span>
                    <span class=" rams-text--3xs rams-text--muted rams-uppercase rams-font-mono">{{ 'quote.copilot.component_types'|trans }}</span>
                </div>
            </div>
        </div>
        <div class="rams-module rams-module--inset">
            <div class="rams-module__content">
                <div class="rams-metric rams-metric--lg">
                    <span class="rams-metric__label">{{ 'quote.quantity'|trans }}</span>
                    <span class="rams-metric__value">
                        {{ quote.quantity }}
                    </span>
                    <span class=" rams-text--3xs rams-text--muted rams-uppercase rams-font-mono">{{ 'quote.copilot.units_to_produce'|trans }}</span>
                </div>
            </div>
        </div>
    </div>

    {# BOM Lines Table #}
    <div class="rams-module rams-mt-6">
        <div class="rams-module__header rams-panel-head">
            <h2 class="rams-heading rams-heading--3">{{ 'quote.copilot.bill_of_materials'|trans }}</h2>
            <a href="{{ path('quote_review_detail', {id: quote.id}) }}" class="rams-btn rams-btn--sm rams-btn--indigo">
                <svg class="rams-btn__icon rams-icon--sm" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
                {{ 'quote.copilot.review_verify_lines'|trans }}
            </a>
        </div>
        <div class="rams-table-container">
            <table class="rams-table" aria-label="{{ 'quote.copilot.bill_of_materials'|trans }}">
                <thead>
                    <tr>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.line'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.mpn'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.manufacturer'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'common.description'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header rams-table__cell--right">{{ 'common.quantity'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header rams-table__cell--right">{{ 'quote.copilot.unit_price'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header rams-table__cell--right">{{ 'quote.copilot.ext_price'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header">{{ 'quote.copilot.source'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header rams-text--center">{{ 'quote.review.confidence'|trans }}</th>
                        <th scope="col" class="rams-table__cell rams-table__cell--header rams-text--center">{{ 'quote.copilot.link'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in quote.bomLines %}
                        <tr class="rams-table__row">
                            <td class="rams-table__cell">{{ line.lineNumber }}</td>
                            <td class="rams-table__cell">
                                <code class="rams-code">{{ line.mpn }}</code>
                                {% if line.matchedMpn and line.matchedMpn != line.mpn %}
                                    <br><span class=" rams-text--3xs rams-text--muted" title="Matched: {{ line.matchedMpn }}">↳ {{ line.matchedMpn }}</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell">{{ line.manufacturer }}</td>
                            <td class="rams-table__cell rams-table__cell--truncate" title="{{ line.description }}">{{ line.description|length > 40 ? line.description|slice(0, 40) ~ '...' : line.description }}</td>
                            <td class="rams-table__cell rams-table__cell--right">{{ line.quantity }}</td>
                            <td class="rams-table__cell rams-table__cell--right">
                                {% if line.unitPrice %}
                                    {{ line.unitPrice|format_currency(quote.currency, null, 4) }}
                                {% else %}
                                    <span class=" rams-text--danger">—</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell rams-table__cell--right rams-text--bold">
                                {% if line.extendedPrice %}
                                        {{ line.extendedPrice|format_currency(quote.currency, null, 2) }}
                                {% else %}
                                    <span class=" rams-text--danger">—</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell">
                                {% if line.hasException %}
                                    <span class="rams-badge rams-badge--red">{{ line.exceptionReason }}</span>
                                {% else %}
                                    <span class="rams-badge rams-badge--green">{{ line.procurementSource }}</span>
                                    {% if line.isFallback %}
                                        <br><span class="rams-badge rams-badge--yellow rams-inline-block rams-badge-code">⚡ {{ line.fallbackLabel }}</span>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="rams-table__cell rams-text--center">
                                {% if line.confidenceLevel == 'HIGH' %}
                                    <span class="rams-badge rams-badge--green" title="Score: {{ line.confidenceScore }}">HIGH</span>
                                {% elseif line.confidenceLevel == 'MEDIUM' %}
                                    <span class="rams-badge rams-badge--yellow" title="Score: {{ line.confidenceScore }}">MED</span>
                                {% elseif line.confidenceLevel == 'LOW' %}
                                    <span class="rams-badge rams-badge--red" title="Score: {{ line.confidenceScore }}">LOW</span>
                                {% elseif line.confidenceLevel == 'VERY_LOW' %}
                                    <span class="rams-badge rams-badge--very-low" title="Score: {{ line.confidenceScore }}">V.LOW</span>
                                {% else %}
                                    <span class=" rams-text--muted">—</span>
                                {% endif %}
                            </td>
                            <td class="rams-table__cell rams-text--center">
                                {% if line.supplierProductUrl %}
                                    <a href="{{ line.supplierProductUrl }}" target="_blank" rel="noopener" class="rams-link" title="View listing">↗</a>
                                {% elseif line.distributorSearchUrl %}
                                    <a href="{{ line.distributorSearchUrl }}" target="_blank" rel="noopener" class="rams-link" title="Search distributor">↗</a>
                                {% else %}
                                    <span class=" rams-text--muted">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot class="rams-table__footer">
                    <tr>
                        <td colspan="6" class="rams-table__cell rams-table__cell--right rams-text--bold">{{ 'common.total'|trans }}:</td>
                            <td class="rams-table__cell rams-table__cell--right rams-text--bold">{{ quote.totalCost|format_currency(quote.currency, null, 2) }}</td>
                        <td class="rams-table__cell"></td>
                        <td class="rams-table__cell"></td>
                        <td class="rams-table__cell"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    {# Quote Details #}
    <div class="rams-grid rams-grid--2 rams-gap-6 rams-mt-6">
        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-dymo">{{ 'quote.copilot.shipment_details'|trans }}</span>
            </div>
            <div class="rams-module__content">
                <dl class="rams-definition-list">
                    <div class="rams-definition-list__item">
                        <dt class="rams-definition-list__term">{{ 'quote.copilot.destination'|trans }}</dt>
                        <dd class="rams-definition-list__desc">{{ quote.shipToCountry }}</dd>
                    </div>
                    <div class="rams-definition-list__item">
                        <dt class="rams-definition-list__term">{{ 'quote.copilot.incoterms_label'|trans }}</dt>
                        <dd class="rams-definition-list__desc">{{ quote.incoterms }}</dd>
                    </div>
                    {% if quote.notes %}
                        <div class="rams-definition-list__item">
                            <dt class="rams-definition-list__term">{{ 'common.notes'|trans }}</dt>
                            <dd class="rams-definition-list__desc">{{ quote.notes }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </div>
        </div>

        <div class="rams-module">
            <div class="rams-module__header">
                <span class="rams-dymo">{{ 'common.actions'|trans }}</span>
            </div>
            <div class="rams-module__content">
                <div class="rams-stack rams-stack--sm">
                    {# Customer-Facing Documents #}
                    <span class="rams-dymo rams-text--xs">{{ 'quote.copilot.customer_documents'|trans({}, 'messages')|default('Customer Documents') }}</span>
                    <a href="{{ path('quote_copilot_pdf', {id: quote.id}) }}" class="rams-btn rams-btn--primary rams-btn--full">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        {{ 'quote.copilot.download_pdf'|trans }}
                    </a>
                    <a href="{{ path('quote_copilot_customer_excel', {id: quote.id}) }}" class="rams-btn rams-btn--full">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        {{ 'quote.copilot.download_customer_excel'|trans({}, 'messages')|default('Customer Excel') }}
                    </a>

                    {# Internal Documents #}
                    <hr class="rams-border-t rams-my-2">
                    <span class="rams-dymo rams-text--xs">{{ 'quote.copilot.internal_documents'|trans({}, 'messages')|default('Internal Documents') }}</span>
                    <a href="{{ path('quote_copilot_full_excel', {id: quote.id}) }}" class="rams-btn rams-btn--full rams-btn--accent-outline">
                        <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        {{ 'quote.copilot.download_full_excel'|trans({}, 'messages')|default('Full Sourcing Excel') }}
                    </a>

                    {# Publish #}
                    <hr class="rams-border-t rams-my-2">
                    {% if quote.coveragePercent >= 60 %}
                        <button onclick="initiatePublish({{ quote.id }})" class="rams-btn rams-btn--full">
                            <svg class="rams-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                            </svg>
                            {{ 'quote.copilot.publish'|trans }}
                        </button>
                    {% else %}
                        <div class="rams-andon rams-andon--warning">
                            <p class=" rams-text--sm">
                                <strong>⚠ {{ 'quote.copilot.coverage_too_low'|trans }}</strong> {{ 'quote.copilot.coverage_requirement'|trans }}
                            </p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# Contact Selection Modal #}
<div id="contactModal" class="rams-modal rams-modal--hidden" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
    <div class="rams-modal__backdrop" role="button" tabindex="0" aria-label="{{ 'common.close'|trans }}" onclick="closeContactModal()" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); closeContactModal(); }"></div>
    <div class="rams-modal__content">
        <div class="rams-modal__header">
            <h3 id="contact-modal-title" class="rams-heading rams-heading--3">{{ 'quote.copilot.select_contact'|trans }}</h3>
            <p class=" rams-text--muted">{{ 'quote.copilot.select_contact_hint'|trans }}</p>
        </div>
        <div id="contactList" class="rams-modal__body">
            {# Contacts will be loaded here #}
        </div>
        <div class="rams-modal__footer">
            <button onclick="closeContactModal()" class="rams-btn">
                {{ 'common.cancel'|trans }}
            </button>
        </div>
    </div>
</div>

<script>
let currentQuoteId = null;

const copilotContactsUrl = '{{ path('quote_copilot_contacts', {id: 0}) }}';
const copilotPublishUrl = '{{ path('quote_copilot_publish', {id: 0}) }}';

async function initiatePublish(quoteId) {
    currentQuoteId = quoteId;
    
    try {
        const response = await fetch(copilotContactsUrl.replace('/0', '/' + quoteId));
        const data = await response.json();
        
        if (!data.success) {
            ramsAlert('{{ 'quote.copilot.error_loading_contacts'|trans }}: ' + data.message, {variant: 'error'});
            return;
        }
        
        if (data.count === 0) {
            ramsAlert('{{ 'quote.copilot.no_contacts'|trans }}', {variant: 'warning'});
            return;
        }
        
        if (data.count === 1) {
            ramsConfirm(`{{ 'quote.copilot.send_to'|trans }} ${data.contacts[0].name} (${data.contacts[0].email})?`, function() {
                publishQuote(quoteId, data.contacts[0].id);
            });
        } else {
            showContactModal(data.contacts);
        }
    } catch (error) {
        ramsAlert('{{ 'quote.copilot.error_loading_contacts'|trans }}', {variant: 'error'});
        console.error(error);
    }
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

function showContactModal(contacts) {
    const contactList = document.getElementById('contactList');
    contactList.innerHTML = contacts.map(contact => {
        return `
        <div class="rams-list__item rams-list__item--clickable" data-contact-id="${contact.id}" data-contact-name="${escapeHtml(contact.name)}" data-contact-email="${escapeHtml(contact.email)}">
            <div class="rams-list__content">
                <p class=" rams-text--bold">${escapeHtml(contact.name)}</p>
                <p class=" rams-text--sm rams-text--muted">${escapeHtml(contact.email)}</p>
                ${contact.role ? `<p class=" rams-text--xs rams-text--muted">${escapeHtml(contact.role)}</p>` : ''}
            </div>
            <svg class="rams-list__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </div>
    `}).join('');
    
    contactList.querySelectorAll('.rams-list__item--clickable').forEach(item => {
        item.addEventListener('click', function() {
            selectContact(
                parseInt(this.dataset.contactId),
                this.dataset.contactName,
                this.dataset.contactEmail
            );
        });
    });
    
    document.getElementById('contactModal').classList.remove('rams-modal--hidden');
}

function closeContactModal() {
    document.getElementById('contactModal').classList.add('rams-modal--hidden');
    currentQuoteId = null;
}

function selectContact(contactId, contactName, contactEmail) {
    ramsConfirm(`{{ 'quote.copilot.send_to'|trans }} ${contactName} (${contactEmail})?`, function() {
        closeContactModal();
        publishQuote(currentQuoteId, contactId);
    });
}

async function publishQuote(quoteId, contactId) {
    try {
        const response = await fetch(copilotPublishUrl.replace('/0', '/' + quoteId), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ contactId: contactId })
        });
        
        const data = await response.json();
        
        if (data.success) {
            ramsAlert('{{ 'quote.copilot.publish_success'|trans }}', {variant: 'success', onClose: function() { window.location.reload(); }});
        } else {
            ramsAlert('{{ 'common.error'|trans }}: ' + data.message, {variant: 'error'});
        }
    } catch (error) {
        ramsAlert('{{ 'quote.copilot.publish_error'|trans }}', {variant: 'error'});
        console.error(error);
    }
}
</script>
{% endblock %}