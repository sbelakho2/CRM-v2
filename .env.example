# Symfony Application Environment Configuration
APP_ENV=prod
APP_SECRET=CHANGE_ME_ON_PRODUCTION

# Database Configuration - SQLite (No drivers needed)
DATABASE_URL="mysql://crm_user:PASSWORD@localhost:3306/starz_crm?serverVersion=8.0&charset=utf8mb4"

# Mailer Configuration
MAILER_DSN=smtp://username:password@smtp.example.com:587

# Translation Configuration
DEFAULT_LOCALE=en

###> symfony/framework-bundle ###
APP_SECRET=CHANGE_ME_ON_PRODUCTION
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite database for development (no drivers needed)
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://username:password@smtp.example.com:587
###< symfony/mailer ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> quote-copilot/api-integrations ###
# ============================================
# SYSADMIN: OBTAIN API KEYS BEFORE DEPLOYMENT
# ============================================
#
# Quote Co-Pilot requires API keys from the following suppliers/platforms.
# These keys enable real-time pricing, availability, and component data.
# 
# IMPORTANT: Keep these keys secure. Never commit real keys to version control.
#

# Mouser Electronics API
# How to obtain: https://www.mouser.com/api-hub/
# Sign up for a free API account and generate your key from the dashboard
MOUSER_API_KEY=your_mouser_api_key_here

# Digi-Key Electronics API
# How to obtain: https://developer.digikey.com/
# Create a developer account and register your application
DIGIKEY_API_KEY=your_digikey_api_key_here
DIGIKEY_CLIENT_ID=your_digikey_client_id_here
DIGIKEY_CLIENT_SECRET=your_digikey_client_secret_here

# Nexar (Octopart) GraphQL API
# How to obtain: https://nexar.com/api
# Sign up for Nexar Supply API access (free tier available)
NEXAR_API_KEY=your_nexar_api_key_here
NEXAR_CLIENT_ID=your_nexar_client_id_here
NEXAR_CLIENT_SECRET=your_nexar_client_secret_here

# Alibaba.com Open Platform API
# How to obtain: https://open.alibaba.com/
# Register as a developer and create an application
ALIBABA_API_KEY=your_alibaba_api_key_here
ALIBABA_APP_SECRET=your_alibaba_app_secret_here

# API Rate Limiting (requests per minute)
API_RATE_LIMIT_MOUSER=20
API_RATE_LIMIT_DIGIKEY=20
API_RATE_LIMIT_NEXAR=100
API_RATE_LIMIT_ALIBABA=10

###< quote-copilot/api-integrations ###
