# Symfony Application Environment Configuration
APP_ENV=prod
APP_SECRET=CHANGE_ME_ON_PRODUCTION

# Database Configuration - MySQL 8 (Docker container crm-v2-mysql on host port 3308)
# IMPORTANT: the Docker MySQL is published on port 3308, NOT the default 3306.
# phpunit.xml.dist and .env both use 3308 — keep this file in sync with them.
# The server version is auto-detected by DBAL (works for MySQL 8 and MariaDB);
# only set serverVersion explicitly when you need to pin the platform.
DATABASE_URL="mysql://crm_user:PASSWORD@127.0.0.1:3308/starz_crm?charset=utf8mb4"

# Mailer Configuration
# DSN reference: https://symfony.com/doc/current/mailer.html#transport-setup
MAILER_DSN=smtp://username:password@smtp.example.com:587
MAILER_FROM_ADDRESS=noreply@example.com
MAILER_FROM_NAME="Starz Electronics"

# Admin email for system alerts (competitor changes, compliance expiry, etc.)
# If not set, defaults to the MAILER_FROM_ADDRESS
ADMIN_EMAIL=admin@starz-electronics.com

# Translation Configuration
DEFAULT_LOCALE=en

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Primary connection is MySQL 8 on port 3308 (see above). Alternatives —
# serverVersion is auto-detected when omitted (omit it for any MySQL/MariaDB):
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3308/app?charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> app ###
DEFAULT_TIMEZONE=UTC
LOCK_DSN=semaphore://localhost
# Secret used to sign public meeting booking/cancellation tokens.
# REQUIRED in production: no default is applied there, so the container
# build fails if it is unset. Dev/test fall back to a known literal.
# APP_BOOKING_SECRET=change-me-booking-secret
###< app ###

###> google ###
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here
###< google ###

###> quote-copilot/api-integrations ###
# ============================================
# SYSADMIN: OBTAIN API KEYS BEFORE DEPLOYMENT
# ============================================
#
# Quote Co-Pilot requires API keys from the following suppliers/platforms.
# These keys enable real-time pricing, availability, and component data.
# 
# IMPORTANT: Keep these keys secure. Never commit real keys to version control.
#

# Mouser Electronics API
# How to obtain: https://www.mouser.com/api-hub/
# Sign up for a free API account and generate your key from the dashboard
MOUSER_API_KEY=your_mouser_api_key_here

# Digi-Key Electronics API (OAuth2 client credentials)
# How to obtain: https://developer.digikey.com/
# Create a developer account and register your application
DIGIKEY_CLIENT_ID=your_digikey_client_id_here
DIGIKEY_CLIENT_SECRET=your_digikey_client_secret_here

# Nexar (Octopart) GraphQL API — OAuth2 client credentials
# How to obtain: https://nexar.com/api
# Sign up for Nexar Supply API access (free tier available)
NEXAR_CLIENT_ID=your_nexar_client_id_here
NEXAR_CLIENT_SECRET=your_nexar_client_secret_here

# Alibaba.com Open Platform API
# How to obtain: https://open.alibaba.com/
# Register as a developer and create an application
# NOTE: Uncomment the following lines when Alibaba integration is needed
# ALIBABA_API_KEY=your_alibaba_api_key_here
# ALIBABA_APP_SECRET=your_alibaba_app_secret_here

# API Rate Limiting (requests per minute)
# NOTE: Uncomment these when API integrations are activated
# API_RATE_LIMIT_MOUSER=20
# API_RATE_LIMIT_DIGIKEY=20
# API_RATE_LIMIT_NEXAR=100
# API_RATE_LIMIT_ALIBABA=10

###< quote-copilot/api-integrations ###
